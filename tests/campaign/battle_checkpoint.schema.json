{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emerald-champions.invalid/battle-checkpoint.schema.json",
  "title": "Emerald Champions deterministic pre-battle checkpoint",
  "type": "object",
  "required": ["schema_version", "encounter", "campaign", "identity", "checkpoint", "player", "services", "legal_arsenal", "dependency_graph", "preparation_adapter", "launch"],
  "properties": {
    "schema_version": {"const": 1},
    "encounter": {
      "type": "object",
      "required": ["id", "trainer_ids", "map_id", "level_cap"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "trainer_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TRAINER_"}},
        "map_id": {"type": "integer", "minimum": 0},
        "level_cap": {"type": "integer", "minimum": 1, "maximum": 100}
      },
      "additionalProperties": true
    },
    "campaign": {"type": "object", "required": ["segment", "parent_segment", "parent_state_sha256"]},
    "identity": {"type": "object", "required": ["rom_sha256", "elf_sha256", "runner_sha256"]},
    "checkpoint": {"type": "object", "required": ["state", "state_sha256", "screenshot", "screenshot_sha256"]},
    "player": {
      "type": "object",
      "required": ["money", "badges", "party", "inventory"],
      "properties": {
        "money": {"type": "integer", "minimum": 0},
        "badges": {"type": "array", "items": {"type": "string"}},
        "party": {"type": "array", "maxItems": 6},
        "inventory": {"type": "array"}
      }
    },
    "services": {"type": "object"},
    "legal_arsenal": {"type": "object", "required": ["reachable_maps", "encounter_method_access", "chronology", "pokemon", "held_items", "mega_access", "mega_stones", "evolution_items", "evolution_edges", "natures", "stat_point_rule"]},
    "dependency_graph": {"type": "object", "required": ["inputs", "invalidation"]},
    "preparation_adapter": {"type": "object", "required": ["allowed_changes", "result_states", "execution_boundary", "request_log"]},
    "launch": {
      "type": "object",
      "required": ["campaign_autowin_disabled", "reset_source", "allowed_controls", "observation"],
      "properties": {"campaign_autowin_disabled": {"const": true}, "observation": {"const": "screenshots"}}
    }
  },
  "additionalProperties": true
}

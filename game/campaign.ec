text:MatchCall_BattlePikeText5	{'body': "Hiya, {PLAYER}{KUN}!\\nIt's {STR_VAR_1}.\\pI heard you got past {STR_VAR_3} rooms\\nat the {STR_VAR_2}.\\pI'd better get with it, too!\\nSee you soon!$"}

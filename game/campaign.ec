text:BattleFrontier_BattleTowerMultiPartnerRoom.KindlerIntro	{'body': "Yo, there!\\nI'm KINDLER {STR_VAR_1}!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.KindlerMon1	{'body': 'You know what my training cooked up?\\nOne {STR_VAR_2} with {STR_VAR_1} and$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.KindlerMon2Ask	{'body': 'one {STR_VAR_2} with {STR_VAR_1}!\\pWell, what do you say?\\nWant to form a tag team?$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.KindlerAccept	{'body': "All right!\\nI'll get on with the registration.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.KindlerReject	{'body': "Promise you'll partner up with me\\nthe next time we run into each other.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.CamperIntro	{'body': "I'm {STR_VAR_1}, and I'm a CAMPER!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.CamperMon1	{'body': "I've been raising one {STR_VAR_1}-\\nusing {STR_VAR_2} and one$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.CamperMon2Ask	{'body': "{STR_VAR_1}-using {STR_VAR_2}.\\pDo you think it'd be fun to team up?\\nI bet it would be!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.CamperAccept	{'body': 'Yeah!\\nOff I go to register!$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.CamperReject	{'body': 'Next time, okay?\\nI want to be on your team.$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PicnickerIntro	{'body': "Hello!\\nI'm {STR_VAR_1}, and I'm a PICNICKER!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PicnickerMon1	{'body': "The POKéMON I've been taking are\\none {STR_VAR_2} with {STR_VAR_1} and$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PicnickerMon2Ask	{'body': 'one {STR_VAR_2} with {STR_VAR_1}.\\pAre you interested in joining me\\non a tag team?$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PicnickerAccept	{'body': 'Why, thank you!\\nI will do the registration now.$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PicnickerReject	{'body': 'It would be nice if I could join you\\nsome other time.$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicMIntro	{'body': "I'm PSYCHIC {STR_VAR_1}!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicMMon1	{'body': "The twosome I've been raising are\\none {STR_VAR_2} with {STR_VAR_1} and$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicMMon2Ask	{'body': 'one {STR_VAR_2} with {STR_VAR_1}.\\pWould you like to form a tag team\\nwith me?$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicMAccept	{'body': "Sure thing!\\nI'll take care of the registration!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicMReject	{'body': "If we meet again, that's when I'd like\\nto team up with you.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicFIntro	{'body': "I'm {STR_VAR_1}.\\nI'm a PSYCHIC.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicFMon1	{'body': 'One {STR_VAR_2} with {STR_VAR_1} and$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicFMon2Ask	{'body': "one {STR_VAR_2} with {STR_VAR_1}--\\nthey're my disciples.\\pDoesn't the idea of forming a tag-team\\npartnership intrigue you?$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicFAccept	{'body': "Thank you.\\nI'll go deal with the registration.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PsychicFReject	{'body': 'I hope there will be another chance\\nto forge an alliance.$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SchoolKidFIntro	{'body': "I'm SCHOOL KID {STR_VAR_1}!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SchoolKidFMon1	{'body': 'One {STR_VAR_1}-using {STR_VAR_2}$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SchoolKidFMon2Ask	{'body': 'and one {STR_VAR_1}-using\\n{STR_VAR_2} are my POKéMON pair.\\pMay I please be your partner on\\na tag team?$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SchoolKidFAccept	{'body': "Ooh, thank you!\\nI'll register at the counter right away!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SchoolKidFReject	{'body': 'Please?\\nMay I join you the next time?$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PkmnBreederFIntro	{'body': "Hiya! The name's {STR_VAR_1}!\\nI'm a POKéMON BREEDER!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PkmnBreederFMon1	{'body': "The POKéMON I've raised are one\\n{STR_VAR_1}-using {STR_VAR_2} and$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PkmnBreederFMon2Ask	{'body': 'one {STR_VAR_1}-using {STR_VAR_2}.\\pSound interesting?\\nHow about we form a tag team, then?$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PkmnBreederFAccept	{'body': 'All righty!\\nYou leave the registration to me!$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PkmnBreederFReject	{'body': 'You have to team up with me next time,\\nall right?$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PokefanFIntro	{'body': "I'm {STR_VAR_1}, and I'm proud to say\\nthat I am a POKéFAN.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PokefanFMon1	{'body': "The darling POKéMON I've raised are\\none {STR_VAR_2} with {STR_VAR_1} and$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PokefanFMon2Ask	{'body': "one {STR_VAR_2} with {STR_VAR_1}.\\pAren't they just the cutest?\\nWe ought to make a team!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PokefanFAccept	{'body': "Thank you, dear!\\nI'll be on my way to register!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.PokefanFReject	{'body': "My darling POKéMON are the best,\\nI'll have you know. How annoying!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerFIntro	{'body': "Hi, I'm SWIMMER {STR_VAR_1}.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerFMon1	{'body': 'One {STR_VAR_1}-using {STR_VAR_2}$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerFMon2Ask	{'body': "and one {STR_VAR_1}-using\\n{STR_VAR_2} are what I've trained.\\pYou and me, let's make a tag team.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerFAccept	{'body': "That's cool!\\nI'll register the two of us.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerFReject	{'body': 'If we meet again, you owe me\\na tag team!$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteMIntro	{'body': "What's happening?\\nI'm {STR_VAR_1}, and I'm a TRIATHLETE.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteMMon1	{'body': 'I got a couple decent POKéMON.\\nOne {STR_VAR_2} with {STR_VAR_1} and$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteMMon2Ask	{'body': "one {STR_VAR_2} with {STR_VAR_1}!\\pIt'd be neat if we made a tag team\\ntogether, so how about it?$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteMAccept	{'body': 'Right on!\\nYou wait while I register, okay?$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteMReject	{'body': "I expect you'll let me join you\\nnext time, how's that?$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteFIntro	{'body': "I'm the TRIATHLETE {STR_VAR_1}!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteFMon1	{'body': 'One {STR_VAR_2} with {STR_VAR_1} and$'}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteFMon2Ask	{'body': "another {STR_VAR_2} that knows how\\nto use {STR_VAR_1}. That's my pair.\\pWhat do you think?\\nWe'd make a good team, I'd say.$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteFAccept	{'body': "I like that answer!\\nI'll get done with registration fast!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmingTriathleteFReject	{'body': "You'll give me another chance to form\\na partnership, won't you?$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerMIntro	{'body': "Hi, there! Hello!\\nI'm {STR_VAR_1}, and I'm a SWIMMER!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerMMon1	{'body': "Check out what I've been raising!\\nOne {STR_VAR_2} with {STR_VAR_1} and$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerMMon2Ask	{'body': "one {STR_VAR_2} with {STR_VAR_1}!\\pSweet, huh?\\nIt'd be sweet to form a team, too!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerMAccept	{'body': "Much obliged!\\nI'll get this registration thing done!$"}
text:BattleFrontier_BattleTowerMultiPartnerRoom.SwimmerMReject	{'body': "If we meet again, you have to team up\\nwith me. You'll do that, right?$"}
text:BattleFrontier_ExchangeServiceCorner.WelcomePleaseChoosePrize	{'body': 'Hello, this is the EXCHANGE SERVICE\\nCORNER.\\pWe exchange the Battle Points you\\nhave collected for lovely prizes.\\pPlease choose a prize from this list.$'}
text:BattleFrontier_ExchangeServiceCorner.PleaseChoosePrize	{'body': 'Please choose a prize from this list.$'}
text:BattleFrontier_ExchangeServiceCorner.ConfirmPurchase	{'body': "You've chosen the {STR_VAR_1}.\\nIs that correct?$"}
text:BattleFrontier_ExchangeServiceCorner.WellSendItToPC	{'body': "Thank you!\\nWe'll send it to your PC at home.$"}
text:BattleFrontier_ExchangeServiceCorner.HereIsYourPrize	{'body': 'Here is your prize!$'}
text:BattleFrontier_ExchangeServiceCorner.DontHaveEnoughPoints	{'body': "I'm so sorry…\\nYou don't have enough Battle Points…$"}
text:BattleFrontier_ExchangeServiceCorner.PCIsFull	{'body': "I'm so sorry…\\nYour PC appears to be full…$"}
text:BattleFrontier_ExchangeServiceCorner.DontHaveSpaceToHoldIt	{'body': "I'm so sorry…\\nYou don't have space to hold it…$"}
text:BattleFrontier_ExchangeServiceCorner.ThankYouVisitWithPoints	{'body': 'Thank you very much.\\pPlease visit us when you have\\nsaved up Battle Points.$'}
text:BattleFrontier_ExchangeServiceCorner.WishIHadAllDolls	{'body': "Oh, they're so nice!\\nI wish I had them!\\lCute cushions!\\lBig plush DOLLS!\\lLittle plush DOLLS!\\lI wish I had them all!$"}
text:BattleFrontier_ExchangeServiceCorner.GetYouAnythingYouWant	{'body': "Leave it to your mommy!\\pIf it's anything you want, I'll go\\nthrough anything to get it, honey!$"}
text:BattleFrontier_ExchangeServiceCorner.ItemsWillGetMonTougher	{'body': 'I save Battle Points for supplies\\nand decorations.\\pEvolution tools cost cash at specialist\\nshops, or Battle Points here.$'}
text:BattleFrontier_ExchangeServiceCorner.GoGetYourOwnDoll	{'body': "Hah?\\nWhat are you gawking at?\\pI don't like you staring at my plush\\ndoll like that.\\pIf you want it, go get one yourself!\\nIsn't that right, SMOOCHUM?$"}
text:BattleFrontier_ExchangeServiceCorner.MoreBattlePointsForRecord	{'body': "Every CIRCUIT victory earns Battle\\nPoints. Longer streaks earn more.\\pI keep promising myself I'll save\\nthem. Then I see another plush DOLL!$"}
text:BattleFrontier_ExchangeServiceCorner.KissPosterDesc	{'body': 'A large poster with a SMOOCHUM print.$'}
text:BattleFrontier_ExchangeServiceCorner.KissCushionDesc	{'body': 'A SMOOCHUM cushion.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.SmoochumDollDesc	{'body': 'A SMOOCHUM DOLL.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.TogepiDollDesc	{'body': 'A TOGEPI DOLL.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.MeowthDollDesc	{'body': 'A MEOWTH DOLL.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.ClefairyDollDesc	{'body': 'A CLEFAIRY DOLL.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.DittoDollDesc	{'body': 'A DITTO DOLL.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.CyndaquilDollDesc	{'body': 'A CYNDAQUIL DOLL.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.ChikoritaDollDesc	{'body': 'A CHIKORITA DOLL.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.TotodileDollDesc	{'body': 'A TOTODILE DOLL.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.LargeDollDesc	{'body': 'A large DOLL.\\nPlace it on a mat or a desk.$'}
text:BattleFrontier_ExchangeServiceCorner.PPUpDesc	{'body': 'Raises the PP of one selected move.$'}
text:BattleFrontier_ExchangeServiceCorner.PPMaxDesc	{'body': "Fully raises one selected move's PP.$"}
text:BattleFrontier_ExchangeServiceCorner.MaxReviveDesc	{'body': 'Revives one POKéMON with full HP.$'}
text:BattleFrontier_ExchangeServiceCorner.SacredAshDesc	{'body': 'Revives every fainted party member.$'}
text:BattleFrontier_ExchangeServiceCorner.DreamBallDesc	{'body': 'A BALL that excels on sleeping POKéMON.$'}
text:BattleFrontier_ExchangeServiceCorner.BeastBallDesc	{'body': 'A rare BALL made for ULTRA BEASTS.$'}
text:BattleFrontier_ExchangeServiceCorner.LinkingCordDesc	{'body': 'Evolves certain trade-only POKéMON.$'}
text:BattleFrontier_ExchangeServiceCorner.ProtectorDesc	{'body': 'A stiff guard that evolves RHYDON.$'}
text:BattleFrontier_ExchangeServiceCorner.ElectirizerDesc	{'body': 'A box of energy that evolves\\nELECTABUZZ.$'}
text:BattleFrontier_ExchangeServiceCorner.MagmarizerDesc	{'body': 'A box of magma that evolves MAGMAR.$'}
text:BattleFrontier_ExchangeServiceCorner.ReaperClothDesc	{'body': 'A cloth filled with spiritual energy.$'}
text:BattleFrontier_ExchangeServiceCorner.RazorClawDesc	{'body': 'A sharp claw that evolves SNEASEL.$'}
text:BattleFrontier_ExchangeServiceCorner.SweetAppleDesc	{'body': 'A sweet apple that causes evolution.$'}
text:BattleFrontier_ExchangeServiceCorner.TartAppleDesc	{'body': 'A tart apple that causes evolution.$'}
text:BattleFrontier_ExchangeServiceCorner.PrismScaleDesc	{'body': 'A shining scale that evolves FEEBAS.$'}
text:BattleFrontier_ExchangeServiceCorner.AlreadyOwnCord	{'body': "You already own a LINKING CORD.\\nIt's reusable, so save your points!$"}
text:BattleFrontier_Lounge1.EvExplanation	{'body': 'For 70 years I have raised\\nPOKéMON!\\pEvery partner has the potential to\\ncompete. The one you caught today\\ldeserves that chance, too.\\pA CENTER tutor can help you choose\\nits Nature and EVs, or prepare a\\lfull battle set.\\pThen the two of you can get on\\nwith the adventure!$'}
text:BattleFrontier_Lounge1.EvReminder	{'body': 'Every POKéMON has flawless\\npotential.\\pUse a CENTER tutor to choose its\\nNature, moves, Ability, item, and\\lEVs.$'}
text:BattleFrontier_Lounge1.SaidMyMonIsOutstanding	{'body': 'My POKéMON was ready the moment I\\ncaught it!\\pNow I can focus on how it fits my team.$'}
text:BattleFrontier_Lounge1.DidntDoAnythingSpecialRaisingIt	{'body': "I changed my POKéMON's set at a\\nCENTER.\\pNo breeding for numbers, no grinding--\\njust a different battle plan.$"}
text:BattleFrontier_Lounge2.FrontierManiacIntro	{'body': "Howdy! When it comes to news about\\nthe BATTLE FRONTIER, I'm no. 1.\\pYou can think of me as\\nthe FRONTIER MANIAC.\\pJust checking, but you are a TRAINER,\\nisn't that right?\\pI'll happily share the hottest news\\nI gathered about the BATTLE FRONTIER.$"}
text:BattleFrontier_Lounge2.SwingByForTheLatestWord	{'body': 'Howdy! Did you swing by to grill me\\nabout the latest word? Oh, all right!$'}
text:BattleFrontier_Lounge2.MyInformationsBeenUsefulRight	{'body': "Well? Well? Well?\\pI'm sure my information's been\\nseriously useful to you, right?$"}
text:BattleFrontier_Lounge2.FacilityIsHottest	{'body': "Let's see now…\\pIt sounds like the {STR_VAR_1}\\nis the hottest place going.$"}
text:BattleFrontier_Lounge2.BattleTowerIsHottest	{'body': "Let's see now…\\pIt sounds like BATTLE TOWER\\n{STR_VAR_1} is the hottest.$"}
text:BattleFrontier_Lounge2.SalonMaidenIsThere	{'body': "Bet you didn't know this!\\pOne of those top TRAINERS that SCOTT\\ncalls the FRONTIER BRAINS is there.\\pIt's this mysterious TRAINER called\\nthe SALON MAIDEN that runs the place.$"}
text:BattleFrontier_Lounge2.SalonMaidenSilverMons	{'body': "Have you battled the SALON MAIDEN?\\pWhen she's measuring up her opponent,\\nshe apparently uses these POKéMON:\\pA PSYCHIC-type PSI POKéMON,\\na FIRE-type VOLCANO POKéMON,\\land a NORMAL-type SLEEPING POKéMON.$"}
text:BattleFrontier_Lounge2.SalonMaidenGoldMons	{'body': "Have you battled the SALON MAIDEN\\nwhen she's serious?\\pWhen she's battling flat out,\\nshe apparently uses these POKéMON:\\pA DRAGON & PSYCHIC EON POKéMON,\\nan ELECTRIC-type THUNDER POKéMON,\\land a NORMAL-type SLEEPING POKéMON.$"}
text:BattleFrontier_Lounge2.DomeAceIsThere	{'body': "Bet you didn't know this!\\pOne of those top TRAINERS that SCOTT\\ncalls the FRONTIER BRAINS is there.\\pIt's this flamboyant TRAINER called\\nthe DOME ACE that runs the place.$"}
text:BattleFrontier_Lounge2.DomeAceSilverMons	{'body': "Have you battled the DOME ACE?\\pWhen he's treating the opponent\\nlightly, he uses these three POKéMON:\\pA DRAGON & FLYING DRAGON POKéMON,\\na WATER & GROUND MUD FISH POKéMON,\\land a FIRE & FLYING FLAME POKéMON.$"}
text:BattleFrontier_Lounge2.DomeAceGoldMons	{'body': "Have you battled the DOME ACE\\nwhen he's serious?\\pWhen he's demonstrating his strategy,\\nhe uses these three POKéMON:\\pA DRAGON & FLYING EON POKéMON,\\na WATER & GROUND MUD FISH POKéMON,\\land a STEEL- & PSYCHIC-type IRON LEG\\lPOKéMON.$"}
text:BattleFrontier_Lounge2.FactoryHeadIsThere	{'body': "Bet you didn't know this!\\pOne of those top TRAINERS that SCOTT\\ncalls the FRONTIER BRAINS is there.\\pIt's this freaky TRAINER called\\nthe FACTORY HEAD that runs the place.$"}
text:BattleFrontier_Lounge2.FactoryHeadSilverMons	{'body': 'Have you battled the FACTORY HEAD\\nalready?\\pLet me think… When he goes to battle,\\nhe just gets three rental POKéMON.\\pHe battles under pretty much the same\\nconditions as you.$'}
text:BattleFrontier_Lounge2.FactoryHeadGoldMons	{'body': "Have you battled the FACTORY HEAD\\nwhen he's serious?\\pWhen he goes seriously to battle,\\nhe still gets three rental POKéMON.\\pHe battles under virtually the same\\nconditions as you.$"}
text:BattleFrontier_Lounge2.PikeQueenIsThere	{'body': "Bet you didn't know this!\\pOne of those top TRAINERS that SCOTT\\ncalls the FRONTIER BRAINS is there.\\pIt's this scary TRAINER called\\nthe PIKE QUEEN that runs the place.$"}
text:BattleFrontier_Lounge2.PikeQueenSilverMons	{'body': "Have you battled the PIKE QUEEN\\nbefore?\\pWhen she's in a good mood, they say\\nshe uses these three POKéMON:\\pA POISON-type FANG SNAKE POKéMON,\\na BUG & ROCK MOLD POKéMON,\\land a WATER-type TENDER POKéMON.$"}
text:BattleFrontier_Lounge2.PikeQueenGoldMons	{'body': "Have you battled the PIKE QUEEN\\nwhen she's serious?\\pWhen she's seriously annoyed, they say\\nshe uses these three POKéMON:\\pA POISON-type FANG SNAKE POKéMON,\\na STEEL & GROUND IRON SNAKE POKéMON,\\land a WATER- & FLYING-type ATROCIOUS\\lPOKéMON.$"}
text:BattleFrontier_Lounge2.ArenaTycoonIsThere	{'body': "Bet you didn't know this!\\pOne of those top TRAINERS that SCOTT\\ncalls the FRONTIER BRAINS is there.\\pIt's this cute TRAINER called\\nthe ARENA TYCOON that runs the place.$"}
text:BattleFrontier_Lounge2.ArenaTycoonSilverMons	{'body': "Have you battled the ARENA TYCOON\\nbefore?\\pWhen she's assessing the foe's ability,\\nshe supposedly uses these POKéMON:\\pA BUG & FIGHTING SINGLE HORN POKéMON,\\na DARK-type MOONLIGHT POKéMON,\\land a BUG & GHOST SHED POKéMON.$"}
text:BattleFrontier_Lounge2.ArenaTycoonGoldMons	{'body': "Have you battled the ARENA TYCOON\\nwhen she's serious?\\pWhen she battles for keeps,\\nshe supposedly uses these POKéMON:\\pA DARK-type MOONLIGHT POKéMON,\\na GHOST & POISON SHADOW POKéMON\\land a GRASS- & FIGHTING-type\\lMUSHROOM POKéMON.$"}
text:BattleFrontier_Lounge2.PalaceMavenIsThere	{'body': "Bet you didn't know this!\\pOne of those top TRAINERS that SCOTT\\ncalls the FRONTIER BRAINS is there.\\pIt's this sinister TRAINER called\\nthe PALACE MAVEN that runs the place.$"}
text:BattleFrontier_Lounge2.PalaceMavenSilverMons	{'body': "Have you battled the PALACE MAVEN\\nbefore?\\pWhen he's testing the opponent's\\nspirit, he's said to use these POKéMON:\\pA POISON & FLYING-type BAT POKéMON,\\na NORMAL-type LAZY POKéMON, and a\\lWATER- & ICE-type TRANSPORT POKéMON.$"}
text:BattleFrontier_Lounge2.PalaceMavenGoldMons	{'body': "Have you battled the PALACE MAVEN\\nwhen he's serious?\\pWhen he throws his entire might into\\nbattle, he's said to use these POKéMON:\\pA FIRE-type LEGENDARY POKéMON,\\na NORMAL-type LAZY POKéMON,\\land a WATER-type AURORA POKéMON.$"}
text:BattleFrontier_Lounge2.PyramidKingIsThere	{'body': "Bet you didn't know this!\\pOne of those top TRAINERS that SCOTT\\ncalls the FRONTIER BRAINS is there.\\pIt's this fiery-hot TRAINER called\\nthe PYRAMID KING that runs the place.$"}
text:BattleFrontier_Lounge2.PyramidKingSilverMons	{'body': "Have you battled the PYRAMID KING\\nbefore?\\pWhen he's checking the foe's power,\\nhe apparently uses these POKéMON:\\pA ROCK-type ROCK PEAK POKéMON,\\nan ICE-type ICEBERG POKéMON,\\land a STEEL-type IRON POKéMON.$"}
text:BattleFrontier_Lounge2.PyramidKingGoldMons	{'body': "Have you battled the PYRAMID KING\\nwhen he's serious?\\pWhen he's pumped with hot power,\\nhe apparently uses these POKéMON:\\pAn ICE & FLYING FREEZE POKéMON, an\\nELECTRIC & FLYING ELECTRIC POKéMON,\\land a FIRE- & FLYING-type FLAME\\lPOKéMON.$"}
text:BattleFrontier_Lounge2.DoubleBattleAdvice1	{'body': "Sure, there are several places where\\nyou can enter DOUBLE BATTLES.\\pBut the DOUBLE BATTLE ROOMS of\\nthe BATTLE TOWER are, like, basic!\\pThey're where you should learn about\\nhow DOUBLE BATTLES are played here\\lin the BATTLE FRONTIER.$"}
text:BattleFrontier_Lounge2.DoubleBattleAdvice2	{'body': 'Watch yourself in the battles here.\\pI hear there are TRAINERS that have\\nstrategies they developed just for\\lDOUBLE BATTLES.$'}
text:BattleFrontier_Lounge2.DoubleBattleAdvice3	{'body': "Once you're confident and comfortable\\nwith DOUBLE BATTLES here, you should\\lthink about challenging other places\\loffering DOUBLE BATTLES.$"}
text:BattleFrontier_Lounge2.MultiBattleAdvice	{'body': 'All sorts of TRAINERS gather in\\nthe BATTLE SALON.\\pJust think--you may run into your\\nfriends or followers!\\lYou should look carefully!$'}
text:BattleFrontier_Lounge2.LinkMultiBattleAdvice	{'body': "If you're with a friend, head for the\\nLINK MULTI BATTLE ROOM.\\pIf you play with a strong friend,\\nyou can expect to see tough foes!$"}
text:BattleFrontier_Lounge2.NewsGatheringPower	{'body': "What amazing news-gathering power!\\nMy mentor's like none other!$"}
text:BattleFrontier_Lounge2.AmazingPowersOfObservation	{'body': "What amazing powers of observation!\\nMy mentor's like none other!$"}
text:BattleFrontier_Lounge2.AmazingPowerOfPersuasion	{'body': "What amazing power of persuasion!\\nMy mentor's like none other!$"}
text:BattleFrontier_Lounge2.ThisPlaceIsScaringMe	{'body': "…What is this place?\\nIt's scaring me…$"}
text:BattleFrontier_Lounge2.CurrentCircuitNews	{'body': "Here's the latest: every desk\\nenters the CHAMPIONS CIRCUIT!\\pDifferent buildings, one central\\narena, and plenty of different\\lteams to argue about.$"}
text:BattleFrontier_Lounge3.CantYouSeeWereBusyHere	{'body': "…What's that you want?\\pCan't you see we're kind of busy here?\\nCan't your business wait till later?$"}
text:BattleFrontier_Lounge3.YouLookToughExplainGambling	{'body': "…Huh?\\nYou look to me like a tough TRAINER.\\pHeheh…\\nListen, I have this proposition.\\pWe have a little group going here,\\nand we play a little game with what\\lgoes on in the BATTLE FRONTIER.\\pThe rules are really simple.\\pFirst, we pick one of the facilities\\nin the BATTLE FRONTIER.\\pThen, we each pick a different TRAINER\\nwho's taking that facility's challenge,\\land bet with our Battle Points.\\pThe guy who bet on the TRAINER with\\nthe best record takes all the Battle\\lPoints in the pool.\\pSounds simple, huh?\\nSo, anyway…$"}
text:BattleFrontier_Lounge3.ChallengeBattleTowerSingle	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be challenging the BATTLE\\lTOWER's SINGLE BATTLE ROOMS.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattleTowerDouble	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be challenging the BATTLE\\lTOWER's DOUBLE BATTLE ROOMS.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattleTowerMulti	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be challenging the BATTLE\\lTOWER's MULTI BATTLE ROOMS.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattleDomeSingle	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be entering the BATTLE\\lDOME's SINGLE BATTLE Tourney.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattleDomeDouble	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be entering the BATTLE\\lDOME's DOUBLE BATTLE Tourney.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattleFactorySingle	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be entering the BATTLE\\lFACTORY's Battle Swap Single Tourney.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattleFactoryDouble	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be entering the BATTLE\\lFACTORY's Battle Swap Double Tourney.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattlePalaceSingle	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be challenging the BATTLE\\lPALACE's SINGLE BATTLE HALLS.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattlePalaceDouble	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be challenging the BATTLE\\lPALACE's DOUBLE BATTLE HALLS.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattleArena	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be entering the BATTLE\\lARENA's Set KO Tourney.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattlePike	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be entering the BATTLE PIKE's\\lBattle Choice.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.ChallengeBattlePyramid	{'body': "What I'm looking for is a TRAINER who's\\ngoing to be entering the BATTLE\\lPYRAMID's Battle Quest.\\pBut so far, I haven't seen a TRAINER\\nthat has that winning quality.$"}
text:BattleFrontier_Lounge3.HowAboutEnteringEventForMe	{'body': "I'll see to it that you benefit, too.\\nSo how about it?\\lHow about entering that event for me?$"}
text:BattleFrontier_Lounge3.SpotMeSomeBattlePoints	{'body': "All right, that's perfect.\\nSo, uh… How about spotting me some\\lof your Battle Points?\\pTrust me, I'll show you my gratitude\\nafterward.$"}
text:BattleFrontier_Lounge3.HowMuchCanYouSpot	{'body': 'Great, great!\\nSo, how much can you spot me?$'}
text:BattleFrontier_Lounge3.YouDontHaveEnoughPoints	{'body': "Oh, no, no, no!\\nYou don't have enough Battle Points!\\pI wish you wouldn't monkey around and\\nwaste everyone's time!$"}
text:BattleFrontier_Lounge3.ThanksOffYouGo	{'body': 'Heheh! Thanks much!\\nSo, off you go!$'}
text:BattleFrontier_Lounge3.GetToBattleTowerSingle	{'body': "Get to the BATTLE TOWER's\\nSINGLE BATTLE ROOMS pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattleTowerDouble	{'body': "Get to the BATTLE TOWER's\\nDOUBLE BATTLE ROOMS pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattleTowerMulti	{'body': "Get to the BATTLE TOWER's\\nMULTI BATTLE ROOMS pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattleDomeSingle	{'body': "Get to the BATTLE DOME's\\nSINGLE BATTLE Tourney pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattleDomeDouble	{'body': "Get to the BATTLE DOME's\\nDOUBLE BATTLE Tourney pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattleFactorySingle	{'body': "Get to the BATTLE FACTORY's\\nBattle Swap Single Tourney pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattleFactoryDouble	{'body': "Get to the BATTLE FACTORY's\\nBattle Swap Double Tourney pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattlePalaceSingle	{'body': "Get to the BATTLE PALACE's\\nSINGLE BATTLE HALLS pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattlePalaceDouble	{'body': "Get to the BATTLE PALACE's\\nDOUBLE BATTLE HALLS pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattleArena	{'body': "Get to the BATTLE ARENA's\\nSet KO Tourney pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattlePike	{'body': "Get to the BATTLE PIKE's\\nBattle Choice pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.GetToBattlePyramid	{'body': "Get to the BATTLE PYRAMID's\\nBattle Quest pronto!\\pIt's a must-win situation!\\nDon't blow your chance!\\lBoth of our futures depend on you!$"}
text:BattleFrontier_Lounge3.NiceTryCantReturnPoints	{'body': "Oh, it's you…\\nNice try…\\pI hate to break it to you, but I can't\\nreturn your Battle Points…\\pI guess we'll have to let it motivate\\nus to try harder next time!$"}
text:BattleFrontier_Lounge3.HelloChampHeresYourPoints	{'body': "Oh, yes!\\nHello there, champ!\\pI knew you could!\\nI knew you would!\\lWe're both big winners!\\pI'll return your Battle Points and,\\nof course, a little extra from me!$"}
text:BattleFrontier_Lounge3.ObtainedBattlePoints	{'body': '{PLAYER} obtained\\n{STR_VAR_1} Battle Points.$'}
text:BattleFrontier_Lounge3.ThinkOfMeForAnotherChallenge	{'body': "If you're up for another challenge,\\nplease do think of me!$"}
text:BattleFrontier_Lounge3.NotInterested	{'body': "Not interested?! You shouldn't be\\nso afraid to take a chance!$"}
text:BattleFrontier_Lounge3.Oh	{'body': 'Oh…$'}
text:BattleFrontier_Lounge3.BackedWrongTrainer	{'body': 'I backed the wrong TRAINER again!\\pMaybe I should be battling normally\\nlike everyone else…$'}
text:BattleFrontier_Lounge3.TrainerGoodButRattled	{'body': "That TRAINER…\\pHe's good, but he gets rattled too\\neasily to survive the BATTLE DOME…$"}
text:BattleFrontier_Lounge3.KnowWinnerWhenISeeOne	{'body': 'Giggle!\\nI know a winner when I see one!$'}
text:BattleFrontier_Lounge3.ShouldBeTakingChallenges	{'body': 'Those TRAINERS…\\nWhat are they doing?\\lThey should be taking challenges.$'}
text:BattleFrontier_Lounge3.CurrentObserver	{'body': "I used to wager on the old\\nFrontier events.\\pNow I watch the CIRCUIT and argue\\nabout teams. It's cheaper...\\lusually.$"}
text:BattleFrontier_Lounge4.WonderIfInterviewsAiring	{'body': "I wonder if they'll be airing interviews\\nwith tough TRAINERS today?$"}
text:BattleFrontier_Lounge4.IfIOpenedRestaurantHere	{'body': "If I opened a restaurant here,\\nit'd make money for sure.$"}
text:BattleFrontier_Lounge4.NeedBreatherAfterBattles	{'body': 'Whew…\\pI need to take a breather after\\nsome intense battles…\\pBut even now, I never take a break\\nfrom plotting strategy and combos.$'}
text:BattleFrontier_Lounge5.NatureGirlGreeting	{'body': 'Ehehe! I make up little stories\\nabout what POKéMON are thinking!\\pThey still listen to you in battle.\\nPlease! Can I see your POKéMON?$'}
text:BattleFrontier_Lounge5.NatureGirlNoneShown	{'body': 'Boo!\\nCheapie!$'}
text:BattleFrontier_Lounge5.NatureGirlAttackHighAttackLow	{'body': 'Hmhm…\\pThis one says it likes to battle!\\nIt will battle even if it has a lot\\lof ouchies!$'}
text:BattleFrontier_Lounge5.NatureGirlAttackHighDefenseLow	{'body': 'Hmhm…\\pThis one says it likes to battle!\\nBut if it gets enough ouchies,\\lit will worry about itself!$'}
text:BattleFrontier_Lounge5.NatureGirlAttackHighSupportLow	{'body': 'Hmhm…\\pThis one says it likes to battle!\\nBut if it gets enough ouchies,\\lit will turn sneaky!$'}
text:BattleFrontier_Lounge5.NatureGirlDefenseHighAttackLow	{'body': 'Hmhm…\\pThis one says it looks after itself!\\nBut if it gets enough ouchies,\\lit will hit back!$'}
text:BattleFrontier_Lounge5.NatureGirlDefenseHighDefenseLow	{'body': 'Hmhm…\\pThis one says it looks after itself!\\nIt says it worries about itself whether\\lor not it has a lot of ouchies!$'}
text:BattleFrontier_Lounge5.NatureGirlDefenseHighSupportLow	{'body': 'Hmhm…\\pThis one says it looks after itself!\\nBut if it gets enough ouchies,\\lit will turn sneaky!$'}
text:BattleFrontier_Lounge5.NatureGirlSupportHighAttackLow	{'body': 'Hmhm…\\pThis one says it likes to be sneaky!\\nBut if it gets enough ouchies,\\lit will hit back!$'}
text:BattleFrontier_Lounge5.NatureGirlSupportHighDefenseLow	{'body': 'Hmhm…\\pThis one says it likes to be sneaky!\\nBut if it gets enough ouchies,\\lit will worry about itself!$'}
text:BattleFrontier_Lounge5.NatureGirlSupportHighSupportLow	{'body': 'Hmhm…\\pThis one says it likes to be sneaky!\\nIt says it likes to be sneaky even\\lif it has a lot of ouchies!$'}
text:BattleFrontier_Lounge5.NatureGirlEgg	{'body': "That's silly! An EGG is asleep!\\nI can't talk to it!$"}
text:BattleFrontier_Lounge5.LadyClaimsSheUnderstandsPokemon	{'body': 'How charming!\\nThat little lady claims she can\\lunderstand POKéMON!$'}
text:BattleFrontier_Lounge5.GirlSayingSomethingProfound	{'body': 'I have this feeling that the little girl\\nis saying something profound.$'}
text:BattleFrontier_Lounge5.GirlPlaysAtRedHouseALot	{'body': 'I know something!\\pThat little girl plays at the red house\\na lot!$'}
text:BattleFrontier_Lounge6.WouldYouLikeToTrade	{'body': 'My POKéMON is a {STR_VAR_2}.\\nIt was built to become anything.\\pI think it needs a TRAINER who will\\nhelp it discover what it wants to be.\\pWould you trade me a {STR_VAR_1}\\nfor my {STR_VAR_2}?$'}
text:BattleFrontier_Lounge6.PromiseIllBeGoodToIt	{'body': "Oh, it's adorable! Thank you! I\\npromise I'll be good to it.\\pTYPE: NULL already has a battle\\nset. Raise its friendship, then\\llevel it up to get SILVALLY.\\pA memory held by SILVALLY changes\\nits type.$"}
text:BattleFrontier_Lounge6.DontTradeForAnythingButMon	{'body': "Oh, I'm sorry!\\nI don't intend to trade for anything\\lbut a {STR_VAR_1}.$"}
text:BattleFrontier_Lounge6.WellThatsFineToo	{'body': "Oh, you won't?\\nWell, that's fine, too.\\lPlease come visit us again.$"}
text:BattleFrontier_Lounge6.SkittySoMuchCuterThanImagined	{'body': "Giggle!\\nA SKITTY is so much cuter than I had\\limagined. I'm delighted!$"}
text:BattleFrontier_Lounge7.LeftTutorIntro	{'body': "Buhahaha!\\pYou couldn't tell it from looking now,\\nbut I used to be one tough TRAINER.\\pI had a reputation as the toughest\\nBEAUTY around, I tell you!\\p… … … … … …\\pWhat is it now?\\nYou don't believe me.\\pI'm not like that blowhard woman over\\nthere. I'm actually talented!\\pLet me prove it to you.\\nI can teach your POKéMON special and\\lyet cute moves.\\pBut my lessons don't come free.\\nHow about paying for the moves I teach\\lwith a wee bit of Battle Points?$"}
text:BattleFrontier_Lounge7.LeftTutorWelcomeBack	{'body': 'Buhahaha!\\pAre you back to learn special and\\nyet cute POKéMON moves?$'}
text:BattleFrontier_Lounge7.TeachWhichMove	{'body': 'Fine, fine, look here!\\nWhich move should I teach?$'}
text:BattleFrontier_Lounge7.MoveWillBeXBattlePoints	{'body': 'The move {STR_VAR_1}, is it?\\nThat will be {STR_VAR_2} Battle Points, okay?$'}
text:BattleFrontier_Lounge7.TeachMoveToWhichMon	{'body': 'Fine, fine, now pick the POKéMON\\nI should teach the move to.$'}
text:BattleFrontier_Lounge7.HaventGotEnoughPoints	{'body': "What the…\\nYou haven't got enough Battle Points!$"}
text:BattleFrontier_Lounge7.IllTakeBattlePoints	{'body': "Do you see how skilled I am now?\\nI'll take your Battle Points, thanks!$"}
text:BattleFrontier_Lounge7.YouDontWantTo	{'body': "What's that?\\nYou don't want to…\\pIf you want to see how skilled I am,\\nyou come see me anytime!$"}
text:BattleFrontier_Lounge7.RightTutorIntro	{'body': "Ihihihi!\\pI know it's hard to see now, but I used\\nto be one fantastic TRAINER.\\pI had a reputation as the most\\ninvincible SWIMMER around, I tell you!\\p… … … … … …\\pWhat's wrong?\\nYou don't believe me.\\pI'm not like that buffoonish woman over\\nthere. I'm actually experienced!\\pI can prove it to you.\\nI can teach your POKéMON hard and\\lyet pretty moves.\\pBut my lessons don't come free.\\nHow about paying for the moves I teach\\lwith a wee bit of Battle Points?$"}
text:BattleFrontier_Lounge7.RightTutorWelcomeBack	{'body': 'Ihihihi!\\pHave you come to learn hard and\\nyet pretty POKéMON moves?$'}
text:BattleFrontier_Lounge7.ThinkLadiesDontGetAlong	{'body': "Those ladies, the way they bad-mouth\\neach other, you probably think that\\lthey don't get along.\\pBut if that were true, they wouldn't\\nstay out here together, would they?$"}
text:BattleFrontier_Lounge7.LadiesWereStrongAndBeautiful	{'body': "When I was just a wee YOUNGSTER,\\nthose ladies were strong and beautiful.\\pThey were idols among us TRAINERS.\\pEven now, age hasn't dulled their\\nabilities.\\pIn fact, their POKéMON moves have\\ngrown even more polished.\\pBut… For some reason, I can't help\\nbut feel this…\\pTime is so cruel…$"}
text:BattleFrontier_Lounge7.SoftboiledDesc	{'body': "Recovers up to\\nhalf the user's\\nmaximum HP.$"}
text:BattleFrontier_Lounge7.SeismicTossDesc	{'body': "Inflicts damage\\nidentical to the\\nuser's level.$"}
text:BattleFrontier_Lounge7.DreamEaterDesc	{'body': 'Recovers half the\\ndamage inflicted\\non a sleeping foe.$'}
text:BattleFrontier_Lounge7.MegaPunchDesc	{'body': 'A strong punch\\nthrown with\\nincredible power.$'}
text:BattleFrontier_Lounge7.MegaKickDesc	{'body': 'An extremely\\npowerful kick with\\nintense force.$'}
text:BattleFrontier_Lounge7.BodySlamDesc	{'body': 'A full-body slam\\nthat may cause\\nparalysis.$'}
text:BattleFrontier_Lounge7.RockSlideDesc	{'body': 'Large boulders\\nare hurled. May\\ncause flinching.$'}
text:BattleFrontier_Lounge7.CounterDesc	{'body': 'Retaliates any\\nphysical hit with\\ndouble the power.$'}
text:BattleFrontier_Lounge7.ThunderWaveDesc	{'body': 'A weak jolt of\\nelectricity that\\nparalyzes the foe.$'}
text:BattleFrontier_Lounge7.SwordsDanceDesc	{'body': 'A fighting dance\\nthat sharply\\nraises ATTACK.$'}
text:BattleFrontier_Lounge7.DefenseCurlDesc	{'body': 'Curls up to con-\\nceal weak spots\\nand raise DEFENSE.$'}
text:BattleFrontier_Lounge7.SnoreDesc	{'body': 'A loud attack\\nthat can be used\\nonly while asleep.$'}
text:BattleFrontier_Lounge7.MudSlapDesc	{'body': "Hurls mud in the\\nfoe's face to re-\\nduce its accuracy.$"}
text:BattleFrontier_Lounge7.SwiftDesc	{'body': 'Sprays star-\\nshaped rays\\nthat never miss.$'}
text:BattleFrontier_Lounge7.IcyWindDesc	{'body': "A chilling attack\\nthat lowers the\\nfoe's SPEED.$"}
text:BattleFrontier_Lounge7.EndureDesc	{'body': 'Endures any at-\\ntack for 1 turn,\\nleaving 1HP.$'}
text:BattleFrontier_Lounge7.PsychUpDesc	{'body': "Copies the foe's\\neffect(s) and\\ngives to the user.$"}
text:BattleFrontier_Lounge7.IcePunchDesc	{'body': 'An icy punch\\nthat may\\nfreeze the foe.$'}
text:BattleFrontier_Lounge7.ThunderPunchDesc	{'body': 'An electrified\\npunch that may\\nparalyze the foe.$'}
text:BattleFrontier_Lounge7.FirePunchDesc	{'body': 'A fiery punch\\nthat may burn\\nthe foe.$'}
text:BattleFrontier_Lounge7.LeftTutorFree	{'body': "Buhahaha! I was the toughest\\nBEAUTY around, and I still know a\\lbeautiful move when I see one!\\pDon't mind her boasting over\\nthere. My lessons are free. Let's\\lsee your POKéMON!$"}
text:BattleFrontier_Lounge7.RightTutorFree	{'body': "Ihihihi! I was winning battles\\nwhile swimming against the\\lcurrent!\\pShe'll tell you she was better.\\nLet her talk! My lessons are free.\\lLet's see your POKéMON!$"}
text:BattleFrontier_Lounge8.WhatATrainerNeeds	{'body': "What a TRAINER needs…\\pKnowledge…\\nStrategy…\\lLuck…\\lGuts…\\lSpirit…\\lBravery…\\lAnd ability…\\pWell, I'm all set in every way!\\nI'll be unstoppable at every building!\\pHuh? POKéMON?\\nWhat's that?$"}
text:BattleFrontier_Lounge8.KnowAboutFrontierBrains	{'body': "Do you know about the FRONTIER\\nBRAINS?\\pThat's what SCOTT calls the seven\\nspecial TRAINERS that run the seven\\lfacilities in the BATTLE FRONTIER.$"}
text:BattleFrontier_Lounge8.ToldMeIHaveTalentForBattling	{'body': "At the BATTLE TOWER, an older girl\\ntold me that I have a lot of talent\\lfor battling!\\pI like POKéMON CONTESTS more!\\pBut I'm no good at CONTESTS!\\pI guess having talent and liking\\nsomething aren't the same.$"}
text:BattleFrontier_Lounge9.QuietMoment	{'body': 'I come here between challenges.\\pA quiet moment helps me think\\nabout what to try next.$'}
text:BattleFrontier_Mart.ChaperonGrandson	{'body': "We came here to chaperon our\\ngrandson.\\pBut since we're here, we thought\\nwe should get some souvenirs.$"}
text:BattleFrontier_Mart.CaptureBallsMakeNiceGift	{'body': "Dear, what do you think of this?\\nWouldn't these BALLS make a nice gift?\\pOur grandson is always searching for\\none more teammate.$"}
text:BattleFrontier_Mart.FacilitiesDontAllowItems	{'body': "Trainer battles here don't allow\\nitems from the BAG.\\pPrepare held items before entering\\nthe CHAMPIONS CIRCUIT.$"}
text:BattleFrontier_OutsideEast.BattleTowerSign	{'body': 'This is the BATTLE TOWER!\\nKeep the win streak as the toughest\\lTRAINER!$'}
text:BattleFrontier_OutsideEast.BattlePalaceSign	{'body': 'This is the BATTLE PALACE!\\nKeep your eyes on POKéMON battles!$'}
text:BattleFrontier_OutsideEast.BattleArenaSign	{'body': 'This is the BATTLE ARENA!\\nLet the toughest teams gather!$'}
text:BattleFrontier_OutsideEast.BattlePyramidSign	{'body': 'BATTLE PYRAMID\\pCHAMPIONS CIRCUIT RECEPTION\\nCentral arena: BATTLE TOWER$'}
text:BattleFrontier_OutsideEast.RankingHallSign	{'body': 'BATTLE FRONTIER RANKING HALL\\nSet your sights on new records!$'}
text:BattleFrontier_OutsideEast.ExchangeCornerSign	{'body': 'BATTLE POINT EXCHANGE SERVICE CORNER\\nExchange your Battle Points!$'}
text:BattleFrontier_OutsideEast.BattleTowerFeelsSpecial	{'body': "Wow!\\nIt's huge!\\pThe BATTLE TOWER feels special.\\nIt's different from the others.$"}
text:BattleFrontier_OutsideEast.ConquerLeagueAndFrontier	{'body': "My grand ambition is to conquer both\\nthe BATTLE FRONTIER and the POKéMON\\lLEAGUE.\\pAnd if my dream comes true…\\pI… I'm going to ask MIMI next door\\nif she will be friends with me!$"}
text:BattleFrontier_OutsideEast.PyramidTooHarsh	{'body': 'The CIRCUIT is too harsh! I keep\\nlosing at the same point.\\pMaybe I should change my plan\\ninstead of climbing this pyramid.$'}
text:BattleFrontier_OutsideEast.ThriveInDarkness	{'body': 'I thrive in darkness...\\pA quiet pyramid, a difficult team\\nto build, and nobody interrupting\\lmy thoughts...$'}
text:BattleFrontier_OutsideEast.PutTogetherUltimateTeam	{'body': "I didn't sleep for a week, but then\\nI put together the ultimate team!\\pI can't see myself losing, no joke.\\nWe're storming the BATTLE ARENA!$"}
text:BattleFrontier_OutsideEast.DidScottBringYouHere	{'body': "Did SCOTT bring you here, too?\\nWhat is it with that guy?\\pIt sounds like he really does know\\nhow to spot talented TRAINERS, but…\\pI've never seen him battling in person\\never.$"}
text:BattleFrontier_OutsideEast.BelieveInYouBuddy	{'body': "ZIGG!\\nI believe in you, little buddy!\\pI'll make my little ZIGG any favorite\\ntasty treats you like if you win!$"}
text:BattleFrontier_OutsideEast.ZigzagoonLooksVacant	{'body': 'ZIGZAGOON looks vacant…$'}
text:BattleFrontier_OutsideEast.PeopleCallMeBusybody	{'body': 'People call me a busybody. I keep\\nspotting something to fix!\\pThat habit helps in doubles. There\\nare two sides of the board to\\lwatch at once.$'}
text:BattleFrontier_OutsideEast.OnceBeatGymLeader	{'body': 'I may not look that impressive now,\\nbut I once beat a GYM LEADER.\\pWho knows, maybe I should give it\\nanother shot at glory.$'}
text:BattleFrontier_OutsideEast.FastOnBikeAndBattles	{'body': "I'm fast on my BIKE, and that goes for\\nthe way I battle, too.\\pI win matches in the blink of\\nan eye!$"}
text:BattleFrontier_OutsideEast.BetterThanDaddyAtPokemon	{'body': "I'm better than my daddy\\nat POKéMON.$"}
text:BattleFrontier_OutsideEast.GoRackUpSomeWinsForDaddy	{'body': "Go on, my baby sweetie!\\nGo rack up some wins for Daddy!\\pYou're just like your mother,\\nso you'll be dominating!$"}
text:BattleFrontier_OutsideEast.HeardPrettyGirlAtBattleArena	{'body': "It wasn't easy getting here,\\nbut I'd heard about this knockout\\lpretty girl at the BATTLE ARENA.\\pInstead of her, do you know what\\nI found?\\pA whole teeming mob of sweaty,\\nstinky, and primitive martial artists!$"}
text:BattleFrontier_OutsideEast.SometimesImportantOldManInThere	{'body': 'I sometimes see this really important-\\nlooking old man going in there.\\pHe has these really awesome POKéMON.\\nHe seems really nice, though.$'}
text:BattleFrontier_OutsideEast.LegendOfBattlePyramid	{'body': "Do you know it?\\nThe legend of the BATTLE PYRAMID?\\pWhen there comes a confident TRAINER\\nreaching for the golden pinnacle,\\lthere shall appear a man among men.\\pDon't know that legend?\\nWell, of course not!\\lI just made it up!\\pWhat's it supposed to mean?\\nThat, my friend, I can't say!$"}
text:BattleFrontier_OutsideEast.GotWipedOut	{'body': "Man! Oh man!\\nI've never lost once before!\\pBut I got wiped out with no saving\\ngrace at all!\\pAnd then I'm told I don't have any\\ntalent?! Man!$"}
text:BattleFrontier_OutsideEast.ToughTrainerInBattleTower	{'body': 'This guy ran into a horribly tough\\nTRAINER while he was on the BATTLE\\lTOWER challenge.\\pNow look at him…\\pYou need to be cautious if you ever\\ndecide to go to the BATTLE TOWER.$'}
text:BattleFrontier_OutsideEast.EnoughBattlePointsForDoll	{'body': "Yes! Enough Battle Points at last!\\nI'm getting a giant plush DOLL.\\lIt has a place waiting on my bed.$"}
text:BattleFrontier_OutsideEast.LikeToHaveNameRecordedHere	{'body': "Oh, yeah, okay!\\nSo this is the RANKING HALL!\\pI'd like to go down in history as\\na super champ and have my name\\lrecorded here for posterity.$"}
text:BattleFrontier_OutsideEast.CanDoAnythingWithYou	{'body': 'With you by my side, I can do anything.$'}
text:BattleFrontier_OutsideEast.PowerOfOurLoveWillOvercome	{'body': "Let's sit down and build a team\\ntogether, darling!\\pSix partners that support one\\nanother. Then we can each see how\\lfar our plan goes!$"}
text:BattleFrontier_OutsideEast.FrontierNotExclusivelyForToughTrainers	{'body': "The BATTLE FRONTIER isn't exclusively\\nfor tough TRAINERS.\\pMany people with special abilities\\nhave been invited, it seems.\\pThat man SCOTT…\\pHe may have built this place to serve\\na bigger objective…$"}
text:BattleFrontier_OutsideEast.OddTreeHereSeemsToWiggle	{'body': 'Excuse me, young one.\\nHave you good eyesight?\\pThere is an odd tree past here, and to\\nmy tired eyes it seems to wiggle.$'}
text:BattleFrontier_OutsideEast.OnceAnOddTreePastHere	{'body': 'Excuse me, young one.\\nHave you a good memory?\\pI have this feeling there once was\\nan odd tree past here.$'}
text:BattleFrontier_OutsideEast.StickyMonWithLongTail	{'body': 'I…\\nI saw it!\\pThere was a sticky sort of a POKéMON\\nwith a long tail up ahead!\\pIt was hiding under a boulder, and\\nit kept staring at me!$'}
text:BattleFrontier_OutsideWest.BattleDomeSign	{'body': 'This is the BATTLE DOME!\\nYour path to the invincible superstar!$'}
text:BattleFrontier_OutsideWest.BattleFactorySign	{'body': 'This is the BATTLE FACTORY!\\nSeek out the toughest POKéMON!$'}
text:BattleFrontier_OutsideWest.BattlePikeSign	{'body': 'BATTLE PIKE\\pCHAMPIONS CIRCUIT RECEPTION\\nCentral arena: BATTLE TOWER$'}
text:BattleFrontier_OutsideWest.ThisIsBattleTower	{'body': 'This is the BATTLE TOWER.\\nThe CHAMPIONS CIRCUIT holds its\\ldoubles matches in the central arena.$'}
text:BattleFrontier_OutsideWest.MayISeeYourTicket	{'body': 'Hello, are you here for the ferry?\\nMay I confirm your ferry pass?$'}
text:BattleFrontier_OutsideWest.MustHaveTicketToBoard	{'body': "Your ferry pass is not registered.\\pI'm terribly sorry.\\pYou need a registered pass to board\\nthe ferry.$"}
text:BattleFrontier_OutsideWest.WhereWouldYouLikeToGo	{'body': "The attendant confirmed your ferry\\npass.\\pPerfect! That's all you need!\\pAnd where would you like to go?$"}
text:BattleFrontier_OutsideWest.SlateportItIs	{'body': 'SLATEPORT CITY it is, then!$'}
text:BattleFrontier_OutsideWest.LilycoveItIs	{'body': 'LILYCOVE CITY it is, then!$'}
text:BattleFrontier_OutsideWest.SailWithUsAnotherTime	{'body': 'Please sail with us another time!$'}
text:BattleFrontier_OutsideWest.PleaseBoardFerry	{'body': 'Please board the ferry and wait for\\ndeparture.$'}
text:BattleFrontier_OutsideWest.ThenWhereWouldYouLikeToGo	{'body': 'Then, where would you like to go?$'}
text:BattleFrontier_OutsideWest.BestOutOfAllMyFriends	{'body': "I'm the best out of all my friends.\\nBut here…\\lI've been useless!$"}
text:BattleFrontier_OutsideWest.CantFindBattleTower	{'body': "I want to go to the BATTLE TOWER,\\nbut I can't find it even though I have\\la map of the BATTLE FRONTIER.\\pThis place is just too big!$"}
text:BattleFrontier_OutsideWest.GotSeasickOnWayHere	{'body': 'I wanted to take a challenge as soon\\nas I arrived here.\\pBut on the way, I got seasick…\\nUrrrrp…$'}
text:BattleFrontier_OutsideWest.OnlyToughTrainersBroughtHere	{'body': "It's not as if just anyone can come\\nhere, you know?\\pOnly those TRAINERS who've been\\nrecognized as tough are brought here.\\pThat's why many TRAINERS don't even\\nknow about the BATTLE FRONTIER.$"}
text:BattleFrontier_OutsideWest.SureWeCanChallengeWithNoMons	{'body': "Hey, bro... We need six Pokémon\\nfor the CIRCUIT.\\pLet's visit the CENTER and finish\\nour team first.$"}
text:BattleFrontier_OutsideWest.BigGuySaidIllLendYouMons	{'body': 'That big fellow showed me how to\\nprepare a set at the CENTER.\\pHe said the team still needs to be\\nours. Fair enough!$'}
text:BattleFrontier_OutsideWest.WhosRaisingThoseRentalMons	{'body': "That's the BATTLE FACTORY. Its\\ndesk also enters the CIRCUIT.\\pWho prepares all those opposing\\nteams? I'd like to compare notes!$"}
text:BattleFrontier_OutsideWest.ScaredOfPikeBecauseSeviper	{'body': "I'm scared of going into the BATTLE\\nPIKE because of SEVIPER…\\pB-but I came all the way here, so I will\\ntry to conquer everything!\\l…Shudder…$"}
text:BattleFrontier_OutsideWest.LetsPlayRockPaperScissors	{'body': "Let's play rock, paper, scissors!\\nOne, two, three!\\p… … … … … …$"}
text:BattleFrontier_OutsideWest.WonIllTakePikeChallenge	{'body': "I won! I'll register at the PIKE\\nand start another Circuit run!$"}
text:BattleFrontier_OutsideWest.LostIllPutOffPikeChallenge	{'body': "I lost. Maybe that's my cue to\\nreview my team before the CIRCUIT.$"}
text:BattleFrontier_OutsideWest.ChooseFishingOverBattling	{'body': "I came to fish instead of battle.\\pI'll try the water and see what\\nbites. A good partner can be its\\lown reward.$"}
text:BattleFrontier_OutsideWest.KeepBattlingUntilIGetSymbol	{'body': "I'm going to keep battling until I\\nbeat my best Circuit streak!$"}
text:BattleFrontier_OutsideWest.YoureOffToChallengeDome	{'body': "Registering at the DOME? Good luck!\\nWe'll both end up at the TOWER arena.\\lMaybe I'll see you there.$"}
text:BattleFrontier_OutsideWest.DomeIsHereGrandpa	{'body': "Grandpa, over here!\\nThe BATTLE DOME is here!\\lGo get 'em, Grandpa!$"}
text:BattleFrontier_OutsideWest.WontLetGentlemenBeatMe	{'body': "Ah, so this here is the BATTLE DOME?\\nI won't let GENTLEMEN beat me!\\pBut where is the entrance?$"}
text:BattleFrontier_OutsideWest.NothingHereNotLongAgo	{'body': "There used to be nothing here not all\\nthat long ago.\\pBut, now look at this place! Amazing!\\nI'll bring my mother out to see this.$"}
text:BattleFrontier_OutsideWest.FinallyArrivedAtFrontier	{'body': "I've finally arrived at the BATTLE\\nFRONTIER!\\pI'm sure to grab attention with\\nmy looks and ability!$"}
text:BattleFrontier_OutsideWest.SquareFilledWithToughPeople	{'body': "Munch, munch…\\pIt looks like this square's filled with\\ntough people.\\pMunch, munch…$"}
text:BattleFrontier_OutsideWest.MetOlderGirlAtPike	{'body': 'Crunch, munch…\\pA while back, I met this older girl\\nat the BATTLE PIKE.\\pShe had these eyes that were scary\\nin a real ornery way.\\pCrunch, munch…\\pShe got all furious: “Will you quit\\neating!” Then she whaled on me.\\pIt was a hair-raising kind of\\nscary experience, sure enough.\\pCrunch, munch…$'}
text:BattleFrontier_OutsideWest.LastTimeOurEyesMet	{'body': "Huh? Will you listen to yourself?\\nThat's nothing!\\pWhy, the last time I cheered for him,\\nour eyes met and sparks flew!$"}
text:BattleFrontier_OutsideWest.DomeAceLookedBecauseOfMyCheering	{'body': 'Whaaaaaat?! Pfft!\\pThe DOME ACE only looked our way\\nbecause my cheering was so loud!\\lThat old tournament was legendary!$'}
text:BattleFrontier_OutsideWest.DomeAceIsMine	{'body': 'Oh, shush!\\nKeep that racket down!\\pYou fair-weather fans should stick\\nto cheering for some GYM LEADER!\\pThe DOME ACE is mine!\\nThe only idol for me!$'}
text:BattleFrontier_OutsideWest.FansOverThereUsedToBeTrainers	{'body': 'Those people squabbling over there\\nused to be famous TRAINERS.\\pThen one tournament opponent beat\\nall of them. They became fans on\\lthe spot!\\pThe old DOME tournaments ended,\\nbut they still meet here every day\\lto argue over their idol.$'}
text:BattleFrontier_OutsideWest.MonWithLongTailInFrontier	{'body': "I heard a rumor that someone saw\\na POKéMON with an unusually long tail\\lsomewhere in the BATTLE FRONTIER.\\pIt must be adorable. I'm sure of it…\\pOh, challenges can wait. I feel driven\\nto find the delightful creature!$"}
text:BattleFrontier_PokemonCenter_1F.NeverSeenPokemon	{'body': "There was someone here using a \\nPOKéMON I've never seen before.\\pI never learned about it at\\nTRAINER'S SCHOOL at least.\\pI wonder where you can catch POKéMON\\nlike that.$"}
text:BattleFrontier_PokemonCenter_1F.NextStopBattleArena	{'body': "Okay! Next stop, the BATTLE ARENA!\\nI'd better get the right POKéMON from\\lthe PC Storage System.$"}
text:BattleFrontier_PokemonCenter_1F.GoingThroughEveryChallenge	{'body': "I'm bringing SKITTY on my next\\nCircuit team!\\pFive partners will help this\\nlittle one find its chance.$"}
text:BattleFrontier_PokemonCenter_1F.Skitty	{'body': 'SKITTY: Mya myaaah!$'}
text:BattleFrontier_RankingHall.ExplainRankingHall	{'body': "This hall celebrates the\\nFrontier's competitive history.\\pToday's boards show CHAMPIONS\\nCIRCUIT results: the current run,\\lbest recorded run, and total wins.$"}
text:BattleFrontier_RankingHall.DomePikeFactoryRecords	{'body': 'CHAMPIONS CIRCUIT RECORDS Current\\nrun, best recorded, total wins$'}
text:BattleFrontier_RankingHall.PalaceArenaPyramidRecords	{'body': 'CHAMPIONS CIRCUIT RECORDS Current\\nrun, best recorded, total wins$'}
text:BattleFrontier_RankingHall.IsYourNameOnThisList	{'body': "Have you set a Circuit record\\nyou're proud of?$"}
text:BattleFrontier_RankingHall.WowThatsSuper	{'body': "Wow, that's super!\\nI'll have to try harder, too!$"}
text:BattleFrontier_RankingHall.WorkHarderIfYouSawFriendsName	{'body': "I'm still working on mine, too!\\pMaybe we can compare our best runs\\nnext time.$"}
text:BattleFrontier_RankingHall.MyNamesNotUpThere	{'body': "I keep checking my records, but I\\nhaven't entered a challenge yet.\\pFunny how the numbers haven't\\nmoved…$"}
text:BattleFrontier_ReceptionGate.FirstTimeHereThisWay	{'body': 'Is it your first time here?\\nPlease step this way!$'}
text:BattleFrontier_ReceptionGate.WelcomeToBattleFrontier	{'body': 'The front lines of POKéMON battling!\\nWelcome to the BATTLE FRONTIER!$'}
text:BattleFrontier_ReceptionGate.IssueFrontierPass	{'body': "For a first-time visitor, we issue\\nthe FRONTIER PASS.\\pIt's for use at all the facilities\\nin the BATTLE FRONTIER.\\pHere you are!$"}
text:BattleFrontier_ReceptionGate.ObtainedFrontierPass	{'body': '{PLAYER} obtained\\nthe FRONTIER PASS.$'}
text:BattleFrontier_ReceptionGate.PlacedTrainerCardInFrontierPass	{'body': '{PLAYER} placed the TRAINER CARD\\nin the FRONTIER PASS.$'}
text:BattleFrontier_ReceptionGate.EnjoyBattleFrontier	{'body': 'We hope you enjoy all that the BATTLE\\nFRONTIER has to offer!$'}
text:BattleFrontier_ReceptionGate.IfItIsntPlayerYouCame	{'body': "???: Well, if it isn't {PLAYER}{KUN}!\\nYou came out here!$"}
text:BattleFrontier_ReceptionGate.OhMrScottGoodDay	{'body': 'GUIDE: Oh! MR. SCOTT, sir!\\nGood day to you, sir!$'}
text:BattleFrontier_ReceptionGate.ScottGreatToSeeYouHere	{'body': "SCOTT: It's great to see you here!\\pEvery desk enters the CHAMPIONS\\nCIRCUIT. Six partners, coordinated\\lopponents, and no easy matches.\\pThe buildings preserve the\\nFrontier's history. The Tower\\lholds our central arena.\\pVisit my house when you have time.\\nI'd like to hear about your teams.$"}
text:BattleFrontier_ReceptionGate.YourGuideToFacilities	{'body': "I'm your guide to the various facilities\\nhere in the BATTLE FRONTIER.$"}
text:BattleFrontier_ReceptionGate.LearnAboutWhich2	{'body': 'Which would you like to learn about?$'}
text:BattleFrontier_ReceptionGate.BattleTowerInfo	{'body': 'The BATTLE TOWER is the great\\ntower.\\pIts reception desk enters the\\nCHAMPIONS CIRCUIT at the central\\lTower arena. All matches are\\ldoubles.$'}
text:BattleFrontier_ReceptionGate.BattleDomeInfo	{'body': 'The BATTLE DOME is the oval\\nbuilding.\\pIts reception desk enters the\\nCHAMPIONS CIRCUIT at the central\\lTower arena. All matches are\\ldoubles.$'}
text:BattleFrontier_ReceptionGate.BattlePalaceInfo	{'body': 'The BATTLE PALACE is the red\\nbuilding to the east.\\pIts reception desk enters the\\nCHAMPIONS CIRCUIT at the central\\lTower arena. All matches are\\ldoubles.$'}
text:BattleFrontier_ReceptionGate.BattleArenaInfo	{'body': 'The BATTLE ARENA is the central\\ndojo.\\pIts reception desk enters the\\nCHAMPIONS CIRCUIT at the central\\lTower arena. All matches are\\ldoubles.$'}
text:BattleFrontier_ReceptionGate.BattleFactoryInfo	{'body': 'The BATTLE FACTORY is the building\\nnearest this gate.\\pIts reception desk enters the\\nCHAMPIONS CIRCUIT at the central\\lTower arena. All matches are\\ldoubles.$'}
text:BattleFrontier_ReceptionGate.BattlePikeInfo	{'body': 'The BATTLE PIKE is the\\nSEVIPER-shaped building.\\pIts reception desk enters the\\nCHAMPIONS CIRCUIT at the central\\lTower arena. All matches are\\ldoubles.$'}
text:BattleFrontier_ReceptionGate.BattlePyramidInfo	{'body': 'The BATTLE PYRAMID is the enormous\\npyramid.\\pIts reception desk enters the\\nCHAMPIONS CIRCUIT at the central\\lTower arena. All matches are\\ldoubles.$'}
text:BattleFrontier_ReceptionGate.RankingHallInfo	{'body': 'The RANKING HALL is near the\\nBATTLE TOWER.\\pIts current displays show your\\nCHAMPIONS CIRCUIT run, best\\lrecorded run, and total wins.$'}
text:BattleFrontier_ReceptionGate.ExchangeCornerInfo	{'body': 'The EXCHANGE SERVICE CORNER is near\\nthe BATTLE TOWER.\\pThe Battle Points you have earned in\\nthe BATTLE FRONTIER may be exchanged\\lfor fabulous prizes there.$'}
text:BattleFrontier_ReceptionGate.YourGuideToRules	{'body': "I'm your guide to the basic rules that\\nare common to all the challenges\\loffered by the facilities in the BATTLE\\lFRONTIER.$"}
text:BattleFrontier_ReceptionGate.LearnAboutWhat	{'body': 'What would you like to learn about?$'}
text:BattleFrontier_ReceptionGate.LevelModeInfo	{'body': "All the challenges at the BATTLE\\nFRONTIER's facilities come in\\ltwo courses--Level 50 and Open Level.$"}
text:BattleFrontier_ReceptionGate.Level50Info	{'body': 'The Level 50 course is open to POKéMON\\nup to and including Level 50.\\pPlease keep in mind, however, that\\nno TRAINER you face will have any\\lPOKéMON below Level 50.\\pThis course is the entry level for\\nbattles at the BATTLE FRONTIER.\\pTo begin, we hope you will challenge\\nthis course.$'}
text:BattleFrontier_ReceptionGate.OpenLevelInfo	{'body': 'The Open Level course places no limit\\non the levels of POKéMON entering\\lchallenges.\\pThe levels of your opponents will\\nbe adjusted to match the levels of\\lyour POKéMON.\\pHowever, no TRAINER you face will\\nhave any POKéMON below Level 60.$'}
text:BattleFrontier_ReceptionGate.MonEntryInfo	{'body': 'Virtually any kind of POKéMON may take\\non the challenges at all facilities.\\pEGGS and certain kinds of POKéMON,\\nhowever, are not permitted.\\pThe numbers of POKéMON required for\\nchallenges will depend on the facility.\\pAt all facilities, however, two or more\\nof the same kind of POKéMON are not\\lpermitted.$'}
text:BattleFrontier_ReceptionGate.HoldItemsInfo	{'body': 'When entering a challenge at a BATTLE\\nFRONTIER facility, POKéMON may not\\lbe holding the same kind of item.\\pPlease make sure that all POKéMON\\nentering a challenge are holding\\ldifferent items.$'}
text:BattleFrontier_ReceptionGate.YourGuideToFrontierPass	{'body': "I'm your guide to the FRONTIER PASS.$"}
text:BattleFrontier_ReceptionGate.LearnAboutWhich1	{'body': 'Which would you like to learn about?$'}
text:BattleFrontier_ReceptionGate.SymbolsInfo	{'body': "There are seven facilities at\\nthe BATTLE FRONTIER.\\pTRAINERS who gain recognition for\\ntheir abilities may be rewarded with\\lsymbols from each of the facilities.\\pTo earn a symbol, TRAINERS may need\\nto defeat other TRAINERS in a row,\\land may need to win events repeatedly.\\pIt's certainly not easy to win symbols.\\nI wish you the best of luck!$"}
text:BattleFrontier_ReceptionGate.RecordedBattleInfo	{'body': 'Battle recordings are not offered\\nat this BATTLE FRONTIER.\\pYour FRONTIER PASS instead tracks\\nsymbols, BATTLE POINTS, and your\\lchallenge records.$'}
text:BattleFrontier_ReceptionGate.BattlePointsInfo	{'body': 'Battle Points are rewards given to\\nTRAINERS who battled outstandingly\\lat the BATTLE FRONTIER.\\pYou may trade in your Battle Points\\nfor prizes at the EXCHANGE SERVICE\\lCORNER.$'}
text:BattleFrontier_ReceptionGate.CurrentFrontierPass	{'body': 'Your FRONTIER PASS keeps your\\nTRAINER CARD, BATTLE POINTS, and\\lhistorical SYMBOL records.\\pThe record boards show your\\ncurrent CHAMPIONS CIRCUIT results.$'}
text:BattleFrontier_ScottsHouse.WelcomeToBattleFrontier	{'body': "SCOTT: Well, hello and welcome!\\nHeheh… Sorry about the cramped space.\\pAnyway, {PLAYER}{KUN}, let me formally\\nwelcome you to the BATTLE FRONTIER.\\pThis is my dream come true.\\nIt took me years and years, but I've\\lfinally given shape to my dream.$"}
text:BattleFrontier_ScottsHouse.HowMuchEffortItTookToMakeReal	{'body': 'On reflection, it was a terribly long\\njourney…\\pI left home alone on a quest to find\\nstrong TRAINERS.\\pNo one can imagine how much effort\\nor time it took to make this real.$'}
text:BattleFrontier_ScottsHouse.HaveThisAsMementoOfOurPathsCrossing	{'body': "But that's all in the past.\\nNo point dwelling on that!\\pAll I want for you is to enjoy battling\\nto your heart's content here.\\p{PLAYER}{KUN}, I want you to have this\\nas a memento for all the time our\\lpaths crossed on our journeys.$"}
text:BattleFrontier_ScottsHouse.ObtainedXBattlePoints	{'body': '{PLAYER} obtained\\n{STR_VAR_1} Battle Point(s).$'}
text:BattleFrontier_ScottsHouse.ExplainBattlePoints	{'body': 'SCOTT: You can check your Battle\\nPoints on your FRONTIER PASS.\\pThe more success you have here at\\nthe BATTLE FRONTIER, the more Battle\\lPoints you will collect.\\pUse your Battle Points the way you\\nsee fit, like trading them for items.$'}
text:BattleFrontier_ScottsHouse.ExpectingGreatThings	{'body': "I'm expecting great things from you!$"}
text:BattleFrontier_ScottsHouse.WhyIGoSeekingTrainers	{'body': "SCOTT: Every TRAINER is an individual.\\nThey all lead lives of their own.\\pBut when they're in a battle,\\nit doesn't matter who they are.\\pThey're all the same!\\pI love the purity of battle,\\nwhere everyone is equal.\\pThat's why I go everywhere seeking\\nTRAINERS who are serious about\\lbattling, and invite them here.$"}
text:BattleFrontier_ScottsHouse.HaveYouMetFrontierBrain	{'body': 'SCOTT: The FRONTIER BRAINS gave\\nthese buildings their character.\\pToday every desk enters the\\nCHAMPIONS CIRCUIT. I want to see\\lwhat your team can do there!$'}
text:BattleFrontier_ScottsHouse.MayFindWildMonsInFrontier	{'body': "SCOTT: You don't just train for battle,\\nright?\\pI think I remember you working on\\na POKéDEX as well.\\pWell, guess what?\\pYou may run into wild POKéMON in\\nthe BATTLE FRONTIER somewhere…\\lFufufu!$"}
text:BattleFrontier_ScottsHouse.YouveCollectedAllSilverSymbols	{'body': "SCOTT: Are you enjoying things in\\nthe BATTLE FRONTIER?\\p…Wait a second…\\nOh!\\pYour FRONTIER PASS!\\nYou've collected the full set\\lof silver symbols!\\pThat's more than impressive!\\nYou are tough, just as I suspected!\\pNormally, I wouldn't do something\\nlike this, but this is a special time!\\pI want you to have this.\\nI'm sure you can put it to proper use.$"}
text:BattleFrontier_ScottsHouse.YouveCollectedAllGoldSymbols	{'body': "SCOTT: I hope you're enjoying\\neverything in the BATTLE FRONTIER.\\p…Wait a second…\\nOh, my disbelieving eyes!\\pYour FRONTIER PASS!\\nYou've gathered up the full set\\lof gold symbols!\\pThat's more than stupendous!\\nYou're incredible, just as I suspected!\\p… … … … … …\\p{PLAYER}, you've got to accept this!\\pI think you will be able to\\nappreciate the value of my gift!$"}
text:BattleFrontier_ScottsHouse.SoGladIBroughtYouHere	{'body': "I must say I have the gift of knowing\\na good TRAINER when I see one.\\pI'm so glad I had the foresight to\\nbring you here!$"}
text:BattleFrontier_ScottsHouse.BerryPocketStuffed	{'body': 'Your BERRY POCKET seems to\\nbe stuffed.$'}
text:BattleFrontier_ScottsHouse.Beat50TrainersInARow	{'body': "SCOTT: Oh, I heard about you!\\nHow you ruled the BATTLE TOWER!\\lYou beat over 50 TRAINERS in a row?\\pThat's fantastic!\\nI want you to have this!$"}
text:BattleFrontier_ScottsHouse.Beat100TrainersInARow	{'body': "SCOTT: Oh, my! I heard about you!\\nHow you overwhelmed the BATTLE TOWER!\\lYou beat over 100 TRAINERS in a row?\\pThat's ridiculously spectacular!\\nYou've got to have this!$"}
text:BattleFrontier_ScottsHouse.ExpectingToHearEvenGreaterThings	{'body': "I'll be expecting to hear even greater\\nthings about you now!$"}
text:BattleFrontier_ScottsHouse.ComeBackForThisLater	{'body': 'Oops, well, if you have too much\\nstuff, come back for this later.$'}
text:CaveOfOrigin_1F.CarbinkStuck	{'body': 'This CARBINK is guarding an old\\nladder.\\pIts crystals echo with the energy\\nof eight BADGES. Come back when\\lthey shine.$'}
text:CaveOfOrigin_B1F.WallaceStory	{'body': "Ah, {PLAYER}{KUN}. STEVEN told me\\nhow far you have traveled.\\pI am WALLACE. I once led the\\nSOOTOPOLIS GYM; JUAN leads it\\lnow.\\pGROUDON and KYOGRE's powers are\\noverwhelming HOENN. Their\\lstruggle will consume land and\\lsea alike.\\pThe oldest tale tells of a third\\npower that stopped their clash:\\lRAYQUAZA.\\pWe need its help again. But I do\\nnot know where it sleeps...$"}
text:CaveOfOrigin_B1F.WhereIsRayquaza	{'body': 'WALLACE: Where might a POKéMON of\\nthe sky rest?\\pHave you heard of any place on\\nyour travels that could shelter\\lRAYQUAZA?$'}
text:CaveOfOrigin_B1F.ButWereInCaveOfOrigin	{'body': "WALLACE: We've searched the CAVE\\nOF ORIGIN. There is no sign of\\lRAYQUAZA here.\\pPerhaps somewhere higher, closer\\nto the sky?$"}
text:CaveOfOrigin_B1F.OldLadyDidntMentionThat	{'body': "WALLACE: The elders at MT. PYRE\\ntold me RAYQUAZA's story, but it\\ldoesn't rest there.\\pPerhaps another place high above\\nthe sea?$"}
text:CaveOfOrigin_B1F.CantYouRememberSomehow	{'body': "WALLACE: There is an old tower\\ncalled SKY PILLAR, near ROUTE\\l131. It reaches high above the\\lsea.\\pCould that be the place we're\\nlooking for?$"}
text:CaveOfOrigin_B1F.WellHeadToSkyPillar	{'body': 'WALLACE: The SKY PILLAR! Of\\ncourse. A place between the sea\\land sky.\\pFrom ROUTE 128, SURF south, then\\nwest through ROUTES 129 and 130\\lto ROUTE 131.\\pSKY PILLAR is on its north side,\\neast of PACIFIDLOG. I will open\\lthe way!$'}
text:CaveOfOrigin_DianciesRoom.WallaceIntro	{'body': "WALLACE: Listen to the water in\\nthis chamber. Even a quiet place\\lhas its own rhythm.\\pWe've met at the LEAGUE. Here, I'd\\nlike to show you another side of\\lmy team!$"}
text:CaveOfOrigin_DianciesRoom.WallaceDefeat	{'body': 'A magnificent performance!$'}
text:CaveOfOrigin_DianciesRoom.WallaceAfter	{'body': "WALLACE: What a pleasure to battle\\nyou here! The crystals seemed to\\lcatch every flash of light.\\pYou needn't win an exhibition to\\nmeet DIANCIE or find the DIANCITE\\lhere. Take your time exploring!$"}
text:CaveOfOrigin_DianciesRoom.WallaceNotReady	{'body': "WALLACE: Challenge me at the\\nPOKéMON LEAGUE first. Then we can\\lhold a special exhibition here.\\pYou're welcome to explore the\\nchamber in the meantime.$"}
text:CaveOfOrigin_DianciesRoom.WallaceOffer	{'body': "WALLACE: Would you join me for a\\nspecial exhibition battle here?\\pI've brought a different team from\\nthe one you faced at the LEAGUE.$"}
text:CaveOfOrigin_DianciesRoom.WallaceDecline	{'body': 'Whenever your team is ready. I\\nwill be here.$'}
text:CeladonCity_Condominiums_1F_Meowth	{'body': 'MEOWTH: Meow!$'}
text:CeladonCity_Condominiums_1F_TryThisDrinkInstead	{'body': "You shouldn't spend all your money\\non drinks.\\pTry this instead.$"}
text:CeladonCity_Condominiums_1F_NothingBeatsThirstLikeTea	{'body': 'Nothing beats thirst like some hot\\nTEA.\\pIt really is the best.$'}
text:CeladonCity_Condominiums_1F_MyDearMonsKeepMeCompany	{'body': 'My dear POKéMON keep me company.\\nMEOWTH even brings money home!$'}
text:CeladonCity_Condominiums_1F_DaisyComesToBuyTea	{'body': 'Oh, hello, dearie.\\nDid you enjoy my TEA?\\pBy the way, dear. Are you, by any\\nchance, from PALLET TOWN?\\pA girl from PALLET TOWN, DAISY,\\nshe enjoys TEA every day.\\pShe visits the CELADON DEPT. STORE\\nto buy some TEA.$'}
text:CeladonCity_Condominiums_1F_Clefairy	{'body': 'CLEFAIRY: Pi pippippi!$'}
text:CeladonCity_Condominiums_1F_Nidoran	{'body': 'NIDORAN♀: Kya kyaoo!$'}
text:CeladonCity_Condominiums_1F_ManagersSuite	{'body': "CELADON MANSION\\nManager's Suite$"}
text:CeladonCity_Condominiums_2F_GameFreakMeetingRoom	{'body': 'GAME FREAK Meeting Room$'}
text:CeladonCity_Condominiums_3F_ImTheProgrammer	{'body': "Me?\\nI'm the programmer!$"}
text:CeladonCity_Condominiums_3F_ImTheGraphicArtist	{'body': "I'm the graphic artist!\\nI drew you!$"}
text:CeladonCity_Condominiums_3F_IWroteTheStory	{'body': "I wrote the story!\\nIsn't ERIKA cute?\\pI like MISTY a lot, too!\\nOh, and SABRINA, I like her!$"}
text:CeladonCity_Condominiums_3F_ImGameDesignerShowMeFinishedPokedex	{'body': "Is that right?\\pI'm the game designer!\\pFilling up your POKéDEX is tough,\\nbut don't quit!\\pWhen you finish, come tell me!$"}
text:CeladonCity_Condominiums_3F_CompletedPokedexCongratulations	{'body': 'Wow! Excellent!\\nYou completed your POKéDEX!\\lCongratulations!\\l…$'}
text:CeladonCity_Condominiums_3F_ItsTheGameProgram	{'body': "It's the game program! Messing with\\nit could bug out the game!$"}
text:CeladonCity_Condominiums_3F_SomeonesPlayingGame	{'body': "Someone's playing a game instead of\\nworking!$"}
text:CeladonCity_Condominiums_3F_ItsScriptBetterNotLookAtEnding	{'body': "It's the script!\\nBetter not look at the ending!$"}
text:CeladonCity_Condominiums_3F_GameFreakDevelopmentRoom	{'body': 'GAME FREAK Development Room$'}
text:CeladonCity_Condominiums_RoofRoom_TheresNothingIDontKnow	{'body': "There is nothing that I don't know,\\nlike I wrote on the blackboard.\\pI know about the world of POKéMON\\nin your GAME BOY ADVANCE!\\pGet together with your friends and\\nenjoy trading POKéMON!$"}
text:CeladonCity_Condominiums_RoofRoom_ObtainedAnEevee	{'body': '{PLAYER} obtained an EEVEE!$'}
text:CeladonCity_Condominiums_RoofRoom_BoxIsFull	{'body': 'ポケモンが\u3000いっぱいだ\\nボックスを\u3000かえて\u3000きなさい$'}
text:CeladonCity_Condominiums_RoofRoom_WirelessAdapterLecture	{'body': 'POKéMON Lecture\\pPlaying with the Wireless Adapter$'}
text:CeladonCity_Condominiums_RoofRoom_ReadWhichHeading	{'body': 'Which heading do you want to read?$'}
text:CeladonCity_Condominiums_RoofRoom_ExplainWirelessClub	{'body': 'The POKéMON WIRELESS CLUB is\\nupstairs at any POKéMON CENTER.\\pVisit one to link up with friend(s)\\nusing your Wireless Adapter.$'}
text:CeladonCity_Condominiums_RoofRoom_ExplainDirectCorner	{'body': 'To link only with a friend, go to\\nthe DIRECT CORNER.\\pIt is the right counter at the\\nPOKéMON WIRELESS CLUB.\\pGo into the TRADE CORNER or the\\nCOLOSSEUM with your friend.$'}
text:CeladonCity_Condominiums_RoofRoom_ExplainUnionRoom	{'body': 'To link and communicate with\\nanyone, go to the UNION ROOM.\\pIt is the left counter at the\\nPOKéMON WIRELESS CLUB.\\pGo to the UNION ROOM and enjoy\\nmeeting other TRAINERS.$'}
text:CeladonCity_Condominiums_RoofRoom_PamphletOnTMs	{'body': "It's a pamphlet on TMs.\\p… …\\pThere are fifty TMs in all.\\pThere are also seven HMs that\\ncan be used repeatedly.\\pSILPH CO.$"}
text:CeladonCity_Condominiums_Roof_IKnowEverything	{'body': 'I KNOW EVERYTHING!$'}
text:CeladonCity_DepartmentStore_1F_WelcomeToDeptStore	{'body': 'Hello!\\nWelcome to CELADON DEPT. STORE.\\pThe board on the right describes\\nthe store layout.$'}
text:CeladonCity_DepartmentStore_1F_FloorDescriptions	{'body': "1F: SERVICE COUNTER\\p2F: TRAINER'S MARKET\\p3F: TV GAME SHOP\\p4F: WISE MAN GIFTS\\p5F: DRUGSTORE\\pROOFTOP SQUARE: VENDING MACHINES$"}
text:CeladonCity_DepartmentStore_1F_ServiceCounter	{'body': '1F: SERVICE COUNTER$'}
text:CeladonCity_DepartmentStore_2F_SuperRepelMorePowerfulRepel	{'body': "SUPER REPEL keeps weak POKéMON at\\nbay…\\pHmm, it's a more powerful REPEL.$"}
text:CeladonCity_DepartmentStore_2F_BuyReviveForLongOutings	{'body': 'For long outings, you should buy\\nREVIVE.$'}
text:CeladonCity_DepartmentStore_2F_FloorSign	{'body': "Top-Grade Items for TRAINERS!\\p2F: TRAINER'S MARKET$"}
text:CeladonCity_DepartmentStore_2F_LanceComesToBuyCapes	{'body': 'We have a customer, LANCE, who\\noccasionally comes.\\pHe always buys capes.\\pI wonder… Does he have many\\nidentical capes at home?$'}
text:CeladonCity_DepartmentStore_3F_OTStandsForOriginalTrainer	{'body': 'Captured POKéMON are registered\\nwith an ID No. and the OT.\\pOT stands for “Original TRAINER” -\\nthe TRAINER that caught it first.$'}
text:CeladonCity_DepartmentStore_3F_BuddyTradingKangaskhanForHaunter	{'body': "All right!\\pMy buddy's going to trade me his\\nKANGASKHAN for my HAUNTER!$"}
text:CeladonCity_DepartmentStore_3F_HaunterEvolvedOnTrade	{'body': 'Come on, HAUNTER!\\pI love HAUNTER!\\nI collect them!\\pHuh?\\pHAUNTER turned into a different\\nPOKéMON while being traded!$'}
text:CeladonCity_DepartmentStore_3F_CanIdentifyTradeMonsByID	{'body': 'You can identify POKéMON you get\\nin trades by their ID Numbers.$'}
text:CeladonCity_DepartmentStore_3F_ItsSuperNES	{'body': "It's a Super NES.$"}
text:CeladonCity_DepartmentStore_3F_AnRPG	{'body': "An RPG!\\nThere's no time for that!$"}
text:CeladonCity_DepartmentStore_3F_SportsGame	{'body': "A sports game!\\nDad'll like that!$"}
text:CeladonCity_DepartmentStore_3F_PuzzleGame	{'body': 'A puzzle game!\\nLooks addictive!$'}
text:CeladonCity_DepartmentStore_3F_FightingGame	{'body': 'A fighting game!\\nLooks tough!$'}
text:CeladonCity_DepartmentStore_3F_TVGameShop	{'body': '3F: TV GAME SHOP$'}
text:CeladonCity_DepartmentStore_3F_RedGreenBothArePokemon	{'body': 'Red and Green!\\nBoth are POKéMON!$'}
text:CounterTeach	{'body': "Oh, hi!\\nI finally finished POKéMON.\\pNot done yet? How about I teach\\nyou a good move?\\pThe move I have in mind is\\nCOUNTER.\\pNot like the one I'm leaning on,\\nmind you!$"}
text:CounterDeclined	{'body': "You're not interested? Come see\\nme if you change your mind.$"}
text:CounterWhichMon	{'body': 'Which POKéMON should I teach\\nCOUNTER to?$'}
text:CounterTaught	{'body': 'Are you using that COUNTER move\\nI taught your POKéMON?$'}
text:CeladonCity_DepartmentStore_4F_GettingPokeDollAsPresent	{'body': "I'm getting a present for my\\ngirlfriend.\\pI guess a POKé DOLL will be it.\\nIt's the popular thing.$"}
text:CeladonCity_DepartmentStore_4F_CanRunAwayWithPokeDoll	{'body': 'I heard something useful.\\pIf a wild POKéMON appears, you can\\ndistract it with a POKé DOLL.\\pYou can run away while the wild\\nPOKéMON is distracted.$'}
text:CeladonCity_DepartmentStore_4F_FloorSign	{'body': 'Express yourself with gifts!\\n4F: WISE MAN GIFTS\\pEvolution Special!\\nElement STONES on sale now!$'}
text:CeladonCity_DepartmentStore_5F_ExplainStatEnhancers	{'body': 'POKéMON stat enhancers can be\\nbought only here.\\pHP UP increases the base HP of a\\nPOKéMON.\\pCALCIUM raises the base SP. ATK\\nstat of one POKéMON.\\pZINC boosts the base SP. DEF stat\\nof one POKéMON.\\pCARBOS enhances the base SPEED\\nstat.$'}
text:CeladonCity_DepartmentStore_5F_HereForStatEnhancers	{'body': "I'm here for POKéMON stat\\nenhancers.\\pPROTEIN increases the base ATTACK\\npower.\\pIRON increases the base DEFENSE\\nstat.$"}
text:CeladonCity_DepartmentStore_5F_Drugstore	{'body': '5F: DRUGSTORE$'}
text:CeladonCity_DepartmentStore_Roof_ImThirstyGiveHerDrink	{'body': "I'm thirsty!\\nI want something to drink!\\p{FONT_NORMAL}Give her a drink?$"}
text:CeladonCity_DepartmentStore_Roof_GiveWhichDrink	{'body': 'Give her which drink?$'}
text:CeladonCity_DepartmentStore_Roof_YayFreshWaterHaveThis	{'body': 'Yay!\\pFRESH WATER!\\pThank you!\\nYou can have this from me!$'}
text:ReceivedItemFromLittleGirl	{'body': '{PLAYER} received a {STR_VAR_2}\\nfrom the little girl.$'}
text:CeladonCity_DepartmentStore_Roof_ExplainTM16	{'body': "TM16 contains LIGHT SCREEN.\\pIt's a move that weakens the power\\nof special attacks by your foe.$"}
text:CeladonCity_DepartmentStore_Roof_YaySodaPopHaveThis	{'body': 'Yay!\\pSODA POP!\\pThank you!\\nYou can have this from me!$'}
text:CeladonCity_DepartmentStore_Roof_ExplainTM20	{'body': "TM20 contains SAFEGUARD.\\pIt's a move that prevents status\\nproblems among your POKéMON.$"}
text:CeladonCity_DepartmentStore_Roof_YayLemonadeHaveThis	{'body': 'Yay!\\pLEMONADE!\\pThank you!\\nYou can have this from me!$'}
text:CeladonCity_DepartmentStore_Roof_ExplainTM33	{'body': "TM33 contains REFLECT.\\pIt's a move that weakens the power\\nof physical attacks by your foe.$"}
text:CeladonCity_DepartmentStore_Roof_DontHaveSpaceForThis	{'body': "You don't have space for this!$"}
text:CeladonCity_DepartmentStore_Roof_ImNotThirstyAfterAll	{'body': "No, thank you!\\nI'm not thirsty after all!$"}
text:CeladonCity_DepartmentStore_Roof_MySisterIsImmature	{'body': "My sister is a TRAINER, believe it\\nor not.\\pBut, she's so immature, she drives\\nme nuts!$"}
text:CeladonCity_DepartmentStore_Roof_ImThirstyIWantDrink	{'body': "I'm thirsty!\\nI want something to drink!$"}
text:CeladonCity_DepartmentStore_Roof_FloorSign	{'body': 'ROOFTOP SQUARE:\\nVENDING MACHINES$'}
text:CeladonCity_DepartmentStore_Roof_VendingMachineWhatDoesItHave	{'body': 'A vending machine!\\nWhat does it have?$'}
text:CeladonCity_DepartmentStore_Roof_NotEnoughMoney	{'body': 'Oops, not enough money!$'}
text:CeladonCity_DepartmentStore_Roof_DrinkCanPoppedOut	{'body': 'A can of {STR_VAR_1} popped out!$'}
text:CeladonCity_DepartmentStore_Roof_NoMoreRoomForStuff	{'body': "There's no more room for stuff!$"}
text:CeladonCity_DepartmentStore_Roof_NotThirsty	{'body': 'Not thirsty!$'}
text:CeladonCity_GotMyKoffingInCinnabar	{'body': "I got my KOFFING in CINNABAR.\\pIt's usually nice, but it breathes\\npoison when it's angry.$"}
text:CeladonCity_GymIsGreatFullOfWomen	{'body': "Heheh! This GYM is great!\\nIt's full of women!$"}
text:CeladonCity_GameCornerIsBadForCitysImage	{'body': "CELADON takes pride in its efforts\\nto keep the city beautiful.\\pThat's why the new GAME CORNER is\\nbad for our city's image.$"}
text:CeladonCity_BlewItAllAtSlots	{'body': 'Moan…\\nI blew it all at the slots!\\pI knew I should have cashed in my\\nCOINS for prizes!$'}
text:CeladonCity_MyTrustedPalPoliwrath	{'body': 'This is my trusted pal, POLIWRATH.\\pIt evolved from a POLIWHIRL when\\nI used a WATER STONE.$'}
text:CeladonCity_Poliwrath	{'body': 'POLIWRATH: Ribi ribit!$'}
text:CeladonCity_GetLostOrIllPunchYou	{'body': "What are you staring at?\\nGet lost, or I'll punch you.$"}
text:CeladonCity_KeepOutOfTeamRocketsWay	{'body': "Keep out of TEAM ROCKET's way!$"}
text:CeladonCity_ExplainXAccuracyDireHit	{'body': 'TRAINER TIPS\\pX ACCURACY boosts the accuracy of\\ntechniques.\\pDIRE HIT jacks up the likelihood\\nof critical hits.\\pGet your items at the CELADON\\nDEPT. STORE!$'}
text:CeladonCity_CitySign	{'body': 'CELADON CITY\\nThe City of Rainbow Dreams$'}
text:CeladonCity_GymSign	{'body': 'CELADON CITY POKéMON GYM\\nLEADER: ERIKA\\lThe Nature-Loving Princess!$'}
text:CeladonCity_MansionSign	{'body': 'CELADON MANSION$'}
text:CeladonCity_DeptStoreSign	{'body': 'Find what you need at the\\nCELADON DEPT. STORE!$'}
text:CeladonCity_GuardSpecProtectsFromStatus	{'body': 'TRAINER TIPS\\pGUARD SPEC. protects POKéMON\\nfrom status-reduction moves during\\lbattle.\\pGet your items at the\\nCELADON DEPT. STORE!$'}
text:CeladonCity_PrizeExchangeSign	{'body': 'COINS exchanged for prizes!\\nPRIZE EXCHANGE$'}
text:CeladonCity_GameCornerSign	{'body': 'ROCKET GAME CORNER\\nThe playground for grown-ups!$'}
text:CeladonCity_ScaldedTongueOnTea	{'body': 'Aaaagh, ow…\\nI scalded my tongue!\\pThis nice old lady in the MANSION\\ngave me some TEA.\\pBut it was boiling hot!\\nGotta cool it to drink it.$'}
text:SoftboiledTeach	{'body': "Hello, there!\\pI've seen you about, but I never\\nhad a chance to chat.\\pIt must be good luck that brought\\nus together finally.\\pI'd like to celebrate by teaching\\nyou the move SOFTBOILED.$"}
text:SoftboiledDeclined	{'body': "I'll always be keeping an eye out\\nfor you.\\pI hope we can chat again.$"}
text:SoftboiledWhichMon	{'body': "So, who's the POKéMON that gets\\nthe chance to learn SOFTBOILED?$"}
text:SoftboiledTaught	{'body': 'I wish you the best of luck!$'}
text:CeladonCity_SomeoneStoleSilphScope	{'body': "Oh, what am I to do…\\pSomeone stole our SILPH SCOPE.\\pThe thief came running this way,\\nI'm sure of it.\\pBut I lost sight of him!\\nWhere'd he go?$"}
text:CeladonCity_GameCorner_CanExchangeCoinsNextDoor	{'body': 'Welcome!\\pYou can exchange your COINS for\\nfabulous prizes next door.$'}
text:CeladonCity_GameCorner_WelcomeBuySomeCoins	{'body': 'Welcome to ROCKET GAME CORNER!\\pDo you need some game COINS?\\nWould you like to buy some?$'}
text:CeladonCity_GameCorner_ComePlaySometime	{'body': 'No?\\nPlease come play sometime!$'}
text:CeladonCity_GameCorner_SorryDontHaveCoinCase	{'body': "Oh, I'm sorry.\\nYou don't have a COIN CASE.$"}
text:CeladonCity_GameCorner_CoinCaseIsFull	{'body': 'Whoops!\\nYour COIN CASE is full.$'}
text:CeladonCity_GameCorner_CantAffordCoins	{'body': "You can't afford the COINS.$"}
text:CeladonCity_GameCorner_HereAreYourCoins	{'body': 'Thank you.\\nHere are your COINS!$'}
text:CeladonCity_GameCorner_RumoredTeamRocketRunsThisPlace	{'body': "Keep this quiet.\\pIt's rumored that this place is run\\nby TEAM ROCKET.$"}
text:CeladonCity_GameCorner_ThinkMachinesHaveDifferentOdds	{'body': 'I think these machines have\\ndifferent odds.$'}
text:CeladonCity_GameCorner_DoYouWantToPlay	{'body': 'Kid, do you want to play?$'}
text:CeladonCity_GameCorner_Received10CoinsFromMan	{'body': '{PLAYER} received 10 COINS\\nfrom the man.$'}
text:CeladonCity_GameCorner_DontNeedMyCoins	{'body': "You don't need my COINS!$"}
text:CeladonCity_GameCorner_WinsComeAndGo	{'body': "Wins seem to come and go.\\nNothing's a sure thing.$"}
text:CeladonCity_GameCorner_WinOrLoseItsOnlyLuck	{'body': "These slot games…\\nWin or lose, it's only by luck.$"}
text:CeladonCity_GameCorner_GymGuyAdvice	{'body': "Hey!\\pYou have better things to do,\\nchamp in the making!\\pCELADON GYM's LEADER is ERIKA.\\pShe is a user of GRASS-type\\nPOKéMON, and at one with nature.\\pShe might appear docile because of\\nher flower arranging…\\pBut she's not one to be taken\\nlightly!$"}
text:CeladonCity_GameCorner_RareMonsForCoins	{'body': "They offer rare POKéMON that can\\nbe exchanged for your COINS.\\pBut, I just can't seem to win!$"}
text:CeladonCity_GameCorner_SoEasyToGetHooked	{'body': "Games are scary!\\nIt's so easy to get hooked!$"}
text:CeladonCity_GameCorner_WantSomeCoins	{'body': "What's up?\\nWant some COINS?$"}
text:CeladonCity_GameCorner_Received20CoinsFromNiceGuy	{'body': '{PLAYER} received 20 COINS\\nfrom the nice guy.$'}
text:CeladonCity_GameCorner_YouHaveLotsOfCoins	{'body': 'You have lots of COINS!$'}
text:CeladonCity_GameCorner_NeedMoreCoinsForMonIWant	{'body': 'Darn! I need more COINS for the\\nPOKéMON I want!$'}
text:CeladonCity_GameCorner_HereAreSomeCoinsShoo	{'body': "Hey, what? You're throwing me off!\\nHere are some COINS, so shoo!$"}
text:CeladonCity_GameCorner_Received20CoinsFromMan	{'body': '{PLAYER} received 20 COINS\\nfrom the man.$'}
text:CeladonCity_GameCorner_YouveGotPlentyCoins	{'body': "You've got plenty of your own\\nCOINS!$"}
text:CeladonCity_GameCorner_WatchReelsClosely	{'body': 'The trick is to watch the reels\\nclosely.$'}
text:CeladonCity_GameCorner_GruntIntro	{'body': "I'm guarding this poster!\\nGo away, or else!$"}
text:CeladonCity_GameCorner_GruntDefeat	{'body': 'Dang!$'}
text:CeladonCity_GameCorner_GruntPostBattle	{'body': 'The TEAM ROCKET HIDEOUT might\\nbe discovered!\\pI better tell BOSS!$'}
text:CeladonCity_GameCorner_SwitchBehindPosterPushIt	{'body': "Hey!\\pA switch behind the poster!?\\nLet's push it!$"}
text:CeladonCity_GameCorner_CoinCaseIsRequired	{'body': 'A COIN CASE is required…$'}
text:CeladonCity_GameCorner_DontHaveCoinCase	{'body': "Oops!\\nDon't have the COIN CASE!$"}
text:CeladonCity_GameCorner_SlotMachineWantToPlay	{'body': 'A slot machine!\\nWant to play?$'}
text:CeladonCity_GameCorner_OutOfOrder	{'body': 'OUT OF ORDER\\nThis is broken.$'}
text:CeladonCity_GameCorner_OutToLunch	{'body': 'OUT TO LUNCH\\nThis is reserved.$'}
text:CeladonCity_GameCorner_SomeonesKeys	{'body': "Someone's keys!\\nThey'll be back.$"}
text:CeladonCity_GameCorner_PrizeRoom_FancyThatPorygon	{'body': "I sure do fancy that PORYGON!\\nBut, it's hard to win at slots!$"}
text:CeladonCity_GameCorner_PrizeRoom_RakedItInToday	{'body': 'Gahaha! I raked it in today!\\nIf only every day were like this…$'}
text:CeladonCity_GameCorner_PrizeRoom_CoinCaseRequired	{'body': 'A COIN CASE is required…$'}
text:CeladonCity_GameCorner_PrizeRoom_WeExchangeCoinsForPrizes	{'body': 'We exchange your COINS for prizes.$'}
text:CeladonCity_GameCorner_PrizeRoom_WhichPrize	{'body': 'Which prize would you like?$'}
text:CeladonCity_GameCorner_PrizeRoom_HereYouGo	{'body': 'はい どうぞ$'}
text:CeladonCity_GameCorner_PrizeRoom_YouWantPrize	{'body': 'So, you want the {STR_VAR_1}?$'}
text:CeladonCity_GameCorner_PrizeRoom_YouWantTM	{'body': 'Okay, a TM of {STR_VAR_2}\\nis what you want?$'}
text:CeladonCity_GameCorner_PrizeRoom_NeedMoreCoins	{'body': "Sorry, you'll need more COINS\\nthan that.$"}
text:CeladonCity_GameCorner_PrizeRoom_OopsNotEnoughRoom	{'body': 'おきゃくさん もう もてないよ$'}
text:CeladonCity_GameCorner_PrizeRoom_OhFineThen	{'body': 'あっ そう$'}
text:CeladonCity_Gym_ErikaIntro	{'body': "Hello…\\nLovely weather, isn't it?\\lIt's so pleasant…\\p…Oh, dear…\\nI must have dozed off. Welcome.\\pMy name is ERIKA.\\nI am the LEADER of CELADON GYM.\\pI am a student of the art of\\nflower arranging.\\pMy POKéMON are solely of the\\nGRASS type.\\p…Oh, I'm sorry, I had no idea that\\nyou wished to challenge me.\\pVery well, but I shall not lose.{PLAY_BGM MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:CeladonCity_Gym_ErikaDefeat	{'body': 'Oh!\\nI concede defeat.\\lYou are remarkably strong.\\pI must confer on you the\\nRAINBOWBADGE.$'}
text:CeladonCity_Gym_ErikaPostBattle	{'body': "You are cataloging POKéMON?\\nI must say I'm impressed.\\pI would never collect POKéMON if\\nthey were unattractive.$"}
text:CeladonCity_Gym_ExplainRainbowBadgeTakeThis	{'body': 'The RAINBOWBADGE will make\\nPOKéMON up to Lv. 50 obey.\\pIt also allows POKéMON to use\\nSTRENGTH in and out of battle.\\pPlease also take this with you.$'}
text:CeladonCity_Gym_ReceivedTM19FromErika	{'body': '{PLAYER} received TM19\\nfrom ERIKA.$'}
text:CeladonCity_Gym_ExplainTM19	{'body': "TM19 contains GIGA DRAIN.\\pHalf the damage it inflicts is\\ndrained to heal your POKéMON.\\pWouldn't you agree that it's a\\nwonderful move?$"}
text:CeladonCity_Gym_ShouldMakeRoomForThis	{'body': 'You should make room for this.$'}
text:CeladonCity_Gym_KayIntro	{'body': 'I should tell you about this GYM.\\pOnly real ladies are allowed in\\nhere!$'}
text:CeladonCity_Gym_KayDefeat	{'body': "You're too rough!$"}
text:CeladonCity_Gym_KayPostBattle	{'body': 'Bleaah!\\nI hope ERIKA wipes you out!$'}
text:CeladonCity_Gym_BridgetIntro	{'body': 'Oh, welcome.\\nI was getting bored.$'}
text:CeladonCity_Gym_BridgetDefeat	{'body': 'My makeup!$'}
text:CeladonCity_Gym_BridgetPostBattle	{'body': 'GRASS-type POKéMON are tough\\nagainst the WATER type.\\pThey also have an edge on ROCK-\\nand GROUND-type POKéMON.$'}
text:CeladonCity_Gym_TinaIntro	{'body': "…Weren't you peeking in here\\nearlier?$"}
text:CeladonCity_Gym_TinaDefeat	{'body': "You're an eye-opener!$"}
text:CeladonCity_Gym_TinaPostBattle	{'body': "Oh, you were looking at ERIKA…\\nYou weren't looking at me…$"}
text:CeladonCity_Gym_TamiaIntro	{'body': "Look, look!\\nSee my POKéMON!\\pI like the GRASS type.\\nI like how they're easy to raise.$"}
text:CeladonCity_Gym_TamiaDefeat	{'body': 'No!$'}
text:CeladonCity_Gym_TamiaPostBattle	{'body': 'We only use GRASS-type POKéMON at\\nour GYM.\\pWhy? We also use them for making\\nflower arrangements!$'}
text:CeladonCity_Gym_LisaIntro	{'body': "Oh, hey!\\pWe don't like BUG- or FIRE-type\\nPOKéMON in here!$"}
text:CeladonCity_Gym_LisaDefeat	{'body': 'Oh!\\nYou!$'}
text:CeladonCity_Gym_LisaPostBattle	{'body': "Our LEADER ERIKA might be quiet,\\nbut she's famous around here.$"}
text:CeladonCity_Gym_LoriIntro	{'body': 'Pleased to meet you.\\nMy hobby is POKéMON training.$'}
text:CeladonCity_Gym_LoriDefeat	{'body': 'Oh!\\nSplendid!$'}
text:CeladonCity_Gym_LoriPostBattle	{'body': 'I have a blind date coming up.\\nI have to learn to be polite,\\lespecially if I have to battle.$'}
text:CeladonCity_Gym_MaryIntro	{'body': "Welcome to CELADON GYM!\\pYou'd better not underestimate\\nthe nice ladies here.$"}
text:CeladonCity_Gym_MaryDefeat	{'body': 'Oh!\\nBeaten!$'}
text:CeladonCity_Gym_MaryPostBattle	{'body': "I didn't bring my best POKéMON.\\nWait until next time!$"}
text:CeladonCity_Gym_GymStatue	{'body': 'CELADON POKéMON GYM\\nLEADER: ERIKA\\pWINNING TRAINERS:\\n{RIVAL}$'}
text:CeladonCity_Gym_GymStatuePlayerWon	{'body': 'CELADON POKéMON GYM\\nLEADER: ERIKA\\pWINNING TRAINERS:\\n{RIVAL}, {PLAYER}$'}
text:CeladonCity_Hotel_ThisHotelIsForPeople	{'body': "POKéMON?\\nNo, this is a hotel for people.\\pWe're full up, unfortunately.$"}
text:CeladonCity_Hotel_OnVacationWithBrotherAndBoyfriend	{'body': "I'm on vacation with my brother and\\nboyfriend.\\pCELADON is such a pretty city!$"}
text:CeladonCity_Hotel_WhyDidSheBringBrother	{'body': 'Why?\\nWhy did she bring her brother?$'}
text:CeladonCity_Hotel_SisBroughtMeOnVacation	{'body': "Yippee! I'm on vacation!\\nMy sis brought me along! Awesome!$"}
text:CeladonCity_House1_SlotsReelInTheDough	{'body': 'Hehehe!\\pThe slots just reel in the dough,\\nbig-time!$'}
text:CeladonCity_House1_ShippedMonsAsSlotPrizes	{'body': 'CHIEF!\\pWe just shipped two thousand\\nmore POKéMON as slot prizes\\lagain today!$'}
text:CeladonCity_House1_DontTouchGameCornerPoster	{'body': "Don't touch the poster at the GAME\\nCORNER!\\pThere's no secret switch behind it!$"}
text:CeladonCity_PokemonCenter_1F_PokeFluteAwakensSleepingMons	{'body': 'A POKé FLUTE awakens sleeping\\nPOKéMON. You know that.\\pIt does so with a sound that only\\nthey can hear.$'}
text:CeladonCity_PokemonCenter_1F_RodeHereFromFuchsia	{'body': "I rode here from FUCHSIA.\\pIt's an uphill ride on CYCLING\\nROAD, so I'm exhausted.$"}
text:CeladonCity_PokemonCenter_1F_GoToCyclingRoadIfIHadBike	{'body': 'If I had a BIKE, I would go to\\nCYCLING ROAD!$'}
text:CeladonCity_Restaurant_TakingBreakRightNow	{'body': "Hi!\\pSorry, but we're taking a break\\nright now.$"}
text:CeladonCity_Restaurant_OftenGoToDrugstore	{'body': 'My POKéMON are weak, so I often\\nhave to go to the DRUGSTORE.$'}
text:CeladonCity_Restaurant_PsstBasementUnderGameCorner	{'body': "Psst! There's a basement under the\\nGAME CORNER, I hear.$"}
text:CeladonCity_Restaurant_ManLostItAllAtSlots	{'body': 'Munch…\\pThe man at that table lost it all\\nat the slots.$'}
text:CeladonCity_Restaurant_TakeThisImBusted	{'body': "Go ahead! Laugh!\\nI'm flat-out busted!\\pNo more slots for me!\\nI'm going straight!\\pHere!\\nI won't be needing this anymore!$"}
text:CeladonCity_Restaurant_ReceivedCoinCaseFromMan	{'body': '{PLAYER} received a COIN CASE\\nfrom the man.$'}
text:CeladonCity_Restaurant_MakeRoomForThis	{'body': 'Make room for this!$'}
text:CeladonCity_Restaurant_ThoughtIdWinItBack	{'body': 'I always thought I was going to\\nwin it back…$'}
text:CeruleanCave_B1F_Mew	{'body': 'Mew!$'}
text:CeruleanCity_BikeShop_WelcomeToBikeShop	{'body': 'Hi!\\nWelcome to our BIKE SHOP.\\pHave we got just the BIKE for\\nyou!$'}
text:CeruleanCity_BikeShop_SorryYouCantAffordIt	{'body': "Sorry!\\nYou can't afford it!$"}
text:CeruleanCity_BikeShop_OhBikeVoucherHereYouGo	{'body': "Oh, that's…\\pA BIKE VOUCHER!\\pOkay!\\nHere you go!$"}
text:CeruleanCity_BikeShop_ExchangedVoucherForBicycle	{'body': '{PLAYER} exchanged the\\nBIKE VOUCHER for a BICYCLE.$'}
text:CeruleanCity_BikeShop_ThankYouComeAgain	{'body': 'Thank you!\\nCome back again sometime!$'}
text:CeruleanCity_BikeShop_HowDoYouLikeNewBicycle	{'body': 'How do you like your new BICYCLE?\\nDo you like how it rides?\\pYou can take it out on CYCLING\\nROAD and even into caves!$'}
text:CeruleanCity_BikeShop_MakeRoomForBicycle	{'body': 'You better make room for your\\nBICYCLE!$'}
text:CeruleanCity_BikeShop_CityBikeGoodEnoughForMe	{'body': "A plain city bike is good enough\\nfor me.\\pAfter all, you can't put a shopping\\nbasket on a mountain bike.$"}
text:CeruleanCity_BikeShop_BikesCoolButExpensive	{'body': "These bikes are cool, but they're\\nway expensive!$"}
text:CeruleanCity_BikeShop_WowYourBikeIsCool	{'body': 'Wow.\\nYour BIKE is really cool!$'}
text:CeruleanCity_BikeShop_GermanFoldableBicyleFinallyOnMarket	{'body': 'ついに\u3000はつばい！\\pドイツ\u3000せい\u3000さいこうきゅう\\nおりたたみ\u3000じてんしゃ！$'}
text:CeruleanCity_BikeShop_ShinyNewBicycle	{'body': 'A shiny new BICYCLE!$'}
text:CeruleanCity_RivalIntro	{'body': "{RIVAL}: Yo! {PLAYER}!\\pYou're still struggling along back\\nhere?\\pI'm doing great! I caught a bunch\\nof strong and smart POKéMON!\\pHere, let me see what you caught,\\n{PLAYER}!$"}
text:CeruleanCity_RivalDefeat	{'body': 'Hey!\\nTake it easy!\\lYou won already!$'}
text:CeruleanCity_RivalPostBattle	{'body': "{RIVAL}: Hey, guess what?\\pI went to BILL's and got him to\\nshow me his rare POKéMON.\\pThat added a lot of pages to my\\nPOKéDEX!\\pAfter all, BILL's world famous as a\\nPOKéMANIAC.\\pHe invented the POKéMON Storage\\nSystem on PC, too.\\pSince you're using his system,\\nyou should go thank him.\\pWell, I better get rolling!\\nSmell ya later!$"}
text:CeruleanCity_OhRightLittlePresentAsFavor	{'body': "Oh, yeah, right.\\pI feel sorry for you. No, really.\\nYou're always plodding behind me.\\pSo here, I'll give you a little\\npresent as a favor.$"}
text:CeruleanCity_ExplainFameCheckerSmellYa	{'body': "A chatty gossip like you…\\nThat thing's perfect.\\pI don't need it because I don't\\ngive a hoot about others.\\pAll right, this time I really am\\ngone. Smell ya!$"}
text:CeruleanCity_GruntIntro	{'body': "Hey! Stay out!\\nIt's not your yard!\\p…Huh?\\nMe?\\pI'm an innocent bystander!\\nDon't you believe me?{PLAY_BGM}{MUS_RG_ENCOUNTER_ROCKET}$"}
text:CeruleanCity_GruntDefeat	{'body': "GRUNT: Stop! I give up!\\nI'll leave quietly!$"}
text:CeruleanCity_OkayIllReturnStolenTM	{'body': "…Okay.\\nI'll return the TM I stole.$"}
text:CeruleanCity_RecoveredTM28FromGrunt	{'body': '{PLAYER} recovered TM28 from\\nthe TEAM ROCKET GRUNT.$'}
text:CeruleanCity_BetterGetMovingBye	{'body': 'I better get moving!\\nBye!$'}
text:CeruleanCity_MakeRoomForThisCantRun	{'body': "Make room for this!\\nI can't run until I give it to you!$"}
text:CeruleanCity_TrainerLifeIsToughIsntIt	{'body': "You're a TRAINER, too?\\pCollecting, battling…\\nIt's a tough life, isn't it?$"}
text:CeruleanCity_YouCanCutDownSmallTrees	{'body': "Did you know that you can CUT down\\nsmall trees?\\pEven that small tree in front of\\nthe shop can be CUT down.\\pI think there's a way around it,\\nthough.$"}
text:CeruleanCity_IfSlowbroWasntThereCouldCutTree	{'body': "If that SLOWBRO wasn't there, you\\ncould CUT down the small tree.\\pThat way, you could get to the\\nother side.\\pI think there's a way around it,\\nthough.$"}
text:CeruleanCity_PokemonEncyclopediaAmusing	{'body': "You're making an encyclopedia on\\nPOKéMON? That sounds amusing.$"}
text:CeruleanCity_PeopleHereWereRobbed	{'body': "The people here were robbed.\\pIt's obvious that TEAM ROCKET is\\nbehind this most heinous crime!\\pEven our POLICE FORCE has\\ntrouble with the ROCKETS!$"}
text:CeruleanCity_SlowbroUseSonicboom	{'body': 'Okay! SLOWBRO!\\nUse SONICBOOM!$'}
text:CeruleanCity_SlowbroPayAttention	{'body': 'Come on, SLOWBRO, pay attention!$'}
text:CeruleanCity_SlowbroPunch	{'body': 'SLOWBRO, punch!$'}
text:CeruleanCity_NoYouBlewItAgain	{'body': 'No!\\nYou blew it again!$'}
text:CeruleanCity_SlowbroWithdraw	{'body': 'SLOWBRO, WITHDRAW!$'}
text:CeruleanCity_HardToControlMonsObedience	{'body': "No! That's wrong!\\nIt's so hard to control POKéMON!\\pYour POKéMON's obedience depends\\non your abilities as a TRAINER.$"}
text:CeruleanCity_SlowbroTookSnooze	{'body': 'SLOWBRO took a snooze…$'}
text:CeruleanCity_SlowbroLoafingAround	{'body': 'SLOWBRO is loafing around…$'}
text:CeruleanCity_SlowbroTurnedAway	{'body': 'SLOWBRO turned away…$'}
text:CeruleanCity_SlowbroIgnoredOrders	{'body': 'SLOWBRO ignored orders…$'}
text:CeruleanCity_WantBrightRedBicycle	{'body': "I want a bright red bicycle.\\pI'll keep it at home, so it won't\\nget dirty.$"}
text:CeruleanCity_ThisIsCeruleanCave	{'body': "This is CERULEAN CAVE.\\pHorribly strong POKéMON live inside\\nthere.\\pIt takes a very special TRAINER to\\nbe allowed inside there.\\pYou'd have to be strong enough to\\nbecome the POKéMON LEAGUE\\lCHAMPION for starters.\\pAnd, you would have to have\\nmade a great achievement.$"}
text:CeruleanCity_CitySign	{'body': 'CERULEAN CITY\\nA Mysterious, Blue Aura Surrounds\\lIt$'}
text:CeruleanCity_TrainerTipsHeldItems	{'body': 'TRAINER TIPS\\pA POKéMON can be made to hold\\nan item.\\pSome items can even be used by\\nthe holding POKéMON in battle.$'}
text:CeruleanCity_BikeShopSign	{'body': 'Grass and caves handled easily!\\nBIKE SHOP$'}
text:CeruleanCity_GymSign	{'body': 'CERULEAN CITY POKéMON GYM\\nLEADER: MISTY\\lThe Tomboyish Mermaid!$'}
text:CeruleanCity_Gym_MistyIntro	{'body': "Hi, you're a new face!\\pOnly those TRAINERS who have a\\npolicy about POKéMON can turn pro.\\pWhat is your approach when you\\ncatch and train POKéMON?\\pMy policy is an all-out offensive\\nwith WATER-type POKéMON!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:CeruleanCity_Gym_ExplainTM03	{'body': 'TM03 teaches WATER PULSE.\\pUse it on an aquatic POKéMON!$'}
text:CeruleanCity_Gym_ExplainCascadeBadge	{'body': "The CASCADEBADGE makes all\\nPOKéMON up to Lv. 30 obey.\\pThat includes even outsiders you\\ngot in trades.\\pThere's more. You can now use CUT\\nanytime, even out of battle.\\pYou can CUT down small trees to\\nopen new pathways.\\pYou can also have my favorite TM.$"}
text:CeruleanCity_Gym_ReceivedTM03FromMisty	{'body': '{PLAYER} received TM03\\nfrom MISTY.$'}
text:CeruleanCity_Gym_BetterMakeRoomForThis	{'body': 'You better make room for this!$'}
text:CeruleanCity_Gym_MistyDefeat	{'body': "Wow!\\nYou're too much!\\pAll right!\\pYou can have the CASCADEBADGE to\\nshow you beat me.$"}
text:CeruleanCity_Gym_DianaIntro	{'body': "What? You?\\nI'm more than good enough for you!\\pMISTY won't have to be bothered.$"}
text:CeruleanCity_Gym_DianaDefeat	{'body': 'You overwhelmed me!$'}
text:CeruleanCity_Gym_DianaPostBattle	{'body': 'You have to face other TRAINERS\\nto see how good you really are.$'}
text:CeruleanCity_Gym_LuisIntro	{'body': "Splash!\\pI'm first up!\\nLet's do it!$"}
text:CeruleanCity_Gym_LuisDefeat	{'body': "That can't be!$"}
text:CeruleanCity_Gym_LuisPostBattle	{'body': "MISTY is a TRAINER who's going to\\nkeep improving.\\pShe won't lose to someone like you!$"}
text:CeruleanCity_Gym_GymGuyAdvice	{'body': 'Yo!\\nChamp in the making!\\pLet me give you some advice!\\pThe LEADER, MISTY, is a pro who\\nuses WATER-type POKéMON.\\pYou can drain all their water with\\nGRASS-type POKéMON.\\pOr, you might use ELECTRIC-type\\nPOKéMON and zap them!$'}
text:CeruleanCity_Gym_WeMakePrettyGoodTeam	{'body': "You beat MISTY!\\nSee, what'd I tell ya?\\pYou and me, kid, we make a pretty\\ndarn-good team!$"}
text:CeruleanCity_Gym_GymStatue	{'body': 'CERULEAN POKéMON GYM\\nLEADER: MISTY\\pWINNING TRAINERS:\\n{RIVAL}$'}
text:CeruleanCity_Gym_GymStatuePlayerWon	{'body': 'CERULEAN POKéMON GYM\\nLEADER: MISTY\\pWINNING TRAINERS:\\n{RIVAL}, {PLAYER}$'}
text:CeruleanCity_House1_BadgesHaveAmazingSecrets	{'body': 'Only skilled TRAINERS can collect\\nPOKéMON BADGES.\\pI see you have at least one.\\pThose BADGES have amazing secrets,\\ndid you know?$'}
text:CeruleanCity_House1_DescribeWhichBadge	{'body': 'Now then…\\pWhich of the eight BADGES should\\nI describe?$'}
text:CeruleanCity_House1_ComeVisitAnytime	{'body': 'Come visit me anytime you wish.$'}
text:CeruleanCity_House1_AttackStatFlash	{'body': 'The ATTACK stat of all your\\nPOKéMON increases a little bit.\\pIt also lets you use the move\\nFLASH outside of battle.$'}
text:CeruleanCity_House1_ObeyLv30Cut	{'body': 'POKéMON up to Lv. 30 will obey\\nyou.\\pThat includes even outsiders you\\nobtain in trades.\\pPOKéMON of higher levels will\\nbe unruly in battle, however.\\pIt also lets you use the move\\nCUT outside of battle.$'}
text:CeruleanCity_House1_SpeedStatFly	{'body': 'The SPEED stat of all your\\nPOKéMON increases a little bit.\\pIt also lets you use the move\\nFLY outside of battle.$'}
text:CeruleanCity_House1_ObeyLv50Strength	{'body': 'POKéMON up to Lv. 50 will obey\\nyou.\\pThat includes even outsiders you\\nobtain in trades.\\pPOKéMON of higher levels will\\nbe unruly in battle, however.\\pIt also lets you use the move\\nSTRENGTH outside of battle.$'}
text:CeruleanCity_House1_DefenseStatSurf	{'body': 'The DEFENSE stat of all your\\nPOKéMON increases a little bit.\\pIt also lets you use the move\\nSURF outside of battle.$'}
text:CeruleanCity_House1_ObeyLv70RockSmash	{'body': 'POKéMON up to Lv. 70 will obey\\nyou.\\pThat includes even outsiders you\\nobtain in trades.\\pPOKéMON of higher levels will\\nbe unruly in battle, however.\\pIt also lets you use the move\\nROCK SMASH outside of battle.$'}
text:CeruleanCity_House1_SpStatsWaterfall	{'body': 'The SP. ATK and SP. DEF stats of\\nall your POKéMON rise a little bit.\\pIt also lets you use the move\\nWATERFALL outside of battle.$'}
text:CeruleanCity_House1_AllMonsWillObeyYou	{'body': 'All POKéMON will obey you!$'}
text:CeruleanCity_House2_RocketsStoleTMForDig	{'body': "Those miserable ROCKETS!\\pLook what they've done to my\\nhouse!\\pThey stole a TM for teaching\\nPOKéMON how to DIG holes!\\pI was going to use it on a\\nMANKEY or a SANDSHREW…\\pThat cost me a bundle, it did!$"}
text:CeruleanCity_House2_TeachDiglettDigWithoutTM	{'body': "I figure what's lost is lost.\\pI decided to teach DIGLETT how to\\nDIG without a TM.$"}
text:CeruleanCity_House2_TeamRocketTryingToDigIntoNoGood	{'body': 'TEAM ROCKET must be trying to DIG\\ntheir way into no good!$'}
text:CeruleanCity_House2_TeamRocketLeftWayOut	{'body': 'TEAM ROCKET left a way out!$'}
text:CeruleanCity_House3_PleaseTradeWithMyHusband	{'body': "My husband likes trading POKéMON.\\pYou're collecting POKéMON for your\\nPOKéDEX, aren't you?\\pWould you please trade with him?$"}
text:CeruleanCity_House4_NothingEntertaining	{'body': 'Sigh…\\nToo much time, too little to do…\\pIs nothing entertaining happening\\nanywhere?$'}
text:CeruleanCity_House4_NewNewsInformativeHaveThis	{'body': 'Ah!\\nA new news report!\\pHmm…\\pI see!\\nThat was quite informative!\\pI applaud you for taking interest\\nin the news at your young age.\\pAs my thanks for sharing the news\\nwith me, I want you to have this.$'}
text:CeruleanCity_House4_IncredibleNewsHaveBerries	{'body': "Oh, oh!\\nTh-this news report!\\pHmm…\\pAmazing!\\nWhat an incredible piece of news!\\pI haven't seen a news story this\\nincredible in too long a time!\\pThanks for sharing this fantastic\\nnews. Have a bunch of BERRIES!$"}
text:CeruleanCity_House4_WishCouldShareNewsWithOthers	{'body': 'It seems such a shame to not share\\nthis news with other folks…\\pI wish I could tell someone…\\nLet others know the news…$'}
text:CeruleanCity_House4_ThanksForSpreadingNewsTakeThis	{'body': "Ah, you've spread the news for me?\\pGood news becomes worthwhile when\\nall sorts of people share it.\\pAs my thanks for your spreading\\nthe news, take this!$"}
text:CeruleanCity_House4_MagnificentNewsSpreadHaveBerries	{'body': "You've spread the news some more?\\nMagnificent!\\pThat piece of news must be\\ndelighted to be passed around so.\\pYes, indeed!\\pConsider this a show of\\nappreciation from me and the news.\\pI'll give you more BERRIES than\\nI usually do.$"}
text:CeruleanCity_House4_EnjoyingMyselfWithAllSortsOfNews	{'body': "I'm quite enjoying myself with all\\nsorts of news.\\pYes, I am satisfied!\\nI won't be bored for a while.$"}
text:CeruleanCity_House4_YourBerryPouchIsFull	{'body': 'Hm? Your BERRY POUCH is full.\\nMy gift remains ungiven, then.$'}
text:CeruleanCity_House1_AnyInterestInBerries	{'body': 'I concoct a variety of medicine\\nfrom BERRY POWDER.\\pUsing good BERRY POWDER, I can\\nmake any kind of medicine.\\pNow tell me, have you any interest\\nin BERRIES?$'}
text:CeruleanCity_House1_HaveJustTheThing	{'body': 'Ah, good! For you, then, I have\\njust the thing.$'}
text:CeruleanCity_House1_GoCrushBerriesAtDirectCorner	{'body': "There's something new on the second\\nfloor of POKéMON CENTERS, at the\\lDIRECT CORNER.\\pThey installed a Wireless Adapter\\nmachine for crushing BERRIES.\\pThis is where you come in.\\pI have a favor to ask, one that\\nI can entrust only to you.\\pCould you make BERRY POWDER for\\nme using that machine?\\pDon't forget, the machine is at the\\nDIRECT CORNER of POKéMON CENTERS.\\pI'll concoct medicine for you if\\nyou bring me some BERRY POWDER.\\pDon't forget, crush BERRIES into\\nBERRY POWDER and bring it to me.$"}
text:CeruleanCity_House1_WhyMustYouLieNoBerries	{'body': 'Why must you lie to me?\\pHow many BERRIES do you have?\\nNot a one!$'}
text:CeruleanCity_House1_TakeInterestInAllSortsOfThings	{'body': "You have no interest in BERRIES?\\pYoung one, it's important to take an\\ninterest in all sorts of things.$"}
text:CeruleanCity_House1_HaveYouBroughtBerryPowder	{'body': 'Er-hem! Have you brought me some\\nBERRY POWDER?$'}
text:CeruleanCity_House5_ExchangeWithWhat	{'body': 'With what would you like to \\nexchange it?$'}
text:CeruleanCity_House1_YoullExchangeBerryPowderForItem	{'body': "Fine, you'll exchange your BERRY\\nPOWDER for one {STR_VAR_1}?$"}
text:CeruleanCity_House1_DontHaveEnoughBerryPowder	{'body': "Hm? You don't have enough\\nBERRY POWDER.$"}
text:CeruleanCity_House1_TradeMoreBerryPowder	{'body': 'This is fine BERRY POWDER indeed.\\nIt will make excellent medicine.\\pWould you like to trade more BERRY\\nPOWDER for something else?$'}
text:CeruleanCity_House1_HopeToSeeYouAgain	{'body': "That's fine, then.\\nI'll hope to see you back again.$"}
text:CeruleanCity_House1_SeeMeIfYoudLikeToTradePowder	{'body': "Come see me if you'd like to trade\\nyour BERRY POWDER.$"}
text:CeruleanCity_Mart_RepelWorksOnWeakMons	{'body': "REPEL not only keeps bugs away,\\nit also works on weak POKéMON.\\pPut your strongest POKéMON at the\\nleft of the POKéMON LIST.\\pIf your first POKéMON is strong,\\nREPEL's effect is boosted.$"}
text:CeruleanCity_Mart_DoYouKnowAboutRareCandy	{'body': 'Do you know about ULTRA BALLS?\\nThey make difficult catches easier.\\pSave them for a rare POKéMON that\\nyou truly do not want to lose.$'}
text:CeruleanCity_PokemonCenter_1F_BillDoesWhateverForRareMons	{'body': "That BILL!\\pI heard that he'll do whatever it\\ntakes to get rare POKéMON.\\pHe's not above doing all sorts\\nof things, I've heard.$"}
text:CeruleanCity_PokemonCenter_1F_EveryoneCallsBillPokemaniac	{'body': "Have you heard about BILL?\\pEveryone calls him a POKéMANIAC!\\pI think people are just jealous of\\nBILL, though.\\pWho wouldn't want to boast about\\ntheir POKéMON?$"}
text:CeruleanCity_PokemonCenter_1F_BillCollectsRareMons	{'body': 'BILL has lots of POKéMON!\\nHe collects rare ones, too!$'}
text:CeruleanCity_PokemonCenter_1F_TryTradingUpstairs	{'body': "Why don't you go upstairs and try\\ntrading POKéMON with your friends?\\pYou could get a lot more variety\\nby trading.\\pThe POKéMON you get in trades grow\\nquickly, too.$"}
text:CinnabarIsland_DoorIsLocked	{'body': 'The door is locked…$'}
text:CinnabarIsland_BlaineLivedHereSinceBeforeLab	{'body': "CINNABAR GYM's BLAINE is quite the\\nodd fellow.\\pHe's lived on the island since way\\nbefore the LAB was built.$"}
text:CinnabarIsland_ScientistsExperimentInMansion	{'body': 'Scientists conduct experiments \\nin the burned-out building.\\pYou know, the one they call the\\nPOKéMON MANSION.$'}
text:CinnabarIsland_IslandSign	{'body': 'CINNABAR ISLAND\\nThe Fiery Town of Burning Desire$'}
text:CinnabarIsland_PokemonLab	{'body': 'POKéMON LAB$'}
text:CinnabarIsland_GymSign	{'body': 'CINNABAR ISLAND POKéMON GYM\\nLEADER: BLAINE\\lThe Hotheaded Quiz Master!$'}
text:CinnabarIsland_HeyIfItIsntPlayer	{'body': "Huh?\\nHey, if it isn't {PLAYER}!$"}
text:CinnabarIsland_ComeWithMeToOneIsland	{'body': "Look, it's me, BILL.\\nLong time no see!\\pI hope you're still using my\\nPC system.\\pWell, listen, since we met up here,\\nhow about spending time with me?\\pThere's this little island in the far\\nsouth called ONE ISLAND.\\pA friend invited me, so I'm on my\\nway out there.\\pHow about it?\\nDo you feel like coming with me?$"}
text:CinnabarIsland_AllRightLetsGo	{'body': "All right, then.\\nLet's go!$"}
text:CinnabarIsland_IllBeWaitingInPokeCenter	{'body': "What, are you too busy?\\pWell, all right.\\nThe boat hasn't arrived yet anyway.\\pI'll be waiting at the POKéMON\\nCENTER over there.\\pCome see me when you're done with\\nyour business here.$"}
text:CinnabarIsland_MyPalsBoatArrived	{'body': "Looks like my pal's boat arrived,\\ntoo.\\pHe sent it specially here to\\nCINNABAR to pick me up.$"}
text:CinnabarIsland_IfYouHaveTriPassYouCanGoAgain	{'body': "Hey, wasn't that a long cruise?\\pMy buddy CELIO seemed to enjoy\\nyour company.\\pI'm sure he'd welcome you if you\\nwere to visit him again.\\pIf you have a TRI-PASS, you can\\nalways take a ferry there from\\lVERMILION PORT.\\pAll right, thanks for your company!$"}
text:CinnabarIsland_Gym_BlaineIntro	{'body': 'Hah!\\pI am BLAINE, the red-hot LEADER\\nof CINNABAR GYM!\\pMy fiery POKéMON are all rough\\nand ready with intense heat!\\pThey incinerate all challengers!\\pHah!\\nYou better have BURN HEAL!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$'}
text:CinnabarIsland_Gym_BlaineDefeat	{'body': 'I have burned down to nothing!\\nNot even ashes remain!\\pYou have earned the VOLCANOBADGE.$'}
text:CinnabarIsland_Gym_FireBlastIsUltimateFireMove	{'body': "FIRE BLAST is the ultimate fire\\ntechnique.\\pDon't waste it on WATER POKéMON.$"}
text:CinnabarIsland_Gym_ExplainVolcanoBadge	{'body': 'Hah!\\pThe VOLCANOBADGE heightens the\\nSPECIAL stats of your POKéMON.\\pHere, you can have this, too!$'}
text:CinnabarIsland_Gym_ReceivedTM38FromBlaine	{'body': '{PLAYER} received TM38\\nfrom BLAINE.$'}
text:CinnabarIsland_Gym_BlainePostBattle	{'body': 'TM38 contains FIRE BLAST.\\nTeach it to FIRE-type POKéMON.\\pVULPIX or CHARMELEON would be\\nideal for that move.$'}
text:CinnabarIsland_Gym_MakeSpaceForThis	{'body': 'Make space for this, child!$'}
text:CinnabarIsland_Gym_ErikIntro	{'body': 'Do you know how hot POKéMON fire\\nbreath can get?$'}
text:CinnabarIsland_Gym_ErikDefeat	{'body': 'Yow!\\nHot, hot, hot!$'}
text:CinnabarIsland_Gym_ErikPostBattle	{'body': 'Fire, or to be more precise,\\ncombustion…\\p…Oxygen in the air…\\nBlah, blah, blah, blah…$'}
text:CinnabarIsland_Gym_QuinnIntro	{'body': 'I was a thief, but I went straight\\nas a TRAINER.$'}
text:CinnabarIsland_Gym_QuinnDefeat	{'body': 'I surrender!$'}
text:CinnabarIsland_Gym_QuinnPostBattle	{'body': "I get this uncontrollable urge to\\nsteal other people's POKéMON.$"}
text:CinnabarIsland_Gym_AveryIntro	{'body': "I've studied POKéMON thoroughly.\\nYou can't win!$"}
text:CinnabarIsland_Gym_AveryDefeat	{'body': 'Waah!\\nMy studies were insufficient!$'}
text:CinnabarIsland_Gym_AveryPostBattle	{'body': 'My theories are too complicated\\nfor you to understand.$'}
text:CinnabarIsland_Gym_RamonIntro	{'body': 'I like using FIRE-type POKéMON.\\nI just do.$'}
text:CinnabarIsland_Gym_RamonDefeat	{'body': 'Too hot to handle!$'}
text:CinnabarIsland_Gym_RamonPostBattle	{'body': "I wish there were a thief POKéMON.\\nI'd use that!$"}
text:CinnabarIsland_Gym_DerekIntro	{'body': 'I know why BLAINE became a\\nTRAINER.$'}
text:CinnabarIsland_Gym_DerekDefeat	{'body': 'Ow!$'}
text:CinnabarIsland_Gym_DerekPostBattle	{'body': 'Our LEADER, BLAINE, became lost\\nin the mountains but good.\\pNight fell when a fiery bird\\nPOKéMON appeared.\\pIts light allowed BLAINE to find\\nhis way down safely.$'}
text:CinnabarIsland_Gym_DustyIntro	{'body': "I've been to many GYMS, but this\\none best suits my style.$"}
text:CinnabarIsland_Gym_DustyDefeat	{'body': 'Yowza!\\nToo hot!$'}
text:CinnabarIsland_Gym_DustyPostBattle	{'body': 'PONYTA, NINETALES…\\nThose are popular FIRE POKéMON.$'}
text:CinnabarIsland_Gym_ZacIntro	{'body': 'Fire is weak against H2O.$'}
text:CinnabarIsland_Gym_ZacDefeat	{'body': 'Oh!\\nSnuffed out!$'}
text:CinnabarIsland_Gym_ZacPostBattle	{'body': 'Water beats fire, of course.\\pBut fire melts ice, so the FIRE\\ntype beats ICE-type POKéMON.$'}
text:CinnabarIsland_Gym_GymGuyAdvice	{'body': "Yo!\\nChamp in the making!\\pThe hotheaded BLAINE is a FIRE\\nPOKéMON pro.\\pDouse his spirits with water!\\pYou'd better take some\\nBURN HEALS, too.$"}
text:CinnabarIsland_Gym_GymGuyPostVictory	{'body': '{PLAYER}!\\nYou beat that firebrand!$'}
text:CinnabarIsland_Gym_GymStatue	{'body': 'CINNABAR POKéMON GYM\\nLEADER: BLAINE\\pWINNING TRAINERS:\\n{RIVAL}$'}
text:CinnabarIsland_Gym_GymStatuePlayerWon	{'body': 'CINNABAR POKéMON GYM\\nLEADER: BLAINE\\pWINNING TRAINERS:\\n{RIVAL}, {PLAYER}$'}
text:CinnabarIsland_Gym_PokemonQuizRules	{'body': 'POKéMON Quiz!\\pGet it right, and the door opens to\\nthe next room.\\pGet it wrong, and face a TRAINER!\\pIf you want to conserve your\\nPOKéMON for the GYM LEADER…\\pThen get it right!\\nHere we go!$'}
text:CinnabarIsland_Gym_QuizQuestion1	{'body': 'CATERPIE evolves into METAPOD?$'}
text:CinnabarIsland_Gym_QuizQuestion2	{'body': 'There are nine certified POKéMON\\nLEAGUE BADGES?$'}
text:CinnabarIsland_Gym_QuizQuestion3	{'body': 'POLIWAG evolves three times?$'}
text:CinnabarIsland_Gym_QuizQuestion4	{'body': 'Are electric moves effective\\nagainst GROUND-type POKéMON?$'}
text:CinnabarIsland_Gym_QuizQuestion5	{'body': 'POKéMON of the same kind and level\\nare not identical?$'}
text:CinnabarIsland_Gym_QuizQuestion6	{'body': 'TM28 contains TOMBSTONY?$'}
text:CinnabarIsland_Gym_CorrectGoOnThrough	{'body': "You're absolutely correct!\\pGo on through!$"}
text:CinnabarIsland_Gym_SorryBadCall	{'body': 'Sorry!\\nBad call!$'}
text:CinnabarIsland_Mart_DontTheyHaveXAttack	{'body': "Don't they have X ATTACK?\\pI like it because it raises the\\nATTACK stat in battle.$"}
text:CinnabarIsland_Mart_ExtraItemsNeverHurt	{'body': 'It never hurts to have extra items.\\nYou never know what might happen.$'}
text:CinnabarIsland_PokemonCenter_1F_CinnabarGymLocked	{'body': "I came to visit the CINNABAR GYM,\\nbut the door is locked tight.\\pThere should be a key for it\\nsomewhere.\\pCould it be in that burned-out\\nmansion?\\pThe GYM LEADER's friend used to\\nlive there, they say.$"}
text:CinnabarIsland_PokemonCenter_1F_VisitUnionRoom	{'body': 'Do you have lots of friends?\\pLinking up with the usual friends\\nis fun, of course.\\pBut how about visiting the\\nUNION ROOM every so often?\\pWho knows, you may end up making\\nnew friends.\\pI think it would be worth your time\\nto check the UNION ROOM.$'}
text:CinnabarIsland_PokemonCenter_1F_EvolutionCanWaitForNewMoves	{'body': 'POKéMON can still learn techniques\\nafter canceling evolution.\\pEvolution can wait until new moves\\nhave been learned.$'}
text:CinnabarIsland_PokemonCenter_1F_ReadyToSailToOneIsland	{'body': 'BILL: Hey, you kept me waiting!\\nReady to set sail to ONE ISLAND?$'}
text:CinnabarIsland_PokemonCenter_1F_OhNotDoneYet	{'body': "Oh, you're still not done yet?$"}
text:CinnabarIsland_PokemonCenter_1F_LetsGo	{'body': "Well, that's it.\\nLet's go!$"}
text:CinnabarIsland_Gym_PhotoOfBlaineAndFuji	{'body': "It's a photo of BLAINE and\\nMR. FUJI.\\pThey're standing shoulder to\\nshoulder with big grins.$"}
text:CinnabarIsland_PokemonLab_Entrance_StudyMonsExtensively	{'body': 'We study POKéMON extensively\\nevery day.\\pPeople often bring us rare POKéMON\\nfor examination.$'}
text:CinnabarIsland_PokemonLab_Entrance_PhotoOfLabFounderDrFuji	{'body': "A photo of the LAB's founder…\\nDR. FUJI?!$"}
text:CinnabarIsland_PokemonLab_Entrance_MeetingRoomSign	{'body': 'POKéMON LAB\\nMeeting Room$'}
text:CinnabarIsland_PokemonLab_Entrance_RAndDRoomSign	{'body': 'POKéMON LAB\\nR & D Room$'}
text:CinnabarIsland_PokemonLab_Entrance_TestingRoomSign	{'body': 'POKéMON LAB\\nTesting Room$'}
text:MetronomeTeach	{'body': "Tch-tch-tch!\\nI'll teach you a nifty move.\\pTeach it to a POKéMON, and watch\\nthe fun unfold!\\pIt's a move called METRONOME.\\nDoes it strike your fancy?$"}
text:MetronomeDeclined	{'body': "I tell you, it's a lot of fun!$"}
text:MetronomeWhichMon	{'body': 'Okay!\\nWhich POKéMON should I teach?$'}
text:MetronomeTaught	{'body': "Tch-tch-tch!\\nThat's the sound of a METRONOME.\\pIt tweaks your POKéMON's brain into\\nusing moves it doesn't even know.$"}
text:CinnabarIsland_PokemonLab_ExperimentRoom_HaveYouAFossilForMe	{'body': 'Hiya!\\pI am important doctor.\\nYes, very much so, indeed.\\pHere, I study rare POKéMON fossils.\\nAll the time, I study.\\pYou!\\nHave you a fossil for me?$'}
text:CinnabarIsland_PokemonLab_ExperimentRoom_NoIsTooBad	{'body': 'No!\\nIs too bad!$'}
text:CinnabarIsland_PokemonLab_ExperimentRoom_TakesTimeGoForWalkJP	{'body': 'ちょっと\u3000じかん\u3000かかるよ！\\pそこらへんを\u3000すこし\\nブラブラ\u3000してくると\u3000よろしー！$'}
text:CinnabarIsland_PokemonLab_ExperimentRoom_FossilMonBackToLife	{'body': 'You late.\\nWhere were you?\\pYour fossil is back to life!\\nIt was {STR_VAR_1} like I think!$'}
text:CinnabarIsland_PokemonLab_ExperimentRoom_ReceivedMonFromDoctor	{'body': '{PLAYER} received the {STR_VAR_1}\\nfrom the doctor.$'}
text:CinnabarIsland_PokemonLab_ExperimentRoom_NoRoomForPokemon	{'body': 'ポケモン\u3000いっぱいで\u3000もてないね！$'}
text:CinnabarIsland_PokemonLab_ExperimentRoom_ThatFossilIsOfMonMakeItLiveAgain	{'body': 'Oh!\\nThat is {STR_VAR_2}, it is!\\pIt is fossil of {STR_VAR_1},\\na POKéMON that is already extinct!\\pMy Resurrection Machine will make\\nthat POKéMON live again!$'}
text:CinnabarIsland_PokemonLab_ExperimentRoom_HandedFossilToWeirdDoctor	{'body': 'So!\\nYou hurry and give me that!\\p{FONT_NORMAL}{PLAYER} handed over the\\n{STR_VAR_2} to the weird doctor.$'}
text:CinnabarIsland_PokemonLab_ExperimentRoom_TakesTimeGoForWalk	{'body': 'I take a little time!\\nYou go for walk a little while!$'}
text:CinnabarIsland_PokemonLab_ExperimentRoom_YouComeAgain	{'body': 'Aiyah!\\nYou come again!$'}
text:CinnabarIsland_PokemonLab_Lounge_FoundFossilInMtMoon	{'body': "I found this most remarkable fossil\\ninside MT. MOON.\\pI think it's of a rare, prehistoric\\nPOKéMON.$"}
text:CinnabarIsland_PokemonLab_ResearchRoom_EeveeCanEvolveIntroThreeMons	{'body': 'EEVEE can evolve into one of three\\nkinds of POKéMON.$'}
text:CinnabarIsland_PokemonLab_ResearchRoom_LegendaryBirdEmail	{'body': "There's an e-mail message.\\p… … …\\pThere are three legendary bird\\nPOKéMON.\\pThey are ARTICUNO, ZAPDOS, and\\nMOLTRES.\\pTheir whereabouts are unknown.\\pWe plan to explore the cavern\\nclose to CERULEAN.\\pFrom: POKéMON RESEARCH TEAM…$"}
text:CinnabarIsland_PokemonLab_ResearchRoom_AnAmberPipe	{'body': 'An amber pipe!$'}
text:DesertUnderpass.FoundRootFossil	{'body': '{PLAYER} found the ROOT FOSSIL.$'}
text:DesertUnderpass.FoundClawFossil	{'body': '{PLAYER} found the CLAW FOSSIL.$'}
text:DewfordManor_1F.Historian	{'body': "This manor housed Hoenn's first study\\nof MEGA EVOLUTION.\\pThe researchers found that a stone is\\nonly a key. Trust supplies the power.\\pTheir final entry mentions a crystal\\nchamber beneath SOOTOPOLIS.$"}
text:DewfordMeadow.Warden_Helped	{'body': 'Your partner sings with the warden.\\nA distant melody answers the song!$'}
text:DewfordMeadow.Warden	{'body': 'Our meadow shelters some\\nremarkable visitors. Check its\\lsign for the local POKéMON.\\pCOSMOG and MUNKIDORI are rare\\nwild residents. A caught legend\\lstops appearing; the sign\\lrecords it as Caught.\\pMELOETTA answers songs. With the\\nKNUCKLE BADGE, bring a partner\\lwith SING and we can perform.\\pWe only need to sing once.\\nAfter it answers, search here.\\lLet me check our field notes.$'}
text:DewfordMeadow.ManorSign	{'body': "DEWFORD MANOR\\pA sea captain's retreat, later a\\nhome for MEGA EVOLUTION research.\\pPlease respect the POKéMON that\\nnow shelter inside.$"}
text:DewfordMeadow.MeloettaCaught	{'body': "MELOETTA has joined your journey!\\nI'll remember our song for years.\\pCheck the meadow sign for any\\nother discoveries still waiting.\\lYour catches are recorded there.$"}
text:DewfordTown.BrawlyInSlateport	{'body': "Hey, Champ-to-be!\\pBRAWLY, the GYM LEADER here, went\\nto SLATEPORT's OCEANIC MUSEUM.\\pLook for him in the queue outside.\\nHe needs a nudge to come home!\\pMR. BRINEY can sail you there once\\nyou deliver STEVEN's LETTER.\\pFind STEVEN in GRANITE CAVE,\\nnorthwest of DEWFORD.$"}
text:DewfordTown.TinyIslandCommunity	{'body': "There's a meadow west of town.\\nLately, travelers have spotted\\lsome very unusual POKéMON there.\\pThe old manor holds records of\\nMEGA EVOLUTION. Someone must have\\lstudied it here long ago.$"}
text:DewfordTown.TownSign	{'body': 'DEWFORD TOWN\\n“A tiny island in the blue sea.”$'}
text:DewfordTown.GymSign	{'body': 'DEWFORD TOWN POKéMON GYM\\nLEADER: BRAWLY\\l“A big wave in fighting!”$'}
text:DewfordTown.HallSign	{'body': "DEWFORD HALL\\n“Everyone's information exchange!”$"}
text:Route104_LandedInDewfordDeliverLetter	{'body': "MR. BRINEY: Ahoy!\\nWe've hit land in DEWFORD.\\pI suppose you're off to deliver that\\nLETTER to, who was it now, STEVEN!$"}
text:DewfordTown.SetSailBackToPetalburg	{'body': 'MR. BRINEY: Have you delivered your\\nLETTER?\\pOr were you meaning to sail back to\\nPETALBURG?$'}
text:DewfordTown.PetalburgWereSettingSail2	{'body': "MR. BRINEY: PETALBURG it is, then!\\pAnchors aweigh!\\nPEEKO, we're setting sail, my darling!$"}
text:DewfordTown.GoDeliverIllBeWaiting	{'body': "MR. BRINEY: Look for GRANITE CAVE along\\nROUTE 106. That's where STEVEN went.\\pTake your time with the LETTER. PEEKO\\nand I will keep an eye on the boat!$"}
text:DewfordTown.BrineyLandedInDewford	{'body': "MR. BRINEY: Ahoy!\\nWe've hit land in DEWFORD!\\pYou just go on and tell me whenever\\nyou want to set sail again!$"}
text:DewfordTown.WhereAreWeBound	{'body': "MR. BRINEY: Ahoy! The LETTER's\\ndelivered, and the sea's still\\lcalling us!\\pNow, my friend, where are we\\nbound?$"}
text:DewfordTown.PetalburgWereSettingSail	{'body': "MR. BRINEY: PETALBURG, is it?\\pAnchors aweigh!\\nPEEKO, we're setting sail, my darling!$"}
text:DewfordTown.SlateportWereSettingSail	{'body': "MR. BRINEY: SLATEPORT, is it?\\nA fine harbor, and a busy one!\\pAnchors aweigh! PEEKO, we're off!$"}
text:DewfordTown.JustTellMeWhenYouNeedToSetSail	{'body': 'MR. BRINEY: You just tell me whenever\\nyou need to set sail again!$'}
text:DewfordTown.GettingItchToFish	{'body': 'This is a renowned fishing spot.\\nAre you getting the itch to fish?$'}
text:DewfordTown.GiveYouOneOfMyRods	{'body': "I hear you, and I like what\\nyou're saying!\\pI'll give you one of my fishing RODS.$"}
text:DewfordTown.ThrowInFishingAdvice	{'body': "And, as an added bonus, I'll even throw\\nin a little fishing advice!\\pFirst, you want to face the water,\\nthen use the ROD.\\pFocus your mind…\\nIf you get a bite, pull on the ROD.\\pSometimes you can snag something\\nimmediately, but with bigger catches,\\lyou need to time the pulls on your ROD\\lto haul them in.$"}
text:DewfordTown.ThatsTooBadThen	{'body': "Oh, is that so?\\nThat's too bad, then.$"}
text:DewfordTown.HowsYourFishing	{'body': "Yo!\\nHow's your fishing?$"}
text:DewfordTown.GreatHaulInSomeBigOnes	{'body': "Is that right! That's great!\\nHaul in some big ones!$"}
text:DewfordTown.FishingAdvice	{'body': "Oh, hey, don't get down on yourself!\\nI'll give you a little fishing advice.\\pFirst, you want to face the water,\\nthen use the ROD.\\pFocus your mind…\\nIf you get a bite, pull the ROD.\\pSometimes you can snag something\\nimmediately, but with bigger catches,\\lyou need to time the pulls on your ROD\\lto haul them in.$"}
text:DewfordTown.XIsTheBiggestHappeningThingRight	{'body': "I like what's hip, happening, and trendy.\\nI'm always checking it out.\\pListen, have you heard about this new\\n“{STR_VAR_1}”?\\pThat's right!\\nOf course you know!\\pI mean, sheesh,\\n“{STR_VAR_1}”…\\lIt's the hottest thing in cool!\\pWherever you're from,\\n“{STR_VAR_1}”\\lis the biggest happening thing, right?$"}
text:DewfordTown.TellMeWhatsNewAndIn	{'body': "Hunh?\\nIt's not the hip and happening thing?\\pWell, hey, you have to tell me,\\nwhat's new and what's “in”?$"}
text:DewfordTown.OfCourseIKnowAboutThat	{'body': "Hunh?\\n“{STR_VAR_2}”?\\p… …\\p…Uh… Yeah! That's right!\\nYeah, I knew that! Knew it all along!\\pOf course I know about that!\\n“{STR_VAR_2},” right?\\pYeah, that's it, it's there!\\nIsn't “{STR_VAR_2}”\\lthe coolest, or what?\\pIt's the hippest thing in hip.\\nYou think I'd not know about it?\\p“{STR_VAR_1}”…\\nIt's, like, so five minutes ago.\\pNow, “{STR_VAR_2}” is\\nwhat's vital and in tune with the times!$"}
text:DewfordTown.XHuhIThinkYIsCool	{'body': "Hmm…\\n“{STR_VAR_2},” huh?\\pBut personally, I think\\n“{STR_VAR_1}”\\lis what's real in cool.$"}
text:DewfordTown.HearOfAnyTrendsComeShareWithMe	{'body': 'Well, if you hear of any happening new\\ntrends, come share them with me, okay?$'}
text:DewfordTown.YeahDefinitionOfInRightNow	{'body': 'Yeah, absolutely right!\\p“{STR_VAR_1}” is the\\ndefinition of “in” right now.$'}
text:DewfordTown_Gym.GymGuideAdvice	{'body': 'BRAWLY brings a powerful Fighting\\nteam, but his partners do more\\lthan attack.\\pPACHIRISU draws single-target\\nmoves aside. His fighters use\\lspeed, priority and support to\\lcreate openings.\\pNormal Pokémon risk Fighting\\ndamage, but a useful support role\\lcan still earn a place on your\\lteam.\\pThe GYM grows brighter as you\\ndefeat its trainers. Make every\\laction count!$'}
text:DewfordTown_Gym.GymGuidePostVictory	{'body': "Whoah! It's turned too bright in here!\\pYour future is bright, too!$"}
text:DewfordTown_Gym.TakaoIntro	{'body': 'GRAPPLOCT can hold a target in\\nplace. WOBBUFFET makes switching\\ldifficult too.\\pLet us see how you handle the\\npressure!$'}
text:DewfordTown_Gym.TakaoDefeat	{'body': 'You won a tough battle!$'}
text:DewfordTown_Gym.TakaoPostBattle	{'body': "HITMONLEE's WHITE HERB can clear\\nits stat drops and activate\\lUNBURDEN.\\pSpeed can change in the middle of\\na turn. Watch the whole board.$"}
text:DewfordTown_Gym.JocelynIntro	{'body': 'TAILWIND can change the race in an\\ninstant.\\pFour turns of pressure. Can your\\nteam handle them?$'}
text:DewfordTown_Gym.JocelynDefeat	{'body': 'You took this battle!$'}
text:DewfordTown_Gym.JocelynPostBattle	{'body': "TAILWIND lasts four turns.\\nBRELOOM's POISON HEAL can keep it\\lgoing while the field changes.\\pPlan for the partners still in\\nreserve.$"}
text:DewfordTown_Gym.LauraIntro	{'body': 'FAKE OUT steals the first turn, and\\nGUTS makes my own burn a weapon.\\pCan you afford to blink?$'}
text:DewfordTown_Gym.LauraDefeat	{'body': 'That was a hard-fought win!$'}
text:DewfordTown_Gym.LauraPostBattle	{'body': 'Blank FAKE OUT, pressure the Flame Orb,\\nand never switch on instinct alone.$'}
text:DewfordTown_Gym.LilithIntro	{'body': 'INTIMIDATE softens you, then SCRAGGY\\ndances into the space it made.\\pWe build on every opening!$'}
text:DewfordTown_Gym.LilithDefeat	{'body': 'You brought a winning team!$'}
text:DewfordTown_Gym.LilithPostBattle	{'body': 'A paired battle is two complete teams,\\nnot one trick repeated twice.$'}
text:DewfordTown_Gym.BrendenIntro	{'body': "MACHOP's NO GUARD beats accuracy\\ntricks. SAWK has MOLD BREAKER.\\pThere is no safe angle here!$"}
text:DewfordTown_Gym.BrendenDefeat	{'body': 'We gave it everything!$'}
text:DewfordTown_Gym.BrendenPostBattle	{'body': 'Do not let one physical wall become your\\nanswer to an entire FIGHTING school.$'}
text:DewfordTown_Gym.CristianIntro	{'body': 'FALINKS strikes its own partner, and\\nJUSTIFIED turns the blow into power.\\pHurt us and we sharpen!$'}
text:DewfordTown_Gym.CristianDefeat	{'body': 'Our formation could not hold!$'}
text:DewfordTown_Gym.CristianPostBattle	{'body': 'FALINKS can power up JUSTIFIED\\nbefore its partner attacks.\\pGALLADE and LUCARIO can both use\\nthat opening. Always check who is\\lactive.$'}
text:DewfordTown_Gym.BrawlyIntro	{'body': "Back from SLATEPORT? Right on!\\pI'm BRAWLY, DEWFORD's GYM LEADER!\\pMy team draws attacks aside,\\nthen uses the space to set up.\\pDon't give us time to build momentum.\\nOnce we're rolling, we're hard to stop!$"}
text:DewfordTown_Gym.BrawlyDefeat	{'body': 'Whoa! You knocked me off balance!\\pTake the KNUCKLE BADGE. You earned it!$'}
text:DewfordTown_Gym.ReceivedKnuckleBadge	{'body': '{PLAYER} received the KNUCKLE BADGE\\nfrom BRAWLY.$'}
text:DewfordTown_Gym.KnuckleBadgeInfoTakeThis	{'body': 'The KNUCKLE BADGE lets your LEVELER\\ntrain a party up to Lv. 30.\\pIt also enables the hidden move FLASH\\noutside of battle.\\pTake this rare MEGA STONE, too.$'}
text:DewfordTown_Gym.ExplainLucarionite	{'body': "Lucarionite lets Lucario Mega Evolve.\\nYou'll soon receive the Ring it needs.$"}
text:DewfordTown_Gym.RegisteredBrawly	{'body': 'Registered GYM LEADER BRAWLY\\nin the POKéNAV.$'}
text:DewfordTown_Gym.BrawlyPostBattle	{'body': 'Return to STEVEN in GRANITE CAVE,\\nnorthwest of town, for your MEGA RING.\\pYour new BADGE lets you use FLASH\\nto light the way inside.$'}
text:DewfordTown_Gym.GymStatue	{'body': 'DEWFORD TOWN POKéMON GYM$'}
text:DewfordTown_Gym.GymStatueCertified	{'body': "DEWFORD TOWN POKéMON GYM\\pBRAWLY'S CERTIFIED TRAINERS:\\n{PLAYER}$"}
text:DewfordTown_Gym.BrawlyPreRematch	{'body': "BRAWLY: A wave may draw back, but it\\nalways returns to the shore.\\pA giant wave of a talent like you…\\nI knew you would return!\\pShow me how much higher\\nyou've gone!$"}
text:DewfordTown_Gym.BrawlyRematchDefeat	{'body': 'Wow!\\nSwamped again!$'}
text:DewfordTown_Gym.BrawlyPostRematch	{'body': "BRAWLY: Battling is vast and it's deep.\\nYou can't see the bottom.\\lIt's just like the sea of HOENN!$"}
text:DewfordTown_Gym.BrawlyRematchNeedTwoMons	{'body': "BRAWLY: A wave may draw back, but it\\nalways returns to the shore.\\pA giant wave of a talent like you…\\nI knew you would return!\\pOh? You only have one POKéMON\\nthat can battle.\\pI'm sorry, but I'd like you to come back\\nwith at least two POKéMON.$"}
text:DewfordTown_Hall.TradeTropius	{'body': 'My {STR_VAR_2} longs for a new route.\\pTrade your {STR_VAR_1} for my\\n{STR_VAR_2}?$'}
text:DewfordTown_Hall.TradeComplete	{'body': 'A fair trade! Give {STR_VAR_2} room\\nto spread those broad leaves.$'}
text:DewfordTown_Hall.TradeDeclined	{'body': 'No pressure. Good trades should feel\\nright to both TRAINERS.$'}
text:DewfordTown_Hall.NeedRequestedMon	{'body': "That isn't a {STR_VAR_1}. I promised\\nmy partner an even exchange.$"}
text:DewfordTown_Hall.TropiusDoingWell	{'body': "How is TROPIUS? DEWFORD's sea breeze\\nnever quite suited those leaves.$"}
text:DewfordTown_Hall.CantImagineLifeWithoutTrend	{'body': "What's in vogue? Why, it has to be\\n“{STR_VAR_1}”!\\pI can't imagine what life would be like\\nwithout that trend!$"}
text:DewfordTown_Hall.GettingBoredOfTrend	{'body': "What's in vogue? Why, it has to be\\n“{STR_VAR_1}”!\\pBut I'm getting kind of bored with it.\\pI should look for the next big thing.$"}
text:DewfordTown_Hall.TeachingMonAboutTrend	{'body': "I'm teaching my POKéMON about\\n“{STR_VAR_1},”\\lbut it's not going well.\\pIt's a bit too much, I think.$"}
text:DewfordTown_Hall.DeepLinkBetweenXAndY	{'body': "I'm studying up on the hip and trendy\\n“{STR_VAR_1}” now.\\pIs there a deep link between\\n“{STR_VAR_1}”\\land “{STR_VAR_2}”?$"}
text:DewfordTown_Hall.MyHunchWasRight	{'body': "Oh!\\nSo, my hunch was right!\\pI'm one step closer to being hip and\\nhappening, yowza!$"}
text:DewfordTown_Hall.NotEasyToKeepUp	{'body': "What?!\\nIs that so?!\\pIt's not easy for an older fellow like\\nme to keep up with trends!$"}
text:DewfordTown_Hall.TVShowAboutTrend	{'body': "This whole business about\\n“{STR_VAR_1}”…\\lIsn't there a TV show on it?$"}
text:DewfordTown_Hall.IsTrendMorePopularAcrossSea	{'body': 'Across the sea…\\pIs “{STR_VAR_1}”\\neven more popular?$'}
text:DewfordTown_Hall.CollectTrendMerchandise	{'body': "I collect official\\n“{STR_VAR_1}”\\llicensed merchandise.\\pI have official\\n“{STR_VAR_1}” DOLLS…\\pOfficial clothing for\\n“{STR_VAR_1}”…\\pAnd officially licensed\\n“{STR_VAR_1}”\\lpicture books.\\pHeheh, I own!\\nI'm not sharing anything with you!$"}
text:DewfordTown_Hall.BooksAboutTrend	{'body': "IDENTIFYING GOOD\\n“{STR_VAR_1}” &\\lBAD “{STR_VAR_1}”…\\pTHE LINK BETWEEN\\n“{STR_VAR_1}” AND\\lPOKéMON…\\pUSEFUL\\n“{STR_VAR_1}”…\\pIt's neatly jammed with books about\\n“{STR_VAR_1}.”$"}
text:DewfordTown_Hall.TrendsScream	{'body': "“{STR_VAR_1}'S\\nSCREAM” is the title.$"}
text:DewfordTown_Hall.TrendsSmile	{'body': "“{STR_VAR_1}'S\\nSMILE” is the title.$"}
text:DewfordTown_Hall.LastTrend	{'body': "It's titled “THE LAST\\n{STR_VAR_1}”.$"}
text:DewfordTown_Hall.BirthOfTrend	{'body': "It's titled “THE BIRTH OF\\n{STR_VAR_1}”.$"}
text:DewfordTown_Hall.SawTrendCoolestThing	{'body': "I saw “{STR_VAR_1}”!\\nCool, huh?\\pIt's, like, the coolest thing going!\\pIt was awesome!\\nIt was the real thing, oh yeah!$"}
text:DewfordTown_Hall.AllegedTrendNotAuthentic	{'body': "Oh, no, no, no.\\pThat alleged\\n“{STR_VAR_1}”\\lyou claim to have seen--it's not.\\pThe authentic article is much…\\nHow should I say it?\\lSharper, yet more mellow!\\pAh, no matter. It's astonishing!$"}
text:DewfordTown_Hall.ComposedTrendThemeSong	{'body': 'Hey, listen, I composed a theme song\\nfor “{STR_VAR_1}.”\\p“{STR_VAR_1}”\\nis really popular right now.\\pOkay, listen!\\n… …\\pOh!\\n{STR_VAR_1}!\\pWonderful\\n{STR_VAR_1}!$'}
text:DewfordTown_Hall.WorkOnYourSinging	{'body': '… …\\pI dare say, chap, it would pay for you\\nto work on your singing before you\\ltrifle yourself with\\l“{STR_VAR_1}.”$'}
text:DewfordTown_Hall.OrganizeTrendParty	{'body': 'Anyway, as I was saying earlier, we\\nshould get together and organize a\\l“{STR_VAR_1}” party\\lon the island.$'}
text:DewfordTown_Hall.BrilliantIndeed	{'body': 'Oh, a smashing good idea!\\pIt will settle once and for all\\nwho is the best at\\l“{STR_VAR_1}.”\\lBrilliant, indeed!\\pStarting today, our lives will revolve\\naround that trend!$'}
text:DewfordTown_Hall.TrendHasBecomePartOfLife	{'body': "I was thinking, though…\\pWouldn't you agree that\\n“{STR_VAR_1}” has\\lgrown from being something trendy to\\lbeing a part of our daily lives?$"}
text:DewfordTown_Hall.TrendWeighsHeavilyOnMind	{'body': "Beg pardon?\\nThat much, what?\\pHowever, it's true that\\n“{STR_VAR_1}”\\lweighs heavily on your mind, whether\\lyou're awake or asleep.\\pAbsolutely, you're the\\n“{STR_VAR_1}”\\lPROFESSOR, old sport!$"}
text:DewfordTown_Hall.IfWeTeamUpWellBeInvincible	{'body': "If you and me team up as a combo,\\nwe'll be invincible when it comes to all\\lthings trendy!$"}
text:DewfordTown_Hall.WellBeTrendDuo	{'body': "Spot on, my friend!\\pWe shall be the\\n“{STR_VAR_1}” DUO!\\pIsn't that a ripe image?\\nHahahah!$"}
text:DewfordTown_Hall.GiveYouDeepSeaScale	{'body': 'The Deep Sea Scale is trending!\\pIt evolves Clamperl into Gorebyss.$'}
text:DewfordTown_Hall.ScaleAndTrend	{'body': 'That DEEP SEA SCALE evolves\\nCLAMPERL into GOREBYSS. Use it\\lfrom the BAG when ready.\\pAnd the latest trend?\\n“{STR_VAR_1}” is\\lmaking waves, too.$'}
text:DewfordTown_House1.LotToBeSaidForLivingOnIsland	{'body': "There's a lot to be said for living on\\na small island like this in harmony with\\lPOKéMON and the family.$"}
text:DewfordTown_House1.LifeGoesSlowlyOnIsland	{'body': "I left the major port of SLATEPORT\\nCITY when I married my husband here.\\pLife goes by slowly on this little\\nisland. But being surrounded by the\\lbeautiful sea--that's happiness, too.$"}
text:DewfordTown_House1.Zigzagoon	{'body': 'ZIGZAGOON: Guguuh!$'}
text:DewfordTown_House1.MegaGift_BARBARACITE_Text	{'body': 'I found this in a tide pool, held\\ntight between two little claws.\\pA Binacle has a stubborn grip.\\nIts grown form can use this stone.$'}
text:DewfordTown_House2.WantYouToHaveReaperCloth	{'body': 'Gorge your eyes on this rare\\nREAPER CLOTH! Spooky, yet stylish!\\pYou appreciate my dazzling taste.\\nHere, I want you to have it!$'}
text:DewfordTown_House2.NoRoom	{'body': "Oh, you don't have room?\\pThis REAPER CLOTH is rare! Make room\\nand come back for it.$"}
text:DewfordTown_House2.ExplainReaperCloth	{'body': 'A Reaper Cloth evolves Dusclops.\\nUse it from the Bag when ready.$'}
text:DewfordTown_House2.BrawlySoCool	{'body': "Wow, you bothered to cross the sea\\nto visit DEWFORD?\\pDid you maybe come here because you\\nheard about BRAWLY?\\pHe's so cool…\\nEveryone idolizes him.$"}
text:DewfordTown_House2.MegaGift_KINGLERITE_Text	{'body': 'I followed a Krabby along the shore\\nand found this where it was digging.\\pWhen its claw is big and strong,\\nthis stone could make it stronger!$'}
text:DewfordTown_House2.MegaGift_GYARADOSITE_Text	{'body': 'The fish you overlook today might\\ncarry you through a storm tomorrow.\\pRaise a Magikarp with care.\\nThis stone is for its grown form.$'}
text:DewfordTown_PokemonCenter_1F.StoneCavern	{'body': "Off to explore the cavern?\\nThere are rare stones in there.\\pIf you've earned the STONE BADGE,\\nyour level cap is now 20. Use\\lthe LEVELER before heading out!\\pA new evolution may suit a new\\nBattle Set. The TUTOR can help\\lyou prepare for BRAWLY, too.$"}
text:DewfordTown_PokemonCenter_1F.FaintedMonCanUseHM	{'body': 'With an HM and its BADGE, a\\ncompatible partner can use skills\\lsuch as CUT without a move slot.\\pEven a fainted partner can help.\\nFLASH is different: get its HM\\land BADGE, and caves light up\\las you enter. No partner needed!$'}
text:DiglettsCave_NorthEntrance_RockTunnelPitchBlack	{'body': "I went inside ROCK TUNNEL, but it's\\npitch-black and scary in there.\\pIf I could get a POKéMON to use\\nFLASH and light it up…$"}
text:DiglettsCave_SouthEntrance_DiglettDugThisTunnel	{'body': "Well, isn't this a surprise!\\nDIGLETT dug this long tunnel!\\pIt goes right to VIRIDIAN CITY,\\nthey tell me.$"}
text:EmberPath.Warden	{'body': 'The mountain has been restless.\\nTEAM MAGMA tampering with it\\lcertainly did not help.\\pMOLTRES roosts along this path.\\nIt seems quite at home with the heat.$'}
text:EmberPath.WardenMoltresCaught	{'body': 'MOLTRES has left its roost here\\nto travel with you.\\pThe mountain is still restless.\\nTake care along the hot slopes.$'}
text:EverGrandeCity.EnteringVictoryRoad	{'body': 'ENTERING VICTORY ROAD$'}
text:EverGrandeCity.EnteringPokemonLeague	{'body': 'ENTERING POKéMON LEAGUE\\nCENTER GATE$'}
text:EverGrandeCity.CitySign	{'body': 'EVER GRANDE CITY\\p“The paradise of flowers, the sea,\\nand POKéMON.”$'}
text:EverGrandeCity_ChampionsRoom.IntroSpeech	{'body': "WALLACE: Welcome, {PLAYER}.\\pWhen we met in SOOTOPOLIS, HOENN\\nneeded your courage. Today,\\lyou've come here to pursue your\\lown dream.\\pEight BADGES. The ELITE FOUR. You\\nand your partners have earned\\lthis challenge.\\pI am WALLACE, HOENN's CHAMPION. I\\nwill give you everything I have!$"}
text:EverGrandeCity_ChampionsRoom.Defeat	{'body': 'You have beaten my finest team.\\nMagnificent!$'}
text:EverGrandeCity_ChampionsRoom.PostBattleSpeech	{'body': 'WALLACE: This victory belongs to\\nyou and the partners who brought\\lyou here.\\pAll the roads you traveled, all\\nthe people and POKéMON you met…\\lThey brought you to this moment.\\pI proclaim you the new HOENN\\nCHAMPION!$'}
text:EverGrandeCity_ChampionsRoom.MayAdvice	{'body': "MAY: {PLAYER}{KUN}! One thing before\\nWALLACE.\\pWatch his remaining partners.\\nA strong opening isn't the whole battle.$"}
text:EverGrandeCity_ChampionsRoom.MayItsAlreadyOver	{'body': "MAY: Huh? Wait. Your face…\\p{PLAYER}{KUN}… It's already over,\\nisn't it?$"}
text:EverGrandeCity_ChampionsRoom.BrendanAdvice	{'body': "BRENDAN: {PLAYER}! Advice before\\nWALLACE, if you want it.\\pWatch his remaining partners.\\nDon't let a winning turn distract you.$"}
text:EverGrandeCity_ChampionsRoom.BrendanYouveWon	{'body': "BRENDAN: {PLAYER}…\\pDon't tell me. You already beat him.$"}
text:EverGrandeCity_ChampionsRoom.BirchArriveRatePokedex	{'body': "BIRCH: You did it, {PLAYER}!\\pIt seems like yesterday you and\\nthose two POKéMON rescued me on\\lROUTE 101. Now look at you!\\pMay I see your POKéDEX? I'd love\\nto see the record of your\\ljourney.$"}
text:EverGrandeCity_ChampionsRoom.BirchCongratulations	{'body': 'BIRCH: Congratulations, {PLAYER}!\\nYour parents will be so proud.\\pAnd thank you, all of you\\nPOKéMON, for looking after our\\lnew CHAMPION!$'}
text:EverGrandeCity_ChampionsRoom.WallaceComeWithMe	{'body': 'WALLACE: {PLAYER}{KUN}…\\pNo, let me rephrase that properly.\\pThe new CHAMPION!\\pCome with me.$'}
text:EverGrandeCity_ChampionsRoom.WallaceWaitOutside	{'body': "WALLACE: I'm sorry, but…\\pFrom here on, only those TRAINERS who\\nhave become CHAMPIONS may enter.\\pYou'll have to wait outside with\\nPROF. BIRCH.$"}
text:EverGrandeCity_ChampionsRoom.MayCongratulations	{'body': "MAY: Aww… I wanted to come, too!\\pHehe! Go on, {PLAYER}{KUN}. This\\nis your moment.\\pI'm so happy for you.\\nCongratulations!$"}
text:EverGrandeCity_ChampionsRoom.BrendanCongratulations	{'body': 'BRENDAN: What?! I wanted to see\\nit!\\pAll right, all right. You earned\\nthis, {PLAYER}.\\pWay to go! Dad will be talking\\nabout this for weeks!$'}
text:EverGrandeCity_DrakesRoom.IntroSpeech	{'body': "DRAKE. Last of the four, and the one\\nwho's sailed the longest.\\pDragons remember every age of battle.\\nSALAMENCE can bring a TAILWIND.\\pKORAIDON brings sunlight for\\nRESHIRAM's flames.\\pKeep something for MEGA GARCHOMP.\\nCome on!$"}
text:EverGrandeCity_DrakesRoom.Defeat	{'body': 'Hah! My Dragons gave you everything.\\nSuperb, Trainer. Superb.$'}
text:EverGrandeCity_DrakesRoom.PostBattleSpeech	{'body': "Heal up. Beyond that door WALLACE will\\nthrow every lesson at you at once.\\pGo on. The CHAMPION's waiting.$"}
text:EverGrandeCity_GlaciasRoom.IntroSpeech	{'body': 'GLACIA. I came far for opponents\\nworth the cold.\\pSnow is patience. The VEIL buys time,\\nthe wind rearranges order, and one\\lpowerful Dragon waits behind it.\\pChanging the weather is one answer.\\nBut the VEIL can outlast the snow.$'}
text:EverGrandeCity_GlaciasRoom.Defeat	{'body': '…Your team weathered the battle.\\nAcceptable.$'}
text:EverGrandeCity_GlaciasRoom.PostBattleSpeech	{'body': "DRAKE waits ahead. He's sailed\\nthrough many storms with his\\lDRAGON POKéMON.\\pYou have earned his full\\nattention.$"}
text:EverGrandeCity_HallOfFame.HereWeHonorLeagueChampions	{'body': 'WALLACE: This room…\\pThis is where we keep records of\\nPOKéMON that prevailed through\\lharsh battles.\\pIt is here that the LEAGUE CHAMPIONS\\nare honored.$'}
text:EverGrandeCity_HallOfFame.LetsRecordYouAndYourPartnersNames	{'body': "WALLACE: Come on, let's record your\\nname as a TRAINER who triumphed over\\lthe POKéMON LEAGUE, and the names of\\lthe partners who battled with you.$"}
text:EverGrandeCity_PhoebesRoom.IntroSpeech	{'body': 'Welcome. I am PHOEBE.\\pI trained on MT. PYRE, where the ones\\nwho are gone still take part.\\pMy friends can steal your boosts\\nand wear down your strength with burns.\\pKeep something for SPECTRIER.\\nEach knockout can make it stronger.$'}
text:EverGrandeCity_PhoebesRoom.Defeat	{'body': 'What a wonderful team! My\\ngrandmother would love to meet\\lyour POKéMON.$'}
text:EverGrandeCity_PhoebesRoom.PostBattleSpeech	{'body': 'Rest a moment if you need to.\\pGLACIA can shelter her team with\\nAURORA VEIL. Prepare for her snow.$'}
text:EverGrandeCity_PokemonCenter_1F.LeagueAfterVictoryRoad	{'body': "The POKéMON LEAGUE is only a short\\ndistance after the VICTORY ROAD.\\pIf you've come this far, what choice\\ndo you have but to keep going?$"}
text:EverGrandeCity_PokemonCenter_1F.BelieveInYourPokemon	{'body': "The long and harrowing VICTORY ROAD…\\pIt's like reliving the path one has\\ntraveled in life…\\pBelieve in your POKéMON and give it\\nyour very best!$"}
text:EverGrandeCity_PokemonCenter_1F.ScottHappyForYou	{'body': "SCOTT: {PLAYER}{KUN}! You've made\\nit to the POKéMON LEAGUE!\\pI knew you were one to watch. Now\\nyou've got a shot at the\\lchampionship!\\pI'll be cheering for you. Give\\nthem a battle they'll remember!$"}
text:EverGrandeCity_PokemonLeague_1F.MustHaveAllGymBadges	{'body': 'Beyond this point, only those TRAINERS\\nwho have collected all the GYM BADGES\\lare permitted to enter.\\pTRAINER, let us confirm that you have\\nall the GYM BADGES.$'}
text:EverGrandeCity_PokemonLeague_1F.HaventObtainedAllBadges	{'body': "You need all eight GYM BADGES.\\pIf you're bound for the POKéMON\\nLEAGUE, you must return with them.$"}
text:EverGrandeCity_PokemonLeague_1F.GoForth	{'body': 'TRAINER! Believe in yourself and your\\nPOKéMON, and go forth!$'}
text:EverGrandeCity_SidneysRoom.IntroSpeech	{'body': "Heh. SIDNEY. First door, best door.\\pMy crew fights dirty. Fake Out, sleep,\\nTAILWIND to keep you chasing.\\lYou'll think you've read it.\\pThen ABSOL shows up and the reading\\nwas wrong. Let's go, kid!$"}
text:EverGrandeCity_SidneysRoom.Defeat	{'body': 'Ha! You got the better of my crew.\\nThat was a good time.$'}
text:EverGrandeCity_SidneysRoom.PostBattleSpeech	{'body': "Patch up from your BAG if you want.\\pPHOEBE's next. Her idea of “safe” is\\nnot gonna match yours.$"}
text:FallarborTown.MayDisaster	{'body': 'MAY: Oh! {PLAYER}{KUN}! Help!$'}
text:FallarborTown.BrendanComeHere	{'body': 'BRENDAN: {PLAYER}! Come here!$'}
text:FallarborTown.MayWeirdos	{'body': "MAY: PROF. COZMO was abducted by\\nTEAM MAGMA!\\pI'm heading for METEOR FALLS now.\\nPlease catch up and help us!$"}
text:FallarborTown.BrendanNuts	{'body': "BRENDAN: PROF. COZMO was abducted by\\nTEAM MAGMA!\\pI'm heading for METEOR FALLS now.\\nCatch up as soon as you can!$"}
text:FallarborTown.ShadyCharactersCozmosHome	{'body': "Something's happening,\\nand I don't like it!\\pI've seen shady characters wandering\\nin and out of PROF. COZMO's home…$"}
text:FallarborTown.RegionKnownForMeteors	{'body': "This region's been known for meteors\\nsince the olden days.\\pThey say METEOR FALLS was gouged out\\nby a falling meteorite long ago.$"}
text:FallarborTown.MyPreciousAzurill	{'body': "See! Take a look!\\nThis is my precious AZURILL!\\pIt's slick and smooth and plushy, too!$"}
text:FallarborTown.Azurill	{'body': 'AZURILL: Rooreelooo.$'}
text:FallarborTown.HaveYouChallengedFlannery	{'body': "Have you already challenged FLANNERY,\\nthe LEADER of LAVARIDGE GYM?\\pThe girl's grandfather was famous.\\nHe was one of the ELITE FOUR in the\\lPOKéMON LEAGUE at one point.\\pIt wouldn't surprise me to see FLANNERY\\nbecome a great TRAINER in her own\\lright.$"}
text:FallarborTown.BattleTentSign	{'body': 'BATTLE TENT FALLARBOR SITE\\n“May the Greatest Teams Gather!”$'}
text:FallarborTown.TownSign	{'body': 'FALLARBOR TOWN\\n“A farm community with small gardens.”$'}
text:FallarborTown.MoveTutorSign	{'body': 'HEART SCALE WORKSHOP\\n“Scales polished into PP UPS.”$'}
text:FallarborTown_ContestHall_DoAllRightInPreliminary	{'body': 'We do all right in the preliminary round,\\nbut we can never win the appeals…\\pMaybe it means I have to watch what\\nother contestants are doing…$'}
text:FallarborTown_ContestHall_MonAllTheseRibbons	{'body': 'See!\\nMy POKéMON won all these RIBBONS!\\pHave your POKéMON earned any RIBBONS?\\nYou can check them on your POKéNAV.$'}
text:FallarborTown_ContestHall_CantWinEverywhere	{'body': "I can't beat GYM LEADERS…\\pI can't win any CONTESTS…\\pI've been here, there, and everywhere,\\nand it's all for naught…$"}
text:FallarborTown_ContestHall_SuperRankStage	{'body': 'POKéMON CONTESTS\\nSUPER RANK STAGE!$'}
text:FallarborTown_BattleTentLobby.MakeThinkImJustKid	{'body': "Fufufufufu.\\pI'm going to make everyone think\\nI'm just a kid and let them play down.\\pThen, I'll shock them and grab\\nthe title!$"}
text:FallarborTown_BattleTentLobby.FallarborTentMyFavorite	{'body': 'The tents share the same serious\\ndoubles competition.\\pFALLARBOR is my favorite place to\\nvisit between exhibitions.$'}
text:FallarborTown_BattleTentLobby.CameToCampOut	{'body': "I heard something about some tent,\\nso I came to camp out.\\pI didn't know that tents these days\\nare so luxurious!\\pSince I'm here, I may as well try\\nmy hand at battling!$"}
text:FallarborTown_BattleTentLobby.ScottLookingForSomeone	{'body': "SCOTT: Hi, {PLAYER}{KUN}!\\nSo you came out to this BATTLE TENT!\\pThe people in these parts tend to be\\neasygoing and laid-back.\\pBut, you see, what I'm looking for are\\npeople with…\\pHow should I say this?\\pSomeone bursting with the desire\\nand the drive to win.\\pIf there were a TRAINER like that,\\nI'd immediately…\\pWhoops! Never mind!\\nKeep working at it!$"}
text:FallarborTown_BattleTentLobby.ScottMakeChallenge	{'body': 'SCOTT: Instead of wasting your\\ntime with the likes of me, why not\\lmake a challenge?$'}
text:FallarborTown_BattleTentLobby.ExhibitionWelcome	{'body': 'Our challengers bring ideas from\\nthe mountains and far beyond.\\pThis is a six-Pokémon doubles\\nexhibition. You command every move\\land switch.\\pYour team uses the current cap.\\nDifficulty sets opponent levels.\\lEnter with six healthy partners?$'}
text:FallarborTown_BattleTentLobby.ExhibitionRules	{'body': 'LOCAL DOUBLES EXHIBITIONS\\pBring six healthy Pokémon, with no\\nEggs. Prepare freely before\\lentering.\\pThree victories earn one local\\nprize. Your party is restored\\lafter each exhibition.\\pThese results are separate from\\nthe CHAMPIONS CIRCUIT. You return\\lto this lobby afterward.$'}
text:FallarborTown_CozmosHouse.MeteoriteWillNeverBeMineNow	{'body': "PROF. COZMO: Oh…\\nI never should have let myself be\\lconned into telling TEAM MAGMA where\\lyou can find METEORITES…\\pThat METEORITE from METEOR FALLS…\\nIt's never going to be mine now…$"}
text:FallarborTown_CozmosHouse.IsThatMeteoriteMayIHaveIt	{'claims': (('rare', ('field', 'offer:FallarborTown_CozmosHouse.PlayerHasMeteorite.4', 'gain', 0, 0, 1)),), 'slots': {'reward': ('upper', ('field', 'offer:FallarborTown_CozmosHouse.PlayerHasMeteorite.4', 'gain', 0, 0, 1, 'name')), 'payment': ('upper', ('field', 'offer:FallarborTown_CozmosHouse.PlayerHasMeteorite.4', 'payment', 'name'))}, 'body': 'Oh! Is that the {payment} TEAM MAGMA\\ntook from METEOR FALLS?\\pPlease, may I have it? I can offer this\\nrare {reward} in exchange.$'}
text:FallarborTown_CozmosHouse.PleaseTakeThisDawnStone	{'body': 'This Dawn Stone is my thanks.\\nPlease put it to good use.$'}
text:FallarborTown_CozmosHouse.ReallyGoingToHelpMyResearch	{'body': "PROF. COZMO: Oh, I can't believe it.\\nThis is really, really great!\\pThis is really going to help my research!$"}
text:FallarborTown_CozmosHouse.CrushedWithDisappointment	{'body': "PROF. COZMO: Oh, but…\\nI'm crushed with disappointment…$"}
text:FallarborTown_CozmosHouse.MayIHaveMeteorite	{'claims': (('rare', ('field', 'offer:FallarborTown_CozmosHouse.PlayerHasMeteorite.4', 'gain', 0, 0, 1)),), 'slots': {'reward': ('upper', ('field', 'offer:FallarborTown_CozmosHouse.PlayerHasMeteorite.4', 'gain', 0, 0, 1, 'name')), 'payment': ('upper', ('field', 'offer:FallarborTown_CozmosHouse.PlayerHasMeteorite.4', 'payment', 'name'))}, 'body': 'PROF. COZMO: Please, may I have that\\nMETEORITE?\\pI can offer this rare {reward}\\nin exchange.$'}
text:FallarborTown_CozmosHouse.CozmoWentToMeteorFalls	{'body': 'PROF. COZMO went off to METEOR FALLS\\non ROUTE 114 with some people from\\lTEAM MAGMA.$'}
text:FallarborTown_CozmosHouse.FeelSorryForCozmo	{'body': "Poor PROF. COZMO…\\nHe's so depressed… I feel sorry for him.$"}
text:FallarborTown_CozmosHouse.CozmoIsSoHappy	{'body': "Look at PROF. COZMO…\\nHe's so happy! I think it's cute.$"}
text:FallarborTown_CozmosHouse.MegaGift_CLEFABLITE_Text	{'body': 'Cozmo studies what falls from space.\\nI notice who comes looking for it.\\pClefairy gather around these stones.\\nTake this one for its evolved form.$'}
text:FallarborTown_CozmosHouse.HisuianGoomy	{'body': 'METEOR FALLS has iron-rich stone. Level\\nGOOMY to Lv. 40 or higher in its main\\lentrance chamber for Hisuian SLIGGOO.\\pElsewhere, GOOMY keeps its usual form.\\nEither SLIGGOO evolves at Lv. 50 or\\lhigher when leveled in rain or fog.$'}
text:FallarborTown_Mart.MoveSpecialist	{'body': 'I once handed out DRAIN PUNCH as a TM.\\pNow every POKéMON CENTER specialist\\nteaches any legal move for free.$'}
text:FallarborTown_Mart.DecidingSkittyEvolve	{'body': "I'm having a hard time deciding if I\\nshould make my SKITTY evolve or not.\\pI only have to use this MOON STONE,\\nbut it's so hard to decide…\\pIf I make it evolve, it will become\\nmuch stronger.\\pBut it will look so different, too.$"}
text:FallarborTown_Mart.Skitty	{'body': 'SKITTY: Miyao?$'}
text:FallarborTown_Mart.SellNuggetIFound	{'body': "This NUGGET I found here…\\nI suppose I'll have to sell it, seeing\\las how it has no other use.$"}
text:FallarborTown_MoveRelearnersHouse.IvyEvieIntro1	{'body': "Hey there, TRAINER!\\pIf you want your POKéMON to be the very\\nbest in all of HOENN, you've come to\\lthe right place!\\pI'm EVIE, and this is my sister, IVY.$"}
text:FallarborTown_MoveRelearnersHouse.IvyEvieIntro2	{'body': 'IVY: We run the training programs that\\nseriously beef up your team!$'}
text:FallarborTown_MoveRelearnersHouse.IvyEvieIntro3	{'body': 'EVIE: IVY adjusts EVs for free.\\pI collect HEART SCALES and trade\\na PP UP for each one.\\pCome back as often as you like!$'}
text:FallarborTown_MoveRelearnersHouse.ImTheScaleCollector	{'body': "I'm a HEART SCALE collector.\\pThe tutors at every POKéMON CENTER\\nalready teach moves for free.\\pI polish HEART SCALES into PP UPS,\\none for one.\\pPP upgrades stay with their move slots\\nwhen you change a battle set.$"}
text:FallarborTown_MoveRelearnersHouse.TradeScaleForPPUp	{'body': 'Trade one HEART SCALE for one PP UP?$'}
text:FallarborTown_MoveRelearnersHouse.ExchangeComplete	{'body': "A fine trade! I can polish another\\nHEART SCALE whenever you're ready.$"}
text:FallarborTown_MoveRelearnersHouse.BringHeartScale	{'body': "Bring me a HEART SCALE and I'll trade\\nyou a PP UP.$"}
text:FallarborTown_MoveRelearnersHouse.NoRoomForPPUp	{'body': 'Your BAG has no room for a PP UP.\\nMake space before we trade.$'}
text:FallarborTown_MoveRelearnersHouse.MaybeLater	{'body': "No rush. Your HEART SCALE stays safe\\nwith you until you're ready.$"}
text:FallarborTown_PokemonCenter_1F.LanetteGreeting	{'body': "Oh, hello.\\nYou are?\\pOkay, your name's {PLAYER}{KUN}.\\nI can see that you're a TRAINER.\\pSo that means you use the POKéMON\\nStorage System I developed.\\pHow I arrived at that conclusion is\\na simple deductive process.\\pYou spoke to me because you wanted\\nto access something on this PC.\\pOh, I'm sorry. I'm LANETTE.\\pHonestly, I'm glad to meet you--it's\\ngreat you're using the Storage System.\\pIf you could, please visit me at home.\\nMy house is on ROUTE 114.$"}
text:FallarborTown_PokemonCenter_1F.FossilManiacEdgeOfTown	{'body': 'I wonder what POKéMON looked like\\nlong, long ago?\\pMaybe the FOSSIL MANIAC at the edge\\nof town will know.$'}
text:FallarborTown_PokemonCenter_1F.PlantHardyTrees	{'body': 'In the fields of FALLARBOR, we plant\\nseedlings of hardy trees that thrive\\leven in volcanic ash.$'}
text:FarawayIsland_Interior.TheFeelingOfBeingWatchedFaded	{'body': 'The feeling of being watched faded…$'}
text:FiveIsland_IslandSign	{'body': 'FIVE ISLAND\\nChrono Island: Where Time Goes$'}
text:FiveIsland_WeirdBuildingInMeadow	{'body': "Oh, this stinks. I wanted to play in\\nthe MEADOW.\\pBut they put up a weird building\\non it, so I can't play there.$"}
text:FiveIsland_BeenGettingBusierAroundHere	{'body': "It's been getting busier around\\nthese parts lately.\\pI haven't been catching many good\\nfish lately, either.$"}
text:FiveIsland_House1_HusbandWentOffFishing	{'body': "Don't worry about buying anything\\nfor dinner tonight!\\p…That's what my husband said when\\nhe went off fishing today.\\pI'm not sure if I can count on him\\nto live up to that promise.$"}
text:FiveIsland_House2_MeadowBelongedToFamily	{'body': 'That MEADOW has belonged to our\\nfamily for generations.\\pI should have had a giant mansion\\nbuilt on it.\\pIt would be preferable to having\\nthose thugs run wild on it!$'}
text:FiveIsland_LostCave_Room10_SelphyIntro	{'body': 'W-what do you intend to do with\\nme?$'}
text:FiveIsland_LostCave_Room10_SelphyDefeat	{'body': 'Oh… I was afraid that you meant to\\nharm me.$'}
text:FiveIsland_LostCave_Room10_MayIAskYouToTakeMeHome	{'body': 'I am so glad that you happened\\nhere.\\pI grew rather bored of walking,\\nand I am feeling fatigued.\\pMay I ask you to take me home\\nfrom here?$'}
text:FiveIsland_LostCave_Room1_LawsonIntro	{'body': "Aiyeeeeeh!\\pI thought this was an ancient ruin.\\nBut it's teeming with ghosts!$"}
text:FiveIsland_LostCave_Room1_LawsonDefeat	{'body': 'Aiyeeeeeh!\\nMercy!$'}
text:FiveIsland_LostCave_Room1_LawsonPostBattle	{'body': "I'm trying to get out of here, but\\nI always end up at the same spot.\\pMaybe the number of boulders is\\na hint…$"}
text:FiveIsland_LostCave_Room4_LauraIntro	{'body': 'I think there is a mysterious power\\nat work in this cave.$'}
text:FiveIsland_LostCave_Room4_LauraDefeat	{'body': "If you don't go into the right\\ntunnel, you won't get ahead.$"}
text:FiveIsland_LostCave_Room4_LauraPostBattle	{'body': 'Earlier, a lady went into the caves\\nahead.$'}
text:FiveIsland_Meadow_DoorNeedsTwoPasswords	{'body': 'とびらを\u3000あけるには\\nパスワードが\u30002つ\u3000いるようだ$'}
text:FiveIsland_Meadow_EnteredPasswordAnotherNeeded	{'body': '{PLAYER} entered a password.\\p“GOLDEEN need log.”\\p… …  … …  … …\\pAnother password is needed to\\nopen the door…$'}
text:FiveIsland_Meadow_EnteredPasswordDoorOpened	{'body': "{PLAYER} entered two passwords.\\p“GOLDEEN need log.”\\n“Yes, nah, CHANSEY.”\\p… …  … …  … …\\pThe WAREHOUSE's door opened!$"}
text:FiveIsland_Meadow_WarehouseDoorAlreadyOpen	{'body': "The WAREHOUSE's door is already\\nopen.$"}
text:FiveIsland_Meadow_Rocket1Intro	{'body': "This area's strictly off-limits!\\nOut, out!$"}
text:FiveIsland_Meadow_Rocket1Defeat	{'body': 'Is this for real?$'}
text:FiveIsland_Meadow_Rocket1PostBattle	{'body': "You don't have any business here!\\nGo home!$"}
text:FiveIsland_Meadow_Rocket2Intro	{'body': "There's nothing past here except\\nour WAREHOUSE.\\pSo what brings you here?$"}
text:FiveIsland_Meadow_Rocket2Defeat	{'body': "That wasn't supposed to happen…$"}
text:FiveIsland_Meadow_Rocket2PostBattle	{'body': "You're wanting to know what's inside\\nthis WAREHOUSE?\\pIt's better you didn't know.\\nFor your own sake, I mean.$"}
text:FiveIsland_Meadow_Rocket3Intro	{'body': "You'd be wasting time even if you\\nwere to get by me.$"}
text:FiveIsland_Meadow_Rocket3Defeat	{'body': 'Oh, that makes me furious!$'}
text:FiveIsland_Meadow_Rocket3PostBattle	{'body': "You won't be able to get in without\\nthe passwords anyway.$"}
text:FiveIsland_MemorialPillar_MiloIntro	{'body': "I'm the eldest of the BIRD\\nBROTHERS.\\pThe best thing about birds…\\nIt has to be the beak.$"}
text:FiveIsland_MemorialPillar_MiloDefeat	{'body': 'Oh, so sharp!$'}
text:FiveIsland_MemorialPillar_MiloPostBattle	{'body': 'You can fly to FOUR ISLAND from\\nhere.$'}
text:FiveIsland_MemorialPillar_ChazIntro	{'body': "I'm the middle kid of the BIRD\\nBROTHERS.\\pThe best thing about birds…\\nIt has to be the wings.$"}
text:FiveIsland_MemorialPillar_ChazDefeat	{'body': 'Flap, flap!$'}
text:FiveIsland_MemorialPillar_ChazPostBattle	{'body': 'There was a really somber guy\\nover that way.$'}
text:FiveIsland_MemorialPillar_HaroldIntro	{'body': "I'm the youngest of the BIRD\\nBROTHERS.\\pThe best thing about birds…\\nIt has to be the down.$"}
text:FiveIsland_MemorialPillar_HaroldDefeat	{'body': 'Down is so comfy…\\nIt makes me drowsy…$'}
text:FiveIsland_MemorialPillar_HaroldPostBattle	{'body': 'It fills me with happiness when\\nbird POKéMON beg playfully…$'}
text:FiveIsland_MemorialPillar_ScrubScrub	{'body': 'Scrub, scrub…$'}
text:FiveIsland_MemorialPillar_YourMonsLookHealthy	{'body': 'Hello…\\nYour POKéMON look healthy…$'}
text:FiveIsland_MemorialPillar_ThisIsWhereIBuriedMyOnix	{'body': 'This is where I buried my ONIX…\\nIt was named TECTONIX…$'}
text:FiveIsland_MemorialPillar_HereLiesTectonixLemonadeOffering	{'body': '“Here lies TECTONIX” is engraved\\non a boulder.\\pThere is a LEMONADE placed as an\\noffering in front of the grave.$'}
text:FiveIsland_MemorialPillar_LeaveAnotherLemonadeOffering	{'body': 'Would you like to leave another\\nLEMONADE as an offering?$'}
text:FiveIsland_MemorialPillar_PlacedCanOfLemonade	{'body': '{PLAYER} placed a can of LEMONADE\\nin front of the grave.$'}
text:FiveIsland_MemorialPillar_ThankYouPleaseTakeThis	{'body': "Th-thank you…\\pThat was my TECTONIX's favorite\\ndrink…\\pI don't even know you, but your\\nact of kindness…\\pIt's uplifted me a little.\\pCan you please take this as my\\nthanks?$"}
text:FiveIsland_MemorialPillar_BeGoodToYourMonsToo	{'body': 'Please be good to your POKéMON,\\ntoo.$'}
text:FiveIsland_MemorialPillar_DontHaveRoomForIt	{'body': "If you don't have room for it,\\nI'll hold it for you till next time.$"}
text:FiveIsland_MemorialPillar_StillHaveThingAsMyThanks	{'body': "Oh, it's you from that time…\\pI still have that thing I wanted\\nyou to have as my thanks.$"}
text:FiveIsland_MemorialPillar_ScrubScrubTectonix	{'body': 'Scrub, scrub…\\p… … …\\nTECTONIX…$'}
text:FiveIsland_MemorialPillar_HereLiesTectonix	{'body': 'Boulders and rocks are neatly piled\\nup as a cairn.\\p“Here lies TECTONIX” is engraved\\non a boulder.$'}
text:FiveIsland_PokemonCenter_1F_OnMyWayToPrepareMeal	{'body': "I'm on my way to prepare a meal\\nfor a certain high-society person.$"}
text:FiveIsland_PokemonCenter_1F_YoureOnQuestToCatchEveryMon	{'body': "You're on a quest to catch every\\nsingle kind of POKéMON?\\p…How incredible. Please tell me if\\nyou catch a strong one!$"}
text:FiveIsland_ResortGorgeous_DaisyIntro	{'body': 'With these hands, I will create\\nmy victory!$'}
text:FiveIsland_ResortGorgeous_DaisyDefeat	{'body': "The shame of this…\\nI'm red-faced…$"}
text:FiveIsland_ResortGorgeous_DaisyPostBattle	{'body': 'Uh-oh, my paint tubes have\\nscattered everywhere!$'}
text:FiveIsland_ResortGorgeous_CelinaIntro	{'body': "Excuse me!\\nI'm trying to paint.\\lPlease keep out of my sight!$"}
text:FiveIsland_ResortGorgeous_CelinaDefeat	{'body': "This loss…\\nI feel like I'm whiting out…$"}
text:FiveIsland_ResortGorgeous_CelinaPostBattle	{'body': "GILLIAN?\\nPlease tilt your head slightly…\\lThere! That's the look I want!$"}
text:FiveIsland_ResortGorgeous_RaynaIntro	{'body': 'Hmm…\\nThe angle, it is not quite there…$'}
text:FiveIsland_ResortGorgeous_RaynaDefeat	{'body': 'Oh…\\nMy feelings, they are blue…$'}
text:FiveIsland_ResortGorgeous_RaynaPostBattle	{'body': 'The sky and the sea…\\nThey are so fickle.\\pTheir changing expressions make\\nthem difficult to capture.$'}
text:FiveIsland_ResortGorgeous_JackiIntro	{'body': "I am visiting my friend's retreat,\\nif you must know.$"}
text:FiveIsland_ResortGorgeous_JackiDefeat	{'body': 'Oh, my, so strong.$'}
text:FiveIsland_ResortGorgeous_JackiPostBattle	{'body': 'I find it pleasurable to leisurely\\nbattle in the gentle sea breeze.$'}
text:FiveIsland_ResortGorgeous_GillianIntro	{'body': "I'm thinking of having a pool\\nmade specially for POKéMON.$"}
text:FiveIsland_ResortGorgeous_GillianDefeat	{'body': 'Oh, my goodness gracious!$'}
text:FiveIsland_ResortGorgeous_GillianPostBattle	{'body': 'A pool would be nice, but I must\\nsay, a sun-room may be sublime.$'}
text:FiveIsland_ResortGorgeous_DestinIntro	{'body': "I'm a good runner.\\nI'm really fast!$"}
text:FiveIsland_ResortGorgeous_DestinDefeat	{'body': 'Oops!\\nI rushed things!$'}
text:FiveIsland_ResortGorgeous_DestinPostBattle	{'body': 'When I run with the wind, it feels\\nlike I could fly!$'}
text:FiveIsland_ResortGorgeous_TobyIntro	{'body': 'I say, this marine life here at\\nthis resort agrees with me.$'}
text:FiveIsland_ResortGorgeous_TobyDefeat	{'body': "That's a shocker!\\nYou must be joking.$"}
text:FiveIsland_ResortGorgeous_TobyPostBattle	{'body': 'Getting so serious over this…\\nHow nonsensical.$'}
text:FiveIsland_ResortGorgeous_SelphyThanksYouMayGoNow	{'body': 'SELPHY: Thank you.\\pYou may go now.$'}
text:FiveIsland_ResortGorgeous_SelphysHouse	{'body': "SELPHY'S HOUSE$"}
text:FiveIsland_ResortGorgeous_House_PleaseHearMyWish	{'body': "SELPHY: Oh?\\nDo I know you from somewhere?\\pOh, but that doesn't matter.\\pI am exquisitely bored.\\nPlease, hear my wish.$"}
text:FiveIsland_ResortGorgeous_House_WishToSeeMonPlease	{'body': 'I wish to see a POKéMON.\\nA darling {STR_VAR_1}.\\pI want to see one right away.\\nPlease, make my wish come true.$'}
text:FiveIsland_ResortGorgeous_House_OhImTiredOfWaiting	{'body': "SELPHY: Oh, I'm tired of this.\\nI'm tired of waiting for you.\\pI'll forgive you this time, but\\nplease don't fail me next time.$"}
text:FiveIsland_ResortGorgeous_House_MonYouCaughtForMeThankYou	{'body': 'SELPHY: Oh, hello, there.\\pOh, my gracious. That must be the\\n{STR_VAR_1} you caught for me.\\pGiggle…\\nI see a resemblance to you.\\pThank you so kindly.\\p… …  … …  … …\\nIs something the matter?\\pYou may leave.\\p… …  … …  … …\\nOh, fine. I understand now.\\pSEBASTIAN!\\nI need you here this instant!$'}
text:FiveIsland_ResortGorgeous_House_ButlerYesMyLady	{'body': 'Butler: Yes, my lady.$'}
text:FiveIsland_ResortGorgeous_House_SelphyGiveTokenOfAppreciation	{'body': 'SELPHY: See to it that this person\\nis given a token of appreciation.$'}
text:FiveIsland_ResortGorgeous_House_ButlerIShallDoAsYouBid	{'body': 'Butler: I shall do as you bid,\\nmy lady.$'}
text:FiveIsland_ResortGorgeous_House_ButlerPleaseAcceptThisAsHerThanks	{'body': 'Butler: I sincerely thank you for\\npleasing Lady SELPHY.\\pPlease accept this as her thanks…$'}
text:FiveIsland_ResortGorgeous_House_ButlerBagAppearsToBeFull	{'body': 'Butler: Your BAG appears to be\\nunfortunately full.$'}
text:FiveIsland_ResortGorgeous_House_OhHowDisappointing	{'body': 'Oh…\\nHow disappointing.$'}
text:FiveIsland_ResortGorgeous_House_SelphyWishYouBestOfLuck	{'body': 'SELPHY: I wish you the best of\\nluck.$'}
text:FiveIsland_ResortGorgeous_House_LadySelphySmileHasBrillianceOfSun	{'body': 'Butler: The smile of Lady SELPHY\\nhas the brilliance of the sun.\\pPlease, I beg you to bring joy\\nto Lady SELPHY.$'}
text:FiveIsland_RocketWarehouse_ManyMonsLockedInPen	{'body': 'There are many POKéMON locked\\naway in the pen…$'}
text:FiveIsland_RocketWarehouse_PenUnlockedMonsFled	{'body': 'The pen door is unlocked.\\nThe POKéMON appear to have fled.$'}
text:FiveIsland_RocketWarehouse_Grunt2Intro	{'body': "Did you come here knowing it's\\nTEAM ROCKET's WAREHOUSE?$"}
text:FiveIsland_RocketWarehouse_Grunt2Defeat	{'body': "What do you think you're doing?!$"}
text:FiveIsland_RocketWarehouse_Grunt2PostBattle	{'body': 'TEAM ROCKET broke up?\\nWhat planet are you from?$'}
text:FiveIsland_RocketWarehouse_Grunt1Intro	{'body': "Oh, now your POKéMON look strong.\\nYou're willing to sell them?\\pOh?\\nYou wanted to battle?$"}
text:FiveIsland_RocketWarehouse_Grunt1Defeat	{'body': 'Oh, but…\\nToo much!$'}
text:FiveIsland_RocketWarehouse_Grunt1PostBattle	{'body': 'We can give you a great price.\\nSell us your POKéMON!$'}
text:FiveIsland_RocketWarehouse_Grunt3Intro	{'body': "I got word about you from the\\nothers.\\pBut there's no way a kid like you'd\\nknow our BOSS GIOVANNI!$"}
text:FiveIsland_RocketWarehouse_Grunt3Defeat	{'body': "Don't…you…dare…laugh…$"}
text:FiveIsland_RocketWarehouse_Grunt3PostBattle	{'body': "Don't mess in the doings of adults,\\nyou jumped-up pip-squeak!$"}
text:FiveIsland_RocketWarehouse_Admin1Intro	{'body': "I don't know or care if what I'm\\ndoing is right or wrong…\\pI just put my faith in GIOVANNI\\nand do as I am told.$"}
text:FiveIsland_RocketWarehouse_Admin1Defeat	{'body': "I…\\nI'm shattered…$"}
text:FiveIsland_RocketWarehouse_Admin1PostBattle	{'body': "You're doing things according to\\nyour beliefs and morals.\\pI understand now…$"}
text:FiveIsland_RocketWarehouse_MadeItSoYouCanComeBackThrough	{'body': "I've made it so you can come back\\nin through there.\\pWhy don't you go get rested and\\nrefreshed for what lies ahead?\\pThe ADMIN after me outranks me\\nthoroughly as a TRAINER.\\pYou'd better steel yourself for one\\nharsh challenge.$"}
text:FiveIsland_RocketWarehouse_Admin2Intro	{'body': "That's quite enough of you \\nplaying the hero, kid.\\pSpreading lies about how TEAM\\nROCKET has disbanded…\\pIt's such an obvious attempt to\\ncause confusion in our ranks.\\pFortunately, we're not so ignorant\\nto fall for the lies of a child!\\pAnd now, I'll show you how scary\\nan angry adult can be!$"}
text:FiveIsland_RocketWarehouse_Admin2Defeat	{'body': "Urgh…\\nYou were too strong…\\p…\\nTh-that's GIOVANNI's BADGE!\\pSo it's true?\\nTEAM ROCKET really has disbanded?$"}
text:FiveIsland_RocketWarehouse_Admin2PostBattle	{'body': "We will abandon this WAREHOUSE…\\pBut don't think this is over.\\nI won't let this be the end.\\pI will find GIOVANNI.\\nAnd I will resurrect TEAM ROCKET!\\lI will…\\pUntil then, farewell!$"}
text:FiveIsland_RocketWarehouse_ReportWithGraphsAndText	{'body': "A report with graphs and text is on\\nthe PC monitor.\\p“The Influence of Magnetic Waves\\non POKéMON Evolution”…\\p… … … … … …\\pIt's too difficult to understand…$"}
text:FiveIsland_RocketWarehouse_GideonIntro	{'body': "I almost managed to sell the\\nSAPPHIRE for huge money…\\pThen, you just had to come along\\nand blow the whole deal apart!\\pFufu… Fufufufu…\\nThere's no forgiveness for you!$"}
text:FiveIsland_RocketWarehouse_GideonDefeat	{'body': 'Gah! Darn!\\nDarn! Darn!$'}
text:FiveIsland_RocketWarehouse_GideonPostBattle	{'body': "If I can't sell it, it's worthless!\\nGo ahead, take it!$"}
text:FiveIsland_RocketWarehouse_GetLostLeaveMeBe	{'body': 'What do you want now?\\nGo on, get lost, leave me be.$'}
text:FiveIsland_RocketWarehouse_GiovannisKidHasRedHair	{'body': "What, you again?\\pYou… You're not GIOVANNI's kid,\\nare you?\\pNo, that can't be right!\\nGIOVANNI's kid has red hair.\\pYou don't have any reasons for\\nbugging me. Leave me alone!$"}
text:FiveIsland_WaterLabyrinth_LetMeTakeLookAtMons	{'body': "You travel all over the place,\\ndon't you?\\pYou're not driving your POKéMON\\ntoo harshly, are you?\\pLet me take a look.\\n… … …   … … …$"}
text:FiveIsland_WaterLabyrinth_HmmISeeIsee	{'body': 'Ah, hmm…\\nI see, I see…$'}
text:FiveIsland_WaterLabyrinth_TreatMonRightHaveThis	{'body': "Oh, impressive.\\nYou treat your POKéMON right.\\pI think you can be entrusted with\\nthis.\\pPlease, I'd like you to have this.$"}
text:FiveIsland_WaterLabyrinth_ReceivedEggFromMan	{'body': '{PLAYER} received an EGG\\nfrom the man!$'}
text:FiveIsland_WaterLabyrinth_DontHaveSpaceInYourParty	{'body': "…Unfortunately, you don't have\\nspace for this in your party.\\pYou'd better come back for it\\nanother time.$"}
text:FiveIsland_WaterLabyrinth_YouveComeBackForTheEgg	{'body': 'やあ\\nタマゴを\u3000もらいに\\lきて\u3000くれたんだね$'}
text:FiveIsland_WaterLabyrinth_GladIMetSomeoneLikeYou	{'body': "I received that EGG while I was\\ntraveling.\\pI'm glad I met someone like you.$"}
text:FiveIsland_WaterLabyrinth_CuteMonRemindsMeOfDaisy	{'body': "Oh, hello.\\nThat's a cute {STR_VAR_2}.\\pSeeing it reminds me of a sweet \\nlittle girl I met while traveling.\\pShe was gently grooming POKéMON…\\nShe was a little angel.\\pThat little girl's name…\\nI think it was DAISY.$"}
text:FiveIsland_WaterLabyrinth_AlizeIntro	{'body': 'This is an excellent environment\\nfor raising POKéMON.$'}
text:FiveIsland_WaterLabyrinth_AlizeDefeat	{'body': 'Your POKéMON are growing up\\nadmirably well!$'}
text:FiveIsland_WaterLabyrinth_AlizePostBattle	{'body': 'You know, I think you have the\\ntalent to be a good BREEDER.$'}
text:FortreeCity.SawGiganticPokemonInSky	{'body': 'No one believes me, but I saw this\\ngigantic POKéMON in the sky.\\pIt seemed to squirm as it flew toward\\nROUTE 131.\\pBy the way… Sniff…\\nUm… You, uh…smell singed.\\pWere you at a volcano or something?$'}
text:FortreeCity.SomethingBlockingGym	{'body': "I want to go to the POKéMON GYM,\\nbut something's blocking the way.\\pAfter all the bother I went\\nthrough training on ROUTE 120…\\pSTEVEN is on the bridge east of\\ntown. He was studying something\\linvisible.\\pMaybe he can help us clear the\\nGYM path!$"}
text:FortreeCity.ThisTimeIllBeatWinona	{'body': "I've got my pride-and-joy POKéMON\\nwith me. This time, I'll beat WINONA.$"}
text:FortreeCity.TreesGrowByDrinkingRainwater	{'body': "The ground absorbs rainwater, and\\ntrees grow by drinking that water…\\pOur FORTREE CITY exists because\\nthere's both water and soil.$"}
text:FortreeCity.EveryoneHealthyAndLively	{'body': "The CITY consists of homes built on\\ntrees.\\pPerhaps because of that lifestyle,\\neveryone is healthy and lively.\\pWhy, even myself--I feel as if I've\\ngrown thirty years younger.$"}
text:FortreeCity.BugPokemonComeThroughWindow	{'body': 'Living on top of trees is okay.\\pBut sometimes BUG POKéMON come in\\nthrough windows.\\lIt can be really startling.$'}
text:FortreeCity.PokemonThatEvolveWhenTraded	{'body': 'Some POKéMON evolve when you\\ntrade them.\\pA LINKING CORD lets you evolve\\nthose partners yourself, too. Ask\\la CENTER vendor about evolution\\litems!$'}
text:FortreeCity.SomethingUnseeable	{'body': 'Something unseeable is in the way.$'}
text:FortreeCity.UnseeableUseDevonScope	{'body': 'Something unseeable is in the way.\\pWant to use the DEVON SCOPE?$'}
text:FortreeCity.UsedDevonScopePokemonFled	{'body': '{PLAYER} used the DEVON SCOPE.\\pAn invisible POKéMON became completely\\nvisible!\\pThe startled POKéMON fled!$'}
text:FortreeCity.CitySign	{'body': 'FORTREE CITY\\n“The treetop city that frolics with\\lnature.”$'}
text:FortreeCity.GymSign	{'body': 'FORTREE CITY POKéMON GYM\\nLEADER: WINONA\\p“The bird user taking flight into\\nthe world.”$'}
text:FortreeCity_DecorationShop.MerchandiseSentToPC	{'body': "Merchandise you buy here is sent to\\nyour own PC.\\pThat's fantastic! I wish they could\\nalso deliver me home like that.$"}
text:FortreeCity_DecorationShop.BuyingDeskForDolls	{'body': "I'm buying a pretty desk and I'm\\nputting my cute DOLLS on it.\\pIf I don't, when I decorate my\\nSECRET BASE, my DOLLS will get\\ldirty or poked with splinters.$"}
text:FortreeCity_Gym.GymGuideAdvice	{'body': "Yo, how's it going, CHAMPION-\\nbound {PLAYER}?\\pFORTREE GYM LEADER WINONA is\\na master of FLYING-type POKéMON.\\pShe's waiting at the back of this GYM,\\nbehind the rotating doors.\\pShe's waiting for new challengers\\nwho are trying to take wing!\\pOkay, go for it!$"}
text:FortreeCity_Gym.GymGuidePostVictory	{'body': "You did it!\\nYou've achieved liftoff!$"}
text:FortreeCity_Gym.JaredIntro	{'body': "SWOOBAT's SIMPLE doubles every CALM\\nMIND. NOCTOWL keeps the pressure on.\\pWhich one will you stop first?$"}
text:FortreeCity_Gym.JaredDefeat	{'body': "We couldn't hold the sky…$"}
text:FortreeCity_Gym.JaredPostBattle	{'body': "TAUNT can stop CALM MIND. But don't\\nforget the attacker beside SWOOBAT.$"}
text:FortreeCity_Gym.EdwardoIntro	{'body': 'JUMPLUFF puts you to sleep, and\\nHONCHKROW grows with every fall.\\pGive it nothing to feed on!$'}
text:FortreeCity_Gym.EdwardoDefeat	{'body': 'We lost our lift…$'}
text:FortreeCity_Gym.EdwardoPostBattle	{'body': 'TAILWIND lasts four turns. Stall the\\nwind, then punish what it carried.$'}
text:FortreeCity_Gym.FlintIntro	{'body': "MULTISCALE DRAGONITE, SPEED BOOST\\nYANMEGA, and dragons in reserve.\\pWINONA needn't see you if I win here!$"}
text:FortreeCity_Gym.FlintDefeat	{'body': 'WINONA, I… The wind broke!$'}
text:FortreeCity_Gym.FlintPostBattle	{'body': 'Speed stacked on speed still dies to\\npriority. EXTREME SPEED is coming.$'}
text:FortreeCity_Gym.AshleyIntro	{'body': "PIDGEOT's HURRICANE never misses\\nunder NO GUARD. PELIPPER brings\\lthe rain.\\pPosition, then power!$"}
text:FortreeCity_Gym.AshleyDefeat	{'body': "Even our sky wasn't enough!$"}
text:FortreeCity_Gym.AshleyPostBattle	{'body': 'Changing the rain slows MANTINE.\\nBut NO GUARD works in any weather.$'}
text:FortreeCity_Gym.HumbertoIntro	{'body': 'GLISCOR heals through its own poison,\\nand CORVIKNIGHT returns what you send.\\pLower our stats. I dare you!$'}
text:FortreeCity_Gym.HumbertoDefeat	{'body': 'Even steel wings can buckle…$'}
text:FortreeCity_Gym.HumbertoPostBattle	{'body': 'Special attacks test our defenses.\\nICE is especially hard on GLISCOR.$'}
text:FortreeCity_Gym.DariusIntro	{'body': 'TORNADUS gives TAILWIND priority.\\nBRAVIARY rides the gust behind it.\\pFour turns. Outlast them!$'}
text:FortreeCity_Gym.DariusDefeat	{'body': 'Our wind has run its course.$'}
text:FortreeCity_Gym.DariusPostBattle	{'body': 'A rival TAILWIND can contest mine.\\nTRICK ROOM can turn speed against us.$'}
text:FortreeCity_Gym.WinonaIntro	{'body': "I am WINONA, FORTREE's GYM\\nLEADER.\\pMy POKéMON and I have flown\\nthrough clear skies and sudden\\lstorms. We know how quickly the\\lwind can turn.\\pShow me how your team meets a\\nchanging sky!$"}
text:FortreeCity_Gym.WinonaDefeat	{'body': "You've carried your team through\\nour strongest winds. The FEATHER\\lBADGE is yours.$"}
text:FortreeCity_Gym.ReceivedFeatherBadge	{'body': '{PLAYER} received the FEATHER BADGE\\nfrom WINONA.$'}
text:FortreeCity_Gym.ExplainFeatherBadgeTakeThis	{'body': 'The FEATHER BADGE lets your LEVELER\\ntrain a party up to Lv. 60.\\pIt also enables FLY outside of battle.\\nYour FLIGHT BEACON works from now on.\\lUse it from the BAG to revisit towns.\\pAnd this…\\nThis is a gift from me.$'}
text:FortreeCity_Gym.ExplainAltarianite	{'body': 'Altarianite lets Altaria Mega Evolve.\\nLet it hold the stone in battle.$'}
text:FortreeCity_Gym.PyreHandoff	{'body': 'AQUA has been seen near MT. PYRE.\\nFollow ROUTES 120 and 121 east,\\lthen SURF south on ROUTE 122 to\\lfind it.\\pDiscover what they are disturbing\\nthere. The skies over HOENN are\\lunsettled.$'}
text:FortreeCity_Gym.RegisteredWinona	{'body': 'Registered GYM LEADER WINONA\\nin the POKéNAV.$'}
text:FortreeCity_Gym.WinonaPostBattle	{'body': 'WINONA: A strong wind can carry\\nyou far, but you must choose\\lwhere to go.\\pTo follow AQUA to MT. PYRE, head\\neast through ROUTES 120 and 121,\\lthen SURF south on ROUTE 122.\\pI hope the people there are safe.$'}
text:FortreeCity_Gym.GymStatue	{'body': 'FORTREE CITY POKéMON GYM$'}
text:FortreeCity_Gym.GymStatueCertified	{'body': "FORTREE CITY POKéMON GYM\\pWINONA'S CERTIFIED TRAINERS:\\n{PLAYER}$"}
text:FortreeCity_Gym.WinonaPreRematch	{'body': "WINONA: We humans can never escape\\ngravity's pull on the ground.\\pBut by striving for excellence,\\nwe have the power to soar!\\pYou have scaled the pinnacle as\\nthe reigning CHAMPION.\\pPlease, allow me to see your power\\nat full flight!$"}
text:FortreeCity_Gym.WinonaRematchDefeat	{'body': 'I failed to reach your height again…$'}
text:FortreeCity_Gym.WinonaPostRematch	{'body': 'WINONA: Even though I have lost,\\nthe wings of my heart remain unbroken.\\pI can rise and soar again and\\nyet again.\\pI am convinced of it!$'}
text:FortreeCity_Gym.WinonaRematchNeedTwoMons	{'body': "WINONA: We humans can never escape\\ngravity's pull on the ground.\\pBut by striving for excellence,\\nwe have the power to soar!\\pYou have scaled the pinnacle as\\nthe reigning CHAMPION.\\pPlease, allow me to see your power\\nat full flight!\\pOh, no… Do you have but one\\nPOKéMON with you?\\pPlease return with two POKéMON\\nat the very least.$"}
text:FortreeCity_Gym.WinonaAfterPyre	{'body': 'WINONA: A strong wind can carry\\nyou far, but you must choose\\lwhere to go.\\pMay your journey bring you clear\\nskies.$'}
text:FortreeCity_House1.YouWillTradeWontYou	{'body': "Wrooooaaar! I need it!\\nI have to get me a {STR_VAR_1}!\\lI'll do anything for it!\\p…Uh… Did you hear that?\\nMy shout from the bottom of my heart?\\pHaving heard that, you will trade\\nyour {STR_VAR_1} for my {STR_VAR_2},\\lwon't you?$"}
text:FortreeCity_House1.MonYouTakeCare	{'body': 'Oh, yeah, right on!\\p{STR_VAR_1}, welcome!\\n{STR_VAR_2}, you take care!$'}
text:FortreeCity_House1.ThisIsntAMon	{'body': "Uh, no, I don't think so.\\nThat isn't a {STR_VAR_1}.$"}
text:FortreeCity_House1.YouWontTradeMe	{'body': "No? You won't trade me?\\nEven after I bared my heart to you?$"}
text:FortreeCity_House1.GoingToMakeVolbeatStrong	{'body': "I'm going to make VOLBEAT super\\nstrong from this moment on!\\pBOMBIRDIER already knows its role.\\nJust give it a partner to cover!$"}
text:FortreeCity_House1.TradingMemoriesWithOthers	{'body': "Trading POKéMON with others…\\pIt's as if you're trading your own\\nmemories with other people.$"}
text:FortreeCity_House1.Zigzagoon	{'body': 'ZIGZAGOON: Gumomoh?$'}
text:FortreeCity_House1.MegaGift_MILOTICITE_Text	{'body': 'People admire a Milotic, but few\\nremember the patient work of raising it.\\pTake this stone if you find one.\\nBeauty deserves a little adventure.$'}
text:FortreeCity_House2.HiddenPowersArousedByNature	{'body': 'People… POKéMON…\\pTheir hidden powers are aroused by\\nliving in natural environments…$'}
text:FortreeCity_House2.CoinInWhichHand	{'body': 'Let this old woman see if your hidden\\npower has awoken…\\pI hold a coin in my hand.\\pNow, tell me, have I palmed it in\\nthe right hand? Or in the left?$'}
text:FortreeCity_House2.CorrectTryAgainWhichHand	{'body': 'Oh! Yes, correct!\\pWe shall try again.\\pIn which hand have I palmed the coin?\\nThe right or left?$'}
text:FortreeCity_House2.CorrectTryAgainWhichHand2	{'body': 'Oh! Yes, correct!\\pWe shall try again.\\pIn which hand have I palmed the coin?\\nThe right or left?$'}
text:FortreeCity_House2.YourHiddenPowerHasAwoken	{'body': 'Your insight has awoken!\\pTake this Dubious Disc for Porygon2.$'}
text:FortreeCity_House2.ExplainDubiousDisc	{'body': 'A DUBIOUS DISC evolves PORYGON2.\\nUse it from the Bag when ready.$'}
text:FortreeCity_House2.YouGuessedWrong	{'body': 'No, too bad.\\nYou guessed wrong.$'}
text:FortreeCity_House3.MetStevenHadAmazingPokemon	{'body': "While speaking about POKéDEXES,\\nI remembered something.\\pI met this TRAINER, STEVEN, when\\nI was searching for rare stones.\\pHoo, boy, he had some amazing POKéMON\\nwith him.\\pThey weren't just rare, they were\\ntrained to terrifying extremes!\\pHe might even be stronger than the\\nGYM LEADER in this town…$"}
text:FortreeCity_House3.OhYouHavePokedex	{'body': "What's that thing you have there?\\p… … … … … …\\pOh, it's called a POKéDEX?\\nIt's really awesome!$"}
text:FortreeCity_House4.BringsWorldCloserTogether	{'body': "By being together with POKéMON,\\npeople make more and more friends.\\pAnd that brings the world closer\\ntogether. I think it's wonderful!$"}
text:FortreeCity_House4.GoBirdPokemon	{'body': 'There!\\nTake this to my friend in\\nMOSSDEEP, WINGULL!$'}
text:FortreeCity_House4.AskedWingullToRunErrand	{'body': 'My WINGULL is delivering MAIL\\nto a friend in MOSSDEEP.\\pIf you meet it there, say hello!\\nIt may be ready to fly home.$'}
text:FortreeCity_House4.WelcomeWingullTakeSachet	{'body': 'Welcome back, Wingull! And thank you.\\pPlease take this Sachet as my thanks.$'}
text:FortreeCity_House4.FriendsFarAwayThanksToWingull	{'body': 'Thanks to my WINGULL, I have friends\\nwho live far away.$'}
text:FortreeCity_House4.Wingull	{'body': 'WINGULL: Pihyoh!$'}
text:FortreeCity_House5.TreeHousesAreGreat	{'body': "The tree houses of FORTREE are great!\\pI think it's the number one town for\\nliving together with POKéMON.$"}
text:FortreeCity_House5.AdaptedToNature	{'body': "POKéMON and people have adapted to\\nnature for survival.\\pThere's no need to make nature\\nconform to the way we want to live.$"}
text:FortreeCity_House5.Zigzagoon	{'body': 'ZIGZAGOON: Bufuu!$'}
text:FortreeCity_House5.MegaGift_CHIMECHITE_Text	{'body': 'Listen to the chimes in the trees.\\nNo two breezes sound quite alike.\\pI kept this for a Chimecho.\\nPerhaps yours will give it a voice.$'}
text:FortreeCity_Mart.SpenserChallenge	{'body': "I am SPENSER of the BATTLE PALACE.\\pA Pokémon's instincts reveal its\\nTrainer's trust. Let me see yours!$"}
text:FortreeCity_Mart.SpenserDefeat	{'body': 'Gwahaha! Your trust held firm!$'}
text:FortreeCity_Mart.SpenserAfter	{'body': 'Use that PROTECTOR to raise a new\\npartner. We will meet at the FRONTIER.$'}
text:FortreeCity_Mart.SuperRepelBetter	{'body': "SUPER REPEL lasts a long time,\\nand it gets the job done.\\pIt's much better than an ordinary\\nREPEL.$"}
text:FortreeCity_Mart.StockUpOnItems	{'body': "I always stock up on more items than\\nI'm sure I'll need.\\pYou never know what might happen.\\nBetter to be safe than sorry!$"}
text:FortreeCity_Mart.RareCandyMakesMonGrow	{'body': 'The LEVELER raises your whole party to\\nthe current level limit at once.\\pUse it again after each GYM BADGE\\nraises that limit.$'}
text:FortreeCity_PokemonCenter_1F.GoToSafariZone	{'body': "Listen, kid, are you working\\non a POKéDEX?\\pHmm… Go to the SAFARI ZONE.\\nThat's my suggestion.$"}
text:FortreeCity_PokemonCenter_1F.RecordCornerIsNeat	{'body': "Have you done anything at\\nthe RECORD CORNER?\\pIt's pretty neat. It mixes and matches\\nthe records of TRAINERS.\\pI don't know quite how it works,\\nbut it's cool. It's exciting, even!$"}
text:FortreeCity_PokemonCenter_1F.DoYouKnowAboutPokenav	{'body': "Oh, wow, you have a POKéNAV!\\nAnd it's just like mine!\\pDo you know about POKéNAV's\\nMATCH CALL system?\\pAccess it, and you can chat with\\nregistered TRAINERS anytime.\\pIt also lets TRAINERS share news\\nand training notes with you.\\pIt's really nifty! Those DEVON guys\\nsure know what they're doing!$"}
text:FourIsland_IslandSign	{'body': 'FOUR ISLAND\\nThe Warm, Blue, Floe Island$'}
text:FourIsland_LoreleiHasReturned	{'body': 'LORELEI has returned.\\pDid she find the city life too\\nstressful, I wonder?$'}
text:FourIsland_LoreleiMetLaprasAsChild	{'body': 'LORELEI has gone back.\\pThe LAPRAS she has, I imagine it\\nto be the one she met as a child.\\pI believe it was in ICEFALL CAVE\\nthat she caught it.\\pPerhaps that POKéMON has been with\\nher ever since.$'}
text:FourIsland_RivalAlreadyGotEggBeSmellingYa	{'body': "{RIVAL}: Hey!\\n{PLAYER}!\\pWhat are you doing here in the\\nSEVII ISLANDS?\\pYou should quit copying me,\\nyou know?\\pAnyways, I already got my POKéMON\\nEGG, so I'm done with this island.\\pHeh, I bet you don't even know\\nabout POKéMON EGGS.\\pYou'll never fill your NATIONAL\\nPOKéDEX that way.\\pBy the way, I saw someone we both\\nknow on this island.\\pWhy don't you go look around if\\nit makes you curious?\\pMe, I don't have the time to\\nwaste.\\pBe smelling ya!$"}
text:FourIsland_LoreleiHasLotsOfStuffedDolls	{'body': "Oh, you found me!\\nPlease don't tell LORELEI.\\pDid you know that LORELEI has lots\\nand lots of stuffed dolls?\\pEvery time she comes back to\\nFOUR ISLAND, her collection grows!$"}
text:FourIsland_MadeSlushieUsingIcefallCaveIce	{'body': "Ooh, chilly!\\pI made a slushie using ice I\\nshaved inside ICEFALL CAVE.\\pIt's chilly and tasty!$"}
text:FourIsland_LoreleisHouse	{'body': "LORELEI'S HOUSE$"}
text:FourIsland_House1_YoureAwfullyHeavy	{'body': "There! Boing!\\nYou're awfully heavy!$"}
text:FourIsland_IcefallCave_Back_LoreleiKeepHandsOffMons	{'body': "LORELEI: Keep your filthy hands\\noff the POKéMON in the cave!\\pDo as I say, or you'll have me to\\nanswer to!$"}
text:FourIsland_IcefallCave_Back_ShutItLadyLeaveUsBe	{'body': "Aww, shut it, lady, and leave\\nus be.\\pDon't let your glasses get all\\nsteamed up!$"}
text:FourIsland_IcefallCave_Back_LoreleiPlayerHelpMeKickPoachersOut	{'body': "LORELEI: {PLAYER}?!\\nWhat are you doing here?\\pNo, we can catch up later.\\nRight now, I need your help.\\pHelp me kick these poachers out\\nbefore they do anything else.\\pThey've been catching POKéMON\\nhere, then selling them off!\\pAre you ready?\\nYou take that one, please!$"}
text:FourIsland_IcefallCave_Back_GruntIntro	{'body': "W-what?!\\pWho says we can't do what we want\\nwith the POKéMON we catch?$"}
text:FourIsland_IcefallCave_Back_GruntDefeat	{'body': "We didn't plan on this!$"}
text:FourIsland_IcefallCave_Back_LoreleiWhereHaveYouTakenMons	{'body': "LORELEI: Humph.\\nSo despicably weak.\\pYou!\\nTell me!\\pWhere have you taken the captured\\nPOKéMON?\\pI'm smashing your ring once and\\nfor all!$"}
text:FourIsland_IcefallCave_Back_NotTellingYouThat	{'body': "N-no way!\\nI'm not telling you that!$"}
text:FourIsland_IcefallCave_Back_LoreleiWellDeepFreezeYou	{'body': "LORELEI: If you won't confess,\\nwe'll deep-freeze you.\\pMy LAPRAS is furious for what\\nyou've done to its friends.\\pGo, LAPRAS!\\nICE BEAM…$"}
text:FourIsland_IcefallCave_Back_OkayRocketWareHouseFiveIsland	{'body': "Wawaah! Okay!\\nI'll talk!\\pThe POKéMON are in the ROCKET\\nWAREHOUSE on FIVE ISLAND.\\pThere! I said it!\\nWe'll be going now!\\p…But I doubt you'll ever make it\\ninto the ROCKET WAREHOUSE!\\pHeheheheh!$"}
text:FourIsland_IcefallCave_Back_ThankYouThisIsAwful	{'body': '{PLAYER}, thank you.\\nBut this is awful…\\pI was born and raised here on\\nthese islands.\\pI had no idea that those horrible\\ncriminals were loose here…$'}
text:FourIsland_LoreleisHouse_IfAnythingWereToHappenToIsland	{'body': "LORELEI: There's something weighing\\nheavily on my mind.\\pIf anything were to happen on\\nthe island where I was born…\\pI wouldn't know about it if I were\\nin the POKéMON LEAGUE.\\pI wonder if that would make me\\nirresponsible to my home…$"}
text:FourIsland_LoreleisHouse_IllReturnToLeagueInShortWhile	{'body': "LORELEI: So, you managed to solve\\nall the problems here?\\pThat's wonderful.\\pThat means there isn't any reason\\nfor me to be here all the time.\\pThank you…\\pI'll return to the POKéMON LEAGUE\\nin a short while.$"}
text:FourIsland_LoreleisHouse_WillDoWhatICanHereAndNow	{'body': "I don't know what will happen in\\nthe future, but…\\pI will do what I can here and now.\\nThat's all I can do.$"}
text:FourIsland_LoreleisHouse_StuffedMonDollsGalore	{'body': 'Stuffed POKéMON dolls galore!$'}
text:FourIsland_Mart_LoreleiGrewUpOnThisIsland	{'body': "We've had a great and powerful\\nTRAINER grow up on this island.\\pI bet even you'd know her.\\nIt's LORELEI of the ELITE FOUR!\\pWhen LORELEI was just a tyke,\\nI taught her about POKéMON.$"}
text:FourIsland_Mart_IcefallCaveIsFrigid	{'body': 'The SEVII ISLANDS are in a warm\\nregion overall.\\pBut there is one exception you\\nneed to know about.\\pThe ICEFALL CAVE is frigid because\\nof the POKéMON that live in it.$'}
text:BodySlamTeach	{'body': "Ready?\\nBoing!\\pWe're having a BODY SLAM match\\nto see who wimps out first.\\pIf you were to join us, you'd be\\nsquashed like a bug, though…\\pHow about I teach BODY SLAM to\\na POKéMON of yours instead?$"}
text:BodySlamDeclined	{'body': 'Come again!\\nBoing!$'}
text:BodySlamWhichMon	{'body': 'Which POKéMON wants to learn how\\nto BODY SLAM?$'}
text:BodySlamTaught	{'body': 'Boioing!$'}
text:FourIsland_House1_FatMan	{'body': 'それ\u3000ぼよーん！\\nおまえ\u3000おもいなあー！$'}
text:FourIsland_PokemonCenter_1F_RareIceMonsInCave	{'body': "There's a rare kind of ICE POKéMON\\nthat lives in the cave.\\pWe get a lot of visitors hoping to\\nsee that POKéMON.$"}
text:FourIsland_PokemonCenter_1F_DayCarePeopleFoundEggBefore	{'body': "Oh? A POKéMON EGG?\\n…I have no idea.\\p…Oh, wait. The DAY-CARE people\\nin town were saying something.\\pThey said that they'd found EGGS\\nbefore on their property.$"}
text:FourIsland_PokemonCenter_1F_NewPokemonJournalHasntArrived	{'body': "What's this?\\pThe new POKéMON JOURNAL hasn't\\narrived on this island?$"}
text:FuchsiaCity_DidYouTrySafariGame	{'body': 'Did you try the SAFARI GAME?\\pThere are some rare POKéMON that\\ncan only be caught there.$'}
text:FuchsiaCity_SafariZoneZooInFront	{'body': 'The SAFARI ZONE has a zoo in front\\nof the entrance.\\pOut back is the SAFARI GAME for\\ncatching POKéMON.$'}
text:FuchsiaCity_WheresSara	{'body': "ERIK: Where's SARA?\\nI said I'd meet her here.$"}
text:FuchsiaCity_ItemBallInThere	{'body': "That item ball in there…\\nWere you wanting that?\\pMe, too!\\n…Huh? That's a POKéMON?$"}
text:FuchsiaCity_CitySign	{'body': "FUCHSIA CITY\\nBehold! It's Passion Pink!$"}
text:FuchsiaCity_SafariZoneSign	{'body': 'POKéMON PARADISE\\nSAFARI ZONE$'}
text:FuchsiaCity_SafariGameSign	{'body': 'SAFARI GAME\\nPOKéMON-U-CATCH!$'}
text:FuchsiaCity_WardensHomeSign	{'body': "SAFARI ZONE\\nWARDEN'S HOME$"}
text:FuchsiaCity_SafariZoneOfficeSign	{'body': 'POKéMON PARADISE!\\nWelcome to the SAFARI ZONE!\\lSAFARI ZONE OFFICE$'}
text:FuchsiaCity_GymSign	{'body': 'FUCHSIA CITY POKéMON GYM\\nLEADER: KOGA\\lThe Poisonous Ninja Master$'}
text:FuchsiaCity_ChanseySign	{'body': 'Name: CHANSEY\\nCatching one is all up to chance.$'}
text:FuchsiaCity_VoltorbSign	{'body': 'Name: VOLTORB\\nThe very image of a POKé BALL.$'}
text:FuchsiaCity_KangaskhanSign	{'body': 'Name: KANGASKHAN\\pA maternal POKéMON that raises its\\nyoung in a pouch on its belly.$'}
text:FuchsiaCity_SlowpokeSign	{'body': 'Name: SLOWPOKE\\nFriendly and very slow moving.$'}
text:FuchsiaCity_LaprasSign	{'body': 'Name: LAPRAS\\nAKA the king of the seas.$'}
text:FuchsiaCity_OmanyteSign	{'body': 'Name: OMANYTE\\nAn extremely rare POKéMON that was\\lregenerated from a fossil.$'}
text:FuchsiaCity_KabutoSign	{'body': 'Name: KABUTO\\nAn extremely rare POKéMON that was\\lregenerated from a fossil.$'}
text:FuchsiaCity_Ellipsis	{'body': '……$'}
text:SubstituteTeach	{'body': "Aww, I wish I was a KANGASKHAN\\nbaby.\\pI'd love to be a substitute for the\\nbaby…\\pAnd snuggle in the mother\\nKANGASKHAN's belly pouch.\\pBut only POKéMON can use the\\ntechnique SUBSTITUTE…\\pWant me to teach SUBSTITUTE to\\none of your POKéMON?$"}
text:SubstituteDeclined	{'body': 'Oh, really?\\nSUBSTITUTE seems so fun…$'}
text:SubstituteWhichMon	{'body': 'Which POKéMON wants to learn\\nSUBSTITUTE?$'}
text:SubstituteTaught	{'body': "Boy, what I'd give to crawl inside\\na KANGASKHAN belly pouch…$"}
text:FuchsiaCity_MyFatherIsGymLeader	{'body': "My father is the GYM LEADER of\\nthis town.\\pI'm training to use POISON POKéMON\\nas well as my father.$"}
text:FuchsiaCity_Gym_KogaIntro	{'body': 'KOGA: Fwahahaha!\\pA mere child like you dares to\\nchallenge me?\\pThe very idea makes me shiver\\nwith mirth!\\pVery well, I shall show you true\\nterror as a ninja master.\\pPoison brings steady doom.\\nSleep renders foes helpless.\\pDespair to the creeping horror of\\nPOISON-type POKéMON!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$'}
text:FuchsiaCity_Gym_KogaDefeat	{'body': 'Humph!\\nYou have proven your worth!\\pHere!\\nTake the SOULBADGE!$'}
text:FuchsiaCity_Gym_KogaPostBattle	{'body': 'When afflicted by TOXIC, a POKéMON\\nsuffers more and more.\\pIt suffers worsening damage as the\\nbattle wears on!\\pIt will surely terrorize foes!$'}
text:FuchsiaCity_Gym_KogaExplainSoulBadge	{'body': 'Now that you have the SOULBADGE,\\nthe DEFENSE of your POKéMON rises.\\pIt also lets you SURF outside of\\nbattle.\\pAh!\\nTake this, too!$'}
text:FuchsiaCity_Gym_ReceivedTM06FromKoga	{'body': '{PLAYER} received TM06\\nfrom KOGA.$'}
text:FuchsiaCity_Gym_KogaExplainTM06	{'body': 'Sealed within that TM06 lies\\nTOXIC!\\pIt is a secret technique dating\\nback some four hundred years.$'}
text:FuchsiaCity_Gym_MakeSpaceForThis	{'body': 'Make space for this, child!$'}
text:FuchsiaCity_Gym_KaydenIntro	{'body': "Strength isn't the key for POKéMON.\\nDo you understand this?\\pPOKéMON is about strategy!\\pI'll show you how strategy can\\nbeat brute strength.$"}
text:FuchsiaCity_Gym_KaydenDefeat	{'body': 'What?\\nExtraordinary!$'}
text:FuchsiaCity_Gym_KaydenPostBattle	{'body': "So, you mix brawn with brains?\\nGood strategy!\\pThat's remarkable for a child\\nTRAINER.$"}
text:FuchsiaCity_Gym_KirkIntro	{'body': 'I was a magician once upon a time.\\pBut I dreamt of becoming a ninja,\\nso I joined this GYM.$'}
text:FuchsiaCity_Gym_KirkDefeat	{'body': "I'm done for!$"}
text:FuchsiaCity_Gym_KirkPostBattle	{'body': "Even though I've lost, I will keep\\ntraining according to the teachings\\lof KOGA, my ninja master.$"}
text:FuchsiaCity_Gym_NateIntro	{'body': "Let's see you beat my special\\ntechniques!$"}
text:FuchsiaCity_Gym_NateDefeat	{'body': 'You had me fooled!$'}
text:FuchsiaCity_Gym_NatePostBattle	{'body': 'I like poison and sleep techniques,\\nas they linger after battle!$'}
text:FuchsiaCity_Gym_PhilIntro	{'body': 'Stop right there!\\pThe famed invisible walls of\\nFUCHSIA GYM have you frustrated?$'}
text:FuchsiaCity_Gym_PhilDefeat	{'body': "Whoa!\\nYou've got it!$"}
text:FuchsiaCity_Gym_PhilPostBattle	{'body': "You impressed me!\\nHere's a hint!\\pLook very closely for gaps in the\\ninvisible walls!$"}
text:FuchsiaCity_Gym_EdgarIntro	{'body': 'I also study the way of the ninja\\nwith Master KOGA!\\pNinja have a long history of using\\nanimals!$'}
text:FuchsiaCity_Gym_EdgarDefeat	{'body': 'Awoo!$'}
text:FuchsiaCity_Gym_EdgarPostBattle	{'body': 'I still have much to learn.$'}
text:FuchsiaCity_Gym_ShawnIntro	{'body': 'Master KOGA comes from a long line\\nof ninjas.\\pWhat did you descend from?$'}
text:FuchsiaCity_Gym_ShawnDefeat	{'body': "You're more skilled than I'd\\nthought!$"}
text:FuchsiaCity_Gym_ShawnPostBattle	{'body': 'Where there is light, there is\\nshadow!\\pLight and shadow!\\nWhich do you choose?$'}
text:FuchsiaCity_Gym_GymGuyAdvice	{'body': "Yo!\\nChamp in the making!\\pFUCHSIA GYM is a tricked-up place.\\nIt's riddled with invisible walls!\\pKOGA might appear close, but he's\\nblocked off.\\pYou have to find gaps in the walls\\nto reach him.$"}
text:FuchsiaCity_Gym_GymGuyPostVictory	{'body': "It's amazing how ninja can terrify,\\neven now!$"}
text:FuchsiaCity_Gym_GymStatue	{'body': 'FUCHSIA POKéMON GYM\\nLEADER: KOGA\\pWINNING TRAINERS:\\n{RIVAL}$'}
text:FuchsiaCity_Gym_GymStatuePlayerWon	{'body': 'FUCHSIA POKéMON GYM\\nLEADER: KOGA\\pWINNING TRAINERS:\\n{RIVAL}, {PLAYER}$'}
text:FuchsiaCity_House1_WardenIsOldHasFalseTeeth	{'body': "The SAFARI ZONE's WARDEN is old, \\nbut he's still very much active.\\pAll his teeth are false, though.$"}
text:FuchsiaCity_House1_BillIsMyGrandson	{'body': "Hmm?\\nYou've met BILL?\\pHe's my grandson!\\pHe always liked collecting things,\\neven as a child!$"}
text:FuchsiaCity_House1_BillFilesHisOwnMonData	{'body': 'BILL files his own POKéMON data on\\nhis PC.\\pDid he show you?$'}
text:FuchsiaCity_House2_DoYouLikeToFish	{'body': "I'm the FISHING GURU's older\\nbrother.\\pI simply looove fishing!\\nI can't bear to go without.\\pTell me, do you like to fish?$"}
text:FuchsiaCity_House2_LikeYourStyleTakeThis	{'body': 'Grand! I like your style.\\nI think we can be friends.\\pTake this and fish, young friend!$'}
text:FuchsiaCity_House2_ReceivedGoodRod	{'body': "{PLAYER} received a GOOD ROD from\\nthe FISHING GURU's brother.$"}
text:FuchsiaCity_House2_GoodRodCanCatchBetterMons	{'body': 'Fishing is a way of life!\\nIt is like the finest poetry.\\pA crummy OLD ROD could only catch\\nMAGIKARP, yes?\\pBut with a GOOD ROD, you can\\ncatch much better POKéMON.$'}
text:FuchsiaCity_House2_OhThatsDisappointing	{'body': "Oh…\\nThat's so disappointing…$"}
text:FuchsiaCity_House2_HowAreTheFishBiting	{'body': 'Hello there, {PLAYER}!\\pHow are the fish biting?$'}
text:FuchsiaCity_House2_YouHaveNoRoomForGift	{'body': 'Oh, no!\\pI had a gift for you, but you have\\nno room for it!$'}
text:FuchsiaCity_House3_WouldYouLikeToForgetMove	{'body': "Uh…\\nOh, yes, I'm the MOVE DELETER.\\pI can make POKéMON forget their\\nmoves.\\pWould you like me to do that?$"}
text:FuchsiaCity_House3_WhichMonShouldForgetMove	{'body': 'Which POKéMON should forget a\\nmove?$'}
text:FuchsiaCity_House3_WhichMoveShouldBeForgotten	{'body': 'Which move should be forgotten?$'}
text:FuchsiaCity_House3_MonOnlyKnowsOneMove	{'body': '{STR_VAR_1} seems to know only one\\nmove…$'}
text:FuchsiaCity_House3_MonsMoveShouldBeForgotten	{'body': "Hm! {STR_VAR_1}'s {STR_VAR_2}?\\nThat move should be forgotten?$"}
text:FuchsiaCity_House3_MonHasForgottenMoveCompletely	{'body': 'It worked to perfection!\\p{STR_VAR_1} has forgotten\\n{STR_VAR_2} completely.$'}
text:FuchsiaCity_House3_ComeAgainToForgetOtherMoves	{'body': 'Come again if there are other\\nmoves to be forgotten.$'}
text:FuchsiaCity_House3_NoEggShouldKnowMoves	{'body': 'What?\\nNo EGG should know any moves.$'}
text:FuchsiaCity_Mart_DontTheyHaveSafariZonePennants	{'body': "Don't they have any pennants\\npromoting the SAFARI ZONE?\\pHow about some paper lanterns?\\nAren't there even any calendars?$"}
text:FuchsiaCity_Mart_DidYouTryXSpeed	{'body': 'Did you try X SPEED?\\nIt speeds up a POKéMON in battle.$'}
text:FuchsiaCity_PokemonCenter_1F_CantBecomeGoodTrainerWithOneMon	{'body': "You can't become a good TRAINER\\nwith just one strong POKéMON.\\pBut raising many POKéMON evenly\\nis no easy task, either.$"}
text:FuchsiaCity_PokemonCenter_1F_PokemonLeagueWestOfViridian	{'body': "There's a narrow trail west of\\nVIRIDIAN CITY.\\pIt goes to the POKéMON LEAGUE HQ.\\nThe HQ governs all TRAINERS.$"}
text:FuchsiaCity_PokemonCenter_1F_VisitSafariZoneForPokedex	{'body': "If you're working on a POKéDEX,\\nvisit the SAFARI ZONE.\\pAll sorts of rare POKéMON breed\\nthere.$"}
text:FuchsiaCity_SafariZone_Entrance_WelcomeToSafariZone	{'body': 'Welcome to the SAFARI ZONE!$'}
text:FuchsiaCity_SafariZone_Entrance_PlaySafariGameFor500	{'body': 'For just ¥500, you can play the\\nSAFARI GAME.\\pYou can roam the wide-open safari\\nand catch what you like.\\pWould you like to play?$'}
text:FuchsiaCity_SafariZone_Entrance_ThatllBe500WeOnlyUseSpecialBalls	{'body': "That'll be ¥500, please!\\pWe only use a special kind of \\nPOKé BALLS here.$"}
text:FuchsiaCity_SafariZone_Entrance_PlayerReceived30SafariBalls	{'body': '{PLAYER} received 30 SAFARI BALLS\\nfrom the attendant.$'}
text:FuchsiaCity_SafariZone_Entrance_CallYouOnPAWhenYouRunOut	{'body': "We'll call you on the PA when you\\nrun out of time or SAFARI BALLS.\\pWell, I'll wish you the best of\\nluck!$"}
text:FuchsiaCity_SafariZone_Entrance_OkayPleaseComeAgain	{'body': 'Okay.\\nPlease come again!$'}
text:FuchsiaCity_SafariZone_Entrance_OopsNotEnoughMoney	{'body': 'Oops!\\nNot enough money!$'}
text:FuchsiaCity_SafariZone_Entrance_GoingToLeaveSafariZoneEarly	{'body': 'Are you going to leave the\\nSAFARI ZONE early?$'}
text:FuchsiaCity_SafariZone_Entrance_PleaseReturnSafariBalls	{'body': 'Please return any SAFARI BALLS\\nyou may have left.$'}
text:FuchsiaCity_SafariZone_Entrance_GoodLuck	{'body': 'Good luck!$'}
text:FuchsiaCity_SafariZone_Entrance_CatchFairShareComeAgain	{'body': 'Did you catch your fair share?\\nCome again!$'}
text:FuchsiaCity_SafariZone_Entrance_FirstTimeAtSafariZone	{'body': 'Hi! Is it your first time here at\\nthe SAFARI ZONE?$'}
text:FuchsiaCity_SafariZone_Entrance_ExplainSafariZone	{'body': "The SAFARI ZONE actually has\\nfour zones in it.\\pEach zone has different kinds of\\nPOKéMON, even some rare ones.\\pUse the supplied SAFARI BALLS to\\ncatch them.\\pYou can also throw BAIT or ROCKS\\nbesides the SAFARI BALLS.\\pIf you throw BAIT, the POKéMON\\nbecomes less likely to flee, but\\lharder to catch.\\pIf you throw ROCKS, the POKéMON\\nbecomes more likely to flee, but\\leasier to catch.\\pWhen you run out of time or SAFARI\\nBALLS, it's game over for you!$"}
text:FuchsiaCity_SafariZone_Entrance_SorryYoureARegularHere	{'body': "Sorry, you're a regular here!$"}
text:FuchsiaCity_SafariZone_Office_NicknamedWardenSlowpoke	{'body': 'We nicknamed the WARDEN\\n“SLOWPOKE.”\\pYou know, he has that vacant look\\nlike a SLOWPOKE.$'}
text:FuchsiaCity_SafariZone_Office_WardenIsVeryKnowledgeable	{'body': 'WARDEN SLOWPOKE is very\\nknowledgeable about POKéMON.\\pHe even has some fossils of rare,\\nextinct POKéMON.$'}
text:FuchsiaCity_SafariZone_Office_CouldntUnderstandWarden	{'body': "WARDEN SLOWPOKE came in, but\\nI couldn't understand him.\\pI think he's got a speech problem!$"}
text:FuchsiaCity_SafariZone_Office_PrizeInSafariZone	{'body': "WARDEN SLOWPOKE is running a\\npromotion campaign right now.\\pTry to get to the farthest corner\\nof the SAFARI ZONE.\\pIf you can make it, you'll win a\\nvery convenient prize.$"}
text:FuchsiaCity_WardensHouse_HifFuffHefifoo	{'body': 'WARDEN: Hif fuff hefifoo!\\pHa lof ha feef ee hafahi ho.\\nHeff hee fwee!$'}
text:FuchsiaCity_WardensHouse_AhHowheeHoHoo	{'body': 'Ah howhee ho hoo!\\nEef ee hafahi ho!$'}
text:FuchsiaCity_WardensHouse_HeOhayHeHaHoo	{'body': 'Ha?\\nHe ohay heh ha hoo ee haheh!$'}
text:FuchsiaCity_WardensHouse_GaveGoldTeethToWarden	{'body': '{PLAYER} gave the GOLD TEETH\\nto the WARDEN.$'}
text:FuchsiaCity_WardensHouse_WardenPoppedInHisTeeth	{'body': 'The WARDEN popped in his teeth!$'}
text:FuchsiaCity_WardensHouse_ThanksSonGiveYouSomething	{'body': "WARDEN: Thanks, son!\\nYou're a real lifesaver!\\pNo one could understand a word\\nthat I said, not a one!\\pI was too ashamed to show my face\\naround the OFFICE, even.\\pLet me give you something for your\\ntrouble.$"}
text:FuchsiaCity_WardensHouse_ThanksLassieGiveYouSomething	{'body': "WARDEN: Thank you, lassie!\\nYou're a real lifesaver!\\pNo one could understand a word\\nthat I said, not a one!\\pI was too ashamed to show my face\\naround the OFFICE, even.\\pLet me give you something for your\\ntrouble.$"}
text:FuchsiaCity_WardensHouse_ReceivedHM04FromWarden	{'body': '{PLAYER} received HM04\\nfrom the WARDEN.$'}
text:FuchsiaCity_WardensHouse_ExplainStrength	{'body': "WARDEN: Inside HM04 you'll find\\nSTRENGTH.\\pIt lets POKéMON move boulders when\\nyou're outside of battle.\\pOh yes, did you find the SECRET\\nHOUSE in the SAFARI ZONE?$"}
text:FuchsiaCity_WardensHouse_YouHaveTooMuchStuff	{'body': 'なんや\u3000にもつ\\nいっぱいやんけ！$'}
text:FuchsiaCity_WardensHouse_MonPhotosFossilsOnDisplay	{'body': 'POKéMON photos and fossils are on\\ndisplay.$'}
text:FuchsiaCity_WardensHouse_OldMonMerchandiseOnDisplay	{'body': 'Old POKéMON merchandise is on\\ndisplay.$'}
text:GraniteCave_1F.GetsDarkAheadHereYouGo	{'body': "Hey, you.\\nIt gets awfully dark ahead.\\lIt'll be tough trying to explore.\\pThat guy who came by earlier…\\nSTEVEN, I think it was.\\pHe knew how to use FLASH, so he ought\\nto be all right, but…\\pWell, for us HIKERS, helping out those\\nthat we meet is our motto.\\pHere you go, I'll pass this on to you.$"}
text:GraniteCave_1F.ExplainFlash	{'body': "That HM registers FLASH as a field\\ntechnique for your team.\\pIt lights up even the inky darkness\\nof caves.\\pWith DEWFORD's GYM BADGE, caves\\nlight up as you enter them!$"}
text:GraniteCave_StevensRoom.StoneInPC	{'body': '{PLAYER} put the {STR_VAR_2}\\nin the PC.$'}
text:GraniteCave_StevensRoom.StoneStorageFull	{'body': "Your BAG and PC have no room for the\\nremaining stone. I'll keep it here.\\pMake some room, then speak to me\\nagain. Your gift will still be here.$"}
text:GraniteCave_StevensRoom.ImStevenLetterForMe	{'body': "I'm STEVEN. Forgive me, I didn't\\nhear you come in.\\pRare POKéMON have been seeking\\nshelter in these caves. Their\\lmovements seem to follow the\\lunusual weather.\\pI'm trying to understand why. Oh?\\nA LETTER from my father?$"}
text:GraniteCave_StevensRoom.ThankYouTakeThis	{'body': "You've earned BRAWLY's trust. And you\\ncame all this way to find me. Thank you.\\pTake this MEGA RING. With a matching\\nstone, one partner can Mega Evolve\\lduring a battle.\\pHave your partner hold its stone.\\nChoose FIGHT, then press START before\\lyou choose a move.\\pA strong bond helps your team\\nbring out that power.$"}
text:GraniteCave_StevensRoom.NoStarterStone	{'body': "I don't have a matching Mega\\nStone for your original partners\\lhere.\\pKeep exploring. Other members of\\nyour team may be able to Mega\\lEvolve, too!$"}
text:GraniteCave_StevensRoom.ArchiveOpen	{'body': "The RING lets your partners use\\nMega Stones you find across\\lHOENN. Look off the path, and\\ltalk to people you meet!\\pIt also opens the CENTER vendors'\\nfree Form Tools archive.\\lLegendary form tools are there,\\ltoo.$"}
text:GraniteCave_StevensRoom.ReturnWithKnuckleBadge	{'body': 'The LETTER confirms it: unusual\\nweather is driving rare POKéMON\\linto new hiding places.\\pChallenge BRAWLY at DEWFORD GYM.\\nCome back with the KNUCKLE BADGE.$'}
text:GraniteCave_StevensRoom.FindBrawlyInSlateport	{'body': "BRAWLY is visiting SLATEPORT. Look\\noutside the OCEANIC MUSEUM for him.\\pYou've delivered my LETTER, so ask\\nMR. BRINEY at the dock to sail there.\\pFind BRAWLY, then return to DEWFORD.\\nI'll wait here for your KNUCKLE BADGE.$"}
text:GraniteCave_StevensRoom.CouldBecomeChampionLetsRegister	{'body': "A journey teaches you things you\\ncannot learn in a laboratory.\\pLet's register each other in the\\nPOKéNAV. I'll keep studying these\\lunusual POKéMON sightings.$"}
text:GraniteCave_StevensRoom.RegisteredSteven	{'body': 'Registered STEVEN\\nin the POKéNAV.$'}
text:GraniteCave_StevensRoom.SternHandoff	{'body': "Now take DEVON's GOODS to CAPT. STERN\\nin SLATEPORT CITY.\\pAsk MR. BRINEY at DEWFORD's dock\\nto sail you there.\\pThe SHIPYARD staff in SLATEPORT can\\ntell you where to find the captain.$"}
text:GraniteCave_StevensRoom.IveGotToHurryAlong	{'body': 'I am heading east. MAGMA and AQUA\\nare disturbing more than land\\land sea.\\pCOBALION lives among wild\\nPOKéMON on GRANITE CAVE B2F,\\lwith a 3% encounter chance.\\pRead the area signs as you travel.\\nThey list the local POKéMON and\\lany special requirements.$'}
text:GraniteCave_StevensRoom.OhBagIsFull	{'body': 'Your BAG is full. Make room and return;\\nI will keep the MEGA RING safe.$'}
text:GraniteCave_StevensRoom.CobalionCaught	{'body': "You've already found COBALION!\\nIt chose a remarkable companion.\\pI am heading east to study these\\ndisturbances. Keep checking the\\lroute signs as you travel.\\pThey record your discoveries and\\nshow which POKéMON remain nearby.$"}
text:IndigoPlateau_PokemonCenter_1F_GymGuyAdvice	{'body': 'Yo!\\nChamp in the making!\\pAt the POKéMON LEAGUE, you will\\nface the ELITE FOUR all in a row.\\pIf you lose, you have to start all\\nover again!\\pThis is it!\\nGo for it!$'}
text:IndigoPlateau_PokemonCenter_1F_FaceEliteFourGoodLuck	{'body': 'From here on, you face the\\nELITE FOUR one by one.\\pIf you win, a door opens to the\\nnext TRAINER. Good luck!$'}
text:IndigoPlateau_PokemonCenter_1F_LoreleiIsAbsentClosedForTimeBeing	{'body': "I am so sorry, but you've wasted\\nyour time coming here.\\pLORELEI of the ELITE FOUR is\\nabsent, you see.\\pAs a result, the POKéMON LEAGUE is\\nclosed for the time being.$"}
text:IndigoPlateau_PokemonCenter_1F_AgathaWhuppedUs	{'body': "AGATHA's GHOST-type POKéMON are\\nhorrifically terrifying in toughness.\\pI took my FIGHTING-type POKéMON\\nand raised them to the max.\\pI went at AGATHA feeling pretty\\nconfident, but she whupped us.\\pThat old lady's also got a really\\nshort fuse, too.\\pIt doesn't take anything to get\\nthat scary lady hollering.$"}
text:IndigoPlateau_PokemonCenter_1F_LancesCousinGymLeaderFarAway	{'body': "Maybe becoming an ELITE FOUR\\nmember is in the blood.\\pFrom what I've heard, LANCE has\\na cousin who's a GYM LEADER\\lsomewhere far away.$"}
text:InsideOfTruck.BoxPrintedWithMonLogo	{'body': "The box has a POKéMON logo on it.\\pIt's from a moving and delivery\\nservice that works with POKéMON.$"}
text:JaggedPass.VialChanseyAshenWoods	{'body': 'Blob vanished into ASHEN WOODS.\\nThe HEAL BALL is still warm.$'}
text:JaggedPass.EricIntro	{'body': "MT. CHIMNEY's JAGGED PASS…\\pNow this is what I've always wanted\\nin a mountain.\\pThis jagged bumpiness…\\nIt rocks my soul!$"}
text:JaggedPass.EricDefeat	{'body': 'Losing left me bitter!$'}
text:JaggedPass.EricPostBattle	{'body': 'Yes, I did lose at POKéMON…\\pBut, when it comes to the love of\\nthe mountains, I have you beat!$'}
text:JaggedPass.DianaIntro	{'body': "This place isn't your casual hike.\\nIt's not suited for a picnic.$"}
text:JaggedPass.DianaDefeat	{'body': 'Ohhh, no!\\nThe ground is too bumpy…$'}
text:JaggedPass.DianaPostBattle	{'body': 'Did you know?\\pSome people cleverly ride their\\nbicycles up this horribly bumpy pass.$'}
text:JaggedPass.DianaRegister	{'body': "Will you ever be back in this\\narea? If you return, share what\\lyou've learned.$"}
text:JaggedPass.DianaRematchIntro	{'body': 'Picnics are fun wherever you go.\\nJust like POKéMON!$'}
text:JaggedPass.DianaRematchDefeat	{'body': 'I only lost because the ground is\\ntoo bumpy!$'}
text:JaggedPass.DianaPostRematch	{'body': "I'll forget about losing and just\\nenjoy this bumpy hike.$"}
text:JaggedPass.EthanIntro	{'body': "JAGGED PASS is hard to walk on.\\nIt's a good place for training.$"}
text:JaggedPass.EthanDefeat	{'body': 'It was all over while we were still\\ntrying to find a good footing…$'}
text:JaggedPass.EthanPostBattle	{'body': "If I had an ACRO BIKE, I'd be able to\\njump ledges.$"}
text:JaggedPass.EthanRegister	{'body': "When I get more used to this bumpiness,\\nI'll send you my best climbing tips!\\pCan you register me in your POKéNAV?$"}
text:JaggedPass.EthanRematchIntro	{'body': 'I got used to this bumpiness.\\nI sing while I climb now.$'}
text:JaggedPass.EthanRematchDefeat	{'body': "It's still not easy to battle on this\\nbumpy ground…$"}
text:JaggedPass.EthanPostRematch	{'body': 'I should get an ACRO BIKE from RYDEL\\nin MAUVILLE CITY…$'}
text:JaggedPass.GruntIntro	{'body': 'Wah! What are you doing up here?\\pWhat am I doing up here? Guarding a\\npath. Badly, apparently. Fight me!$'}
text:JaggedPass.GruntDefeat	{'body': "Urrrgh… Should've ducked into the\\nHIDEOUT while I could.$"}
text:JaggedPass.GoWhereverYouWant	{'body': "Okay, oh-kay!\\nI admit it--you're strong!\\pDon't worry about me.\\nGo wherever you want!$"}
text:JaggedPass.BoulderShakingInResponseToEmblem	{'body': 'Oh! This boulder is shaking in response\\nto the MAGMA EMBLEM!$'}
text:JaggedPass.JulioIntro	{'body': "Aiyeeh! It's awfully scary to shoot\\ndown the mountain in one go!$"}
text:JaggedPass.JulioDefeat	{'body': "I feel like I'm falling apart…$"}
text:JaggedPass.JulioPostBattle	{'body': "My bicycle bounced around so much,\\nmy rear end's sore…$"}
text:JaggedPass.AutumnIntro	{'body': 'I climb this hill every day.\\nI have confidence in my strength!$'}
text:JaggedPass.AutumnDefeat	{'body': 'Hmm…\\nWhat went wrong?$'}
text:JaggedPass.AutumnPostBattle	{'body': 'What is that odd rock protrusion\\na little up the hill from here?$'}
text:LavaridgeTown.MayNiceBadgesTakeThis	{'body': 'MAY: {PLAYER}{KUN}! You stopped MAGMA\\nand earned the HEAT BADGE!\\pThe hot springs finally feel\\npeaceful again.\\pHere, these will help with the\\nsandstorm on ROUTE 111.$'}
text:LavaridgeTown.GoGogglesSentToPC	{'body': 'Your KEY ITEMS pocket is full, so the\\nGO-GOGGLES were sent to your PC.$'}
text:LavaridgeTown.GoGogglesNoRoom	{'body': 'Your KEY ITEMS pocket and PC are\\nfull. Make room, then talk to me.\\pIf you leave town, I will wait\\noutside the HERB SHOP.$'}
text:LavaridgeTown.MayExplainGoGogglesChallengeDad	{'body': 'MAY: Carry those GO-GOGGLES in\\nyour BAG to explore the desert.\\pThe route signs list its POKéMON.\\nCheck them before heading in!\\pWith four BADGES, you can\\nchallenge your dad in PETALBURG.\\pI want to see how I do against\\nhim, too. See you there!$'}
text:LavaridgeTown.BrendanNiceBadgesTakeThis	{'body': 'BRENDAN: Hey, {PLAYER}!\\nYou stopped MAXIE at the summit!\\pAnd now you have the HEAT BADGE.\\nYou have been busy!\\pTake these for the sandstorm\\non ROUTE 111.$'}
text:LavaridgeTown.BrendanExplainGoGogglesChallengeDad	{'body': 'BRENDAN: Keep the GO-GOGGLES in\\nyour BAG to explore the desert.\\pCheck its route signs for POKéMON\\nyou have not found elsewhere.\\pFour BADGES means NORMAN will\\naccept your challenge now.\\pI am heading to PETALBURG, too.\\nYour dad should be a tough match!$'}
text:LavaridgeTown.HaveEggWillYouTakeIt	{'body': "I have here an EGG.\\pI'd hoped to hatch it by covering it in\\nhot sand by the hot springs.\\lBut that doesn't seem to be enough…\\pI've heard it would be best if it were\\nkept together with POKéMON and\\lcarried about.\\pYou are a TRAINER, yes?\\nAnd your POKéMON radiate vitality.\\pSo, what say you?\\nWill you take this EGG to hatch?$"}
text:LavaridgeTown.HopeYoullWalkPlentyWithEgg	{'body': "Good! I hope you'll walk plenty with\\nthis here EGG!$"}
text:LavaridgeTown.ReceivedTheEgg	{'body': '{PLAYER} received the EGG.$'}
text:LavaridgeTown.NoRoomForThisEgg	{'body': "Oh? You've too many POKéMON.\\nThere's no room for this EGG…$"}
text:LavaridgeTown.AsYouWishThen	{'body': 'As you wish, then…\\pIf you have a change of heart about\\nhatching this EGG, I will be here.$'}
text:LavaridgeTown.EverySoOftenEggFoundAtDayCare	{'body': "Every so often, an EGG will be found at\\nthe POKéMON DAY CARE.\\pOr at least that's how the rumor goes.$"}
text:LavaridgeTown.HotSpringsNeverRunDry	{'body': "We draw as much hot water as we need,\\nand yet the hot springs never run dry.\\pIsn't it magical?\\pThese hot springs appear near active\\nvolcanoes. Veins of water under the\\lground are heated by magma to well up\\las hot springs.$"}
text:LavaridgeTown.PokemonNippedBackside	{'body': 'Being buried in this hot sand is…\\nSigh…\\pSo warm and heavenly…\\pEh? Gyaah! Ouch!\\pA POKéMON nipped my backside!$'}
text:LavaridgeTown.OhYouLikeHotSprings	{'body': "Oh, you like hot springs, do you?\\pThat's surprising for one as young\\nas you.$"}
text:LavaridgeTown.BatheInHotSpringsEveryDay	{'body': 'I bathe in the hot springs every day.\\pI want to become a beautiful and strong\\nGYM LEADER like FLANNERY.$'}
text:LavaridgeTown.IfPokemonInHotSprings	{'body': 'If people put POKéMON in hot springs,\\nit might be seriously strange.\\pWhy, it might be an electric bath, or\\na bubble bath, or even a lava bath…$'}
text:LavaridgeTown.HotSpringsClaims	{'body': "They're claiming that these hot springs\\nare good for calming nervous tension,\\lrelieving aching muscles, solving\\lromantic problems, and attracting\\lmoney…$"}
text:LavaridgeTown.TownSign	{'body': 'LAVARIDGE TOWN\\p“POKéMON CENTER HOT SPRINGS\\nAn excellent place for relaxing!”$'}
text:LavaridgeTown.GymSign	{'body': 'LAVARIDGE TOWN POKéMON GYM\\nLEADER: FLANNERY\\l“One with a fiery passion that burns!”$'}
text:LavaridgeTown.HerbShopSign	{'body': 'POKéMON HERB SHOP\\n“Bitter taste--better cure!”$'}
text:LavaridgeTown_Gym_1F.GymGuideAdvice	{'body': "FLANNERY's sun strengthens Fire\\nattacks and weakens Water\\lattacks.\\pLILLIGANT can use AFTER YOU to\\nlet slow TORKOAL attack sooner.\\pWeather control, disruption and\\ncareful damage all offer\\ldifferent ways to challenge that\\lpartnership.$"}
text:LavaridgeTown_Gym_1F.GymGuidePostVictory	{'body': 'Yow! That was a scorching-hot battle!$'}
text:LavaridgeTown_Gym_1F.ColeIntro	{'body': "Owowowowow!\\nYikes, it's hot!\\pContact can burn more than pride!$"}
text:LavaridgeTown_Gym_1F.ColeDefeat	{'body': "I'm blinded by sweat in my eyes…$"}
text:LavaridgeTown_Gym_1F.ColePostBattle	{'body': "Being buried in hot sand promotes\\ncirculation.\\pIt's effective for healing pain in\\nyour joints.$"}
text:LavaridgeTown_Gym_1F.AxleIntro	{'body': "I'm trying to relieve my stress.\\nDon't come along and stress me out!\\pARMAROUGE's WEAKNESS POLICY can\\nturn a weakness into power!$"}
text:LavaridgeTown_Gym_1F.AxleDefeat	{'body': 'I hope FLANNERY flames you good!$'}
text:LavaridgeTown_Gym_1F.AxlePostBattle	{'body': 'Haaah… Whew…\\pIf you spend too much time buried in\\nhot sand, it tuckers you out…$'}
text:LavaridgeTown_Gym_B1F_KeeganIntro	{'body': "You must be getting tired by now.\\nYou'd like to rest in the hot sand,\\lwouldn't you?\\pBut you should know that maintaining\\nyour willpower is an important ability\\lfor all TRAINERS.\\pMy own poison is my fuel!$"}
text:LavaridgeTown_Gym_B1F_KeeganDefeat	{'body': 'Play with fire, and be burned…$'}
text:LavaridgeTown_Gym_B1F_KeeganPostBattle	{'body': "Your skill is real…\\nBut our LEADER FLANNERY is strong.\\pIf you don't watch yourself, you'll be\\nburned seriously.$"}
text:LavaridgeTown_Gym_1F.GeraldIntro	{'body': 'Can your POKéMON handle\\nthe heat of this team?\\pSUNNY DAY first. Then we run!$'}
text:LavaridgeTown_Gym_1F.GeraldDefeat	{'body': "It didn't burn hotly enough…$"}
text:LavaridgeTown_Gym_1F.GeraldPostBattle	{'body': 'Sun helps my Grass Pokémon move\\nfaster.\\pEven here, a Fire team needs\\nits partners!$'}
text:LavaridgeTown_Gym_1F.DanielleIntro	{'body': "Um…\\nOkay, I'll battle with you.\\pDance, and ORICORIO dances too!$"}
text:LavaridgeTown_Gym_1F.DanielleDefeat	{'body': "Oh, but you're too strong.$"}
text:LavaridgeTown_Gym_1F.DaniellePostBattle	{'body': "I'm going to be a pretty and strong\\nTRAINER just like FLANNERY.$"}
text:LavaridgeTown_Gym_B1F_JaceIntro	{'body': "Come on, get with it!\\nLet's go before my feelings cool!\\pSALAZZLE's TOXIC can poison STEEL!$"}
text:LavaridgeTown_Gym_B1F_JaceDefeat	{'body': "It's so hot, and yet my heart is\\nclutched by ice…$"}
text:LavaridgeTown_Gym_B1F_JacePostBattle	{'body': 'The way the battling spirit burns\\nwithin you, you may stand a chance\\lagainst our LEADER.$'}
text:LavaridgeTown_Gym_B1F_JeffIntro	{'body': "See how the flames blaze wildly?\\nThey flare in anticipation of my win!\\pAt full health, TALONFLAME's\\nFlying moves gain priority!$"}
text:LavaridgeTown_Gym_B1F_JeffDefeat	{'body': "Something didn't go right.$"}
text:LavaridgeTown_Gym_B1F_JeffPostBattle	{'body': "Well, so what? I say so what?\\nI can walk on hot coals barefoot!\\p…Don't even think about trying it!$"}
text:LavaridgeTown_Gym_B1F_EliIntro	{'body': 'As much as I love mountains,\\nI especially love volcanoes.\\pCLAYDOL avoids Ground attacks.\\nBRONZONG can take the heat!$'}
text:LavaridgeTown_Gym_B1F_EliDefeat	{'body': 'Well, it seems my team has\\nmet its match!$'}
text:LavaridgeTown_Gym_B1F_EliPostBattle	{'body': "I stay here because I became a fan\\nof FLANNERY's power.\\pHehehehe.$"}
text:LavaridgeTown_Gym_1F.FlanneryIntro	{'body': "I am FLANNERY, LAVARIDGE's GYM\\nLEADER!\\pMT. CHIMNEY taught me that power\\nneeds timing.\\pLILLIGANT and TORKOAL are ready\\nto turn up the heat. Show us your\\lbest!$"}
text:LavaridgeTown_Gym_1F.FlanneryDefeat	{'body': 'That was a blazing battle!\\pYou beat the team I put my heart\\ninto. Take the HEAT BADGE!$'}
text:LavaridgeTown_Gym_1F.ReceivedHeatBadge	{'body': '{PLAYER} received the HEAT BADGE\\nfrom FLANNERY.$'}
text:LavaridgeTown_Gym_1F.ExplainHeatBadgeTakeThis	{'body': "The HEAT BADGE lets your LEVELER train\\na party up to Lv. 45.\\pIt also enables STRENGTH outside\\nof battle.\\pThis is a token of my appreciation.\\nDon't be shy about taking it!$"}
text:LavaridgeTown_Gym_1F.ExplainCameruptite	{'body': 'Cameruptite lets Camerupt Mega Evolve.\\nLet it hold the stone in battle.$'}
text:LavaridgeTown_Gym_1F.RegisteredFlannery	{'body': 'Registered GYM LEADER FLANNERY\\nin the POKéNAV.$'}
text:LavaridgeTown_Gym_1F.FlanneryPostBattle	{'body': 'Four BADGES! NORMAN is ready for\\nyour challenge in PETALBURG CITY.\\pHead back through MAUVILLE, then\\nwest through RUSTURF TUNNEL.\\pFrom RUSTBORO, follow the woods\\nsouth to PETALBURG and its GYM.\\pEMBER PATH is also open now.\\nExplore it when you can move boulders.$'}
text:LavaridgeTown_Gym_1F.GymStatue	{'body': 'LAVARIDGE TOWN POKéMON GYM$'}
text:LavaridgeTown_Gym_1F.GymStatueCertified	{'body': "LAVARIDGE TOWN POKéMON GYM\\pFLANNERY'S CERTIFIED TRAINERS:\\n{PLAYER}$"}
text:LavaridgeTown_Gym_1F.FlanneryPreRematch	{'body': "FLANNERY: Losing a battle isn't going\\nto deflate me.\\pI love POKéMON.\\nI love to battle.\\lAnd… I love this GYM!\\pLet's exchange superhot moves\\nin another battle!$"}
text:LavaridgeTown_Gym_1F.FlanneryRematchDefeat	{'body': 'Whew!\\nOn the verge of eruption!$'}
text:LavaridgeTown_Gym_1F.FlanneryPostRematch	{'body': "FLANNERY: I lost the match,\\nbut I'm completely satisfied.\\pIt's not often I get to enjoy a battle\\nthis heated.\\pLet's have another one like this\\nagain sometime!$"}
text:LavaridgeTown_Gym_1F.FlanneryRematchNeedTwoMons	{'body': "FLANNERY: Losing a battle isn't going\\nto deflate me.\\pI love POKéMON.\\nI love to battle.\\lAnd… I love this GYM!\\pLet's exchange superhot moves\\nin another battle!\\pOh, wait. Do you only have one POKéMON\\nthat can battle?\\pI hate to say this, but when you come\\nsee me, bring at least two POKéMON.$"}
text:LavaridgeTown_HerbShop.WelcomeToHerbShop	{'body': 'Welcome to the HERB SHOP, home of\\neffective and inexpensive medicine!$'}
text:LavaridgeTown_HerbShop.YouveComeToLookAtHerbalMedicine	{'body': "You've come to look at herbal medicine\\nin LAVARIDGE?\\pThat's rather commendable.\\pI like you! Take this!$"}
text:LavaridgeTown_HerbShop.ExplainFireStone	{'body': 'A Fire Stone evolves certain Pokémon.\\nUse it from the Bag when ready.$'}
text:LavaridgeTown_HerbShop.HerbalMedicineWorksButMonWillDislike	{'body': 'Herbal medicine works impressively well.\\nBut your POKéMON will dislike you for it.\\lIt must be horribly bitter!$'}
text:LavaridgeTown_House.WifeWarmingEggInHotSprings	{'body': "My wife's warming an EGG in the hot\\nsprings. This is what she told me.\\pShe left two POKéMON with the DAY CARE.\\nAnd they discovered that EGG!$"}
text:LavaridgeTown_House.Zigzagoon	{'body': 'ZIGZAGOON: Pshoo!$'}
text:LavaridgeTown_House.MegaGift_BLAZIKENITE_Text	{'body': 'I learned footwork by watching\\nBlaziken train on the hot rocks.\\pA flame needs room to grow.\\nTake this stone on your journey.$'}
text:LavaridgeTown_House.MegaGift_MACHAMPITE_Text	{'body': 'Machamp carried the stones that\\nbuilt some of these old baths.\\pThis one is small enough to carry\\nyourself. Let a Machamp hold it.$'}
text:LavaridgeTown_Mart.PrepareBeforeTrainerBattles	{'body': "TRAINER battles don't allow items\\nfrom the BAG.\\pPrepare your moves and held items\\nbefore the battle begins!$"}
text:LavaridgeTown_Mart.LocalSpecialtyOnMtChimney	{'body': "On MT. CHIMNEY's peak, there's a local\\nspecialty sold beside the crater.\\pGive it to a POKéMON--it will be elated.$"}
text:LavaridgeTown_PokemonCenter_1F.LucyChallenge	{'body': 'Scott said a serious Trainer would\\ncome through these springs.\\pI am Lucy. I stack the odds until\\nthey obey. Show me your answer.$'}
text:LavaridgeTown_PokemonCenter_1F.LucyDefeat	{'body': 'So… You made your own luck.$'}
text:LavaridgeTown_PokemonCenter_1F.LucyReward	{'body': 'That ABSOLITE belongs with someone\\nwho can force the right outcome.\\pThe BATTLE FRONTIER awaits.$'}
text:LavaridgeTown_PokemonCenter_1F.TrainersPokemonSpendTimeTogether	{'body': "I think POKéMON get closer to their\\nTRAINERS if they spend time together.\\pThe longer the better.\\nThat's what I think.$"}
text:LavaridgeTown_PokemonCenter_1F.HotSpringCanInvigorate	{'body': "It's sort of magical how just sitting\\nin a hot-spring pool can invigorate.\\pI wish I could let my POKéMON\\nsoak, too.$"}
text:LavaridgeTown_PokemonCenter_1F.TrainersShouldRestToo	{'body': 'Hohoho! Hey, kid, you can reach\\nthe hot springs from here.\\pIf POKéMON are getting rest, so too\\nshould their TRAINERS.$'}
text:LavaridgeTown_PokemonCenter_1F.MoomooMilkWelcome	{'body': 'Moomoo Milk is perfect before or after\\nthe hot spring. How many would you like?$'}
text:LavenderTown_DoYouBelieveInGhosts	{'body': 'Do you believe in ghosts?$'}
text:LavenderTown_SoThereAreBelievers	{'body': 'Really?\\nSo there are believers…$'}
text:LavenderTown_JustImaginingWhiteHand	{'body': "Hahaha, I guess not.\\pThat white hand on your shoulder…\\nI'm just imagining it.$"}
text:LavenderTown_TownKnownAsMonGraveSite	{'body': 'This town is known as the grave\\nsite of POKéMON.\\pMemorial services are held in\\nPOKéMON TOWER.$'}
text:LavenderTown_GhostsAppearedInTower	{'body': "Ghosts appeared in POKéMON TOWER.\\pI think they're the spirits of\\nPOKéMON that the ROCKETS killed.$"}
text:LavenderTown_TownSign	{'body': 'LAVENDER TOWN\\nThe Noble Purple Town$'}
text:LavenderTown_SilphScopeNotice	{'body': 'New SILPH SCOPE!\\nMake the Invisible Plain to See!\\pSILPH CO.$'}
text:LavenderTown_VolunteerPokemonHouse	{'body': 'LAVENDER VOLUNTEER\\nPOKéMON HOUSE$'}
text:LavenderTown_PokemonTowerSign	{'body': 'POKéMON TOWER\\nBecalm the Spirits of POKéMON$'}
text:LavenderTown_House1_Cubone	{'body': 'CUBONE: Kyarugoo!$'}
text:LavenderTown_House1_RocketsKilledCubonesMother	{'body': "Those horrible ROCKETS!\\nThey deserve no mercy!\\pThat poor CUBONE's mother…\\pIt was killed trying to escape from\\nTEAM ROCKET.$"}
text:LavenderTown_House1_GhostOfPokemonTowerIsGone	{'body': 'The ghost of POKéMON TOWER is\\ngone!\\pSomeone must have soothed its\\nrestless spirit!$'}
text:LavenderTown_House2_WantMeToRateNicknames	{'body': 'Hello, hello!\\nI am the official NAME RATER!\\pWant me to rate the nicknames of\\nyour POKéMON?$'}
text:LavenderTown_House2_CritiqueWhichMonsNickname	{'body': "Which POKéMON's nickname should\\nI critique?$"}
text:LavenderTown_House2_GiveItANicerName	{'body': '{STR_VAR_1}, is it?\\nThat is a decent nickname!\\pBut, would you like me to give it\\na nicer name?\\pHow about it?$'}
text:LavenderTown_House2_WhatShallNewNicknameBe	{'body': 'Ah, good. Then, what shall the new\\nnickname be?$'}
text:LavenderTown_House2_FromNowOnShallBeKnownAsName	{'body': 'Done! From now on, this POKéMON\\nshall be known as {STR_VAR_1}!\\pIt is a better name than before!\\nHow fortunate for you!$'}
text:LavenderTown_House2_ISeeComeVisitAgain	{'body': 'I see.\\nDo come visit again.$'}
text:LavenderTown_House2_FromNowOnShallBeKnownAsSameName	{'body': 'Done! From now on, this POKéMON\\nshall be known as {STR_VAR_1}!\\pIt looks no different from before,\\nand yet, this is vastly superior!\\pHow fortunate for you!$'}
text:LavenderTown_House2_TrulyImpeccableName	{'body': '{STR_VAR_1}, is it?\\nThat is a truly impeccable name!\\pTake good care of {STR_VAR_1}!$'}
text:LavenderTown_House2_ThatIsMerelyAnEgg	{'body': 'Now, now.\\nThat is merely an EGG!$'}
text:LavenderTown_Mart_SearchingForStatRaiseItems	{'body': "I'm searching for items that raise\\nthe stats of POKéMON.\\pThey're effective over the course\\nof a single battle.\\pX ATTACK, X DEFEND, X SPEED, \\nand X SPECIAL are what I'm after.\\pDo you know where I can get them?$"}
text:LavenderTown_Mart_DidYouBuyRevives	{'body': 'Did you buy some REVIVES?\\nThey revive any fainted POKéMON!$'}
text:LavenderTown_Mart_TrainerDuosCanChallengeYou	{'body': 'Sometimes, a TRAINER duo will\\nchallenge you with two POKéMON\\lat the same time.\\pIf that happens, you have to send\\nout two POKéMON to battle, too.$'}
text:LavenderTown_Mart_SoldNuggetFromMountainsFor5000	{'body': 'この\u3000あいだ\u3000やまおくで\\nきんのたまを\u3000ひろい\u3000ましてね！\\pつかえない\u3000しなもの\u3000ですが\\nうったら\u3000なんと\u30005000¥でした$'}
text:LavenderTown_PokemonCenter_1F_RocketsDoAnythingForMoney	{'body': 'TEAM ROCKET will do anything for\\nthe sake of money!\\pThere is no job too dirty, no deed\\ntoo heinous, no crime too wicked!$'}
text:LavenderTown_PokemonCenter_1F_CubonesMotherKilledByRockets	{'body': "I saw CUBONE's mother trying to\\nescape from TEAM ROCKET.\\pShe was killed trying to get away…$"}
text:LavenderTown_PokemonCenter_1F_PeoplePayForCuboneSkulls	{'body': 'You know how the CUBONE species\\nwears skulls, right?\\pPeople will pay a lot for one.$'}
text:LavenderTown_PokemonCenter_1F_HearMrFujiNotFromAroundHere	{'body': "I recently moved to this town.\\pI hear that MR. FUJI's not from\\nthese parts originally, either.$"}
text:LavenderTown_VolunteerPokemonHouse_WhereDidMrFujiGo	{'body': "That's odd, MR. FUJI isn't here.\\nWhere'd he go?$"}
text:LavenderTown_VolunteerPokemonHouse_MrFujiWasPrayingForCubonesMother	{'body': "MR. FUJI had been praying alone\\nfor CUBONE's mother.$"}
text:LavenderTown_VolunteerPokemonHouse_MrFujiLooksAfterOrphanedMons	{'body': "This is really MR. FUJI's house.\\pHe's really kind.\\pHe looks after abandoned and\\norphaned POKéMON.$"}
text:LavenderTown_VolunteerPokemonHouse_MonsNiceToHug	{'body': "It's so warm!\\nPOKéMON are so nice to hug.$"}
text:LavenderTown_VolunteerPokemonHouse_Nidorino	{'body': 'NIDORINO: Gaoo!$'}
text:LavenderTown_VolunteerPokemonHouse_Psyduck	{'body': 'PSYDUCK: Gwappa!$'}
text:LavenderTown_VolunteerPokemonHouse_IdLikeYouToHaveThis	{'body': "MR. FUJI: {PLAYER}…\\pYour POKéDEX quest is one that\\nrequires strong dedication.\\pWithout deep love for POKéMON,\\nyour quest may fail.\\pI'm not sure if this will help you,\\nbut I'd like you to have it.$"}
text:LavenderTown_VolunteerPokemonHouse_ReceivedPokeFluteFromMrFuji	{'body': '{PLAYER} received a POKé FLUTE\\nfrom MR. FUJI.$'}
text:LavenderTown_VolunteerPokemonHouse_ExplainPokeFlute	{'body': 'Upon hearing the POKé FLUTE,\\nsleeping POKéMON will spring awake.\\pTry using it on POKéMON that are\\nsleeping obstacles.$'}
text:LavenderTown_VolunteerPokemonHouse_MustMakeRoomForThis	{'body': 'You must make room for this!$'}
text:LavenderTown_VolunteerPokemonHouse_HasPokeFluteHelpedYou	{'body': 'MR. FUJI: Has my POKé FLUTE\\nhelped you?$'}
text:LavenderTown_VolunteerPokemonHouse_GrandPrizeDrawingClipped	{'body': "POKéMON FAN MAGAZINE\\nMonthly Grand Prize Drawing!\\pThe application form is…\\pGone! It's been clipped out.\\nSomeone must have applied already.$"}
text:LavenderTown_VolunteerPokemonHouse_PokemonMagazinesLineShelf	{'body': 'POKéMON magazines line the shelf.\\pPOKéMON INSIDER…\\pPOKéMON FAN…$'}
text:LilycoveCity.AltarianiteKeeperOffer	{'body': 'Your ALTARIA carries itself like a\\ncloud dragon. Take this ALTARIANITE?$'}
text:LilycoveCity.AltarianiteKeeperExplain	{'body': 'ALTARIANITE lets ALTARIA Mega Evolve.\\pWINONA also entrusts one to every\\nTRAINER who earns her BADGE.$'}
text:LilycoveCity.AltarianiteKeeperNeedsAltaria	{'body': 'Return with ALTARIA. I want to see\\nwhether it moves like a cloud.$'}
text:LilycoveCity.AltarianiteKeeperDecline	{'body': 'Very well. The stone will wait until\\nyou and ALTARIA are ready.$'}
text:LilycoveCity.MayShoppingLetsBattle	{'body': "MAY: {PLAYER}{KUN}! Are you\\nshopping, too?\\pI was looking for a gift for Dad,\\nbut I keep finding things I want!\\pIt's been ages since our last\\nbattle. Want to show me your\\lteam?$"}
text:LilycoveCity.MayNotRaisingPokemon	{'body': "MAY: Another time, then! I'll be\\nhere trying to choose a present.$"}
text:LilycoveCity.MayBattleMe	{'body': "MAY: Ready for a battle? I've met\\nsome wonderful POKéMON since\\lROUTE 119!$"}
text:LilycoveCity.MayWontBeBeaten	{'body': "MAY: All right! Everyone, let's\\ngive it our best!$"}
text:LilycoveCity.MayDefeat	{'body': "MAY: I remember our first battle\\non ROUTE 103.\\pYou keep finding ways through my\\nteams. I'll have to try again!$"}
text:LilycoveCity.MayGoingBackToLittleroot	{'body': "MAY: I'm heading back to\\nLITTLEROOT. Dad could use help\\lsorting all our POKéMON\\lsightings.$"}
text:LilycoveCity.MayYouGoingToCollectBadges	{'body': "Keep going, {PLAYER}{KUN}. Earn\\nthe BADGES, explore HOENN and\\ltake on the LEAGUE!\\pI'll still finish the POKéDEX\\nbefore you do. See you!$"}
text:LilycoveCity.MayYouGoingToPokemonLeague	{'body': "{PLAYER}{KUN}, is it the LEAGUE next?\\nOr the POKéDEX?\\pI lost the battle. I'm still winning\\nthe POKéDEX. See you!$"}
text:LilycoveCity.MayYouGoingToBattleFrontier	{'body': "{PLAYER}{KUN}, what are you going to do?\\pAre you taking the BATTLE FRONTIER\\nchallenge?\\pOr, are you going to complete your\\nPOKéDEX?\\pI might've lost to you in battling,\\nbut I'll finish my POKéDEX before you!\\pSee you!$"}
text:LilycoveCity.BrendanShoppingLetsBattle	{'body': "BRENDAN: {PLAYER}! Running an\\nerrand for Dad. No, I'm not\\lbuying DOLLS!\\pIt's been a while since ROUTE\\n119. Got time for a battle?$"}
text:LilycoveCity.BrendanNoConfidence	{'body': "BRENDAN: Got other plans? Fair\\nenough. Come find me when you're\\lready!$"}
text:LilycoveCity.BrendanBattleMe	{'body': "BRENDAN: How about that battle?\\nI've been looking forward to it!$"}
text:LilycoveCity.BrendanWontBeBeaten	{'body': "BRENDAN: I've caught and trained\\nPOKéMON all the way here. I'm\\lready for you, {PLAYER}!$"}
text:LilycoveCity.BrendanDefeat	{'body': "BRENDAN: You found a way through\\nmy team. That stings.\\pI had a head start as a TRAINER...\\nI'll have to make the next one\\lcount.$"}
text:LilycoveCity.BrendanGoingBackToLittleroot	{'body': "BRENDAN: I'm heading home. Dad\\nneeds someone to sort our POKéMON\\lsightings, and I know where I\\lfound mine.$"}
text:LilycoveCity.BrendanYouGoingToCollectBadges	{'body': "BRENDAN: What's next, {PLAYER}?\\nThe rest of the BADGES, then the\\lLEAGUE?\\pMaybe I'll try that, too. But\\nfirst, Dad's waiting for these\\lsupplies.\\pDon't get too far ahead of me!$"}
text:LilycoveCity.BrendanYouGoingToPokemonLeague	{'body': "{PLAYER}, going for the LEAGUE?\\pOne more rebuild and I'd beat you.\\nProbably. Anyway, hang in there!$"}
text:LilycoveCity.BrendanYouGoingToBattleFrontier	{'body': "{PLAYER}, what now? The FRONTIER, or\\nthe POKéDEX?\\pWith your teams, the FRONTIER. The\\nCIRCUIT there is doubles all the way.\\pOne more rebuild and I'm stronger than\\nyou. Probably. Hang in there!$"}
text:LilycoveCity.MovedLootIntoHideoutToday	{'body': 'Fufufu…\\pWe moved more loot into our secret\\nHIDEOUT today…\\pWh-who are you?!\\nI was just talking to myself!$'}
text:LilycoveCity.ChanceToDoBigThings	{'body': "I'm just a GRUNT, so I don't know what\\nthe BOSS is thinking…\\pBut being on TEAM AQUA, I know I'll get\\nthe chance to do big things!\\pWh-who are you?!\\nI was just talking to myself!$"}
text:LilycoveCity.DontGoNearCaveInCove	{'body': "Hey, you!\\pDon't go near the cave in the cove!\\pWhy? You don't need a reason why!\\nI'm an adult, so you just listen to me!$"}
text:LilycoveCity.IfWorldBecomesOurs	{'body': "If this whole wide world becomes ours,\\nTEAM AQUA's, it will be a happier\\lplace for POKéMON, too.$"}
text:LilycoveCity.WailmerLeapOutOfWater	{'body': 'There! WAILMER!\\nLeap out of the water now!$'}
text:LilycoveCity.GetLostMessingUpTraining	{'body': "Hunh? What do you want?\\pYou're messing up our training,\\nso can you, like, get lost?$"}
text:LilycoveCity.ContestHallInTown	{'body': "There's a POKéMON CONTEST HALL\\nright in this here town. \\pThat means well-raised POKéMON will\\ncome from all over the country.\\pMy heart swells with excitement!$"}
text:LilycoveCity.StrangeCaveInCove	{'body': 'Have you seen that strange cave in\\nthe cove at the edge of town?$'}
text:LilycoveCity.GoingToMoveDeleterForHMs	{'body': "I'm choosing moves for a CONTEST.\\pThe move tutor beside the CENTER's\\nPC helps me rearrange my team's moves.\\pField skills don't need a move slot\\nonce licensed, so I have room to try\\lsomething new!$"}
text:LilycoveCity.ImFromKanto	{'body': 'I came from KANTO.\\pThe HOENN region is beautiful with\\nall its water and verdant nature.\\pHunh? Wait a second…\\pCould there be rare POKéMON that live\\nonly in this area?$'}
text:LilycoveCity.TeamAquaBeenTrainingWailmer	{'body': "TEAM AQUA's been training their\\nWAILMER in the cove.\\pWe SAILORS can't get our boats out\\nto sea with them in the way!$"}
text:LilycoveCity.SomeonePuntedTeamAquaOut	{'body': 'Ahoy, did you know?\\pSomeone punted TEAM AQUA out of\\nthe way for us!\\pThat got the WAILMER out of the cove,\\nso we can get our boats out again.$'}
text:LilycoveCity.SomeoneStoleMyPokemon	{'body': "I was taking a relaxing snooze at the\\nseaside inn to the sound of waves…\\pWhen someone stole my POKéMON!\\pWho's the abductor?\\nTEAM AQUA? Is it TEAM AQUA?$"}
text:LilycoveCity.MissingPokemonCameBack	{'body': 'My missing POKéMON…\\nIt came back without me noticing!$'}
text:LilycoveCity.ImArtDealer	{'body': "I'm an ART DEALER.\\pI am a buyer and seller of fine art,\\nespecially paintings.\\pI've heard that the MUSEUM here has\\nmagnificent works on exhibit…$"}
text:LilycoveCity.SeaRemainsForeverYoung	{'body': 'Even as we grow old and wrinkled,\\nthe sea remains forever young with\\lthe vivid brilliance of life…\\pFwohoho fwohohohoho…$'}
text:LilycoveCity.SixtyYearsAgoHusbandProposed	{'body': 'It was sixty years ago that my husband\\nproposed to me here.\\lThe sea remains as beautiful as ever.\\pMufufufu mufufufufufu…$'}
text:LilycoveCity.TeamAquaRenovatedCavern	{'body': "Hm, you know of the peculiar cavern\\nin this cove?\\pThat had been a natural formation,\\nbut then that TEAM AQUA lot came\\lalong and made their renovations.\\pThey call themselves\\nthe “nature-loving TEAM AQUA”!\\pBut what they do and what they say\\ndon't match at all!$"}
text:LilycoveCity.TeamAquaLotGoneForGood	{'body': "That cave in the cove…\\pI didn't notice it right away,\\nbut it's completely empty now.\\pThat TEAM AQUA lot, they must\\nhave gone away for good.$"}
text:LilycoveCity.CitySign	{'body': 'LILYCOVE CITY\\p“Where the land ends and the\\nsea begins.”$'}
text:LilycoveCity.ContestHallSign	{'body': 'POKéMON CONTEST HALL\\n“The gathering place for TRAINERS!”$'}
text:LilycoveCity.MotelSign	{'body': 'COVE LILY MOTEL\\p“Remember us as COVE LILY of\\nLILYCOVE.”$'}
text:LilycoveCity.MuseumSign	{'body': 'LILYCOVE MUSEUM\\p“POKéMON Masterpiece Collection\\non exhibit!”$'}
text:LilycoveCity.MuseumSignPlayersExhibit	{'body': "LILYCOVE MUSEUM\\p“{PLAYER}'s POKéMON Collection\\non exhibit!”$"}
text:LilycoveCity.HarborSignUnderConstruction	{'body': 'LILYCOVE CITY HARBOR\\p“The ferry S.S. TIDAL is under\\nconstruction in SLATEPORT CITY.\\p“Service is scheduled to begin\\nshortly.”$'}
text:LilycoveCity.HarborSign	{'body': 'LILYCOVE CITY HARBOR\\p“Enjoy a delightful cruise on\\nthe ferry S.S. TIDAL.”$'}
text:LilycoveCity.TrainerFanClubSign	{'body': 'POKéMON TRAINER FAN CLUB\\pThe names of TRAINERS are scribbled\\nall over the sign…$'}
text:LilycoveCity.DepartmentStoreSign	{'body': 'LILYCOVE DEPARTMENT STORE\\p“Overflowing with great merchandise\\nand excitement!\\p“A great place to find that something\\nyou need!”$'}
text:LilycoveCity.MoveDeletersHouseSign	{'body': "MOVE DELETER'S HOUSE\\p“Unwanted POKéMON moves deleted.”$"}
text:LilycoveCity.DoYouKnowAboutBerryBlender	{'body': 'Do you know about the machine\\nBERRY BLENDER?$'}
text:LilycoveCity.FasterSpinBetterPokeblocks	{'body': "People have to work together to get it\\nto spin faster.\\pThe faster you can make it spin, the\\nbetter {POKEBLOCK}S you can get, I've heard.$"}
text:LilycoveCity.ExplainBerryBlender	{'body': "It's used for making a kind of candy\\ncalled a {POKEBLOCK}.\\pIf you give a good {POKEBLOCK} to a POKéMON,\\nits condition will improve by a lot.$"}
text:LilycoveCity.HeardTowerCalledSkyPillar	{'body': "I heard there's a tower somewhere out\\non the sea routes.\\pIt's called the SKY PILLAR, I hear.$"}
text:LilycoveCity.SawTallTowerOnRoute131	{'body': 'I saw this tall tower somewhere\\naround ROUTE 131.\\pCould that possibly be…?$'}
text:LilycoveCity.JustArrivedAndSawRarePokemon	{'body': 'We just arrived here on our\\nhoneymoon vacation.\\pWe happened to see a DRAGON-type\\nPOKéMON flying way up in the sky.\\pDo cool POKéMON like that live in\\nthe HOENN region?$'}
text:LilycoveCity.HoneymoonVowToSeeRarePokemon	{'body': 'On our honeymoon, we vowed to see as\\nmany rare POKéMON as we can.\\pSo we were delighted to see a rare\\nPOKéMON as soon as we arrived.\\pI mean, we are totally happy!$'}
text:LilycoveCity_ContestHall.TodayWonSmartnessContest	{'body': 'This POKéMON won the BEAUTY CONTEST\\nhere before.\\pWell, guess what? Today, I made it\\nwin a SMARTNESS CONTEST!\\pMy abilities scare even me…$'}
text:LilycoveCity_ContestHall.EnteredBunchOfContests	{'body': "I've entered a bunch of CONTESTS,\\nso I'm seeing how things work.\\pIf you're in a COOLNESS CONTEST,\\ncool moves go over as appeals.\\pBut smart moves and cute moves\\ndon't go over well, for instance.$"}
text:LilycoveCity_ContestHall.ManWhoWonEarlierHadPokeblocks	{'body': 'That young man who won earlier had\\na whole bunch of different {POKEBLOCK}S.\\pCan you win if you had that many\\nof those things?$'}
text:LilycoveCity_ContestHall.IsntThisPlaceHumongous	{'body': "Whoa, isn't this place humongous!\\pThe tension in the air… It's not\\nlike a CONTEST hall in the sticks.$"}
text:LilycoveCity_ContestHall.GiveItBestSmartAppeal	{'body': "MC: Okay, SMART POKéMON and their\\nTRAINERS, are you ready?!\\pGive it your best showing!\\nLet's appeal!$"}
text:LilycoveCity_ContestHall.AreYouEnjoyingThisContest	{'body': 'JUDGE: Are you enjoying this CONTEST?\\pCome back with three friends, and\\nall of you may enter a CONTEST!$'}
text:LilycoveCity_ContestHall.EnteredWrongContest	{'body': 'Ayayayay…\\nI entered the wrong CONTEST.\\pI entered this tough POKéMON in\\nthe SMARTNESS CONTEST…\\pCome on, wow them with a smart-looking\\nROCK SMASH.$'}
text:LilycoveCity_ContestHall.RaisedMonToBeSmart	{'body': "I've spent many a year, and all my\\nwisdom besides, raising this POKéMON\\lto be smart.\\pIt won't be easily bested by some\\nyoung pup's POKéMON.\\pMy dear wife, are you seeing this?$"}
text:LilycoveCity_ContestHall.IfMonPullsSmartMoveNext	{'body': "There it is!\\pIf my POKéMON pulls a smart move next,\\nthe audience's excitement will peak!$"}
text:LilycoveCity_ContestHall.DontAppreciateCuteLeechLife	{'body': "Oh, dear, no!\\pMy darling ZUBAT's LEECH LIFE is so\\ncute I kept using it over and over!\\pBut these mean people don't appreciate\\nit at all!$"}
text:LilycoveCity_ContestHall.YoureBeautifulGrandpa	{'body': "Kiyaaah! You're beautiful, Grandpa!$"}
text:LilycoveCity_ContestHall.AllSeemToUseDifferentMoves	{'body': "Even when TRAINERS enter the same\\nkind of POKéMON, they all seem to use\\ldifferent moves for appeals.\\pIt's just like the way people have\\ndifferent styles for battling.$"}
text:LilycoveCity_ContestHall.PokemonSmarterThanTrainers	{'body': 'I think the POKéMON look smarter\\nthan their TRAINERS. By a lot.$'}
text:LilycoveCity_ContestHall.StillLoveSmartnessContests	{'body': "When all's said and done, I still love\\nSMARTNESS CONTESTS.\\pThat intellectual green color…\\nIt's so… So… Cool.$"}
text:LilycoveCity_ContestHall.AreYouEnteringBeautyContest	{'body': 'MC: Are you entering the BEAUTY\\nCONTEST, too? Good luck!$'}
text:LilycoveCity_ContestHall.EveryPokemonPristineBeauty	{'body': 'JUDGE: Ah, every POKéMON here is\\na model of pristine beauty!\\pWhy, I almost forgot to score them!$'}
text:LilycoveCity_ContestHall.EyesWillBeGluedToMyBeauty	{'body': "A POKéMON this beautiful…\\nThere isn't another one like it.\\pEveryone's eyes will be glued to\\nmy beauty.$"}
text:LilycoveCity_ContestHall.OverdidGrooming	{'body': "Waaaah!\\pI brushed and groomed my POKéMON\\ncarefully for this CONTEST…\\pBut I overdid it…\\nMy POKéMON's coat turned all scraggly…\\pWhat should I do?$"}
text:LilycoveCity_ContestHall.JudgeWontSeeAuroraBeam	{'body': "This AURORA BEAM is so dazzling,\\nthe JUDGE won't be able to see it.\\pUh, wait a second…\\nThat'll be meaningless, then!$"}
text:LilycoveCity_ContestHall.PokemonLooksLikeYoungerMe	{'body': 'This pretty POKéMON looks just like\\nme when I was younger.\\pRight when I said that, my husband\\nspewed the coffee he was drinking.\\pDid I say something funny?$'}
text:LilycoveCity_ContestHall.WinBeautyContestMakesMeHappy	{'body': 'You know, if I win at a BEAUTY\\nCONTEST, sure it makes me\\lhappy. More than usual, anyway.$'}
text:LilycoveCity_ContestHall.GanderAtAllThosePrettyPokemon	{'body': 'Wahahahah!\\pWill you take a gander at all those\\npretty POKéMON!\\lI just love this sort of glitz!$'}
text:LilycoveCity_ContestHall.CantWinOnBeautyAlone	{'body': "You can't always win on just beauty\\nalone.\\pYou have to groom your POKéMON so\\nit's nice and glossy like mine.$"}
text:LilycoveCity_ContestHall.InTheMiddleOfContest	{'body': "MC: Uh-oh! Hello!\\nWe're in the middle of a CONTEST!\\pPlease enter at our registration\\ncounter and come out, okay?$"}
text:LilycoveCity_ContestHall.SuchCharmingCuteAppeals	{'body': 'JUDGE: Oh, such charming and cute\\nappeals!\\pOh, my goodness! What a perfectly\\nadorable WATER SPORT appeal!$'}
text:LilycoveCity_ContestHall.MyAzurillWasDistracted	{'body': 'Oh, no… My sweet AZURILL was\\ndistracted by another POKéMON.$'}
text:LilycoveCity_ContestHall.NeverWonBattleButContest	{'body': 'My POKéMON has never won in a battle,\\nbut put it in a CONTEST and look out!$'}
text:LilycoveCity_ContestHall.PetalDanceIsMarvel	{'body': "My POKéMON's PETAL DANCE is a marvel\\nof elegance.\\pI won't let anyone disturb its\\nperformance.$"}
text:LilycoveCity_ContestHall.MyMonAppealSoMuchCuter	{'body': "Everyone's POKéMON are very cute.\\pHowever, if my POKéMON were to make\\na cute appeal…\\pI'm sure that it would be so much \\ncuter than the others.$"}
text:LilycoveCity_ContestHall.MyChildIsInContest	{'body': 'My child is in this CONTEST.$'}
text:LilycoveCity_ContestHall.ComeOnDear	{'body': 'Come on, dear. Go for it!\\nYour POKéMON is the best!$'}
text:LilycoveCity_ContestHall.ThatGirlThereIsCutest	{'body': "I think that girl over there is\\nthe cutest of the lot.\\pWhat's that? They're judging\\nPOKéMON by their looks?$"}
text:LilycoveCity_ContestHall.WantCuteMonOfMyOwn	{'body': "Ohh, seeing all these cute POKéMON\\nmakes me want to meet one of my\\lown!\\pI'm going to go look for a\\npartner!$"}
text:LilycoveCity_ContestHall.BeautyContestStage	{'body': 'BEAUTY CONTEST STAGE\\nBE ALLURED BY BEAUTIFUL POKéMON!$'}
text:LilycoveCity_ContestHall.CuteContestStage	{'body': 'CUTENESS CONTEST STAGE\\nBE CHARMED BY CUTE POKéMON!$'}
text:LilycoveCity_ContestHall.SmartContestStage	{'body': 'SMARTNESS CONTEST STAGE\\nBE IMPRESSED BY SMART POKéMON!$'}
text:LilycoveCity_ContestLobby.LadyGaveMePokeblockCase	{'body': 'Yippee!\\pThe lady at the reception counter\\ngave me a case for {POKEBLOCK}S!$'}
text:LilycoveCity_ContestLobby.MakePokeblocksDifferentBerries	{'body': 'Make {POKEBLOCK}S and put them in there.\\pWhen you make a {POKEBLOCK}, everyone\\nhas to put in a different BERRY.$'}
text:LilycoveCity_ContestLobby.YourPokemonSpurredMeToPaint	{'body': "Congratulations!\\pI did a painting of your POKéMON to\\ncommemorate its victory…\\pWell, your POKéMON's appeals were\\nso fantastic, it spurred me into\\lpainting better than I usually do.\\lLook, see?$"}
text:LilycoveCity_ContestLobby.ShouldITakePaintingToMuseum	{'body': "What do you think? I'm confident in\\nwhat I've done, but do you like it?\\pA work of this caliber, it wouldn't look\\nout of place in an art museum.\\pHuh? An art museum really is looking\\nfor paintings?\\pDo you think I should take this there?$"}
text:LilycoveCity_ContestLobby.IllTakePaintingToMuseum	{'body': "What, really? Then, sure, I will take\\nthis painting there right now.\\pI'll give it a proper title, too.\\pI hope they'll like it and consider\\nexhibiting this.\\pPlease check if they did accept this.\\nThank you!$"}
text:LilycoveCity_ContestLobby.TakeMementoOfPainting	{'body': "Oh, that's right!\\pAs a memento of me painting your\\nPOKéMON, please take this.$"}
text:LilycoveCity_ContestLobby.ReceivedARibbon	{'body': '{PLAYER} received a RIBBON.$'}
text:LilycoveCity_ContestLobby.PutTheRibbonOnMon	{'body': '{PLAYER} put the RIBBON on\\n{STR_VAR_1}.$'}
text:LilycoveCity_ContestLobby.OkaySeeYou	{'body': 'Okay, see you!$'}
text:LilycoveCity_ContestLobby.TakeHomeButIdLikeToTakeToMuseum	{'body': "Oh… Then, I guess I'll just take\\nthis home with me…\\pBut, you know, I would like to take\\nthis to the art museum… Okay?$"}
text:LilycoveCity_ContestLobby.FineThatsTheWayItIs	{'body': "Oh, fine, that's the way it is.\\nI will hang this in my own house.\\pI'll just have to try harder next time.\\nWell, be seeing you.$"}
text:LilycoveCity_ContestLobby.MasterRankHereICome	{'body': 'Hoo, boy… Master Rank CONTESTS,\\nhere I come.\\pThe world will know that my dearest\\nPOKéMON is the cutest being in all\\lexistence. The time has come!\\lUheheheh.$'}
text:LilycoveCity_ContestLobby.WholeVarietyOfPokemonHere	{'body': "You can see a whole variety of\\nPOKéMON here.\\pThat's why I make this place a regular\\npart of my daily stroll.$"}
text:LilycoveCity_ContestLobby.ContestFeastForEyes	{'body': 'Wow, coming out to a CONTEST is\\na feast for these eyes!\\pWould you look at all the POKéMON\\nthat just scream to be painted?$'}
text:LilycoveCity_ContestLobby.ToughContestIsExtreme	{'body': 'The TOUGHNESS CONTEST is like\\nextreme, man!\\pThose muscular appeals…\\nCascading sweat… I swoon!$'}
text:LilycoveCity_ContestLobby.LavishedCareOnMon	{'body': 'Day in and day out, I lavished my care\\non this POKéMON.\\pIts condition is peaking.\\nToday, victory is mine!$'}
text:LilycoveCity_ContestLobby.MadePokeblocksWithFamily	{'body': 'I made {POKEBLOCK}S with Mom, Dad, and\\nBig Sister. They turned out great!\\pI bet you can make smoother, better\\n{POKEBLOCK}S if you have more people.$'}
text:LilycoveCity_CoveLilyMotel_1F.GuestsDoubledByMascot	{'body': "Hm, so they doubled the guests by\\nusing POKéMON as attractions?\\pHm, well, maybe I should make a cute\\nPOKéMON our inn's mascot.\\pI wonder if that will attract more\\nguests to stay with us?$"}
text:LilycoveCity_CoveLilyMotel_1F.NoGuestsWithTeamAqua	{'body': 'Oh, sorry, sorry!\\nI was too involved in watching TV!\\pSince that TEAM AQUA came to town,\\nthe tourists have been staying away.$'}
text:LilycoveCity_CoveLilyMotel_1F.CantSeeTheTV	{'body': "Hey, down in front!\\nI can't see the TV!$"}
text:LilycoveCity_CoveLilyMotel_1F.MonFoundLostItem	{'body': "Amazing! You're telling me a POKéMON\\nfound someone's lost item?\\pThat's something. If we had some smart\\nPOKéMON like that…\\pWe could recover anything that our\\nguests mislaid…$"}
text:LilycoveCity_CoveLilyMotel_1F.HeardAquaHideoutBusted	{'body': 'Oh, sorry, sorry!\\nI was too involved in watching TV!\\pI heard that someone busted\\nthe TEAM AQUA HIDEOUT.\\pThanks to that, we just booked\\na reservation from a big group.\\pIt was a company called… Uh…\\nGAME something…$'}
text:LilycoveCity_CoveLilyMotel_1F.HouseSittingMonCaughtBurglar	{'body': "Amazing! A house-sitting POKéMON\\ncaught a burglar?\\pThat's something. If we had a tough\\nPOKéMON as a security guard…\\pWe would be able to provide our guests\\nwith greater safety.$"}
text:LilycoveCity_CoveLilyMotel_1F.BetterGetWorkingOnGuestsDinner	{'body': "Oh, sorry, sorry!\\nI was too involved in watching TV.\\pOh, yes. A big group of guests arrived\\na little while ago.\\pThey booked in as GAME FREAK,\\nso I guess they must make games.\\pUh-oh, I'd better get working on\\ntheir dinner!$"}
text:LilycoveCity_CoveLilyMotel_2F.ShowMeCompletedDex	{'body': "I'm the GAME DESIGNER.\\pOh, is that right?\\nYou're working on a POKéDEX?\\pIt's tough trying to complete it,\\nbut don't give up.\\pIf you do complete it, please come\\nshow me.$"}
text:LilycoveCity_CoveLilyMotel_2F.BuffelChallenge	{'body': 'I helped design battles where\\nevery role hands momentum to the\\lnext.\\pWant to test one of my favorite\\nteams?$'}
text:LilycoveCity_CoveLilyMotel_2F.BuffelDefeat	{'body': "You've given me something to think on!$"}
text:LilycoveCity_CoveLilyMotel_2F.BuffelAfter	{'body': 'The best battle is difficult, readable,\\nand different from the one before it.$'}
text:LilycoveCity_CoveLilyMotel_2F.BuffelDecline	{'body': "Return when you want a designer's test.$"}
text:LilycoveCity_CoveLilyMotel_2F.FilledPokedexGiveYouThis	{'body': "Wow! That's awesome!\\nYep, it's totally awesome!\\pThis POKéDEX is completely filled!\\nYou really must love POKéMON!\\pI'm so impressed!\\pLet me give you something in\\nrecognition of your feat!$"}
text:LilycoveCity_CoveLilyMotel_2F.ImTheProgrammer	{'body': "Me? You're talking to me?\\nI'm the PROGRAMMER.\\pI wonder what the SLOTS are\\nlike here.$"}
text:LilycoveCity_CoveLilyMotel_2F.ImTheGraphicArtist	{'body': "I'm the GRAPHIC ARTIST! Aren't the\\nPOKéMON of HOENN interesting?$"}
text:LilycoveCity_CoveLilyMotel_2F.GirlsAreCute	{'body': "I love watching young TRAINERS\\ndiscover what their POKéMON can\\ldo.\\pA pair of TWINS surprised me with\\ntheir teamwork. They'd practiced\\ltogether for ages!\\pWhoop! That's the joy of battling!$"}
text:LilycoveCity_CoveLilyMotel_2F.SeaBreezeTicklesHeart	{'body': 'The sea breeze tickles my heart.\\nIt feels wonderful here!$'}
text:LilycoveCity_CoveLilyMotel_2F.NeverLeaveWithoutGameBoy	{'body': "You never know when and where\\npeople will challenge you.\\pThat's why I never leave home without\\nmy GAME BOY ADVANCE.$"}
text:LilycoveCity_CoveLilyMotel_2F.SnoozingPreferBattles	{'body': "SCOTT: … … … … …\\n… … … … … Zzz…\\p… … … … … Huh?!\\nOh, sorry, sorry! I was snoozing!\\pI came to check out this POKéMON\\nCONTEST thing.\\pI have to admit, it does look quite\\nentertaining, but…\\pConsider me a purist--I prefer\\nbattles and tough TRAINERS.\\pBut that's just me.\\p{PLAYER}{KUN}, I hope you'll enjoy everything\\nlike the GYMS, CONTESTS, BATTLE TENT,\\lthe whole works!$"}
text:LilycoveCity_CoveLilyMotel_2F.ContestsDoTakeStrategy	{'body': "SCOTT: I think it does take strategy\\nto win a CONTEST.\\pDevising CONTEST strategies is one way\\nof becoming a better TRAINER, I'd say.$"}
text:LilycoveCity_DepartmentStoreRooftop.SetDatesForClearOutSales	{'body': "Don't they have set dates for their\\nclear-out sales?\\pI watch TV, but they never show any\\ncommercials.$"}
text:LilycoveCity_DepartmentStoreRooftop.BeenWaitingForClearOutSale	{'body': "Yes! I've been waiting a long time for\\nthis clear-out sale.\\pThey have unusual decorations today.\\nI'm going to load up, that I am!$"}
text:LilycoveCity_DepartmentStoreRooftop.BoneDryThirsty	{'body': "Ohh… I'm bone-dry thirsty!$"}
text:LilycoveCity_DepartmentStoreRooftop.WhichDrinkWouldYouLike	{'body': "It's a VENDING MACHINE.\\nWhich drink would you like?$"}
text:LilycoveCity_DepartmentStoreRooftop.CanOfDrinkDroppedDown	{'body': 'Clang!\\pA can of {STR_VAR_1} dropped down.$'}
text:LilycoveCity_DepartmentStoreRooftop.ExtraCanOfDrinkDroppedDown	{'body': 'Clang!\\pScore! An extra can of {STR_VAR_1}\\ndropped down!$'}
text:LilycoveCity_DepartmentStoreRooftop.NotEnoughMoney	{'body': 'Not enough money…$'}
text:LilycoveCity_DepartmentStoreRooftop.DecidedAgainstBuyingDrink	{'body': 'Decided against buying a drink.$'}
text:LilycoveCity_DepartmentStore_1F.WelcomeToDeptStore	{'body': 'Welcome to LILYCOVE DEPARTMENT STORE.$'}
text:LilycoveCity_DepartmentStore_1F.IBuyAllSortsOfThings	{'body': "Whenever I come to the DEPARTMENT\\nSTORE, I always end up buying all sorts\\lof things because it's so fun.$"}
text:LilycoveCity_DepartmentStore_1F.MomBuyingMeFurniture	{'body': 'Today, my mom is going to buy me some\\nnice furniture.$'}
text:LilycoveCity_DepartmentStore_1F.BuyingSomethingForAzumarill	{'body': "I'm buying something for my AZUMARILL\\nas a reward for winning a CONTEST.$"}
text:LilycoveCity_DepartmentStore_1F.Azumarill	{'body': 'AZUMARILL: Maririroo!$'}
text:LilycoveCity_DepartmentStore_1F.FloorNamesSign	{'body': "1F: SERVICE COUNTER\\n    LOTTERY CORNER\\p2F: TRAINER'S ZONE\\p3F: BATTLE COLLECTION\\p4F: EVOLUTION DEPARTMENT\\p5F: POKé DOLL FLOOR\\pROOFTOP: ROOFTOP PLAZA$"}
text:LilycoveCity_DepartmentStore_1F.WirelessCommIsFun	{'body': "Wireless Communication is a\\nlot of fun, isn't it?\\pI think it lets you do things that\\nweren't possible before.\\pFor instance, you can now trade\\nwith people you couldn't before.\\pI think it's going to be exciting!$"}
text:LilycoveCity_DepartmentStore_1F.SpreadWordAboutWirelessComm	{'body': 'I want to spread the word about how\\nfun Wireless Communication can be.$'}
text:LilycoveCity_DepartmentStore_2F.LearnToUseItemsProperly	{'body': "Learn to use items properly.\\nThat's basic, really.$"}
text:LilycoveCity_DepartmentStore_2F.GoodGiftForHusband	{'body': 'My husband is waiting at home.\\nWhat would make a good gift for him?$'}
text:LilycoveCity_DepartmentStore_2F.StockUpOnItems	{'body': "I'm leaving on a long journey soon.\\nI need to stock up on items.$"}
text:LilycoveCity_DepartmentStore_3F.RightBallBuildsTeamsFast	{'body': 'For building a new team quickly,\\nthe right kind of BALL is best.\\pQUICK BALLS reward a fast throw,\\nwhile DUSK BALLS shine in caves.$'}
text:LilycoveCity_DepartmentStore_3F.TimerBallsRewardPatience	{'body': 'Some rare POKéMON take patience.\\pA TIMER BALL grows stronger as the\\nbattle lasts, so I always carry a few.$'}
text:LilycoveCity_DepartmentStore_3F.QuickBallFirstTurnCatch	{'body': 'I caught a new partner with a\\nQUICK BALL on the very first turn!$'}
text:LilycoveCity_DepartmentStore_4F.Stones	{'body': 'Every evolution stone, ¥3000 each!\\nWhich one does your partner need?$'}
text:LilycoveCity_DepartmentStore_4F.Tools	{'body': 'Special evolution tools cost ¥5000.\\nReusable devices cost ¥10000.\\pA reusable device only needs to be\\nbought once. Check its description!$'}
text:LilycoveCity_DepartmentStore_4F.Gentleman	{'body': "The left counter sells stones.\\nThe right has the unusual tools.\\pEven the LINKING CORD! It's reusable,\\nso my whole team can share it.$"}
text:LilycoveCity_DepartmentStore_4F.Woman	{'body': 'I found an evolution item on my travels.\\nThat saved me a shopping trip!$'}
text:LilycoveCity_DepartmentStore_4F.Youngster	{'body': "Evolving opens up new moves and roles.\\nI'll visit the free CENTER tutor next!$"}
text:LilycoveCity_DepartmentStore_5F.PlaceFullOfCuteDolls	{'body': 'This place is full of cute DOLLS.\\pI should buy some for me, instead of\\njust for my children.$'}
text:LilycoveCity_DepartmentStore_5F.GettingDollInsteadOfPokemon	{'body': "I'm not big enough to raise POKéMON,\\nso I'm getting a cute DOLL instead.$"}
text:LilycoveCity_DepartmentStore_5F.SellManyCuteMatsHere	{'body': "They sell many cute MATS here.\\pI wonder which one I should get?\\nMaybe I'll buy them all…$"}
text:LilycoveCity_DepartmentStore_5F.ClosedRooftopForWeather	{'body': 'I think they closed the rooftop\\nbecause the weather is wild today.$'}
text:LilycoveCity_Harbor.FerryUnavailable	{'body': 'The ferry opens to TRAINERS with\\nsix BADGES. Come back with the\\lFEATHER BADGE!$'}
text:LilycoveCity_Harbor.MayISeeYourTicket	{'body': 'Hello, are you here for the ferry?\\nMay I confirm your ferry pass?$'}
text:LilycoveCity_Harbor.NoTicket	{'body': "You'll need a ferry pass. With\\nsix BADGES, speak to the sailor\\lhere in LILYCOVE HARBOR. He can\\lregister yours.$"}
text:LilycoveCity_Harbor.ConfirmedPassWhereTo	{'body': "The attendant confirmed your ferry\\npass.\\pPerfect! That's all you need!\\pAnd where would you like to go?$"}
text:LilycoveCity_Harbor.SailAnotherTime	{'body': 'Please sail with us another time!$'}
text:LilycoveCity_Harbor.SlateportItIs	{'body': 'SLATEPORT CITY it is, then!$'}
text:LilycoveCity_Harbor.BattleFrontierItIs	{'body': 'BATTLE FRONTIER it is, then!$'}
text:LilycoveCity_Harbor.PleaseBoard	{'body': 'Please board the ferry and wait for\\ndeparture.$'}
text:LilycoveCity_Harbor.WhereWouldYouLikeToGo	{'body': 'Then, where would you like to go?$'}
text:LilycoveCity_Harbor.SailorFerryUnavailable	{'body': "STERN is preparing exploration\\ntrips. Come back with the FEATHER\\lBADGE and I'll have your passes\\lready.$"}
text:LilycoveCity_Harbor.SailorFerryAvailable	{'body': 'Six badges! STERN and DEVON have\\napproved your exploration trips.\\pHere are passes for the ferry,\\nSOUTHERN ISLAND, NAVEL ROCK,\\lBIRTH ISLAND and FARAWAY ISLAND.\\pThe BATTLE FRONTIER is open too.\\nIts CIRCUIT awards legendary\\lPOKéMON as your total wins grow.$'}
text:LilycoveCity_Harbor.ChampionPassesReady	{'body': 'Your island routes are active.\\nShow the attendant a pass to\\lchoose a destination.\\pExplore for LATIAS or LATIOS,\\nLUGIA, HO-OH, DEOXYS and MEW. You\\lcan meet them during your GYM\\ljourney.$'}
text:LilycoveCity_Harbor.ChampionPassesBagFull	{'body': 'Your BAG cannot hold the next\\npass. Make room and speak to me\\lagain.$'}
text:LilycoveCity_Harbor.LatiReport	{'body': "I've received two sightings: red\\nLATIAS and blue LATIOS!\\pOne will travel HOENN's routes.\\nThe other waits on SOUTHERN\\lISLAND.\\pWhich mainland lead shall we\\nfollow: red or blue?$"}
text:LilycoveCity_Harbor.LatiReportReady	{'body': 'Red is LATIAS; blue is LATIOS.\\pWatch the routes for your choice,\\nand sail to meet the other!$'}
text:LilycoveCity_House1.PokemonPartnersNotTools	{'body': "POKéMON are partners to people.\\nThey aren't our tools.\\pUnfortunately, there are some people\\nwho fail to understand that…$"}
text:LilycoveCity_House1.Kecleon	{'body': 'KECLEON: Ruroro?$'}
text:LilycoveCity_House2.NotAwakeYetHaveThis	{'body': 'Huh? What? Oh, a visitor…\\pI was admiring this MOON STONE and\\ndrifted off. You can have it…\\lYawn…$'}
text:LilycoveCity_House2.SleepIsEssential	{'body': 'Yawn… A MOON STONE can help\\ncertain POKéMON evolve…\\pMe? A little more sleep will do\\nnicely…$'}
text:LilycoveCity_House3.LearnFromMasterOfPokeblocks	{'body': "Oh, my, my! Are you traveling alone?\\nBut you're so young! Good for you!\\pI'm sure my kids could learn a thing\\nor two from you!\\pMe? I'm a master of {POKEBLOCK}S.\\pIf I get serious just a little, why,\\nI can concoct great {POKEBLOCK}S.\\pWould you like to learn from me,\\na master of {POKEBLOCK}S?$"}
text:LilycoveCity_House3.OhAreYouSure	{'body': "Oh? Are you sure?\\pYou shouldn't always try to do\\neverything by yourself, dear!$"}
text:LilycoveCity_House3.ExplainPokeblocks	{'body': "Oh, good! You're a smart soul!\\nThis is a bit long, so listen up!\\pAre you ready?\\pIf you look at {POKEBLOCK}S, you should see\\nthat they are rated on how they feel.\\pThe lower the feel rating,\\nthe better it is. Don't forget this!\\pA good {POKEBLOCK} has a low feel\\nrating and a high level.\\pA POKéMON can eat more good\\n{POKEBLOCK}S than ordinary ones, too.\\pAnd this is important.\\pIf you want to make smooth {POKEBLOCK}S,\\nuse different kinds of BERRIES.\\pDon't be stingy--the kinds of BERRIES\\naffect the smoothness of {POKEBLOCK}S.\\pAnd another thing.\\pThe more people blending BERRIES,\\nthe smoother the {POKEBLOCK}S.\\pThat's why you should talk to other\\npeople and make {POKEBLOCK}S together.\\pThat's about all you need to know to\\nmake good {POKEBLOCK}S.\\pIf everyone had POKéMON they love,\\nsmooth {POKEBLOCK}S, and a loving family,\\lthe world would be a happier place.\\pDon't give up, dear!$"}
text:LilycoveCity_House3.HappyToHaveQuadruplets	{'body': 'When my wife gave birth to quadruplets,\\nyou bet I was shocked.\\pBut, now, seeing them play together,\\nit makes me happy.$'}
text:LilycoveCity_House3.GoingToWinMultiBattles	{'body': "We're having MULTI BATTLES, but I know\\nI'm going to win.$"}
text:LilycoveCity_House3.LikeMixingAtRecordCorner	{'body': 'We like mixing stuff at\\nthe RECORD CORNER.\\pBut what gets mixed up?$'}
text:LilycoveCity_House3.MakePokeblocksWithBerryBlender	{'body': "We're going to make super {POKEBLOCK}S\\nwith a BERRY BLENDER!$"}
text:LilycoveCity_House3.GoingToEnterContest	{'body': "I want to brag about how tough my\\nPOKéMON is, so we're going to enter\\la CONTEST together.$"}
text:LilycoveCity_House4.MysteriesAtBottomOfSea	{'body': "This planet's biggest mysteries are\\nat the bottom of the sea.\\pSomebody said that, but I don't know…$"}
text:LilycoveCity_House4.UnderwaterTrenchMossdeepSootopolis	{'body': "There's a deep underwater trench\\nbetween MOSSDEEP and SOOTOPOLIS.\\pThat's what someone told me, anyway.$"}
text:LilycoveCity_House4.MegaGift_LAPRASITE_Text	{'body': 'A Lapras once carried my family\\nhome through a terrible storm.\\pI kept this stone in gratitude.\\nPlease find a Lapras to give it to.$'}
text:LilycoveCity_House4.MegaGift_STARMINITE_Text	{'body': 'The sea leaves more than shells\\non our shore after a storm.\\pThis stone shines like a Starmie.\\nLet one carry it beneath the stars.$'}
text:LilycoveCity_LilycoveMuseum_1F.WelcomeToLilycoveMuseum	{'body': 'Welcome to LILYCOVE MUSEUM.\\pPlease take the time to enjoy our\\ncollection of fantastic artwork\\lfeaturing POKéMON.$'}
text:LilycoveCity_LilycoveMuseum_1F.ImCuratorHaveYouViewedOurPaintings	{'body': "I'm the CURATOR of this MUSEUM of\\nfine arts.\\pIt's heartening to see someone so\\nyoung as you in our MUSEUM.\\pHave you viewed our collection of\\npaintings already?$"}
text:LilycoveCity_LilycoveMuseum_1F.NotDisturbYouTakeYourTime	{'body': 'Ah, then let me not disturb you.\\nPlease, do take your time.$'}
text:LilycoveCity_LilycoveMuseum_1F.HaveYouAnInterestInPaintings	{'body': 'Oh? I do believe that you seem to\\nbe a POKéMON TRAINER.\\pHave you an interest in paintings,\\ntoo?$'}
text:LilycoveCity_LilycoveMuseum_1F.HonoredYoudVisitInSpiteOfThat	{'body': "I see…\\pI'm honored that you would visit\\nus in spite of that.$"}
text:LilycoveCity_LilycoveMuseum_1F.ExcellentCanYouComeWithMe	{'body': 'Ah, excellent!\\nYou do like paintings!\\pThen, may I ask you to come with me?$'}
text:LilycoveCity_LilycoveMuseum_1F.VeryOldPainting	{'body': "It's a very old painting.\\nThe paint is peeling here and there.$"}
text:LilycoveCity_LilycoveMuseum_1F.OddLandscapeFantasticScenery	{'body': "It's an odd landscape with bizarre\\nand fantastic scenery.$"}
text:LilycoveCity_LilycoveMuseum_1F.PaintingOfBeautifulWoman	{'body': "It's a painting of a beautiful, smiling\\nwoman with a POKéMON on her lap.$"}
text:LilycoveCity_LilycoveMuseum_1F.PaintingOfLegendaryPokemon	{'body': "It's a painting of a legendary POKéMON\\nfrom long ago.\\pThe artist painted this from\\nimagination.$"}
text:LilycoveCity_LilycoveMuseum_1F.PaintingOfGrassPokemon	{'body': "It's a painting of GRASS POKéMON\\nswaying in a breeze.\\pThey appear to be enjoying the wind's\\ngentle caress.$"}
text:LilycoveCity_LilycoveMuseum_1F.PaintingOfBerries	{'body': "It's a delicious-looking painting\\nof BERRIES.\\pThis painting could make you hungry!$"}
text:LilycoveCity_LilycoveMuseum_BirdPokemonSculptureReplica	{'body': "It's a replica of a famous sculpture.\\pIt depicts an ancient BIRD POKéMON.$"}
text:LilycoveCity_LilycoveMuseum_1F.BigPokeBallCarvedFromStone	{'body': "It's a big POKé BALL carved from\\na black stone.\\pIt was apparently used in festivals\\nin the olden days.$"}
text:LilycoveCity_LilycoveMuseum_1F.StoneTabletWithAncientText	{'body': "It's a huge stone tablet inscribed\\nwith POKéMON and dense text in the\\lsmall characters of an ancient,\\lunreadable language.$"}
text:LilycoveCity_LilycoveMuseum_1F.WorksOfMagnificence	{'body': 'Hmmm…\\nWhat works of great magnificence…$'}
text:LilycoveCity_LilycoveMuseum_1F.MustntForgetLoveForFineArts	{'body': "Battling with POKéMON is fun,\\nI'll grant you that.\\pBut one mustn't forget our love for\\nthe fine arts.$"}
text:LilycoveCity_LilycoveMuseum_1F.ThisMuseumIsInspiration	{'body': 'This ART MUSEUM… Well, you could\\nsee many fantastic paintings.\\pAnd the CURATOR is a wonderful person.\\pAmong artists like myself, this MUSEUM\\nis an inspiration.$'}
text:LilycoveCity_LilycoveMuseum_1F.ThisLadyIsPretty	{'body': "This lady is pretty!\\nShe's like Mommy!$"}
text:LilycoveCity_LilycoveMuseum_1F.ThisPokemonIsAdorable	{'body': 'This POKéMON is adorable!\\nJust like our little boy!$'}
text:LilycoveCity_LilycoveMuseum_1F.HeardMuseumGotNewPaintings	{'body': "I'd heard that this ART MUSEUM got\\nin some new paintings.\\pSo, naturally I hurried over.\\pAre the new paintings up on\\nthe second floor?$"}
text:LilycoveCity_LilycoveMuseum_1F.CuratorHasBeenCheerful	{'body': 'Lately, the CURATOR has been\\nunusually cheerful.\\pI bet something good happened for him.\\nDefinitely.$'}
text:LilycoveCity_LilycoveMuseum_1F.AimToSeeGreatPaintings	{'body': 'I aim to see many great paintings\\nhere and learn from them.\\pI have this dream of one day having\\nmy artwork exhibited here.$'}
text:LilycoveCity_LilycoveMuseum_1F.MuseumTouristDestination	{'body': "The ART MUSEUM has become a favorite\\ntourist destination.\\pIt's great for LILYCOVE…\\nNo, great for the HOENN region!\\pThis is what I've heard--a lone TRAINER\\nprocured all the paintings upstairs.$"}
text:LilycoveCity_LilycoveMuseum_2F.ThisIsExhibitHall	{'body': 'This is our special exhibit hall.$'}
text:LilycoveCity_LilycoveMuseum_2F.ExplainExhibitHall	{'body': "As you can plainly see, there is not\\na single painting on exhibit.\\pHere, I don't wish to exhibit works of\\nso-called classical art.\\pSuch classical works you can see on\\nour ground floor.\\pI wish to exhibit work that is far\\ndifferent from the classics.\\pArt, after all, is not restricted to old,\\nfamous works!\\pThis exhibit hall, I wish to fill it with…\\pModern and vibrant artworks of\\nPOKéMON seemingly ready to spring\\lforth into glorious life!$"}
text:LilycoveCity_LilycoveMuseum_2F.PleaseObtainPaintingsForExhibit	{'body': "I beg your pardon. I didn't intend\\nto monopolize the conversation.\\pNow, as you are young, and yet\\nobviously well traveled…\\pYou must encounter lively POKéMON\\nand works of art depicting them.\\pIf you were to come across such\\na painting, may we ask you to obtain\\lthe artist's permission to exhibit\\lit here?$"}
text:LilycoveCity_LilycoveMuseum_2F.WishToFillExhibit	{'body': 'I wish to fill this exhibit hall with\\nmodern and vibrant paintings of\\lPOKéMON.$'}
text:LilycoveCity_LilycoveMuseum_2F.ThanksAddedNewPainting	{'body': "Thanks to you, we've added a new\\npainting to our collection!\\pI've heard it depicts your POKéMON.\\nTruly magnificent!\\pThank you so very, very much!$"}
text:LilycoveCity_LilycoveMuseum_2F.ItsYouPlayer	{'body': "Ah! It's you!\\n{PLAYER}!$"}
text:LilycoveCity_LilycoveMuseum_2F.PaintingsAttractedMoreGuests	{'body': "Isn't this marvelous?\\nThis collection of paintings!\\pEach one of them flawless!\\nNone better than another!\\pThese paintings have attracted\\nmore guests to our ART MUSEUM.\\pSincerely, I thank you, {PLAYER}.\\nThis is my dream come true!$"}
text:LilycoveCity_LilycoveMuseum_2F.TokenOfGratitude	{'body': 'This is merely a token of my gratitude.$'}
text:LilycoveCity_LilycoveMuseum_2F.KeepThisForYou	{'body': 'I will keep this for you until we\\nmeet again.$'}
text:LilycoveCity_LilycoveMuseum_2F.HonorToHaveYouVisit	{'body': "Ah, so good to see you, {PLAYER}!\\pIt's an honor to have you visit us\\non your busy journeys.\\pPlease, relax and do enjoy your\\nvisit with us.$"}
text:LilycoveCity_LilycoveMuseum_2F.ItsPinkPictureFrame	{'body': "It's a picture frame with pink-colored\\nadornments.$"}
text:LilycoveCity_LilycoveMuseum_2F.ItsYellowPictureFrame	{'body': "It's a picture frame with\\nyellow-colored adornments.$"}
text:LilycoveCity_LilycoveMuseum_2F.ItsBluePictureFrame	{'body': "It's a picture frame with\\nblue-colored adornments.$"}
text:LilycoveCity_LilycoveMuseum_2F.ItsRedPictureFrame	{'body': "It's a picture frame with\\nred-colored adornments.$"}
text:LilycoveCity_LilycoveMuseum_2F.ItsGreenPictureFrame	{'body': "It's a picture frame with\\ngreen-colored adornments.$"}
text:LilycoveCity_LilycoveMuseum_2F.ItsPaintingOfPokemon	{'body': "It's a painting of POKéMON.$"}
text:LilycoveCity_LilycoveMuseum_2F.NewPaintingsSurprisedMe	{'body': "I've been away awhile, so the new\\npaintings up here surprised me.\\pI wish someone would paint my POKéMON\\nthis pretty.$"}
text:LilycoveCity_LilycoveMuseum_2F.NewPaintingsRatherAmusing	{'body': 'Well… So this is where they show\\nthe topical POKéMON paintings.\\pI see, these new paintings are indeed\\nrather amusing.$'}
text:LilycoveCity_LilycoveMuseum_2F.ThesePaintingsOfYourPokemon	{'body': "Wow, is that right?\\nThese paintings are of your POKéMON.\\pIsn't that just the ultimate joy for\\na TRAINER?$"}
text:LilycoveCity_MoveDeletersHouse.ICanMakeMonForgetMove	{'body': "Uh…\\nOh, yes, I'm the MOVE DELETER.\\pI can make POKéMON forget their moves.\\pWould you like me to do that?$"}
text:LilycoveCity_MoveDeletersHouse.WhichMonShouldForget	{'body': 'Which POKéMON should forget a move?$'}
text:LilycoveCity_MoveDeletersHouse.WhichMoveShouldBeForgotten	{'body': 'Which move should be forgotten?$'}
text:LilycoveCity_MoveDeletersHouse.MonOnlyKnowsOneMove	{'body': "{STR_VAR_1} knows only one move\\nso it can't be forgotten…$"}
text:LilycoveCity_MoveDeletersHouse.MonsMoveShouldBeForgotten	{'body': "Hm! {STR_VAR_1}'s {STR_VAR_2}?\\nThat move should be forgotten?$"}
text:LilycoveCity_MoveDeletersHouse.MonHasForgottenMove	{'body': 'It worked to perfection!\\p{STR_VAR_1} has forgotten\\n{STR_VAR_2} completely.$'}
text:LilycoveCity_MoveDeletersHouse.ComeAgain	{'body': 'Come again if there are moves that\\nneed to be forgotten.$'}
text:LilycoveCity_MoveDeletersHouse.EggCantForgetMoves	{'body': 'What?\\nNo EGG should know any moves.$'}
text:LilycoveCity_MoveDeletersHouse.CantForgetSurf	{'body': "Hm!\\pYour {STR_VAR_1} doesn't seem willing\\nto forget SURF.$"}
text:LilycoveCity_PokemonCenter_1F.HowManyKindsOfPokemon	{'body': "I wonder how many kinds of POKéMON\\nthere are in the world.\\pIt'd be great to cross seas and\\ntrade POKéMON with people far away.$"}
text:LilycoveCity_PokemonCenter_1F.HeardAboutRottenScoundrels	{'body': "I've been hearing about some rotten\\nscoundrels who steal POKéMON and rip\\loff METEORITES.$"}
text:LilycoveCity_PokemonCenter_1F.HaventSeenRottenScoundrels	{'body': "Those rotten scoundrels who steal\\nPOKéMON and rip off METEORITES…\\pI haven't seen them around recently.$"}
text:LilycoveCity_PokemonTrainerFanClub.OhWowItsPlayer	{'body': "Oh, wow!\\nIt's {PLAYER}!$"}
text:LilycoveCity_PokemonTrainerFanClub.HeardAboutYouImYourFan	{'body': "I've heard the news!\\nYou're really strong, aren't you?\\pWe always argue about who is the\\nstrongest of all TRAINERS here.\\pSo when I heard about you, I decided\\nto be your fan!\\pI hope you'll keep on battling other\\ntough TRAINERS.\\pThat way, we'll be able to see more\\nof your hot, hot battles.\\pThat will make the others here see\\nexactly how great you are.\\pRemember, I'm cheering for you,\\n{PLAYER}!$"}
text:LilycoveCity_PokemonTrainerFanClub.YoureOneWeWantToWin	{'body': "Yo, {PLAYER}!\\nYou're the one we want to win!$"}
text:LilycoveCity_PokemonTrainerFanClub.OthersDontKnowYoureTheBest	{'body': "The others, they don't know that\\nyou're the best of the best!\\pIsn't that right, {PLAYER}?\\nShow them you've got guts!$"}
text:LilycoveCity_PokemonTrainerFanClub.TrainersPowerIsOutOfTheOrdinary	{'body': "I hate to say this, but the TRAINER\\neverybody's talking about is\\l{STR_VAR_1}, no question about it!\\pThat TRAINER's power…\\nIt's out of the ordinary.$"}
text:LilycoveCity_PokemonTrainerFanClub.TrainerIsBestNoOneWantsToListen	{'body': "Darn it… I've been telling people\\nthat {STR_VAR_1} is the best now…\\pBut no one wants to listen…$"}
text:LilycoveCity_PokemonTrainerFanClub.HearingAboutToughNewTrainer	{'body': "I've been hearing things about\\na tough new TRAINER.\\pThis TRAINER's supposed to be beating\\nGYM LEADERS, even.\\pDo you know anything about this\\nnew TRAINER?$"}
text:LilycoveCity_PokemonTrainerFanClub.ImPullingForYou	{'body': "Oh!\\n{PLAYER}!\\pGo for it!\\nI'm pulling for you!$"}
text:LilycoveCity_PokemonTrainerFanClub.BrawlyNoImYourFan	{'body': "Sigh…\\nBRAWLY…\\pOh, no! Wait!\\nThat's not right! No, no, no!\\pI'm your fan through and through!\\pSo make me proud!\\nGo for it!$"}
text:LilycoveCity_PokemonTrainerFanClub.ICantHelpLikingBrawly	{'body': "I can't help it, I can only get to\\nlike BRAWLY…$"}
text:LilycoveCity_PokemonTrainerFanClub.NobodyUnderstandsBrawly	{'body': "Nobody understands the charm of\\nBRAWLY…\\pI don't care!\\pEven if I'm the only one, I'm going\\nto keep cheering for BRAWLY!$"}
text:LilycoveCity_PokemonTrainerFanClub.MyFavoriteTrainerIsBrawly	{'body': "Whatever anyone says, my favorite\\nTRAINER is DEWFORD's GYM LEADER\\lBRAWLY!$"}
text:LilycoveCity_PokemonTrainerFanClub.YouveSurpassedYourFather	{'body': "You've surpassed your own father in\\nevery regard!\\pI'm telling you, so there's no question\\nabout it at all!$"}
text:LilycoveCity_PokemonTrainerFanClub.YourFatherNeverGaveUpSoKeepOnBattling	{'body': 'Even when things turned bleak,\\nyour father never gave up.\\pThis I know to be true.\\pYou never give up even if you lose!\\nSo keep on battling!$'}
text:LilycoveCity_PokemonTrainerFanClub.LongWayToGoComparedToNorman	{'body': "NORMAN battled with more power,\\ncharisma, and showmanship than you.\\pEven though people may say that\\nyou're strong…\\pYou've still got a long way to go\\ncompared to your father.$"}
text:LilycoveCity_PokemonTrainerFanClub.YouAndNormanAreDifferent	{'body': "You're beginning to get the same\\nair of awe NORMAN exudes.\\pBut there's something conclusively\\ndifferent between you and NORMAN.\\pI can't tell you what that is.\\nYou'll have to find it yourself.$"}
text:LilycoveCity_PokemonTrainerFanClub.WeDiscussStrongestTrainers	{'body': "Everyone here, we're all huge fans\\nof POKéMON battles.\\pWe discuss who we consider to be\\nthe strongest of all TRAINERS.\\pIf you were to become famous,\\nwe might even become your fans!$"}
text:LilycoveCity_PokemonTrainerFanClub.OhWoweeItsPlayer	{'body': "Oh, woweee! It's {PLAYER}!\\nFor real, too!\\pPlease, shake my hand, shake my hand!$"}
text:LilycoveCity_PokemonTrainerFanClub.AlwaysCheerForYou	{'body': "I'll always cheer for you, {PLAYER}!\\nAlways, always!\\pI don't want to see you lose ever,\\n{PLAYER}.\\pBecause I know you're really,\\nreally strong, {PLAYER}!$"}
text:LilycoveCity_PokemonTrainerFanClub.EveryoneThinksTrainerIsCool	{'body': '{STR_VAR_1} is really cool…\\pEveryone thinks so, right, right?$'}
text:LilycoveCity_PokemonTrainerFanClub.TrainerIsReallyCoolItsJustMe	{'body': "{STR_VAR_1} really is cool, don't\\nyou think so?\\pEven if it's just me, I'm going to keep\\ncheering my favorite TRAINER.$"}
text:LilycoveCity_PokemonTrainerFanClub.WishThereWasTrainerLikeThat	{'body': 'My favorite TRAINER is…\\pCool…\\pStrong…\\pAnd really nice…\\pI wish there was a TRAINER like that…$'}
text:LilycoveCity_PokemonTrainerFanClub.WantToBeStrongLikeYou	{'body': "Whoa! It's {PLAYER}!\\nWicked!\\pWhen I grow up, I want to be strong\\nlike you, {PLAYER}!$"}
text:LilycoveCity_PokemonTrainerFanClub.OnlyOneWhoCheersForYou	{'body': "Even if I'm the only one…\\pYou'll always be the only one\\nI cheer for, {PLAYER}!\\pBecause I believe in you, {PLAYER}!$"}
text:LilycoveCity_PokemonTrainerFanClub.TrainerIsWickedlyCool	{'body': '{STR_VAR_1} is so wickedly cool…\\nI want to shake hands with my hero.$'}
text:LilycoveCity_PokemonTrainerFanClub.NeverGoingToStopBeingTrainersFan	{'body': "Even if I'm the only one…\\pI'm never going to stop being\\n{STR_VAR_1}'s fan!\\pBecause I've heard, {STR_VAR_1}\\nnever loses!$"}
text:LilycoveCity_PokemonTrainerFanClub.YoureAmazingAfterAll	{'body': "{PLAYER}!\\nYou are amazing after all!\\pEver since I set eyes on you,\\nI knew that you were great.\\pIt looks like my eyes didn't deceive me.$"}
text:LilycoveCity_PokemonTrainerFanClub.ImInYourCorner	{'body': "Who cares about the others.\\nI'm in your corner!\\pYou don't need to worry. Just get\\nout there and battle like always.$"}
text:LilycoveCity_PokemonTrainerFanClub.ThinkTrainerIsNumberOne	{'body': "You're a pretty decent TRAINER,\\nI think.\\pBut I also think that {STR_VAR_1}\\nis number one right now.\\pThat's just my opinion.\\nDon't worry about it too much.$"}
text:LilycoveCity_PokemonTrainerFanClub.YoureMaybeStrongerThanTrainer	{'body': "Wow, you really are strong.\\nMaybe even stronger than {STR_VAR_1}.\\pBut {STR_VAR_1} needs me.\\pIf I don't cheer for {STR_VAR_1},\\nwho will?$"}
text:LilycoveCity_PokemonTrainerFanClub.YouChangedMyMind	{'body': "You've changed my mind!\\nYou are strong, aren't you?\\pI'd like you to tell me how you managed\\nto get so strong!$"}
text:LilycoveCity_PokemonTrainerFanClub.YouBattleAttractivelyInToughSituation	{'body': "The tougher the situation, the more\\nattractively you battle.\\pI can't wait for your next battle!$"}
text:LilycoveCity_PokemonTrainerFanClub.TrainerIsStandout	{'body': "Among the recently hot TRAINERS,\\n{STR_VAR_1} is the standout.\\pThat toughness, it's simply not normal.\\pYou're doing okay, but you're not in\\nthe same class as {STR_VAR_1}.$"}
text:LilycoveCity_PokemonTrainerFanClub.NoOneCanKnockYouButTrainerStronger	{'body': "You are really popular…\\pYou're strong, and you're caring to\\nPOKéMON. No one can knock you.\\pBut, you know, I believe in {STR_VAR_1}.\\p{STR_VAR_1} is definitely stronger!\\nI'm positive!$"}
text:LilycoveCity_PokemonTrainerFanClub.YouImpressive	{'body': 'You…\\pImpressive!$'}
text:LilycoveCity_PokemonTrainerFanClub.OnlyIRecognizeYourTrueWorth	{'body': 'Your true worth, it is fine if only\\nI recognized it.\\pThe others I doubt will understand\\nthe hidden power that beats within.$'}
text:LilycoveCity_PokemonTrainerFanClub.HaventRealizedPotential	{'body': "Yes, I see strength in your eyes.\\pBut!\\pYou still haven't realized your\\npotential.$"}
text:LilycoveCity_PokemonTrainerFanClub.YourePowerfulButNotTrueStrength	{'body': 'It is true that you are tremendously\\npowerful.\\pBut!\\nI can tell…\\pThat strength cannot be considered\\ntrue strength yet!\\pTrue strength is…!\\n… …\\pActually, I have no idea, either.$'}
text:LittlerootTown.OurNewHomeLetsGoInside	{'body': "MOM: {PLAYER}, we're here, honey!\\pThat must have been a tiring ride\\nin the moving truck.\\pWelcome to LITTLEROOT TOWN!\\nThis is our new home.\\pIt's quiet, but I think we'll\\nlike it here. And you have\\lyour very own room, {PLAYER}!\\pCome on, let's go inside.$"}
text:LittlerootTown.WaitPlayer	{'body': 'MOM: Wait, {PLAYER}!$'}
text:LittlerootTown.WearTheseRunningShoes	{'body': "MOM: {PLAYER}! Did you meet PROF.\\nBIRCH?\\pOh! Look at your new friends!\\nYou're setting off together? How\\llovely!\\pYour father will be so proud.\\nHere, honey, take these RUNNING\\lSHOES.\\pThey'll put a zip in your step!$"}
text:LittlerootTown.SwitchShoesWithRunningShoes	{'body': '{PLAYER} switched shoes with the\\nRUNNING SHOES.$'}
text:LittlerootTown.ExplainRunningShoes	{'body': 'MOM: The shoes came with a note:\\p“Hold the B Button to run.\\nNow get out there and explore!”$'}
text:LittlerootTown.ComeHomeIfAnythingHappens	{'body': "… … … … … … … …\\n… … … … … … … …\\pTo think that you have your very own\\nPOKéMON now…\\lYour father will be overjoyed.\\pHe's at the GYM in PETALBURG CITY.\\nGo west from OLDALE along ROUTE 102.\\p…But please be careful.\\nYou can always come home to rest.\\pGo on, go get them, honey!$"}
text:LittlerootTown.CanUsePCToStoreItems	{'body': 'If you use a PC, you can store items\\nand POKéMON.\\pThe power of science is staggering!$'}
text:LittlerootTown.BirchSpendsDaysInLab	{'body': 'PROF. BIRCH spends days studying\\nin his LAB, then rushes outside\\lto do even more research.\\pWhen does he find time to go home?$'}
text:LittlerootTown.IfYouGoInGrassPokemonWillJumpOut	{'body': 'Um, um, um!\\pIf you go outside and go in the grass,\\nwild POKéMON will jump out!$'}
text:LittlerootTown.DangerousIfYouDontHavePokemon	{'body': "It's dangerous if you don't have\\nyour own POKéMON.$"}
text:LittlerootTown.CanYouGoSeeWhatsHappening	{'body': "Um, hi!\\pThere are scary POKéMON outside!\\nI can hear their cries!\\pI want to go see what's going on,\\nbut I don't have any POKéMON…\\pCan you go see what's happening\\nfor me?$"}
text:LittlerootTown.YouSavedBirch	{'body': "You saved PROF. BIRCH!\\nI'm so glad!$"}
text:LittlerootTown.GoodLuckCatchingPokemon	{'body': 'Are you going to catch POKéMON?\\nGood luck!$'}
text:LittlerootTown.TownSign	{'body': "LITTLEROOT TOWN\\n“A town that can't be shaded any hue.”$"}
text:LittlerootTown.ProfBirchsLab	{'body': "PROF. BIRCH'S POKéMON LAB$"}
text:LittlerootTown.PlayersHouse	{'body': "{PLAYER}'s HOUSE$"}
text:LittlerootTown.ProfBirchsHouse	{'body': "PROF. BIRCH'S HOUSE$"}
text:LittlerootTown.BirchSomethingToShowYouAtLab	{'body': "PROF. BIRCH: Well, well, {PLAYER}{KUN}!\\nThat was good work out there!\\pI knew there was something special\\nabout you when I first saw you,\\lbut I never expected this.\\pOh, yes. Do you still have the POKéDEX\\nI gave you?\\pI have something to show you.\\nLet's go to my LAB.$"}
text:PlayersHouse_1F_IsntItNiceInHere	{'body': "MOM: See, {PLAYER}?\\nIsn't it nice in here, too?$"}
text:PlayersHouse_1F_MoversPokemonGoSetClock	{'body': "The mover's POKéMON do all the work\\nof moving us in and cleaning up after.\\lThis is so convenient!\\p{PLAYER}, your room is upstairs.\\nGo check it out, dear!\\pDAD bought you a new clock to mark\\nour move here.\\lDon't forget to set it!$"}
text:PlayersHouse_1F_ArentYouInterestedInRoom	{'body': "MOM: Well, {PLAYER}?\\pAren't you interested in seeing your\\nvery own room?$"}
text:PlayersHouse_1F_GoSetTheClock	{'body': 'MOM: {PLAYER}.\\pGo set the clock in your room, honey.$'}
text:PlayersHouse_1F_OhComeQuickly	{'body': 'MOM: Oh! {PLAYER}, {PLAYER}!\\nQuick! Come quickly!$'}
text:PlayersHouse_1F_MaybeDadWillBeOn	{'body': "MOM: Look! It's PETALBURG GYM!\\nMaybe DAD will be on!$"}
text:PlayersHouse_1F_ItsOverWeMissedHim	{'body': "MOM: Oh… It's over.\\pI think DAD was on, but we missed him.\\nToo bad.$"}
text:PlayersHouse_1F_GoIntroduceYourselfNextDoor	{'body': "Oh, yes.\\nOne of DAD's friends lives in town.\\pPROF. BIRCH is his name.\\pHe lives right next door, so you should\\ngo over and introduce yourself.$"}
text:PlayersHouse_1F_SeeYouHoney	{'body': 'MOM: See you, honey!$'}
text:PlayersHouse_1F_DidYouMeetProfBirch	{'body': 'MOM: Did you introduce yourself to\\nPROF. BIRCH?$'}
text:PlayersHouse_1F_YouShouldRestABit	{'body': 'MOM: How are you doing, {PLAYER}?\\nYou look a little tired.\\pI think you should rest a bit.$'}
text:PlayersHouse_1F_TakeCareHoney	{'body': 'MOM: Take care, honey!$'}
text:PlayersHouse_1F_GotDadsBadgeHeresSomethingFromMom	{'body': "MOM: Oh? Did DAD give you that BADGE?\\pThen here's something from your MOM!$"}
text:PlayersHouse_1F_DontPushYourselfTooHard	{'body': "Don't push yourself too hard, dear.\\nYou can always come home.\\pGo for it, honey!$"}
text:PlayersHouse_1F_IsThatAPokenav	{'body': 'MOM: What is that, honey? A POKéNAV?\\nSomeone from DEVON gave it to you?\\pWell, honey, how about registering\\nyour mom?\\p… … …$'}
text:PlayersHouse_1F_RegisteredMom	{'body': 'Registered MOM\\nin the POKéNAV.$'}
text:PlayersHouse_1F_Vigoroth1	{'body': 'Fugiiiiih!$'}
text:PlayersHouse_1F_Vigoroth2	{'body': 'Huggoh, uggo uggo…$'}
text:PlayersHouse_1F_ReportFromPetalburgGym	{'body': 'INTERVIEWER: …And that was our\\nreport from PETALBURG GYM.$'}
text:PlayersHouse_1F_TheresAMovieOnTV	{'body': 'There is a movie on TV.\\pTwo men are dancing on a big piano\\nkeyboard.\\pBetter get going!$'}
text:PlayersHouse_1F_RunningShoesManual	{'body': "It's the instruction booklet for the\\nRUNNING SHOES.\\p“Press the B Button to run while\\nwearing your RUNNING SHOES.\\p“Lace up your RUNNING SHOES and hit\\nthe road running!”$"}
text:PlayersHouse_1F_TicketFromBrineyCameForYou	{'body': "DAD: Hm?\\pHey, it's {PLAYER}!\\pIt's been a while since I saw you,\\nbut you look…stronger, somehow.\\pThat's the impression I get.\\nBut your old man hasn't given up yet!\\pOh, yes, I have something for you.\\nThis came to you from someone named\\lMR. BRINEY.$"}
text:PlayersHouse_1F_SSTicketSentToPC	{'body': 'Your KEY ITEMS pocket is full, so the\\nS.S. TICKET was sent to your PC.$'}
text:PlayersHouse_1F_SSTicketNoRoom	{'body': 'Your KEY ITEMS pocket and PC are full.\\nMR. BRINEY registered your pass with\\lboth ferry ports instead.$'}
text:PlayersHouse_1F_PortsInSlateportLilycove	{'body': 'DAD: Hm, a TICKET for a ferry?\\pIf I recall, there are ferry ports in\\nSLATEPORT and LILYCOVE.$'}
text:PlayersHouse_1F_BetterGetBackToGym	{'body': "I'd better get back to PETALBURG GYM.\\pMOM, thanks for looking after the house\\nwhile I'm away.$"}
text:PlayersHouse_1F_DadShouldStayLonger	{'body': 'MOM: That DAD of yours…\\pHe comes home for the first time in a\\nwhile, but all he talks about is POKéMON.\\pHe should relax and stay a little longer.$'}
text:PlayersHouse_1F_IsThatABreakingStory	{'body': 'MOM: Is that a breaking news story?$'}
text:PlayersHouse_1F_LatiEmergencyNewsFlash	{'body': 'We bring you this emergency\\nnews flash!\\pIn various HOENN locales, there have\\nbeen reports of a BZZT…colored\\lPOKéMON in flight.\\pThe identity of this POKéMON is\\ncurrently unknown.\\pWe now return you to the regular\\nmovie program.$'}
text:PlayersHouse_1F_WhatColorDidTheySay	{'body': 'MOM: {PLAYER}, did you catch that?\\pWhat color did the announcer say\\nthat POKéMON was?$'}
text:PlayersHouse_1F_StillUnknownPokemon	{'body': "MOM: Well, isn't that something!\\nThere are still unknown POKéMON.$"}
text:PlayersHouse_2F_ClockIsStopped	{'body': 'The clock is stopped…\\pBetter set it and start it!$'}
text:PlayersHouse_2F_HowDoYouLikeYourRoom	{'body': "MOM: {PLAYER}, how do you like your\\nnew room?\\pGood! Everything's put away neatly!\\pThey finished moving everything in\\ndownstairs, too.\\pPOKéMON movers are so convenient!\\pOh, you should make sure that\\neverything's all there on your desk.$"}
text:PlayersHouse_2F_Notebook	{'body': '{PLAYER} flipped open the notebook.\\pADVENTURE RULE NO. 1\\nOpen the MENU with START.\\pADVENTURE RULE NO. 2\\nRecord your progress with SAVE.\\pThe remaining pages are blank…$'}
text:Common_LookCloserAtMap	{'body': '{PLAYER} took a closer look at the\\n{REGION} region map.$'}
text:PlayersHouse_2F_ItsAGameCube	{'body': "It's a Nintendo GameCube.\\pA Game Boy Advance is connected to\\nserve as the Controller.$"}
text:RivalsHouse_1F_OhYoureTheNewNeighbor	{'body': "Oh, hello. And you are?\\p… … … … … … … … …\\n… … … … … … … … …\\pOh, you're {PLAYER}{KUN}, our new next-door\\nneighbor! Hi!\\pWe have a {STR_VAR_1} about the same\\nage as you.\\pOur {STR_VAR_1} was excited to make\\na new friend.\\pOur {STR_VAR_1} is upstairs, I think.$"}
text:RivalsHouse_1F_LikeChildLikeFather	{'body': "Like child, like father.\\pMy husband is as wild about POKéMON\\nas our child.\\pIf he's not at his LAB, he's likely\\nscrabbling about in grassy places.$"}
text:RivalsHouse_1F_TooBusyToNoticeVisit	{'body': "{RIVAL} is already packing for\\nanother trip into the field.\\pI'm glad you two got to meet,\\n{PLAYER}{KUN}. It's nice to have\\la friend next door.$"}
text:RivalsHouse_1F_WentOutToRoute103	{'body': "Oh, {RIVAL} went out to ROUTE 103\\njust a little while ago.\\pLike father, like child.\\n{RIVAL} can't stay quietly at home.$"}
text:RivalsHouse_1F_ShouldGoHomeEverySoOften	{'body': "I think it's wonderful for people to\\ntravel with POKéMON.\\pBut you should go home every so often\\nto let your mother know you're okay.\\pShe might not say it, but I'm sure she\\nworries about you, {PLAYER}{KUN}.$"}
text:RivalsHouse_1F_MayWhoAreYou	{'body': "You're {PLAYER}, right? I'm MAY.\\nWelcome to LITTLEROOT!\\pDad said a GYM LEADER's family\\nwas moving next door. I hoped\\lwe'd get to be friends!\\pHe studies POKéMON from all nine\\nregions. He took their starter\\lpartners out for fieldwork today.\\pYou can meet him on ROUTE 101,\\nnorth of town!$"}
text:RivalsHouse_1F_BrendanWhoAreYou	{'body': "You're {PLAYER}? I'm BRENDAN. Dad\\ntold me you were moving next\\ldoor.\\pA GYM LEADER's kid, huh? We'll\\nhave to battle sometime!\\pDad studies POKéMON from all nine\\nregions. He's on ROUTE 101 with\\ltheir starter partners today.\\pHead north out of town. You can't\\nmiss him!$"}
text:RivalsHouse_1F_DoYouHavePokemon	{'body': 'Hi, neighbor!\\pDo you already have your\\nown POKéMON?$'}
text:RivalsHouse_2F_MayWhoAreYou	{'body': "You're {PLAYER}, right? I'm MAY.\\nWelcome to LITTLEROOT!\\pDad said a GYM LEADER's family\\nwas moving next door. I hoped\\lwe'd get to be friends!\\pHe studies POKéMON from all nine\\nregions. He took their starter\\lpartners out for fieldwork today.\\pYou can meet him on ROUTE 101,\\nnorth of town!$"}
text:RivalsHouse_2F_MayGettingReady	{'body': 'POKéMON fully restored!\\nItems ready, and…$'}
text:RivalsHouse_2F_BrendanWhoAreYou	{'body': "You're {PLAYER}? I'm BRENDAN. Dad\\ntold me you were moving next\\ldoor.\\pA GYM LEADER's kid, huh? We'll\\nhave to battle sometime!\\pDad studies POKéMON from all nine\\nregions. He's on ROUTE 101 with\\ltheir starter partners today.\\pHead north out of town. You can't\\nmiss him!$"}
text:RivalsHouse_2F_BrendanGettingReady	{'body': 'POKéMON fully restored…\\nItems all packed, and…$'}
text:RivalsHouse_2F_ItsRivalsPokeBall	{'body': "It's {RIVAL}'s POKé BALL!\\pBetter leave it right where it is.$"}
text:RivalsHouse_2F_MayJustCheckingMyPokedex	{'body': "MAY: {PLAYER}{KUN}!\\pI was just checking my POKéDEX.\\pThere's still a lot of POKéMON that\\nI've seen but haven't caught.\\pAnd there are many others that\\nI think will evolve.\\pI wonder where I should go catch\\nsome POKéMON next?$"}
text:RivalsHouse_2F_MayWhereShouldIGoNext	{'body': "MAY: I wonder where I should go catch\\nsome POKéMON next?\\pWouldn't it be funny if we ran into each\\nother, {PLAYER}{KUN}?$"}
text:RivalsHouse_2F_BrendanJustCheckingMyPokedex	{'body': "BRENDAN: Hey, it's {PLAYER}.\\pI was just checking out my POKéDEX.\\pThere are still many POKéMON that\\nI need to catch, I know, but this\\lis looking pretty good.\\pChecking this POKéDEX out gives me\\nthe urge to hit the road again.$"}
text:RivalsHouse_2F_BrendanWhereShouldIGoNext	{'body': "BRENDAN: I'm having a hard time deciding\\nwhere I should catch POKéMON next.\\pHey, {PLAYER}, if I see you while I'm out\\ncatching POKéMON, I can pitch you a\\lbattle if you'd like.$"}
text:LittlerootTown_ProfessorBirchsLab.BirchAwayOnFieldwork	{'body': "Looking for PROF. BIRCH?\\pHe's on ROUTE 101, north of town,\\nstudying POKéMON in the wild.\\pHe calls it fieldwork. I call it\\na good excuse to leave the desk!$"}
text:LittlerootTown_ProfessorBirchsLab.BirchIsntOneForDeskWork	{'body': 'The PROF. prefers fieldwork to\\npaperwork. Try ROUTE 101, just\\lnorth of town.$'}
text:LittlerootTown_ProfessorBirchsLab.BirchEnjoysRivalsHelpToo	{'body': "PROF. BIRCH is studying the habitats\\nand distribution of POKéMON.\\pThe PROF enjoys {RIVAL}'s help, too.\\nThere's a lot of love there.$"}
text:LittlerootTown_ProfessorBirchsLab.LikeYouToHavePokemon	{'body': "PROF. BIRCH: {PLAYER}, thank you!\\nI really was in a spot back there.\\pMy colleagues sent these POKéMON from\\nnine regions. Quite a welcome to HOENN!\\pThat one trusted you when it mattered.\\nI'd like you to keep traveling together.\\p{PLAYER} received the {STR_VAR_1}!$"}
text:LittlerootTown_ProfessorBirchsLab.WhyNotGiveNicknameToMon	{'body': "PROF. BIRCH: While you're at it, why not\\ngive a nickname to that {STR_VAR_1}?$"}
text:LittlerootTown_ProfessorBirchsLab.MightBeGoodIdeaToGoSeeRival	{'body': "{RIVAL} is studying POKéMON on\\nROUTE 103. Why not introduce your\\lnew partners?\\pOLDALE's CENTER can help you\\nprepare. Its free LEVELER brings\\lyour POKéMON up to the current\\ltraining limit.\\pWould you like to go find\\n{RIVAL}?$"}
text:LittlerootTown_ProfessorBirchsLab.GetRivalToTeachYou	{'body': 'Good! You can learn a lot from a battle,\\neven one you lose. Take care out there!$'}
text:LittlerootTown_ProfessorBirchsLab.DontBeThatWay	{'body': "PROF. BIRCH: Oh, don't be that way.\\nYou should go meet my kid.$"}
text:LittlerootTown_ProfessorBirchsLab.BirchRivalGoneHome	{'body': "PROF. BIRCH: {RIVAL}?\\nGone home, I think.\\pOr maybe that kid's scrabbling around\\nin tall grass again somewhere…\\pIf you or your POKéMON get tired,\\nyou should get some rest at home.$"}
text:LittlerootTown_ProfessorBirchsLab.HeardYouBeatRivalTakePokedex	{'body': "PROF. BIRCH: {RIVAL} told me all about\\nyour battle! Sounds like quite a match.\\pI have something for your journey. This\\nPOKéDEX records each species you meet,\\leven the ones you haven't caught.\\pI can't see all of HOENN from here.\\nWill you tell me what you discover?$"}
text:LittlerootTown_ProfessorBirchsLab.ReceivedPokedex	{'body': '{PLAYER} received the POKéDEX!$'}
text:LittlerootTown_ProfessorBirchsLab.ExplainPokedex	{'body': "Read the signs along each route. They'll\\nhelp you find the POKéMON living there.\\pCatch the ones that interest you. Try\\ntraveling with different companions.\\pThe LEVELER helps new teammates catch\\nup. But tough battles still take care\\land preparation. Look after each other!$"}
text:LittlerootTown_ProfessorBirchsLab.CountlessPokemonAwait	{'body': 'Take ROUTE 102 west from OLDALE\\nto PETALBURG CITY. Your dad will\\lbe happy to see you at his GYM.\\pBring back a few discoveries\\nof your own, too!$'}
text:LittlerootTown_ProfessorBirchsLab.MayGotPokedexTooTakeThese	{'body': "MAY: Oh, wow, {PLAYER}{KUN}!\\nYou got a POKéDEX, too!\\pThat's great! Just like me!\\nI've got something for you, too!$"}
text:LittlerootTown_ProfessorBirchsLab.CatchCutePokemonWithPokeBalls	{'body': 'MAY: Take these POKé BALLS! I always\\nmeet new friends in unexpected places.\\pCatch lots of POKéMON. You can change\\nyour team to suit the battles ahead!$'}
text:LittlerootTown_ProfessorBirchsLab.OhYourBagsFull	{'body': "Oh? Your BAG's full.$"}
text:LittlerootTown_ProfessorBirchsLab.MayWhereShouldIGoNext	{'body': 'MAY: I wonder where I should go look\\nfor POKéMON next?$'}
text:LittlerootTown_ProfessorBirchsLab.BrendanGotPokedexTooTakeThese	{'body': "BRENDAN: Huh…\\nSo you got a POKéDEX, too.\\pWell then, here.\\nI'll give you these.$"}
text:LittlerootTown_ProfessorBirchsLab.CatchCoolPokemonWithPokeBalls	{'body': "BRENDAN: Here, take these POKé BALLS.\\nThere's more out there than you think.\\pCatch different POKéMON. Then you can\\nchoose the right six for each battle.$"}
text:LittlerootTown_ProfessorBirchsLab.HeyYourBagsFull	{'body': "Hey, your BAG's full.$"}
text:LittlerootTown_ProfessorBirchsLab.BrendanWhereShouldIGoNext	{'body': 'BRENDAN: Where should I look for\\nPOKéMON next…$'}
text:LittlerootTown_ProfessorBirchsLab.SeriousLookingMachine	{'body': "It's a serious-looking machine.\\nThe PROF must use this for research.$"}
text:LittlerootTown_ProfessorBirchsLab.PCUsedForResearch	{'body': "It's a PC used for research.\\nBetter not mess around with it.$"}
text:LittlerootTown_ProfessorBirchsLab.CrammedWithBooksOnPokemon	{'body': "It's crammed with books on POKéMON.$"}
text:LittlerootTown_ProfessorBirchsLab.BookTooHardToRead	{'body': "It's a book that's too hard to read.$"}
text:LittlerootTown_ProfessorBirchsLab.OtherRegionsUpgradeToNational	{'body': "PROF. BIRCH: {PLAYER}{KUN},\\n{RIVAL}, you've both brought back\\lso many field notes!\\pYour POKéDEX units could record\\nevery region from the start.\\lLet's add our latest observations\\lto both.\\pMay I see them for a moment?$"}
text:LittlerootTown_ProfessorBirchsLab.MayUpgradeSoCool	{'body': "MAY: Eheheh!\\pIt's so cool that our field notes\\nare finally synchronized!\\pIt's because you went out and caught\\nso many POKéMON, {PLAYER}{KUN}!$"}
text:LittlerootTown_ProfessorBirchsLab.BrendanYouCanThankMe	{'body': "BRENDAN: I went out all over HOENN\\nand checked out POKéMON.\\pYou can thank me for the final\\nresearch notes.\\pYep, you're lucky, {PLAYER}!$"}
text:LittlerootTown_ProfessorBirchsLab.OkayAllDone	{'body': 'PROF. BIRCH: Okay, all done!$'}
text:LittlerootTown_ProfessorBirchsLab.PokedexUpgradedToNational	{'body': "{PLAYER}'s POKéDEX synchronized\\nthe CHAMPION research notes!$"}
text:LittlerootTown_ProfessorBirchsLab.GrassyPatchWaiting2	{'body': "PROF. BIRCH: But listen.\\nYou've become the CHAMPION,\\lbut your POKéMON journey isn't over.\\pThere is no end to the road\\nthat is POKéMON.\\pSomewhere, there is a grassy patch\\nthat's waiting for you!$"}
text:LittlerootTown_ProfessorBirchsLab.MayTakeBreakFromFieldwork	{'body': "MAY: I think I'll take a short break\\nfrom fieldwork.\\pI think I'll help the PROF here for\\na while.$"}
text:LittlerootTown_ProfessorBirchsLab.BrendanTakeBreakFromFieldwork	{'body': "BRENDAN: For the time being,\\nI'm taking a break from fieldwork.\\pI'll be helping out the PROF here\\nfor a while.$"}
text:LittlerootTown_ProfessorBirchsLab.CompletedDexResearchReward	{'body': "PROF. BIRCH: Every known HOENN\\nspecies! What a remarkable record\\lof your journey.\\pI've kept a spare set of our\\nlegendary form tools here. Take\\lany you're missing!\\pThey're also in the CENTER\\nvendors' Form Tools archive.\\lYour MEGA RING gives you access\\lthere.$"}
text:LittlerootTown_ProfessorBirchsLab.ResearchRewardWaiting	{'body': "PROF. BIRCH: Your LEGENDARY FORM tools\\nare still here. Let's finish the set.$"}
text:LittlerootTown_ProfessorBirchsLab.ResearchRewardComplete	{'body': "The tools let KYUREM, ZYGARDE,\\nNECROZMA, and CALYREX change\\lforms or combine with certain\\lpartners.\\pThere's always something new to\\nlearn about POKéMON!$"}
text:LittlerootTown_ProfessorBirchsLab.ResearchRewardBagFull	{'body': 'Your KEY ITEMS pocket is full.\\nMake room and return; every\\lremaining tool is safe.$'}
text:LittlerootTown_ProfessorBirchsLab.MayWhatNextImStayingHere	{'body': "MAY: {PLAYER}{KUN}, after this…\\nWhat are you going to do?\\pAre you going to keep battling\\nand sharpening your skills?\\pOr are you going to try filling\\nthe NATIONAL POKéDEX?\\pI'm staying here to help the PROF.$"}
text:LittlerootTown_ProfessorBirchsLab.BrendanPreferCollectingSlowly	{'body': 'BRENDAN: Rather than collecting\\nPOKéMON, I prefer slowly and \\lsteadily raising the one I chose.$'}
text:LittlerootTown_ProfessorBirchsLab.MayHaveYouGoneToBattleFrontier	{'body': 'MAY: Oh, hi, {PLAYER}{KUN}!\\nHave you gone to that place,\\lthe BATTLE FRONTIER?$'}
text:LittlerootTown_ProfessorBirchsLab.BrendanHaveYouGoneToBattleFrontier	{'body': 'BRENDAN: Hey, {PLAYER}!\\nHave you gone out to that place,\\lthe BATTLE FRONTIER?$'}
text:LittlerootTown_ProfessorBirchsLab.ScottAboardSSTidalCall	{'body': "… … … … … …\\n… … … … … Beep!\\pSCOTT: Hi, hi, {PLAYER}!\\nIt's me, SCOTT.\\pI'm aboard the S.S. TIDAL now.\\nIt feels great to be on the sea!\\pBy the way…\\pThere's this place that I'd like to\\ninvite you to for a visit.\\pIf you're interested, board a ferry\\nat either SLATEPORT or LILYCOVE.\\pI'll fill you in on the details when\\nwe meet. I'll be waiting!\\p… … … … … …\\n… … … … … Click!$"}
text:LittlerootTown_ProfessorBirchsLab.YourTwoPartners	{'body': "PROF. BIRCH: You and both of these\\nPOKéMON were brave out there.\\pI'd like {STR_VAR_1} and\\n{STR_VAR_2} to stay with you.\\pI think you're going to make\\na wonderful team!$"}
text:LittlerootTown_ProfessorBirchsLab.NameOpeningPartner	{'body': 'Would you like to nickname\\n{STR_VAR_1}?$'}
text:LittlerootTown_ProfessorBirchsLab.OpeningDex	{'body': "Take this POKéDEX, too. It records\\nthe POKéMON you see and catch.\\pHOENN's weather has been strange.\\nPOKéMON are appearing in places\\lwe've never seen them before.\\pEven LEGENDARY POKéMON, once known\\nonly through stories, are being\\lsighted along our routes!\\pAre they following the weather,\\nor is something drawing them here?\\lYour discoveries could help us learn.$"}
text:LittlerootTown_ProfessorBirchsLab.OpeningBalls	{'body': 'You received 20 POKé BALLS!$'}
text:LittlerootTown_ProfessorBirchsLab.OpeningBallsInPC	{'body': 'Your 20 POKé BALLS were sent\\nto the item PC.$'}
text:LittlerootTown_ProfessorBirchsLab.OpeningReady	{'body': "{RIVAL} is studying POKéMON on\\nROUTE 103, north of OLDALE TOWN.\\pStop at OLDALE's POKéMON CENTER.\\nCollect your free tools and ask\\lthe TUTOR about Battle Sets.\\pThey prepare moves and stats.\\nUse the LEVELER to raise your\\lparty; battles give no experience.\\pCatch a few more partners, then\\ntry a battle with {RIVAL}!\\pIf you need another try, choose\\nRUN in a TRAINER battle. You can\\lrestart that battle for free.$"}
text:LittlerootTown_ProfessorBirchsLab.OpeningSuppliesFull	{'body': 'Your field supplies are waiting.\\pMake room in your Bag or item PC,\\nthen speak to me or the aide.$'}
text:LittlerootTown_ProfessorBirchsLab.OpeningDebrief	{'body': "PROF. BIRCH: Welcome back, {PLAYER}!\\nYou beat {RIVAL}? Well done!\\pFirst you helped me out of a\\nscrape, and now your first win\\lagainst another TRAINER!\\pThere's nothing like getting out\\nin the field with your partners.\\lEven I learn something every day!\\pHere, take these 10 GREAT BALLS.\\nThey catch POKéMON more easily\\lthan ordinary POKé BALLS.$"}
text:LittlerootTown_ProfessorBirchsLab.OpeningSendoff	{'body': 'Head west from OLDALE along\\nROUTE 102 to PETALBURG CITY.\\pYour dad runs the GYM there.\\nGo show him your team!\\pRead the route signs as you go.\\nThey list local POKéMON by grass,\\lwater, and fishing method.\\pKeep reading past the fishing\\nlists for local LEGENDARIES. Many\\lcan be found in the wild!\\pFor more leads, ask the local\\nguide near the PC in each\\lPOKéMON CENTER.\\pHe can tell you which LEGENDARIES\\nare nearby and who to talk to\\labout them. Enjoy the journey!$'}
text:LittlerootTown_ProfessorBirchsLab.GreatBallsInPC	{'body': 'Your 10 GREAT BALLS were sent\\nto the item PC.$'}
text:LittlerootTown_ProfessorBirchsLab.GreatBallsWaiting	{'body': "Your Bag and item PC are full.\\pMake room and come see me.\\nI'll keep your GREAT BALLS here!$"}
text:MagmaHideout_1F.Grunt1Intro	{'body': "This corner is my post. Nobody\\ngets past it while I'm on duty!\\pMAXIE is counting on us. I won't\\nlet him down!$"}
text:MagmaHideout_1F.Grunt1Defeat	{'body': "I couldn't hold my own post…$"}
text:MagmaHideout_1F.Grunt1PostBattle	{'body': 'I thought standing guard would be\\nthe easy job.\\pThe digging crew warned me. I\\nshould have listened.$'}
text:MagmaHideout_1F.Grunt2Intro	{'body': "Our leader told us to dig into MT.\\nCHIMNEY, so we dug and dug.\\pWhat we found could give HOENN\\nmore land than we ever dreamed of!\\pAnd you're not getting near it!$"}
text:MagmaHideout_1F.Grunt2Defeat	{'body': 'All that digging wore me out…$'}
text:MagmaHideout_1F.Grunt2PostBattle	{'body': "MAXIE is in the deepest chamber.\\nHe says the BLUE ORB will awaken\\lwhat we found.\\pI hope he knows what he's doing.$"}
text:MagmaHideout_2F_1R.Grunt14Intro	{'body': "Hey! No hood, no business here.\\pI joined MAGMA because my town floods\\nevery spring. Solid ground, that's all\\lI ever asked for. Now beat it!$"}
text:MagmaHideout_2F_1R.Grunt14Defeat	{'body': 'Aiyiyi… My hood and my pride, both.$'}
text:MagmaHideout_2F_1R.Grunt14PostBattle	{'body': 'Go on, then. Just… if you see MAXIE,\\nask him if the ground is worth this.$'}
text:MagmaHideout_2F_1R.Grunt3Intro	{'body': "Hold it! You think I'll just let you\\nstroll past a CLAYDOL and a GARBODOR?$"}
text:MagmaHideout_2F_1R.Grunt3Defeat	{'body': 'Ooh wow! Okay. I concede.$'}
text:MagmaHideout_2F_1R.Grunt3PostBattle	{'body': "Honestly, I only signed up for the\\ndental plan. Don't tell the ADMINS.$"}
text:MagmaHideout_2F_1R.Grunt4Intro	{'body': "An intruder! SCRAFTY, it's a real fight\\nfor once, not another drill!$"}
text:MagmaHideout_2F_1R.Grunt4Defeat	{'body': "Graaah! Even the drills didn't go\\nlike that!$"}
text:MagmaHideout_2F_1R.Grunt4PostBattle	{'body': "I've already lost. Do I have to keep\\nrunning laps around this rock?$"}
text:MagmaHideout_2F_1R.Grunt5Intro	{'body': 'Oh, oh! Nobody told me anyone would\\nactually get this far!$'}
text:MagmaHideout_2F_1R.Grunt5Defeat	{'body': 'Mutter… mutter…$'}
text:MagmaHideout_2F_1R.Grunt5PostBattle	{'body': "I'm not much of a battler. I'm in it\\nfor the volcano. It's really pretty.$"}
text:MagmaHideout_2F_2R.Grunt15Intro	{'body': "Nothing personal. I'm following orders,\\nand my orders are: nobody passes.$"}
text:MagmaHideout_2F_2R.Grunt15Defeat	{'body': 'Orders, meet reality…$'}
text:MagmaHideout_2F_2R.Grunt15PostBattle	{'body': "We dug up something huge down here, and\\nMAXIE has the BLUE ORB now.\\pI don't know what happens next. I don't\\nthink he does either.$"}
text:MagmaHideout_2F_2R.Grunt6Intro	{'body': "I used to hate this heat. My\\nPOKéMON seem perfectly\\lcomfortable!\\pMaybe they're trying to tell me to\\nstop complaining. Come on, then!$"}
text:MagmaHideout_2F_2R.Grunt6Defeat	{'body': 'Now I really need some fresh air…$'}
text:MagmaHideout_2F_2R.Grunt6PostBattle	{'body': 'They love it here. I suppose I can\\nput up with a little sweat.\\pA lot of sweat, actually.$'}
text:MagmaHideout_2F_2R.Grunt7Intro	{'body': "You feel those tremors? People say it's\\nthe volcano. Some of us know better.\\pWhoops! Never mind. Fight me!$"}
text:MagmaHideout_2F_2R.Grunt7Defeat	{'body': 'You hit like a volcano yourself…$'}
text:MagmaHideout_2F_2R.Grunt7PostBattle	{'body': "You won this one. Doesn't matter.\\nMAGMA's almost there. I hope.$"}
text:MagmaHideout_2F_2R.Grunt8Intro	{'body': "Wait. One of ours lost a MAGMA\\nEMBLEM. Is that how you got in?\\pOh, he'll hear about this! But\\nfirst, I've got to deal with you!$"}
text:MagmaHideout_2F_2R.Grunt8Defeat	{'body': "I'm having trouble believing this…$"}
text:MagmaHideout_2F_2R.Grunt8PostBattle	{'body': "Between you and me? I've got a feeling\\nthis plan ends badly for everyone.$"}
text:MagmaHideout_3F_1R.Grunt9Intro	{'body': "Guard posting next to the lava. My left\\near's been cooking for an hour.\\pAt least fighting you means I can move.$"}
text:MagmaHideout_3F_1R.Grunt9Defeat	{'body': 'Heat exhaustion. Definitely the heat.$'}
text:MagmaHideout_3F_1R.Grunt9PostBattle	{'body': "Do you think it's weird that we wear\\nhoods inside a volcano? Be honest.$"}
text:MagmaHideout_3F_1R.Grunt16Intro	{'body': 'MAXIE offers a world people can\\npredict, build on, and pass to\\ltheir children.\\pAQUA rejects it. You question it.\\nI will defend it.$'}
text:MagmaHideout_3F_1R.Grunt16Defeat	{'body': 'Your uncertainty outplayed my order…$'}
text:MagmaHideout_3F_1R.Grunt16PostBattle	{'body': "I still believe MAGMA's question\\nmatters. I am less certain our\\lanswer is complete.$"}
text:MagmaHideout_3F_2R.Grunt10Intro	{'body': "I understand everything our leader\\nsays. But you know what?\\pDoing stuff like digging up a super-\\nancient POKéMON and ripping off\\lsomeone's METEORITE…\\pI think we're going a little too far.\\nWhat do you think?$"}
text:MagmaHideout_3F_2R.Grunt10Defeat	{'body': 'Yeah, I think we are doing something\\nwrong somehow.$'}
text:MagmaHideout_3F_2R.Grunt10PostBattle	{'body': "You know, losing to you cleared my mind.\\pThe next time I see our leader,\\nI'm going to ask him about what we do.$"}
text:MagmaHideout_4F.CourtneyIntro	{'body': 'COURTNEY: You reached the\\nchamber.\\pMAXIE must not be interrupted. I\\nwill stop you here.$'}
text:MagmaHideout_4F.CourtneyDefeat	{'body': 'COURTNEY: Defeated… Again.$'}
text:MagmaHideout_4F.CourtneyAfter	{'body': 'COURTNEY: MAXIE is just ahead.\\pGROUDON… What will it do when it\\nwakes?$'}
text:MagmaHideout_4F.AdminsStillStanding	{'body': 'COURTNEY and TABITHA still hold this\\nchamber. Face both before MAXIE.$'}
text:MagmaHideout_4F.Grunt11Intro	{'body': "MAXIE promised solid ground under\\nevery home in HOENN. I believe\\lhim.\\pYou're not getting into that\\nchamber!$"}
text:MagmaHideout_4F.Grunt11Defeat	{'body': 'You beat my whole team…$'}
text:MagmaHideout_4F.Grunt11PostBattle	{'body': "None of us have seen GROUDON.\\nMAXIE keeps the last chamber\\lclosed.\\pThe mountain's shaking. I hope he\\nknows what he's doing.$"}
text:MagmaHideout_4F.Grunt12Intro	{'body': "Can you feel the mountain\\nshaking? That's GROUDON's power!\\pMAXIE's waited years for this. I\\nwon't let you spoil it!$"}
text:MagmaHideout_4F.Grunt12Defeat	{'body': "I couldn't stop you…$"}
text:MagmaHideout_4F.Grunt12PostBattle	{'body': 'MAXIE, sir! An intruder is headed for\\nthe chamber!$'}
text:MagmaHideout_4F.Grunt13Intro	{'body': "This is the last chamber. GROUDON\\nis just beyond us.\\pYou want to stop MAXIE? You'll\\nhave to get past me!$"}
text:MagmaHideout_4F.Grunt13Defeat	{'body': "My team couldn't hold you back…$"}
text:MagmaHideout_4F.Grunt13PostBattle	{'body': 'That tremor… Was it stronger than\\nthe last one?$'}
text:MagmaHideout_4F.TabithaIntro	{'body': "TABITHA: You've made it through\\nthe entire hideout. I should have\\lexpected it.\\pMAXIE is with GROUDON. This is\\nthe moment we've worked for.\\pI'm not letting you take it from\\nus!$"}
text:MagmaHideout_4F.TabithaDefeat	{'body': "Even here, I couldn't defeat you…$"}
text:MagmaHideout_4F.TabithaPostBattle	{'body': 'TABITHA: MAXIE is just ahead.\\pThe shaking keeps getting worse.\\nWhat is happening in there?$'}
text:MagmaHideout_4F.MaxieAwakenGroudon	{'body': 'MAXIE: GROUDON, ancient architect\\nof continents... accept the BLUE\\lORB.\\pThe mountain shakes with your\\npower. Rise, and give HOENN land\\lthat will never yield!$'}
text:MagmaHideout_4F.MaxieGroudonWhatsWrong	{'body': "MAXIE: GROUDON! What's wrong? The\\nBLUE ORB was supposed to make\\lyou obey!\\pWait! Where are you going?$"}
text:MagmaHideout_4F.MaxieOhItWasYou	{'body': "MAXIE: You! Did you see that?\\nGROUDON left without a single\\lcommand.\\pDon't look at me like that. You\\nwon't stop TEAM MAGMA!$"}
text:MagmaHideout_4F.MaxieDefeat	{'body': 'What makes you so adept at handling\\nPOKéMON?$'}
text:MagmaHideout_4F.MaxieImGoingAfterGroudon	{'body': "MAXIE: GROUDON is loose. I have\\nto find out why the ORB failed to\\lcontrol it.\\pARCHIE still has the RED ORB.\\nHe'll need STERN's submarine to\\lreach KYOGRE on the seafloor.\\pGo warn CAPT. STERN at the harbor\\nin northeast SLATEPORT.\\pI'm going after GROUDON.$"}
text:MauvilleCity.UncleHesTooPeppy	{'body': "UNCLE: It's because of POKéMON that\\nthis boy's got more pep, I suppose…\\lBut he's become a bit too peppy…$"}
text:MauvilleCity.WallyWantToChallengeGym	{'body': "WALLY: Aww, UNCLE, please?\\pI feel so much better since\\nmoving to VERDANTURF. We've been\\lpracticing every day!\\pRALTS even evolved into KIRLIA!$"}
text:MauvilleCity.UncleYourePushingIt	{'body': "UNCLE: Now hold on, WALLY.\\pSince you started living with POKéMON,\\nyou have grown quite a lot stronger.\\pBut don't you think you're pushing it\\nto suddenly challenge a GYM?$"}
text:MauvilleCity.WallyWeCanBeatAnyone	{'body': "WALLY: We've made new friends,\\ntoo! I want to see how far we can\\lgo together.$"}
text:MauvilleCity.WallyWillYouBattleMe	{'body': "WALLY: Oh! Hi, {PLAYER}!\\pDo you remember helping me catch\\nRALTS? We've come a long way\\lsince then.\\pPlease, will you battle me? I\\nwant to show my UNCLE I'm ready.$"}
text:MauvilleCity.WallyMyUncleWontKnowImStrong	{'body': 'WALLY: Oh… All right. I was\\nhoping you could help me show\\lhim.$'}
text:MauvilleCity.UncleCanYouBattleWally	{'body': "UNCLE: {PLAYER}{KUN}, was it?\\nOn WALLY's behalf, can I ask you to\\lbattle with him just this once?\\pI don't think he's going to listen to\\nany reason the way he is now.$"}
text:MauvilleCity.WallyPleaseBattleMe	{'body': 'WALLY: {PLAYER}, please!\\nOne battle.$'}
text:MauvilleCity.WallyHereICome	{'body': "WALLY: Thank you, {PLAYER}!\\pAll right, everyone. Let's show\\nthem what we can do!$"}
text:MauvilleCity.WallyDefeat	{'body': 'WALLY: I… I lost.\\pI really thought we were ready…$'}
text:MauvilleCity.WallyIllGoBackToVerdanturf	{'body': "WALLY: UNCLE… I'll go back to\\nVERDANTURF.\\pBut I don't want to give up.\\nKIRLIA and I still have so much to\\llearn.$"}
text:MauvilleCity.ThankYouNotEnoughToBattle	{'body': "{PLAYER}, thank you.\\nBeing a TRAINER is tough, isn't it?\\pIt's not enough just to have POKéMON\\nand make them battle. That isn't what\\lbeing a real TRAINER is about.$"}
text:MauvilleCity.UncleNoNeedToBeDown	{'body': "UNCLE: WALLY, there's no need to be so\\ndown on yourself.\\pWhy, what's keeping you from becoming\\nstronger and stronger?\\pCome on, let's go home.\\nEveryone's waiting for you.$"}
text:MauvilleCity.UncleVisitUsSometime	{'body': "UNCLE: {PLAYER}{KUN}, it just dawned on me\\nthat you must be the TRAINER who kept\\lan eye out for WALLY when he caught\\lhis POKéMON.\\pWhy don't you visit us in VERDANTURF\\nsometime?\\lI'm sure WALLY would enjoy it.$"}
text:MauvilleCity.WallyPokenavCall	{'body': '… … … … … …\\n… … … … … Beep!\\pWALLY: Oh, hello, {PLAYER}!\\pI just wanted to tell you that\\nmy uncle bought me a POKéNAV!\\pNow I can get in touch with you\\nanytime, {PLAYER}!\\p… … … … … …\\n… … … … … Click!$'}
text:MauvilleCity.RegisteredWally	{'body': 'Registered WALLY\\nin the POKéNAV.$'}
text:MauvilleCity.ScottYouDidntHoldBack	{'body': "SCOTT: Hehe…\\nI was watching that match!\\pYou're friends with that boy WALLY,\\naren't you?\\pBut you didn't hold anything back\\nand beat him impressively.\\pYeah! That's what a real POKéMON\\nbattle is all about!\\pI idolize TRAINERS like that!\\p… … … … … …\\nI'll be cheering for you!$"}
text:MauvilleCity.WattsonNeedFavorTakeKey	{'body': "WATTSON: Oh, {PLAYER}{KUN}!\\nYou look like you have a lot of zip!\\lThat's a good thing, wahahahaha!\\pFine! I've decided!\\nI need a favor, {PLAYER}{KUN}!\\pMAUVILLE CITY has an underground\\nsector called NEW MAUVILLE.\\p{PLAYER}{KUN}, I'd like you to go there and\\nswitch off the GENERATOR.\\pThe GENERATOR has been running a bit\\nhaywire. It's getting unsafe.\\pHere, this is the KEY to get into\\nNEW MAUVILLE.$"}
text:MauvilleCity.WattsonWontBeChallenge	{'body': "WATTSON: Don't you worry about it.\\nIt won't be a challenge to you.\\pThe entrance to NEW MAUVILLE is just\\na short SURF away from ROUTE 110.\\pThat's it, then, you have my trust!\\nWahahahaha!\\pWATTSON: If you find MELTAN, level it\\nup in NEW MAUVILLE to get MELMETAL.\\lThe generator can be on or off!$"}
text:MauvilleCity.WattsonThanksTakeElectirizer	{'body': "WATTSON: Wahahahaha! I knew I'd made\\nthe right choice asking you!\\pThis ELECTIRIZER came from the old\\nGENERATOR. You've earned it!$"}
text:MauvilleCity.WattsonYoungTakeCharge	{'body': 'WATTSON: Wahahahaha!\\pIt pleases me to no end to see\\nthe young step up and take charge!\\pWATTSON: If you find MELTAN, level it\\nup in NEW MAUVILLE to get MELMETAL.\\lThe generator can be on or off!$'}
text:MauvilleCity.NurseHurtMonBackToHealth	{'body': "You know, it's cool to have POKéMON\\nbattles and stuff…\\pBut if your POKéMON gets hurt,\\nyou have to nurse it back to health.$"}
text:MauvilleCity.AllSortsOfPeopleComeThrough	{'body': 'The roads of this town stretch north\\nand south, and east and west.\\pBecause of that, we get all sorts of\\npeople coming through.$'}
text:MauvilleCity.RydelVeryGenerous	{'body': "Have you been to RYDEL'S CYCLES yet?\\pRYDEL, the owner, is a very generous\\nman.$"}
text:MauvilleCity.PokemonCanJumpYouOnBike	{'body': "Even if you're riding a BIKE,\\nwild POKéMON could jump you.$"}
text:MauvilleCity.CitySign	{'body': 'MAUVILLE CITY\\n“The bright and shiny city of fun!”$'}
text:MauvilleCity.GymSign	{'body': 'MAUVILLE CITY POKéMON GYM\\nLEADER: WATTSON\\l“The cheerfully electrifying man!”$'}
text:MauvilleCity.BikeShopSign	{'body': "“Ride in gravel and shake up your\\nsoul!”\\lRYDEL'S CYCLES$"}
text:MauvilleCity.GameCornerSign	{'body': '“The play spot for all!”\\nMAUVILLE GAME CORNER$'}
text:MauvilleCity.ExplainTV	{'body': "Hi, do you check out TV at all?\\pThey've added a bunch of cool new\\nshows recently.\\pTV is so cool. I've seen my friends on\\nTV just out of the blue.\\pAnd, sometimes, they even put you on TV\\nwithout telling you.\\pI wish I would be on TV sometime.\\pThat's why I think you should check\\nout TVs whenever you can.$"}
text:MauvilleCity.BeenCheckingOutTV	{'body': 'Hi, have you been checking out TVs?$'}
text:MauvilleCity_BikeShop.RydelGreeting	{'body': "Well, well, what have we here?\\nA most energetic customer!\\pMe? You may call me RYDEL.\\nI'm the owner of this cycle shop.$"}
text:MauvilleCity_BikeShop.DidYouComeFromFarAway	{'body': "RYDEL: Your RUNNING SHOES…\\nThey're awfully filthy.\\pDid you come from far away?$"}
text:MauvilleCity_BikeShop.GuessYouDontNeedBike	{'body': 'RYDEL: Is that right?\\pThen, I guess you have no need for\\nany of my BIKES.$'}
text:MauvilleCity_BikeShop.ExplainBikesChooseWhichOne	{'body': "RYDEL: Hm, hm… … … … …\\pYou're saying that you came all this\\nway from LITTLEROOT?\\pMy goodness!\\nThat's ridiculously far!\\pIf you had one of my BIKES, you could\\ngo anywhere easily while feeling the\\lgentle caress of the wind!\\pI'll tell you what!\\nI'll give you a BIKE!\\pOh, wait a second!\\pI forgot to tell you that there are\\ntwo kinds of BIKES!\\pThey are the MACH BIKE and\\nthe ACRO BIKE!\\pThe MACH BIKE is for cyclists who want\\nto feel the wind with their bodies!\\pAnd an ACRO BIKE is for those who\\nprefer technical rides!\\pI'm a real sweetheart, so you can\\nhave whichever one you like!\\pWhich one will you choose?$"}
text:MauvilleCity_BikeShop.ChoseMachBike	{'body': '{PLAYER} chose the MACH BIKE.$'}
text:MauvilleCity_BikeShop.ChoseAcroBike	{'body': '{PLAYER} chose the ACRO BIKE.$'}
text:MauvilleCity_BikeShop.ComeBackToSwitchBikes	{'body': 'RYDEL: If you get the urge to switch\\nBIKES, just come see me!$'}
text:MauvilleCity_BikeShop.WantToSwitchBikes	{'body': 'RYDEL: Oh? Were you thinking about\\nswitching BIKES?$'}
text:MauvilleCity_BikeShop.IllSwitchBikes	{'body': "RYDEL: Okay, no problem!\\nI'll switch BIKES for you!$"}
text:MauvilleCity_BikeShop.ExchangedMachForAcro	{'body': '{PLAYER} got the MACH BIKE exchanged\\nfor an ACRO BIKE.$'}
text:MauvilleCity_BikeShop.ExchangedAcroForMach	{'body': '{PLAYER} got the ACRO BIKE exchanged\\nfor a MACH BIKE.$'}
text:MauvilleCity_BikeShop.HappyYouLikeIt	{'body': "RYDEL: Good, good!\\nI'm happy that you like it!$"}
text:MauvilleCity_BikeShop.OhYourBikeIsInPC	{'body': "Oh? What happened to that BIKE\\nI gave you?\\pOh, I get it, you stored it using your PC.\\pWell, take it out of PC storage,\\nand I'll be happy to exchange it!\\pMay the wind always be at your back\\non your adventure!$"}
text:MauvilleCity_BikeShop.HandbooksAreInBack	{'body': "I'm learning about BIKES while\\nI work here.\\pIf you need advice on how to ride your\\nBIKE, there're a couple handbooks in\\lthe back.$"}
text:MauvilleCity_BikeShop.MachHandbookWhichPage	{'body': "It's a handbook on the MACH BIKE.\\pWhich page do you want to read?$"}
text:MauvilleCity_BikeShop.HowToRideMachBike	{'body': 'A BIKE moves in the direction that\\nthe + Control Pad is pressed.\\pIt will speed up once it gets rolling.\\pTo stop, release the + Control Pad.\\nThe BIKE will slow to a stop.\\pWant to read a different page?$'}
text:MauvilleCity_BikeShop.HowToTurnMachBike	{'body': "A MACH BIKE is speedy, but it can't\\nstop very quickly.\\pIt gets a little tricky to get around\\na corner.\\pRelease the + Control Pad a little\\nbefore the corner and slow down.\\pWant to read a different page?$"}
text:MauvilleCity_BikeShop.SandySlopes	{'body': 'There are small sandy slopes\\nthroughout the HOENN region.\\pThe loose, crumbly sand makes it\\nimpossible to climb normally.\\pBut if you have a MACH BIKE, you can\\nzip up a sandy slope.\\pWant to read a different page?$'}
text:MauvilleCity_BikeShop.AcroHandbookWhichPage	{'body': "It's a handbook on the ACRO BIKE.\\pWhich page do you want to read?$"}
text:MauvilleCity_BikeShop.Wheelies	{'body': 'Press the B Button while riding,\\nand the front wheel lifts up.\\pYou can zip around with the front\\nwheel up using the + Control Pad.\\pThis technique is called a wheelie.\\pWant to read a different page?$'}
text:MauvilleCity_BikeShop.BunnyHops	{'body': 'Keeping the B Button pressed,\\nyour BIKE can hop on the spot.\\pThis technique is called a bunny hop.\\pYou can ride while hopping, too.\\pWant to read a different page?$'}
text:MauvilleCity_BikeShop.Jumps	{'body': 'Press the B Button and the + Control\\nPad at the same time to jump.\\pPress the + Control Pad to the side\\nto jump sideways.\\pPress it backwards to make the BIKE\\nchange directions while jumping.\\pWant to read a different page?$'}
text:MauvilleCity_GameCorner.ConfirmPokemonPrize	{'body': 'Exchange your Coins for {STR_VAR_1}?$'}
text:MauvilleCity_GameCorner.PokemonPrizeReceived	{'body': '{STR_VAR_1} arrived battle-ready!\\pIts moves, nature, Ability, and item\\nmatch a competitive set.$'}
text:MauvilleCity_GameCorner.AlreadyReceivedPokemonPrize	{'body': 'That unique prize has already been\\nclaimed.$'}
text:MauvilleCity_GameCorner.WhichStarterRegion	{'body': 'Starters cost 500 Coins each.\\nWhich region should I open?$'}
text:MauvilleCity_GameCorner.PokemonPrizeSetFailed	{'body': 'That battle set is unavailable.\\nNo Coins or prize claim were used.$'}
text:MauvilleCity_GameCorner.ThisIsMauvilleGameCorner	{'body': 'This is MAUVILLE GAME CORNER.$'}
text:MauvilleCity_GameCorner.NeedCoinCaseForCoins	{'body': "Okay, you wanted some COINS for\\nthe games?\\pBut you don't have a COIN CASE for\\nstowing the COINS.$"}
text:MauvilleCity_GameCorner.WereYouLookingForCoins	{'body': "Were you looking for COINS?\\pIt's ¥1000 for 50 COINS.\\nWould you like some?$"}
text:MauvilleCity_GameCorner.ThankYouHereAreYourCoins	{'body': 'Thank you very much!\\nHere are your COINS!$'}
text:MauvilleCity_GameCorner.DontHaveEnoughMoney	{'body': "Um… You don't appear to have\\nenough money…$"}
text:MauvilleCity_GameCorner.CoinCaseIsFull	{'body': 'Oh?\\nYour COIN CASE is full.$'}
text:MauvilleCity_GameCorner.DontNeedCoinsThen	{'body': "Oh… You don't need COINS, then?\\nGood luck on your adventure!$"}
text:MauvilleCity_GameCorner.ExchangeCoinsForPrizes	{'body': 'Welcome.\\pYou can exchange your COINS for\\nprizes here.$'}
text:MauvilleCity_GameCorner.WhichPrize	{'body': 'Which prize would you like?$'}
text:MauvilleCity_GameCorner.SendToYourHomePC	{'body': "Thank you!\\nWe'll send it to your PC at home.$"}
text:MauvilleCity_GameCorner.NotEnoughCoins	{'body': "You don't have enough COINS.$"}
text:MauvilleCity_GameCorner.NoRoomForPlacingDecor	{'body': "There isn't any room available for\\nplacing {STR_VAR_1}.$"}
text:MauvilleCity_GameCorner.OhIsThatSo	{'body': 'Oh, is that so? \\nYou need to save some COINS before\\lcoming back here.$'}
text:MauvilleCity_GameCorner.SoYourChoiceIsX	{'body': 'So your choice is {STR_VAR_1}?$'}
text:MauvilleCity_GameCorner.CantCarryAnyMore	{'body': "Oh, you can't carry any more than that.$"}
text:MauvilleCity_GameCorner.GotTwoOfSameDollWantOne	{'body': 'I made a mistake and got two of\\nthe same DOLLS.\\pWould you like one of them?$'}
text:MauvilleCity_GameCorner.HereYouGo2	{'body': 'Here you go!$'}
text:MauvilleCity_GameCorner.YouWantItButNotNow	{'body': 'Huh?\\nYou want it, but not right now?$'}
text:MauvilleCity_GameCorner.DontBeNegative	{'body': "Oh, don't be so negative!\\nYou can have this!$"}
text:MauvilleCity_GameCorner.CantWinJackpot	{'body': "There's a prize I want, but I can't win\\nthe jackpot.$"}
text:MauvilleCity_GameCorner.NeedCoinCaseGoNextDoor	{'body': 'Hey, kid, if you want to play here,\\nyou need a COIN CASE.\\pI think the young lady next door\\nhad one. Go see her!$'}
text:MauvilleCity_GameCorner.LuckOnlyLastSoLongTakeCoins	{'body': 'My luck can only last so long.\\nThis is too much for me.\\lHere, take some COINS!$'}
text:MauvilleCity_GameCorner.MauvilleSomethingForEveryone	{'body': "MAUVILLE has something for\\neveryone.\\pFor me, it's the GAME CORNER.$"}
text:MauvilleCity_GameCorner.RouletteTablesDifferentRates	{'body': "The ROULETTE tables have different\\nrates.\\pCheck your COINS if you're going to\\npick a table.$"}
text:MauvilleCity_GameCorner.EasyToLoseTrackOfTime	{'body': "It's easy to lose track of time in here. \\nI should get back to work.$"}
text:MauvilleCity_GameCorner.CoinsAreNeededToPlay	{'body': 'COINS are needed to play here\\nin the GAME CORNER.$'}
text:MauvilleCity_GameCorner.RouletteOnlyLuck	{'body': "This ROULETTE thing…\\nIt's rather demanding.\\pWin or lose, it's only by luck.$"}
text:MauvilleCity_GameCorner.UpTo3CoinsCanBeUsed	{'body': 'Up to three COINS can be used to play\\nthe SLOTS.$'}
text:MauvilleCity_GameCorner.DifficultToStopOn7	{'body': "It's very difficult to make it stop\\nright on “7.”\\pIf it stops on “7” during the REEL TIME\\nbonus game, you'll receive extra COINS.$"}
text:MauvilleCity_GameCorner.HeresSomeSlotsInfo	{'body': "Here's some information for you\\nabout the SLOTS.\\pThe more lightning bolts you stock,\\nthe more REEL TIME chances you get.\\pIn a game with the maximum five\\nREEL TIME chances…\\pIt is possible to receive four regular\\nbonuses, then a big bonus.\\pThat would total 660 COINS, but it's\\nvery difficult to get.$"}
text:MauvilleCity_GameCorner.CantPlayWithNoCoinCase	{'body': "You can't play if you don't have\\na COIN CASE.$"}
text:MauvilleCity_GameCorner.AlreadyCaughtLegendary	{'body': 'You have already befriended this\\nlegendary Pokémon.\\pYour Coins have not been spent.$'}
text:MauvilleCity_Gym.GymGuideAdvice	{'body': "Hey, how's it going, CHAMPION-\\nbound {PLAYER}?\\pWATTSON, the LEADER of MAUVILLE\\nGYM, uses ELECTRIC-type POKéMON.\\pIf you challenge him with WATER-type\\nPOKéMON, he'll zap them! Bzzt!\\pAnd, he's put in switch-controlled\\ndoors all over his GYM! Eccentric!\\pHey, go for it!$"}
text:MauvilleCity_Gym.GymGuidePostVictory	{'body': "Whoa, you're electrifying!\\nYou've powered the door open!$"}
text:MauvilleCity_Gym.KirkIntro	{'body': "PINCURCHIN floors the whole stage,\\nand EMOLGA turns bolts into speed.\\pFind the current's blind spot!$"}
text:MauvilleCity_Gym.KirkDefeat	{'body': 'You shut down my amplifier!$'}
text:MauvilleCity_Gym.KirkPostBattle	{'body': 'ELECTRIC TERRAIN protects grounded\\nPokémon from sleep.\\pA Flying Pokémon or an AIR BALLOON\\nchanges which benefits apply.$'}
text:MauvilleCity_Gym.ShawnIntro	{'body': 'Some of my Pokémon float above\\nGround attacks. Others use the\\lterrain beneath them.\\pCan you tell which answer fits\\neach pair?$'}
text:MauvilleCity_Gym.ShawnDefeat	{'body': 'You broke our live connection…$'}
text:MauvilleCity_Gym.ShawnPostBattle	{'body': "BELLIBOLT can set ELECTRIC TERRAIN\\nfor RAICHU's SURGE SURFER.\\pMEGA AMPHAROS brings a different\\npace and a Dragon typing.$"}
text:MauvilleCity_Gym.BenIntro	{'body': 'Send electricity, and LANTURN\\ndrinks it. Send water, and\\lHELIOLISK drinks that.\\pWhat else can your partners do?$'}
text:MauvilleCity_Gym.BenDefeat	{'body': "Our circuit couldn't hold!$"}
text:MauvilleCity_Gym.BenPostBattle	{'body': 'CHARJABUG powers special attacks\\nwith BATTERY. DISCHARGE can even\\lheal LANTURN.\\pThat same move is not safe beside\\nevery partner.$'}
text:MauvilleCity_Gym.VivianIntro	{'body': 'PLUSLE and MINUN amplify each other\\njust by standing side by side.\\pSplit us, or lose to both!$'}
text:MauvilleCity_Gym.VivianDefeat	{'body': "Our partnership wasn't enough!$"}
text:MauvilleCity_Gym.VivianPostBattle	{'body': 'Do not press ELECTRIC attacks into the\\nAbility that wants to absorb them.$'}
text:MauvilleCity_Gym.AngeloIntro	{'body': 'JOLTIK makes THUNDER more\\nreliable, and TOXTRICITY turns\\lsound into power.\\pWe are ready to take our chances!$'}
text:MauvilleCity_Gym.AngeloDefeat	{'body': 'Our relay lost its charge…$'}
text:MauvilleCity_Gym.AngeloPostBattle	{'body': 'WATTREL can set TAILWIND, and\\nJOLTIK can slow opponents with\\lELECTROWEB.\\pThose moves change speed in\\ndifferent ways.$'}
text:MauvilleCity_Gym.WattsonIntro	{'body': 'Wahahahah! I am WATTSON!\\pELECTRODE sends the current.\\nELECTIVIRE turns it into speed.\\pI know how my partners work\\ntogether. Show me what yours can\\ldo!$'}
text:MauvilleCity_Gym.WattsonDefeat	{'body': 'Wahahah! What a battle!\\pYou have earned the DYNAMO BADGE!$'}
text:MauvilleCity_Gym.ReceivedDynamoBadge	{'body': '{PLAYER} received the DYNAMO BADGE\\nfrom WATTSON.$'}
text:MauvilleCity_Gym.ExplainDynamoBadgeTakeThis	{'body': 'The DYNAMO BADGE lets your LEVELER\\ntrain a party up to Lv. 40.\\pIt also enables ROCK SMASH outside\\nof battle.\\pHmm…\\nYou should take this, too!$'}
text:MauvilleCity_Gym.ExplainManectite	{'body': 'Manectite lets Manectric Mega Evolve.\\nLet it hold the stone in battle.$'}
text:MauvilleCity_Gym.RegisteredWattson	{'body': 'Registered GYM LEADER WATTSON\\nin the POKéNAV.$'}
text:MauvilleCity_Gym.WattsonPostBattle	{'body': 'Head north on ROUTE 111. My crew\\nwill let you through with that BADGE.\\pTurn west onto ROUTE 112 and go\\nthrough FIERY PATH to ROUTE 113.\\pFollow it west to FALLARBOR TOWN.\\nAsk there about the trouble at\\pMETEOR FALLS, down ROUTE 114.$'}
text:MauvilleCity_Gym.WattsonMtChimney	{'body': 'Head north on ROUTE 111, then west\\nonto ROUTE 112.\\pTake the cable car up MT. CHIMNEY.\\nStop TEAM MAGMA at the crater.$'}
text:MauvilleCity_Gym.WattsonLavaridge	{'body': "Take ROUTE 112's cable car up\\nMT. CHIMNEY, then descend JAGGED PASS.\\pThat leads to LAVARIDGE TOWN.\\nChallenge FLANNERY at the GYM.$"}
text:MauvilleCity_Gym.WattsonGoForthAndEndeavor	{'body': 'Wahahahah!\\nGo forth and endeavor, youngster!$'}
text:MauvilleCity_Gym.GymStatue	{'body': 'MAUVILLE CITY POKéMON GYM$'}
text:MauvilleCity_Gym.GymStatueCertified	{'body': "MAUVILLE CITY POKéMON GYM\\pWATTSON'S CERTIFIED TRAINERS:\\n{PLAYER}$"}
text:MauvilleCity_Gym.WattsonPreRematch	{'body': "WATTSON: Ah-ha! Here at last!\\nI know what you want.\\lYou want to battle my POKéMON!\\pWahahahaha!\\pI'll make sparks fly from you!\\nDon't say I didn't warn you!$"}
text:MauvilleCity_Gym.WattsonRematchDefeat	{'body': 'Oof…\\nOur batteries ran dry…$'}
text:MauvilleCity_Gym.WattsonPostRematch	{'body': "WATTSON: We'll have to recharge our\\nbatteries again.\\pWhen we're fully charged up, we'll\\ngladly accept your challenge.\\pSo, come back again sometime,\\nwon't you?$"}
text:MauvilleCity_Gym.WattsonRematchNeedTwoMons	{'body': "WATTSON: Ah-ha! Here at last!\\nI know what you want.\\lYou want to battle my POKéMON!\\pWahahahaha!\\pOops! Wait!\\nYou've only one POKéMON with you!\\pCome see me with two or more\\nPOKéMON, all right?$"}
text:MauvilleCity_House1.ImRockSmashDudeTakeThis	{'body': 'Woohoo!\\pI hear people call me the ROCK SMASH\\nGUY, but I find that sort of degrading.\\pI think I deserve a bit more respect,\\nlike maybe the ROCK SMASH DUDE.\\pWoohoo!\\pAnyways, your POKéMON look pretty\\nstrong.\\pI like that!\\nHere, take this HIDDEN MACHINE!$'}
text:MauvilleCity_House1.ExplainRockSmash	{'body': 'That HM registers ROCK SMASH for\\nyour team!\\pWith the DYNAMO BADGE and a\\ncompatible partner, you can smash\\lcracked rocks in your path.\\pNo need to use a battle move slot.\\nSmash rocks aside, I say! Woohoo!$'}
text:MauvilleCity_House1.MonCanFlyOutOfSmashedRock	{'body': 'Oh, yes, if you smash a rock, a POKéMON\\ncould come flying out of hiding.\\pWoohoo!$'}
text:MauvilleCity_House2.MoveSpecialist	{'body': 'I studied the PLEDGE moves and the\\nthree ultimate starter techniques.\\pThe POKéMON CENTER specialist can\\nteach all six now, free of charge.$'}
text:MauvilleCity_House2.BuyHarborMailAtSlateport	{'body': "If I had a BIKE, it'd be easy to cycle to\\nSLATEPORT for some shopping.\\pI'd be able to buy HARBOR MAIL at the\\nPOKéMON MART in SLATEPORT…$"}
text:MauvilleCity_House2.TradeHarborMailForCoinCase	{'body': 'Oh! You have HARBOR MAIL?\\nWill you trade it for a COIN CASE?$'}
text:MauvilleCity_House2.IllTradeYouCoinCase	{'body': "Oh, I'm so happy!\\nOkay, I'll trade you a COIN CASE!$"}
text:MauvilleCity_House2.UseCoinCaseAtGameCorner	{'body': 'That COIN CASE can be used\\nat the GAME CORNER.$'}
text:MauvilleCity_House2.ThatsDisappointing	{'body': "Oh, that's disappointing.\\pA COIN CASE is needed for the\\nGAME CORNER.$"}
text:MauvilleCity_House2.MegaGift_AMPHAROSITE_Text	{'body': 'An Ampharos can light a road for\\neveryone following behind it.\\pTake this stone. A strong partner\\ncan help others find their way.$'}
text:MauvilleCity_Mart.ItemsToTemporarilyElevateStats	{'body': 'Trainer battles do not allow BAG\\nitems. This shop stocks\\lspecialized POKé BALLS instead,\\lso you can build more teams.$'}
text:MauvilleCity_Mart.DecisionsDetermineBattle	{'body': "Choose a move, switch a partner, or\\nprotect a position…\\pThe TRAINER's decisions determine how\\nbattles turn out.$"}
text:MauvilleCity_PokemonCenter_1F.ManOverThereSaysWeirdThings	{'body': "That man over there, he says weird\\nthings!\\pHe's funny in a weird way.\\nI doubt I'll forget about him!$"}
text:MauvilleCity_PokemonCenter_1F.MyDataUpdatedFromRecordCorner	{'body': "When I accessed the RECORD CORNER,\\nthe data for what's hot in DEWFORD\\lgot updated.\\pNow that bit of data is the same\\nas my friend's!$"}
text:MauvilleCity_PokemonCenter_1F.RecordCornerSoundsFun	{'body': "A RECORD CORNER opened upstairs in\\nthe POKéMON CENTER.\\pI don't know what it's about, but it\\nsounds fun. I'll go check it out!$"}
text:MauvilleCity_PokemonCenter_2F.Youngster	{'body': "Did you know that you can link battle\\nat the COLOSSEUM here?\\pThey put up your record on the wall\\nfor everyone to see.\\pIt's embarrassing if you lose more\\noften than you win…$"}
text:MeteorFalls_1F_1R.RivalAfterBattleRestored	{'body': "MAGMA took the METEORITE toward\\nMT. CHIMNEY. We have to follow.\\pTake ROUTE 112's cable car\\nup to the summit.$"}
text:MeteorFalls_1F_1R.WithThisMeteorite	{'body': "The METEORITE is secured. Its\\nenergy will feed MAXIE's machine\\lat MT. CHIMNEY!$"}
text:MeteorFalls_1F_1R.DontExpectMercyFromMagma	{'body': "COURTNEY: The METEORITE is ours.\\pYou won't take it from us. I'll\\nstop you here.$"}
text:MeteorFalls_1F_1R.CourtneyDefeat	{'body': 'COURTNEY: You broke through…$'}
text:MeteorFalls_1F_1R.GruntDefeat	{'body': 'We lost, even here?!$'}
text:MeteorFalls_1F_1R.HoldItRightThereMagma	{'body': 'Hold it, TEAM MAGMA! If you set\\noff that volcano, the whole coast\\lwill suffer!$'}
text:MeteorFalls_1F_1R.BeSeeingYouTeamAqua	{'body': 'COURTNEY: AQUA arrived sooner\\nthan projected. The result is\\lunchanged.\\pWe have the METEORITE. MAXIE is\\nalready preparing the machine at\\lMT. CHIMNEY.\\pFollow us if you want to see the\\nland rise.$'}
text:MeteorFalls_1F_1R.ArchieSeenYouBefore	{'body': "ARCHIE: We met at SLATEPORT's\\nMUSEUM. {PLAYER}, wasn't it?\\pYou stopped my crew there. But we\\nboth know what MAGMA is planning\\lnow.\\pIf MAXIE sets off MT. CHIMNEY,\\nthe lava could destroy habitats\\lall the way to the coast.\\pWe're going after him. You can\\nhelp, if you mean to stop that\\leruption.$"}
text:MeteorFalls_1F_1R.BossWeShouldChaseMagma	{'body': 'BOSS, we should give chase to\\nTEAM MAGMA…$'}
text:MeteorFalls_1F_1R.ArchieYesNoTellingWhatMagmaWillDo	{'body': 'ARCHIE: Right! No time to waste.\\nGet to MT. CHIMNEY before MAXIE\\lstarts that machine!$'}
text:MeteorFalls_1F_1R.ArchieFarewell	{'body': "ARCHIE: ROUTE 112's cable car\\nleads to the summit. We'll see\\lyou there, {PLAYER}!$"}
text:MeteorFalls_1F_1R.MeetProfCozmo	{'body': "I'm PROF. COZMO. MAGMA asked me\\nto study the METEORITE's energy.\\pI thought it was geological\\nresearch. They took the sample\\land my readings.\\pThat energy could trigger an\\neruption at MT. CHIMNEY. People\\land POKéMON would lose their\\lhomes!$"}
text:MeteorFalls_1F_1R.WhatsTeamMagmaDoingAtMtChimney	{'body': "PROF. COZMO: MAGMA plans to use\\nthe METEORITE to power a machine\\lat the volcano.\\pPlease stop them before it\\nerupts! ROUTE 112's cable car\\lgoes to MT. CHIMNEY's summit.$"}
text:MeteorFalls_1F_2R.MoveSpecialist	{'body': 'I once guarded the secret of\\nDRAGON ASCENT here.\\pThe POKéMON CENTER specialist now\\nteaches every legal move.$'}
text:MeteorFalls_1F_2R.NicolasIntro	{'body': 'This is where we DRAGON users do our\\ntraining.\\pThe CHAMPION even visits.\\nNow do you see how special it is here?$'}
text:MeteorFalls_1F_2R.NicolasDefeat	{'body': "Urgh!\\nI didn't expect you to be so strong!$"}
text:MeteorFalls_1F_2R.NicolasPostBattle	{'body': "With the FEATHER BADGE and\\nREGIROCK recorded as caught,\\lREGIDRAGO can appear on this\\lfloor.\\pIt has a 1% wild encounter\\nchance. SWEET SCENT raises that\\lto 25%.\\pFALLARBOR's CENTER guide knows\\nthe discoveries in the other\\lMETEOR FALLS rooms.$"}
text:MeteorFalls_1F_2R.NicolasRegidragoCaught	{'body': "You've caught REGIDRAGO!\\nWhat a partner to train beside.\\pFALLARBOR's CENTER guide knows\\nthe legends in the other rooms.$"}
text:MeteorFalls_1F_2R.NicolasRegister	{'body': 'I want to know more about your power.\\nLet me register you in my POKéNAV.$'}
text:MeteorFalls_1F_2R.NicolasRematchIntro	{'body': "Since we met, we have trained hard\\nwith our sights on number one.\\pHelp us see how much stronger we've\\nbecome!$"}
text:MeteorFalls_1F_2R.NicolasRematchDefeat	{'body': "Urgh!\\nI didn't expect you to be so strong!$"}
text:MeteorFalls_1F_2R.NicolasPostRematch	{'body': "You've obviously kept up your\\nPOKéMON training.\\pSo long as you remain strong, I, too,\\ncan become stronger!$"}
text:MeteorFalls_1F_2R.JohnIntro	{'body': "JOHN: We've always battled POKéMON\\ntogether as a twosome.\\lWe've confidence in ourselves.$"}
text:MeteorFalls_1F_2R.JohnDefeat	{'body': "JOHN: Oh, my.\\nWe've lost, dear wife.$"}
text:MeteorFalls_1F_2R.JohnPostBattle	{'body': "JOHN: We've been married for\\nfifty years.\\pCome to think of it, I've yet to beat\\nmy dear wife in a battle.$"}
text:MeteorFalls_1F_2R.JohnNotEnoughMons	{'body': "JOHN: Well, well, what a young TRAINER!\\pWill you battle with us? If so, you'll\\nhave to return with more POKéMON.$"}
text:MeteorFalls_1F_2R.JohnRegister	{'body': 'JOHN: Young TRAINER, may we trade\\nnotes on teamwork through MATCH CALL?$'}
text:MeteorFalls_1F_2R.JayIntro	{'body': "JAY: We've been married for\\nfifty years.\\pThe bond we share as a couple could\\nnever be broken.$"}
text:MeteorFalls_1F_2R.JayDefeat	{'body': "JAY: Oh, dear.\\nWe've lost, my dear husband.$"}
text:MeteorFalls_1F_2R.JayPostBattle	{'body': 'JAY: Fifty years of marriage…\\pIf we ever argued, we always settled\\nit with a POKéMON battle…$'}
text:MeteorFalls_1F_2R.JayNotEnoughMons	{'body': "JAY: Well, well, aren't you a young\\nTRAINER?\\pIf you'd care to battle with us, you'll\\nhave to come back with more POKéMON.$"}
text:MeteorFalls_1F_2R.JohnRematchIntro	{'body': "JOHN: We've always battled POKéMON\\ntogether as a twosome.\\lWe've confidence in ourselves.$"}
text:MeteorFalls_1F_2R.JohnRematchDefeat	{'body': "JOHN: Oh, my.\\nWe've lost, dear wife.$"}
text:MeteorFalls_1F_2R.JohnPostRematch	{'body': 'JOHN: Married for fifty years…\\pOn reflection, the dear wife and I,\\nwe battled day in and day out…$'}
text:MeteorFalls_1F_2R.JohnRematchNotEnoughMons	{'body': "JOHN: Well, well, what a young TRAINER!\\pWill you battle with us? If so, you'll\\nhave to return with more POKéMON.$"}
text:MeteorFalls_1F_2R.JayRematchIntro	{'body': "JAY: We've been married for\\nfifty years.\\pWe've supported each other all that\\ntime. We've made ourselves strong.$"}
text:MeteorFalls_1F_2R.JayRematchDefeat	{'body': "JAY: Oh, dear.\\nWe've lost, my dear husband.$"}
text:MeteorFalls_1F_2R.JayPostRematch	{'body': 'JAY: Fifty years of marriage…\\nMany things have happened.\\pI hope that we will continue to make\\nhappy memories together.$'}
text:MeteorFalls_1F_2R.JayRematchNotEnoughMons	{'body': "JAY: Well, well, aren't you a young\\nTRAINER?\\pIf you'd care to battle with us, you'll\\nhave to come back with more POKéMON.$"}
text:MeteorFalls_StevensCave.ShouldKnowHowGoodIAmExpectWorst	{'body': "STEVEN: Oh, wow, {PLAYER}{KUN}.\\nI'm amazed you knew where to find me.\\pDo you, uh…maybe think of me as\\njust a rock maniac?\\pNo, that can't be right.\\pWe battled alongside each other at\\nthe MOSSDEEP SPACE CENTER.\\pYou should have a very good idea\\nabout how good I am.\\pOkay, {PLAYER}{KUN}, if you're going to mount\\na serious challenge, expect the worst!$"}
text:MeteorFalls_StevensCave.StevenDefeat	{'body': "You…\\nI had no idea you'd become so strong…$"}
text:MeteorFalls_StevensCave.MyPredictionCameTrue	{'body': "STEVEN: Come to think of it, ever since\\nour paths first crossed in GRANITE\\lCAVE in DEWFORD, I had this feeling.\\pI thought that you would eventually\\nbecome the CHAMPION.\\pMy predictions usually come true.\\pAnd where will you go from here?\\p… … … … … …\\n… … … … … …\\pFufufu, even I couldn't tell you that.$"}
text:MirageTower_4F.TakeRootFossil	{'body': 'You found the ROOT FOSSIL.\\pIf this FOSSIL is taken, the ground\\naround it will likely crumble away…\\pTake the ROOT FOSSIL anyway?$'}
text:MirageTower_4F.LeftRootFossilAlone	{'body': '{PLAYER} left the ROOT FOSSIL alone.$'}
text:MirageTower_4F.TakeClawFossil	{'body': 'You found the CLAW FOSSIL.\\pIf this FOSSIL is taken, the ground\\naround it will likely crumble away…\\pTake the CLAW FOSSIL anyway?$'}
text:MirageTower_4F.LeaveClawFossilAlone	{'body': '{PLAYER} left the CLAW FOSSIL alone.$'}
text:MirageTower_B1F.Inscription	{'body': 'The inscription reads:\\pWHEN LAND, SEA, AND SKY CONTEST, THE\\nCELLS OF ORDER GATHER BELOW.$'}
text:MossdeepCity.WantKingsRockStevenGaveMe	{'body': "I got this from STEVEN, but I don't\\nknow what it's good for.\\pI think it's called KING'S ROCK.\\nDo you want it?$"}
text:MossdeepCity.YouCanKeepIt	{'body': "Why would you want it?\\nYou're weird.\\pYou can keep it, but keep it a secret\\nfrom STEVEN.$"}
text:MossdeepCity.StevensHouseOverThere	{'body': "STEVEN's house is right over there!$"}
text:MossdeepCity.WhatToDoWithWeirdRock	{'body': 'Yeah, you think so, too! What are you\\nsupposed to do with some weird rock?$'}
text:MossdeepCity.WailmerWatching	{'body': "Around MOSSDEEP, you can see wild\\nWAILMER.\\pIt's called, uh…\\nWhat was it now…\\pWAI, WAI, WAI…\\pWAILMER watching!$"}
text:MossdeepCity.SpaceCenterReceivedLetter	{'body': "The island's SPACE CENTER has been\\nlaunching huge rockets.\\pThere's been some kind of an uproar\\nover a letter they received recently.$"}
text:MossdeepCity.SpaceCenterLaunchingRockets	{'body': "The island's SPACE CENTER has been\\nlaunching huge rockets.$"}
text:MossdeepCity.MossdeepTargetedByMagma	{'body': "I heard from a SAILOR buddy that\\nTEAM AQUA set up shop in LILYCOVE.\\pI also heard that someone came along\\nand wiped the floor with them!\\pBut MOSSDEEP here's been targeted\\nby that TEAM MAGMA.\\pIf you want to know what they're up to,\\ngo visit the SPACE CENTER.$"}
text:MossdeepCity.FeelReliefOnLand	{'body': "I'm a SAILOR, so the sea's obviously\\nmore important to me.\\pBut you know? When I get back on land\\nafter a long voyage, I do feel relief!$"}
text:MossdeepCity.NiceIfWorldCoveredByFlowers	{'body': "Wouldn't it be nice?\\pIf the whole world was covered in\\nplants and flowers like this island?$"}
text:MossdeepCity.LifeNeedsSeaToLive	{'body': 'MANAPHY and PALKIA live on the\\nSEAFLOOR CAVERN seabed.\\pDIVE at ROUTE 128 and search near\\nthe submarine. Each has a 3%\\lwild encounter chance.$'}
text:MossdeepCity.SurfExhilarating	{'body': "A voyage on a ship is fine.\\pBut crossing the sea with POKéMON\\nusing SURF…\\pNow that's an exhilarating trip!\\nWouldn't you agree, youngster?$"}
text:MossdeepCity.SpecialSpaceCenterRock	{'body': "This rock has a special meaning to\\nthe people at the SPACE CENTER.\\pThey put it here as their wish for\\ntheir rockets to fly safely.\\pWhen you make a wish, what do you use?\\nDo you wish upon a star?\\pI use a wish tag to make it happen.\\nThat's what I do.$"}
text:MossdeepCity.ItsAWhiteRock	{'body': "It's a white rock.$"}
text:MossdeepCity.GymSign	{'body': 'MOSSDEEP CITY POKéMON GYM\\nLEADERS: LIZA & TATE\\p“The mystic combination!”$'}
text:MossdeepCity.CitySign	{'body': 'MOSSDEEP CITY\\n“Our slogan: Cherish POKéMON!”$'}
text:MossdeepCity.SpaceCenterSign	{'body': 'MOSSDEEP SPACE CENTER\\n“The closest place to space.”$'}
text:MossdeepCity.ScottSomethingWrongWithTown	{'body': "SCOTT: {PLAYER}{KUN}! I came to\\nwatch the GYM, but everyone's\\lworried about a threat to the\\lSPACE CENTER.\\pSTEVEN is looking into it. I hope\\nthose researchers are safe.$"}
text:MossdeepCity.SootopolisNewGymLeader	{'body': 'Ahh… It feels great letting the waves\\nwash over my feet…\\pSpeaking of the waves, you know that\\nisland city SOOTOPOLIS?\\pI think the GYM there had a new\\nLEADER come in.\\pPeople tell me the new LEADER once\\nmentored WALLACE.$'}
text:RS_MysteryEventsHouse_OldManGreeting	{'body': "When I was young, I traveled the world\\nas a POKéMON TRAINER.\\pNow that I've become an old buzzard,\\nmy only amusement is watching young\\lTRAINERS battle.$"}
text:RS_MysteryEventsHouse_DoorIsLocked	{'body': 'The door appears to be locked.$'}
text:RS_MysteryEventsHouse_ChallengeVisitingTrainer	{'body': 'A TRAINER named {STR_VAR_1} is\\nvisiting my home.\\pWould you like to challenge\\n{STR_VAR_1}?$'}
text:RS_MysteryEventsHouse_YouWontBattle	{'body': "You won't battle? I'm disappointed\\nthat I can't see you battle…$"}
text:RS_MysteryEventsHouse_KeepItToA3On3	{'body': "Oh, good, good!\\pBut my house isn't all that sturdy.\\pCould I ask you to keep it down to\\na 3-on-3 match?$"}
text:RS_MysteryEventsHouse_SaveYourProgress	{'body': 'Before you two battle, you should\\nsave your progress.$'}
text:RS_MysteryEventsHouse_HopeToSeeAGoodMatch	{'body': 'I hope to see a good match!$'}
text:RS_MysteryEventsHouse_BattleTie	{'body': 'So, it became a standoff.\\pIt was a brilliant match in which\\nneither side conceded a step!$'}
text:RS_MysteryEventsHouse_BattleWon	{'body': 'That was superlative!\\pWhy, it was like seeing myself in\\nmy youth again!$'}
text:RS_MysteryEventsHouse_BattleLost	{'body': 'Ah, too bad for you!\\pBut it was a good match.\\nI hope you can win next time.$'}
text:MossdeepCity_Gym.GymGuideAdvice	{'body': "Yo, how's it going, CHAMPION-bound\\n{PLAYER}?\\pThe GYM LEADERS here use\\nPSYCHIC-type POKéMON.\\pIf you go up against them with\\nFIGHTING- or POISON-type POKéMON,\\lthey'll inflict horrible damage!\\pPlus, they'll come at you with\\noutstanding combination attacks.\\pIf you want to win, you'll need to show\\nthem how tight you are with your\\lPOKéMON. Go for it!$"}
text:MossdeepCity_Gym.GymGuidePostVictory	{'body': "Wow, you're astounding!\\nYou're one great TRAINER!$"}
text:MossdeepCity_Gym.PrestonIntro	{'body': "MAGIC GUARD protects ALAKAZAM from\\npoison damage and hazards.\\pYou'll need a more direct approach!$"}
text:MossdeepCity_Gym.PrestonDefeat	{'body': "I couldn't read your next move.$"}
text:MossdeepCity_Gym.PrestonPostBattle	{'body': "MAGIC GUARD doesn't stop paralysis\\nor sleep. Damage isn't everything.$"}
text:MossdeepCity_Gym.VirgilIntro	{'body': "BRONZONG changes our pace with ROOM.\\nMUSHARNA makes you fear sleep.\\pSlow doesn't mean harmless!$"}
text:MossdeepCity_Gym.VirgilDefeat	{'body': "Our timing wasn't enough…$"}
text:MossdeepCity_Gym.VirgilPostBattle	{'body': 'TRICK ROOM lasts five turns. You can\\nreverse it, or endure until it ends.$'}
text:MossdeepCity_Gym.BlakeIntro	{'body': "MEOWSTIC's screens shelter METANG.\\nKLEFKI and MR. MIME can slow you down.\\pCan you keep the pressure on?$"}
text:MossdeepCity_Gym.BlakeDefeat	{'body': "Our defenses couldn't hold.$"}
text:MossdeepCity_Gym.BlakePostBattle	{'body': 'BRICK BREAK removes our screens.\\nCritical hits can bypass them, too.$'}
text:MossdeepCity_Gym.HannahIntro	{'body': "BRUXISH bites. MALAMAR gets stronger\\nwhen SUPERPOWER should weaken it.\\pOur blades aren't our only weapons!$"}
text:MossdeepCity_Gym.HannahDefeat	{'body': 'Even our sharpest edge fell short.$'}
text:MossdeepCity_Gym.HannahPostBattle	{'body': 'Burns hinder my physical attackers.\\nBut ESPATHRA attacks another way.$'}
text:MossdeepCity_Gym.SamanthaIntro	{'body': "GOTHITELLE closes the exit. AZELF\\nplots, and then ends the board.\\pSwitching won't be so simple!$"}
text:MossdeepCity_Gym.SamanthaDefeat	{'body': "I couldn't keep you in my grasp.$"}
text:MossdeepCity_Gym.SamanthaPostBattle	{'body': 'MAGIC BOUNCE returns your hazards and\\nsleep. ESPEON still fears direct hits.$'}
text:MossdeepCity_Gym.MauraIntro	{'body': 'JYNX starts a countdown.\\nGOTHITELLE makes leaving difficult.\\pThree turns. Can you find a way out?$'}
text:MossdeepCity_Gym.MauraDefeat	{'body': 'The last note belonged to you.$'}
text:MossdeepCity_Gym.MauraPostBattle	{'body': 'GHOST types can leave SHADOW TAG.\\nSOUNDPROOF blocks PERISH SONG.\\pA well-timed pivot can escape, too.$'}
text:MossdeepCity_Gym.SylviaIntro	{'body': 'INDEEDEE and SIGILYPH open for us.\\nDONDOZO and TATSUGIRI wait in reserve.\\pSave an answer for their partnership!$'}
text:MossdeepCity_Gym.SylviaDefeat	{'body': "Even our reserve plan wasn't enough.$"}
text:MossdeepCity_Gym.SylviaPostBattle	{'body': "Inside DONDOZO, TATSUGIRI can't be hit.\\nHAZE can clear DONDOZO's boosts.$"}
text:MossdeepCity_Gym.NateIntro	{'body': 'METAGROSS is tough to break\\nthrough, and MIMIKYU hides behind\\lits DISGUISE.\\pCan you get past both of them?$'}
text:MossdeepCity_Gym.NateDefeat	{'body': 'We ran out of answers.$'}
text:MossdeepCity_Gym.NatePostBattle	{'body': 'Breaking DISGUISE is only a start.\\nMIMIKYU still needs a second answer.$'}
text:MossdeepCity_Gym.KathleenIntro	{'body': 'I am the last door before the twins.\\pLATIAS endures, DRAGAPULT outruns,\\nand TYRANITAR wears you down.\\pProve you belong in there!$'}
text:MossdeepCity_Gym.KathleenDefeat	{'body': "You've earned your way to the twins.$"}
text:MossdeepCity_Gym.KathleenPostBattle	{'body': "LATIAS can recover and use CALM MIND.\\nDon't let a long battle favor it.$"}
text:MossdeepCity_Gym.CliffordIntro	{'body': "PINCURCHIN's terrain doubles\\nRAICHU's speed. ESPATHRA gets\\lfaster every turn.\\pKeep up if you can!$"}
text:MossdeepCity_Gym.CliffordDefeat	{'body': "We couldn't keep ahead of you.$"}
text:MossdeepCity_Gym.CliffordPostBattle	{'body': "Replacing ELECTRIC TERRAIN removes\\nRAICHU's SURGE SURFER speed boost.$"}
text:MossdeepCity_Gym.MaceyIntro	{'body': 'FERROTHORN and TOXAPEX do not fall.\\nDELPHOX brings firepower in reserve.\\pBring fire, or bring patience!$'}
text:MossdeepCity_Gym.MaceyDefeat	{'body': 'Our patience finally ran out.$'}
text:MossdeepCity_Gym.MaceyPostBattle	{'body': 'TOXAPEX can erase boosts with HAZE.\\nTAUNT can restrict its recovery, too.$'}
text:MossdeepCity_Gym.NicholasIntro	{'body': 'LATIOS is quick, and AEGISLASH\\ncan make a careless attack\\lcostly.\\pChoose your moment!$'}
text:MossdeepCity_Gym.NicholasDefeat	{'body': 'You found your way past our blades.$'}
text:MossdeepCity_Gym.NicholasPostBattle	{'body': 'INTIMIDATE helps CONTRARY MALAMAR.\\nA burn is a safer way to weaken it.$'}
text:MossdeepCity_Gym.NeedFeatherBadge	{'body': "TATE: Your path still bends west.\\nLIZA: WINONA awaits in FORTREE.\\pReturn with the FEATHER BADGE, and\\nwe'll accept your challenge.$"}
text:MossdeepCity_Gym.TateAndLizaIntro	{'body': 'TATE: We grew up battling\\ntogether.\\lLIZA: We know when to help each\\lother.\\pTATE: Psychic Terrain protects\\ngrounded partners from priority\\lmoves.\\pLIZA: And under TRICK ROOM…\\nTATE: …the slowest may move\\lfirst!\\pBOTH: Ready to face us?$'}
text:MossdeepCity_Gym.TateAndLizaDefeat	{'body': 'TATE: We shared our strength...\\nLIZA: ...and you still overcame us.\\pTATE: You earned...\\nLIZA: ...the MIND BADGE.$'}
text:MossdeepCity_Gym.ReceivedMindBadge	{'body': '{PLAYER} received the MIND BADGE\\nfrom TATE and LIZA.$'}
text:MossdeepCity_Gym.ExplainMindBadgeTakeThis	{'body': 'TATE: The MIND BADGE lets your LEVELER\\ntrain a party up to Lv. 70.\\pLIZA: It also enables DIVE outside\\nof battle.\\pTATE: You should also take this, too.$'}
text:MossdeepCity_Gym.ExplainMetagrossite	{'body': 'Tate: Metagrossite lets Metagross Mega\\nEvolve. Let it hold the stone.$'}
text:MossdeepCity_Gym.RegisteredTateAndLiza	{'body': 'Registered GYM LEADERS TATE & LIZA\\nin the POKéNAV.$'}
text:MossdeepCity_Gym.TateAndLizaPostBattle	{'body': 'TATE: A wish sleeps deep inside\\nMETEOR FALLS.\\pLIZA: Explore beyond its waterfall.\\nYou may find JIRACHI there.$'}
text:MossdeepCity_Gym.TateAndLizaNeedTwoMons	{'body': "TATE: Hehehe… Were you surprised?\\pLIZA: That there are two GYM LEADERS?\\pTATE: Oops, you have only one…\\nLIZA: POKéMON that can battle.\\pTATE: We can't battle that way!\\pLIZA: If you want to challenge us,\\nbring some more POKéMON.$"}
text:MossdeepCity_Gym.GymStatue	{'body': 'MOSSDEEP CITY POKéMON GYM$'}
text:MossdeepCity_Gym.GymStatueCertified	{'body': "MOSSDEEP CITY POKéMON GYM\\pLIZA AND TATE'S CERTIFIED TRAINERS:\\n{PLAYER}$"}
text:MossdeepCity_Gym.TateAndLizaPreRematch	{'body': "TATE: POKéMON…\\nLIZA: POKéMON…\\pTATE: By changing the party's mix…\\nLIZA: The battle style changes.\\pTATE: But me…\\nLIZA: But me…\\pTATE: I'll always be with LIZA!\\nLIZA: I'll always be with TATE!\\pTATE: Our combination…\\nLIZA: We'll show you again and again!$"}
text:MossdeepCity_Gym.TateAndLizaRematchDefeat	{'body': "TATE: You and your POKéMON…\\nLIZA: It's as if you were siblings!$"}
text:MossdeepCity_Gym.TateAndLizaPostRematch	{'body': "TATE: You can knock us down,\\nbut we'll never stay down!\\pLIZA: Because the two of us,\\nwe always support each other!$"}
text:MossdeepCity_Gym.TateAndLizaRematchNeedTwoMons	{'body': "TATE: You're back again…\\nLIZA: You're back again…\\pTATE: To give us a rematch.\\nLIZA: To give us a rematch.\\pTATE: But…\\nLIZA: For our match…\\pTATE: You brought just one POKéMON!\\nLIZA: You brought just one POKéMON!\\pTATE: We need you to bring at least…\\nLIZA: Two POKéMON when you come back.$"}
text:MossdeepCity_Gym.SpaceCenterHandoff	{'body': "TATE: TEAM MAGMA is after the\\nSPACE CENTER's rocket fuel.\\pLIZA: Please help STEVEN stop them!\\nThe SPACE CENTER is east of our GYM.$"}
text:MossdeepCity_House1.HmmYourPokemon	{'body': 'Hmm!\\nYour {STR_VAR_1}…$'}
text:MossdeepCity_House1.ItLikesXPokeblocks	{'body': "It likes {STR_VAR_1}S,\\ndoesn't it?\\pNo, I'm positive of it! It definitely\\nlikes {STR_VAR_1}S!$"}
text:MossdeepCity_House1.DoesntLikeOrDislikePokeblocks	{'body': "It doesn't appear to like or dislike\\nany {POKEBLOCK}S.$"}
text:MossdeepCity_House1.HusbandCanTellPokeblockMonLikes	{'body': "My husband can tell what kind of\\n{POKEBLOCK}S a POKéMON likes at a glance.\\pCYNTHIA is our guest while she studies\\nMOSSDEEP's myths and meteor records.$"}
text:MossdeepCity_House1.CynthiaChallenge	{'body': "I'm CYNTHIA. I study myths, but battles\\nreveal how a Trainer reasons under fire.\\pYou are HOENN's Champion. Will you face\\na Champion from another region?$"}
text:MossdeepCity_House1.CynthiaDefeat	{'body': 'What a battle! You and your POKéMON\\nhave given me something new to study.$'}
text:MossdeepCity_House1.CynthiaAfter	{'body': 'The SHINY CHARM is yours.\\nMay your next journey reveal\\lsomething extraordinary.$'}
text:MossdeepCity_House1.CynthiaNotReady	{'body': "These kind hosts gave me a quiet place\\nto study HOENN's meteor records.\\pYour journey continues. Return after\\nthe HOENN LEAGUE knows your name.$"}
text:MossdeepCity_House1.CynthiaDecline	{'body': 'A good challenge improves by waiting.$'}
text:MossdeepCity_House1.CynthiaBagFull	{'body': 'Make room for the SHINY CHARM.\\nI will keep it safe.$'}
text:MossdeepCity_House2.SisterMailsBoyfriendInFortree	{'body': "My little sister exchanges MAIL with\\nher boyfriend in FORTREE.\\pI don't envy her one bit at all.$"}
text:MossdeepCity_House2.PokemonCarriesMailBackAndForth	{'body': "Even though I can't see my friend in\\nFORTREE, my POKéMON carries MAIL\\lback and forth for us.\\pI'm not lonesome, even though we're\\napart.$"}
text:MossdeepCity_House2.Wingull	{'body': 'WINGULL: Pihyoh!$'}
text:MossdeepCity_House3.YouWantSuperRod	{'body': "Hey there, TRAINER!\\nA SUPER ROD really is super!\\pSay all you want, but this baby can\\ncatch POKéMON off the seafloor!\\pWhat do you think?\\nYou want it, don't you?$"}
text:MossdeepCity_House3.SuperRodIsSuper	{'body': 'You bet, you bet!\\nAfter all, a SUPER ROD is really super!$'}
text:MossdeepCity_House3.TryDroppingRodInWater	{'body': "If there's any water, try dropping in\\nyour ROD and see what bites!$"}
text:MossdeepCity_House3.DontYouLikeToFish	{'body': "Hunh?\\nDon't you like to fish?$"}
text:MossdeepCity_House3.GoAfterSeafloorPokemon	{'body': 'Go after the seafloor POKéMON with\\nyour SUPER ROD.$'}
text:MossdeepCity_House4.BrotherLikesToFindBases	{'body': "My little brother says he likes to go\\nfind people's SECRET BASES.$"}
text:MossdeepCity_House4.BrotherLikesToVisitBasesAndBattle	{'body': "My little brother says he likes to\\nvisit people's SECRET BASES and have\\lPOKéMON battles.$"}
text:MossdeepCity_House4.YouMadeSecretBaseNearX	{'body': 'Was it you who made a SECRET BASE\\nnear {STR_VAR_1}?$'}
text:MossdeepCity_House4.MakeSecretBase	{'body': "You should make a SECRET BASE\\nsomewhere. I'll go find it!$"}
text:MossdeepCity_House4.Skitty	{'body': 'SKITTY: Miyaan?$'}
text:MossdeepCity_Mart.ReviveIsFantastic	{'body': "REVIVE is fantastic!\\pGive it to a fainted POKéMON,\\nand the POKéMON will arise.\\pBut be careful, REVIVE doesn't restore\\nthe used-up PP of moves.$"}
text:MossdeepCity_Mart.MaxRepelLastsLongest	{'body': 'MAX REPEL lasts 250 steps.\\nIt keeps weaker wild POKéMON away.\\pThe reusable REPEL SPRAY lasts\\n500 steps and can be used again!$'}
text:MossdeepCity_Mart.NetAndDiveBallsRare	{'body': 'NET and DIVE BALLS specialize in\\ndifferent kinds of hunts.\\pA NET BALL excels against BUG- and\\nWATER-type POKéMON.\\pA DIVE BALL excels while surfing,\\nfishing, or exploring underwater.$'}
text:MossdeepCity_PokemonCenter_1F.GymLeaderDuoFormidable	{'body': 'The GYM LEADERS in this town are\\na formidable duo.\\pTheir combination attacks are, like,\\nexcellent and wow!$'}
text:MossdeepCity_PokemonCenter_1F.AbilitiesMightChangeMoves	{'body': 'Depending on the special abilities of\\nPOKéMON, some moves might change\\lor not work at all.$'}
text:MossdeepCity_PokemonCenter_2F.Woman5	{'body': 'If I win a whole lot of link battles\\nand show everyone how good I am,\\lI might get a fan following!$'}
text:MossdeepCity_SpaceCenter_1F.RocketLaunchImminent	{'body': "The rocket's launch is imminent!$"}
text:MossdeepCity_SpaceCenter_1F.SuccessfulLaunchNumber	{'body': "The rocket launched safely!\\nThat's launch no. {STR_VAR_1}!$"}
text:MossdeepCity_SpaceCenter_1F.HaywireButRocketLaunchImminent	{'body': "We were preparing for a launch\\nwhen MAGMA arrived.\\pThe crew needs that fuel. We\\ncan't let them take it!$"}
text:MossdeepCity_SpaceCenter_1F.HaywireButSuccessfulLaunchNumber	{'body': "We'd completed launch no.\\n{STR_VAR_1} safely. Then TEAM\\lMAGMA arrived.\\pI can't believe they're trying to\\nsteal our fuel!$"}
text:MossdeepCity_SpaceCenter_1F.RocketLaunchDemandsPerfection	{'body': "A rocket launch demands perfection.\\nNot even a 1% margin of error is allowed.\\pEven if it's 99% okay, the whole thing\\nis useless if 1% happens to be no good.\\pDespite that, we never stop trying.\\nWhy? It's a dream that never ends.$"}
text:MossdeepCity_SpaceCenter_1F.MagmaHaveSightsOnSpaceCenter	{'body': "Those MAGMA thugs have threatened\\nthe SPACE CENTER.\\pWe're securing the rocket fuel.\\nIf they take it, they could do\\lterrible damage.$"}
text:MossdeepCity_SpaceCenter_1F.FoundThisYouCanHaveIt	{'body': "I was taking a stroll down the beach\\nwhen I found this.\\pIt's not anything I need, so you can\\nhave it.$"}
text:MossdeepCity_SpaceCenter_1F.HoennFamousForMeteorShowers	{'body': 'The HOENN region has been famous for \\nits meteor showers for a long time.$'}
text:MossdeepCity_SpaceCenter_1F.MagmaCantStealFuelTakeThis	{'body': "TEAM MAGMA mustn't get that fuel!\\pI found this SUN STONE on the\\nbeach. If it can help one of your\\lPOKéMON, please take it.$"}
text:MossdeepCity_SpaceCenter_1F.CantStrollOnBeachWithMagma	{'body': "With TEAM MAGMA around, I guess\\nstrolls on the beach aren't safe.$"}
text:MossdeepCity_SpaceCenter_1F.DidPokemonComeFromSpace	{'body': 'Some people claim that POKéMON came\\nfrom space. Could it be true?$'}
text:MossdeepCity_SpaceCenter_1F.AquaShouldBeatMagma	{'body': "TEAM AQUA should take care of\\nTEAM MAGMA!\\pBut if they did that, TEAM AQUA will\\nbecome bold and brazen, won't they?$"}
text:MossdeepCity_SpaceCenter_1F.RocketsBoggleMyMind	{'body': 'A giant chunk of metal bursts through\\nthe skies and flies into space…\\pIt boggles my mind!$'}
text:MossdeepCity_SpaceCenter_1F.MagmaWantsToSpoilMyDream	{'body': "A giant chunk of metal bursts through\\nthe skies and flies into space…\\pBut TEAM MAGMA wants to spoil\\nthat dream of mine!\\pI'm not having any of that!$"}
text:MossdeepCity_SpaceCenter_1F.StevenMagmaCantBeAllowedToTakeFuel	{'body': "STEVEN: {PLAYER}{KUN}, have you read that\\nproclamation already?\\pTEAM MAGMA is coming after the rocket\\nfuel on this island.\\pI don't know what they'd need it for,\\nbut they can't be allowed to take it.\\pI'll keep an eye on things for\\na while longer.\\pIn the meantime, why don't you go\\ncheck out the town?$"}
text:MossdeepCity_SpaceCenter_1F.Grunt3Intro	{'body': "We're here for the rocket fuel, exactly\\nlike we announced. MAXIE likes it tidy.$"}
text:MossdeepCity_SpaceCenter_1F.Grunt3Defeat	{'body': 'Ran out of fuel…$'}
text:MossdeepCity_SpaceCenter_1F.Grunt3PostBattle	{'body': "Don't think you're on a roll just\\nbecause you beat me. I'm the warm-up.$"}
text:MossdeepCity_SpaceCenter_1F.Grunt1Intro	{'body': 'We gave fair warning! Nothing sneaky\\nabout TEAM MAGMA! Now, MIGHTYENA!$'}
text:MossdeepCity_SpaceCenter_1F.Grunt1Defeat	{'body': 'Grrr… Next time we try sneaky.$'}
text:MossdeepCity_SpaceCenter_1F.Grunt1PostBattle	{'body': 'Okay, I get it. Next time we come\\nunannounced. Write that down.$'}
text:MossdeepCity_SpaceCenter_1F.Grunt4Intro	{'body': "The rocket fuel in storage. Every last\\ndrop of it. That's the whole plan.$"}
text:MossdeepCity_SpaceCenter_1F.Grunt4Defeat	{'body': 'Please, can you spare some fuel?\\nEven a chintzy cup?$'}
text:MossdeepCity_SpaceCenter_1F.Grunt4PostBattle	{'body': 'What do we DO with rocket fuel? How\\nwould I know? Ask the boss upstairs.$'}
text:MossdeepCity_SpaceCenter_1F.Grunt2Intro	{'body': 'MAXIE said nobody gets past me. So\\nnobody gets past me. FLYGON!$'}
text:MossdeepCity_SpaceCenter_1F.Grunt2Defeat	{'body': 'Ack! Ack! Aaack!$'}
text:MossdeepCity_SpaceCenter_1F.Grunt2PostBattle	{'body': 'Tell him I never left my post. Tell\\nhim I stayed to the end.$'}
text:MossdeepCity_SpaceCenter_1F.MagmaIntentToStealNotice	{'body': "This is…\\nAn intent-to-steal notice?\\p“To the staff of the SPACE CENTER:\\nHow are you? We are doing fine.\\p“We will soon visit you to take your\\nrocket fuel.\\p“Please don't try to stop us.\\nWe will take the fuel no matter what.\\p“Let there be more land!\\n                                          TEAM MAGMA”$"}
text:MossdeepCity_SpaceCenter_2F.MossdeepIdealForRockets	{'body': "MOSSDEEP has mainly sunny weather,\\nand its winds are stable.\\pIt's an ideal location for launching\\nrockets.$"}
text:MossdeepCity_SpaceCenter_2F.WhyWouldMagmaStealRocketFuel	{'body': 'Why would TEAM MAGMA want to steal\\nour rocket fuel in the first place?$'}
text:MossdeepCity_SpaceCenter_2F.WouldveLikedToBeAstronaut	{'body': "If only I was a little younger, I would\\nhave liked being an astronaut…\\pNo… It's not too late!\\nI can and will try!$"}
text:MossdeepCity_SpaceCenter_2F.MagmaCantGetAwayWithThis	{'body': "If TEAM MAGMA takes the rocket fuel,\\nI won't be able to go to space!\\pThey can't be allowed to get away\\nwith such an outrage!$"}
text:MossdeepCity_SpaceCenter_2F.WishOrdinaryPeopleCouldGoIntoSpace	{'body': 'I wish ordinary people could go into\\nspace one day…$'}
text:MossdeepCity_SpaceCenter_2F.DoesMagmaWantToGoToSpace	{'body': 'TEAM MAGMA…\\nDo they want to go to space, too?$'}
text:MossdeepCity_SpaceCenter_2F.YoureOutnumberedTakeUsOn	{'body': "You'll have to battle all three\\nof us, one after another!\\pStill want to come through?$"}
text:MossdeepCity_SpaceCenter_2F.GoodAnswer	{'body': "That's right. Go downstairs while\\nyou can!$"}
text:MossdeepCity_SpaceCenter_2F.Grunt5Intro	{'body': "I'm first! You're not getting\\npast this corridor!$"}
text:MossdeepCity_SpaceCenter_2F.Grunt5Defeat	{'body': "What?! It's your turn. Stop that\\nkid!$"}
text:MossdeepCity_SpaceCenter_2F.Grunt6Intro	{'body': "You beat one of us. Let's see you\\nbeat two!$"}
text:MossdeepCity_SpaceCenter_2F.Grunt6Defeat	{'body': "Oh, no… It's all up to you now!$"}
text:MossdeepCity_SpaceCenter_2F.Grunt7Intro	{'body': "I'm the last one! MAXIE's\\ncounting on me!$"}
text:MossdeepCity_SpaceCenter_2F.Grunt7Defeat	{'body': 'All three of us… defeated!$'}
text:MossdeepCity_SpaceCenter_2F.Grunt6PostBattle	{'body': 'Three of us guarding one\\ncorridor. I thought this would be\\lan easy job.$'}
text:MossdeepCity_SpaceCenter_2F.Grunt7PostBattle	{'body': "I can't believe you beat us all.\\nWhat do I tell MAXIE?$"}
text:MossdeepCity_SpaceCenter_2F.Grunt5PostBattle	{'body': 'We were supposed to keep everyone\\ndownstairs until MAXIE had the\\lfuel.$'}
text:MossdeepCity_SpaceCenter_2F.WellTakeCareOfYou	{'body': "The others couldn't stop you?\\nThen we will!\\pMAXIE isn't leaving without that\\nfuel.$"}
text:MossdeepCity_SpaceCenter_2F.MaxieDontInterfere	{'body': 'MAXIE: You again? STEVEN is\\nalready wasting my time. Stand\\laside!$'}
text:MossdeepCity_SpaceCenter_2F.StevenWhyStealRocketFuel	{'body': 'STEVEN: Rocket fuel cannot control\\nGROUDON. What are you truly targeting?$'}
text:MossdeepCity_SpaceCenter_2F.MaxieUseFuelToEruptVolcano	{'body': 'MAXIE: The rocket fuel will blast\\nopen MT. CHIMNEY. New land will\\lrise across HOENN.\\pGROUDON would not obey. I will\\nfinish what it began myself.$'}
text:MossdeepCity_SpaceCenter_2F.StevenAreYouReadyToBattle	{'body': 'STEVEN: {PLAYER}! Help me stop\\nthem.\\pAre you ready to battle alongside\\nme?$'}
text:MossdeepCity_SpaceCenter_2F.StevenHurryGetReadyQuickly	{'body': 'STEVEN: Then, hurry!\\nGet ready quickly!$'}
text:MossdeepCity_SpaceCenter_2F.JustWantToExpandLand	{'body': 'All I want…\\nI just want to expand the land mass…$'}
text:MossdeepCity_SpaceCenter_TabithaDefeat	{'body': "I couldn't keep you away…$"}
text:MossdeepCity_SpaceCenter_2F.TabithaIntro	{'body': 'TABITHA: MAXIE needs that rocket\\nfuel. My orders are to keep\\leveryone else away!$'}
text:MossdeepCity_SpaceCenter_2F.TabithaAfter	{'body': "TABITHA: You beat me, but MAXIE\\nwon't leave empty-handed. STEVEN\\lis still trying to stop him.$"}
text:MossdeepCity_SpaceCenter_2F.TabithaNotEnoughMons	{'body': 'A formation requires two usable\\nPOKéMON. Return when both can battle.$'}
text:MossdeepCity_SpaceCenter_CourtneyDefeat	{'body': 'COURTNEY: Defeated… Both of us.$'}
text:MossdeepCity_SpaceCenter_2F.CourtneyFormation	{'body': "COURTNEY: STEVEN… and you.\\pMAXIE, I'll cover you. We still\\nneed that fuel.$"}
text:MossdeepCity_SpaceCenter_2F.MaxieWeFailedIsAquaAlsoMisguided	{'body': "MAXIE: We couldn't control\\nGROUDON. So I came here to take\\lfuel and force an eruption\\lanyway.\\pI nearly destroyed the very land\\nI claimed to protect.\\pIf I was this wrong… ARCHIE may\\nbe making the same mistake at\\lsea.$"}
text:MossdeepCity_SpaceCenter_2F.MaxieWeWillGiveUp	{'body': "MAXIE: Keep the fuel. We're\\nleaving.\\pI must find GROUDON, and stop\\nARCHIE before he awakens KYOGRE.$"}
text:MossdeepCity_SpaceCenter_2F.StevenThankYouComeSeeMeAtHome	{'body': "STEVEN: Thank you, {PLAYER}.\\nTogether, we kept the staff and\\ltheir research safe.\\pCome to my home west of the GYM.\\nI have DIVE for you.\\pYou'll need it to follow AQUA's\\nstolen submarine.$"}
text:MossdeepCity_StevensHouse.YouveEarnedHMDive	{'body': "STEVEN: {PLAYER}{KUN}…\\pAs you can see, there's not much here,\\nbut this is my home.\\pThank you for all that you've done.\\pThis is my token of appreciation.\\nIt's the HIDDEN MACHINE DIVE.\\pNo need to be shy--you've earned\\nthis HM.$"}
text:MossdeepCity_StevensHouse.ExplainDive	{'body': "STEVEN: While you're using SURF, you\\nshould notice dark patches of water.\\pUse DIVE if you come to deep water\\nlike it. You'll drop to the seafloor.\\pWhen you want to come back up, use\\nDIVE again.\\pIn some places, it won't be possible\\nfor you to surface, though.\\pAQUA took the submarine to a cavern.\\nSearch south on ROUTE 128.\\pUse DIVE in the dark water to find the\\nSEAFLOOR CAVERN and stop ARCHIE.$"}
text:MossdeepCity_StevensHouse.UnderwateCavernBetweenMossdeepSootopolis	{'body': 'STEVEN: Search south on ROUTE 128.\\nUse DIVE in the dark water.\\pFind the SEAFLOOR CAVERN where AQUA\\ntook the submarine, and stop ARCHIE.$'}
text:MossdeepCity_StevensHouse.TakeBallContainingBeldum	{'body': '{PLAYER} checked the POKé BALL.\\pIt contained the POKéMON\\nBELDUM.\\pTake the POKé BALL?$'}
text:MossdeepCity_StevensHouse.ObtainedBeldum	{'body': '{PLAYER} obtained a BELDUM.$'}
text:MossdeepCity_StevensHouse.NoSpaceForAnotherMon	{'body': 'There is no space for another POKéMON.$'}
text:MossdeepCity_StevensHouse.LeftPokeBallWhereItWas	{'body': '{PLAYER} left the POKé BALL where\\nit was.$'}
text:MossdeepCity_StevensHouse.LetterFromSteven	{'body': "It's a letter.\\p… … … … … …\\pTo {PLAYER}{KUN}…\\pI've decided to do a little soul-\\nsearching and train on the road.\\pI don't plan to return home for some\\ntime.\\pI have a favor to ask of you.\\pI want you to take the POKé BALL on\\nthe desk.\\pInside it is a BELDUM, my favorite\\nPOKéMON.\\pI'm counting on you.\\pMay our paths cross someday.\\pSTEVEN STONE$"}
text:MossdeepCity_StevensHouse.CollectionOfRareRocks	{'body': "It's a collection of rare rocks and\\nstones assembled by STEVEN.$"}
text:MtChimney.MeteoriteWillActivateVolcano	{'body': "The METEORITE will drive this\\nvolcano's energy into the fault\\lline.\\pCaverns will open beneath HOENN,\\nand the land will rise!$"}
text:MtChimney.MaxieIntro	{'body': "MAXIE: ARCHIE's unexpected ally.\\nI prefer problems with clear\\lsolutions.\\pThe sea changes without\\npermission. Land gives people\\lroom to build and grow.\\pThis machine will awaken the\\npower beneath MT. CHIMNEY. HOENN\\lwill have all the land it needs.\\pYou may test my team. You will\\nnot stop my work.$"}
text:MtChimney.MaxieDefeat	{'body': 'You stopped my team… How?!$'}
text:MtChimney.MaxieYouHaventSeenLastOfMagma	{'body': "MAXIE: You've stopped this\\nmachine. But MAGMA's work will\\lcontinue.\\pThere is a greater power beneath\\nHOENN. We will find a way to\\lawaken it.$"}
text:MtChimney.TabithaIntro	{'body': "TABITHA: So you followed us from\\nMETEOR FALLS!\\pMAXIE is working with the\\nMETEORITE. I'm not letting you\\lnear his machine!$"}
text:MtChimney.TabithaDefeat	{'body': "I couldn't hold you off!$"}
text:MtChimney.TabithaPostBattle	{'body': 'TABITHA: MAXIE! The intruder is\\ncoming!$'}
text:MtChimney.Grunt2Intro	{'body': 'Stable land means homes, roads,\\nand room for people to build a\\lfuture.\\pThat is why I chose TEAM MAGMA.\\nYou will not interrupt the work.$'}
text:MtChimney.Grunt2Defeat	{'body': "I couldn't protect the machine…$"}
text:MtChimney.Grunt2PostBattle	{'body': 'MAXIE promised a safer world.\\pIf the method frightens everyone it is\\nmeant to help, what did we misjudge?$'}
text:MtChimney.Grunt1Intro	{'body': "LAVARIDGE sits beside a volcano.\\nImagine if we could make all that\\lland safe!\\pThat's what MAXIE promised us.\\nI'm not letting you stop him!$"}
text:MtChimney.Grunt1Defeat	{'body': 'Even with all our training…$'}
text:MtChimney.Grunt1PostBattle	{'body': 'I thought this would make people\\nfeel safer. Why are they all so\\lfrightened?$'}
text:MtChimney.TeamAquaAlwaysMessingWithPlans	{'body': 'Those AQUA grunts keep trying to\\nreach our machine!$'}
text:MtChimney.MeteoritesPackAmazingPower	{'body': 'The METEORITE resonates with the\\nfault!$'}
text:MtChimney.YouBetterNotMessWithUs	{'body': 'Stand back! MAXIE is working at\\nthe crater!$'}
text:MtChimney.AquasNameSimilar	{'body': 'MAGMA wants more land. AQUA wants\\nmore sea.\\pAnd neither side is giving way\\ntoday!$'}
text:MtChimney.DouseThemInFire	{'body': 'Hold the high ground!\\nDo not let AQUA reach the machine!$'}
text:MtChimney.KeepMakingMoreLand	{'body': "More land means more places to\\nlive! That's why we're here!$"}
text:MtChimney.Bufoh	{'body': 'The line is holding!$'}
text:MtChimney.ArchieGoStopTeamMagma	{'body': "ARCHIE: {PLAYER}! MAXIE is\\nforcing the METEORITE into the\\lvolcano's fault line.\\pIf it breaks, fire will tear\\nthrough the mountain and every\\lconnected cavern.$"}
text:MtChimney.ArchieIHaveMyHandsFull	{'body': "ARCHIE: Grrr…\\pI want to stop that MAXIE,\\nbut I can't!\\pNot when I have my hands full battling\\nthree opponents at once!$"}
text:MtChimney.ArchieThankYou	{'body': "ARCHIE: You stopped him. I owe\\nyou that.\\pThe sea POKéMON along this coast\\ncan breathe easy. But AQUA's work\\lisn't finished.\\pJAGGED PASS leads down to\\nLAVARIDGE. You've earned a rest.\\pAnd that METEORITE is still in\\nthe machine. COZMO in FALLARBOR\\lwill want it back.$"}
text:MtChimney.MagmaOutnumbersUs	{'body': "MAGMA outnumbers us! We can't get\\nthrough to the machine!$"}
text:MtChimney.LessHabitatForWaterPokemon	{'body': 'If lava pours into the sea, what\\nhappens to the POKéMON living\\lthere?$'}
text:MtChimney.MagmasNameSimilar	{'body': "We joined AQUA to protect the\\nsea. We can't let MAGMA destroy\\lit!$"}
text:MtChimney.Bushaa	{'body': 'Break their line!$'}
text:MtChimney.LavaCookiesJust200	{'body': "LAVA COOKIES are MT. CHIMNEY's local\\nspecialty.\\pTry one. It's just ¥200.$"}
text:MtChimney.ThankYouDear	{'body': 'Thank you, dear!$'}
text:MtChimney.YouveNotGotTheMoney	{'body': "Oh, dear. You can't buy a thing if\\nyou've not got the money.$"}
text:MtChimney.OhFineThen	{'body': 'Oh, fine then.$'}
text:MtChimney.MeteoriteFittedOnMachine	{'body': 'A METEORITE is fitted into the\\nmachine. Cables run from it\\ltoward the crater.$'}
text:MtChimney.RemoveTheMeteorite	{'body': 'A METEORITE is fitted on a mysterious\\nmachine…\\pDo you want to remove the METEORITE?$'}
text:MtChimney.PlayerRemovedMeteorite	{'body': '{PLAYER} removed the METEORITE from\\nthe mysterious machine.$'}
text:MtChimney.PlayerLeftMeteorite	{'body': '{PLAYER} left the METEORITE where\\nit was.$'}
text:MtChimney.MachineMakesNoResponse	{'body': 'This mysterious machine…\\nIt makes no response whatsoever.$'}
text:MtChimney.RouteSign	{'body': '{DOWN_ARROW} JAGGED PASS\\nLAVARIDGE TOWN AHEAD$'}
text:MtChimney.ShelbyIntro	{'body': "I've been to the hot springs and\\nrefreshed my tired bones.\\lRight now I'm feeling strong!$"}
text:MtChimney.ShelbyDefeat	{'body': "Oh, my goodness.\\nNow, aren't you something!$"}
text:MtChimney.ShelbyPostBattle	{'body': "Well, well, I've lost. I can't call\\nmyself an EXPERT now, can I?$"}
text:MtChimney.ShelbyRegister	{'body': 'Thank you, child. It was fun, as if\\nI were battling my own grandchild.\\pPlease, keep in touch and tell me\\nwhere your journey takes you.$'}
text:MtChimney.ShelbyRematchIntro	{'body': 'If you can mesh your heart with those\\nof your POKéMON, why, you should be\\lable to achieve great things.$'}
text:MtChimney.ShelbyRematchDefeat	{'body': "Oh, my goodness.\\nNow, aren't you something!$"}
text:MtChimney.ShelbyPostRematch	{'body': 'Perhaps your heart has become one\\nwith the hearts of your POKéMON.$'}
text:MtChimney.MelissaIntro	{'body': "I've got the fire in me, baby.\\nI can't stand it! I have to battle!$"}
text:MtChimney.MelissaDefeat	{'body': 'Ooh, that was a scorching-hot match!$'}
text:MtChimney.MelissaPostBattle	{'body': 'The heat of MT. CHIMNEY warms\\nme up, baby!$'}
text:MtChimney.SheilaIntro	{'body': "I've finally made it to MT. CHIMNEY.\\nI want to make my POKéMON battle!$"}
text:MtChimney.SheilaDefeat	{'body': "The way you battle…\\nIt's like a MT. CHIMNEY eruption!$"}
text:MtChimney.SheilaPostBattle	{'body': "Like I said, I've finally made it to\\nMT. CHIMNEY. It would be a shame if\\lI only do a little sightseeing…\\pI want to get in some battles and buy\\nCOOKIES as souvenirs.$"}
text:MtChimney.ShirleyIntro	{'body': "Since I bathed in the hot springs,\\nI've been feeling great!\\lI'm sure I'm going to win!$"}
text:MtChimney.ShirleyDefeat	{'body': "Yowch!\\nI'm getting a chill out of the water.$"}
text:MtChimney.ShirleyPostBattle	{'body': "I'll have to take another dip in the\\nhot springs. Want to join me?\\pJust joking!$"}
text:MtChimney.SawyerIntro	{'body': 'This is one fine mountain! Plenty of\\nhot people around for company!$'}
text:MtChimney.SawyerDefeat	{'body': "Oh, you're a real firebrand, too!$"}
text:MtChimney.SawyerPostBattle	{'body': 'I think I need a dip in LAVARIDGE\\nHOT SPRING with the locals!$'}
text:MtChimney.SawyerRegister	{'body': 'I like little fireballs like you.\\nLet me register you in my POKéNAV.$'}
text:MtChimney.SawyerRematchIntro	{'body': "I'm happily surrounded by hot people\\naround these parts. I won't lose!$"}
text:MtChimney.SawyerRematchDefeat	{'body': "Gosh, you're still the same\\nfirebrand as before!$"}
text:MtChimney.SawyerPostRematch	{'body': "Actually, it really is hot here.\\nI'm overdressed for these parts.$"}
text:MtChimney_CableCarStation.CableCarReadyGetOn	{'body': 'The CABLE CAR is ready to go down.\\nWould you like to be on it?$'}
text:MtChimney_CableCarStation.StepThisWay	{'body': 'Please step this way.$'}
text:MtChimney_CableCarStation.RideAnotherTime	{'body': 'Please ride with us another time.$'}
text:ExplosionTeach	{'body': "Can you imagine?\\nIf this volcano were to erupt?\\pThe explosion would be the end of\\nus. How terrifying is that?\\pWhile we're terrified, would you\\nlike me to teach EXPLOSION?$"}
text:ExplosionDeclined	{'body': "Yeah, you're right.\\nIt is too terrifying.$"}
text:ExplosionWhichMon	{'body': "You're terribly brave!\\pWhich POKéMON should I teach\\nEXPLOSION?$"}
text:ExplosionTaught	{'body': 'Using EXPLOSION while on this\\nvolcano…\\pWhat a terrifying thrill!$'}
text:MtEmber_Exterior_WellTryDiggingHere	{'body': "Over here.\\nWe'll try digging here.\\pThat treasure the ADMINS've been\\ntalking about should be here.$"}
text:MtEmber_Exterior_YoureInTheWayGetLost	{'body': "What the…?\\nYou're in the way. Get lost.$"}
text:MtEmber_Exterior_PunchedThroughAtLast	{'body': "Whew, punched through at last.\\nLet's go treasure hunting!$"}
text:MtEmber_Exterior_WhatsPasswordAgain	{'body': "Any treasure we find, we haul back\\nto the WAREHOUSE, understood?\\p…Oh, and what're the passwords?\\nAt the ROCKET WAREHOUSE, I mean.$"}
text:MtEmber_Exterior_FirstPasswordGoldeen	{'body': "What, you forgot the password?\\nThere're actually two.\\pThe first one's “GOLDEEN need\\nlog.”\\pAnd the second one is…$"}
text:MtEmber_Exterior_SnoopsBeenListeningIn	{'body': "Hey!\\nThis snoop's been listening in!$"}
text:MtEmber_Exterior_Grunt1Intro	{'body': "You've been eavesdropping on us,\\nhaven't you?$"}
text:MtEmber_Exterior_Grunt1Defeat	{'body': 'Huh, what?$'}
text:MtEmber_Exterior_Grunt1PostBattle	{'body': "Why'd you have to win?$"}
text:MtEmber_Exterior_Grunt2Intro	{'body': "Trying to horn in on our treasure?\\nDon't bet on it!$"}
text:MtEmber_Exterior_Grunt2Defeat	{'body': 'Wait!\\nBut how?$'}
text:MtEmber_Exterior_Grunt2PostBattle	{'body': 'Develop amnesia conveniently and\\nforget everything you heard!$'}
text:MtEmber_Exterior_WellRegroupDontStepInsideThere	{'body': "What a setback…\\nWe'll have to regroup.\\pYou! Don't even think about taking\\na step inside here!\\pIf you know what's good for you,\\ndon't even think about this!$"}
text:MtEmber_Exterior_LoganIntro	{'body': "An active volcano is one that's\\nerupting, or about to.$"}
text:MtEmber_Exterior_LoganDefeat	{'body': "Whew… That was hot!\\nSweat's erupting from me!$"}
text:MtEmber_Exterior_LoganPostBattle	{'body': "They say there're over 1,500\\nactive volcanoes in the world.\\pJust thinking about them makes me\\nfeel all hot and gooey inside!$"}
text:MtEmber_Exterior_BethIntro	{'body': 'Do you know how caves form inside\\nvolcanoes?$'}
text:MtEmber_Exterior_BethDefeat	{'body': "Atchah!\\nYou're shockingly good!$"}
text:MtEmber_Exterior_BethPostBattle	{'body': 'When lava at the surface of magma\\nhardens, and the magma inside flows\\lout, caverns are left behind.$'}
text:MtEmber_Exterior_JocelynIntro	{'body': "I've been in training so I can mend\\nmy broken heart…\\pIt toughened me up physically at\\nleast! Hi-yah!$"}
text:MtEmber_Exterior_JocelynDefeat	{'body': 'I think I tried to overdo it…$'}
text:MtEmber_Exterior_JocelynPostBattle	{'body': 'The way you battle, it reminds me\\nof the guy who dumped me…$'}
text:MtEmber_RubyPath_B3F_FoundARuby	{'body': '{PLAYER} found a RUBY!$'}
text:MtMoon_1F_MarcosIntro	{'body': "WHOA!\\nYou shocked me!\\l…Oh, you're just a kid!$"}
text:MtMoon_1F_MarcosDefeat	{'body': 'Wow!\\nShocked again!$'}
text:MtMoon_1F_MarcosPostBattle	{'body': "Kids like you shouldn't be\\nwandering around here in the dark.$"}
text:MtMoon_1F_JoshIntro	{'body': 'Did you come to explore the cave,\\ntoo?$'}
text:MtMoon_1F_JoshDefeat	{'body': "Losing stinks!\\nIt's so uncool.$"}
text:MtMoon_1F_JoshPostBattle	{'body': 'I came all the way down here to\\nshow off to girls.$'}
text:MtMoon_1F_MiriamIntro	{'body': "Wow! It's way bigger in here than\\nI thought!$"}
text:MtMoon_1F_MiriamDefeat	{'body': 'Oh!\\nI lost it!$'}
text:MtMoon_1F_MiriamPostBattle	{'body': "How do you get out of here?\\nIt's so big, I may get lost.$"}
text:MtMoon_1F_JovanIntro	{'body': "What!\\nDon't sneak up on me!$"}
text:MtMoon_1F_JovanDefeat	{'body': "My POKéMON won't do!$"}
text:MtMoon_1F_JovanPostBattle	{'body': 'I have to find stronger POKéMON.\\nWhere might they be?$'}
text:MtMoon_1F_IrisIntro	{'body': "What?\\nI'm waiting for my friends to find\\lme here.$"}
text:MtMoon_1F_IrisDefeat	{'body': 'I lost?$'}
text:MtMoon_1F_IrisPostBattle	{'body': 'I came because I heard there are\\nsome very rare fossils here.$'}
text:MtMoon_1F_KentIntro	{'body': 'Suspicious men are in the cave.\\nWhat about you?$'}
text:MtMoon_1F_KentDefeat	{'body': 'You got me!$'}
text:MtMoon_1F_KentPostBattle	{'body': "I saw them!\\nI'm sure they're from TEAM ROCKET!$"}
text:MtMoon_1F_RobbyIntro	{'body': 'You need to go through this cave\\nto get to CERULEAN CITY.$'}
text:MtMoon_1F_RobbyDefeat	{'body': 'I lost.$'}
text:MtMoon_1F_RobbyPostBattle	{'body': "ZUBAT is tough!\\nBut if you can catch one, you'll\\lbe able to count on it.$"}
text:MtMoon_1F_ZubatIsABloodsucker	{'body': 'Beware!\\nZUBAT is a bloodsucker!$'}
text:MtMoon_1F_BrockHelpsExcavateFossils	{'body': "Hi, I'm excavating for fossils here\\nunder MT. MOON.\\pSometimes, BROCK of PEWTER GYM\\nlends me a hand.$"}
text:MtMoon_B2F_MiguelIntro	{'body': "Hey, stop!\\pI found these fossils!\\nThey're both mine!$"}
text:MtMoon_B2F_MiguelDefeat	{'body': "Okay!\\nI'll share!$"}
text:MtMoon_B2F_WellEachTakeAFossil	{'body': "We'll each take a fossil!\\nNo being greedy!$"}
text:MtMoon_B2F_ThenThisFossilIsMine	{'body': 'All right.\\nThen this fossil is mine!$'}
text:MtMoon_B2F_LabOnCinnabarRegeneratesFossils	{'body': "Far away, on CINNABAR ISLAND,\\nthere's a POKéMON LAB.\\pThey do research on regenerating\\nfossils.$"}
text:MtMoon_B2F_Grunt1Intro	{'body': 'We, TEAM ROCKET, shall find the\\nfossils!\\pReviving POKéMON from them will\\nearn us huge riches!$'}
text:MtMoon_B2F_Grunt1Defeat	{'body': "Urgh!\\nNow I'm mad!$"}
text:MtMoon_B2F_Grunt1PostBattle	{'body': 'You made me mad!\\nTEAM ROCKET will blacklist you!$'}
text:MtMoon_B2F_Grunt2Intro	{'body': 'We, TEAM ROCKET, are POKéMON\\ngangsters!\\lWe strike fear with our strength!$'}
text:MtMoon_B2F_Grunt2Defeat	{'body': 'I blew it!$'}
text:MtMoon_B2F_Grunt2PostBattle	{'body': "Darn it all!\\nMy associates won't stand for this!$"}
text:MtMoon_B2F_Grunt3Intro	{'body': "We're pulling a big job here!\\nGet lost, kid!$"}
text:MtMoon_B2F_Grunt3Defeat	{'body': 'So, you are good…$'}
text:MtMoon_B2F_Grunt3PostBattle	{'body': 'If you find a fossil, give it to me\\nand scram!$'}
text:MtMoon_B2F_Grunt4Intro	{'body': "Little kids shouldn't be messing\\naround with grown-ups!\\pIt could be bad news!$"}
text:MtMoon_B2F_Grunt4Defeat	{'body': "I'm steamed!$"}
text:MtMoon_B2F_Grunt4PostBattle	{'body': 'POKéMON lived here long before\\npeople came.$'}
text:MtMoon_B2F_YouWantDomeFossil	{'body': 'Do you want the DOME FOSSIL?$'}
text:MtMoon_B2F_YouWantHelixFossil	{'body': 'Do you want the HELIX FOSSIL?$'}
text:MtMoon_B2F_ObtainedHelixFossil	{'body': 'Obtained the HELIX FOSSIL!$'}
text:MtMoon_B2F_ObtainedDomeFossil	{'body': 'Obtained the DOME FOSSIL!$'}
text:MtPyre_1F.TakeThisForYourOwnGood	{'body': "All sorts of beings wander the slopes\\nof MT. PYRE…\\pThere is no telling what may happen.\\nTake this. It's for your own good.$"}
text:MtPyre_1F.ExplainCleanseTag	{'body': 'Have a POKéMON hold that\\nCLEANSE TAG.\\pIt will help ward off wild POKéMON.$'}
text:MtPyre_1F.ComeToPayRespects	{'body': 'Did you come to pay your respect\\nto the spirits of departed POKéMON?\\pYou must care for your POKéMON a lot.\\pThis mountain changes some evolutions.\\nLevel QUILAVA here at Lv. 36 or higher\\lfor Hisuian TYPHLOSION.\\pLevel RUFFLET here at Lv. 54 or higher\\nfor Hisuian BRAVIARY. Elsewhere, both\\lgrow into their usual forms.$'}
text:MtPyre_1F.RestingPlaceOfZigzagoon	{'body': 'This is the final resting place of my\\nZIGZAGOON. I cherished it…$'}
text:MtPyre_2F.MemoriesOfSkitty	{'body': 'Memories of my darling SKITTY…\\nMy eyes overflow thinking about it.$'}
text:MtPyre_2F.TumbledFromFloorAbove	{'body': "Ooch, ouch… There are holes in the\\nground here and there.\\pI didn't notice and took a tumble from\\nthe floor above.$"}
text:MtPyre_2F.MarkIntro	{'body': "Hey! Are you searching for POKéMON?\\nYou came along after me! You're rude!$"}
text:MtPyre_2F.MarkDefeat	{'body': "Ayieeeeh!\\nI'm sorry, forgive me, please!$"}
text:MtPyre_2F.MarkPostBattle	{'body': "People don't come here often, so\\nI thought there'd be rare POKéMON.$"}
text:MtPyre_2F.LukeIntro	{'body': "LUKE: We're here on a dare.\\pHeheh, if I show her how cool I am,\\nshe'll fall for me. I know it!\\pI know! I'll cream you and show her\\nhow cool I am!$"}
text:MtPyre_2F.LukeDefeat	{'body': 'LUKE: Whoopsie!$'}
text:MtPyre_2F.LukePostBattle	{'body': "LUKE: Well, we lost but that's okay!\\nI'm right here by your side.\\lWe'll make it through this dare!$"}
text:MtPyre_2F.LukeNotEnoughMons	{'body': "LUKE: If you want to take me on,\\nbring some more POKéMON.\\pIf you don't, I won't be able to show\\noff to my girl how cool I am!$"}
text:MtPyre_2F.DezIntro	{'body': "DEZ: I came here on a dare with my\\nboyfriend.\\pIt's really scary, but I'm with my\\nboyfriend. It's okay.\\pI know! I'll get my boyfriend to look\\ncool by beating you!$"}
text:MtPyre_2F.DezDefeat	{'body': "DEZ: Waaaah! I'm scared!$"}
text:MtPyre_2F.DezPostBattle	{'body': "DEZ: We're lovey-dovey, so we don't\\ncare if we lose!$"}
text:MtPyre_2F.DezNotEnoughMons	{'body': "DEZ: If you want to challenge us, you\\nshould bring at least two POKéMON.\\pMy boyfriend's strong.\\nJust one POKéMON won't do at all.$"}
text:MtPyre_2F.LeahIntro	{'body': 'You are an unfamiliar sight…\\nDepart before anything befalls you!$'}
text:MtPyre_2F.LeahDefeat	{'body': "Hmm…\\nYou're durable.$"}
text:MtPyre_2F.LeahPostBattle	{'body': "Our family has been TRAINERS here\\nsince my great-grandmother's time…\\pIt is my duty to protect this\\nmountain…$"}
text:MtPyre_2F.ZanderIntro	{'body': "Kiyaaaaah!\\nI'm terrified!$"}
text:MtPyre_2F.ZanderDefeat	{'body': 'Nooooooo!\\nI lost my wits!$'}
text:MtPyre_2F.ZanderPostBattle	{'body': "I get freaked out every time I see\\nanything move…\\pI shouldn't have come here to train…$"}
text:MtPyre_3F.WilliamIntro	{'body': 'The rich atmosphere of the mountain\\nhas elevated my psychic power!\\pA mere child like you…\\nYou dream of winning?$'}
text:MtPyre_3F.WilliamDefeat	{'body': 'I drown in self-pity…$'}
text:MtPyre_3F.WilliamPostBattle	{'body': 'My psychic powers have surely\\ngrown several times, but…$'}
text:MtPyre_3F.KaylaIntro	{'body': 'Ahahahaha!\\pThis is no place for children, least\\nof all you!$'}
text:MtPyre_3F.KaylaDefeat	{'body': 'I lost that cleanly…$'}
text:MtPyre_3F.KaylaPostBattle	{'body': "This means my training is still not\\nenough…\\pI've got to keep working toward the\\nsummit…\\pGo, me!$"}
text:MtPyre_3F.GabrielleIntro	{'body': 'Why have you come here?$'}
text:MtPyre_3F.GabrielleDefeat	{'body': "That was amazing!\\nYou're a very special TRAINER.$"}
text:MtPyre_3F.GabriellePostBattle	{'body': 'POKéMON no longer of this world.\\nPOKéMON that are with you now.\\pAnd the POKéMON that you will meet\\nin the future…\\pThey are all to be equally cherished.\\nPlease remember that.$'}
text:MtPyre_3F.GabrielleRegister	{'body': 'I would like to see your POKéMON\\nwhen they grow up some more…\\pPlease, I need to see your POKéNAV.$'}
text:MtPyre_3F.GabrielleRematchIntro	{'body': "Oh, it's you…\\pHave you come to show me your grown\\nPOKéMON?$"}
text:MtPyre_3F.GabrielleRematchDefeat	{'body': 'How amazing!\\nYou are a special person.$'}
text:MtPyre_3F.GabriellePostRematch	{'body': "POKéMON no longer of this world.\\nPOKéMON that are with you now.\\pAnd the POKéMON that you will meet\\nin the future…\\pThey are all to be equally cherished.\\nI see that you've remembered that.$"}
text:MtPyre_5F_AtsushiIntro	{'body': 'Teacher…\\nPlease watch over my progress!$'}
text:MtPyre_5F_AtsushiDefeat	{'body': 'Teacher…\\nPlease forgive me!$'}
text:MtPyre_5F_AtsushiPostBattle	{'body': 'Until I improve, my teacher, who rests\\nhere, will never find true peace…$'}
text:MtPyre_4F_TashaIntro	{'body': "I love all things horrifying…\\nIt's like a disease…\\pWhen I'm here…\\nI shiver with fear…$"}
text:MtPyre_4F_TashaDefeat	{'body': 'Losing, I dislike…$'}
text:MtPyre_4F_TashaPostBattle	{'body': "I want to see dreadful things…\\nI can't leave…\\pStay…\\nWon't you stay with me?$"}
text:MtPyre_6F.ValerieIntro	{'body': "When I'm here…\\nA curious power flows into me…$"}
text:MtPyre_6F.ValerieDefeat	{'body': 'The power is ebbing away…$'}
text:MtPyre_6F.ValeriePostBattle	{'body': 'Perhaps the power is from the spirits\\nof POKéMON in fitful sleep here…$'}
text:MtPyre_6F.ValerieRegister	{'body': 'Fufufu… I lost the match, but…\\nI have this little ability…\\pWithout ever laying my hands on\\nyour POKéNAV… Hiyah!$'}
text:MtPyre_6F.ValerieRematchIntro	{'body': 'Behind you…\\nWhat is it…$'}
text:MtPyre_6F.ValerieRematchDefeat	{'body': 'Something faded away…$'}
text:MtPyre_6F.ValeriePostRematch	{'body': 'The POKéMON at rest here…\\nSometimes, they play…$'}
text:MtPyre_6F.CedricIntro	{'body': 'Have you lost your bearings?\\nHave no fear for I am here!$'}
text:MtPyre_6F.CedricDefeat	{'body': "Weren't you lost?$"}
text:MtPyre_6F.CedricPostBattle	{'directives': ('.set EC_SIGN_PECHARUNT_ID, 65',), 'body': "I had this feeling that a lost TRAINER\\nwould be panicked and easy to beat.\\pIt's dirty and I won't try it again…$"}
text:MtPyre_6F.PecharuntDormant	{'body': 'PECHARUNT waits here. Earn the\\nMIND BADGE and catch OKIDOGI,\\lMUNKIDORI and FEZANDIPITI to\\lchallenge it.$'}
text:MtPyre_6F.PecharuntNeedsPartner	{'body': 'The three masks belong to OKIDOGI,\\nMUNKIDORI and FEZANDIPITI.\\pCatch all three, then return here.\\nThey do not need to travel with you.$'}
text:MtPyre_6F.PecharuntAwakens	{'body': 'The three masks flare! A poisoned mist\\nspills from the tombstone--PECHARUNT!$'}
text:MtPyre_6F.PecharuntQuiet	{'body': 'The tombstone is still. Three faded\\nmasks record the trial you completed.$'}
text:MtPyre_Summit.DarkraiDormant	{'body': 'A dream can calm this nightmare.\\pAfter helping the elders, befriend\\nMUNNA or MUSHARNA and return here.\\pYour Pokédex records the connection.\\nYour partner may stay in the PC.$'}
text:MtPyre_Summit.DarkraiQuiet	{'body': 'The nightmare has lifted. Your\\nencounter with DARKRAI is\\lrecorded.$'}
text:MtPyre_Summit.DarkraiNeedsTrainers	{'body': 'A dream can calm this nightmare.\\pAfter helping the elders, befriend\\nMUNNA or MUSHARNA and return here.\\pYour Pokédex records the connection.\\nYour partner may stay in the PC.$'}
text:MtPyre_Summit.DarkraiNeedsMusharna	{'body': 'A dream can calm this nightmare.\\pAfter helping the elders, befriend\\nMUNNA or MUSHARNA and return here.\\pYour Pokédex records the connection.\\nYour partner may stay in the PC.$'}
text:MtPyre_Summit.DarkraiAwakened	{'body': 'DARKRAI emerges from the\\nnightmare mist. Approach it at\\lthe summit.$'}
text:MtPyre_Summit.DarkraiAwaits	{'body': 'DARKRAI is still waiting in the\\nnightmare mist at the summit.$'}
text:MtPyre_Summit.CresseliaAwakened	{'body': "DARKRAI's capture has revealed a\\nnew lead: CRESSELIA shelters in\\lthe rear B1F room of METEOR\\lFALLS.\\pWith six badges and the MAGMA\\nEMBLEM, it can appear among\\lwild POKéMON there.$"}
text:MtPyre_Summit.CresseliaAwaits	{'body': "CRESSELIA can appear among wild\\nPOKéMON in METEOR FALLS' rear B1F\\lroom, after six badges and the\\lMAGMA EMBLEM.$"}
text:MtPyre_Summit.TimeSignDormant	{'body': 'DIALGA lives in the main B1F\\nchamber of METEOR FALLS. It has\\la 3% wild encounter chance.$'}
text:MtPyre_Summit.DialgaAwakened	{'body': 'DIALGA can appear among wild\\nPOKéMON in the main B1F chamber\\lof METEOR FALLS. Its chance is 3%.$'}
text:MtPyre_Summit.DialgaAwaits	{'body': 'Search the main B1F chamber of\\nMETEOR FALLS for DIALGA. Each\\lwild encounter has a 3% chance.$'}
text:MtPyre_Summit.DreamChainComplete	{'body': 'Nightmare, dream, and time have all\\nanswered you. Their legend is yours.$'}
text:MtPyre_Summit.MattIntro	{'body': "MATT: Hey, I know you! ARCHIE\\nsaid you'd turn up again.\\pHe needs more time at the summit.\\nSo you get to battle me!$"}
text:MtPyre_Summit.MattDefeat	{'body': "You're tougher than I expected!$"}
text:MtPyre_Summit.MattAfter	{'body': 'ARCHIE is beyond us with the RED\\nORB. If you follow, expect the\\lsea to fight back.$'}
text:MtPyre_Summit.Grunt1Intro	{'body': "MAGMA got here first. We're not\\nletting them take both ORBS!\\pAnd you're not getting through,\\neither!$"}
text:MtPyre_Summit.Grunt1Defeat	{'body': 'You got past me, too…$'}
text:MtPyre_Summit.Grunt1PostBattle	{'body': "ARCHIE's farther up. The others\\nwill stop you!$"}
text:MtPyre_Summit.Grunt2Intro	{'body': "We came all this way for the RED\\nORB. Don't think we're leaving\\lwithout it!$"}
text:MtPyre_Summit.Grunt2Defeat	{'body': "That wasn't supposed to happen!$"}
text:MtPyre_Summit.Grunt2PostBattle	{'body': 'Why do you keep following us?\\nMAGMA is the one you should be\\lstopping!$'}
text:MtPyre_Summit.Grunt3Intro	{'body': "You helped stop MAGMA at MT.\\nCHIMNEY. So why are you fighting\\lus now?\\pFine! I'll stop you myself!$"}
text:MtPyre_Summit.Grunt3Defeat	{'body': "You're really not on our side…$"}
text:MtPyre_Summit.Grunt3PostBattle	{'body': 'The battle still bought ARCHIE time.\\nThe RED ORB is already within reach.$'}
text:MtPyre_Summit.Grunt4Intro	{'body': "You again?! Do you ever get tired\\nof chasing TEAM AQUA?\\pI'm putting an end to it!$"}
text:MtPyre_Summit.Grunt4Defeat	{'body': 'Not again!$'}
text:MtPyre_Summit.Grunt4PostBattle	{'body': 'ARCHIE will know what to do. He\\nhas to.$'}
text:MtPyre_Summit.ArchieWeGotTheOrbLetsGo	{'body': 'ARCHIE: MAXIE took the BLUE ORB.\\nThe RED ORB belongs to AQUA now!\\pThe wardens used these ORBS to\\nkeep ancient powers asleep. I\\lwill use this one to wake the\\lsea.\\pAQUA, move out!$'}
text:MtPyre_Summit.BothOrbsTakenMagmaLeftThis	{'body': "Both ORBS are gone. They were\\nentrusted to us to keep GROUDON\\land KYOGRE's powers in balance.\\pMAGMA dropped this EMBLEM. Take\\nit to their hideout in JAGGED\\lPASS.\\pRide ROUTE 112's cable car to MT.\\nCHIMNEY, then descend the pass.\\pCarry the EMBLEM near the odd\\nboulder on the east side. It may\\lopen the way.\\pStop MAGMA before they awaken\\nsomething they cannot control.$"}
text:MtPyre_Summit.MagmaEmblemSentToPC	{'body': 'Your KEY ITEMS pocket is full, so the\\nMAGMA EMBLEM was sent to your PC.$'}
text:MtPyre_Summit.MagmaEmblemWaiting	{'body': 'The MAGMA EMBLEM is still waiting for\\nyou. Make room and take it now.$'}
text:MtPyre_Summit.MagmaEmblemNoRoom	{'body': 'Both your KEY ITEMS pocket and PC are\\nfull. Make room, then speak to me again.$'}
text:MtPyre_Summit.OrbsHaveBeenTaken	{'body': "The stolen ORBS can awaken\\nGROUDON and KYOGRE. Their powers\\lmust never clash again.\\pTake the MAGMA EMBLEM to JAGGED\\nPASS. Use ROUTE 112's cable car\\lto MT. CHIMNEY, then descend the\\lpass.\\pApproach the strange boulder on\\nthe east side. Find MAGMA before\\lthey awaken GROUDON.$"}
text:MtPyre_Summit.GroudonKyogreAwakened	{'body': 'Both GROUDON and KYOGRE are\\nawake? Then we are all in danger.\\pThe ORBS are part of their\\nancient bond. They are no\\lguarantee of obedience.\\pOnly RAYQUAZA stopped their last\\nclash. You must find someone who\\lknows where it rests.$'}
text:MtPyre_Summit.ThoseTwoMenReturnedOrbs	{'body': 'The two men returned the ORBS\\nthemselves. They finally saw what\\ltheir plans would do to HOENN.\\pI am glad they came back. But\\nrepairing the harm will take more\\lthan returning what they stole.$'}
text:MtPyre_Summit.SuperAncientPokemonTaughtUs	{'body': 'The embodiments of the land, sea,\\nand the sky…\\pThat is said to be the identities of\\nthe super-ancient POKéMON…\\pIn the same way that we humans and\\nPOKéMON have life, our world, too,\\lis alive…\\pThe super-ancient POKéMON have\\ntaught us that…$'}
text:MtPyre_Summit.WillYouHearOutMyTale	{'body': 'MT. PYRE is where we calm the spirits\\nof POKéMON that have passed on…\\pThis is a high place where one can\\nsee all of HOENN…\\pThe disembodied spirits of POKéMON\\nmust find solace here…\\pIs it coincidence that you are here…\\pWill you hear out my tale? A tale long\\ntold in the HOENN region?$'}
text:MtPyre_Summit.GroudonKyogreTale	{'body': 'GROUDON raised the land and\\nKYOGRE carved the sea. Their\\lclash grew until neither could\\lstop.\\pRAYQUAZA descended and calmed\\nthem. The RED and BLUE ORBS were\\lleft in our care.\\pTAPU LELE and Galarian MOLTRES\\nlive in the outside grass.\\lGIRATINA lives on the sixth floor.\\lEach has a 3% encounter chance.\\pAccept the MAGMA EMBLEM and earn\\nsix badges to find YVELTAL\\loutside, too. SWEET SCENT helps\\lwith that discovery.$'}
text:MtPyre_Summit.WellThatTooIsFine	{'body': 'I see…\\nWell, that, too, is fine…$'}
text:MtPyre_Summit.MaxieSilence	{'body': 'MAXIE: {PLAYER}…\\p… … … … … …\\n… … … … … …$'}
text:MtPyre_Summit.HearTheNewLegendOfHoenn	{'body': 'Our old tale tells how RAYQUAZA\\nstopped a terrible clash. Now we\\lhave seen it happen again.\\pWill you hear what people are\\nsaying about SOOTOPOLIS?$'}
text:MtPyre_Summit.HoennTrioTale	{'body': 'RAYQUAZA restored the balance.\\nYou helped HOENN find a way\\lthrough.\\pSearch the sixth floor for\\nGIRATINA. It has a 3% wild\\lencounter chance.$'}
text:MtPyre_Summit.OrbsApart	{'body': "The ORBS were entrusted to us to\\nkeep GROUDON and KYOGRE's powers\\lin balance.\\pOnly RAYQUAZA could calm their\\nlast clash. I fear we will need\\lits help again.$"}
text:NewMauville_Entrance.DoorIsLocked	{'body': 'The door is locked.$'}
text:NewMauville_Entrance.UseBasementKey	{'body': 'Use the BASEMENT KEY?$'}
text:NewMauville_Entrance.UsedBasementKey	{'body': '{PLAYER} used the BASEMENT KEY.\\pThe door opened!$'}
text:NewMauville_Inside.GeneratorRadiatingHeat	{'body': 'The generator is radiating heat that\\ncan be felt even at a distance.\\pIt looks like it should be turned off\\nas soon as possible.$'}
text:NewMauville_Inside.GeneratorQuietedDown	{'body': 'The generator quieted down.$'}
text:NewMauville_Inside.SteppedOnSwitchGeneratorStopped	{'body': '{PLAYER} stepped on the switch.\\pClick…\\p… … … … … … … …\\n… … … … … … … …\\pThe generator appears to have\\nstopped…$'}
text:NewMauville_Inside.GeneratorRestarted	{'body': 'Bzzzt! Something laughed inside the\\ngenerator, and it restarted itself!$'}
text:NewMauville_Inside.GeneratorRestartedAgain	{'body': 'The same cry rings through the plant.\\pWhatever is inside wants a battle.$'}
text:NewMauville_Inside.RotomAppears	{'body': 'The generator bursts open!\\nROTOM challenges your team!$'}
text:NewMauville_Inside.RotomRemains	{'body': 'ROTOM slips back into the generator.\\nIt is still waiting for your answer.$'}
text:NewMauville_Inside.RotomCaught	{'directives': ('.set EC_SIGN_ZAPDOS_ID, 69',), 'body': "ROTOM is safely out of the\\ngenerator.\\pThe ROTOM CATALOG changes ROTOM\\ninto its five appliances.\\pThe sign near the entrance lists\\nthis plant's wild POKéMON.\\pIt shows legendary requirements\\nand marks partners you've caught.\\pThe local guide in MAUVILLE's\\nPOKéMON CENTER can help, too.$"}
text:NewMauville_Inside.ZapdosDormant	{'body': 'ZAPDOS watches over the\\ngenerator. Return with the\\lBALANCE BADGE to challenge it.$'}
text:NewMauville_Inside.ZapdosNeedsPartner	{'body': 'ZAPDOS accepts challengers with\\nthe BALANCE BADGE. No partner\\lspecies is required.$'}
text:NewMauville_Inside.ZapdosAwakens	{'body': 'ZAPDOS crackles with electricity!\\nIt accepts your challenge!$'}
text:OldaleTown.OpeningBallSupplies	{'body': "Your field supplies are topped up!\\nCheck your Bag or item PC.\\pTry more partners before your\\nfirst battle with the PROF.'s kid.$"}
text:OldaleTown.SavingMyProgress	{'body': "I'm saving before I take a rest.\\nDon't forget yours!\\pOnce you SAVE, the START menu\\nalso has RELOAD. It loads your\\llast save without a reset.\\pAnything since that save is lost.\\nI always SAVE before trying\\lsomething I might want to undo!$"}
text:OldaleTown.IWorkAtPokemonMart	{'body': 'Hi!\\nI work at a POKéMON MART.\\pCan I get you to come with me?$'}
text:OldaleTown.ThisIsAPokemonMart	{'body': 'This is a POKéMON MART.\\nJust look for the blue roof!\\pThe clerk stocks POTIONS and\\nother supplies for your travels.\\pHere, take a POTION to try.$'}
text:OldaleTown.PotionExplanation	{'body': "A POTION can help an injured\\npartner while you're exploring.\\pYou can't use your BAG during\\nTRAINER battles, so patch\\leveryone up before a challenge!$"}
text:OldaleTown.WaitDontComeInHere	{'body': "Aaaaah! Wait!\\nPlease don't come in here.\\pI just discovered the footprints of\\na rare POKéMON!\\pWait until I finish sketching\\nthem, okay?$"}
text:OldaleTown.DiscoveredFootprints	{'body': 'I just discovered the footprints of\\na rare POKéMON!\\pWait until I finish sketching\\nthem, okay?$'}
text:OldaleTown.FinishedSketchingFootprints	{'body': 'I finished sketching those rare\\nPOKéMON footprints!\\pBut it turns out they were only\\nmy own footprints…$'}
text:OldaleTown.MayLetsGoBack	{'body': "MAY: {PLAYER}{KUN}!\\nOver here!\\lLet's hurry home!$"}
text:OldaleTown.BrendanLetsGoBack	{'body': "BRENDAN: I'm heading back to my dad's\\nLAB now.\\l{PLAYER}, you should hustle back, too.$"}
text:OldaleTown.TownSign	{'body': 'OLDALE TOWN\\n“Where things start off scarce.”$'}
text:OldaleTown_House1.LeftPokemonGoesOutFirst	{'body': 'In a DOUBLE BATTLE, your first two\\nPokémon able to battle form your\\lopening pair.\\pChange their party order before\\nyou challenge a Trainer. Those two\\lpartners set the opening.$'}
text:OldaleTown_House2.PokemonLevelUp	{'body': "Battles test your team here.\\nThey don't give experience.\\pUse the free LEVELER from the\\nCENTER to raise your whole party\\lto the current level cap.\\pBADGES raise that cap. Use it\\nagain when a new partner joins!\\pIt also checks for evolutions.\\nIf you meet a new requirement,\\ltry it again, even at the cap.$"}
text:OldaleTown_House2.YoullGoFurtherWithStrongPokemon	{'body': "A new move can make an old\\npartner feel completely different!\\pThe TUTOR by the CENTER PC can\\nteach your partner its available\\lmoves for free.\\pYou don't need to wait for\\nlevel-up moves. Visit again\\lafter your partner evolves!$"}
text:OldaleTown_Mart.PokeBallsAreSoldOut	{'body': 'The clerk is waiting for more\\nPOKé BALLS to arrive.\\pPROF. BIRCH and the MART guide\\noutside have field supplies for\\lnew Trainers, though!$'}
text:OldaleTown_Mart.ImGoingToBuyPokeBalls	{'body': "POKé BALLS are back in stock!\\nI'm going to catch some new\\lpartners for my team.$"}
text:OldaleTown_Mart.RestoreHPWithPotion	{'body': "A POTION restores a POKéMON's HP,\\nbut it won't wake a fainted one.\\pTake fainted partners to the\\nPOKéMON CENTER for a rest.$"}
text:OldaleTown_PokemonCenter_1F.TrainersCanUsePC	{'body': "Planning your team at the PC?\\nTry the TUTOR beside it, too.\\pAsk for a Battle Set: a prepared\\ncombination of moves, Ability,\\lNature, EVs, and a held item.\\pChoose Doubles for team battles.\\nYou can preview a set, then\\ldecide whether to apply it.\\pIt's free, and you can change\\nthe details afterward. Think of\\lit as a starting point!$"}
text:OldaleTown_PokemonCenter_1F.PokemonCentersAreGreat	{'body': 'I keep my POKé VIAL handy.\\nOne use restores the whole party\\loutside battle!\\pThe nurse refills its one dose\\nwhenever I stop for healing.\\pRegister a Key Item in your BAG,\\nthen press SELECT to use it.\\lMuch quicker on a long walk!$'}
text:OldaleTown_PokemonCenter_1F.WirelessClubNotAvailable	{'body': "The POKéMON WIRELESS CLUB on\\nthe second floor was built recently.\\pBut they say they're still making\\nadjustments.$"}
text:OldaleTown_PokemonCenter_1F.TradedInWirelessClub	{'body': 'The POKéMON WIRELESS CLUB on\\nthe second floor was built recently.\\pI traded POKéMON right away.$'}
text:OneIsland_BillLetsGoSeeCelio	{'body': "BILL: Here we are!\\nThis is ONE ISLAND.\\pThere are several islands around\\nhere, and this is one of them.\\pMy friend CELIO sent the boat to\\nfetch me here.\\pHe's in charge of the island's PC\\nnetwork by his lonesome.\\p…Why am I telling you this now?\\nLet's just go see CELIO!$"}
text:WhereDoYouWantToSail	{'body': 'Ahoy, there!\\nWhere do you want to sail?$'}
text:OneIsland_LuckyToHaveCelioHere	{'body': "Here we are on an island smack in\\nthe middle of nowhere.\\pWe're lucky to have an upstanding\\nyoung man like CELIO here.\\pMy granddaughter was in a tizzy\\nover CELIO's friend.\\pSomething about a famous\\nPOKéMANIAC?\\pI'm not sure what that means, but\\nCELIO is quite the man!$"}
text:OneIsland_HavePCLinkageWithKanto	{'body': "My granddaughter was in a tizzy\\nover a new breakthrough.\\pShe said we now have PC linkage\\nwith people in KANTO.\\pI'm not sure what that means, but\\nCELIO is quite the man!$"}
text:OneIsland_HavePCLinkageWithHoenn	{'body': "My granddaughter was in a tizzy\\nover a new breakthrough.\\pShe said we finally have PC linkage\\nwith people in HOENN.\\pI'm not sure what that means, but\\nCELIO is quite the man.\\pHe would make a fine husband for\\nmy granddaughter!$"}
text:OneIsland_IslandSign	{'body': 'ONE ISLAND\\nFriends Gather at Knot Island$'}
text:OneIsland_PokemonNetCenterSign	{'body': 'Expanding the POKéMON World!\\nPOKéMON NET CENTER$'}
text:OneIsland_ReturnToCinnabar	{'body': 'グレンタウンに\u3000もどりますか？$'}
text:OneIsland_IsntWarmClimateHereGreat	{'body': "Hi, sight-seeing, are you?\\nIsn't the warm climate here great?$"}
text:OneIsland_House1_GazeUponVolcanoOnSunnyDays	{'body': "On sunny days, I step out and gaze\\nupon the volcano.\\pThat's my daily routine.$"}
text:OneIsland_House1_LastTimeMtEmberErupted	{'body': 'Let me think… When was the last\\ntime MT. EMBER erupted?$'}
text:OneIsland_House2_IWantToStayHereForever	{'body': 'Young people all want to go off to\\nbig cities.\\pBut I want to stay here forever!$'}
text:OneIsland_KindleRoad_EmberSpa_WaterWarmsMeToCore	{'body': 'Hm!\\nHaaaaaaaaaaah!\\pAaaah! This is heavenly!\\nThe water warms me to my core!\\pYou should jump in, too.\\pGo to the middle, relax, and get\\ngood and warm!$'}
text:OneIsland_KindleRoad_EmberSpa_EnjoyBowlOfChowder	{'body': 'My favorite part of bathing comes\\nup right after this.\\pI enjoy a bowl of chowder to\\nwarm me from the inside, too!$'}
text:OneIsland_KindleRoad_EmberSpa_WaterExquisiteFullyRefreshed	{'body': 'The water is perfectly warm.\\nIt feels exquisite…\\p{PLAYER} and the POKéMON were\\nfully refreshed!$'}
text:OneIsland_KindleRoad_EmberSpa_HotSpringIsTherapeutic	{'body': 'Soaking in a hot spring pool is\\ntherapeutic, people say.$'}
text:OneIsland_KindleRoad_EmberSpa_SeeHowSmoothMySkinIs	{'body': "Have a look at my face.\\nSee how smooth my skin is?\\pThe hot spring's water keeps my\\nskin younger than my age.$"}
text:OneIsland_KindleRoad_EmberSpa_BrunoVisitsSpaOnOccasion	{'body': "After an honest day of training,\\nnothing beats a relaxing soak in\\lthe hot spring pool.\\pBRUNO, who's a senior ahead of me,\\nvisits the SPA on occasion.\\pHe comes to rehab injuries, both\\nhis own and his POKéMON's.$"}
text:OneIsland_KindleRoad_EmberSpa_UsedThisToMakeEmberSpa	{'body': 'Hot springs go hand-in-hand with\\nvolcanoes.\\pThe EMBER SPA here, well,\\nI made it years ago.\\pI hewed the pool right out of a\\ngigantic boulder by hand.\\pI was using this at the time.\\nI suppose I can part with it.$'}
text:OneIsland_KindleRoad_EmberSpa_ExplainHM06	{'body': 'That shatters boulders as if they\\nwere made of crackers.$'}
text:OneIsland_KindleRoad_MariaIntro	{'body': "The weather's gorgeous!\\nPerfect for a battle!$"}
text:OneIsland_KindleRoad_MariaDefeat	{'body': 'Aiyeeeeh!$'}
text:OneIsland_KindleRoad_MariaPostBattle	{'body': "Please don't splash my face!\\nYou'll ruin the makeup.$"}
text:OneIsland_KindleRoad_AbigailIntro	{'body': "I'm beginning to get a sunburn…$"}
text:OneIsland_KindleRoad_AbigailDefeat	{'body': "Oh, you're so awful.$"}
text:OneIsland_KindleRoad_AbigailPostBattle	{'body': 'I like that cap you have.\\nMaybe I should wear one, too…$'}
text:OneIsland_KindleRoad_FinnIntro	{'body': 'Seen from here, MT. EMBER towers\\ninto the sky.$'}
text:OneIsland_KindleRoad_FinnDefeat	{'body': "Well, aren't you tough?$"}
text:OneIsland_KindleRoad_FinnPostBattle	{'body': 'The sky is immense around these\\nparts.$'}
text:OneIsland_KindleRoad_GarrettIntro	{'body': 'I took a break from swimming,\\nonly to have you challenge me?$'}
text:OneIsland_KindleRoad_GarrettDefeat	{'body': "Hey, what the…\\nYou're good, you!$"}
text:OneIsland_KindleRoad_GarrettPostBattle	{'body': 'Instead of using SURF all the time,\\nyou should swim some.$'}
text:OneIsland_KindleRoad_TommyIntro	{'body': "Wait! Wait a second!\\nI think I've hooked a big one!$"}
text:OneIsland_KindleRoad_TommyDefeat	{'body': "I've lost it all again…$"}
text:OneIsland_KindleRoad_TommyPostBattle	{'body': 'Not only did I lose, the big one\\ngot away from me, too!$'}
text:OneIsland_KindleRoad_SharonIntro	{'body': 'Could you help me out with my\\ntraining?$'}
text:OneIsland_KindleRoad_SharonDefeat	{'body': 'You were a cut above me.$'}
text:OneIsland_KindleRoad_SharonPostBattle	{'body': "It's clear that you're skilled.\\nI like you!$"}
text:OneIsland_KindleRoad_TanyaIntro	{'body': "There isn't a day in which we don't\\ntrain!$"}
text:OneIsland_KindleRoad_TanyaDefeat	{'body': "I'm such a fool!$"}
text:OneIsland_KindleRoad_TanyaPostBattle	{'body': "I'll train even harder from now on!$"}
text:OneIsland_KindleRoad_SheaIntro	{'body': 'Every morning, before breakfast,\\nI swim around this island.$'}
text:OneIsland_KindleRoad_SheaDefeat	{'body': 'Gasp…\\nGasp…$'}
text:OneIsland_KindleRoad_SheaPostBattle	{'body': "I lost because I'm pooped from all\\nthe running I did…$"}
text:OneIsland_KindleRoad_HughIntro	{'body': 'Dress appropriately for battle!\\nLose that frivolous outfit!$'}
text:OneIsland_KindleRoad_HughDefeat	{'body': 'Why me?!$'}
text:OneIsland_KindleRoad_HughPostBattle	{'body': 'Even martial artists are becoming\\nfashion conscious these days…$'}
text:OneIsland_KindleRoad_BryceIntro	{'body': "You know, everything tastes great\\nwhen you're out in the wild.$"}
text:OneIsland_KindleRoad_BryceDefeat	{'body': 'Awww, blown!$'}
text:OneIsland_KindleRoad_BrycePostBattle	{'body': 'The water in volcanic regions is\\ndelicious.$'}
text:OneIsland_KindleRoad_ClaireIntro	{'body': 'My lunch filled us up, so will you\\nbattle us for some exercise?$'}
text:OneIsland_KindleRoad_ClaireDefeat	{'body': 'That made me all sweaty.$'}
text:OneIsland_KindleRoad_ClairePostBattle	{'body': 'What should I do?\\nI feel famished again.$'}
text:OneIsland_KindleRoad_KiaIntro	{'body': 'KIA: My big brother and I make\\nan awesome combination!$'}
text:OneIsland_KindleRoad_KiaDefeat	{'body': "KIA: Huh?!\\nI can't believe it!$"}
text:OneIsland_KindleRoad_KiaPostBattle	{'body': 'KIA: How could there be anyone\\nbetter than my big brother?$'}
text:OneIsland_KindleRoad_KiaNotEnoughMons	{'body': 'KIA: If you want to battle with\\nus, you have to bring at least two\\lPOKéMON with you.$'}
text:OneIsland_KindleRoad_MikIntro	{'body': "MIK: Together with KIA, I'm afraid\\nof nothing!$"}
text:OneIsland_KindleRoad_MikDefeat	{'body': "MIK: Whoa!\\nThat's too much!$"}
text:OneIsland_KindleRoad_MikPostBattle	{'body': 'MIK: How could my combination\\nwith KIA fail?$'}
text:OneIsland_KindleRoad_MikNotEnoughMons	{'body': 'MIK: Hey, do you want to battle\\nwith us two?\\pBring two or more POKéMON with\\nyou, then.$'}
text:OneIsland_KindleRoad_RouteSign	{'body': 'This is KINDLE ROAD.\\pGo straight for MT. EMBER.$'}
text:OneIsland_KindleRoad_EmberSpaSign	{'body': 'Light the Fire in Your Heart!\\nEMBER SPA$'}
text:OneIsland_PokemonCenter_1F_BillHeyThereCelio	{'body': 'BILL: Hey, there!\\nCELIO!$'}
text:OneIsland_PokemonCenter_1F_CelioCantBelieveYouCameOut	{'body': "CELIO: BILL!\\nI can't believe you came out here.$"}
text:OneIsland_PokemonCenter_1F_BillHowsYourResearchComing	{'body': "BILL: Well, absolutely!\\nHow's your research coming along?\\p…Oh, wait a sec.$"}
text:OneIsland_PokemonCenter_1F_ThisIsMyBuddyCelio	{'body': "{PLAYER}, this is my buddy CELIO.\\nHe's one dedicated PC MANIAC!$"}
text:OneIsland_PokemonCenter_1F_PlayerIsRisingPokemonChamp	{'body': 'CELIO, this is {PLAYER}, a rising\\ncontender as the POKéMON CHAMP!$'}
text:OneIsland_PokemonCenter_1F_PlayerIsReigningPokemonChamp	{'body': 'CELIO, this is {PLAYER}, the\\nreigning POKéMON CHAMP!$'}
text:OneIsland_PokemonCenter_1F_CelioThatsReallyImpressive	{'body': "CELIO: That's really impressive.\\pI hate to say it, but I have zero\\naptitude for battling.\\pAnyways, I'm glad to meet you.$"}
text:OneIsland_PokemonCenter_1F_BillBringMeUpToSpeed	{'body': "BILL: So, bring me up to speed.\\nHow's your machine running?$"}
text:OneIsland_PokemonCenter_1F_CelioPCsCantLinkWithYours	{'body': "CELIO: It's running fine, but we're\\ntoo remote out here.\\pThe PCs on this island just can't\\nlink with your PC, BILL.$"}
text:OneIsland_PokemonCenter_1F_BillLetMeHelpYou	{'body': 'BILL: Oh, yeah?\\nOkay, let me take a look-see.\\p…Hang on here…\\nI think we can make it work.\\lLet me help you, okay?$'}
text:OneIsland_PokemonCenter_1F_CanYouDeliverThisMeteoritePlayer	{'body': "{PLAYER}, can I get you to wait for\\nme just a bit?\\p…Actually, can I get you to do\\nme a favor?\\pThe island next to this one's\\ncalled TWO ISLAND.\\pThere's a guy there that runs\\na GAME CORNER.\\pHe has this thing for rare rocks\\nand gems.\\pWe keep in touch, being fellow\\nmaniacs.\\pSo, can I get you to deliver this\\nMETEORITE to him?$"}
text:OneIsland_PokemonCenter_1F_AcceptedMeteoriteFromBill	{'body': '{PLAYER} accepted the METEORITE\\nfrom BILL.$'}
text:OneIsland_PokemonCenter_1F_CelioPleaseTakeThis	{'body': 'CELIO: {PLAYER}, if you are going\\nto TWO ISLAND, please take this.$'}
text:OneIsland_PokemonCenter_1F_PassLetsYouTravelBetweenIslands	{'body': "It's a PASS for the ferry service\\nserving the local islands.\\pIt will let you travel between the\\nISLANDS ONE, TWO, and THREE.\\pOh, you should have this, too.$"}
text:OneIsland_PokemonCenter_1F_ReceivedExtraPageForTownMap	{'body': '{PLAYER} received an extra page\\nfor the TOWN MAP!$'}
text:OneIsland_PokemonCenter_1F_ReceivedTownMap	{'body': '{PLAYER} received\\na TOWN MAP!$'}
text:OneIsland_PokemonCenter_1F_BillCatchYouLater	{'body': "BILL: I'll catch you later!\\nSay hi to the guy for me!$"}
text:OneIsland_PokemonCenter_1F_HmmHowAboutLikeThis	{'body': 'Hmm…\\pHow about we try this like this…$'}
text:OneIsland_PokemonCenter_1F_GotPCWorkingStrollAWhileMore	{'body': "Oh, hey, {PLAYER}!\\pDid you see?\\nWe got the PC working!\\pI've got a few things to show\\nCELIO here.\\pCan you go out on a stroll or\\nsomething for a while more?$"}
text:OneIsland_PokemonCenter_1F_SorryForBeingPoorHost	{'body': "I'm sorry for taking up so much of\\nBILL's time.\\pI'm also sorry for being such a \\npoor host on your visit here.$"}
text:OneIsland_PokemonCenter_1F_UsualPCServicesUnavailable	{'body': "The usual PC services aren't\\navailable…$"}
text:OneIsland_PokemonCenter_1F_BillOhHeyPlayer	{'body': 'BILL: Oh, hey!\\n{PLAYER}!$'}
text:OneIsland_PokemonCenter_1F_BillWeGotItDone	{'body': 'BILL: What kept you so long?\\nBeen out having a good time?\\pWe got it done.\\nThe PCs are up and running!$'}
text:OneIsland_PokemonCenter_1F_CelioJobWentQuick	{'body': 'CELIO: The job went incredibly\\nquick.\\pBILL is one amazing guy…$'}
text:OneIsland_PokemonCenter_1F_BillYouveLearnedALot	{'body': "BILL: No, no! There was almost\\nnothing left for me to do.\\pCELIO, I have to hand it to you.\\nYou've learned a lot.$"}
text:OneIsland_PokemonCenter_1F_CelioOhReallyEhehe	{'body': 'CELIO: Oh, really?\\nEhehe…$'}
text:OneIsland_PokemonCenter_1F_BillWeShouldHeadBackToKanto	{'body': "BILL: Well, there you have it.\\nI'm finished with the job.\\lWe should head back to KANTO.\\pCELIO, I'll be seeing you again.$"}
text:OneIsland_PokemonCenter_1F_CelioPromiseIllShowYouAroundSometime	{'body': "CELIO: {PLAYER}, I'm really sorry\\nthat we sent you off alone today.\\pI promise, I will show you around\\nthese islands sometime.$"}
text:OneIsland_PokemonCenter_1F_CelioImModifyingMyNetworkMachine	{'body': "CELIO: Hello!\\nYou look awfully busy as always.\\pHow am I doing?\\pWell, I'm modifying my Network\\nMachine.\\pWhen I get done with the machine,\\nI hope you'll be first to use it,\\l{PLAYER}.$"}
text:OneIsland_PokemonCenter_1F_CelioCaughtMoreMonMaybeICanBeUseful	{'body': "CELIO: {PLAYER}, how have things\\nbeen for you?\\pOh, is that right?\\nYou've caught more POKéMON.\\pDo you know what?\\nMaybe I can be useful to you.$"}
text:OneIsland_PokemonCenter_1F_YoullBeTradingFromTrainersFarAway	{'body': "I'm modifying the Network Machine\\nright now.\\pI'm changing it so it can handle\\ntrades over long distances.\\pWhen I get finished, you'll be\\ntrading for exotic POKéMON from\\lTRAINERS far away.$"}
text:OneIsland_PokemonCenter_1F_NeedsSpecialGemstone	{'body': "But, there is a slight catch.\\pFor the link to work, the Machine\\nneeds a special gemstone.\\pIt's supposed to be on ONE ISLAND,\\nbut I haven't found one yet.\\pWho knows where it could be.$"}
text:OneIsland_PokemonCenter_1F_TryingToFindGem	{'body': "I was trying to find the gem\\neven while I was studying.\\pAs a result, I've made no headway\\nin both my search and studies…\\pIf I relied on BILL, I'm sure my\\nresearch would progress.\\pBut this time, I want to try to do\\nthings by myself.$"}
text:OneIsland_PokemonCenter_1F_OhThats	{'body': "Oh!\\nTh-that's…$"}
text:OneIsland_PokemonCenter_1F_HandedRubyToCelio	{'body': '{PLAYER} handed the RUBY\\nto CELIO.$'}
text:OneIsland_PokemonCenter_1F_MayIAskOneMoreFavor	{'body': "Thank you!\\n{PLAYER}, you're simply amazing.\\p… … …  … … …\\pUm… May I ask one more giant favor\\nof you?$"}
text:OneIsland_PokemonCenter_1F_PleaseINeedYourHelp	{'body': "It… It's not anything weird.\\nPlease, I need your help.$"}
text:OneIsland_PokemonCenter_1F_AnotherGemstoneInSeviiIslands	{'body': 'While I was studying gemstones,\\nI discovered something important.\\pThere is another gem that forms\\na pair with this RUBY.\\pThat other gemstone is supposed to\\nbe in the SEVII ISLANDS.\\p{PLAYER}, please, I need you to go\\nfind the other gem.\\p{PLAYER}, may I have your ferry\\nPASS and the TOWN MAP?$'}
text:OneIsland_PokemonCenter_1F_ReturnedTriPassForRainbowPass	{'body': '{PLAYER} returned the TRI-PASS and\\nreceived the RAINBOW PASS.$'}
text:OneIsland_PokemonCenter_1F_ObtainedExtraMapPage	{'body': 'Obtained an extra page for the\\nTOWN MAP!$'}
text:OneIsland_PokemonCenter_1F_PassLetYouGetToAllIslands	{'body': "This is my own ferry PASS.\\pIt will let you get to all the\\nSEVII ISLANDS.\\p{PLAYER}, please, I can't do\\nit without your help.$"}
text:OneIsland_PokemonCenter_1F_HandedSapphireToCelio	{'body': '{PLAYER} handed the SAPPHIRE\\nto CELIO.$'}
text:OneIsland_PokemonCenter_1F_ThankYouGiveMeTime	{'body': "CELIO: So this is the gem that\\nforms a pair with the RUBY…\\p{PLAYER}, you've gone through a lot\\nto get this, didn't you?\\pYou don't have to tell me. I know\\nit wasn't easy.\\pThank you so much!\\pNow it's my turn to work for you!\\nPlease give me a little time.$"}
text:OneIsland_PokemonCenter_1F_OkayThisIsGood	{'body': 'Okay, this is good…$'}
text:OneIsland_PokemonCenter_1F_LinkedUpWithLanette	{'body': 'I did it!\\nI linked up with LANETTE!$'}
text:OneIsland_PokemonCenter_1F_ManagedToLinkWithHoennThankYou	{'body': "{PLAYER}…\\n{PLAYER}, I did it!\\pI've managed to link up with\\nTRAINERS in the HOENN region!\\pFinally, the Network Machine is\\nfully operational!\\p{PLAYER}, I owe it all to you!\\pThanks to you, my dream came\\ntrue…$"}
text:OneIsland_PokemonCenter_1F_WishYouBestOfLuck	{'body': "I…\\nI'm not crying.\\pThat's enough about me!\\p{PLAYER}, you're going to keep\\nlooking for exotic POKéMON, right?\\pI wish you the best of luck!$"}
text:OneIsland_PokemonCenter_1F_CelioHearingRumorsAboutYou	{'body': "CELIO: Hello!\\p{PLAYER}, I've been hearing rumors\\nabout you.$"}
text:OneIsland_PokemonCenter_1F_BillsFirstMonWasAbra	{'body': "{PLAYER}, what's your favorite kind\\nof POKéMON?\\pBILL is a POKéMANIAC, so he loves\\nevery kind.\\pApparently, the first one he caught\\nwas an ABRA.$"}
text:OneIsland_PokemonCenter_1F_BillsHometownInGoldenrod	{'body': "By the way, {PLAYER}, you're from\\nPALLET TOWN, aren't you?\\pI've heard that it's a quiet and\\npleasant place.\\pBILL's hometown is GOLDENROD CITY,\\nwhere his folks still live.\\pI've heard that it's quite the\\nfestive, bustling city.\\pI'd like to go there one day.$"}
text:OneIsland_PokemonCenter_1F_BillCantStomachMilk	{'body': "{PLAYER}, is there anything that\\nyou can't stand?\\pApparently, BILL simply can't\\nstomach milk at all.$"}
text:OneIsland_PokemonCenter_1F_CameFromPalletDontKnowIt	{'body': "Oh, you're a stranger here!\\nHi! Where did you come from?\\p…PALLET TOWN?\\nI don't know it!$"}
text:OneIsland_PokemonCenter_1F_EnormousVolcanoOnIsland	{'body': "On this island, there's an enormous\\nvolcano.\\pIt hasn't erupted lately, so why\\nnot enjoy a hike?$"}
text:OneIsland_PokemonCenter_1F_WishICouldTradeWithBoyfriend	{'body': 'I wish I could trade POKéMON with\\nmy boyfriend who lives far away…$'}
text:OneIsland_PokemonCenter_1F_TradedWithFarAwayBoyfriend	{'body': "I traded POKéMON with my boyfriend\\nfar away!\\pEveryone's saying that we can\\nthank you and CELIO.\\pSo, thank you!$"}
text:OneIsland_PokemonCenter_1F_MachineUnderAdjustment	{'body': 'Network Machine\\nLink Level 0\\p…POKéMON Storage System under\\nadjustment…$'}
text:OneIsland_PokemonCenter_1F_MachineLinkedWithKanto	{'body': 'Network Machine\\nLink Level 1\\pLink established with the KANTO\\nregion.$'}
text:OneIsland_PokemonCenter_1F_MachineLinkedWithKantoAndHoenn	{'body': 'Network Machine\\nLink Level 2\\pLink established with the KANTO\\nand HOENN regions.$'}
text:OneIsland_PokemonCenter_1F_ObtainedTriPass	{'body': 'Obtained the TRI-PASS!$'}
text:OneIsland_TreasureBeach_AmaraIntro	{'body': "Lying back, rocked by the waves…\\nIt's exquisite.$"}
text:OneIsland_TreasureBeach_AmaraDefeat	{'body': 'I lost…\\nIt feels awful.$'}
text:OneIsland_TreasureBeach_AmaraPostBattle	{'body': 'The sea is pleasantly warm in these\\nparts.$'}
text:OneIsland_TreasureBeach_GoodThingsWashUpOnBeach	{'body': "Good things get washed up by the\\nocean current onto this beach.\\pThat's why I often come here for\\nsome beachcombing.$"}
text:PacifidlogTown.FastRunningCurrent	{'body': 'The sea between PACIFIDLOG and\\nSLATEPORT has a fast-running tide.\\pIf you decide to SURF, you could end\\nup swept away somewhere else.$'}
text:PacifidlogTown.NeatHousesOnWater	{'body': "See, isn't it neat?\\nThese houses are on water!\\pI was born here!$"}
text:PacifidlogTown.SkyPillarTooScary	{'body': "The SKY PILLAR?\\p…Oh, you must mean that tall, tall\\ntower a little further out.\\pIf you asked me, I wouldn't climb it.\\nIt's too scary to get up that high.\\pLife at sea level in PACIFIDLOG,\\nthat suits me fine.$"}
text:PacifidlogTown.TownSign	{'body': 'PACIFIDLOG TOWN\\p“Where the morning sun smiles upon\\nthe waters.”$'}
text:PacifidlogTown_House1.RegiStory	{'body': "In the HOENN region, there are three\\nPOKéMON that represent the power of\\lrock, ice, and steel.\\pEach of them is said to hide away deep\\ninside caves.\\pThat's the story I heard when I was\\njust a little kid.$"}
text:PacifidlogTown_House1.SixDotsOpenThreeDoors	{'body': "“Six dots open three doors.”\\pGrandpa used to say that, but I don't\\nknow what he meant.$"}
text:PacifidlogTown_House2.ChairmansYoungerBrotherOnVacation	{'body': "Er-hem!\\pI am the POKéMON FAN CLUB's most\\nimportant person, the CHAIRMAN's\\lyounger brother.\\pI'm here enjoying my vacation with\\nPOKéMON, yes, indeed.$"}
text:PacifidlogTown_House2.AhYourPokemon	{'body': 'Ah!\\nYour POKéMON…$'}
text:PacifidlogTown_House2.AdoringPokemonTakeThis	{'body': "It clearly likes you very much.\\pA POKéMON that bright deserves this\\nSUN STONE, don't you think?$"}
text:PacifidlogTown_House2.PutInSomeMoreEffort	{'body': "Hmm…\\nIt's not bad, but it's also not good.\\pYou, as the TRAINER, need to put in\\nsome more effort.$"}
text:PacifidlogTown_House2.ViciousPokemonTakeThis	{'body': 'It has a fierce look to it.\\pA POKéMON that intense deserves this\\nMOON STONE.$'}
text:PacifidlogTown_House2.ExplainReturnFrustration	{'body': 'SUN and MOON STONES evolve different\\nPOKéMON. Use this one when ready.$'}
text:PacifidlogTown_House2.GetGoodStoneInXDays	{'body': "In {STR_VAR_1} days, I'll receive more\\nevolution stones.\\pCome see me then, and I'll choose one\\nthat suits your lead POKéMON.$"}
text:PacifidlogTown_House2.Rurii	{'body': 'AZURILL: Rurii.$'}
text:PacifidlogTown_House2.VeryFriendlyWithTrainer	{'body': 'It appears to be very friendly with the\\nTRAINER.$'}
text:PacifidlogTown_House2.Rururi	{'body': 'AZURILL: Rururi!$'}
text:PacifidlogTown_House2.DoesntLikeTrainerVeryMuch	{'body': "It doesn't appear to like the TRAINER\\nvery much.$"}
text:PacifidlogTown_House3.WillingToTradeIt	{'body': "Check out this {STR_VAR_2}!\\pIt's the {STR_VAR_2} that I caught\\nyesterday to celebrate my birthday!\\pOh, I can see that you want it!\\nAfter all, it's priceless!\\pI'll tell you what. I might be willing\\nto trade it for a {STR_VAR_1}.$"}
text:PacifidlogTown_House3.ItsSubtlyDifferentThankYou	{'body': "Oh, so this is a {STR_VAR_1}?\\pIt's sort of like a {STR_VAR_2},\\nand yet it's subtly different.\\pMy {STR_VAR_2} is already trained\\nfor doubles. Ride it well!$"}
text:PacifidlogTown_House3.WontAcceptAnyLessThanRealMon	{'body': "No, no, no! I won't accept any\\nless than a real {STR_VAR_1}!$"}
text:PacifidlogTown_House3.NotDesperateOrAnything	{'body': "Oh, so you're not going to go through\\nwith this?\\pThat's cool. I'm not desperate to make\\na trade or anything.$"}
text:PacifidlogTown_House3.ReallyWantedToGetBagon	{'body': 'I know I could go looking for one\\non my own, but…\\pBut I really wanted to get a BAGON\\nthat another TRAINER caught…$'}
text:PacifidlogTown_House3.IsThatAPokedex	{'body': 'Is that a POKéDEX?\\pDid you get to meet a lot of different\\nPOKéMON?\\pI wish I was like you.$'}
text:PacifidlogTown_House4.PeopleSawHighFlyingPokemon	{'body': "People were saying they saw a POKéMON\\nflying high above HOENN.\\pIs it flying around all the time?\\nDoesn't it need to rest somewhere?$"}
text:PacifidlogTown_House4.SkyPokemon	{'body': 'A sky POKéMON!\\nA sky POKéMON!$'}
text:PacifidlogTown_House4.WhereDidYouComeFrom	{'body': 'Where did you come from?$'}
text:PacifidlogTown_House4.YesTown	{'body': "Yes?\\nYES TOWN?\\pI've never heard of a place like that.$"}
text:PacifidlogTown_House4.YouHaveToComeFromSomewhere	{'body': "No? That doesn't make any sense.\\nYou have to come from somewhere.\\pOh! Wait! You're not going to say you\\nwere born at the bottom of the sea?$"}
text:PacifidlogTown_House5.CantSeeMirageIslandToday	{'body': "I can't see MIRAGE ISLAND today…$"}
text:PacifidlogTown_House5.CanSeeMirageIslandToday	{'body': 'Oh! Oh my!\\nI can see MIRAGE ISLAND today!$'}
text:PacifidlogTown_House5.MirageIslandAppearDependingOnWeather	{'body': 'MIRAGE ISLAND…\\pIt must become visible and invisible\\ndepending on the weather conditions\\lthat make mirages appear.\\pOr is it really appearing and\\ndisappearing?$'}
text:PacifidlogTown_PokemonCenter_1F.WhatColorTrainerCard	{'body': "What color is your TRAINER CARD?\\nMine's copper!$"}
text:PacifidlogTown_PokemonCenter_1F.OnColonyOfCorsola	{'body': 'PACIFIDLOG TOWN floats on top of\\na colony of CORSOLA.\\pIf I told you that, would you believe\\nme?$'}
text:PacifidlogTown_PokemonCenter_1F.AncestorsLivedOnBoats	{'body': 'The ancestors of the people in\\nPACIFIDLOG were said to have been\\lborn on boats and then lived and died \\laboard them.\\pI understand that they lived that way\\nbecause they were searching for\\lsomething.$'}
text:PalletTown_OakDontGoOut	{'body': "OAK: Hey! Wait!\\nDon't go out!$"}
text:PalletTown_OakGrassUnsafeNeedMon	{'body': "OAK: It's unsafe!\\nWild POKéMON live in tall grass!\\pYou need your own POKéMON for\\nyour protection.\\pI know!\\nHere, come with me!$"}
text:PalletTown_RaisingMonsToo	{'body': "I'm raising POKéMON, too.\\pWhen they get strong, they can\\nprotect me.$"}
text:PalletTown_CanStoreItemsAndMonsInPC	{'body': 'Technology is incredible!\\pYou can now store and recall items\\nand POKéMON as data via PC.$'}
text:PalletTown_OakPokemonResearchLab	{'body': 'OAK POKéMON RESEARCH LAB$'}
text:PalletTown_PlayersHouse	{'body': "{PLAYER}'s house$"}
text:PalletTown_RivalsHouse	{'body': "{RIVAL}'s house$"}
text:PalletTown_TownSign	{'body': 'PALLET TOWN\\nShades of your journey await!$'}
text:PalletTown_OakLetMeSeePokedex	{'body': "OAK: Ah, {PLAYER}!\\nYou're back, are you?\\pHow much have you filled in your\\nPOKéDEX?\\pMay I see it?\\pLet's see…$"}
text:PalletTown_CaughtXPuttingInHonestEffort	{'body': "You've caught {STR_VAR_2}…\\pHm, it looks as if you're putting\\nin an honest effort.\\pWhen you manage to fill it some\\nmore, come show me, please.$"}
text:PalletTown_CaughtXImpressiveFollowMe	{'body': "You've caught… {STR_VAR_2}!?\\nNow, this is impressive!\\pThere's something I wanted to ask\\nof you, {PLAYER}.\\pCome.\\nFollow me.$"}
text:PalletTown_OakYouEnjoyingTraveling	{'body': 'OAK: Ah, {PLAYER}!\\nYou seem to be enjoying traveling.\\pKnowing you, {PLAYER}, I can easily\\nimagine you going out to even more\\lexotic locales.\\pGood for you, good for you.\\nHohoho.$'}
text:PalletTown_HmmIsThatRight	{'body': 'Hmm…\\nIs that right…$'}
text:PalletTown_OhLookLook	{'body': 'Oh!\\nLook, look!$'}
text:PalletTown_ReadItReadIt	{'body': 'Read it, read it!$'}
text:PalletTown_PressStartToOpenMenu	{'body': 'TRAINER TIPS\\pPress START to open the MENU!$'}
text:PalletTown_SignsAreUsefulArentThey	{'body': "Signs are useful, aren't they?$"}
text:PalletTown_LookCopiedTrainerTipsSign	{'body': 'Look, look!\\pI copied what it said on one of\\nthose TRAINER TIPS signs!$'}
text:PalletTown_PressStartToOpenMenuCopy	{'body': 'TRAINER TIPS!\\pPress START to open the MENU!$'}
text:PalletTown_PlayersHouse_1F_AllBoysLeaveOakLookingForYou	{'body': 'MOM: …Right.\\nAll boys leave home someday.\\lIt said so on TV.\\pOh, yes. PROF. OAK, next door, was\\nlooking for you.$'}
text:PalletTown_PlayersHouse_1F_AllGirlsLeaveOakLookingForYou	{'body': 'MOM: …Right.\\nAll girls dream of traveling.\\lIt said so on TV.\\pOh, yes. PROF. OAK, next door, was\\nlooking for you.$'}
text:PalletTown_PlayersHouse_1F_YouShouldTakeQuickRest	{'body': 'MOM: {PLAYER}!\\nYou should take a quick rest.$'}
text:PalletTown_PlayersHouse_1F_LookingGreatTakeCare	{'body': 'MOM: Oh, good! You and your\\nPOKéMON are looking great.\\lTake care now!$'}
text:PalletTown_PlayersHouse_1F_MovieOnTVFourBoysOnRailroad	{'body': "There's a movie on TV.\\nFour boys are walking on railroad\\ltracks.\\p…I better go, too.$"}
text:PalletTown_PlayersHouse_1F_MovieOnTVGirlOnBrickRoad	{'body': "There's a movie on TV.\\nA girl with her hair in pigtails is\\lwalking up a brick road.\\p…I better go, too.$"}
text:PalletTown_PlayersHouse_1F_OopsWrongSide	{'body': 'Oops, wrong side…$'}
text:PalletTown_PlayersHouse_2F_PlayedWithNES	{'body': "{PLAYER} played with the NES.\\p…Okay!\\nIt's time to go!$"}
text:PalletTown_PlayersHouse_2F_PressLRForHelp	{'body': "It's a posted notice…\\pIf you're confused, ask for HELP!\\nPress the L or R Button!$"}
text:PalletTown_ProfessorOaksLab_RivalGrampsIsntAround	{'body': "{RIVAL}: What, it's only {PLAYER}?\\nGramps isn't around.$"}
text:PalletTown_ProfessorOaksLab_RivalFedUpWithWaiting	{'body': "{RIVAL}: Gramps!\\nI'm fed up with waiting!$"}
text:PalletTown_ProfessorOaksLab_RivalNoFairWhatAboutMe	{'body': '{RIVAL}: Hey! Gramps! No fair!\\nWhat about me?$'}
text:PalletTown_ProfessorOaksLab_RivalGoChoosePlayer	{'body': "{RIVAL}: Heh, I don't need to be\\ngreedy like you. I'm mature!\\pGo ahead and choose, {PLAYER}!$"}
text:PalletTown_ProfessorOaksLab_RivalIllTakeThisOneThen	{'body': "{RIVAL}: I'll take this one, then!$"}
text:PalletTown_ProfessorOaksLab_RivalReceivedMonFromOak	{'body': '{RIVAL} received the {STR_VAR_1}\\nfrom PROF. OAK!$'}
text:PalletTown_ProfessorOaksLab_RivalMyMonLooksTougher	{'body': '{RIVAL}: My POKéMON looks a lot\\ntougher than yours.$'}
text:PalletTown_ProfessorOaksLab_RivalLetsCheckOutMons	{'body': "{RIVAL}: Wait, {PLAYER}!\\nLet's check out our POKéMON!\\pCome on, I'll take you on!$"}
text:PalletTown_ProfessorOaksLab_RivalDefeat	{'body': 'WHAT?\\nUnbelievable!\\lI picked the wrong POKéMON!$'}
text:RivalVictory	{'body': '{RIVAL}: Yeah!\\nAm I great or what?$'}
text:PalletTown_ProfessorOaksLab_RivalGoToughenMyMon	{'body': "{RIVAL}: Okay! I'll make my\\nPOKéMON battle to toughen it up!\\p{PLAYER}! Gramps!\\nSmell you later!$"}
text:PalletTown_ProfessorOaksLab_RivalGramps	{'body': '{RIVAL}: Gramps!$'}
text:PalletTown_ProfessorOaksLab_RivalWhatDidYouCallMeFor	{'body': '{RIVAL}: I almost forgot!\\nWhat did you call me for?$'}
text:PalletTown_ProfessorOaksLab_RivalLeaveItToMeGramps	{'body': '{RIVAL}: All right, Gramps!\\nLeave it all to me!$'}
text:PalletTown_ProfessorOaksLab_RivalTellSisNotToGiveYouMap	{'body': "{PLAYER}, I hate to say it, but you\\nwon't be necessary for this.\\pI know! I'll borrow a TOWN MAP\\nfrom my sis!\\pI'll tell her not to lend you one,\\n{PLAYER}! Hahaha!\\pDon't bother coming around to\\nmy place after this!$"}
text:PalletTown_ProfessorOaksLab_OakThreeMonsChooseOne	{'body': "OAK: {RIVAL}?\\nLet me think…\\pOh, that's right, I told you to\\ncome! Just wait!\\pHere, {PLAYER}.\\pThere are three POKéMON here.\\pHaha!\\pThe POKéMON are held inside\\nthese POKé BALLS.\\pWhen I was young, I was a serious\\nPOKéMON TRAINER.\\pBut now, in my old age, I have\\nonly these three left.\\pYou can have one.\\nGo on, choose!$"}
text:PalletTown_ProfessorOaksLab_OakBePatientRival	{'body': 'OAK: Be patient, {RIVAL}.\\nYou can have one, too!$'}
text:PalletTown_ProfessorOaksLab_OakWhichOneWillYouChoose	{'body': 'OAK: Now, {PLAYER}.\\pInside those three POKé BALLS are\\nPOKéMON.\\pWhich one will you choose for\\nyourself?$'}
text:PalletTown_ProfessorOaksLab_OakHeyDontGoAwayYet	{'body': "OAK: Hey!\\nDon't go away yet!$"}
text:PalletTown_ProfessorOaksLab_OakChoosingCharmander	{'body': "Ah! CHARMANDER is your choice.\\nYou should raise it patiently.\\pSo, {PLAYER}, you're claiming the\\nFIRE POKéMON CHARMANDER?$"}
text:PalletTown_ProfessorOaksLab_OakChoosingSquirtle	{'body': "Hm! SQUIRTLE is your choice.\\nIt's one worth raising.\\pSo, {PLAYER}, you've decided on the\\nWATER POKéMON SQUIRTLE?$"}
text:PalletTown_ProfessorOaksLab_OakChoosingBulbasaur	{'body': "I see! BULBASAUR is your choice.\\nIt's very easy to raise.\\pSo, {PLAYER}, you want to go with\\nthe GRASS POKéMON BULBASAUR?$"}
text:PalletTown_ProfessorOaksLab_OakThisMonIsEnergetic	{'body': 'This POKéMON is really quite\\nenergetic!$'}
text:PalletTown_ProfessorOaksLab_ReceivedMonFromOak	{'body': '{PLAYER} received the {STR_VAR_1}\\nfrom PROF. OAK!$'}
text:PalletTown_ProfessorOaksLab_OakCanReachNextTownWithMon	{'body': 'OAK: If a wild POKéMON appears,\\nyour POKéMON can battle it.\\pWith it at your side, you should be\\nable to reach the next town.$'}
text:PalletTown_ProfessorOaksLab_OakBattleMonForItToGrow	{'body': 'OAK: {PLAYER}, raise your young\\nPOKéMON by making it battle.\\pIt has to battle for it to grow.$'}
text:PalletTown_ProfessorOaksLab_OakHaveSomethingForMe	{'body': "OAK: Oh, {PLAYER}!\\nHow is my old POKéMON?\\pWell, it seems to be growing more\\nattached to you.\\pYou must be talented as a POKéMON\\nTRAINER.\\pWhat's that?\\nYou have something for me?$"}
text:PalletTown_ProfessorOaksLab_DeliveredOaksParcel	{'body': "{PLAYER} delivered OAK'S PARCEL.$"}
text:PalletTown_ProfessorOaksLab_OakCustomBallIOrdered	{'body': "Ah! \\nIt's the custom POKé BALL!\\pI had it on order.\\nThank you!$"}
text:PalletTown_ProfessorOaksLab_OakHaveRequestForYouTwo	{'body': 'OAK: Oh, right!\\nI have a request for you two.$'}
text:PalletTown_ProfessorOaksLab_OakPokedexOnDesk	{'body': "On the desk there is my invention,\\nthe POKéDEX!\\pIt automatically records data on\\nPOKéMON you've seen or caught.\\pIt's a high-tech encyclopedia!$"}
text:PalletTown_ProfessorOaksLab_OakTakeTheseWithYou	{'body': 'OAK: {PLAYER} and {RIVAL}.\\nTake these with you.$'}
text:PalletTown_ProfessorOaksLab_ReceivedPokedexFromOak	{'body': '{PLAYER} received the POKéDEX\\nfrom PROF. OAK.$'}
text:PalletTown_ProfessorOaksLab_OakCatchMonsForDataTakeThese	{'body': "OAK: You can't get detailed data\\non POKéMON by just seeing them.\\pYou must catch them to obtain\\ncomplete data.\\pSo, here are some tools for\\ncatching wild POKéMON.$"}
text:PalletTown_ProfessorOaksLab_ReceivedFivePokeBalls	{'body': '{PLAYER} received five POKé BALLS.$'}
text:PalletTown_ProfessorOaksLab_OakExplainCatching	{'body': "When a wild POKéMON appears,\\nit's fair game.\\pJust throw a POKé BALL at it and\\ntry to catch it!\\pThis won't always work, however.\\pA healthy POKéMON can escape.\\nYou have to be lucky!$"}
text:PalletTown_ProfessorOaksLab_OakCompleteMonGuideWasMyDream	{'body': "To make a complete guide on all\\nthe POKéMON in the world…\\pThat was my dream!\\pBut, I'm too old.\\nI can't get the job done.\\pSo, I want you two to fulfill my\\ndream for me.\\pGet moving, you two.\\pThis is a great undertaking in\\nPOKéMON history!$"}
text:PalletTown_ProfessorOaksLab_OakMonsAroundWorldWait	{'body': 'POKéMON around the world wait for\\nyou, {PLAYER}!$'}
text:PalletTown_ProfessorOaksLab_OakAddedNothingToPokedex	{'body': "Ah, {PLAYER}!\\nHow is your POKéDEX shaping up?\\p{RIVAL} has already caught some\\nPOKéMON and added to the data.\\pSo, {PLAYER}, let's have a look at\\nyour POKéDEX.\\p…What's the matter?\\nYou've added no new data at all.\\pI'll give you these, so do try a\\nlittle harder.$"}
text:PalletTown_ProfessorOaksLab_OakComeSeeMeSometime	{'body': 'OAK: Come see me sometime.\\pAfter all, I want to know how your\\nPOKéDEX is coming along.$'}
text:PalletTown_ProfessorOaksLab_BlankEncyclopedia	{'body': "It's like an encyclopedia, but the\\npages are blank.$"}
text:PalletTown_ProfessorOaksLab_ThoseArePokeBalls	{'body': 'Those are POKé BALLS.\\nThey contain POKéMON!$'}
text:PalletTown_ProfessorOaksLab_OaksLastMon	{'body': "That's PROF. OAK's last POKéMON.$"}
text:PalletTown_ProfessorOaksLab_PressStartToOpenMenu	{'body': 'Press START to open the MENU!$'}
text:PalletTown_ProfessorOaksLab_SaveOptionInMenu	{'body': 'The SAVE option is on the MENU.\\nUse it regularly.$'}
text:PalletTown_ProfessorOaksLab_AllMonTypesHaveStrongAndWeakPoints	{'body': 'All POKéMON types have strong and\\nweak points against others.$'}
text:PalletTown_ProfessorOaksLab_EmailMessage	{'body': "There's an e-mail message here.\\p…\\pFinally!\\nThe ultimate TRAINERS of the\\lPOKéMON LEAGUE are ready to\\ltake on all comers!\\pBring your best POKéMON and see\\nhow you rate as a TRAINER!\\pPOKéMON LEAGUE HQ\\nINDIGO PLATEAU\\pPROF. OAK, please visit us!\\n…$"}
text:PalletTown_ProfessorOaksLab_StudyAsOaksAide	{'body': "I study POKéMON as PROF. OAK's\\nAIDE.$"}
text:PalletTown_ProfessorOaksLab_DaisyWillGroomMons	{'body': "Hi, {PLAYER}. I bet you've become\\ngood friends with your POKéMON.\\pBy the way, did you know about\\nDAISY?\\pIf you show DAISY your POKéMON,\\nshe can tell how much it likes you.\\pOccasionally, she will even groom\\na POKéMON for you.\\pThis is a secret, so please don't\\ntell anyone.$"}
text:PalletTown_ProfessorOaksLab_OakIsGoingToHaveRadioShow	{'body': "PROF. OAK is going to have his own\\nradio show soon.\\pThe program will be called PROF.\\nOAK's POKéMON SEMINAR.$"}
text:PalletTown_ProfessorOaksLab_OakIsAuthorityOnMons	{'body': "PROF. OAK may not look like much,\\nbut he's the authority on POKéMON.\\pMany POKéMON TRAINERS hold him in\\nhigh regard.$"}
text:PalletTown_ProfessorOaksLab_OakFavorToAskYouPlayer	{'body': 'Ah, now this is excellent!\\p{PLAYER}, I have another important\\nfavor to ask of you.\\pI need you to listen closely.$'}
text:PalletTown_ProfessorOaksLab_OakSightingsOfRareMons	{'body': "Recently, there have been sightings\\nof many rare POKéMON species.\\pI'm talking about POKéMON that\\nhave never been seen in KANTO.\\pI would love to go see things for\\nmyself, but I'm much too old.\\pSince I can't do it, {PLAYER}, I'd\\nlike you to go in my place.$"}
text:PalletTown_ProfessorOaksLab_RivalJustLetMeHandleEverything	{'body': "{RIVAL}: Hey, I heard that!\\pGramps, what's with favoring\\n{PLAYER} over me all the time?\\pI went and collected more POKéMON,\\nand faster, too.\\pYou should just let me handle\\neverything.$"}
text:PalletTown_ProfessorOaksLab_OakNeedYourHelpTooNeedToSeePokedexes	{'body': 'OAK: I know, I know.\\nOf course I need your help, too.\\pNow, I need to see both your\\nPOKéDEXES.$'}
text:PalletTown_ProfessorOaksLab_OakTookBothPokedexUnits	{'body': 'PROF. OAK took both POKéDEX\\nunits.$'}
text:PalletTown_ProfessorOaksLab_OakNowTheseUnitsCanRecordMoreData	{'body': "… … …  … … …\\p… … …  … … …\\p…And that's done!\\pNow these units can record data on\\na lot more POKéMON.$"}
text:PalletTown_ProfessorOaksLab_PlayersPokedexWasUpgraded	{'body': "{PLAYER}'s POKéDEX was upgraded!$"}
text:PalletTown_ProfessorOaksLab_OakMustReallyWorkToFillPokedex	{'body': 'Now, {PLAYER} and {RIVAL}!\\pThis time, you really must work\\ntowards filling your POKéDEXES.\\pI urge you to make them the best\\nand the most complete of all time!\\pTruly, this is a monumentally great\\nundertaking in POKéMON history!$'}
text:PalletTown_ProfessorOaksLab_RivalIllCompleteThePokedex	{'body': "{RIVAL}: Gramps, calm down.\\nDon't get so excited.\\pI'll get the POKéDEX completed,\\ndon't you worry about a thing.\\pI think I'll try looking around\\nONE ISLAND first…\\pAnyways, I'm outta here!$"}
text:PalletTown_RivalsHouse_HiBrothersAtLab	{'body': "DAISY: Hi, {PLAYER}!\\pMy brother, {RIVAL}, is out at\\nGrandpa's LAB.$"}
text:PalletTown_RivalsHouse_HeardYouBattledRival	{'body': "DAISY: {PLAYER}, I heard you had\\na battle against {RIVAL}.\\pI wish I'd seen that!$"}
text:PalletTown_RivalsHouse_ErrandForGrandpaThisWillHelp	{'body': "Grandpa asked you to run an\\nerrand?\\pGee, that's lazy of him.\\nHere, this will help you.$"}
text:PalletTown_RivalsHouse_ReceivedTownMapFromDaisy	{'body': '{PLAYER} received a TOWN MAP\\nfrom DAISY.$'}
text:PalletTown_RivalsHouse_DontHaveSpaceForThis	{'body': "You don't have space for this in\\nyour BAG.$"}
text:PalletTown_RivalsHouse_ExplainTownMap	{'body': 'You can use the TOWN MAP to find\\nout where you are, or check the\\lnames of places.$'}
text:PalletTown_RivalsHouse_PleaseGiveMonsRest	{'body': 'DAISY: Just like people, POKéMON\\nare living things.\\pWhen they get tired, please give\\nthem a rest.$'}
text:PalletTown_RivalsHouse_ItsBigMapOfKanto	{'body': "It's a big map of the KANTO region.\\nNow this would be useful!$"}
text:PalletTown_RivalsHouse_ShelvesCrammedFullOfBooks	{'body': 'The shelves are crammed full of\\nbooks on POKéMON.$'}
text:PalletTown_RivalsHouse_LikeMeToGroomMon	{'body': "DAISY: Hi, {PLAYER}!\\nGood timing.\\pI'm about to have some tea.\\nWould you like to join me?\\pOh, but look.\\nYour POKéMON are a little dirty.\\pWould you like me to groom one?$"}
text:PalletTown_RivalsHouse_DontNeedAnyGrooming	{'body': "You don't need any grooming done?\\nOkay, we'll just have tea.$"}
text:PalletTown_RivalsHouse_GroomWhichOne	{'body': 'Which one should I groom?$'}
text:PalletTown_RivalsHouse_LookingNiceInNoTime	{'body': "DAISY: Okay, I'll get it looking\\nnice in no time.$"}
text:PalletTown_RivalsHouse_ThereYouGoAllDone	{'directives': ('#ifdef BUGFIX', '#else', '#endif'), 'body': "{COLOR DARK_GRAY}{STR_VAR_1} looks dreamily content…\\p{COLOR RED}DAISY: There you go! All done.\\n{FONT_NORMAL}{STR_VAR_1} looks dreamily content…\\p{FONT_FEMALE}DAISY: There you go! All done.\\nSee? Doesn't it look nice?\\pGiggle…\\nIt's such a cute POKéMON.$"}
text:PalletTown_RivalsHouse_CantGroomAnEgg	{'body': "Oh, sorry. I honestly can't\\ngroom an EGG.$"}
text:PalletTown_RivalsHouse_MayISeeFirstMon	{'body': 'DAISY: Your POKéMON grow to love\\nyou if you raise them with love.\\pFor example, {PLAYER}, may I see\\nyour first POKéMON?$'}
text:PalletTown_RivalsHouse_CouldntLoveYouMore	{'body': "It couldn't possibly love you\\nany more than it does now.\\pYour POKéMON is happy beyond\\nwords.$"}
text:PalletTown_RivalsHouse_ItLooksVeryHappy	{'body': 'It looks very happy.\\pI wish {RIVAL} could see this and\\nlearn something from it.$'}
text:PalletTown_RivalsHouse_ItsQuiteFriendly	{'body': "It's quite friendly with you.\\nKeep being good to it!$"}
text:PalletTown_RivalsHouse_ItsWarmingUpToYou	{'body': "It's warming up to you.\\nTrust must be growing between you.$"}
text:PalletTown_RivalsHouse_NotFamiliarWithYouYet	{'body': "It's not quite familiar with you\\nyet.\\pPOKéMON are all quite wary when\\nyou first get them.$"}
text:PalletTown_RivalsHouse_DontLikeWayItGlaresAtYou	{'body': "{PLAYER}, I don't like the way it\\nglares at you.\\pCould you try being a little nicer\\nto it?$"}
text:PalletTown_RivalsHouse_WhyWouldMonHateYouSoMuch	{'body': "…Um, it's not easy for me to say\\nthis, but…\\pIs there some reason why your\\nPOKéMON would hate you so much?$"}
text:PalletTown_RivalsHouse_LovelyAndSweetClefairy	{'body': '“The lovely and sweet\\nCLEFAIRY”$'}
text:PetalburgCity.WhereIsWally	{'body': 'Where has our WALLY gone?\\pWe have to leave for VERDANTURF TOWN\\nvery soon…$'}
text:PetalburgCity.AreYouRookieTrainer	{'body': 'Hiya! Are you maybe…\\nA rookie TRAINER?\\pDo you know what POKéMON TRAINERS\\ndo when they reach a new town?\\pThey first check what kind of GYM\\nis in the town.$'}
text:PetalburgCity.ThisIsPetalburgGym	{'body': "See? This is PETALBURG CITY's GYM.$"}
text:PetalburgCity.ThisIsGymSign	{'body': "This is the GYM's sign. Look for it\\nwhenever you're looking for a GYM.$"}
text:PetalburgCity.WaterReflection	{'body': 'My face is reflected in the water.\\pA hopeful grin one day...\\nA worried frown the next.\\pWhat do you see in your reflection?$'}
text:PetalburgCity.FullPartyExplanation	{'body': 'Already traveling with six POKéMON?\\nYou can still catch a new partner.\\pChoose whether to add it to your\\nparty and send someone to a BOX,\\lor send the new catch to storage.$'}
text:PetalburgCity.GymSign	{'body': 'PETALBURG CITY POKéMON GYM\\nLEADER: NORMAN\\l“A man in pursuit of power!”$'}
text:PetalburgCity.CitySign	{'body': 'PETALBURG CITY\\n“Where people mingle with nature.”$'}
text:PetalburgCity.WallyHouseSign	{'body': "WALLY'S HOUSE$"}
text:PetalburgCity.AreYouATrainer	{'body': "Excuse me! You travel with POKéMON,\\ndon't you?\\pI'm SCOTT. I scout for TRAINERS\\nwith a talent for battling.$"}
text:PetalburgCity.WellMaybeNot	{'body': 'No BADGES yet? Then your journey\\nis just getting started.\\pA strong team takes more than\\npower. I watch how partners work\\ltogether when a battle gets tough.$'}
text:PetalburgCity.ImLookingForTalentedTrainers	{'body': "Heading to RUSTBORO? ROXANNE\\nwill give you plenty to think about.\\pI'll be visiting the TRAINER'S\\nSCHOOL there. Tell me how it goes!$"}
text:PetalburgCity_Gym.GymGuideNotReady	{'body': "NORMAN takes challengers with\\nfour GYM BADGES.\\pHe's here at the entrance if\\nyou'd like to talk. Come back\\lfor these rooms when you're ready!$"}
text:PetalburgCity_Gym.DadYoureHereWithYourPokemon	{'body': "DAD: {PLAYER}! You made it!\\nHow was the trip from LITTLEROOT?\\pAnd these are your POKéMON...\\nSo your own journey has begun.\\pI'm proud of you. Take your time,\\nget to know your partners, and\\lfind your own way as a TRAINER.$"}
text:PetalburgCity_Gym.WallyIdLikeAPokemon	{'body': "Um… I…\\nI'd like to get a POKéMON, please…$"}
text:PetalburgCity_Gym.DadOhYoureWallyRight	{'body': "DAD: Hm? You're… Uh… Oh, right.\\nYou're WALLY, right?$"}
text:PetalburgCity_Gym.WallyIveNeverCaughtAPokemon	{'body': "WALLY: I'm going to stay with my\\nrelatives in VERDANTURF TOWN.\\pI thought a POKéMON could keep me\\ncompany... But I've never caught\\lone before. I don't know how.$"}
text:PetalburgCity_Gym.DadHmISee	{'body': 'DAD: Hm. I see.$'}
text:PetalburgCity_Gym.DadPlayerGoWithWally	{'body': 'DAD: {PLAYER}, you heard that,\\nright?\\pGo with WALLY and make sure that he\\nsafely catches a POKéMON.$'}
text:PetalburgCity_Gym.IllLoanYouMyZigzagoon	{'body': "WALLY, here, I'll loan you my POKéMON.\\pWALLY received a ZIGZAGOON!$"}
text:PetalburgCity_Gym.WallyThankYouAndDadGivesPokeBall	{'body': "WALLY: Oh, wow!\\nA POKéMON!\\pDAD: Hm. I'll give you a POKé BALL, too.\\nGo for it!\\pWALLY received a POKé BALL!$"}
text:PetalburgCity_Gym.WallyOhWowThankYou	{'body': 'WALLY: Oh, wow!\\nThank you!$'}
text:PetalburgCity_Gym.WouldYouReallyComeWithMe	{'body': '{PLAYER}… Would you really come\\nwith me?$'}
text:PetalburgCity_Gym.DadSoDidItWorkOut	{'body': 'DAD: So, did it work out?$'}
text:PetalburgCity_Gym.WallyThankYouBye	{'body': "WALLY: Thank you, yes, it did.\\nHere's your POKéMON back.\\p{PLAYER}, thank you for coming along\\nwith me.\\pYou two are why I was able to catch\\nmy POKéMON.\\pI promise I'll take really good\\ncare of it.\\pOh! My mom's waiting for me,\\nso I have to go!\\pBye, {PLAYER}!$"}
text:PetalburgCity_Gym.DadGoCollectBadges	{'body': "DAD: A team grows through\\npractice, {PLAYER}. Don't be\\lafraid to try a different plan.\\pIn a TRAINER battle, RUN asks\\nif you want to restart. Say YES\\lto begin that same battle again.\\pSay NO and you'll be asked if\\nyou want to quit instead.\\lQuitting counts as a loss.\\pSay NO again to keep battling.\\nRestarting a battle is separate\\lfrom reloading a saved game.\\pHead west to ROUTE 104, then\\nnorth through PETALBURG WOODS.\\lROXANNE's GYM is in RUSTBORO.\\pThe school there teaches team\\npreparation. Learn about EVs and\\lbattle controls before the GYM.\\pCollect four BADGES, and then\\nwe'll have our own battle.\\lI'm looking forward to it!$"}
text:PetalburgCity_Gym.NormanGoToRustboro	{'body': "DAD: Hm? Aren't you going to the\\nPOKéMON GYM in RUSTBORO CITY?\\pFollow ROUTE 104 west of town, then\\nhead north through PETALBURG WOODS.\\pThere's no challenge for me to\\nbattle a greenhorn TRAINER.\\p{PLAYER}, I want you to challenge me\\nwhen you become a lot stronger.\\pI'll battle you, {PLAYER}, when you\\ncan show me four GYM BADGES, okay?$"}
text:PetalburgCity_Gym.NormanGoToDewford	{'body': "DAD: I see… So, you've beaten\\nthe GYM LEADER in RUSTBORO CITY.\\pBut there are many more TRAINERS\\nwho are stronger than you, {PLAYER}.\\pAcross the sea in DEWFORD TOWN is a\\nGYM LEADER named BRAWLY.\\pYou should go challenge him.$"}
text:PetalburgCity_Gym.YouHaveGottenStronger	{'body': "DAD: Hm… {PLAYER}, you have gotten\\nstronger.\\pI can tell by the number of BADGES\\nthat you've earned.$"}
text:PetalburgCity_Gym.NextGymMauville	{'body': "WATTSON runs MAUVILLE GYM. From\\nSLATEPORT, follow ROUTE 110 north.\\pKeep going. Bring back four BADGES,\\nand we'll see how far you've come.$"}
text:PetalburgCity_Gym.NextGymLavaridge	{'body': "FLANNERY runs LAVARIDGE GYM, below\\nMT. CHIMNEY. Travel north of MAUVILLE.\\pThe cable car is on ROUTE 112. From\\nthe summit, JAGGED PASS leads down.\\pEarn that fourth BADGE, then come home.\\nI'll be waiting here at the GYM.$"}
text:PetalburgCity_Gym.NormanIntro	{'body': "DAD: Four BADGES already… I still\\nremember you setting out from\\lLITTLEROOT.\\pI'm proud of you, {PLAYER}. But\\nhere in the GYM, I have to give\\levery challenger my best.\\pShow me how far you and your\\nPOKéMON have come!$"}
text:PetalburgCity_Gym.NormanDefeat	{'body': "You beat the team I've raised\\nwith so much care.\\pI'm proud of you.\\nTake the BALANCE BADGE.$"}
text:PetalburgCity_Gym.ReceivedBalanceBadge	{'body': '{PLAYER} received the BALANCE BADGE\\nfrom DAD!$'}
text:PetalburgCity_Gym.ExplainBalanceBadgeTakeThis	{'body': "DAD: The BALANCE BADGE lets your\\nLEVELER train a party up to Lv. 55.\\pIt also lets POKéMON use SURF to\\ntravel over water.\\pThis is my gift to you. {PLAYER}, I'm\\nsure you can use it correctly.$"}
text:PetalburgCity_Gym.ExplainLopunnite	{'body': 'Dad: Lopunnite lets Lopunny Mega\\nEvolve. Let it hold the stone in\\lbattle.$'}
text:PetalburgCity_Gym.DadHappyAndSad	{'body': "DAD: As a LEADER, I learned from you.\\nAs your father, I'm simply proud.$"}
text:PetalburgCity_Gym.PleaseComeWithMe	{'body': 'Ah, there you are, {PLAYER}{KUN}!\\pPlease come with me.\\nI have something I want you to have.$'}
text:PetalburgCity_Gym.LetMeBorrowPlayer	{'body': "NORMAN, you don't mind, do you?\\pLet me borrow your {PLAYER}{KUN} for\\na minute or two.$"}
text:PetalburgCity_Gym.DadGoingToKeepTraining	{'body': "DAD: {PLAYER}, you should go visit\\nyour mother every so often.\\pI'm going to stay here and redouble\\nmy training.\\pIt would bother me as a TRAINER to\\nnot avenge my loss to you, {PLAYER}!$"}
text:PetalburgCity_Gym.DadNoAmountOfTrainingIsEnough	{'body': 'DAD: {PLAYER}, how are things going?\\pThe world of POKéMON is deep.\\pI honestly think that no amount of\\ntraining would ever be enough.$'}
text:PetalburgCity_Gym.GymGuideAdvice	{'body': "Welcome, CHAMPION-bound {PLAYER}!\\pDefeat the Trainers in a room to\\nopen its onward doors.\\pThe left door leads to the\\nMULTIHIT ROOM. The right leads to\\lthe RETALIATION ROOM.\\pEach room's sign names its plan.\\nChoose your route and prepare your\\lpartners together.$"}
text:PetalburgCity_Gym.GymGuidePostVictory	{'body': "{PLAYER}! Whoa! You've overcome even\\nyour own father!\\pLike, whoa!\\nWhat a stunning turn of events!$"}
text:PetalburgCity_Gym.RandallIntro	{'body': 'This is the MULTIHIT ROOM.\\pOne attack can strike again and\\nagain. A FOCUS SASH may not be\\lenough!$'}
text:PetalburgCity_Gym.RandallDefeat	{'body': 'That was a magnificent battle!$'}
text:PetalburgCity_Gym.RandallPostBattle	{'body': 'Another challenge waits ahead.\\pThe left door leads to the TRICK\\nROOM; the right leads to the\\lSTATUS ROOM.$'}
text:PetalburgCity_Gym.RandallPostBadge	{'body': "Whomever you beat, and whomever you\\nmay lose to, you never shirk from\\ltraining yourself and your POKéMON.\\pThat's what I think being a\\nGYM LEADER is all about.$"}
text:PetalburgCity_Gym.ParkerIntro	{'body': 'Welcome to the TRICK ROOM.\\pLICKILICKY shakes the ground.\\nORANGURU tells it to do it again.\\pTELEPATHY keeps my partner safe.\\nWhat will keep yours safe?$'}
text:PetalburgCity_Gym.ParkerDefeat	{'body': 'Our timing was not enough. Good\\nbattle!$'}
text:PetalburgCity_Gym.ParkerPostBattle	{'body': 'WIDE GUARD can stop both EARTHQUAKES.\\nBut we have single-target moves, too.\\pThe POWER ROOM is next. Be ready!$'}
text:PetalburgCity_Gym.ParkerPostBadge	{'body': 'After you beat our LEADER, the\\ntraining has become a lot tougher.$'}
text:PetalburgCity_Gym.GeorgeIntro	{'body': 'This is the ENDURANCE ROOM.\\pHealing buys time. DUBWOOL can\\nturn that time into BODY PRESS\\lpower.\\pCan your team finish the job?$'}
text:PetalburgCity_Gym.GeorgeDefeat	{'body': 'We could not outlast your team!$'}
text:PetalburgCity_Gym.GeorgePostBattle	{'body': 'That was well played.\\pThe next door leads to the BURST\\nROOM. Be ready for its\\lconcentrated pressure.$'}
text:PetalburgCity_Gym.GeorgePostBadge	{'body': "I'm going to keep training at GYMS.\\nOne day, I'll become a LEADER.$"}
text:PetalburgCity_Gym.BerkeIntro	{'body': "This is the BURST ROOM.\\pEXPLOUD's voice can hit Ghosts.\\nMEGA GLALIE turns Normal attacks\\linto Ice.\\pPrepare for both sides of the\\nboard!$"}
text:PetalburgCity_Gym.BerkeDefeat	{'body': 'Your team took the battle!$'}
text:PetalburgCity_Gym.BerkePostBattle	{'body': 'A strong pair can attack through\\ndifferent defenses.\\pThe last reserves still matter:\\nSTOUTLAND and KANGASKHAN keep the\\lpressure on.$'}
text:PetalburgCity_Gym.BerkePostBadge	{'body': 'Since your dad became the LEADER,\\nthe TRAINERS of PETALBURG CITY have\\lbecome a lot tougher.$'}
text:PetalburgCity_Gym.MaryIntro	{'body': "This is the RETALIATION ROOM.\\pDRAMPA can gain power after a\\nhard hit. RUFFLET's HUSTLE trades\\laccuracy for strength.\\pEvery risk needs a purpose!$"}
text:PetalburgCity_Gym.MaryDefeat	{'body': 'You were a cut above me…$'}
text:PetalburgCity_Gym.MaryPostBattle	{'body': 'More formidable teams await.\\pThe left door leads to the STATUS\\nROOM; the right leads to the\\lENDURANCE ROOM.$'}
text:PetalburgCity_Gym.MaryPostBadge	{'body': "Do you know what we're trying to\\nachieve as TRAINERS?\\pWe're striving to become soul mates\\nwith our POKéMON.$"}
text:PetalburgCity_Gym.AlexiaIntro	{'body': 'This is the STATUS ROOM.\\pZANGOOSE and URSARING make their\\nown status a weapon.\\pBring a plan for the whole team!$'}
text:PetalburgCity_Gym.AlexiaDefeat	{'body': "Our defenses weren't enough…$"}
text:PetalburgCity_Gym.AlexiaPostBattle	{'body': "You've given me something to think\\nabout.\\pThe left door leads to the POWER\\nROOM; the right leads to the BURST\\lROOM.$"}
text:PetalburgCity_Gym.AlexiaPostBadge	{'body': 'Hi! Have you tried using SURF?$'}
text:PetalburgCity_Gym.JodyIntro	{'body': 'This is the POWER ROOM.\\pOur LEADER told us to give you\\neverything we have, even if you\\lare his kid.\\pThat is exactly what we will do!$'}
text:PetalburgCity_Gym.JodyDefeat	{'body': 'But… I went all out!$'}
text:PetalburgCity_Gym.JodyPostBattle	{'body': "The way you use your POKéMON…\\nIt's like your father's style.\\pGo on through! The GYM LEADER, your\\nfather, is waiting!$"}
text:PetalburgCity_Gym.JodyPostBadge	{'body': "Sure, it's fine to make your POKéMON\\nstronger.\\pBut what decides the winner?\\pWhy, it's the feelings TRAINERS have\\nfor their POKéMON.$"}
text:PetalburgCity_Gym.DoorAppearsLocked	{'body': 'This door appears to be locked\\nright now…$'}
text:PetalburgCity_Gym.EnterSpeedRoom	{'body': '“MULTIHIT ROOM”, the sign says.\\pDo you want to go through?$'}
text:PetalburgCity_Gym.DoorAppearsLocked2	{'body': 'This door appears to be locked\\nright now…$'}
text:PetalburgCity_Gym.EnterAccuracyRoom	{'body': '“RETALIATION ROOM”, the sign says.\\pDo you want to go through?$'}
text:PetalburgCity_Gym.EnterConfusionRoom	{'body': '“TRICK ROOM”, the sign says.\\pDo you want to go through?$'}
text:PetalburgCity_Gym.EnterDefenseRoom	{'body': '“STATUS ROOM”, the sign says.\\pDo you want to go through?$'}
text:PetalburgCity_Gym.EnterRecoveryRoom	{'body': '“ENDURANCE ROOM”, the sign says.\\pDo you want to go through?$'}
text:PetalburgCity_Gym.EnterStrengthRoom	{'body': '“POWER ROOM”, the sign says.\\pDo you want to go through?$'}
text:PetalburgCity_Gym.EnterOHKORoom	{'body': '“BURST ROOM”, the sign says.\\pDo you want to go through?$'}
text:PetalburgCity_Gym.EnterGymLeadersRoom	{'body': "“GYM LEADER'S ROOM\\p“See for yourself what POKéMON await\\nyou!” the sign says.\\pDo you want to go through?$"}
text:PetalburgCity_Gym.GymStatue	{'body': 'PETALBURG CITY POKéMON GYM$'}
text:PetalburgCity_Gym.GymStatueCertified	{'body': "PETALBURG CITY POKéMON GYM\\pNORMAN'S CERTIFIED TRAINERS:\\n{PLAYER}$"}
text:PetalburgCity_House1.TravelingIsWonderful	{'body': 'Traveling is wonderful!\\pWhen I was young, I roamed the seas\\nand the mountains!$'}
text:PetalburgCity_House1.GoOnAdventure	{'body': 'Sigh…\\pI wish I could go on an adventure\\nwith some POKéMON…\\pCrawl through some damp grass…\\nClimb rocky, rugged mountains…\\pCross the raging seas…\\nWander about in dark caves…\\pAnd, sometimes, even get a little\\nhomesick…\\pIt must be fabulous to travel!$'}
text:PetalburgCity_House2.NormanBecameGymLeader	{'body': "NORMAN became our town's new\\nGYM LEADER.\\pI think he called his family over from\\nsomewhere far away.$"}
text:PetalburgCity_House2.BattledNormanOnce	{'body': 'I battled NORMAN once, but, whew,\\nhe was way too strong.\\pHow would I put it?\\pI just got the feeling that he\\nlives for POKéMON.$'}
text:PetalburgCity_Mart.WeakWillGrowStronger	{'body': 'Even if a POKéMON is weak now,\\nit will grow stronger.\\pThe most important thing is love!\\nLove for your POKéMON!$'}
text:PetalburgCity_Mart.RepelIsUseful	{'body': "Do you use REPEL?\\nIt keeps POKéMON away, so it's\\luseful when you're in a hurry.$"}
text:PetalburgCity_Mart.TakeSomeAntidotesWithYou	{'body': 'Do you carry ANTIDOTES?\\pPoison no longer drains HP while\\nwalking, but it still matters in battle.\\pAn ANTIDOTE clears it before your\\nnext fight.$'}
text:PetalburgCity_PokemonCenter_1F.PCStorageSystem	{'body': 'That PC-based POKéMON Storage\\nSystem…\\pWhoever made it must be some kind\\nof a scientific wizard!$'}
text:PetalburgCity_PokemonCenter_1F.OranBerryRegainedHP	{'body': 'When my POKéMON ate an\\nORAN BERRY, it regained HP!$'}
text:PetalburgCity_PokemonCenter_1F.ManyTypesOfPokemon	{'body': 'There are many types of POKéMON.\\pAll types have their strengths and\\nweaknesses against other types.\\pDepending on the types of POKéMON,\\na battle could be easy or hard.$'}
text:PetalburgCity_PokemonCenter_1F.TreeckoIsGrassType	{'body': 'For {STR_VAR_1}, remember:\\pGRASS attacks are strong against\\nWATER, GROUND, and ROCK types.\\pA second type can change how much\\ndamage an attack does.$'}
text:PetalburgCity_PokemonCenter_1F.TorchicIsFireType	{'body': 'For {STR_VAR_1}, remember:\\pFIRE attacks are strong against\\nGRASS, BUG, ICE, and STEEL types.\\pA second type can change how much\\ndamage an attack does.$'}
text:PetalburgCity_PokemonCenter_1F.MudkipIsWaterType	{'body': 'For {STR_VAR_1}, remember:\\pWATER attacks are strong against\\nFIRE, GROUND, and ROCK types.\\pA second type can change how much\\ndamage an attack does.$'}
text:PetalburgCity_WallysHouse.ThanksForPlayingWithWally	{'body': "You must be {PLAYER}{KUN}!\\nThank you for helping WALLY catch\\lhis first POKéMON.\\pHe's often been too ill to go out.\\nSeeing him so excited means a lot.\\pHe's left to stay with relatives\\nin VERDANTURF TOWN. We hope the\\lclean air will do him good.$"}
text:PetalburgCity_WallysHouse.WonderHowWallyIsDoing	{'body': 'I wonder how our WALLY is doing?$'}
text:PetalburgCity_WallysHouse.PleaseExcuseUs	{'body': "{PLAYER}{KUN}! Please excuse us for\\ndragging you here this way.\\pBut our WALLY's become very healthy\\nsince he went to VERDANTURF TOWN.\\pWe owe it all to you!\\pWhen WALLY left town, you helped\\nhim catch a POKéMON, right?\\pI think that made WALLY really\\nhappy.\\pActually, not just WALLY.\\nIt made me, his father, happy too.\\pHappy that he's gained such a great\\nfriend as you.\\pThis isn't a bribe or anything, but\\nI'd really like you to have this.$"}
text:PetalburgCity_WallysHouse.SurfGoAllSortsOfPlaces	{'body': "A partner that can learn SURF can\\ncarry you across water.\\pIt need not learn the move first.\\nKeep it in your party and face\\lthe water.\\pHead to MAUVILLE.\\pGo east onto ROUTE 118 and cross its\\nriver, then take ROUTE 119 north.\\pBeyond the WEATHER INSTITUTE lies\\nFORTREE CITY and WINONA's GYM.$"}
text:PetalburgCity_WallysHouse.WallyIsComingHomeSoon	{'body': "WALLY's coming home soon.\\nI'm looking forward to that.$"}
text:PetalburgCity_WallysHouse.YouMetWallyInEverGrandeCity	{'body': "Oh? You met WALLY in\\nEVER GRANDE CITY?\\pOh, {PLAYER}{KUN}, don't be silly.\\pHe may have gotten healthy, but he\\ncan't go somewhere far away like\\lthat all by himself.$"}
text:PetalburgCity_WallysHouse.WallyWasReallyHappy	{'body': "WALLY was really happy when he told\\nus that he caught a POKéMON.\\pIt's been ages since I've seen him\\nsmile like that.$"}
text:PetalburgCity_WallysHouse.WallyLeftWithoutTelling	{'body': "I want you to keep this a secret\\nfrom my husband…\\pBut our WALLY left VERDANTURF TOWN\\nwithout telling anyone.\\pYou know, WALLY is frail, but\\nhe's surprisingly strong-willed.\\pI'm sure that he'll come back safe\\nand sound one day!$"}
text:PetalburgCity_WallysHouse.BeforeWallyCatch	{'body': 'Our WALLY is going to stay with\\nrelatives in VERDANTURF TOWN.\\pHe hopes to take a POKéMON along.\\nHe went to ask NORMAN for help.$'}
text:PetalburgWoods.NotAOneToBeFound	{'body': 'Hmmm…\\nNot a one to be found…$'}
text:PetalburgWoods.HaveYouSeenShroomish	{'body': "Oh, hello! Seen any SHROOMISH?\\nI've always loved them.\\pI'm taking research papers back\\nto DEVON in RUSTBORO. I thought\\lI could spare a little time...$"}
text:PetalburgWoods.IWasGoingToAmbushYou	{'body': "I was going to ambush you, but you\\nhad to dawdle in PETALBURG WOODS\\lforever, didn't you?\\pI got sick of waiting, so here I am!$"}
text:PetalburgWoods.HandOverThosePapers	{'body': 'You! DEVON RESEARCHER!\\pHand over those papers!$'}
text:PetalburgWoods.YouHaveToHelpMe	{'body': "Please, help me!\\pThese papers belong to DEVON. I can't\\nlet him take them!$"}
text:PetalburgWoods.NoOneCrossesTeamAqua	{'body': "Hunh? What do you think you're doing?\\nWhat, you're going to protect him?\\pNo one who crosses TEAM AQUA\\ngets any mercy, not even a kid!\\pCome on and battle me!$"}
text:PetalburgWoods.YoureKiddingMe	{'body': "You're kidding me! You're tough!$"}
text:PetalburgWoods.YouveGotSomeNerve	{'body': "Grrr… You've got some nerve\\nmeddling with TEAM AQUA!\\lCome on and battle me again!\\pI wish I could say that, but I'm out of\\nPOKéMON…\\pAnd, hey, we of TEAM AQUA are also\\nafter something in RUSTBORO.\\pI'll let you go today!$"}
text:PetalburgWoods.ThatWasAwfullyClose	{'body': 'Whew... Thank you for helping me!\\pThese papers track the strange\\nweather and LEGENDARY sightings.\\lDEVON is studying the connection.\\pOur field notes help keep the\\nroute signs up to date. Some\\ldiscoveries need more than luck.\\pA sign lists any special\\nrequirements. Once you catch a\\llocal legend, it marks it Caught.\\pThat POKéMON stops appearing, so\\nyou can search for your next find.\\pI must get these reports to DEVON.\\nFirst, take this GREAT BALL\\las my thanks!$'}
text:PetalburgWoods.TeamAquaAfterSomethingInRustboro	{'body': "He said TEAM AQUA was after something\\nin RUSTBORO, too, didn't he?\\pMy colleagues could be in trouble.$"}
text:PetalburgWoods.ICantBeWastingTime	{'body': 'I need to warn everyone at DEVON.\\nNo more looking for SHROOMISH today!$'}
text:PetalburgWoods.YoureLoadedWithItems	{'body': "You're loaded with items.\\nI can't give you this GREAT BALL.$"}
text:PetalburgWoods.GoBugPokemonTeam	{'body': 'I caught a whole bunch of POKéMON!\\pGo, go, go!\\nMy BUG POKéMON team!$'}
text:PetalburgWoods.ICouldntWin	{'body': "I have all these POKéMON,\\nbut I couldn't win…$"}
text:PetalburgWoods.ImOutOfPokeBalls	{'body': "I caught a bunch of POKéMON.\\nNow I'm out of POKé BALLS.$"}
text:PetalburgWoods.InstantlyPopularWithBugPokemon	{'body': 'If you take BUG POKéMON to school,\\nyou get to be instantly popular!$'}
text:PetalburgWoods.CantBePopularIfILose	{'body': "I can't be popular if I lose.$"}
text:PetalburgWoods.PeopleRespectYou	{'body': 'If you have a big BUG POKéMON,\\npeople respect you for it.$'}
text:PetalburgWoods.IWantRematch1	{'body': "I want to tell you when my BUG\\nPOKéMON grow up!\\pI'm registering you in my POKéNAV!$"}
text:PetalburgWoods.IWantRematch2	{'body': "I want to tell you when my BUG\\nPOKéMON grow up!\\pI'm registering you in my POKéNAV!$"}
text:PetalburgWoods.MyPokemonHaveGrown	{'body': "My BUG POKéMON have grown.\\nI'll be popular again.$"}
text:PetalburgWoods.CantBePopularIfLose	{'body': "I can't be popular if I lose.$"}
text:PetalburgWoods.IveBeenTrainingHard	{'body': "You get to be popular if you have\\nstrong POKéMON, right?\\lSo, I've been training hard.$"}
text:PetalburgWoods.StayOutOfTallGrass	{'body': 'Yo, there!\\nYour POKéMON doing okay?\\pIf your POKéMON are weak and you want\\nto avoid battles, you should stay out\\lof tall grass.$'}
text:PetalburgWoods.HiddenItemsExplanation	{'body': 'BURMY hide among these leaves. Females\\nbecome WORMADAM at Lv. 20; males\\lbecome MOTHIM at the same level.\\pAfter a battle, BURMY makes a cloak\\nfrom its surroundings: leaves in grass,\\lsand in caves, or trash in buildings.\\pRaise DARTRIX to Lv. 34 or higher here\\nto get Hisuian DECIDUEYE. Elsewhere,\\lit grows into the usual form.$'}
text:PetalburgWoods.TryUsingThisItem	{'body': "Oh, neat!\\nThat's the BADGE from RUSTBORO GYM!\\pYou must be a TRAINER.\\nYou should try using this item.$"}
text:PetalburgWoods.TartAppleExplanation	{'body': "It's a TART APPLE. Use it on\\nAPPLIN to evolve it into FLAPPLE.\\pFunny how the same POKéMON can\\ngrow differently depending on its\\lfavorite treat!$"}
text:PetalburgWoods.TrainerTipsExperience	{'body': 'TRAINER TIPS\\pUse the LEVELER to bring partners\\nto your current training limit.\\pThen prepare their moves, Ability,\\nNature, and held item for battle.$'}
text:PetalburgWoods.TrainerTipsPP	{'body': 'FOREST FIELD NOTES\\pCUT opens paths into the deeper\\nforest. CELEBI lives in the\\lthird area.\\pVIRIZION and WO-CHIEN live in\\nthe second area. Each of these\\llegendaries has a 3% wild\\lencounter chance in its habitat.$'}
text:PetalburgWoods_3.Ranger	{'body': "CELEBI has been slipping between\\nthe trees. You can find it in\\lthis grove's grass, with a 3%\\lencounter chance.$"}
text:DreamEaterTeach	{'body': 'Yawn!\\nI must have dozed off in the sun.\\pI had this weird dream about\\na DROWZEE eating my dream.\\pAnd…\\nI learned how to eat dreams…\\pOogh, this is too spooky!\\pLet me teach it to a POKéMON so\\nI can forget about it!$'}
text:DreamEaterDeclined	{'body': '…Snore…$'}
text:DreamEaterWhichMon	{'body': 'Which POKéMON wants to learn\\nDREAM EATER?$'}
text:DreamEaterTaught	{'body': "…ZZZ…\\nI…can't eat…anymore…$"}
text:PewterCity_ClefairyCameFromMoon	{'body': "CLEFAIRY came from the moon.\\nThat's what the rumor is.\\pThey appeared after MOON STONES\\nfell on MT. MOON.$"}
text:PewterCity_BrockOnlySeriousTrainerHere	{'body': "There aren't many serious POKéMON\\nTRAINERS here.\\pThey're all like BUG CATCHERS,\\nyou know, just hobbyists.\\pBut PEWTER GYM's BROCK isn't like\\nthat, not one bit.$"}
text:PewterCity_DidYouCheckOutMuseum	{'body': 'Did you check out the MUSEUM?$'}
text:PewterCity_WerentThoseFossilsAmazing	{'body': "Weren't those fossils from MT. MOON\\namazing?$"}
text:PewterCity_ReallyYouHaveToGo	{'body': 'Really?\\nYou absolutely have to go!$'}
text:PewterCity_ThisIsTheMuseum	{'body': "This is it, the MUSEUM.\\pYou have to pay to get in, but it's\\nworth it. See you around!$"}
text:PewterCity_DoYouKnowWhatImDoing	{'body': "Psssst!\\nDo you know what I'm doing?$"}
text:PewterCity_ThatsRightItsHardWork	{'body': "That's right!\\nIt's hard work!$"}
text:PewterCity_SprayingRepelToKeepWildMonsOut	{'body': "I'm spraying REPEL to keep wild\\nPOKéMON out of my garden!$"}
text:PewterCity_BrocksLookingForChallengersFollowMe	{'body': "You're a TRAINER, right?\\pBROCK's looking for new\\nchallengers. Follow me!$"}
text:PewterCity_GoTakeOnBrock	{'body': 'If you have the right stuff,\\ngo take on BROCK!$'}
text:PewterCity_TrainerTipsEarningEXP	{'body': 'TRAINER TIPS\\pAll POKéMON that appear in battle,\\nhowever briefly, earn EXP Points.$'}
text:PewterCity_CallPoliceIfInfoOnThieves	{'body': 'NOTICE!\\pThieves have been stealing POKéMON\\nfossils from MT. MOON.\\pPlease call the PEWTER POLICE if\\nyou have any information.$'}
text:PewterCity_MuseumOfScience	{'body': 'PEWTER MUSEUM OF SCIENCE$'}
text:PewterCity_GymSign	{'body': 'PEWTER CITY POKéMON GYM\\nLEADER: BROCK\\lThe Rock-Solid POKéMON TRAINER!$'}
text:PewterCity_CitySign	{'body': 'PEWTER CITY\\nA Stone Gray City$'}
text:PewterCity_OhPlayer	{'body': 'Oh, {PLAYER}{KUN}!$'}
text:PewterCity_AskedToDeliverThis	{'body': "I'm glad I caught up to you.\\nI'm PROF. OAK's AIDE.\\pI've been asked to deliver this,\\nso here you go.$"}
text:PewterCity_ReceivedRunningShoesFromAide	{'body': '{PLAYER} received the\\nRUNNING SHOES from the AIDE.$'}
text:PewterCity_SwitchedShoesWithRunningShoes	{'body': '{PLAYER} switched shoes with the\\nRUNNING SHOES.$'}
text:PewterCity_ExplainRunningShoes	{'body': "Press the B Button to run.\\nBut only where there's room to run!$"}
text:PewterCity_MustBeGoingBackToLab	{'body': 'Well, I must be going back to\\nthe LAB.\\pBye-bye!$'}
text:PewterCity_RunningShoesLetterFromMom	{'body': "There's a letter attached…\\pDear {PLAYER},\\pHere is a pair of RUNNING SHOES\\nfor my beloved challenger.\\pRemember, I'll always cheer for\\nyou! Don't ever give up!\\pFrom Mom$"}
text:PewterCity_Gym_BrockIntro	{'body': "So, you're here. I'm BROCK.\\nI'm PEWTER's GYM LEADER.\\pMy rock-hard willpower is evident\\neven in my POKéMON.\\pMy POKéMON are all rock hard, and\\nhave true-grit determination.\\pThat's right - my POKéMON are all\\nthe ROCK type!\\pFuhaha! You're going to challenge\\nme knowing that you'll lose?\\pThat's the TRAINER's honor that\\ncompels you to challenge me.\\pFine, then!\\nShow me your best!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:PewterCity_Gym_BrockDefeat	{'body': 'I took you for granted, and so\\nI lost.\\pAs proof of your victory, I confer\\non you this…the official POKéMON\\lLEAGUE BOULDERBADGE.\\p{FONT_NORMAL}{PLAYER} received the BOULDERBADGE\\nfrom BROCK!{PAUSE_MUSIC}{PLAY_BGM}{MUS_OBTAIN_BADGE}{PAUSE 0xFE}{PAUSE 0x56}{RESUME_MUSIC}\\p{FONT_MALE}Just having the BOULDERBADGE makes\\nyour POKéMON more powerful.\\pIt also enables the use of the\\nmove FLASH outside of battle.\\pOf course, a POKéMON must know the\\nmove FLASH to use it.$'}
text:PewterCity_Gym_TakeThisWithYou	{'body': 'Wait!\\nTake this with you.$'}
text:PewterCity_Gym_ReceivedTM39FromBrock	{'body': '{PLAYER} received TM39\\nfrom BROCK.$'}
text:PewterCity_Gym_ExplainTM39	{'body': 'A TM, Technical Machine, contains a\\ntechnique for POKéMON.\\pUsing a TM teaches the move it\\ncontains to a POKéMON.\\pA TM is good for only one use.\\pSo, when you use one, pick the\\nPOKéMON carefully.\\pAnyways…\\nTM39 contains ROCK TOMB.\\pIt hurls boulders at the foe and\\nlowers its SPEED.$'}
text:PewterCity_Gym_BrockPostBattle	{'body': 'There are all kinds of TRAINERS in\\nthis huge world of ours.\\pYou appear to be very gifted as a\\nPOKéMON TRAINER.\\pSo let me make a suggestion.\\pGo to the GYM in CERULEAN and test\\nyour abilities.$'}
text:PewterCity_Gym_DontHaveRoomForThis	{'body': "You don't have room for this.$"}
text:PewterCity_Gym_LiamIntro	{'body': "Stop right there, kid!\\pYou're ten thousand light-years \\nfrom facing BROCK!$"}
text:PewterCity_Gym_LiamDefeat	{'body': "Darn!\\pLight-years isn't time…\\nIt measures distance!$"}
text:PewterCity_Gym_LiamPostBattle	{'body': "You're pretty hot.\\n…But not as hot as BROCK!$"}
text:PewterCity_Gym_LetMeTakeYouToTheTop	{'body': "Hiya!\\nDo you want to dream big?\\pDo you dare to dream of becoming\\nthe POKéMON champ?\\pI'm no TRAINER, but I can advise\\nyou on how to win.\\pLet me take you to the top!$"}
text:PewterCity_Gym_LetsGetHappening	{'body': "All right!\\nLet's get happening!$"}
text:PewterCity_Gym_TryDifferentPartyOrders	{'body': "The first POKéMON out in a match is\\nat the left of the POKéMON LIST.\\pBy changing the order of POKéMON,\\nyou may gain an advantage.\\pTry different orders to suit your\\nopponent's party.$"}
text:PewterCity_Gym_ItsFreeLetsGetHappening	{'body': "It's a free service!\\nLet's get happening!$"}
text:PewterCity_Gym_YoureChampMaterial	{'body': "Just as I thought!\\nYou're POKéMON champ material!$"}
text:PewterCity_Gym_GymStatue	{'body': 'PEWTER POKéMON GYM\\nLEADER: BROCK\\pWINNING TRAINERS:\\n{RIVAL}$'}
text:PewterCity_Gym_GymStatuePlayerWon	{'body': 'PEWTER POKéMON GYM\\nLEADER: BROCK\\pWINNING TRAINERS:\\n{RIVAL}, {PLAYER}$'}
text:PewterCity_House1_Nidoran	{'body': 'NIDORAN♂: Bowbow!$'}
text:PewterCity_House1_NidoranSit	{'body': 'NIDORAN, sit!$'}
text:PewterCity_House1_TradeMonsAreFinicky	{'body': "Our POKéMON's an outsider, so it's\\nfinicky and hard to handle.\\pAn outsider is a POKéMON that you\\nget in a trade.\\pIt grows fast, but it may ignore an\\nunskilled TRAINER in battle.\\pIf only we had some BADGES…$"}
text:PewterCity_House2_MonsLearnTechniquesAsTheyGrow	{'body': 'POKéMON learn new techniques as\\nthey grow.\\pBut some moves must be taught to\\nthem by people.$'}
text:PewterCity_House2_MonsEasierCatchIfStatused	{'body': 'A POKéMON becomes easier to \\ncatch if it has a status problem.\\pSleep, poison, burn, or paralysis…\\nThose are all effective.\\pBut catching POKéMON is never\\na sure thing!$'}
text:PewterCity_Mart_BoughtWeirdFishFromShadyGuy	{'body': "A shady old guy sucked me into\\nbuying this weird fish POKéMON!\\pIt's totally weak and it cost ¥500!$"}
text:PewterCity_Mart_GoodThingsIfRaiseMonsDiligently	{'body': "Good things can happen if you raise\\nPOKéMON diligently.\\pEven the weak ones can surprise\\nyou if you don't give up on them.$"}
text:PewterCity_Museum_1F_Its50YForChildsTicket	{'body': "Yes, yes.\\nIt's ¥50 for a child's ticket.\\pWould you like to come in?$"}
text:PewterCity_Museum_1F_ComeAgain	{'body': 'Come again!$'}
text:PewterCity_Museum_1F_Right50YThankYou	{'body': 'Right, ¥50!\\nThank you!$'}
text:PewterCity_Museum_1F_DontHaveEnoughMoney	{'body': "You don't have enough money.$"}
text:PewterCity_Museum_1F_PleaseEnjoyYourself	{'body': 'Please enjoy yourself.$'}
text:PewterCity_Museum_1F_DoYouKnowWhatAmberIs	{'body': "You can't sneak in the back way!\\nNice try, kid, but no.\\pOh, whatever!\\nDo you know what AMBER is?$"}
text:PewterCity_Museum_1F_AmberContainsGeneticMatter	{'body': "AMBER contains the genetic matter\\nof ancient POKéMON.\\pThere's a LAB somewhere trying to\\nresurrect POKéMON from AMBER.$"}
text:PewterCity_Museum_1F_AmberIsFossilizedSap	{'body': 'AMBER is actually sap, that gooey\\nstuff that oozes from trees.\\pThe ancient sap fossilized over\\ntime to become rock-hard AMBER.$'}
text:PewterCity_Museum_1F_PleaseGoAround	{'body': 'あちらへ\u3000おまわりください$'}
text:PewterCity_Museum_1F_ShouldBeGratefulForLongLife	{'body': 'I should be grateful for my long\\nlife.\\pNever did I think I would get to\\nsee the bones of a dragon!$'}
text:PewterCity_Museum_1F_WantYouToGetAmberExamined	{'body': 'Ssh! Listen, I need to share a\\nsecret with someone.\\pI think that this chunk of AMBER\\ncontains POKéMON DNA!\\pIt would be a shattering scientific\\nbreakthrough if POKéMON could be\\lresurrected from it.\\pBut, my colleagues just ignore\\nwhat I have to say.\\pSo, I have a favor to ask!\\pI want you to get this examined at\\na POKéMON LAB somewhere.$'}
text:PewterCity_Museum_1F_ReceivedOldAmberFromMan	{'body': '{PLAYER} received the OLD AMBER\\nfrom the man.$'}
text:PewterCity_Museum_1F_GetOldAmberChecked	{'body': 'Ssh!\\nGet the OLD AMBER checked!$'}
text:PewterCity_Museum_1F_DontHaveSpaceForThis	{'body': "You don't have space for this.$"}
text:PewterCity_Museum_1F_WeHaveTwoFossilsOnExhibit	{'body': 'We have two fossils of rare,\\nprehistoric POKéMON on exhibit.$'}
text:PewterCity_Museum_1F_BeautifulPieceOfAmber	{'body': 'There is a beautiful piece of\\nAMBER in a clear gold color.$'}
text:PewterCity_Museum_1F_AerodactylFossil	{'body': 'AERODACTYL Fossil\\nA primitive and rare POKéMON.$'}
text:PewterCity_Museum_1F_KabutopsFossil	{'body': 'KABUTOPS Fossil\\nA primitive and rare POKéMON.$'}
text:SeismicTossTeach	{'body': 'The secrets of space…\\nThe mysteries of earth…\\pThere are so many things about\\nwhich we know so little.\\pBut that should spur us to study\\nharder, not toss in the towel.\\pThe only thing you should toss…\\pWell, how about SEISMIC TOSS?\\nShould I teach that to a POKéMON?$'}
text:SeismicTossDeclined	{'body': "Is that so?\\nI'm sure you'll be back for it.$"}
text:SeismicTossWhichMon	{'body': 'Which POKéMON wants to learn\\nSEISMIC TOSS?$'}
text:SeismicTossTaught	{'body': "I hope you won't toss in the towel.\\nKeep it up.$"}
text:PewterCity_Museum_1F_WhatsSpecialAboutMoonStone	{'body': "MOON STONE, huh?\\pWhat's so special about it?\\nLooks like an ordinary rock to me.$"}
text:PewterCity_Museum_1F_BoughtColorTVForMoonLanding	{'body': 'July 20, 1969!\\pHumankind first set foot on the\\nmoon that day.\\pI bought a color TV just so I\\ncould watch that news.$'}
text:PewterCity_Museum_1F_RunningSpaceExhibitThisMonth	{'body': "This month, we're running a space\\nexhibit.$"}
text:PewterCity_Museum_1F_AskedDaddyToCatchPikachu	{'body': "I want a PIKACHU!\\nIt's so cute!\\pI asked my daddy to catch me one!$"}
text:PewterCity_Museum_1F_PikachuSoonIPromise	{'body': 'Yeah, a PIKACHU soon, I promise!$'}
text:PewterCity_Museum_1F_SpaceShuttle	{'body': 'Space Shuttle$'}
text:PewterCity_Museum_1F_MeteoriteThatFellOnMtMoon	{'body': 'A meteorite that fell on MT. MOON.\\nIt is thought to be a MOON STONE.$'}
text:PewterCity_PokemonCenter_1F_TeamRocketMtMoonImOnPhone	{'body': "What!?\\pTEAM ROCKET is at MT. MOON?\\nHuh?\\pI'm on the phone!\\nScram!$"}
text:PewterCity_PokemonCenter_1F_Jigglypuff	{'body': 'JIGGLYPUFF: Puu pupuu!$'}
text:PewterCity_PokemonCenter_1F_WhenJiggylypuffSingsMonsGetDrowsy	{'body': 'Yawn!\\pWhen JIGGLYPUFF sings, POKéMON get\\ndrowsy…\\p…Me, too…\\nSnore…$'}
text:PewterCity_PokemonCenter_1F_TradingMyClefairyForPikachu	{'body': "I really want a PIKACHU, so I'm\\ntrading my CLEFAIRY for one.$"}
text:PewterCity_PokemonCenter_1F_TradingPikachuWithKid	{'body': "I'm trading POKéMON with that kid\\nthere.\\pI had two PIKACHU, so I figured\\nI might as well trade one.$"}
text:PokemonLeague_AgathasRoom_Intro	{'body': "I am AGATHA of the ELITE FOUR.\\pI hear OAK's taken a lot of\\ninterest in you, child.\\pThat old duff was once tough and\\nhandsome.\\pBut that was decades ago.\\nHe's a shadow of his former self.\\pNow he just wants to fiddle with\\nhis POKéDEX.\\pHe's wrong.\\nPOKéMON are for battling!\\p{PLAYER}! I'll show you how a real\\nTRAINER battles!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:PokemonLeague_AgathasRoom_RematchIntro	{'body': "I am AGATHA of the ELITE FOUR.\\pYou're the child that OAK's taken\\nunder his wing, aren't you?\\pThat old duff was once tough and\\nhandsome.\\pBut that was decades ago.\\nHe's a shadow of his former self.\\pNow he just wants to fiddle with\\nhis POKéDEX.\\pHe's wrong.\\nPOKéMON are for battling!\\p{PLAYER}! I'll show you how a real\\nTRAINER battles!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:PokemonLeague_AgathasRoom_Defeat	{'body': "Oh, my!\\nYou're something special, child!$"}
text:PokemonLeague_AgathasRoom_PostBattle	{'body': 'You win!\\pI see what the old duff sees in\\nyou now.\\pI have nothing else to say.\\nRun along now, child!$'}
text:PokemonLeague_BrunosRoom_Intro	{'body': "I am BRUNO of the ELITE FOUR!\\pThrough rigorous training, people\\nand POKéMON can become stronger\\lwithout limit.\\pI've lived and trained with my\\nfighting POKéMON!\\lAnd that will never change!\\p{PLAYER}!\\pWe will grind you down with our\\nsuperior power!\\pHoo hah!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:PokemonLeague_BrunosRoom_RematchIntro	{'body': "I am BRUNO of the ELITE FOUR!\\pThrough rigorous training, people\\nand POKéMON can become stronger\\lwithout limit.\\pI've lived and trained with my\\nfighting POKéMON!\\lAnd that will never change!\\p{PLAYER}!\\pWe will grind you down with our\\nsuperior power!\\pHoo hah!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:PokemonLeague_BrunosRoom_Defeat	{'body': 'Why?\\nHow could I lose?$'}
text:PokemonLeague_BrunosRoom_PostBattle	{'body': 'My job is done.\\nGo face your next challenge.$'}
text:PokemonLeague_ChampionsRoom_Intro	{'body': "{RIVAL}: Hey, {PLAYER}!\\pI was looking forward to seeing\\nyou, {PLAYER}.\\pMy rival should be strong to keep\\nme sharp.\\pWhile working on my POKéDEX, I\\nlooked all over for POKéMON.\\pNot only that, I assembled teams\\nthat would beat any POKéMON type.\\pAnd now…\\pI'm the POKéMON LEAGUE CHAMPION!\\p{PLAYER}!\\nDo you know what that means?\\pI'll tell you.\\pI am the most powerful TRAINER in\\nthe world!$"}
text:PokemonLeague_ChampionsRoom_RematchIntro	{'body': "{RIVAL}: Hey, {PLAYER}!\\pYou came back, {PLAYER}!\\nHahah, that is so great!\\pMy rival should be strong to keep\\nme sharp.\\pWhile working on my POKéDEX, I\\nlooked all over for POKéMON.\\pNot only that, I assembled teams\\nthat would beat any POKéMON type.\\pAnd now…\\pI'm the POKéMON LEAGUE CHAMPION!\\p{PLAYER}!\\nDo you know what that means?\\pI'll tell you.\\pI am the most powerful TRAINER in\\nthe world!$"}
text:PokemonLeague_ChampionsRoom_Defeat	{'body': "NO!\\nThat can't be!\\lYou beat me at my best!\\pAfter all that work to become\\nthe LEAGUE CHAMP?\\pMy reign is over already?\\nIt's not fair!$"}
text:PokemonLeague_ChampionsRoom_Victory	{'body': 'はーはッ！\\nかった！\u3000かった！\u3000かった！\\p{PLAYER}に\u3000まける\u3000ような\\nおれさま\u3000では\u3000なーい！\\pま！\u3000ポケモンの\\nてんさい\u3000{RIVAL}さま\u3000あいてに\\lここまで\u3000よく\u3000がんばった！\\pほめて\u3000つかわす！\\nはーッ！\u3000はーはッはッ！$'}
text:PokemonLeague_ChampionsRoom_PostBattle	{'body': "Why?\\nWhy did I lose?\\pI never made any mistakes raising\\nmy POKéMON…\\pDarn it! You're the new POKéMON\\nLEAGUE CHAMPION!\\pAlthough I don't like to admit it…$"}
text:PokemonLeague_ChampionsRoom_OakPlayer	{'body': 'OAK: {PLAYER}!$'}
text:PokemonLeague_ChampionsRoom_OakCongratulations	{'body': "OAK: So, you've won!\\nSincerely, congratulations!\\pYou're the new POKéMON LEAGUE\\nCHAMPION!\\pYou've grown up so much since you\\nfirst left with {STR_VAR_1} to work\\lon the POKéDEX.\\p{PLAYER}, you have come of age!$"}
text:PokemonLeague_ChampionsRoom_OakImDisappointedRival	{'body': "OAK: {RIVAL}…\\nI'm disappointed in you.\\pI came when I heard you'd beaten\\nthe ELITE FOUR.\\pBut, when I got here, you had\\nalready lost!\\p{RIVAL}, do you understand why\\nyou lost?\\pYou have forgotten to treat your\\nPOKéMON with love and trust.\\pWithout them, you will never\\nbecome a CHAMP again!$"}
text:PokemonLeague_ChampionsRoom_OakPlayerComeWithMe	{'body': 'OAK: {PLAYER}.\\pYou understand that your victory\\nwas not just your own doing.\\pThe bond you share with your\\nPOKéMON is marvelous.\\p{PLAYER}!\\nCome with me!$'}
text:PokemonLeague_HallOfFame_OakCongratulations	{'body': 'OAK: Er-hem!\\nCongratulations, {PLAYER}!\\pThis floor is the POKéMON HALL OF\\nFAME.\\pPOKéMON LEAGUE CHAMPIONS are\\nhonored for their exploits here.\\pTheir POKéMON are also recorded in\\nthe HALL OF FAME.\\p{PLAYER}!\\pYou have worked hard to become\\nthe new LEAGUE CHAMPION.\\pCongratulations, {PLAYER}, you and\\nyour POKéMON are HALL OF FAMERS!$'}
text:PokemonLeague_LancesRoom_Intro	{'body': "Ah! I've heard about you,\\n{PLAYER}!\\pI lead the ELITE FOUR.\\pYou can call me LANCE the dragon\\nTRAINER.\\pYou know that dragons are\\nmythical POKéMON.\\pThey're hard to catch and raise,\\nbut their powers are superior.\\pThey're virtually indestructible.\\nThere's no being clever with them.\\pWell, are you ready to lose?\\pYour LEAGUE challenge ends with\\nme, {PLAYER}!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:PokemonLeague_LancesRoom_RematchIntro	{'body': "Ah!\\nSo, you've returned, {PLAYER}!\\pI lead the ELITE FOUR.\\pYou can call me LANCE the dragon\\nTRAINER.\\pYou know that dragons are\\nmythical POKéMON.\\pThey're hard to catch and raise,\\nbut their powers are superior.\\pThey're virtually indestructible.\\nThere's no being clever with them.\\pWell, are you ready to lose?\\pYour LEAGUE challenge ends with\\nme, {PLAYER}!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:PokemonLeague_LancesRoom_Defeat	{'body': "That's it!\\pI hate to admit it, but you are a\\nPOKéMON master!$"}
text:PokemonLeague_LancesRoom_PostBattle	{'body': "I still can't believe my dragons\\nlost to you, {PLAYER}.\\pYou are now the POKéMON LEAGUE\\nCHAMPION!\\p…Or, you would have been, but\\nyou have one more challenge left.\\pThere is one more TRAINER to face!\\nHis name is…\\p{RIVAL}!\\pHe beat the ELITE FOUR before\\nyou.\\pHe is the real POKéMON LEAGUE\\nCHAMPION.$"}
text:PokemonLeague_LoreleisRoom_Intro	{'body': 'Welcome to the POKéMON LEAGUE.\\pI am LORELEI of the ELITE FOUR.\\pNo one can best me when it comes\\nto icy POKéMON.\\pFreezing moves are powerful.\\pYour POKéMON will be at my mercy\\nwhen they are frozen solid.\\pHahaha!\\nAre you ready?{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$'}
text:PokemonLeague_LoreleisRoom_RematchIntro	{'body': 'Welcome to the POKéMON LEAGUE.\\pI, LORELEI of the ELITE FOUR,\\nhave returned!\\pYou know how it goes.\\nNo one can best me when it comes\\lto icy POKéMON.\\pFreezing moves are powerful.\\pYour POKéMON will be at my mercy\\nwhen they are frozen solid.\\pHahaha!\\nAre you ready?{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$'}
text:PokemonLeague_LoreleisRoom_Defeat	{'body': "…Things shouldn't be this way!$"}
text:PokemonLeague_LoreleisRoom_PostBattle	{'body': "You're better than I thought.\\nGo on ahead.\\pYou only got a taste of the\\nPOKéMON LEAGUE's power.$"}
text:PokemonMansion_1F_TedIntro	{'body': "Who are you?\\nThere shouldn't be anyone here.$"}
text:PokemonMansion_1F_TedDefeat	{'body': 'Ouch!$'}
text:PokemonMansion_1F_TedPostBattle	{'body': "A key? I don't know what you're\\ntalking about.$"}
text:PokemonMansion_1F_JohnsonIntro	{'body': 'W-w-waah! You startled me!\\nI thought you were a ghost.$'}
text:PokemonMansion_1F_JohnsonDefeat	{'body': "Tch!\\nI can't get any wins.$"}
text:PokemonMansion_1F_JohnsonPostBattle	{'body': 'I was exploring here by myself,\\nbut I feel spooked.\\pI ought to go soon.$'}
text:PokemonMansion_PressSecretSwitch	{'body': 'A secret switch!\\pPress it?$'}
text:PokemonMansion_WhoWouldnt	{'body': "Who wouldn't?$"}
text:PokemonMansion_NotQuiteYet	{'body': 'Not quite yet!$'}
text:PokemonMansion_1F_ArnieIntro	{'body': "I can't get out!\\nThis old place is one big puzzle.$"}
text:PokemonMansion_1F_ArnieDefeat	{'body': 'Oh, no!\\nMy bag of loot!$'}
text:PokemonMansion_1F_ArniePostBattle	{'body': 'The switches here open and close\\nalternating sets of doors.$'}
text:PokemonMansion_1F_NewMonDiscoveredInGuyanaJungle	{'body': 'Diary: July 5\\nGuyana, South America\\pA new POKéMON was discovered deep\\nin the jungle.$'}
text:PokemonMansion_1F_ChristenedDiscoveredMonMew	{'body': 'Diary: July 10\\nWe christened the newly discovered\\lPOKéMON, MEW.$'}
text:PokemonMansion_1F_SimonIntro	{'body': 'This place is, like, huge!$'}
text:PokemonMansion_1F_SimonDefeat	{'body': 'Ayah!$'}
text:PokemonMansion_1F_SimonPostBattle	{'body': 'I wonder where my partner went.$'}
text:PokemonMansion_1F_BraydonIntro	{'body': 'My mentor once lived here.$'}
text:PokemonMansion_1F_BraydonDefeat	{'body': 'Whew!\\nOverwhelming!$'}
text:PokemonMansion_1F_BraydonPostBattle	{'body': "So, you're stuck?\\nTry jumping off over there!$"}
text:PokemonMansion_1F_MewGaveBirthToMewtwo	{'body': 'Diary: Feb. 6\\nMEW gave birth.\\pWe named the newborn MEWTWO.$'}
text:PokemonMansion_B1F_LewisIntro	{'body': 'Uh-oh…\\nWhere am I now?$'}
text:PokemonMansion_B1F_LewisDefeat	{'body': 'Awooh!$'}
text:PokemonMansion_B1F_LewisPostBattle	{'body': "You can find stuff lying around.\\nThe residents must've left them.$"}
text:PokemonMansion_B1F_IvanIntro	{'body': 'This place is ideal for a lab.\\nLook at all this space.$'}
text:PokemonMansion_B1F_IvanDefeat	{'body': 'What was that for?$'}
text:PokemonMansion_B1F_IvanPostBattle	{'body': "I like it here.\\nIt's conducive to my studies.$"}
text:PokemonMansion_B1F_MewtwoIsFarTooPowerful	{'body': 'Diary: Sept. 1\\nMEWTWO is far too powerful.\\pWe have failed to curb its vicious\\ntendencies…$'}
text:PokemonTower_1F_ErectedInMemoryOfDeadMons	{'body': 'POKéMON TOWER was erected in the\\nmemory of POKéMON that died.$'}
text:PokemonTower_1F_ComeToPayRespectsSon	{'body': 'Did you come to pay respects?\\pBless your POKéMON-loving heart,\\nson.$'}
text:PokemonTower_1F_ComeToPayRespectsGirl	{'body': 'Did you come to pay respects?\\pBless your POKéMON-loving heart,\\ngirl.$'}
text:PokemonTower_1F_CameToPrayForDepartedClefairy	{'body': "I came to pray for my dearly\\ndeparted CLEFAIRY.\\pSniff!\\nI'm awash in tears…$"}
text:PokemonTower_1F_GrowlitheWhyDidYouDie	{'body': 'My GROWLITHE…\\nWhy did you die?$'}
text:PokemonTower_1F_SenseSpiritsUpToMischief	{'body': 'I am a CHANNELER.\\pThere are spirits up to mischief.\\nI sense them high in the TOWER.$'}
text:PokemonTower_2F_RivalIntro	{'body': "{RIVAL}: Hey, {PLAYER}!\\nWhat brings you here?\\lIs your POKéMON dead?\\pHey! It's alive!\\pI can at least make them faint!\\nLet's go!$"}
text:PokemonTower_2F_RivalDefeat	{'body': 'What?\\nYou stinker!\\pI took it easy on you, too!$'}
text:PokemonTower_2F_RivalPostBattle	{'body': "How's your POKéDEX coming?\\nI just caught a CUBONE!\\pI can't find the bigger MAROWAK.\\nWhere could they be?\\pI bet there aren't any left!\\pWell, I better get going.\\nI've got a lot to accomplish,\\lunlike you.\\pSmell ya later!$"}
text:PokemonTower_2F_SilphScopeCouldUnmaskGhosts	{'body': 'Even we could not identify the\\nwayward ghosts.\\pA SILPH SCOPE might be able to\\nunmask them.$'}
text:PokemonTower_3F_HopeIntro	{'body': 'Urrg… Awaa…\\nHuhu… Graa…$'}
text:PokemonTower_3F_HopeDefeat	{'body': "Hwa!\\nI'm saved!$"}
text:PokemonTower_3F_HopePostBattle	{'body': 'The ghosts can be identified by\\nthe SILPH SCOPE.$'}
text:PokemonTower_3F_CarlyIntro	{'body': 'Kekeke…\\nKwaaah!$'}
text:PokemonTower_3F_CarlyDefeat	{'body': 'Hmm?\\nWhat am I doing?$'}
text:PokemonTower_3F_CarlyPostBattle	{'body': 'Sorry!\\nI was possessed!$'}
text:PokemonTower_3F_PatriciaIntro	{'body': 'Be gone!\\nMalevolent spirit!$'}
text:PokemonTower_3F_PatriciaDefeat	{'body': 'Whew!\\nThe spirit left!$'}
text:PokemonTower_3F_PatriciaPostBattle	{'body': 'The others above…\\nThey must have been possessed.$'}
text:PokemonTower_4F_PaulaIntro	{'body': 'Ghost! No!\\nKwaaah!$'}
text:PokemonTower_4F_PaulaDefeat	{'body': 'Where is the ghost?$'}
text:PokemonTower_4F_PaulaPostBattle	{'body': 'I must have been dreaming…$'}
text:PokemonTower_4F_LaurelIntro	{'body': 'Be cursed with me!\\nKwaaah!$'}
text:PokemonTower_4F_LaurelDefeat	{'body': 'What!$'}
text:PokemonTower_4F_LaurelPostBattle	{'body': "We can't determine the identity of\\nthe ghosts…$"}
text:PokemonTower_4F_JodyIntro	{'body': 'Huhuhu…\\nBeat me not!$'}
text:PokemonTower_4F_JodyDefeat	{'body': 'Huh?\\nWho? What?$'}
text:PokemonTower_4F_JodyPostBattle	{'body': 'May the departed POKéMON rest in\\npeace…$'}
text:PokemonTower_5F_RestHereInPurifiedSpace	{'body': 'Come, child!\\nI have purified this space.\\lYou can rest here.$'}
text:PokemonTower_5F_TammyIntro	{'body': 'Give…me…\\nyour…all…$'}
text:PokemonTower_5F_TammyDefeat	{'body': 'Gasp!$'}
text:PokemonTower_5F_TammyPostBattle	{'body': 'I was under possession.$'}
text:PokemonTower_5F_RuthIntro	{'body': 'You…shall…\\njoin…us…$'}
text:PokemonTower_5F_RuthDefeat	{'body': 'What a nightmare!$'}
text:PokemonTower_5F_RuthPostBattle	{'body': 'I was possessed.$'}
text:PokemonTower_5F_KarinaIntro	{'body': 'Zombies!$'}
text:PokemonTower_5F_KarinaDefeat	{'body': 'Ha?$'}
text:PokemonTower_5F_KarinaPostBattle	{'body': 'I regained my senses.$'}
text:PokemonTower_5F_JanaeIntro	{'body': 'Urgah…\\nUrff…$'}
text:PokemonTower_5F_JanaeDefeat	{'body': 'Whoo!$'}
text:PokemonTower_5F_JanaePostBattle	{'body': 'I fell to evil spirits despite my\\ntraining in the mountains…$'}
text:PokemonTower_5F_PurifiedZoneMonsFullyHealed	{'body': "Entered the purified and protected\\nzone.\\p{PLAYER}'s POKéMON were fully\\nhealed.$"}
text:PokemonTower_6F_AngelicaIntro	{'body': 'Give…me…\\nblood…$'}
text:PokemonTower_6F_AngelicaDefeat	{'body': 'Groan!$'}
text:PokemonTower_6F_AngelicaPostBattle	{'body': 'I feel anemic and weak…$'}
text:PokemonTower_6F_EmiliaIntro	{'body': 'Urff…\\nKwaah!$'}
text:PokemonTower_6F_EmiliaDefeat	{'body': 'Something fell out!$'}
text:PokemonTower_6F_EmiliaPostBattle	{'body': "My hair didn't fall out!\\nIt was a malevolent spirit!$"}
text:PokemonTower_6F_JenniferIntro	{'body': 'Ke…ke…ke…\\nke…ke…ke!$'}
text:PokemonTower_6F_JenniferDefeat	{'body': 'Keee!$'}
text:PokemonTower_6F_JenniferPostBattle	{'body': "What's going on here?$"}
text:PokemonTower_6F_BeGoneIntruders	{'body': 'Be gone…\\nIntruders…$'}
text:PokemonTower_6F_GhostWasCubonesMother	{'body': "The ghost was the restless spirit\\nof CUBONE's mother!$"}
text:PokemonTower_6F_MothersSpiritWasCalmed	{'body': "The mother's spirit was calmed.\\pIt departed to the afterlife…$"}
text:PokemonTower_7F_Grunt1Intro	{'body': 'What do you want?\\nWhy are you here?$'}
text:PokemonTower_7F_Grunt1Defeat	{'body': 'I give up!$'}
text:PokemonTower_7F_Grunt1PostBattle	{'body': "I'm not going to forget this!$"}
text:PokemonTower_7F_Grunt2Intro	{'body': "This old guy marched right up to\\nour HIDEOUT.\\pThen, he starts ranting about how\\nTEAM ROCKET's abusing POKéMON.\\pSo, we're just talking it over as\\nadults.$"}
text:PokemonTower_7F_Grunt2Defeat	{'body': 'Please!\\nNo more!$'}
text:PokemonTower_7F_Grunt2PostBattle	{'body': 'POKéMON are only good for making\\nmoney. Why not use them?\\pYou stay out of our business!$'}
text:PokemonTower_7F_Grunt3Intro	{'body': "You're not saving anyone, kid!$"}
text:PokemonTower_7F_Grunt3Defeat	{'body': "Don't fight us ROCKETS!$"}
text:PokemonTower_7F_Grunt3PostBattle	{'body': "You're not getting away with this!$"}
text:PokemonTower_7F_MrFujiThankYouFollowMe	{'body': "MR. FUJI: Heh?\\nYou came to save me?\\pThank you. But, I came here of my\\nown free will.\\pI came to calm the spirit of\\nCUBONE's mother.\\pI think MAROWAK's spirit has\\nfinally left us.\\pI must thank you for your kind\\nconcern.\\pFollow me to my home, POKéMON\\nHOUSE, at the foot of this tower.$"}
text:RockTunnel_1F_LennyIntro	{'body': 'This tunnel goes a long way, kid!$'}
text:RockTunnel_1F_LennyDefeat	{'body': 'Doh!\\nYou win!$'}
text:RockTunnel_1F_LennyPostBattle	{'body': 'Watch for ONIX.\\nThey appear only occasionally.\\pHigh-level ones can put the\\nsqueeze on you!$'}
text:RockTunnel_1F_OliverIntro	{'body': "Hmm.\\nMaybe I'm lost in here…$"}
text:RockTunnel_1F_OliverDefeat	{'body': 'Ease up!\\nWhat am I doing?\\lWhich way is out?$'}
text:RockTunnel_1F_OliverPostBattle	{'body': 'That sleeping POKéMON on ROUTE 12\\nforced me to take this detour.$'}
text:RockTunnel_1F_LucasIntro	{'body': 'Outsiders like you need to show me\\nsome respect!$'}
text:RockTunnel_1F_LucasDefeat	{'body': 'I give!$'}
text:RockTunnel_1F_LucasPostBattle	{'body': "You're talented enough to hike!$"}
text:RockTunnel_1F_AshtonIntro	{'body': 'POKéMON fight!\\nReady, go!$'}
text:RockTunnel_1F_AshtonDefeat	{'body': 'Game over!$'}
text:RockTunnel_1F_AshtonPostBattle	{'body': "Oh well, I'll get a ZUBAT as I go!$"}
text:RockTunnel_1F_LeahIntro	{'body': "Eek!\\pDon't try anything funny in the\\ndark!$"}
text:RockTunnel_1F_LeahDefeat	{'body': 'It was too dark…$'}
text:RockTunnel_1F_LeahPostBattle	{'body': 'I saw a MACHOP in this tunnel.$'}
text:RockTunnel_1F_DanaIntro	{'body': 'I came this far looking for wild\\nPOKéMON.$'}
text:RockTunnel_1F_DanaDefeat	{'body': "I'm out of POKéMON!$"}
text:RockTunnel_1F_DanaPostBattle	{'body': 'You looked cute and harmless.\\nWas I ever wrong!$'}
text:RockTunnel_1F_ArianaIntro	{'body': "You have POKéMON!\\nLet's start!$"}
text:RockTunnel_1F_ArianaDefeat	{'body': 'You play hard!$'}
text:RockTunnel_1F_ArianaPostBattle	{'body': "Whew!\\nI'm all sweaty now.$"}
text:RockTunnel_1F_RouteSign	{'body': 'ROCK TUNNEL\\nCERULEAN CITY - LAVENDER TOWN$'}
text:RockTunnel_B1F_SofiaIntro	{'body': 'Do you know how you can avoid\\ngetting lost in the mountains?\\pYou can bend twigs as trail\\nmarkers.$'}
text:RockTunnel_B1F_SofiaDefeat	{'body': 'Ohhh!\\nI did my best!$'}
text:RockTunnel_B1F_SofiaPostBattle	{'body': 'I want to go home!$'}
text:RockTunnel_B1F_DudleyIntro	{'body': 'Hahaha!\\nCan you beat my power?$'}
text:RockTunnel_B1F_DudleyDefeat	{'body': 'Oops!\\nOutmuscled!$'}
text:RockTunnel_B1F_DudleyPostBattle	{'body': 'I go for power because I hate\\nthinking.$'}
text:RockTunnel_B1F_CooperIntro	{'body': 'You have a POKéDEX?\\nI want one, too.$'}
text:RockTunnel_B1F_CooperDefeat	{'body': 'Shoot!\\nI am so jealous!$'}
text:RockTunnel_B1F_CooperPostBattle	{'body': 'When you finish your POKéDEX,\\ncan I have it?$'}
text:RockTunnel_B1F_SteveIntro	{'body': 'Um… Do you know about POKéMON\\ncosplay?$'}
text:RockTunnel_B1F_SteveDefeat	{'body': "Well, that's that.$"}
text:RockTunnel_B1F_StevePostBattle	{'body': 'POKéMON cosplay is dressing up as\\nPOKéMON for fun.\\pCLEFAIRY is a favorite.$'}
text:RockTunnel_B1F_AllenIntro	{'body': 'My POKéMON techniques will leave\\nyou crying!$'}
text:RockTunnel_B1F_AllenDefeat	{'body': "I give!\\nYou're a better technician!$"}
text:RockTunnel_B1F_AllenPostBattle	{'body': "In mountains, you'll often find\\nROCK-type POKéMON.$"}
text:RockTunnel_B1F_MarthaIntro	{'body': "I don't often come here, but I will\\nbattle you.$"}
text:RockTunnel_B1F_MarthaDefeat	{'body': 'Oh!\\nI lost!$'}
text:RockTunnel_B1F_MarthaPostBattle	{'body': 'I like tiny POKéMON.\\nBig ones are too scary!$'}
text:RockTunnel_B1F_EricIntro	{'body': 'Hit me with your best shot!$'}
text:RockTunnel_B1F_EricDefeat	{'body': 'Fired away!$'}
text:RockTunnel_B1F_EricPostBattle	{'body': "I'll raise my POKéMON to beat\\nyours, kid.$"}
text:RockTunnel_B1F_WinstonIntro	{'body': "I draw illustrations of POKéMON\\nwhen I'm home.$"}
text:RockTunnel_B1F_WinstonDefeat	{'body': "Whew…\\nI'm exhausted…$"}
text:RockTunnel_B1F_WinstonPostBattle	{'body': "I'm an artist, not a fighter.\\nI'll go home to draw.$"}
text:RocketHideout_B1F_Grunt1Intro	{'body': 'Who are you?\\nHow did you get here?$'}
text:RocketHideout_B1F_Grunt1Defeat	{'body': 'Oww!\\nBeaten!$'}
text:RocketHideout_B1F_Grunt1PostBattle	{'body': "Blast it… You're dissing TEAM\\nROCKET, aren't you?$"}
text:RocketHideout_B1F_Grunt2Intro	{'body': "You broke into TEAM ROCKET's\\noperation? What nerve!$"}
text:RocketHideout_B1F_Grunt2Defeat	{'body': 'Boom!$'}
text:RocketHideout_B1F_Grunt2PostBattle	{'body': "You're not going to get away with\\nthis, brat!$"}
text:RocketHideout_B1F_Grunt3Intro	{'body': 'Intruder alert!$'}
text:RocketHideout_B1F_Grunt3Defeat	{'body': "I can't do it!$"}
text:RocketHideout_B1F_Grunt3PostBattle	{'body': "SILPH SCOPE? Humph!\\nI don't know where it is.$"}
text:RocketHideout_B1F_Grunt4Intro	{'body': 'Why did you come here?$'}
text:RocketHideout_B1F_Grunt4Defeat	{'body': "This won't do!$"}
text:RocketHideout_B1F_Grunt4PostBattle	{'body': "Okay, I'll talk…\\nTake the elevator to see my BOSS.$"}
text:RocketHideout_B1F_Grunt5Intro	{'body': 'Are you lost, you little mouse?$'}
text:RocketHideout_B1F_Grunt5Defeat	{'body': 'Why…?$'}
text:RocketHideout_B1F_Grunt5PostBattle	{'body': 'Uh-oh, that ruckus somehow opened\\nthe door!$'}
text:RocketHideout_B2F_GruntIntro	{'body': 'BOSS said you can see ghosts with\\nthe SILPH SCOPE.$'}
text:RocketHideout_B2F_GruntDefeat	{'body': 'I surrender!$'}
text:RocketHideout_B2F_GruntPostBattle	{'body': 'The TEAM ROCKET HQ has four\\nunderground floors.\\pThink you can reach the BOSS?$'}
text:RocketHideout_B3F_Grunt1Intro	{'body': "Stop meddling in TEAM ROCKET's\\naffairs or else!$"}
text:RocketHideout_B3F_Grunt1Defeat	{'body': 'Oof!\\nTaken down!$'}
text:RocketHideout_B3F_Grunt1PostBattle	{'body': "SILPH SCOPE?\\nOh, that machine the BOSS stole.\\pIt's here somewhere.$"}
text:RocketHideout_B3F_Grunt2Intro	{'body': 'We got word from upstairs that you\\nwere coming!$'}
text:RocketHideout_B3F_Grunt2Defeat	{'body': 'What?\\nI lost? No!$'}
text:RocketHideout_B3F_Grunt2PostBattle	{'body': "Go ahead and go!\\pBut you can't run the elevator\\nwithout the LIFT KEY.$"}
text:RocketHideout_B4F_GiovanniIntro	{'body': "So! I must say, I am impressed you\\ngot here.\\pTEAM ROCKET captures POKéMON from\\naround the world.\\pThey're important tools for keeping\\nour criminal enterprise going.\\pI am the leader, GIOVANNI!\\pFor your insolence, you will feel a\\nworld of pain!$"}
text:RocketHideout_B4F_GiovanniDefeat	{'body': "WHAT!\\nThis can't be!$"}
text:RocketHideout_B4F_GiovanniPostBattle	{'body': 'I see that you raise POKéMON with\\nutmost care.\\pA child like you would never\\nunderstand what I hope to achieve.\\pI shall step aside this time!\\pI hope we meet again…$'}
text:RocketHideout_B4F_Grunt2Intro	{'body': 'I know you!\\nYou ruined our plans at MT. MOON!$'}
text:RocketHideout_B4F_Grunt2Defeat	{'body': 'Burned again!$'}
text:RocketHideout_B4F_Grunt2PostBattle	{'body': 'Do you have something against TEAM\\nROCKET?$'}
text:RocketHideout_B4F_Grunt3Intro	{'body': 'How can you not see the beauty of\\nour evil?$'}
text:RocketHideout_B4F_Grunt3Defeat	{'body': 'Ayaya!$'}
text:RocketHideout_B4F_Grunt3PostBattle	{'body': "BOSS!\\nI'm sorry I failed you!$"}
text:RocketHideout_B4F_Grunt1Intro	{'body': "The elevator doesn't work?\\nWho has the LIFT KEY?$"}
text:RocketHideout_B4F_Grunt1Defeat	{'body': 'No!$'}
text:RocketHideout_B4F_Grunt1PostBattle	{'body': 'Oh, no!\\nI dropped the LIFT KEY!$'}
text:RocketHideout_Elevator_AppearsToNeedAKey	{'body': 'It appears to need a key.$'}
text:Route101.RescueTryAgain	{'body': 'Your partners are safe.\\pTry again and help BIRCH?$'}
text:Route101.PairUnavailable	{'body': 'There is no room for both partners.\\nNo new pair was given.$'}
text:Route101.HelpMe	{'body': 'H-help me!$'}
text:Route101.PleaseHelp	{'body': 'You there! Please help!\\pTwo wild POKéMON are after me!\\nChoose two POKéMON from my BAG!$'}
text:Route101.DontLeaveMe	{'body': "Wh-Where are you going?!\\nDon't leave me like this!$"}
text:Route101.YouSavedMe	{'body': "PROF. BIRCH: Whew! Thank you!\\pI was studying those wild POKéMON\\nwhen they suddenly chased me.\\pYou're {PLAYER}{KUN}, our new neighbor!\\nWhat a way to meet!\\pLet's get back to my LAB. I want\\nto thank you and your partners.$"}
text:Route101.TakeTiredPokemonToPokeCenter	{'body': "If POKéMON get tired, take them to\\na POKéMON CENTER.\\pThere's a POKéMON CENTER in OLDALE\\nTOWN right close by.$"}
text:Route101.WildPokemonInTallGrass	{'body': 'Wild POKéMON live in tall grass.\\pWalk through it to find a partner,\\nthen use a POKé BALL to catch it.$'}
text:Route101.RouteSign	{'body': 'ROUTE 101\\n{UP_ARROW} OLDALE TOWN$'}
text:Route102.WatchMeCatchPokemon	{'body': "WALLY: {PLAYER}... POKéMON live in\\ntall grass like this, don't they?\\pI've never thrown a POKé BALL.\\nWill you watch and tell me if\\lI do it right?\\p...Whoa!$"}
text:Route102.WallyIDidIt	{'body': "WALLY: I did it… It chose to stay.\\nIt's my POKéMON!$"}
text:Route102.LetsGoBack	{'body': "{PLAYER}, thank you! Let's go back to\\nthe GYM. I want your dad to see!$"}
text:Route102.ImNotVeryTall	{'body': "I'm…not very tall, so I sink right\\ninto tall grass.\\pThe grass goes up my nose and…\\nFwafwafwafwafwa…\\pFwatchoo!$"}
text:Route102.CatchWholeBunchOfPokemon	{'body': 'I thought I saw a flower move...\\nThen a little green POKéMON ran\\lthrough the grass!\\pSHAYMIN! Right here, so close\\nto home! It has a 3% chance of\\lappearing in the grass.$'}
text:Route102.RouteSignOldale	{'body': 'ROUTE 102\\n{RIGHT_ARROW} OLDALE TOWN$'}
text:Route102.RouteSignPetalburg	{'body': 'ROUTE 102\\n{LEFT_ARROW} PETALBURG CITY$'}
text:Route102.ShayminCaught	{'body': 'You caught SHAYMIN! I knew that\\nmoving flower was a POKéMON.\\pLook after our little neighbor!$'}
text:Route103.MayRoute103Pokemon	{'body': "MAY: Let's see… The POKéMON found\\non ROUTE 103 include…$"}
text:Route103.MayLetsBattle	{'body': "MAY: The partner you left with\\nDad has joined my team!\\pI've been so excited to introduce\\neveryone. Ready for our DOUBLE\\lBATTLE?$"}
text:Route103.MayDefeated	{'body': 'Your team earned that win!$'}
text:Route103.MayTimeToHeadBack	{'body': "MAY: That was a serious battle!\\pLet's tell Dad how our teams did.$"}
text:Route103.BrendanRoute103Pokemon	{'body': "BRENDAN: Okay, so it's this one and\\nthat one that live on ROUTE 103…$"}
text:Route103.BrendanLetsBattle	{'body': "BRENDAN: I took the partner you\\nleft with Dad. We're getting\\lalong great!\\pLet's see how your team and mine\\nmeasure up. DOUBLE BATTLE. Ready?$"}
text:Route103.BrendanDefeated	{'body': 'Huh. We still have work to do.$'}
text:Route103.BrendanTimeToHeadBack	{'body': "BRENDAN: You earned that win!\\pLet's tell Dad how our teams did.$"}
text:Route103.FinishPreparation	{'body': 'Speak to Dad or his lab aide first.\\nYour partners and field supplies\\lare waiting for you there.$'}
text:Route103.KeepPreparing	{'body': "I'll be here when your team is ready.$"}
text:Route103.ShouldHaveBroughtPotion	{'body': 'My POKéMON is staggeringly tired…\\nI should have brought a POTION…$'}
text:Route103.ShortcutToOldale	{'body': "If you cross the sea from here,\\nit'll be a shortcut to OLDALE TOWN.\\pFufufu, that's useful, isn't it?$"}
text:Route103.RouteSign	{'body': 'ROUTE 103\\n{DOWN_ARROW} OLDALE TOWN$'}
text:Route103.ANDREW_LocalConversation	{'body': 'The fish are ignoring my bait.\\nI may have offended the chef.$'}
text:Route103.MARCOS_LocalConversation	{'body': 'I wrote a song about this river.\\nIt has a very strong current.$'}
text:Route103.PETE_LocalConversation	{'body': 'Swimming is all about timing.\\nSo is remembering to breathe.$'}
text:Route103.ISABELLE_LocalConversation	{'body': 'I found a shell for my collection.\\nIt objected and walked away.$'}
text:Route104.BrineyLivesInSeasideCottage	{'body': 'That seaside cottage is where\\nMR. BRINEY lives.\\pHe was once a mighty sailor who never\\nfeared the sea, however stormy.$'}
text:Route104.WhatsItLikeAtBottomOfSea	{'body': "The sea, huh?\\pI wonder what it's like at the bottom\\nof the sea?$"}
text:Route104.ThrowBallAtWeakenedPokemon	{'body': "A weakened wild POKéMON is easier\\nto catch. Sleep or paralysis can\\lhelp, too.\\pSee the Ball shown in battle?\\nTap R to throw it when the wild\\lPOKéMON can be caught.\\pOn the FIGHT/BAG menu, hold R\\nand use the Control Pad to cycle\\lthrough the Balls in your BAG.\\pRelease R after choosing, then\\ntap R to throw. Watch its HP;\\lyou don't want it to faint!$"}
text:Route104.OnlyThrowBallAtWildPokemon	{'body': "You're a thief if you try to steal\\nsomeone else's POKéMON.\\pYou should throw POKé BALLS only at\\nwild POKéMON.$"}
text:Route104.ImNotATrainer	{'body': "Oh, no, I'm not a TRAINER. I'm\\njust out for a walk.\\pSome TRAINERS will challenge you\\nas soon as they see you. Others\\lwould rather stop and chat!$"}
text:Route104.LikeFillingMouthWithSeedsTakeThis	{'body': 'I found this LEAF STONE beneath the\\nflowers! Some GRASS POKéMON evolve\\lwhen exposed to it. You should have it!$'}
text:Route104.LeafStoneExplanation	{'body': 'That LEAF STONE can evolve certain\\nGRASS POKéMON. Use it when ready.$'}
text:Route104.DontNeedThisTakeIt	{'body': 'I found this Leaf Stone among the\\nflowers. You should have it!$'}
text:Route104.FlowerShopSellingSaplings	{'body': 'This FLOWER SHOP started selling\\nsaplings recently.\\pIt made me so happy, I went overboard\\nshopping. Where should I put them?$'}
text:Route104.MrBrineysCottage	{'body': "MR. BRINEY'S COTTAGE$"}
text:Route104.RouteSignPetalburg	{'body': 'ROUTE 104 {RIGHT_ARROW} PETALBURG\\nCITY$'}
text:Route104.RouteSignRustboro	{'body': 'ROUTE 104 {UP_ARROW} RUSTBORO CITY$'}
text:Route104.PrettyPetalFlowShop	{'body': 'PRETTY PETAL FLOWER SHOP$'}
text:Route104.TrainerTipsDoubleBattles	{'body': 'TRAINER TIPS\\pTrainer battles in HOENN are\\nDOUBLE BATTLES. Prepare your first\\ltwo partners together.\\pA good opening pair gives each\\nPOKéMON room to do its job.$'}
text:Route104.MayWeShouldRegister	{'body': 'MAY: Oh, hi, {PLAYER}{KUN}!\\pDEVON upgraded your POKéNAV with\\nthe MATCH CALL system, huh?\\pWe should register each other so we\\ncan get in contact anytime.$'}
text:Route104.RegisteredMay	{'body': '{PLAYER} registered MAY\\nin the POKéNAV.$'}
text:Route104.MayHowsYourPokedex	{'body': "MAY: Oh, by the way, {PLAYER}{KUN},\\nhow's your POKéDEX coming along?$"}
text:Route104.MayMinesDecentLetsBattle	{'body': "Mine's looking pretty decent.\\nSo…\\lHow about a little battle?$"}
text:Route104.MayHaventRaisedPokemon	{'body': "MAY: Okay! We can battle when\\nyou're ready.\\pI've got plenty of POKéDEX notes\\nto sort out in the meantime.$"}
text:Route104.MayLetsBattle	{'body': 'MAY: So, what do you think?\\nHow about a little battle here?$'}
text:Route104.MayIntro	{'body': "MAY: {PLAYER}{KUN}! We've both\\nfound new partners since ROUTE\\l103.\\pShow me how your team works!$"}
text:Route104.MayDefeat	{'body': 'Yikes! You read that faster than me!$'}
text:Route104.MayPostBattle	{'body': "MAY: We've both come a long way\\nsince ROUTE 103!\\pAre you sailing with MR. BRINEY?\\nSay hello to PEEKO for me. I hope\\lthe sea stays calm for you!$"}
text:Route104.BrendanWeShouldRegister	{'body': "BRENDAN: Oh, hey, {PLAYER}!\\pCool, you had DEVON install the MATCH\\nCALL system on your POKéNAV!\\pLet's register each other in our\\nPOKéNAVS so we can keep in touch.$"}
text:Route104.RegisteredBrendan	{'body': '{PLAYER} registered BRENDAN\\nin the POKéNAV.$'}
text:Route104.BrendanHowsYourPokedex	{'body': "BRENDAN: {PLAYER}, how's your POKéDEX?\\nHave you filled in any pages yet?$"}
text:Route104.BrendanDoingGreatLetsBattle	{'body': "Me, I'm doing great!\\pWant to check out how good I am with\\na battle?$"}
text:Route104.BrendanNoConfidence	{'body': 'BRENDAN: Got somewhere to be? All\\nright. Come find me when you want\\la battle!$'}
text:Route104.BrendanLetsBattle	{'body': "BRENDAN: What's up?\\nWant to have a battle with me?$"}
text:Route104.BrendanIntro	{'body': "BRENDAN: Ready, {PLAYER}? I've\\nbeen looking forward to our next\\lbattle!$"}
text:Route104.BrendanDefeat	{'body': 'Hmm… Fine. You saw it coming.$'}
text:Route104.BrendanPostBattle	{'body': "BRENDAN: You've been busy since\\nROUTE 103. I'll have to keep up!\\pYou're going out to sea with MR.\\nBRINEY, right? Bring back a good\\lstory. I'll have one for you, too.$"}
text:Route104_MrBrineysHouse.WaitUpPeeko	{'body': 'MR. BRINEY: Hold on, lass!\\nWait up, PEEKO!$'}
text:Route104_MrBrineysHouse.ItsYouLetsSailToDewford	{'body': "Hm? You're {PLAYER}{KUN}!\\nYou saved my darling PEEKO!\\lWe owe so much to you!\\pWhat's that?\\nYou want to sail with me?\\pHmhm…\\pYou have a LETTER bound for DEWFORD\\nand a package for SLATEPORT, then?\\pQuite the busy life you must lead!\\pBut, certainly, what you're asking is\\nno problem at all.\\pYou've come to the right man!\\nWe'll set sail for DEWFORD.$"}
text:Route104_MrBrineysHouse.SetSailForDewford	{'body': "MR. BRINEY: DEWFORD it is, then!\\pAnchors aweigh!\\nPEEKO, we're setting sail, my darling!$"}
text:Route104_MrBrineysHouse.DeclineDeliverySail	{'body': 'MR. BRINEY: Is that so?\\nYour deliveries can wait?\\pYou just go on and tell me whenever\\nyou want to set sail!$'}
text:Route104_MrBrineysHouse.NeedToMakeDeliveriesSailToDewford	{'body': "MR. BRINEY: Ahoy!\\nI know exactly what you want to say!\\pYou're to deliver a LETTER to DEWFORD\\nand a package to SLATEPORT.\\pWhat you need me to do is no problem\\nat all--I'm the man for the job!\\pFirst, we'll set sail for DEWFORD.$"}
text:Route104_MrBrineysHouse.NeedToDeliverPackageSailToDewford	{'body': "MR. BRINEY: Ahoy!\\nI know exactly what you want to say!\\pYou're to deliver a package to\\nCAPT. STERN in SLATEPORT.\\pWhat you need me to do is no problem\\nat all--I'm the man for the job!\\pFirst, we'll set sail for DEWFORD.$"}
text:Route104_MrBrineysHouse.WhereAreWeBound	{'body': "MR. BRINEY: Ahoy!\\nFor you, I'll go out to sea anytime!\\pNow, my friend, where are we bound?$"}
text:Route104_MrBrineysHouse.TellMeWheneverYouWantToSail	{'body': 'MR. BRINEY: Is that so?\\nWell, PEEKO owes her life to you.\\pYou just go on and tell me whenever\\nyou want to set sail!$'}
text:Route104_MrBrineysHouse.Peeko	{'body': 'PEEKO: Pii piihyoro!$'}
text:Route104_PrettyPetalFlowerShop.MegaGift_VENUSAURITE_Text	{'body': 'I found this while tending flowers.\\nIt seems to answer a Venusaur.\\pKeep gathering berries as you travel.\\nThe Berry Master trades stones, too.$'}
text:Route104_DadPokenavCall	{'body': "… … … … … …\\n… … … … … Beep!\\pDAD: Oh, {PLAYER}?\\p… … … … … …\\nWhere are you now?\\lIt sounds windy wherever you are.\\pI just heard from DEVON's MR. STONE\\nabout your POKéNAV, so I decided\\lto give you a call.\\pIt sounds like you're doing fine,\\nso that's fine with me.\\pYou take care now.\\p… … … … … …\\n… … … … … Click!$"}
text:Route104_RegisteredDadInPokenav	{'body': 'Registered DAD NORMAN\\nin the POKéNAV.$'}
text:Route105.DOMINIK_LocalConversation	{'body': 'I challenged the current.\\nIt swept the entire match.$'}
text:Route106.TrainerTips	{'body': 'TRAINER TIPS\\pAdvice on catching POKéMON with a ROD:\\nPress the A Button if you get a bite.$'}
text:Route106.DOUGLAS_LocalConversation	{'body': 'A LAPRAS ferry sounds relaxing.\\nI should have booked one.$'}
text:Route107.BETH_LocalConversation	{'body': 'I swim for the scenery.\\nThe scenery keeps splashing me.$'}
text:Route108.JEROME_LocalConversation	{'body': 'I counted every wave out here.\\nThen somebody used SURF.$'}
text:Route108.MATTHEW_LocalConversation	{'body': 'MANTINE makes this look easy.\\nI would also like some wings.$'}
text:DewfordTown_BrineyLandedInSlateportDeliverGoods	{'body': "MR. BRINEY: Ahoy!\\nWe've made land in SLATEPORT!\\pI suppose you're going to visit CAPT.\\nSTERN and deliver the DEVON GOODS?$"}
text:Route109.BrineySailToDewfordQuestion	{'body': "MR. BRINEY: I thought you're supposed\\nto deliver the DEVON GOODS.\\pWould you like to sail back to\\nDEWFORD, then?$"}
text:Route109.BrineyDewfordItIs	{'body': "MR. BRINEY: DEWFORD it is, then!\\pAnchors aweigh!\\nPEEKO, we're setting sail, my darling!$"}
text:Route109.BrineyDeliverDevonGoods	{'body': "MR. BRINEY: Then you go on and deliver\\nthe DEVON GOODS. I'll be waiting.$"}
text:DewfordTown_BrineyLandedInSlateport	{'body': "MR. BRINEY: Ahoy! We've made land in\\nSLATEPORT!\\pYou just go on and tell me whenever\\nyou want to set sail again!$"}
text:Route109.BrineyWhereAreWeBound	{'body': "MR. BRINEY: Ahoy!\\nFor you, I'll go out to sea anytime!\\pNow, my friend, where are we bound?$"}
text:Route109.BrineyTellMeWhenYouNeedToSail	{'body': 'MR. BRINEY: You just tell me whenever\\nyou need to set sail again!$'}
text:Route109.ChillAtMyPapasSpot	{'body': "Yo, TRAINERS!\\nWhether you're hot to trot,\\lor cool cat not,\\lchill at my papa's spot!$"}
text:Route109.LittleKidsDartAround	{'body': "Little kids can dart around so quickly…\\pYou don't dare take your eyes off them\\nfor an instant. It's very taxing.\\pMine are with my POKéMON, so they\\nshould be okay, but…$"}
text:Route109.SandCastleTakingLongTime	{'body': "Our sand castle's taking a long time\\nto make.$"}
text:Route109.YouCanHaveThis	{'body': 'You can have this!$'}
text:Route109.WereGoingToMakeBigCastle	{'body': "We're going to get all the sand from\\nthe beach and make a big castle!\\pAnd then we're going to be a king and\\nqueen.\\pWe'll let you be a servant.$"}
text:Route109.ZigzagoonPicksUpLitter	{'body': 'The water around these parts is clean.\\pBut, I get my ZIGZAGOON to pick up\\nlitter from the shoreline at times.\\pDirty water becomes rain and joins our\\nrivers, which we drink from…\\pIf we pollute the sea, it all comes\\nback to haunt us eventually.$'}
text:Route109.ZigzagoonCry	{'body': 'ZIGZAGOON: Guguu?$'}
text:Route109.SeashoreHouseSign	{'body': 'SEASHORE HOUSE\\p“May hot battles rage on hot sands!\\nThe place for hot TRAINERS!”$'}
text:Route109.TrainerTipsSign	{'body': 'TRAINER TIPS\\pEvery partner has competitive\\npotential. Battles do not award\\lEVs to grind.\\pUse a CENTER specialist to set\\nNature and EVs. Compare\\lthe resulting stats before battle.$'}
text:Route109.HUEY_LocalConversation	{'body': 'My sea legs are excellent.\\nMy land legs filed a complaint.$'}
text:Route109.GWEN_LocalConversation	{'body': 'My float has never lost a race.\\nIt has never entered one either.$'}
text:Route109.ELIJAH_LocalConversation	{'body': 'A bird overhead means good luck.\\nUsually. Keep your hat on.$'}
text:Route109_SeashoreHouse.SeashoreHouseIntro	{'body': "I'm the owner of the SEASHORE HOUSE.\\nBut you can call me MR. SEA!\\pWhat I love above all is to see hot\\nPOKéMON battles.\\pLet me see that your heart burns hot!\\pIf you can defeat all the TRAINERS\\nhere, I'll reward your efforts.$"}
text:Route109_SeashoreHouse.ShowMeSomeHotMatches	{'body': 'Show me some hot matches!\\pI run this SEASHORE HOUSE just for\\nthat reason alone!$'}
text:Route109_SeashoreHouse.TakeTheseSodaPopBottles	{'body': "You're scorching hot!\\nThose battles blazed!\\lI'm more than just satisfied!\\pAs thanks for showing me your hot\\nstreak, I want you to take these.\\pIt's half a dozen bottles of SODA POP!$"}
text:Route109_SeashoreHouse.BagFull	{'body': "Oh, but hey, your BAG's jammed full.\\nI'll hang on to these for you.$"}
text:Route109_SeashoreHouse.WantToBuySodaPop	{'body': 'Want to buy some SODA POP?\\nPOKéMON love it!\\pJust ¥300 a bottle!\\nBuy some!$'}
text:Route109_SeashoreHouse.HereYouGo	{'body': 'Here you go!$'}
text:Route109_SeashoreHouse.NotEnoughMoney	{'body': "You don't have the money.$"}
text:Route109_SeashoreHouse.ThatsTooBad	{'body': "No?\\nThat's too bad.$"}
text:Route109_SeashoreHouse.DwayneIntro	{'body': "If you're looking for a battle in the\\nSEASHORE HOUSE, you'll find no\\lhotter TRAINER than me, matey!$"}
text:Route109_SeashoreHouse.DwayneDefeated	{'body': 'That was a hot battle!\\nI can accept that loss, matey!$'}
text:Route109_SeashoreHouse.DwaynePostBattle	{'body': "Whenever I'm in SLATEPORT, I enjoy\\nhot battles and ice-cold SODA POP!$"}
text:Route109_SeashoreHouse.JohannaIntro	{'body': "Boring battles aren't worth the effort.\\pFiery hot battles are what toughen up\\nTRAINERS and POKéMON!$"}
text:Route109_SeashoreHouse.JohannaDefeated	{'body': "That's hot!$"}
text:Route109_SeashoreHouse.JohannaPostBattle	{'body': "Whew, I'm all thirsty.\\nMaybe I'll have a SODA POP.$"}
text:Route109_SeashoreHouse.SimonIntro	{'body': "I'm going to show you how great\\nmy POKéMON are, but don't cry!$"}
text:Route109_SeashoreHouse.SimonDefeated	{'body': "…I lost, but I won't cry…$"}
text:Route109_SeashoreHouse.SimonPostBattle	{'body': "With SURF's HM and the right BADGE,\\na partner that can use it could\\lcarry me across the water.\\pIt wouldn't need SURF in its\\nbattle moves! Until then, I'll\\lkeep my trusty inner tube.$"}
text:Route10_MarkIntro	{'body': "Wow, you came all the way here?\\nMaybe you're a POKéMANIAC, too?\\lWant to see my collection?$"}
text:Route10_MarkDefeat	{'body': "Humph.\\nI'm not angry!$"}
text:Route10_MarkPostBattle	{'body': 'I have more rare POKéMON at home!$'}
text:Route10_ClarkIntro	{'body': 'Ha-hahah-ah-ha!$'}
text:Route10_ClarkDefeat	{'body': 'Ha-haha!\\nNot laughing!\\lHa-hay fever! Haha-ha-choo!$'}
text:Route10_ClarkPostBattle	{'body': 'Haha-ha-choo!\\nHa-choo!\\lSnort! Snivel!$'}
text:Route10_HermanIntro	{'body': 'Hi, kid!\\nWant to see my POKéMON?$'}
text:Route10_HermanDefeat	{'body': 'Oh, no!\\nMy POKéMON!$'}
text:Route10_HermanPostBattle	{'body': "I don't like you.\\nI don't like anyone better than me!$"}
text:Route10_HeidiIntro	{'body': "I've been out at a POKéMON GYM\\na few times.\\p…But I always lose.$"}
text:Route10_HeidiDefeat	{'body': 'Ohh!\\nAfter all my training!$'}
text:Route10_HeidiPostBattle	{'body': 'I noticed some POKéMANIACS\\nprowling around.\\pCan you imagine? Them?\\nUp here in the mountains?$'}
text:Route10_TrentIntro	{'body': 'Ah!\\nThis mountain air is delicious!$'}
text:Route10_TrentDefeat	{'body': 'That cleared my head!$'}
text:Route10_TrentPostBattle	{'body': 'I feel bloated on mountain air!$'}
text:Route10_CarolIntro	{'body': "I'm feeling a bit faint.\\nI haven't hiked in some time.$"}
text:Route10_CarolDefeat	{'body': "I'm too tired.\\nI wasn't up for it.$"}
text:Route10_CarolPostBattle	{'body': 'The POKéMON here in the mountains\\nare so chunky…\\pI wish there were pink POKéMON\\nwith a floral pattern!$'}
text:Route10_RockTunnelDetourToLavender	{'body': 'ROCK TUNNEL\\nDetour to LAVENDER TOWN$'}
text:Route10_RockTunnel	{'body': 'ROCK TUNNEL$'}
text:Route10_PowerPlant	{'body': 'POWER PLANT$'}
text:Route10_PokemonCenter_1F_EveryTypeStrongerThanOthers	{'body': 'The types of POKéMON match up\\ndifferently with each other.\\pEvery type is stronger than some\\ntypes and weaker than others.$'}
text:Route10_PokemonCenter_1F_NuggetUselessSoldFor5000	{'body': 'A NUGGET is totally useless.\\nSo I sold it for ¥5000.$'}
text:Route10_PokemonCenter_1F_HeardGhostsHauntLavender	{'body': 'I heard that ghosts haunt\\nLAVENDER TOWN.$'}
text:Route10_PokemonCenter_1F_GiveEverstoneIfCaught20Mons	{'body': "Oh… {PLAYER}!\\nI've been looking for you!\\pIt's me, one of the ever-present\\nAIDES to PROF. OAK.\\pIf your POKéDEX has complete data\\non twenty species, I'm supposed to\\lgive you a reward from PROF. OAK.\\pHe entrusted me with this\\nEVERSTONE.\\pSo, {PLAYER}, let me ask you.\\pHave you gathered data on at least\\ntwenty kinds of POKéMON?$"}
text:Route10_PokemonCenter_1F_GreatHereYouGo	{'body': 'Great! You have caught or owned\\n{STR_VAR_3} kinds of POKéMON!\\pCongratulations!\\nHere you go!$'}
text:Route10_PokemonCenter_1F_ReceivedEverstoneFromAide	{'body': '{PLAYER} received the EVERSTONE\\nfrom the AIDE.$'}
text:Route10_PokemonCenter_1F_ExplainEverstone	{'body': 'Making POKéMON evolve certainly\\ncan add to the POKéDEX.\\pHowever, at times, you may not\\nwant a certain POKéMON to evolve.\\pIn that case, give the EVERSTONE\\nto that POKéMON.\\pIt will prevent evolution according\\nto the PROFESSOR.$'}
text:Route110.WeCantTalkAboutAquaActivities	{'body': "TEAM AQUA's activities…\\nWe can't talk about them yet.$"}
text:Route110.KickUpARuckus	{'body': 'I want to get going to SLATEPORT and\\nkick up a ruckus!$'}
text:Route110.MyFirstJobInAqua	{'body': "This is my first job after joining\\nTEAM AQUA. It's a little scary.$"}
text:Route110.AquaActionsBringSmiles	{'body': "TEAM AQUA's actions should bring\\nsmiles to people's faces!$"}
text:Route110.MayLetsBattle	{'body': "MAY: {PLAYER}{KUN}! I've been\\nfinding new POKéMON all the way\\lfrom OLDALE.\\pYou must have met some, too!\\nLet's have a battle and introduce\\lthem!$"}
text:Route110.MayDefeated	{'body': "Wow! You've gotten stronger!$"}
text:Route110.MayTakeThis	{'body': 'MAY: Your partners found an answer\\nto mine. That was a good battle!\\pTake this. It finds what routes\\nhide.$'}
text:Route110.MayExplainItemfinder	{'body': "MAY: That's a DOWSING MACHINE. It\\nreacts to hidden items.\\pFor legendary POKéMON, ask the\\nguide near a POKéMON CENTER's PC.\\lThey know the local leads.\\pI'm heading north to MAUVILLE.\\nWATTSON's GYM is there. See you!$"}
text:Route110.RivalBeforeBattle	{'body': 'Hey, {PLAYER}! Meet me just down\\nthe path. I want to see your team!$'}
text:Route110.RivalRewardRetry	{'body': 'I still have that DOWSING MACHINE\\nfor you. Here you go!$'}
text:Route110.DowsingMachineSentToPC	{'body': 'Your KEY ITEMS pocket is full, so the\\nDOWSING MACHINE was sent to your PC.$'}
text:Route110.DowsingMachineNoRoom	{'body': 'Your KEY ITEMS pocket and PC are full.\\nMake room, then speak to me again.$'}
text:Route110.BrendanLetsBattle	{'body': "BRENDAN: Hey, {PLAYER}! Figured\\nyou'd come this way.\\pI've been looking forward to\\nanother battle. Let's see how far\\lwe've come!$"}
text:Route110.BrendanDefeated	{'body': "Hah… You've been busy, too!$"}
text:Route110.BrendanTakeThis	{'body': 'BRENDAN: A strong team, well\\nplayed. You earned that win.\\pHere. Take this.$'}
text:Route110.BrendanExplainItemfinder	{'body': "BRENDAN: A DOWSING MACHINE! It\\nhums near items you can't see.\\pThe guide near each POKéMON\\nCENTER's PC knows local legendary\\lPOKéMON and where to find them.\\pKeep north to MAUVILLE CITY.\\nWATTSON's GYM will test your\\lteam.$"}
text:Route110.RideBikeAtFullSpeed	{'body': "Wouldn't it be great to ride a BIKE\\nat full speed on CYCLING ROAD?$"}
text:Route110.HairStreamsBehindMe	{'body': 'How do you like the way my raven-\\ncolored hair streams behind me?\\pI grew my hair out just for that.$'}
text:Route110.YouGotBikeFromRydel	{'body': "Oh, hey, you got that BIKE from RYDEL!\\pOh, it's glaringly obvious.\\nIt says right on your bike…\\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\\nRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\\nRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\\nRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\\nRYDEL, RYDEL, RYDEL, RYDEL, RYDEL,\\pRYDEL, RYDEL, RYDEL, RYDEL, RYDEL…\\nThat name's everywhere.\\pYou should ride it around all over\\nthe place--it's good advertising!$"}
text:Route110.TwoRoads	{'body': 'The two roads, one above, one below…\\pA road each for people and POKéMON.\\nPerhaps that is right and fair.$'}
text:Route110.WalkOnTheLowRoad	{'body': "I don't have a BIKE, so I'll take\\na leisurely walk on the low road.$"}
text:Route110.BikeTechniques	{'body': 'Learning techniques will make BIKE\\nriding even more fun.\\pThere are some places that you can\\nreach only by using a BIKE technique.$'}
text:Route110.WhichShouldIChoose	{'body': 'Which should I choose?\\pMake a beeline for MAUVILLE on\\nCYCLING ROAD, or take the low road\\land look for POKéMON?$'}
text:Route110.CyclingChallengeResultSummary	{'body': 'Number of collisions:\\n… … {STR_VAR_1}!\\pTotal time:\\n… … {STR_VAR_2}!$'}
text:Route110.ChallengeReactionBest	{'body': "Bravo! Splendid showing!\\pYour love of cycling comes from deep\\nwithin your heart.\\lYou've shaken me to my very soul!$"}
text:Route110.ChallengeReactionGood	{'body': 'Your technique is remarkable.\\pI suggest you speed up a bit while\\nstill avoiding collisions.$'}
text:Route110.ChallengeReactionOk	{'body': "I would consider you a work in\\nprogress.\\pStill, I hope you don't forget the\\nsheer pleasure of cycling.$"}
text:Route110.ChallengeReactionBad	{'body': 'My word… Your cycling skills border\\non terrifying.\\pMost certainly, you need much more\\npractice riding.$'}
text:Route110.ChallengeReactionWorst	{'body': "…I am aghast…\\pYou're perhaps not cut out for this\\nunfortunate cycling business.\\pYou ought to give serious thought to\\nreturning that BIKE to RYDEL.$"}
text:Route110.RatedForNumberOfCollisions	{'body': 'This is CYCLING ROAD.\\pIf you were to ride from MAUVILLE to\\nSLATEPORT on a MACH BIKE, you would\\lbe rated for the number of collisions\\land your total time.$'}
text:Route110.AlwaysAimHigher	{'body': 'Regardless of the results, I count on\\nseeing more challenges from you.\\lAlways aim higher!$'}
text:Route110.AcroBikesDoNotQualify	{'body': "On this CYCLING ROAD, those riding\\nMACH BIKES are rated for their number\\lof collisions and their total times.\\pACRO BIKES do not qualify for rating.\\nThey are easy to turn, so it's not fair.$"}
text:Route110.SlateportCitySign	{'body': 'ROUTE 110\\n{DOWN_ARROW} SLATEPORT CITY$'}
text:Route110.CyclingRoadSign	{'body': 'SEASIDE CYCLING ROAD$'}
text:Route110.AquaWasHere	{'body': '“TEAM AQUA was here!”\\pSomeone painted that onto this sign,\\nbut then someone else painted over it.\\p“TEAM MAGMA rules!” is what it\\nsays now.$'}
text:Route110.Route103Sign	{'body': 'ROUTE 110\\n{LEFT_ARROW} ROUTE 103$'}
text:Route110.SeasideParkingSign	{'body': 'SEASIDE PARKING$'}
text:Route110.MauvilleCitySign	{'body': 'ROUTE 110\\n{UP_ARROW} MAUVILLE CITY$'}
text:Route110.TrainerTipsPrlzSleep	{'body': 'TRAINER TIPS\\pParalysis usually lowers Speed and\\ncan interrupt a move.\\pSleep stops most moves until the\\nPokémon wakes. Abilities and\\lterrain can change which plans\\lwork.$'}
text:Route110.TrainerTipsRegisterItems	{'body': 'TRAINER TIPS\\pThe items in the BAG can be reorganized\\nby pressing SELECT.$'}
text:Route110.TrickHouseSign	{'body': '“Three steps {RIGHT_ARROW} and two steps {UP_ARROW}\\nto reach the wondrous TRICK HOUSE.”$'}
text:Route110.BestRecord	{'body': 'THE BEST RECORD TO DATE…\\pNo. of collisions: {STR_VAR_1}\\pElapsed time: {STR_VAR_2}$'}
text:Route110.ThereIsNoRecord	{'body': 'THE BEST RECORD TO DATE…\\pNo one seems to have taken the\\nchallenge. There is no record…$'}
text:Route110.ImagineSeeingYouHere	{'body': 'PROF. BIRCH: Oh, {PLAYER}{KUN}!\\nImagine seeing you here!\\pAnd where might my {RIVAL} be?$'}
text:Route110.HeardYouInstallMatchCall	{'body': "Oh, I see!\\nYou two are running separately.\\lWell, that's fine.\\pOh, yes, I heard that your POKéNAV\\nhad the MATCH CALL system installed.\\pWell, then, I should register you in\\nmy POKéNAV as well.\\pThat way, even when we're apart,\\nI can rate your POKéDEX anytime.\\p… … … … … …$"}
text:Route110.RegisteredBirchInPokenav	{'body': 'Registered PROF. BIRCH\\nin the POKéNAV.$'}
text:Route110.KeepAnEyeOutForRival	{'body': 'PROF. BIRCH: {PLAYER}{KUN}…\\pPlease keep an eye out for my {RIVAL}.\\n… … … … … …\\pWell, I had better get going.\\nSee you again, {PLAYER}{KUN}!$'}
text:Route110.DALE_LocalConversation	{'body': 'OCTILLERY has eight arms.\\nStill only holds one fishing rod.$'}
text:Route110_SeasideCyclingRoadNorthEntrance.GoAllOutOnCyclingRoad	{'body': "On CYCLING ROAD, you can go all out\\nand cycle as fast as you'd like.\\pIt feels great to go that fast, but try\\nnot to crash into anyone!$"}
text:Route110_SeasideCyclingRoadNorthEntrance.TooDangerousToWalk	{'body': "Sorry, you can't walk on CYCLING\\nROAD. It's too dangerous.\\pPlease come back with a BIKE.$"}
text:Route110_SeasideCyclingRoadSouthEntrance.GoAllOutOnCyclingRoad	{'body': "On CYCLING ROAD, you can go all out\\nand cycle as fast as you'd like.\\pIt feels great to go that fast, but try\\nnot to crash into anyone!$"}
text:Route110_SeasideCyclingRoadSouthEntrance.TooDangerousToWalk	{'body': "Sorry, you can't walk on CYCLING\\nROAD. It's too dangerous.\\pPlease come back with a BIKE.$"}
text:Route110_TrickHouseEnd.YouveMadeItToMe	{'body': "Aak!\\nYou've made it to me?\\lHmmm… You're sharp!$"}
text:Route110_TrickHouseEnd.AllNightToPlantTrees	{'body': "It took me all night to plant all those\\ntrees…\\pYou're almost my equal in greatness by\\none, two, three, four, five, six places!$"}
text:Route110_TrickHouseEnd.AllNightToMakeMaze	{'body': "It took me all night to make the maze…\\pYou're almost my equal in greatness by\\none, two, three, four, five places!$"}
text:Route110_TrickHouseEnd.AllNightToPreparePanels	{'body': "It took me all night to prepare\\nthe wall panels…\\pYou're almost my equal in greatness by\\none, two, three, four places!$"}
text:Route110_TrickHouseEnd.AllNightToShoveBoulders	{'body': "It took me all night to shove in those\\nboulders…\\pYou're almost my equal in greatness by\\none, two, three places!$"}
text:Route110_TrickHouseEnd.AllNightToMakeMechadolls	{'body': "It took me all night to make MECHADOLLS\\nand another to think up the quiz…\\pYou're almost my equal in greatness by\\none, two places!$"}
text:Route110_TrickHouseEnd.AllNightToInstallDoors	{'body': "It took me all night to install\\nthe doors…\\pYou're almost my equal in greatness!$"}
text:Route110_TrickHouseEnd.AllNightSettingUpArrows	{'body': "It took me all night setting up arrows…\\pYou're my equal in greatness!$"}
text:Route110_TrickHouseEnd.AllNightPolishingFloors	{'body': "It took me all night polishing floors…\\pYou're above me in greatness!\\nPossibly…$"}
text:Route110_TrickHouseEnd.FountainOfIdeasRunDry	{'body': 'Wh-what should I do?\\nMy fountain of ideas for tricks has\\lrun dry…\\pPerhaps it is time I toured the country\\non a quest to devise new tricks…$'}
text:Route110_TrickHouseEnd.DefeatedMePreferWhichTent	{'body': 'I hate to admit defeat, but you have\\nbested me!\\pStill, you must have been reeled in by\\nmy charisma for you to visit me again\\land again. Yes, you must have!\\pBut that has nothing to do with my\\nlosing!\\pIn recognition of the friendship\\nbetween you, the driven, and the genius\\lthat is myself, I demand that you take\\lthis keepsake!\\pActually there are two--\\na RED TENT and a BLUE TENT.\\lWhich do you prefer?$'}
text:Route110_TrickHouseEnd.NoRoomInPC	{'body': 'What? No room in your PC?\\nWhat am I to make of that?\\pI wish I could say that, but I am much\\ntoo kind and caring, so come back later!$'}
text:Route110_TrickHouseEnd.LeavingOnJourney	{'body': '… … … … … …\\pI am leaving on a journey of discovery.\\nA quest in search of new tricks.\\pI wish that you will one day visit and\\nentertain me again.\\pAnd now, farewell!$'}
text:Route110_TrickHouseEnd.YouHaveEarnedThisReward	{'body': 'Fine!\\nYou have earned this reward!$'}
text:Route110_TrickHouseEnd.NoRoomForThis	{'body': "What? Have you no room for this?\\nWhat manner of items do you carry?\\pBut fine, since you've reached me,\\nyour reward will be with me till later.$"}
text:Route110_TrickHouseEnd.MakeNewTricksToStumpYou	{'body': "Scrub that smug smirk from your face!\\nIt's much too early to think you've won!\\pI'll make new tricks to stump you, I will.\\nYou may mock me only when you're done.\\pCome back for the next exciting\\ninstallment!$"}
text:Route110_TrickHouseEnd.YoureIgnoringMe	{'body': "Now, now! You're ignoring me now?\\nNow that, I consider heartbreaking!$"}
text:Route110_TrickHouseEnd.FinalPrizeMegaStone	{'body': 'And one more thing! A true master of\\ntricks deserves a master of the mind.$'}
text:Route110_TrickHouseEntrance.YoureBeingWatched	{'body': "You're being watched…$"}
text:Route110_TrickHouseEntrance.ConcealedBeneathDesk	{'body': "Hah? Grrr…\\pHow did you know I concealed myself\\nbeneath this desk? You're sharp!$"}
text:Route110_TrickHouseEntrance.ConcealedBehindTree	{'body': "Hah? Grrr…\\pHow did you know I concealed myself\\nbehind this tree? You're sharp!$"}
text:Route110_TrickHouseEntrance.ConcealedInDresser	{'body': "Hah? Grrr…\\pHow did you know I concealed myself\\nin this dresser? You're sharp!$"}
text:Route110_TrickHouseEntrance.ConealedBeyondWindow	{'body': "Hah? Grrr…\\pHow did you know I concealed myself\\nbeyond this window? You're sharp!$"}
text:Route110_TrickHouseEntrance.ConcealedInPlanter	{'body': "Hah? Grrr…\\pHow did you know I concealed myself\\nin this planter? You're sharp!$"}
text:Route110_TrickHouseEntrance.ConcealedInCupboard	{'body': "Hah? Grrr…\\pHow did you know I concealed myself\\nin this cupboard? You're sharp!$"}
text:Route110_TrickHouseEntrance.ConcealedBehindWindow	{'body': "Hah? Grrr…\\pHow did you know I concealed myself\\nbehind this window? You're sharp!$"}
text:Route110_TrickHouseEntrance.ConcealedBeneathCushion	{'body': "Hah? Grrr…\\pHow did you know I concealed myself\\nbeneath this cushion? You're sharp!$"}
text:Route110_TrickHouseEntrance.TheyCallMeTrickMaster	{'body': 'Behold!\\pFor I am the greatest living mystery\\nof a man in all of HOENN!\\lThey call me…\\pThe TRICK MASTER!\\nWahahaha! Glad to meet you!$'}
text:Route110_TrickHouseEntrance.ComeToChallengeTrickHouse	{'body': "You, you've come to challenge\\nmy TRICK HOUSE, haven't you?\\pThat's why you're here, isn't it?\\nYes, it is!\\pConsider your challenge accepted!\\pEnter through the scroll there,\\nand let your challenge commence!\\pI shall be waiting in the back!$"}
text:Route110_TrickHouseEntrance.ItsAScroll	{'body': "It's a scroll.$"}
text:Route110_TrickHouseEntrance.GoInHoleBehindScroll	{'body': 'There is a big hole behind the scroll!\\pWant to go in?$'}
text:Route110_TrickHouseEntrance.LeavingOnJourneyNote	{'body': "There is a note affixed to the scroll…\\p“I am leaving on a journey.\\nDon't look for me. TRICK MASTER”$"}
text:Route110_TrickHouseEntrance.NextTimeUseThisTrick	{'body': "For the next time, I'll use this trick,\\nand that scheme, and those ruses…\\pMufufufu… If I may say so, it's\\nbrilliantly difficult, even for me!$"}
text:Route110_TrickHouseEntrance.InMidstOfDevisingNewChallenges	{'body': "Hah? What?!\\nOh, it's you!\\pI'm in the midst of devising new tricky\\nchallenges!\\pIt's not too much to ask for a bit more\\ntime for me to think, is it now?\\lYou wouldn't begrudge me that?\\lCome back in a little while!$"}
text:Route110_TrickHouseEntrance.YoureHereToAcceptReward	{'body': "Ah, it's you! You're here to accept the\\nreward from before, isn't that right?\\lYes, right I am!\\pHere!\\nI'll give it to you now!$"}
text:Route110_TrickHouseEntrance.DidYouNotComeToClaimReward	{'body': 'Hah?\\nDid you not come to claim your reward?$'}
text:Route110_TrickHouseEntrance.MechadollWhichTent	{'body': 'MECHADOLL 5 I AM!\\nIF REWARD IS NOT TAKEN BY YOU,\\lTHEN TRICK MASTER YOU CANNOT FOLLOW.\\pRED TENT OR BLUE TENT,\\nWHICH DO YOU PREFER?$'}
text:Route110_TrickHouseEntrance.ThenFarewell	{'body': 'THEN FAREWELL.$'}
text:Route110_TrickHouseEntrance.PCFullAgain	{'body': 'YOUR PC STATUS: FULL AGAIN.\\nMEAN, YOU ARE.$'}
text:Route110_TrickHousePuzzle_FoundAScroll	{'body': '{PLAYER} found a scroll.$'}
text:Route110_TrickHousePuzzle_MemorizedSecretCode	{'body': '{PLAYER} memorized the secret code\\nwritten on the scroll.$'}
text:Route110_TrickHousePuzzle_SecretCodeWrittenOnIt	{'body': 'A secret code is written on it.$'}
text:Route110_TrickHouseEntrance.DoorLockedWriteSecretCodeHere	{'body': 'The door is locked.\\p…On closer inspection, this is written\\non it: “Write the secret code here.”$'}
text:Route110_TrickHouseEntrance.FinalRewardsPending	{'body': 'YOUR FINAL REWARDS ARE RECORDED.\\pTHE TENT AND ALAKAZITE ARE\\nSEPARATE GIFTS. MAKE ROOM FOR ANY\\lPART STILL WAITING HERE.$'}
text:Route110_TrickHousePuzzle1.WroteSecretCodeLockOpened	{'body': '{PLAYER} wrote down the secret code\\non the door.\\p“TRICK MASTER is fabulous.”\\n… … … … … … … …\\pThe lock clicked open!$'}
text:Route110_TrickHousePuzzle1.SallyIntro	{'body': "I've cut a path through every shrub!\\nNow let's see if I can cut through\\lyour defenses!$"}
text:Route110_TrickHousePuzzle1.SallyDefeat	{'body': 'Why are you so serious?$'}
text:Route110_TrickHousePuzzle1.SallyPostBattle	{'body': 'I never get tired of hacking\\nand slashing!$'}
text:Route110_TrickHousePuzzle1.EddieIntro	{'body': 'I wandered into this weird house\\nby accident…$'}
text:Route110_TrickHousePuzzle1.EddieDefeat	{'body': "And now I've lost…$"}
text:Route110_TrickHousePuzzle1.EddiePostBattle	{'body': "I lost my way, I lost a battle, and I'm\\nnow even more lost… I can't get out…$"}
text:Route110_TrickHousePuzzle1.RobinIntro	{'body': 'Just who is the TRICK MASTER?$'}
text:Route110_TrickHousePuzzle1.RobinDefeat	{'body': 'I lost while I was lost in thought!$'}
text:Route110_TrickHousePuzzle1.RobinPostBattle	{'body': "You're strong!\\nJust who are you?$"}
text:Route110_TrickHousePuzzle2.WroteSecretCodeLockOpened	{'body': '{PLAYER} wrote down the secret code\\non the door.\\p“TRICK MASTER is smart.”\\n… … … … … … … …\\pThe lock clicked open!$'}
text:Route110_TrickHousePuzzle2.TedIntro	{'body': 'Which switch closes which hole?$'}
text:Route110_TrickHousePuzzle2.TedDefeat	{'body': "After that battle, I'm even more\\nconfused!$"}
text:Route110_TrickHousePuzzle2.TedPostBattle	{'body': 'Can I get you to push all the buttons\\nfor me?$'}
text:Route110_TrickHousePuzzle2.PaulIntro	{'body': "Oh! You're on your second TRICK HOUSE\\nchallenge!$"}
text:Route110_TrickHousePuzzle2.PaulDefeat	{'body': "You're good at battling too?$"}
text:Route110_TrickHousePuzzle2.PaulPostBattle	{'body': 'The TRICK MASTER rigged all the tricks\\nin this house all by himself.$'}
text:Route110_TrickHousePuzzle2.GeorgiaIntro	{'body': "I want to make my own GYM one day.\\nSo, I'm studying how to set traps.$"}
text:Route110_TrickHousePuzzle2.GeorgiaDefeat	{'body': "I didn't study battling enough!$"}
text:Route110_TrickHousePuzzle2.GeorgiaPostBattle	{'body': "You're strong, aren't you?\\nMaybe even enough to be a GYM LEADER!$"}
text:Route110_TrickHousePuzzle3.WroteSecretCodeLockOpened	{'body': '{PLAYER} wrote down the secret code\\non the door.\\p“TRICK MASTER is coveted.”\\n… … … … … … … …\\pThe lock clicked open!$'}
text:Route110_TrickHousePuzzle3.JustinIntro	{'body': 'I keep coming back to this same place!$'}
text:Route110_TrickHousePuzzle3.JustinDefeat	{'body': "I'm already having trouble, and then\\nyou have to beat me? It's not fair!$"}
text:Route110_TrickHousePuzzle3.JustinPostBattle	{'body': "It's full of doors here!\\nIt's too small and dark in here! Help!$"}
text:Route110_TrickHousePuzzle3.MarthaIntro	{'body': "I don't know what's going on here.\\nI'm starting to feel sad…$"}
text:Route110_TrickHousePuzzle3.MarthaDefeat	{'body': "You… You're awful!$"}
text:Route110_TrickHousePuzzle3.MarthaPostBattle	{'body': "I know I'm weak!\\nAnd, I have no sense of direction!$"}
text:Route110_TrickHousePuzzle3.AlanIntro	{'body': "I don't get it. What would anyone want\\nwith a house this bizarre?$"}
text:Route110_TrickHousePuzzle3.AlanDefeat	{'body': "I don't get it.\\nHow did I lose?$"}
text:Route110_TrickHousePuzzle3.AlanPostBattle	{'body': "I don't get it.\\nHow many traps are in this house?\\pYou may be the one to solve that.$"}
text:Route110_TrickHousePuzzle4.WroteSecretCodeLockOpened	{'body': '{PLAYER} wrote down the secret code\\non the door.\\p“TRICK MASTER is cool.”\\n… … … … … … … …\\pThe lock clicked open!$'}
text:Route110_TrickHousePuzzle4.CoraIntro	{'body': "It's too much bother to think this out.\\nI only wanted to battle!$"}
text:Route110_TrickHousePuzzle4.CoraDefeat	{'body': 'Even though I lost, I still like battling\\nthe best!$'}
text:Route110_TrickHousePuzzle4.CoraPostBattle	{'body': "Wouldn't you agree? You would go\\nanywhere if TRAINERS were there.$"}
text:Route110_TrickHousePuzzle4.YujiIntro	{'body': 'Heh! Boulders like this, I can brush\\naside with one finger!$'}
text:Route110_TrickHousePuzzle4.YujiDefeat	{'body': "I can push boulders, but I can't solve\\nthe puzzle…$"}
text:Route110_TrickHousePuzzle4.YujiPostBattle	{'body': "It's not good enough to be brawny…\\nYou have to use your head. Be brainy!$"}
text:Route110_TrickHousePuzzle4.PaulaIntro	{'body': "The TRICK HOUSE is getting trickier,\\nisn't it?$"}
text:Route110_TrickHousePuzzle4.PaulaDefeat	{'body': 'Aaak!$'}
text:Route110_TrickHousePuzzle4.PaulaPostBattle	{'body': 'Has anyone made it to the end?$'}
text:Route110_TrickHousePuzzle5.WroteSecretCodeLockOpened	{'body': '{PLAYER} wrote down the secret code\\non the door.\\p“TRICK MASTER is a genius.”\\n… … … … … … … …\\pThe lock clicked open!$'}
text:Route110_TrickHousePuzzle5.Mechadoll1Intro	{'body': 'CLICKETY-CLACK…\\nMECHADOLL 1 AM I!\\pIF YOU ANSWER QUIZZES CORRECTLY,\\nTHEN YOU WILL GO TO MECHADOLL 5.\\lTHEN YOU CAN OBTAIN THE SECRET CODE.$'}
text:Route110_TrickHousePuzzle5.Mechadoll1Quiz1	{'body': 'MECHADOLL 1 QUIZ.\\pWhich move guards your side\\nagainst opposing priority moves?$'}
text:Route110_TrickHousePuzzle5.Mechadoll1Quiz2	{'body': 'MECHADOLL 1 QUIZ.\\pWhich type normally ignores RAGE\\nPOWDER when choosing a target?$'}
text:Route110_TrickHousePuzzle5.Mechadoll1Quiz3	{'body': 'MECHADOLL 1 QUIZ.\\pWhich move normally hits both\\nopponents instead of being\\lredirected by FOLLOW ME?$'}
text:Route110_TrickHousePuzzle5.CorrectGoThrough	{'body': 'CONGRATULATIONS. CORRECT YOU ARE.\\nGO THROUGH. PLEASE.$'}
text:Route110_TrickHousePuzzle5.DisappointmentError	{'body': 'BZZZT. DISAPPOINTMENT.\\nERROR.$'}
text:Route110_TrickHousePuzzle5.Wahahahaha	{'body': 'WAHAHAHAHA! WAHAHAHAHA!\\nCLICKETY-CLACK!$'}
text:Route110_TrickHousePuzzle5.WaitForNextChallenge	{'body': 'YOUR NEXT CHALLENGE WE WAIT FOR.$'}
text:Route110_TrickHousePuzzle5.Mechadoll2Intro	{'body': "CLICKETY-CLACK…\\nMECHADOLL 2 AM I!\\pMECHADOLL 1'S QUIZ DIFFICULTY LEVEL\\nIS SET TOO LOW.$"}
text:Route110_TrickHousePuzzle5.Mechadoll2Quiz1	{'body': 'MECHADOLL 2 QUIZ.\\pTRICK ROOM reverses Speed order\\nwithin which boundary?$'}
text:Route110_TrickHousePuzzle5.Mechadoll2Quiz2	{'body': 'MECHADOLL 2 QUIZ.\\pWhen can a Pokémon normally use\\nFAKE OUT successfully?$'}
text:Route110_TrickHousePuzzle5.Mechadoll2Quiz3	{'body': 'MECHADOLL 2 QUIZ.\\pTAUNT prevents the target from\\nchoosing which moves?$'}
text:Route110_TrickHousePuzzle5.Mechadoll3Intro	{'body': 'CLICKETY-CLACK... MECHADOLL 3 AM I!\\pSUPPORT, STATUS, AND HELD ITEMS!\\nSMALL DETAILS, LARGE CONSEQUENCES!$'}
text:Route110_TrickHousePuzzle5.Mechadoll3Quiz1	{'body': 'MECHADOLL 3 QUIZ.\\pWhich status reduces physical\\ndamage for most attackers?$'}
text:Route110_TrickHousePuzzle5.Mechadoll3Quiz2	{'body': "MECHADOLL 3 QUIZ.\\pWhich move boosts an ally's attack\\ndamage for the current turn?$"}
text:Route110_TrickHousePuzzle5.Mechadoll3Quiz3	{'body': "MECHADOLL 3 QUIZ.\\pWhich Pokémon can receive\\nEVIOLITE's defensive benefit?$"}
text:Route110_TrickHousePuzzle5.Mechadoll4Intro	{'body': 'CLICKETY-CLACK…\\nMECHADOLL 4 THAT IS ME!\\pMY QUIZ IS AN OBJECT OF BEAUTY.$'}
text:Route110_TrickHousePuzzle5.Mechadoll4Quiz1	{'body': 'MECHADOLL 4 QUIZ.\\pWhich held item can remove TAUNT\\nfrom its holder?$'}
text:Route110_TrickHousePuzzle5.Mechadoll4Quiz2	{'body': 'MECHADOLL 4 QUIZ.\\pWhich Ability redirects\\nsingle-target WATER moves?$'}
text:Route110_TrickHousePuzzle5.Mechadoll4Quiz3	{'body': 'MECHADOLL 4 QUIZ.\\pWhich opposing target does PSYCHIC\\nTERRAIN protect from FAKE OUT?$'}
text:Route110_TrickHousePuzzle5.Mechadoll5Intro	{'body': "CLICKETY-CLACK…\\nMECHADOLL 5 AM I!\\pTHE MASTER'S BEST AND PROUDEST\\nACHIEVEMENT AM I.$"}
text:Route110_TrickHousePuzzle5.Mechadoll5Quiz1	{'body': "MECHADOLL 5 QUIZ.\\pYou switch out while TRICK ROOM is\\nactive. What happens to the room's\\ltimer?$"}
text:Route110_TrickHousePuzzle5.Mechadoll5Quiz2	{'body': 'MECHADOLL 5 QUIZ.\\pWhich move guards your side\\nagainst most damaging moves that\\lhit multiple targets?$'}
text:Route110_TrickHousePuzzle5.Mechadoll5Quiz3	{'body': 'MECHADOLL 5 QUIZ.\\pPRANKSTER-boosted TAUNT normally\\nfails against an opposing Pokémon\\lof which type?$'}
text:Route110_TrickHousePuzzle6.WroteSecretCodeLockOpened	{'body': '{PLAYER} wrote down the secret code\\non the door.\\p“TRICK MASTER is my life.”\\n… … … … … … … …\\pThe lock clicked open!$'}
text:Route110_TrickHousePuzzle6.SophiaIntro	{'body': 'When I heard there was a strange\\nhouse, I had to check it out.$'}
text:Route110_TrickHousePuzzle6.SophiaDefeat	{'body': "I've discovered a tough TRAINER!$"}
text:Route110_TrickHousePuzzle6.SophiaPostBattle	{'body': "I'm sure having a good time checking\\nthis place out.\\pIt's a challenge I've found worth\\nrepeating!$"}
text:Route110_TrickHousePuzzle6.BennyIntro	{'body': 'Maybe I could get my BIRD POKéMON\\nto fly over the wall…$'}
text:Route110_TrickHousePuzzle6.BennyDefeat	{'body': 'Gwaaah! I blew it!$'}
text:Route110_TrickHousePuzzle6.BennyPostBattle	{'body': 'Ehehehe… I guess I lost because\\nI was trying to cheat.$'}
text:Route110_TrickHousePuzzle6.SebastianIntro	{'body': "I'm getting dizzy from these rotating\\ndoors…$"}
text:Route110_TrickHousePuzzle6.SebastianDefeat	{'body': "Everything's spinning around and\\naround. I can't take this anymore…$"}
text:Route110_TrickHousePuzzle6.SebastianPostBattle	{'body': "You don't seem to be affected at all.\\nOr do you have your poker face on?$"}
text:Route110_TrickHousePuzzle7.WroteSecretCodeLockOpened	{'body': '{PLAYER} wrote down the secret code\\non the door.\\p“TRICK MASTER is huggable.”\\n… … … … … … … …\\pThe lock clicked open!$'}
text:Route110_TrickHousePuzzle7.JoshuaIntro	{'body': 'The TRICK MASTER always vanishes\\nlike smoke. How does he do it?$'}
text:Route110_TrickHousePuzzle7.JoshuaDefeat	{'body': "Aiyeeeh! You're much too strong!\\nHow do you do it?$"}
text:Route110_TrickHousePuzzle7.JoshuaPostBattle	{'body': 'I wish I could appear and disappear as\\nif I were smoke, too.$'}
text:Route110_TrickHousePuzzle7.PatriciaIntro	{'body': 'Going around the same spot…\\nIt begets ill fortune…$'}
text:Route110_TrickHousePuzzle7.PatriciaDefeat	{'body': "Defeated!\\nIt's a bad sign…$"}
text:Route110_TrickHousePuzzle7.PatriciaPostBattle	{'body': "I've circled the same spot over ten\\ntimes now… It's ill fortune…$"}
text:Route110_TrickHousePuzzle7.AlexisIntro	{'body': "Whoever wins will get through here\\nfirst. That's the feeling I get.$"}
text:Route110_TrickHousePuzzle7.AlexisDefeat	{'body': 'Oh!\\nWell, go ahead, then!$'}
text:Route110_TrickHousePuzzle7.AlexisPostBattle	{'body': "You're solving all the puzzles in the\\nTRICK HOUSE. That's the feeling I get.$"}
text:Route110_TrickHousePuzzle7.MarielaIntro	{'body': "Nufufufu, here at last!\\nLet's get right with it!$"}
text:Route110_TrickHousePuzzle7.MarielaDefeat	{'body': "You're so casual about winning!$"}
text:Route110_TrickHousePuzzle7.MarielaPostBattle	{'body': "Humph! I'm not upset!\\nNot me!$"}
text:Route110_TrickHousePuzzle7.AlvaroIntro	{'body': 'I ever so closely watched you coming!$'}
text:Route110_TrickHousePuzzle7.AlvaroDefeat	{'body': "This outcome I didn't see coming…$"}
text:Route110_TrickHousePuzzle7.AlvaroPostBattle	{'body': "Well, anyway, we both picked a weird\\nplace to get acquainted.\\pAs one weirdo to another,\\nlet's do our best!$"}
text:Route110_TrickHousePuzzle7.EverettIntro	{'body': "It's awfully cramped in here…$"}
text:Route110_TrickHousePuzzle7.EverettDefeat	{'body': 'Oh, yes, strong you are.$'}
text:Route110_TrickHousePuzzle7.EverettPostBattle	{'body': 'I was hoping to switch places with you\\nwhen I beat you, but…$'}
text:Route110_TrickHousePuzzle8.WroteSecretCodeLockOpened	{'body': '{PLAYER} wrote down the secret code\\non the door.\\p“TRICK MASTER I love.”\\n… … … … … … … …\\pThe lock clicked open!$'}
text:Route110_TrickHousePuzzle8.VincentIntro	{'body': 'Not many TRAINERS have made it\\nthis far.$'}
text:Route110_TrickHousePuzzle8.VincentDefeat	{'body': "That must mean you're tough, too…$"}
text:Route110_TrickHousePuzzle8.VincentPostBattle	{'body': "You've beaten the POKéMON LEAGUE\\nCHAMPION? That's too much!$"}
text:Route110_TrickHousePuzzle8.KeiraIntro	{'body': 'Consider yourself lucky to be\\nbattling me!$'}
text:Route110_TrickHousePuzzle8.KeiraDefeat	{'body': "This isn't right!\\nI can't lose!$"}
text:Route110_TrickHousePuzzle8.KeiraPostBattle	{'body': "It's a miracle that you beat me.\\nYou can brag about it.$"}
text:Route110_TrickHousePuzzle8.LeroyIntro	{'body': "You've been slugging through the TRICK\\nHOUSE challenge, too.$"}
text:Route110_TrickHousePuzzle8.LeroyDefeat	{'body': 'I see…\\nYou possess an extraordinary style.$'}
text:Route110_TrickHousePuzzle8.LeroyPostBattle	{'body': 'Seeing someone like you should please\\nthe TRICK MASTER.$'}
text:Route111.VialBlobGetBackHere	{'body': 'Blob! Stop goofing around and get back\\nhere! How did you get over there?$'}
text:Route111.VialNurseNeedsHelp	{'body': "Oh, no! My CHANSEY ran north!\\pPlease bring Blob back. I'll improve\\nyour Poké Vial's capacity as thanks.$"}
text:Route111.VialHealBall	{'body': 'Blob trusts this HEAL BALL.\\nFollow the trail north and use it.$'}
text:Route111.VialNurseWatching	{'body': 'Blob and I help travelers here.\\nCHANSEY can be rather playful.$'}
text:Route111.VialReplacementBall	{'body': 'You lost the HEAL BALL? Take another.\\nBlob will recognize it.$'}
text:Route111.VialBringBlobBack	{'body': 'Follow ROUTE 111 north to ROUTE 112.\\nPlease bring my CHANSEY home!$'}
text:Route111.VialNurseJaggedPass	{'body': 'Blob climbed toward JAGGED PASS.\\nTry the slope below MT. CHIMNEY.$'}
text:Route111.VialNurseAshenWoods	{'body': 'Take EMBER PATH off JAGGED PASS.\\nBlob ran into ASHEN WOODS beyond.$'}
text:Route111.VialThanks	{'body': 'You caught Blob! Thank you!\\pPoké Centers will now refill your\\nPoké Vial with two full charges.$'}
text:Route111.BattleOurFamily	{'body': "Hello! I take it you're a traveler.\\pHow's this? What do you say to taking\\non our family of four in a series of\\lPOKéMON battles?$"}
text:Route111.IsThatSo	{'body': 'Is that so?\\nDrop in, if you change your mind!$'}
text:Route111.VictorIntro	{'body': "That's the spirit! I like you!$"}
text:Route111.VictorDefeat	{'body': "Aiyah!\\nYou're a lot tougher than I expected!$"}
text:Route111.VictorPostBattle	{'body': "Hey, all!\\nI've found a pretty strong TRAINER!$"}
text:Route111.VictoriaIntro	{'body': "Oh, my goodness! Aren't you young?\\pYou must be quite the TRAINER to beat\\nmy husband, though.\\pIt's my turn to battle now!$"}
text:Route111.VictoriaDefeat	{'body': "Oh, gosh!\\nI can't get over how strong you are!$"}
text:Route111.VictoriaPostBattle	{'body': "There's a strong TRAINER here!\\nThis one's really strong!$"}
text:Route111.ViviIntro	{'body': "You're stronger than Mommy? Wow!\\pBut I'm strong, too!\\nReally! Honestly!$"}
text:Route111.ViviDefeat	{'body': 'Huh? Did I just lose?$'}
text:Route111.ViviPostBattle	{'body': 'This stinks…\\p…Snivel… Grandma!$'}
text:Route111.VickyIntro	{'body': "How dare you make my granddaughter\\ncry!\\pFor that, I'm going to smack you!\\nPrepare to lose!$"}
text:Route111.VickyDefeat	{'body': 'Kwah! You are strong…\\nMy granddaughter was right…$'}
text:Route111.VickyPostBattle	{'body': "If you're not in any hurry,\\nvisit with us awhile.$"}
text:Route111.ToughToKeepWinningUpTheRanks	{'body': "If you don't raise your POKéMON some\\nmore, it could be tough to keep winning\\lup through the ranks.\\pI've heard the POKéMON LEAGUE's\\nELITE FOUR are far stronger than\\lany GYM LEADER.$"}
text:Route111.WinstrateFamilyDestroyedMe	{'body': 'I challenged the WINSTRATE family,\\nbut four matches in a row is tough\\lgoing… They destroyed me.$'}
text:Route111.RouteSignMauville	{'body': 'ROUTE 111\\n{DOWN_ARROW} MAUVILLE CITY$'}
text:Route111.WinstrateHouseSign	{'body': "“Our family's hearts beat as one!”\\nTHE WINSTRATE'S HOUSE$"}
text:Route111.RouteSign112	{'body': 'ROUTE 111\\n{LEFT_ARROW} ROUTE 112$'}
text:Route111.RouteSign113	{'body': 'ROUTE 111\\n{LEFT_ARROW} ROUTE 113$'}
text:Route111.OldLadysRestStopSign	{'body': "OLD LADY'S REST STOP\\n“Come in and rest your tired bones.”$"}
text:Route111.TrainerTipsSpAtkSpDef	{'body': 'TRAINER TIPS\\pSP. ATK means SPECIAL ATTACK. It\\ndetermines the power of special\\lmoves.\\pSP. DEF means SPECIAL DEFENSE. It\\nhelps a POKéMON withstand them.$'}
text:Route111.ShouldBeMirageTowerAroundHere	{'body': "There should be a tower made of sand\\naround here somewhere.\\pBut for some reason, it can be seen\\nsometimes, and sometimes not.\\pThat's why I call it the MIRAGE TOWER.$"}
text:Route111.MirageTowerClearlyVisible	{'body': 'The MIRAGE TOWER is visible!\\nBeneath its first floor lies an\\lolder stairway.\\pArchaeologists say it reaches a\\nfossil archive called SANDSTREWN\\lRUINS.$'}
text:Route111.ThatWasShockingSandRainedDown	{'body': 'The tower collapsed, but its\\nbasement passage may still meet\\lDESERT UNDERPASS.\\pThat route leads into SANDSTREWN\\nRUINS.$'}
text:Route111.MirageTowerHasntBeenSeenSince	{'body': "MIRAGE TOWER is gone, but the\\nruins below remain. FOSSIL\\lMANIAC's tunnel on ROUTE 114 now\\lreaches DESERT UNDERPASS.$"}
text:Route111.ClawFossilDisappeared	{'body': 'The CLAW FOSSIL disappeared into\\nthe sand…$'}
text:Route111.RootFossilDisappeared	{'body': 'The ROOT FOSSIL disappeared into\\nthe sand…$'}
text:Route111.MauvilleUncleToldMeToTakeRockSmash	{'body': 'Oh, no!\\pMy uncle in MAUVILLE told me to take\\nROCK SMASH with me if I was going to\\lROUTE 111!\\pMy uncle? He lives across from\\nthe bike shop in MAUVILLE.$'}
text:Route111.TrainerHillSign	{'body': '{RIGHT_ARROW} TRAINER HILL ENTRANCE\\p“Scale the heights, you hot-blooded\\nTRAINERS!”$'}
text:Route111.DynamoGuardClosed	{'body': "The trail north is closed for now.\\nThe power lines up to LAVARIDGE went\\ldown in the last storm.\\pWATTSON's crew is rewiring the route.\\nOnce his GYM certifies you with the\\lDYNAMO BADGE, you're cleared to pass.$"}
text:Route111.DynamoGuardTrigger	{'body': "Hey! Not past the rope. Storm\\ndamage has made the northern trail\\lunsafe.\\pYou'll need WATTSON's DYNAMO BADGE\\nbefore I can let you through.$"}
text:Route111.IRENE_LocalConversation	{'body': 'A picnic needs three things:\\nFood, shade, and less SANDSTORM.$'}
text:Route111.BECKY_LocalConversation	{'body': 'I came to admire the desert.\\nThe desert came into my shoes.$'}
text:Route111.CursedStoneClue	{'body': "That carved stone just east of me\\nmatches a Galarian YAMASK's slab.\\pRead it with a conscious Galarian\\nYAMASK missing at least 49 HP from\\lits maximum. It becomes RUNERIGUS.\\pYou can return to the stone even after\\nMIRAGE TOWER disappears.$"}
text:Route111.CursedStone	{'body': 'A curse is carved into this stone.\\pEach conscious Galarian YAMASK in your\\nparty that is missing at least 49 HP\\lcan become RUNERIGUS here.\\pLet the stone call to your party?$'}
text:Route111.CursedStoneUnchanged	{'body': 'The stone falls silent. Bring a\\nconscious Galarian YAMASK missing\\lat least 49 HP, without an EVERSTONE.$'}
text:Route111_OldLadysRestStop.RestUpHere	{'body': "Oh, dear, dear.\\nAren't your POKéMON exhausted?\\pIf you'd like, rest up here.\\nThat's a fine idea! You should do that.$"}
text:Route111_OldLadysRestStop.TakeYourTimeRestUp	{'body': "That's right.\\nTake your time and rest up!$"}
text:Route111_OldLadysRestStop.StillTiredTakeAnotherRest	{'body': "Oh, dear, dear.\\nAre your POKéMON still tired?\\pYou should take another rest here.\\nThat's a fine idea. You should do that.$"}
text:Route111_OldLadysRestStop.DontNeedToBeShy	{'body': "Is that so?\\nYou don't need to be shy about it.$"}
text:Route111_RuinsExterior.Archaeologist_Helped	{'body': 'CASTFORM helps record the weather.\\nThe wind settles over the ruins.$'}
text:Route111_RuinsExterior.Archaeologist	{'body': 'The storms leave strange patterns\\nacross these ruins. LANDORUS may\\lbe sheltering here.\\pWith the BALANCE BADGE, bring\\nCASTFORM and help me survey the\\lweather.\\pThen LANDORUS can appear among\\nthe wild POKéMON here. Our work\\lonly needs doing once.$'}
text:Route111_WinstrateFamilysHouse.MySonIsStrongerThanYou	{'body': "You're the first TRAINER I've seen who\\ndeploys POKéMON so masterfully.\\pBut, I should tell you--my son is\\nstronger than you.\\pHe even took the POKéMON LEAGUE\\nchallenge, I'll have you know.$"}
text:Route111_WinstrateFamilysHouse.LikeYouToHaveBerries	{'body': "You defeated all four of us without\\na chance to rest. That's remarkable!\\pTake these berries from our garden.\\nYou have earned a little harvest.$"}
text:Route111_WinstrateFamilysHouse.PassionateAboutBattles	{'body': 'Plant those berries or save them for\\nthe BERRY MASTER on ROUTE 123.$'}
text:Route111_WinstrateFamilysHouse.StrongerFamilyMembers	{'body': "Mommy is stronger than Daddy.\\pI'm stronger than Mommy.\\pAnd Grandma's stronger than me!\\pBut my big brother is even stronger\\nthan Grandma.$"}
text:Route111_WinstrateFamilysHouse.GrandsonStrong	{'body': "There's no question that you're strong.\\pBut if you were to battle my grandson,\\nyou'd end up crying in frustration.\\pHe's much stronger than any TRAINER\\nour family knows.\\pHe must be challenging the POKéMON\\nLEAGUE CHAMPION by now.\\pKnowing my grandson, he could be the\\nCHAMPION already!$"}
text:Route111_WinstrateFamilysHouse.GrandsonStrongShort	{'body': 'My grandson must be challenging the\\nPOKéMON LEAGUE CHAMPION by now.\\pKnowing my grandson, he could be the\\nCHAMPION already!$'}
text:Route112.VialChanseyClimbed	{'body': 'Blob bounded toward JAGGED PASS.\\nThe trail continues up the mountain.$'}
text:Route112.LeaderGoingToAwakenThing	{'body': 'Hey, man, is our leader really going\\nto stir up the whole volcano?$'}
text:Route112.YeahWeNeedMeteorite	{'body': 'Sounds like it. I heard the machine\\nneeds a METEORITE to get it going.$'}
text:Route112.OhThatsWhyCrewWentToFallarbor	{'body': "Oh, I get it now. That's why the rest\\nof the crew went out to FALLARBOR.$"}
text:Route112.CantLetAnyonePassUntilTheyreBack	{'body': "You got it. And until they come back,\\nwe're not to let anyone pass, right.$"}
text:Route112.NotEasyToGetBackToLavaridge	{'body': "Eh, I'd like to get to MAUVILLE, but if\\nI went down these ledges, it'd be no\\leasy matter to get back to LAVARIDGE.$"}
text:Route112.MtChimneyCableCarSign	{'body': 'MT. CHIMNEY CABLE CAR\\n“A short walk {UP_ARROW} way!”$'}
text:Route112.MtChimneySign	{'body': 'MT. CHIMNEY\\pFor LAVARIDGE TOWN or the summit,\\nplease take the CABLE CAR.$'}
text:Route112.EnteiClue	{'body': 'FIELD NOTE: ENTEI lives in\\nFIERY PATH. Each wild encounter\\lthere has a 3% chance.$'}
text:Route112.RouteSignLavaridge	{'body': 'ROUTE 112\\n{LEFT_ARROW} LAVARIDGE TOWN$'}
text:Route112.CAROL_LocalConversation	{'body': 'The mountain is lovely today.\\nMy sandwich is now toast.\\pKOFFING takes to FIERY PATH better.\\nLevel it up there at Lv. 35 or higher\\lfor Galarian WEEZING.\\pOutside that cave, it evolves into\\nthe usual WEEZING.$'}
text:Route112.EnteiCaught	{'body': 'FIELD NOTE: ENTEI of FIERY PATH\\nhas been caught.$'}
text:Route112_CableCarStation.CableCarReadyGetOn	{'body': 'The CABLE CAR is ready to go up.\\nWould you like to be on it?$'}
text:Route112_CableCarStation.StepThisWay	{'body': 'Please step this way.$'}
text:Route112_CableCarStation.RideAnotherTime	{'body': 'Please ride with us another time.$'}
text:Route113.AshCanBeFashionedIntoGlass	{'body': "Wahahaha! Today's technology is a\\nwondrous thing!\\pTake this volcanic ash here.\\nIt can be fashioned into glass.$"}
text:Route113.FunWalkingThroughAsh	{'body': "PAWNIARD leave little tracks in the ash.\\nThey become BISHARP at Lv. 52.\\pLet BISHARP hold a LEADER'S CREST,\\nthen level it up for KINGAMBIT.\\lThe crest is used up when it evolves.\\pLILYCOVE's evolution department\\nsells LEADER'S CRESTS.$"}
text:Route113.RouteSign111	{'body': 'ROUTE 113\\n{RIGHT_ARROW} ROUTE 111$'}
text:Route113.RouteSignFallarbor	{'body': 'ROUTE 113\\n{LEFT_ARROW} FALLARBOR TOWN$'}
text:Route113.TrainerTipsRegisterKeyItems	{'body': 'TRAINER TIPS\\pYou may register one of the KEY ITEMS\\nin your BAG as SELECT.\\pSimply press SELECT to use\\nthe registered item conveniently.$'}
text:Route113.GlassWorkshopSign	{'body': 'GLASS WORKSHOP\\n“Turning Volcanic Ash into Glass Items”$'}
text:Route113_GlassWorkshop.GoCollectAshWithThis	{'body': "This area is covered in volcanic ash,\\nhuff-puff!\\pI'm specially gifted, huff-puff.\\pI make glass out of volcanic ash\\nand make items, huff-puff.\\pGo collect ashes with this, huff-puff.$"}
text:Route113_GlassWorkshop.ExplainSootSack	{'body': "Just take that SOOT SACK and walk\\nthrough piles of ash, huff-puff.\\pAnd it will fill up with the volcanic ash,\\nhuff-puff.\\pOnce you think you've collected a good\\namount, come see me, huff-puff.$"}
text:Route113_GlassWorkshop.LetsSeeCollectedAshes	{'body': 'Soot to spend: {STR_VAR_1}.\\nLifetime soot collected: {STR_VAR_2}.\\pGlass purchases never lower your\\nlifetime total, huff-puff!$'}
text:Route113_GlassWorkshop.NotEnoughAshNeedX	{'body': "Hmmm…\\nThere's not enough ash here, huff-puff.\\lI can't make glass with this, huff-puff.\\pLet's see… {STR_VAR_1} is the number of steps\\nyou'll need to walk for me to make you\\la BLUE FLUTE, huff-puff.$"}
text:Route113_GlassWorkshop.WhichGlassItemWoudYouLike	{'body': "Oh!\\nYou've got a lot of ashes, huff-puff!\\pI'll make you a glass item, huff-puff!\\nWhich one would you like, huff-puff?$"}
text:Route113_GlassWorkshop.IsThatTheItemForYou	{'body': 'A {STR_VAR_1} costs {STR_VAR_2} soot.\\nShall I make it, huff-puff?$'}
text:Route113_GlassWorkshop.WhichWouldYouLike	{'body': 'Which one would you like, huff-puff?$'}
text:Route113_GlassWorkshop.IllMakeItemForYou	{'body': "A {STR_VAR_1} it is, then, huff-puff!\\pOkay! I'll make it for you, huff-puff.\\nJust wait a little while, huff-puff.$"}
text:Route113_GlassWorkshop.NotEnoughAshToMakeItem	{'body': "A {STR_VAR_1}, huff-puff?\\pThere's not enough ash here to make\\nthat, though, huff-puff.\\pLet's see… {STR_VAR_2} is the number of steps\\nyou'll need to walk through volcanic ash\\lfor me to make that item, huff-puff.\\pWhich item would you rather have me\\nmake instead, huff-puff?$"}
text:Route113_GlassWorkshop.AllThatAshButDontWantAnything	{'body': "You've collected all that ash, but you\\ndon't want anything, huff-puff?$"}
text:Route113_GlassWorkshop.IveFinishedGlassItem	{'body': "Ah, I've finished your {STR_VAR_1}.\\nTake it, huff-puff.$"}
text:Route113_GlassWorkshop.NoRoomInBag	{'body': "Oh?\\nYou've no room in your BAG, huff-puff.\\pI'll hold on to it, so come back later,\\nhuff-puff.$"}
text:Route113_GlassWorkshop.NoRoomInPC	{'body': "Oh?\\nYou've no room in your PC, huff-puff?\\pI'll hold on to it, so come back later,\\nhuff-puff.$"}
text:Route113_GlassWorkshop.HaventGotYourSootSack	{'body': "Hah? You haven't got your SOOT SACK\\nwith you, huff-puff.\\pYou have to keep it with you to collect\\nvolcanic ash, huff-puff.$"}
text:Route113_GlassWorkshop.FunToBlowGlassFlute	{'body': "It's fun to blow a glass flute while\\nmy boss is talking.\\pHuff-huff! Puff-puff!$"}
text:Route113_GlassWorkshop.NextCord	{'body': "At 100 lifetime soot, I'll give you\\na reusable LINKING CORD!$"}
text:Route113_GlassWorkshop.NextMarshadow	{'body': 'At 250 lifetime soot, I can show you\\na secret in the ash grass!$'}
text:Route113_GlassWorkshop.NextMega	{'body': 'At 500 lifetime soot, a HOUNDOOMINITE\\nis yours. Keep exploring, huff-puff!$'}
text:Route113_GlassWorkshop.AllMilestones	{'body': "You've earned every collection gift!\\nI can still make glass for your soot.$"}
text:Route113_GlassWorkshop.MilestoneBag	{'body': "You've earned a {STR_VAR_1}!\\nIt's in your BAG, huff-puff.$"}
text:Route113_GlassWorkshop.MilestonePC	{'body': "You've earned a {STR_VAR_1}!\\nYour BAG is full, so it's in your PC.$"}
text:Route113_GlassWorkshop.MilestoneOwned	{'body': 'You already own a {STR_VAR_1}.\\nThat milestone is complete, huff-puff!$'}
text:Route113_GlassWorkshop.MilestoneNoRoom	{'body': 'Your collection gift is safe with me.\\nMake room in your BAG or item PC,\\lthen come back, huff-puff!$'}
text:Route113_GlassWorkshop.Marshadow	{'body': "250 soot! You've stirred up a shadow\\nthat follows the drifting ash.\\pThat's MARSHADOW! It can now appear\\nin ROUTE 113's wild grass.\\pThe route sign records this discovery.\\nOnce caught, it stops appearing here.$"}
text:Route114.GoodRodOffer	{'body': 'Different fish gather in these pools\\nat different depths. Want my GOOD ROD?$'}
text:Route114.GoodRodAdvice	{'body': 'Try your GOOD ROD along every shore.\\nYou may find POKéMON your OLD ROD\\lnever brought to the surface.$'}
text:Route114.GoodRodDeclined	{'body': 'Come back if you decide to explore\\nwhat waits below the surface.$'}
text:Route114.AllMyMonDoesIsRoarTakeThis	{'body': 'All my POKéMON does is ROAR…\\nNo one dares to come near me…\\pI found this DRAGON SCALE nearby.\\nPlease, take it off my hands.$'}
text:Route114.ExplainRoar	{'body': 'A Dragon Scale evolves Seadra.\\nUse it from the Bag when ready.$'}
text:Route114.Poochyena	{'body': 'Bow! Bowwow!$'}
text:Route114.MeteorFallsSign	{'body': 'METEOR FALLS\\nRUSTBORO CITY THROUGH HERE$'}
text:Route114.FossilManiacsHouseSign	{'body': "FOSSIL MANIAC'S HOUSE\\n“Fossils from every era studied!”$"}
text:Route114.LanettesHouse	{'body': "LANETTE'S HOUSE$"}
text:Route114.NANCY_LocalConversation	{'body': 'I packed for every weather.\\nMy bag weighs more than I do.$'}
text:Route114_FossilManiacsHouse.HaveThisToDigLikeMyBrother	{'body': 'My brother dug up this Metal Coat.\\pIt evolves Onix or Scyther when used.$'}
text:Route114_FossilManiacsHouse.DigReturnsYouToEntrance	{'body': "If you make a POKéMON DIG inside a\\ncave, you're returned to the entrance…\\pOld peat has another use: use a PEAT\\nBLOCK on URSARING at night to evolve\\lit into URSALUNA, anywhere in HOENN.\\pLILYCOVE's evolution department\\nsells PEAT BLOCKS.$"}
text:Route114_FossilManiacsHouse.RocksFillDisplayCase	{'body': 'Rocks in peculiar shapes fill\\nthe display case…$'}
text:Route114_FossilManiacsHouse.CrammedWithBooks	{'body': "THE COMPOSITION OF STRATA…\\nHOW RAIN SHAPES THE LAND…\\lSTONES, SOIL, AND ROCK…\\pIt's crammed with books.$"}
text:Route114_FossilManiacsTunnel.LookInDesertForFossils	{'body': "I'm the FOSSIL MANIAC…\\nI'm a nice guy who loves FOSSILS…\\pDo you want a FOSSIL?\\pBut the FOSSILS around these parts all\\nbelong to me… None for you…\\pIf you can't bear to go without\\na FOSSIL, look in a desert where there\\lare boulders and sand that may hide\\lFOSSILS…$"}
text:Route114_FossilManiacsTunnel.DevonCorpRevivingFossils	{'body': "You found a FOSSIL, didn't you?\\nThat's so nice… It's so dreamy…\\pDEVON's researcher can revive complete\\nfossils from every ancient era.\\pThe machine handles one at a time,\\nbut you may return with every kind.$"}
text:Route114_FossilManiacsTunnel.FossilsAreWonderful	{'body': 'You brought an ancient POKéMON back!\\nPerhaps fossils are meant to awaken…\\pDEVON can revive any others you find.$'}
text:Route114_FossilManiacsTunnel.NotSafeThatWay	{'body': 'Oh... Be careful! I was digging\\nwhen the wall fell into an\\lenormous cavern.\\pTING-LU lives in the DESERT\\nUNDERPASS. It also connects to\\lSANDSTREWN RUINS, where ZYGARDE\\llives on B1F.\\pUntil caught, each has a 3%\\nwild encounter chance in its\\lhabitat.$'}
text:Route114_LanettesHouse.EverythingClutteredKeepThis	{'body': "LANETTE: Oh! {PLAYER}{KUN}!\\pI'm sorry everything is so cluttered…\\nWhen I get engrossed in research,\\lthings end up this way…\\pThis is embarrassing… Please keep\\nthis a secret in exchange for this.$"}
text:Route114_LanettesHouse.OrganizeYourBoxes	{'body': 'May I offer advice about my POKéMON\\nStorage System?\\pYou should organize your BOXES so you\\ncan tell which POKéMON are in them.$'}
text:Route114_LanettesHouse.ResearchNotesPage1	{'body': "It's LANETTE's research notes.\\nThere's information about BOXES.\\pDesign BOXES to hold 30 POKéMON each.\\pEach TRAINER should be able to store\\n420 POKéMON on the PC system.\\pKeep reading?$"}
text:Route114_LanettesHouse.ResearchNotesPage2	{'body': 'A marking system should be added to\\nmake POKéMON easier to organize.\\pThe name and wallpaper design of each\\nBOX will be made changeable to please\\lthe stored POKéMON.\\pKeep reading?$'}
text:Route114_LanettesHouse.ResearchNotesPage3	{'body': 'When storing a POKéMON, it should be\\nsent to the BOX inspected last.\\pIf that BOX is full, the received\\nPOKéMON is stored in the next BOX.\\pIn other words, when a BOX is examined,\\nit is automatically selected as the BOX\\lto which POKéMON are sent.$'}
text:Route114_LanettesHouse.ClosedTheNotebook	{'body': '{PLAYER} closed the notebook.$'}
text:Route114_LanettesHouse.EmailFromBill	{'body': "There's an e-mail from someone on\\nthe PC.\\p“… … … … … … …\\p“Your Storage System offers more\\nconvenience than mine.\\p“It has a lot of user-friendly features\\nthat make it fun and useful, too.\\p“It makes me proud that I played\\na part in its development.\\p“Here's hoping that you'll continue\\nresearch in Storage Systems.\\p“From BILL\\n… … … … … … … …”$"}
text:Route115.NeverKnowWhenCavePokemonWillAppear	{'body': 'The shifted tide exposed SEASPRAY\\nCAVE along the lower shore.\\pIts first chamber is wet stone.\\nThe floor below is somehow\\lfrozen.$'}
text:Route115.RouteSignRustboro	{'body': 'ROUTE 115\\n{DOWN_ARROW} RUSTBORO CITY$'}
text:Route115.MeteorFallsSign	{'body': 'METEOR FALLS\\nFALLARBOR TOWN THROUGH HERE$'}
text:Route115.NOB_1_LocalConversation	{'body': 'I punched a rock for training.\\nThe rock remains undefeated.$'}
text:Route115.KYRA_LocalConversation	{'body': 'I race my own best time now.\\nShe is a very annoying rival.$'}
text:Route115.HELENE_LocalConversation	{'body': 'My coach told me to loosen up.\\nI dropped my entire backpack.$'}
text:Route116.ScoundrelMadeOffWithPeeko	{'body': 'Ohhh, what am I to do?\\pWe were on our walk, PEEKO and I, when\\nwe were jumped by an odd thug…\\pThe scoundrel made off with my\\ndarling PEEKO!\\pWrrrooooooaaaar! PEEKO!$'}
text:Route116.WantToDigTunnel	{'body': 'Nnn… Roar!\\pI want to dig that tunnel!$'}
text:Route116.DiggingTunnelWhenGoonOrderedMeOut	{'body': "Nnn… Roar!\\nWhat's going on?\\pI was digging the tunnel without any\\ntools when some goon ordered me out!\\pThat tunnel's filled with POKéMON\\nthat react badly to loud noises.\\lThey could cause an uproar.\\pThat's why we stopped using heavy\\nequipment for tunneling…\\pI'm worried that the goon will do\\nsomething stupid and startle the\\lPOKéMON into an uproar.$"}
text:Route116.GoonHightailedItOutOfTunnel	{'body': 'Nnn… Roar!\\pThat goofy goon hightailed it out of\\nthe tunnel! I can go back to digging!$'}
text:Route116.ThankYouTokenOfAppreciation	{'body': "Oh! It's you!\\pYou're that person who not only helped\\nme in PETALBURG WOODS, but also got\\lback my stolen package and then even\\lgraciously delivered it to SLATEPORT!\\pCAPT. STERN informed us that the\\npackage arrived, too!\\pI thank you very, very much!\\pWhy, if I were a rain cloud, I would\\nshower you with gratitude and hail\\lyou as a hero!\\pFor you, the most wonderful TRAINER,\\nI bear good news!\\pRecently, our company developed\\na new kind of POKé BALL.\\pAs a token of our appreciation, this\\nis our gift to our wonderful TRAINER!$"}
text:Route116.NewBallAvailableAtMart	{'body': 'Our new POKé BALL will be available\\nat the POKéMON MART in RUSTBORO.\\pPlease do try it out!\\nThank you and bye-bye!$'}
text:Route116.BagIsJamPacked	{'body': "Your BAG is jam-packed.\\nI can't give you this REPEAT BALL.$"}
text:Route116.TokenOfAppreciation	{'body': 'As a token of our appreciation for\\nyour delivering our package, I have\\la gift of a new kind of POKé BALL\\lfor our most wonderful TRAINER!$'}
text:Route116.CanYouHelpMeFindDuskStone	{'body': 'I dropped a dark stone with a purple\\ngleam…\\pCan you help me find it?$'}
text:Route116.MayISeeThatDuskStone	{'body': 'That DUSK STONE!\\nMay I see it for a second?$'}
text:Route116.DuskStoneIsYours	{'body': 'Hmm… Mine bore a crescent scratch.\\nThis one is different.\\pIt seems to have chosen you. Keep it--\\nsome POKéMON evolve in its darkness.$'}
text:Route116.DuskStoneAlreadyUsed	{'body': "The purple gleam that was here is gone.\\pPerhaps a TRAINER found it and gave it\\npurpose. I'll search on.$"}
text:Route116.DuskStoneNotYetFound	{'body': 'A lovely DUSK STONE, but not the one\\ngleaming somewhere along this path.$'}
text:Route116.RouteSignRustboro	{'body': 'ROUTE 116\\n{LEFT_ARROW} RUSTBORO CITY$'}
text:Route116.RusturfTunnelSign	{'body': 'RUSTURF TUNNEL\\n“Linking RUSTBORO and VERDANTURF\\p“The tunnel project has been\\ncanceled.”$'}
text:Route116.TunnelersRestHouse	{'body': "TUNNELER'S REST HOUSE$"}
text:Route116.TrainerTipsBToStopEvolution	{'body': 'TRAINER TIPS\\pIf you want to stop a POKéMON from\\nevolving, press the B Button while it\\lis trying to evolve.\\lThe startled POKéMON will stop.\\pThis is called an evolution cancel.$'}
text:Route116.TrainerTipsBagHasPockets	{'body': 'TRAINER TIPS\\pYour BAG has several POCKETS.\\pItems you obtain are automatically\\nplaced in the appropriate POCKETS.\\pNo TRAINER can afford to be without\\na BAG of their own.$'}
text:Route116.KAREN_1_LocalConversation	{'body': 'I studied type matchups all night.\\nThe quiz was on geography.$'}
text:Route116_TunnelersRestHouse.WeHadToStopBoring	{'body': "That RUSTURF TUNNEL there…\\pAt first, we had a huge work crew boring\\nthrough rock with the latest machinery.\\lBut, we had to stop.\\pIt turns out that we would have had\\na negative effect on wild POKéMON in\\lthe area.\\pSo, we've got nothing to do but loll\\naround here doing nothing.$"}
text:Route116_TunnelersRestHouse.ManDiggingHisWayToVerdanturf	{'body': "There's a man digging his way to\\nVERDANTURF all by his lonesome.\\lHe's desperate to get through.\\pHe says that if he digs little by little\\nwithout using machines, he won't\\ldisturb POKéMON, and he'll avoid\\lharming the natural environment.\\pI wonder if he made it through yet.$"}
text:Route116_TunnelersRestHouse.GetToVerdanturfWithoutTunnel	{'body': "To get to VERDANTURF without using\\nthis TUNNEL, you'd have to cross the\\lsea to DEWFORD, sail on to SLATEPORT,\\lthen travel through MAUVILLE.$"}
text:Route116_TunnelersRestHouse.TunnelHasGoneThrough	{'body': 'Did you hear? The TUNNEL to VERDANTURF\\nhas gone through!\\pSometimes, if you hope strongly enough,\\ndreams do come true.$'}
text:Route117.AudiniteGift	{'body': "AUDINO often wander through these\\nflowers. They're wonderful partners.\\pTake this AUDINITE. With a MEGA RING,\\nit helps an AUDINO Mega Evolve.$"}
text:Route117.DayCarePokemonHadNewMove	{'body': 'I left two compatible POKéMON at\\nthe DAY CARE, and they produced an\\lEGG!\\pI wonder what the little one will\\nbe like. Waiting to meet it is the\\lhardest part!$'}
text:Route117.ArentTheseFlowersPretty	{'body': "Aren't these flowers pretty? I\\nlove watching the POKéMON wander\\lthrough them.\\pLately, an odd one with a metal\\nmask has been hiding in the grass.\\lDEVON calls it TYPE: NULL.\\pYou can find it in this grass,\\nwith a 3% encounter chance.\\lSWEET SCENT helps draw it out.$"}
text:Route117.AirIsTastyHere	{'body': 'The air is tasty here!$'}
text:Route117.RouteSignVerdanturf	{'body': 'ROUTE 117\\n{LEFT_ARROW} VERDANTURF TOWN$'}
text:Route117.RouteSignMauville	{'body': 'ROUTE 117\\n{RIGHT_ARROW} MAUVILLE CITY$'}
text:Route117.DayCareSign	{'body': 'POKéMON DAY CARE\\n“Let us raise your POKéMON.”$'}
text:Route117.DYLAN_1_LocalConversation	{'body': 'Training tip: take a breath.\\nThat is also my swimming plan.$'}
text:Route117.TypeNullCaught	{'body': 'The flowers seem peaceful now.\\pThat TYPE: NULL found a partner\\nin you! I hope it enjoys traveling\\las much as it enjoyed this meadow.$'}
text:Route117_PokemonDayCare.TogepiEggOffer	{'body': "MEGA KANGASKHAN fights with its child.\\nTheir Ability is PARENTAL BOND.\\pLeave two compatible adult POKéMON\\nhere, then hatch the EGG they produce.\\pI'll give you a KANGASKHANITE!\\nDITTO in the grass can help you breed.\\pWant this TOGEPI EGG as a gift?\\nThis gift won't count for the stone.$"}
text:Route117_PokemonDayCare.TogepiEggReceived	{'body': 'Take TOGEPI along on your adventure.\\pFor the stone, hatch an EGG produced\\nby two POKéMON you leave here.$'}
text:Route117_PokemonDayCare.TogepiEggAfter	{'body': "Leave two compatible POKéMON\\nhere, then hatch the EGG they\\lproduce.\\pOne is enough for a\\nKANGASKHANITE! Gift EGGS,\\lincluding TOGEPI, don't count.$"}
text:Route117_PokemonDayCare.HatchReward	{'body': "You raised an EGG from two parents!\\nNow you've helped their family grow.\\pKANGASKHAN's child grows brave enough\\nto fight beside its mother.\\pTheir PARENTAL BOND lets the child\\nfollow up its mother's attacks.\\pThis KANGASKHANITE is yours. Keep it\\nfor a KANGASKHAN from the SAFARI ZONE.$"}
text:Route117_PokemonDayCare.RewardAfter	{'body': "KANGASKHAN and its child battle\\ntogether when it Mega Evolves.\\pYou'll find KANGASKHAN in the\\nSAFARI ZONE. Take good care of them!$"}
text:Route117_PokemonDayCare.HatchRewardBagFull	{'body': "Make room in your BAG. I'll keep\\nyour KANGASKHANITE safe until then.$"}
text:Route117_PokemonDayCare.TogepiEggDeclined	{'body': 'The EGG will be safe here until you\\nchange your mind.$'}
text:Route117_PokemonDayCare.TogepiEggNoRoom	{'body': 'Your party is full. Make one open slot,\\nthen return for the EGG.$'}
text:Route117_PokemonDayCare.OvalCharmGift	{'body': 'If you ever want to breed POKéMON,\\nthis OVAL CHARM helps EGGS turn up.$'}
text:Route118.StevenQuestions	{'body': "STEVEN: {PLAYER}{KUN}! Good to\\nsee you.\\pHave you found new partners, or\\nstayed with your favorites?\\pEither way, think about how they\\nhelp one another. That's a team's\\lstrength.\\pHead north on ROUTE 119. Visit\\nthe WEATHER INSTITUTE on the way.\\pAsk its researchers about the\\nweather. Then challenge WINONA in\\lFORTREE.\\pI'll keep exploring. Let's\\ncompare discoveries next time.$"}
text:Route118.YouAgreeGoodRodIsGood	{'body': "Hmm!\\nA GOOD ROD is really good!\\pWouldn't you agree?$"}
text:Route118.IdenticalMindsTakeThis	{'body': "Hmm!\\nWe're of identical minds!\\pHmm!\\nTake this GOOD ROD!$"}
text:Route118.TryYourLuckFishing	{'body': "Wherever there's water, try your luck\\nat fishing.$"}
text:Route118.DontYouLikeToFish	{'body': "Don't you like to fish?$"}
text:Route118.TryCatchingMonWithGoodRod	{'body': 'Try catching all sorts of POKéMON\\nwith your GOOD ROD.$'}
text:Route118.MagikarpGuyChallenge	{'body': "People see my MAGIKARP and smile.\\nI don't mind. I smiled when I\\lcaught it!\\pCare to battle my fishing team?$"}
text:Route118.MagikarpGuyDefeat	{'body': 'Well caught! That was a good\\nbattle.$'}
text:Route118.MagikarpGuyAfter	{'body': 'Every partner has a story. Mine\\nusually starts with a fishing rod\\land a very long wait.\\pEven that little MAGIKARP made me\\nwork for it!$'}
text:Route118.MagikarpGuyDecline	{'body': 'No hurry. The river and my team will wait.$'}
text:Route118.CanCrossRiversWithSurf	{'body': "With SURF registered and the\\nBALANCE BADGE, a compatible party\\lmember can cross water.\\pIt doesn't need SURF in its battle\\nmoveset. Partners can help in more\\lways than one!$"}
text:Route118.RouteSignMauville	{'body': 'ROUTE 118\\n{LEFT_ARROW} MAUVILLE CITY$'}
text:Route118.RouteSign119	{'body': 'ROUTE 118\\n{UP_ARROW} ROUTE 119$'}
text:Route118.WADE_LocalConversation	{'body': 'That splash was a huge fish!\\nOr my lunch. I hope it was a fish.$'}
text:Route118.BARNY_LocalConversation	{'body': 'WAILORD took the bait once.\\nI am still paying for the rod.$'}
text:Route119.MayIntro	{'body': 'MAY: {PLAYER}{KUN}! There you\\nare!\\pI keep stopping to take notes,\\nand then the rain washes them\\laway!\\pA battle will cheer us up. Ready?$'}
text:Route119.MayDefeat	{'body': 'Whew! That was worth getting\\nsoaked for!$'}
text:Route119.MayPresentForYou	{'body': 'MAY: Your partners came through\\nthat battle together.\\pHere. I have a present for you.$'}
text:Route119.MayExplainFly	{'body': "MAY: Your FLIGHT BEACON works\\nonce you earn the FEATHER BADGE\\lfrom WINONA in FORTREE.\\pFollow this road north! Then use\\nthe beacon from your BAG to fly\\lto towns you've visited.\\pStop by home sometime. Your mom\\nwould love to see you!$"}
text:Route119.FlyHMSentToPC	{'body': 'Your TM pocket is full, so FLY was sent\\nto your PC. Retrieve it when ready.$'}
text:Route119.FlyHMNoRoom	{'body': 'Your TM pocket and PC are both full.\\nMake room, then speak to me again.$'}
text:Route119.BrendanIntro	{'body': "BRENDAN: {PLAYER}! I wondered\\nwhen you'd catch up.\\pA little rain hasn't stopped us\\npracticing. Come on, let's\\lbattle!$"}
text:Route119.BrendanDefeat	{'body': 'Hmm… You adapted quicker than me.$'}
text:Route119.BrendanIllGiveYouThis	{'body': "BRENDAN: I knew you'd give us a\\ngood battle. Here, take this!$"}
text:Route119.BrendanExplainFly	{'body': "BRENDAN: Your FLIGHT BEACON works\\nonce you earn the FEATHER BADGE\\lfrom WINONA at FORTREE GYM.\\pUse it from the BAG to visit a\\ntown you've already reached.\\pI'm off to see what POKéMON live\\nbeyond FORTREE!$"}
text:Route119.ScottWayToGoBeSeeingYou	{'body': "SCOTT: Hahahah!\\nWay to go, {PLAYER}{KUN}!\\pI just passed by a TRAINER riding\\na BIKE.\\pYou just beat that TRAINER, didn't you?\\nIt was pretty obvious that you did.\\pAlready planning the next battle,\\nby the look of it. I like that spirit!\\pI sure seem to run into you often.\\nAre you off to FORTREE GYM next?\\pI expect that you'll do well at the GYM.\\nWell, I'll be seeing you!$"}
text:Route119.ScottYouWonAtFortreeGym	{'body': "… … … … … …\\n… … … … … Beep!\\pSCOTT: Hiya, {PLAYER}{KUN}, it's me!\\pJust as I thought, you won at\\nthe FORTREE GYM.\\pYour strength…\\nPerhaps you really are the TRAINER\\lthat I've been searching for.\\pRemember, you have a fan in me.\\nI'll be cheering from the sidelines.\\lKeep up the great work!\\p… … … … … …\\n… … … … … Click!$"}
text:Route119.StayAwayFromWeatherInstitute	{'body': "We're standing lookout here.\\pHey, you! Stay away from the WEATHER\\nINSTITUTE. It's not safe.$"}
text:Route119.DontGoNearWeatherInstitute	{'body': "Lookout duty is surprisingly boring.\\pHey, you! Please don't go near the\\nWEATHER INSTITUTE.$"}
text:Route119.ThoughtFlyByCatchingBirdMons	{'body': "I thought you could fly by holding\\non to a whole flock of birds!\\pTurns out a FLIGHT BEACON is much\\nsimpler. Earn WINONA's badge, then\\luse it to visit familiar towns.\\pThe birds seem relieved.$"}
text:Route119.TallGrassSnaresBikeTires	{'body': "Tch…\\nIt's a no-go…\\pThe tall grass snares BIKE tires.\\nThere's no way you can cycle here.$"}
text:Route119.CanYourMonMakeSecretBase	{'body': 'Can your POKéMON use its SECRET POWER\\non a big pile of grass and make a\\lSECRET BASE?$'}
text:Route119.RouteSignFortree	{'body': 'ROUTE 119\\n{RIGHT_ARROW} FORTREE CITY$'}
text:Route119.WeatherInstitute	{'body': "WEATHER INSTITUTE\\pResearching HOENN's changing\\nweather and the POKéMON drawn\\lto it.$"}
text:Route119.TrainerTipsDecoration	{'body': 'TRAINER TIPS\\pUp to sixteen decorations and\\nfurniture items can be placed in\\la SECRET BASE.\\pPick your favorite items and create\\nyour very own SECRET BASE exactly the\\lway you want.$'}
text:Route119.HUGH_LocalConversation	{'body': 'Listen to the birds for a while.\\nThey have plenty to argue about.$'}
text:Route119.DAYTON_LocalConversation	{'body': 'I brought a campfire starter.\\nThe rain brought an opinion.$'}
text:Route119_House.RumorAboutCaveOfOrigin	{'body': 'I heard about a cave called the CAVE\\nOF ORIGIN.\\pPeople rumor that the spirits of\\nPOKéMON are revived there. Could\\lsomething like that really happen?$'}
text:Route119_House.Wingull	{'body': 'WINGULL: Pihyoh!$'}
text:Route119_WeatherInstitute_1F.Grunt1Intro	{'body': "These maps show storms all over\\nHOENN. ARCHIE wants to know where\\lthey begin.\\pHe'll get his answers. You're not\\ngetting upstairs!$"}
text:Route119_WeatherInstitute_1F.Grunt1Defeat	{'body': "I couldn't keep you out…$"}
text:Route119_WeatherInstitute_1F.Grunt1PostBattle	{'body': "These maps connect the strange\\nstorms to the ocean's depths.\\pSHELLY took the researchers\\nupstairs. ARCHIE wants their\\lreadings.$"}
text:Route119_WeatherInstitute_1F.Grunt4Intro	{'body': "You crossed all that rain to get\\nhere? Should've stayed where it\\lwas dry!\\pNow you've got TEAM AQUA to deal\\nwith!$"}
text:Route119_WeatherInstitute_1F.Grunt4Defeat	{'body': 'So much for scaring you off…$'}
text:Route119_WeatherInstitute_1F.Grunt4PostBattle	{'body': "There's a bed over there. You\\nmight want to rest.\\pSHELLY's upstairs with the\\nresearchers. She's tougher than I\\lam.$"}
text:Route119_WeatherInstitute_1F.EveryoneWentUpstairs	{'body': 'Those AQUA people took the researchers\\nupstairs while I was asleep!\\pCan you go up and help them?$'}
text:Route119_WeatherInstitute_1F.WowYoureStrong	{'body': "Wow, you're really strong!\\pI wish I could be a POKéMON TRAINER\\nlike you!$"}
text:Route119_WeatherInstitute_1F.ProfStudyingRain	{'body': "The PROFESSOR loves rain.\\nThat's a fact.\\pBut if it keeps raining, people will be in\\ntrouble. That's another fact.\\pAnd thus, the PROFESSOR is studying\\nif the rain can be put to good use.$"}
text:Route119_WeatherInstitute_1F.NoticingAbnormalWeather	{'body': "On the 2nd floor of the INSTITUTE,\\nwe study the weather patterns over\\lthe HOENN region.\\pWe've been noticing temporary and\\nisolated cases of droughts and\\lheavy rain lately…$"}
text:Route119_WeatherInstitute_1F.WhatWereAquasUpTo	{'body': 'You saved our staff and records.\\nAQUA wanted to know what is\\lcausing these violent changes in\\lweather.$'}
text:Route119_WeatherInstitute_1F.TakeRestInBed	{'body': "There's a bed…\\nLet's take a rest.$"}
text:Route119_WeatherInstitute_2F.Grunt2Intro	{'body': "The researchers say CASTFORM\\nchanges with the weather. ARCHIE\\lwants to know why!\\pYou can't go into the research\\nwing!$"}
text:Route119_WeatherInstitute_2F.Grunt2Defeat	{'body': "I couldn't stop you…$"}
text:Route119_WeatherInstitute_2F.Grunt2PostBattle	{'body': 'CASTFORM does not command the\\nweather. It survives by changing\\lwith it.$'}
text:Route119_WeatherInstitute_2F.Grunt3Intro	{'body': "Weather records, rare POKéMON…\\nThis place has everything ARCHIE\\lasked for!\\pYou're not taking it away from\\nus!$"}
text:Route119_WeatherInstitute_2F.Grunt3Defeat	{'body': 'But I was guarding the records…$'}
text:Route119_WeatherInstitute_2F.Grunt3PostBattle	{'body': "We've watched strange storms\\ngather out at sea. ARCHIE says\\lthese records will tell us what\\lthey mean.$"}
text:Route119_WeatherInstitute_2F.Grunt5Intro	{'body': 'What are you after? The records?\\nThe weather POKéMON?\\pWhatever it is, TEAM AQUA got\\nhere first!$'}
text:Route119_WeatherInstitute_2F.Grunt5Defeat	{'body': "I couldn't hold my post…$"}
text:Route119_WeatherInstitute_2F.Grunt5PostBattle	{'body': 'The storm records led us to old\\nstories about MT. PYRE. ARCHIE\\lthinks its ORBS are the key.$'}
text:Route119_WeatherInstitute_2F.ShellyIntro	{'body': "SHELLY: We came for weather\\nrecords. They show something\\lpowerful stirring in the ocean.\\pYou should have stayed out of\\nthis, {PLAYER}. I'm not letting\\lyou interfere with ARCHIE's work!$"}
text:Route119_WeatherInstitute_2F.ShellyDefeat	{'body': "You've beaten us here, too…$"}
text:Route119_WeatherInstitute_2F.ShellyPostBattle	{'body': "SHELLY: You're as persistent as\\nARCHIE said.\\pWe have what we need. These\\nrecords point to MT. PYRE.$"}
text:Route119_WeatherInstitute_2F.TeamMagmaJustPassedBy	{'body': 'TEAM MAGMA just passed below us. They\\nwere searching for an ancient BLUE ORB.\\pThey are headed for MT. PYRE!$'}
text:Route119_WeatherInstitute_2F.WeHaveToHurryToMtPyre	{'body': "What?! MAGMA is heading for the\\nBLUE ORB?\\pSHELLY: Then we can't waste\\nanother moment here. AQUA! To MT.\\lPYRE!$"}
text:Route119_WeatherInstitute_2F.ThanksPleaseTakePokemon	{'body': 'You saved us, and our research.\\nThank you!\\pThis CASTFORM has helped us study\\nthe weather. I think it would\\lenjoy traveling with you. Please\\ltake it!$'}
text:Route119_WeatherInstitute_2F.NoRoomForPokemon	{'body': "Hm? You don't seem to have any room\\nfor this POKéMON.$"}
text:Route119_WeatherInstitute_2F.PlayerReceivedCastform	{'body': '{PLAYER} received CASTFORM!$'}
text:Route119_WeatherInstitute_2F.PokemonChangesWithWeather	{'body': "CASTFORM changes with the\\nweather. Let it show you what a\\lstorm can do.\\pOur records link TORNADUS to\\nROUTE 119 and THUNDURUS to\\lROUTE 110.\\pThe route signs list their\\nrequirements and mark any\\lpartners you've already caught.\\pA researcher at ROUTE 111's\\nelevated ruins also needs\\lCASTFORM for a weather survey.$"}
text:Route119_WeatherInstitute_2F.RevealGlassPurpose	{'body': "This REVEAL GLASS changes the forms of\\nTORNADUS, THUNDURUS, and LANDORUS.\\pThe northern bridge is clear now.\\nFollow ROUTE 119 to FORTREE's GYM.$"}
text:Route119_WeatherInstitute_2F.RevealGlassBagFull	{'body': 'The REVEAL GLASS is ready for you, but\\nyour KEY ITEMS pocket is full.\\pMake room, then speak with me again.$'}
text:Route119_WeatherInstitute_2F.ChangingWeatherRidiculous	{'body': "Our instruments track unusual\\nweather across HOENN.\\pPOKéMON CENTER guides track local\\nlegendary leads. Look near the PC\\lto hear where to search.\\pThe road north leads to FORTREE.\\nYou're welcome to rest here.$"}
text:Route119_WeatherInstitute_2F.GroudonWeather	{'body': 'I track weather patterns over\\nthe HOENN region.\\pPresently, a drought has been recorded\\nin {STR_VAR_1}.\\pCould that mean, somewhere near\\n{STR_VAR_1}…$'}
text:Route119_WeatherInstitute_2F.KyogreWeather	{'body': 'I track weather patterns over\\nthe HOENN region.\\pPresently, heavy rainfall has been\\nrecorded over {STR_VAR_1}.\\pCould that mean, somewhere near\\n{STR_VAR_1}…$'}
text:Route119_WeatherInstitute_2F.NoAbnormalWeather	{'body': 'Abnormal weather conditions are\\nno longer being reported.\\pThe occasional rainfall is a blessing,\\nreally.$'}
text:Route11_EastEntrance_1F_BagIsFull	{'body': '{PLAYER}{KUN}の\u3000バッグ\\nいっぱい\u3000みたい\u3000だね$'}
text:Route11_EastEntrance_1F_ManInLavenderRatesNames	{'body': "Don't you think it's hard to think\\nup good names for POKéMON?\\pEspecially if you've caught a\\nwhole bunch?\\pIn LAVENDER TOWN, there's a man\\nwho rates POKéMON nicknames.\\pHe can even help you rename your\\nPOKéMON, too.$"}
text:Route11_EastEntrance_1F_RockTunnelToReachLavender	{'body': "If you're aiming to reach LAVENDER\\nTOWN, take ROCK TUNNEL.\\pYou can get to ROCK TUNNEL from\\nCERULEAN CITY.$"}
text:Route11_EastEntrance_2F_GiveItemfinderIfCaught30	{'body': "Hi! Remember me?\\nI'm one of PROF. OAK's AIDES.\\pIf your POKéDEX has complete data\\non {STR_VAR_1} species, I'm supposed to\\lgive you a reward.\\pPROF. OAK entrusted me with the\\n{STR_VAR_2} for you.\\pSo, {PLAYER}, let me ask you.\\pHave you gathered data on at least\\n{STR_VAR_1} kinds of POKéMON?$"}
text:Route11_EastEntrance_2F_GreatHereYouGo	{'body': 'Great! You have caught or owned\\n{STR_VAR_3} kinds of POKéMON!\\pCongratulations!\\nHere you go!$'}
text:Route11_EastEntrance_2F_ReceivedItemfinderFromAide	{'body': '{PLAYER} received the {STR_VAR_2}\\nfrom the AIDE.$'}
text:Route11_EastEntrance_2F_ExplainItemfinder	{'body': "There are items on the ground that\\nmay be hidden from view.\\pUse the ITEMFINDER to detect any\\nhidden items close to you.\\pThe machine is a bit limited.\\nIt can't pinpoint item locations.\\pWhat it does is show the direction\\nwhere the item is.\\pUse it to get your bearings, then\\nsearch the suspect area by hand.$"}
text:Route11_EastEntrance_2F_BigMonAsleepOnRoad	{'body': "Let's see what the binoculars have\\nto show…\\pA big POKéMON is asleep on a road!$"}
text:Route11_EastEntrance_2F_WhatABreathtakingView	{'body': "Let's see what the binoculars have\\nto show…\\pWhat a breathtaking view!$"}
text:Route11_EastEntrance_2F_RockTunnelGoodRouteToLavender	{'body': "Let's see what the binoculars have\\nto show…\\pTo get to LAVENDER TOWN from\\nCERULEAN CITY…\\pROCK TUNNEL appears to be a good\\nroute to take.$"}
text:Route11_HugoIntro	{'body': 'Win, lose, or draw!$'}
text:Route11_HugoDefeat	{'body': "Atcha!\\nDidn't go my way!$"}
text:Route11_HugoPostBattle	{'body': 'POKéMON is life!\\nAnd to live is to play games!$'}
text:Route11_JasperIntro	{'body': "Competition!\\nI can't get enough!$"}
text:Route11_JasperDefeat	{'body': 'I had a chance!$'}
text:Route11_JasperPostBattle	{'body': "You can't be a coward in the world\\nof POKéMON!$"}
text:Route11_EddieIntro	{'body': "Let's go, but don't cheat!$"}
text:Route11_EddieDefeat	{'body': "Huh?\\nThat's not right!$"}
text:Route11_EddiePostBattle	{'body': 'I did my best.\\nI have no regrets.$'}
text:Route11_BraxtonIntro	{'body': "Careful!\\nI'm laying down some cables!$"}
text:Route11_BraxtonDefeat	{'body': 'That was electric!$'}
text:Route11_BraxtonPostBattle	{'body': 'Spread the word to save energy!$'}
text:Route11_DillonIntro	{'body': 'I just became a TRAINER.\\nBut, I think I can win.$'}
text:Route11_DillonDefeat	{'body': "My POKéMON couldn't win…\\nHaven't they grown enough?$"}
text:Route11_DillonPostBattle	{'body': 'What now?\\nLeave me alone!$'}
text:Route11_DirkIntro	{'body': 'Fwahaha!\\nI have never lost!$'}
text:Route11_DirkDefeat	{'body': 'My first loss!$'}
text:Route11_DirkPostBattle	{'body': "You were just lucky, that's all.$"}
text:Route11_DarianIntro	{'body': 'I have never won before…$'}
text:Route11_DarianDefeat	{'body': 'I saw this coming…$'}
text:Route11_DarianPostBattle	{'body': 'I was unlucky, as always.$'}
text:Route11_YasuIntro	{'body': "I'm the best in my class.\\nI train every morning.$"}
text:Route11_YasuDefeat	{'body': 'Darn!\\nMy POKéMON need to be stronger!$'}
text:Route11_YasuPostBattle	{'body': "There's a fat POKéMON that comes\\ndown from the mountains.\\pI bet it'd be strong if you can\\ncatch it.$"}
text:Route11_BernieIntro	{'body': 'Watch out for live wires!$'}
text:Route11_BernieDefeat	{'body': 'Whoa!\\nYou spark plug!$'}
text:Route11_BerniePostBattle	{'body': 'Well, better get back to work.$'}
text:Route11_DaveIntro	{'body': 'I raised my POKéMON carefully.\\nThey should be ready by now!$'}
text:Route11_DaveDefeat	{'body': 'Bye-bye!\\nThank you, and good-bye!$'}
text:Route11_DavePostBattle	{'body': 'Tch…\\nI better go find stronger ones!$'}
text:Route11_DiglettsCave	{'body': "DIGLETT'S CAVE$"}
text:Route120.LeonelOgerponCaught	{'body': 'So OGERPON is traveling with you!\\pThe old stories have a new\\nchapter. Take care of each other.$'}
text:Route120.StevenGreeting	{'body': "STEVEN: Hm? {PLAYER}{KUN}, hi.\\nIt's been a while.\\pThere's something here that you can't\\nsee, right?\\pNow, if I were to use this device on\\nthe invisible obstacle…\\pNo, no. Rather than describing it,\\nI should just show you.\\lThat would be more fun.\\p{PLAYER}{KUN}, are your POKéMON ready for\\nbattle?$"}
text:Route120.StevenIllWaitHere	{'body': "STEVEN: No?\\pI'll wait here, so you can get ready.$"}
text:Route120.StevenReadyForBattle	{'body': 'STEVEN: {PLAYER}{KUN}, are your POKéMON\\nready for battle?$'}
text:Route120.StevenShowMeYourPower	{'body': 'STEVEN: {PLAYER}{KUN}, show me your true\\npower as a TRAINER!$'}
text:Route120.StevenUsedDevonScope	{'body': 'STEVEN used the DEVON SCOPE.\\pAn invisible POKéMON became completely\\nvisible!\\pThe startled POKéMON attacked!$'}
text:Route120.StevenGiveDevonScope	{'body': "STEVEN: I see…\\nYour battle style is intriguing.\\pYour POKéMON have obviously grown\\nsince I first met you in DEWFORD.\\pI'd like you to have this\\nDEVON SCOPE.\\pWho knows, there may be other\\nconcealed POKéMON.$"}
text:Route120.DevonScopeSentToPC	{'body': 'Your KEY ITEMS pocket is full, so the\\nDEVON SCOPE was sent to your PC.$'}
text:Route120.DevonScopeNoRoom	{'body': 'Your KEY ITEMS pocket and PC are full.\\nMake room, then speak to me again.$'}
text:Route120.StevenGoodbye	{'body': 'STEVEN: {PLAYER}{KUN}.\\pI enjoy seeing POKéMON and TRAINERS\\nwho strive together.\\pWINONA is waiting in FORTREE.\\nEarn her FEATHER BADGE, then the road\\least is yours.\\pUse the SCOPE on the obstacle outside\\nher GYM. It should clear your way.$'}
text:Route120.StevenFeatherGate	{'body': 'STEVEN: The road east can wait.\\pWINONA is ready to test you in\\nFORTREE GYM. Return with her\\lFEATHER BADGE.\\pThe SCOPE will reveal the POKéMON\\nblocking her GYM. Try it there.$'}
text:Kecleon_SomethingUnseeable	{'body': 'Something unseeable is in the way.$'}
text:Kecleon_WantToUseDevonScope	{'body': 'Something unseeable is in the way.\\pWant to use the DEVON SCOPE?$'}
text:Kecleon_UseDevonScopeMonAttacked	{'body': '{PLAYER} used the DEVON SCOPE.\\pAn invisible POKéMON became completely\\nvisible!\\pThe startled POKéMON attacked!$'}
text:Route120.RouteSignFortree	{'body': 'ROUTE 120\\n{LEFT_ARROW} FORTREE CITY$'}
text:Route120.RouteSign121	{'body': '{RIGHT_ARROW} ROUTE 121\\n{LEFT_ARROW} ROUTE 120$'}
text:Route120.ROBERT_1_LocalConversation	{'body': 'My bird knows the way home.\\nI am trying not to look jealous.$'}
text:Route120.KEIGO_LocalConversation	{'body': 'You cannot see a true ninja.\\nPlease pretend you cannot see me.$'}
text:Route120.RILEY_LocalConversation	{'body': 'I practiced hiding in the grass.\\nThe grass had other occupants.$'}
text:Route120.CALLIE_LocalConversation	{'body': 'Every good partner needs a break.\\nMine insisted I take one first.$'}
text:Route121.NurseOffer	{'body': 'MT. PYRE is a long climb. Shall I heal\\nyour party before you continue?$'}
text:Route121.NurseHealed	{'body': 'All better. Keep your partners close\\non the mountain.$'}
text:Route121.NurseDeclined	{'body': 'All right. SKITTY and I will be here\\nif you need us.$'}
text:Route121.RestoredSkitty	{'body': 'SKITTY: Meenya?$'}
text:Route121.OkayMoveOutToMtPyre	{'body': "Okay!\\nWe're to move out to MT. PYRE!$"}
text:Route121.AheadLoomsMtPyre	{'body': 'Ahead looms MT. PYRE…\\pIt is a natural monument to the\\nspirits of departed POKéMON…$'}
text:Route121.MtPyrePierSign	{'body': 'MT. PYRE PIER\\p…The sign is old and worn out.\\nThe words are barely legible…$'}
text:Route121.SafariZoneSign	{'body': '“Filled with rare POKéMON!”\\nSAFARI ZONE$'}
text:Route121.VANESSA_LocalConversation	{'body': 'My POKéMON posed for a portrait.\\nThe artist requested hazard pay.$'}
text:Route121_SafariZoneEntrance.CatchingCharmGift	{'body': 'First-time visitors get a CATCHING\\nCHARM. Carry it and your throws will\\lland critical captures more often.$'}
text:Route123.LoveGrassMonsHaveAny	{'body': 'I love GRASS-type POKéMON!\\pDo you have any GRASS-type POKéMON?$'}
text:Route123.YouLikeGrassMonsTooHaveThis	{'body': 'Oh? You like GRASS-type POKéMON,\\ntoo!\\pHere, take this SWEET APPLE from\\nthe orchard. Use it on APPLIN to\\levolve it into APPLETUN.$'}
text:Route123.CheckTreesWithMyGrassMon	{'body': "I check trees with my GRASS-type\\nPOKéMON. I'm like a tree doctor.$"}
text:Route123.RouteSign	{'body': '{RIGHT_ARROW} ROUTE 123\\n{LEFT_ARROW} ROUTE 118$'}
text:Route123.RouteSignMtPyre	{'body': '{UP_ARROW} MT. PYRE\\pTravelers report TAPU BULU in the\\ngrass on ROUTE 123. It has a 3%\\lwild encounter chance.$'}
text:Route123.BerryMastersHouse	{'body': "BERRY MASTER'S HOUSE$"}
text:Route123.KINDRA_LocalConversation	{'body': 'That shadow is following you.\\nMost shadows do. Carry on.$'}
text:Route123.JONAS_LocalConversation	{'body': 'My smoke bomb worked perfectly.\\nFinding my lunch afterward did not.$'}
text:Route123_BerryMastersHouse.GardenWelcome	{'body': 'A good garden always has something\\nto share. What brings you here?$'}
text:Route123_BerryMastersHouse.BerryGifts	{'body': 'Berry gifts$'}
text:Route123_BerryMastersHouse.StoneTrades	{'body': 'Mega Stone trades$'}
text:Route123_BerryMastersHouse.Leave	{'body': 'See you later$'}
text:Route123_BerryMastersHouse.Baxcalibrite	{'body': 'Baxcalibrite$'}
text:Route123_BerryMastersHouse.Dragoninite	{'body': 'Dragoninite$'}
text:Route123_BerryMastersHouse.Tyranitarite	{'body': 'Tyranitarite$'}
text:Route123_BerryMastersHouse.WhichBerries	{'body': 'Which berries?$'}
text:Route123_BerryMastersHouse.StonePrices	{'body': 'Each stone costs {STR_VAR_2} garden berries.\\nYou have {STR_VAR_1}. One of each stone!$'}
text:Route123_BerryMastersHouse.ConfirmStone	{'body': 'Trade {STR_VAR_2} garden berries for\\na {STR_VAR_1}?$'}
text:Route123_BerryMastersHouse.StoneReceived	{'body': 'You traded the berries and received\\na {STR_VAR_1}!$'}
text:Route123_BerryMastersHouse.StoneAlreadyGiven	{'body': "That one's already yours! I only\\nfound one of each in these fields.$"}
text:Route123_BerryMastersHouse.MoreBerries	{'body': 'Keep gathering as you travel. Plant\\na few, and your harvest will grow!$'}
text:Route123_BerryMastersHouse.GardenBerries	{'body': "Razz, Bluk, Nanab, Wepear and Pinap\\nare perfect for my garden.\\pPomeg, Kelpsy, Qualot, Hondew, Grepa\\nand Tamato count, too. Any mixture!\\pI found these stones while digging.\\nLet's put them to better use.$"}
text:Route124.HuntersHouse	{'body': "HUNTER'S HOUSE$"}
text:Route124.SPENCER_LocalConversation	{'body': 'I keep a map in my swim trunks.\\nIt is mostly ocean now.$'}
text:Route124.ROLAND_LocalConversation	{'body': 'CLAWITZER is a powerful swimmer.\\nThe brakes could use some work.$'}
text:Route124.CHAD_LocalConversation	{'body': 'STOUTLAND found my lost goggles.\\nI was wearing them. Good dog.$'}
text:Route124_DivingTreasureHuntersHouse.Greeting	{'body': "I'm the DIVING TREASURE HUNTER!\\pI'm the awesome dude who makes\\ndeep-sea dives to gather treasures\\lresting at the bottom.$"}
text:Route124_DivingTreasureHuntersHouse.HaveYouSeenAnyShards	{'body': 'Tell me, have you seen any SHARDS of\\ntools made in ancient times?$'}
text:Route124_DivingTreasureHuntersHouse.YouHaventGotAnyShards	{'body': "You haven't got any treasures\\nfor me…\\pIf you see any SHARDS, like the RED\\nSHARD, you've got to trade it with me!$"}
text:Route124_DivingTreasureHuntersHouse.ThatsAShardIllTradeYou	{'body': "Oh, hey! That…\\nThat's a SHARD! I'm looking for those!\\pOh, man, you've got to trade that\\nwith me! I'll give you something good!$"}
text:Route124_DivingTreasureHuntersHouse.WhatDoYouWantToTrade	{'body': 'What do you want to trade?$'}
text:Route124_DivingTreasureHuntersHouse.YoullTradeShardForStone	{'body': "You'll trade your {STR_VAR_1} for\\nmy {STR_VAR_2}, then?$"}
text:Route124_DivingTreasureHuntersHouse.ItsADeal	{'body': "It's a done deal!\\nUse that wisely!$"}
text:Route124_DivingTreasureHuntersHouse.TradeSomethingElse	{'body': 'Do you want to trade something else?$'}
text:Route124_DivingTreasureHuntersHouse.BagFull	{'body': "Whoops, your BAG's full.\\nGet rid of some items, friend!$"}
text:Route124_DivingTreasureHuntersHouse.ComeBackIfYouChangeMind	{'body': "No? That's a downer.\\nWell, if you change your mind, come back.$"}
text:Route124_DivingTreasureHuntersHouse.ShardTradeBoard	{'body': '{CLEAR_TO 10}Wanted item{CLEAR_TO 124}Trade item\\n{CLEAR_TO 15}RED SHARD{CLEAR_TO 89}{LEFT_ARROW}{RIGHT_ARROW}{CLEAR_TO 123}FIRE STONE{CLEAR_TO 200}\\p{CLEAR_TO 10}Wanted item{CLEAR_TO 124}Trade item\\n{CLEAR_TO 6}YELLOW SHARD{CLEAR_TO 89}{LEFT_ARROW}{RIGHT_ARROW}{CLEAR_TO 115}THUNDERSTONE{CLEAR_TO 200}\\p{CLEAR_TO 10}Wanted item{CLEAR_TO 124}Trade item\\n{CLEAR_TO 12}BLUE SHARD{CLEAR_TO 89}{LEFT_ARROW}{RIGHT_ARROW}{CLEAR_TO 121}WATER STONE{CLEAR_TO 200}\\p{CLEAR_TO 10}Wanted item{CLEAR_TO 124}Trade item\\n{CLEAR_TO 8}GREEN SHARD{CLEAR_TO 89}{LEFT_ARROW}{RIGHT_ARROW}{CLEAR_TO 123}LEAF STONE$'}
text:Route125.NOLEN_LocalConversation	{'body': 'I know a shortcut to the shore.\\nFirst, decide which shore.$'}
text:Route125.SHARON_LocalConversation	{'body': 'SLOWBRO never seems rushed.\\nI am trying to learn from that.$'}
text:Route126.LEONARDO_LocalConversation	{'body': 'I was racing a FLOATZEL.\\nNow I am enjoying a quiet swim.$'}
text:Route126.ISOBEL_LocalConversation	{'body': 'My warm-up was a little long.\\nI think I crossed a time zone.$'}
text:Route127.JONAH_LocalConversation	{'body': 'Fishing teaches patience.\\nThis spot has a full curriculum.$'}
text:Route127.AIDAN_LocalConversation	{'body': 'Birds never need a boarding pass.\\nI think they are showing off.$'}
text:Route128.ArchieWhatHappened	{'body': 'ARCHIE: What happened…\\nWhat is this wretched scene…\\pDid I…make a horrible mistake?$'}
text:Route128.ArchieIOnlyWanted	{'body': 'I…\\nI only wanted…$'}
text:Route128.MaxieDoYouUnderstandNow	{'body': 'MAXIE: Do you understand now,\\nARCHIE?\\pDo you finally see how disastrous\\nyour dream turned out to be?\\pWe have to hurry! We have to do\\nsomething before the situation goes\\lcompletely out of control!$'}
text:Route128.MaxieResponsibilityFallsToArchieAndMe	{'body': "MAXIE: {PLAYER}, don't say anything.\\pI know that I have no right to be\\ncritical of ARCHIE…\\pBut the way things are now, I doubt\\nthat we humans will be capable of\\ldoing anything about it.\\pBut neither can we stand by and\\njust watch helplessly.\\pThe responsibility for putting an end\\nto this falls to ARCHIE and me…$"}
text:Route128.MaxieThisDefiesBelief	{'body': "MAXIE: This defies belief…\\pThose super-ancient POKéMON…\\pTheir power is unbelievable.\\nThey've upset the balance of nature…$"}
text:Route128.StevenWhatIsHappening	{'body': 'STEVEN: {PLAYER}{KUN}!\\nWhat is happening?$'}
text:Route128.StevenWholeWorldWillDrown	{'body': "This is terrible…\\pAfter the scorching heat wave ended,\\nthis deluge began.\\pIf this doesn't stop, all of HOENN…\\nNo, the whole world will drown.\\pThis huge rain cloud is spreading\\nfrom above SOOTOPOLIS…\\pWhat in the world is taking place there?\\pThere's no point arguing here…\\nSOOTOPOLIS might provide answers…$"}
text:Route128.StevenImGoingToSootopolis	{'body': "STEVEN: SURF north to ROUTE 127,\\nthen west to ROUTE 126's white crater.\\pUse DIVE along its southern wall.\\nEnter the cavern and surface inside.\\pMeet me in SOOTOPOLIS. We must find\\nthe source of this storm.$"}
text:Route128.WAYNE_LocalConversation	{'body': 'DHELMISE is not fishing tackle.\\nImportant lesson. Expensive rod.$'}
text:Route12_FishingHouse_DoYouLikeToFish	{'body': "I'm the FISHING GURU's younger\\nbrother.\\pI simply looove fishing!\\nI can't bear to go without.\\pTell me, do you like to fish?$"}
text:Route12_FishingHouse_TakeThisAndFish	{'body': 'Grand! I like your style.\\nI think we can be friends.\\pTake this and fish, young friend!$'}
text:Route12_FishingHouse_ReceivedSuperRod	{'body': "{PLAYER} received a SUPER ROD from\\nthe FISHING GURU's brother.$"}
text:Route12_FishingHouse_IfYouCatchBigMagikarpShowMe	{'body': 'Fishing is a way of life!\\nIt is like the finest poetry.\\pFrom the seas to rivers, go out\\nand land the big one, my friend.\\pNow, I have a request.\\pIf you catch a big MAGIKARP \\nwith that ROD, I want to see it.\\pAs much as I love to fish, I also\\nlove seeing gigantic MAGIKARP.$'}
text:Route12_FishingHouse_OhThatsDisappointing	{'body': "Oh…\\nThat's so disappointing…$"}
text:Route12_FishingHouse_TryFishingBringMeMagikarp	{'body': "Hello there, {PLAYER}!\\nHave you been fishing?\\pTry fishing with the SUPER ROD in\\nany body of water.\\pYou'll find different POKéMON in\\ndifferent places.\\pOh, and don't forget to bring me\\ngigantic MAGIKARP.$"}
text:Route12_FishingHouse_OhMagikarpAllowMeToSee	{'body': "Oh? {PLAYER}?\\nWhy, if it isn't a MAGIKARP!\\pAllow me to see it, quick!$"}
text:Route12_FishingHouse_WhoaXSizeTakeThis	{'body': '… … …Whoa!\\n{STR_VAR_2}!\\pYou have a rare appreciation for\\nthe fine, poetic aspects of fishing!\\pYou must take this.\\nI insist!$'}
text:Route12_FishingHouse_LookForwardToGreaterRecords	{'body': "I'll look forward to seeing greater\\nrecords from you!$"}
text:Route12_FishingHouse_HuhXSizeSameSizeAsLast	{'body': 'Huh?\\n{STR_VAR_2}?\\pThis is the same size as the one\\nI saw before.$'}
text:Route12_FishingHouse_HmmXSizeDoesntMeasureUp	{'body': "Hmm…\\nThis one is {STR_VAR_2} long.\\pIt doesn't measure up to the\\n{STR_VAR_3} one you brought before.$"}
text:Route12_FishingHouse_DoesntLookLikeMagikarp	{'body': "Uh… That doesn't look much like\\na MAGIKARP.$"}
text:Route12_FishingHouse_NoRoomForGift	{'body': 'Oh, no!\\pI had a gift for you, but you have\\nno room for it.$'}
text:Route12_FishingHouse_MostGiganticMagikarpXSize	{'body': 'The most gigantic MAGIKARP\\nI have ever witnessed…\\p{STR_VAR_3}!$'}
text:Route12_FishingHouse_BlankChartOfSomeSort	{'body': "It's a blank chart of some sort.\\pIt has spaces for writing in\\nrecords of some kind.$"}
text:Route12_MonSprawledOutInSlumber	{'body': 'A POKéMON is sprawled out in\\na deep and comfortable slumber.$'}
text:SnorlaxWokeUp	{'body': 'SNORLAX woke up!\\pIt attacked in a grumpy rage!$'}
text:SnorlaxReturnedToMountains	{'body': 'SNORLAX calmed down.\\nIt gave a huge yawn…\\lAnd returned to the mountains.$'}
text:WantToUsePokeFlute	{'body': 'Want to use the POKé FLUTE?$'}
text:PlayedPokeFlute	{'body': '{PLAYER} played the POKé FLUTE.$'}
text:Route12_NedIntro	{'body': 'Yeah!\\nI got a bite here!$'}
text:Route12_NedDefeat	{'body': 'Tch!\\nJust a small fry…$'}
text:Route12_NedPostBattle	{'body': "Hang on!\\nMy line's snagged!$"}
text:Route12_ChipIntro	{'body': 'Be patient.\\nFishing is a waiting game.$'}
text:Route12_ChipDefeat	{'body': 'That one got away!$'}
text:Route12_ChipPostBattle	{'body': 'With a better ROD, I could catch\\nbetter POKéMON…$'}
text:Route12_JustinIntro	{'body': "I'm searching for a MOON STONE.\\nHave you found one?$"}
text:Route12_JustinDefeat	{'body': 'Oww!$'}
text:Route12_JustinPostBattle	{'body': 'I could have made my POKéMON\\nevolve with a MOON STONE.\\pI would have won then, I bet.$'}
text:Route12_LucaIntro	{'body': "Electricity is my specialty.\\pI don't know a thing about POKéMON\\nof the sea, though.$"}
text:Route12_LucaDefeat	{'body': 'Unplugged!$'}
text:Route12_LucaPostBattle	{'body': 'Water conducts electricity, so you\\nshould zap sea POKéMON.$'}
text:Route12_HankIntro	{'body': 'The FISHING FOOL versus POKéMON\\nKID!$'}
text:Route12_HankDefeat	{'body': 'Touch too much!$'}
text:Route12_HankPostBattle	{'body': "I guess you get to be good at\\nwhat you like.\\pWell, you beat me at POKéMON,\\nbut you can't top me at fishing.$"}
text:Route12_ElliotIntro	{'body': "I love fishing, don't get me wrong.\\pBut it'd be best if I also had more\\nwork.$"}
text:Route12_ElliotDefeat	{'body': "It's not easy…$"}
text:Route12_ElliotPostBattle	{'body': "It's all right.\\nLosing doesn't bug me anymore.$"}
text:Route12_AndrewIntro	{'body': "What's catching?\\pYou never know what you could\\ncatch!$"}
text:Route12_AndrewDefeat	{'body': 'Lost it!$'}
text:Route12_AndrewPostBattle	{'body': 'What, MAGIKARP?\\pI catch them all the time, sure.\\nBut, boy are they wimpy.$'}
text:Route12_RouteSign	{'body': 'ROUTE 12 \\nNorth to LAVENDER$'}
text:Route12_SportfishingArea	{'body': 'SPORTFISHING AREA$'}
text:Route12_JesIntro	{'body': "JES: If I win, I'm going to\\npropose to GIA.$"}
text:Route12_JesDefeat	{'body': "JES: Oh, please, why couldn't you\\nlet us win?$"}
text:Route12_JesPostBattle	{'body': 'JES: Oh, GIA, forgive me,\\nmy love!$'}
text:Route12_JesNotEnoughMons	{'body': "JES: GIA and I, we'll be\\ntogether forever.\\pWe won't battle unless you have\\ntwo POKéMON of your own.$"}
text:Route12_GiaIntro	{'body': "GIA: Hey, JES…\\pIf we win, I'll marry you!$"}
text:Route12_GiaDefeat	{'body': 'GIA: Oh, but why?$'}
text:Route12_GiaPostBattle	{'body': 'GIA: JES, you silly!\\nYou ruined this!$'}
text:Route12_GiaNotEnoughMons	{'body': "GIA: I can't bear to battle\\nwithout my JES!\\pDon't you have one more POKéMON?$"}
text:Route12_NorthEntrance_1F_LookoutSpotUpstairs	{'body': "There's a lookout spot upstairs.\\nThe view is magnificent.$"}
text:Route12_NorthEntrance_2F_TakeTMDontNeedAnymoreMale	{'body': "My POKéMON's ashes are stored in\\nPOKéMON TOWER.\\pYou can have this TM.\\nI don't need it anymore…$"}
text:Route12_NorthEntrance_2F_TakeTMDontNeedAnymoreFemale	{'body': "My POKéMON's ashes are stored in\\nPOKéMON TOWER.\\pYou can have this TM.\\nI don't need it anymore…$"}
text:Route12_NorthEntrance_2F_ReceivedTM27FromLittleGirl	{'body': '{PLAYER} received TM27\\nfrom the little girl.$'}
text:Route12_NorthEntrance_2F_ExplainTM27	{'body': 'TM27 is a move called RETURN…\\pIf you treat your POKéMON good,\\nit will return your love by working\\lits hardest in battle.$'}
text:Route12_NorthEntrance_2F_DontHaveRoomForThis	{'body': "You don't have room for this.$"}
text:Route12_NorthEntrance_2F_TheresManFishing	{'body': "Let's see what the binoculars have\\nto show…\\pThere's a man fishing!$"}
text:Route12_NorthEntrance_2F_ItsPokemonTower	{'body': "Let's see what the binoculars have\\nto show…\\pIt's POKéMON TOWER!$"}
text:Route133.VialNurseHelp	{'body': "We were swept onto this island by\\nRoute 133's current.\\pMay I borrow your help getting\\nChansey and me safely ashore?$"}
text:Route133.VialNurseUpgrade	{'body': 'Thank you! Before we go, I tuned your\\nPoké Vial one final time.\\pCenters will now refill three charges.$'}
text:Route133.VialNurseDecline	{'body': "We'll keep waiting for a safe opening.$"}
text:Route133.VialChansey	{'body': 'Chansey!$'}
text:Route133.FRANKLIN_LocalConversation	{'body': 'WALREIN offered me a ride.\\nThe seat was colder than expected.$'}
text:Route134.HITOSHI_LocalConversation	{'body': 'Even MACHAMP takes a rest day.\\nIt rests four arms. I rest two.$'}
text:Route13_SebastianIntro	{'body': 'My bird POKéMON want to battle\\nwith you!$'}
text:Route13_SebastianDefeat	{'body': 'My PIDGEY and PIDGEOTTO combo\\nlost?$'}
text:Route13_SebastianPostBattle	{'body': 'My POKéMON look happy even though\\nthey lost.$'}
text:Route13_SusieIntro	{'body': "I'm told I'm good for a kid.$"}
text:Route13_SusieDefeat	{'body': 'Ohh!\\nI lost!$'}
text:Route13_SusiePostBattle	{'body': "I want to become a good TRAINER.\\nI'll train hard, just watch.$"}
text:Route13_ValerieIntro	{'body': 'Wow!\\nYour BADGES are too cool!$'}
text:Route13_ValerieDefeat	{'body': 'Not enough!$'}
text:Route13_ValeriePostBattle	{'body': 'You got those BADGES from GYM\\nLEADERS. I know!$'}
text:Route13_GwenIntro	{'body': 'My cute POKéMON wish to make your\\nacquaintance.$'}
text:Route13_GwenDefeat	{'body': 'Good going!\\nYou totally won!$'}
text:Route13_GwenPostBattle	{'body': 'You have to make POKéMON battle\\nto toughen them up.$'}
text:Route13_AlmaIntro	{'body': 'I found CARBOS in a cave once\\nwhile I was spelunking.$'}
text:Route13_AlmaDefeat	{'body': 'Oh, too bad!\\nI just messed up!$'}
text:Route13_AlmaPostBattle	{'body': 'CARBOS boosted the SPEED of my\\nPOKéMON.$'}
text:Route13_PerryIntro	{'body': "I'm not going to lose.\\nNot when the wind's blowing my way!$"}
text:Route13_PerryDefeat	{'body': 'The wind turned!$'}
text:Route13_PerryPostBattle	{'body': "I'm beat.\\nI guess I'll FLY home.$"}
text:Route13_LolaIntro	{'body': "Sure, I'll play with you, sweetie.$"}
text:Route13_LolaDefeat	{'body': 'Oh!\\nYou little beast!$'}
text:Route13_LolaPostBattle	{'body': 'I wonder which is stronger, male or\\nfemale POKéMON?$'}
text:Route13_SheilaIntro	{'body': 'Do you want to battle some\\nPOKéMON with me?$'}
text:Route13_SheilaDefeat	{'body': "It's over already?$"}
text:Route13_SheilaPostBattle	{'body': "I don't know anything about\\nPOKéMON actually.\\pThe ones I use… I picked them\\nfor their looks!$"}
text:Route13_JaredIntro	{'body': "What're you lookin' at?$"}
text:Route13_JaredDefeat	{'body': 'Dang!\\nStripped gears!$'}
text:Route13_JaredPostBattle	{'body': 'Get lost!$'}
text:Route13_RobertIntro	{'body': "I always go with bird POKéMON.\\nI've dedicated myself to them.$"}
text:Route13_RobertDefeat	{'body': 'Out of power!$'}
text:Route13_RobertPostBattle	{'body': 'I wish I could fly like PIDGEY and\\nPIDGEOTTO…$'}
text:Route13_LookToLeftOfThatPost	{'body': 'TRAINER TIPS\\pLook, look!\\nLook to the left of that post!$'}
text:Route13_SelectToSwitchItems	{'body': 'TRAINER TIPS\\pUse SELECT to switch items in the\\nITEMS window.$'}
text:Route13_RouteSign	{'body': 'ROUTE 13\\nNorth to SILENCE BRIDGE$'}
text:Route14_CarterIntro	{'body': 'You need to use TMs to teach good\\nmoves to POKéMON.$'}
text:Route14_CarterDefeat	{'body': 'Not good enough quite yet.$'}
text:Route14_CarterPostBattle	{'body': "You have some HMs, right? POKéMON\\ncan't forget those moves easily.$"}
text:Route14_MitchIntro	{'body': 'My bird POKéMON should be ready\\nfor battle.$'}
text:Route14_MitchDefeat	{'body': 'Not ready yet!$'}
text:Route14_MitchPostBattle	{'body': 'My bird POKéMON need to learn\\nbetter moves.$'}
text:Route14_BeckIntro	{'body': "They have TMs on sale at the\\nCELADON DEPT. STORE.\\pTMs aren't really rare, but not\\nmany people have HMs.$"}
text:Route14_BeckDefeat	{'body': 'Aww, bummer!$'}
text:Route14_BeckPostBattle	{'body': "Try teaching POKéMON a move that's\\nthe same type as it.\\pThat apparently boosts the power\\nof the move.$"}
text:Route14_MarlonIntro	{'body': "Have you taught your bird POKéMON\\nhow to FLY?\\pYou'll be able to soar with it into\\nthe sky!$"}
text:Route14_MarlonDefeat	{'body': 'Shot down in flames!$'}
text:Route14_MarlonPostBattle	{'body': "Bird POKéMON are my one true love.\\nI don't want to raise anything else.$"}
text:Route14_DonaldIntro	{'body': 'Have you heard the legend of the\\nwinged mirages?$'}
text:Route14_DonaldDefeat	{'body': "Why?\\nWhy'd I lose?$"}
text:Route14_DonaldPostBattle	{'body': 'Well, the winged mirages are the\\nlegendary bird POKéMON.\\pThere are three of them: ARTICUNO,\\nZAPDOS, and MOLTRES.$'}
text:Route14_BennyIntro	{'body': "I'm not into it, but okay.\\nLet's go!$"}
text:Route14_BennyDefeat	{'body': 'I knew it!$'}
text:Route14_BennyPostBattle	{'body': "Winning, losing… It's insignificant\\nunder this huge sky.$"}
text:Route14_LukasIntro	{'body': "C'mon, c'mon.\\nLet's go, let's go, let's go!$"}
text:Route14_LukasDefeat	{'body': 'Arrg!\\nLost! Get lost!$'}
text:Route14_LukasPostBattle	{'body': 'What, what, what?\\nWhat do you want still?$'}
text:Route14_IsaacIntro	{'body': 'I need to burn some time.\\nShut up and battle.$'}
text:Route14_IsaacDefeat	{'body': 'What?\\nYou!?$'}
text:Route14_IsaacPostBattle	{'body': 'Raising POKéMON is a drag, man.$'}
text:Route14_GeraldIntro	{'body': 'We ride out here because of the\\nwide-open spaces.$'}
text:Route14_GeraldDefeat	{'body': 'Wipeout!$'}
text:Route14_GeraldPostBattle	{'body': "It's cool you made your POKéMON so\\nstrong.\\pMight is right!\\nAnd you know it!$"}
text:Route14_MalikIntro	{'body': 'POKéMON battle?\\nCool! Rumble!$'}
text:Route14_MalikDefeat	{'body': 'Blown away!$'}
text:Route14_MalikPostBattle	{'body': "You know who'd win, you and me\\none-on-one!$"}
text:Route14_RouteSign	{'body': 'ROUTE 14\\nWest to FUCHSIA CITY$'}
text:Route14_KiriIntro	{'body': "KIRI: JAN, let's try really,\\nreally hard together.$"}
text:Route14_KiriDefeat	{'body': "KIRI: Whimper…\\nWe lost, didn't we?$"}
text:Route14_KiriPostBattle	{'body': 'KIRI: Did we lose because of me?$'}
text:Route14_KiriNotEnoughMons	{'body': 'KIRI: We can battle if you have\\ntwo POKéMON.$'}
text:Route14_JanIntro	{'body': 'JAN: KIRI, here we go!\\nWe have to try hard!$'}
text:Route14_JanDefeat	{'body': 'JAN: Eeeeh!\\nNo fair!$'}
text:Route14_JanPostBattle	{'body': "JAN: KIRI, don't cry!\\nWe'll just try harder next time.$"}
text:Route14_JanNotEnoughMons	{'body': "JAN: You want to battle?\\nYou don't have enough POKéMON.$"}
text:Route15_KindraIntro	{'body': 'I just got some POKéMON in trades.\\nCan I try them out on you?$'}
text:Route15_KindraDefeat	{'body': 'Not good enough!$'}
text:Route15_KindraPostBattle	{'body': "You can't change the nickname of\\nany POKéMON you get in a trade.\\pOnly the Original TRAINER can get\\nthe nickname changed.$"}
text:Route15_BeckyIntro	{'body': "You look gentle, so I think I can\\nbeat you.\\pI'll give it a go!$"}
text:Route15_BeckyDefeat	{'body': 'No, wrong!$'}
text:Route15_BeckyPostBattle	{'body': "I'm afraid of BIKERS. They look so\\nugly and mean!$"}
text:Route15_EdwinIntro	{'body': 'When I whistle, I can summon bird\\nPOKéMON.$'}
text:Route15_EdwinDefeat	{'body': "Ow!\\nThat's tragic!$"}
text:Route15_EdwinPostBattle	{'body': "Maybe I'm not cut out for battles.\\nI'm not the right type, I guess.$"}
text:Route15_ChesterIntro	{'body': "Hmm? My birds are shivering!\\nYou're good, aren't you?$"}
text:Route15_ChesterDefeat	{'body': 'Just as I thought!$'}
text:Route15_ChesterPostBattle	{'body': 'This is so obvious, you should know\\nthis, but…\\pMoves like EARTHQUAKE and FISSURE\\nhave no effect on bird POKéMON.$'}
text:Route15_GraceIntro	{'body': "Oh, you're a little cutie!\\nSo like a darling POKéMON!$"}
text:Route15_GraceDefeat	{'body': 'You looked so cute, too!$'}
text:Route15_GracePostBattle	{'body': "I forgive you.\\nI can take it.\\lI'm a big girl now.$"}
text:Route15_OliviaIntro	{'body': 'I raise POKéMON for protection\\nbecause I live alone.$'}
text:Route15_OliviaDefeat	{'body': "POKéMON isn't about winning or\\nlosing for me.$"}
text:Route15_OliviaPostBattle	{'body': "I love having my POKéMON greet me\\nwhen I get home.\\pIt's so reassuring.$"}
text:Route15_ErnestIntro	{'body': "Hey, kid! C'mon!\\nI just got these off some loser!$"}
text:Route15_ErnestDefeat	{'body': 'Why not?$'}
text:Route15_ErnestPostBattle	{'body': "Life's too short.\\nIt's cool to live as an outlaw.\\lTEAM ROCKET RULES!$"}
text:Route15_AlexIntro	{'body': 'Fork over all your cash when you\\nlose to me, kid!$'}
text:Route15_AlexDefeat	{'body': "That can't be true!$"}
text:Route15_AlexPostBattle	{'body': "I was just joking about the money.\\nDon't take me all serious.$"}
text:Route15_CeliaIntro	{'body': "What's cool and happening?\\nTrading POKéMON!$"}
text:Route15_CeliaDefeat	{'body': 'I said trade!$'}
text:Route15_CeliaPostBattle	{'body': 'I trade POKéMON with my friends\\nall the time.$'}
text:Route15_YazminIntro	{'body': 'Want to play with my POKéMON?$'}
text:Route15_YazminDefeat	{'body': 'I was too impatient!$'}
text:Route15_YazminPostBattle	{'body': "I'll go train with weaker people.$"}
text:Route15_RouteSign	{'body': 'ROUTE 15\\nWest to FUCHSIA CITY$'}
text:Route15_MyaIntro	{'body': "MYA: You're perfect.\\nHelp me train my little brother?$"}
text:Route15_MyaDefeat	{'body': "MYA: RON, you have to focus!\\nConcentrate on what you're doing!$"}
text:Route15_MyaPostBattle	{'body': "MYA: Okay, we'll turn it up.\\nI'll add to our training menu!$"}
text:Route15_MyaNotEnoughMons	{'body': "MYA: Do you want to challenge us?\\nYou'll need two POKéMON, though.$"}
text:Route15_RonIntro	{'body': 'RON: My sister gets scary when we\\nlose.$'}
text:Route15_RonDefeat	{'body': "RON: Oh, no, no…\\nSis, I'm sorry!$"}
text:Route15_RonPostBattle	{'body': 'RON: Oh, bleah…\\nI wish I had a nice sister…$'}
text:Route15_RonNotEnoughMons	{'body': 'RON: Did you want to battle with\\nmy sister and me?\\pYou need two POKéMON, then.$'}
text:Route15_WestEntrance_1F_OaksAideCameByHere	{'body': "Are you the kid who's working on\\na POKéDEX?\\pPROF. OAK's AIDE came by here.$"}
text:Route15_WestEntrance_2F_GiveItemIfCaughtEnough	{'body': "Hi! Remember me?\\nI'm one of PROF. OAK's AIDES.\\pIf your POKéDEX has complete data\\non {STR_VAR_1} species, I'm supposed to\\lgive you a reward.\\pPROF. OAK entrusted me with the\\n{STR_VAR_2} for you.\\pSo, {PLAYER}, let me ask you.\\pHave you gathered data on at least\\n{STR_VAR_1} kinds of POKéMON?$"}
text:Route15_WestEntrance_2F_GreatHereYouGo	{'body': 'Great! You have caught or owned\\n{STR_VAR_3} kinds of POKéMON!\\pCongratulations!\\nHere you go!$'}
text:Route15_WestEntrance_2F_ReceivedItemFromAide	{'body': '{PLAYER} received the {STR_VAR_2}\\nfrom the AIDE.$'}
text:Route15_WestEntrance_2F_ExplainExpShare	{'body': 'EXP. SHARE is an item to be held\\nby a POKéMON.\\pThe POKéMON will receive a share\\nof the EXP. Points without having\\lto battle.$'}
text:Route15_WestEntrance_2F_LargeShiningBird	{'body': "Let's see what the binoculars have\\nto show…\\pA large, shining bird is flying\\ntoward the sea.$"}
text:Route15_WestEntrance_2F_SmallIslandOnHorizon	{'body': "Let's see what the binoculars have\\nto show…\\pIt looks like a small island on\\nthe horizon!$"}
text:Route16_LaoIntro	{'body': 'What do you want?$'}
text:Route16_LaoDefeat	{'body': "Don't you dare laugh!$"}
text:Route16_LaoPostBattle	{'body': "We like just hanging here.\\nWhat's it to you?$"}
text:Route16_KojiIntro	{'body': 'Nice BIKE!\\nHand it over!$'}
text:Route16_KojiDefeat	{'body': 'Knockout!$'}
text:Route16_KojiPostBattle	{'body': 'Forget it, who needs your BIKE!$'}
text:Route16_LukeIntro	{'body': 'Come out and play, little mouse!$'}
text:Route16_LukeDefeat	{'body': 'You little rat!$'}
text:Route16_LukePostBattle	{'body': 'I hate losing!\\nGet out of my face!$'}
text:Route16_HideoIntro	{'body': 'Hey, you just bumped me!$'}
text:Route16_HideoDefeat	{'body': 'Kaboom!$'}
text:Route16_HideoPostBattle	{'body': "We'll always be hanging around here\\neven if you don't like it.\\pYou can detour to VERMILION from\\nFUCHSIA going along the coast.$"}
text:Route16_CamronIntro	{'body': "I'm feeling hungry and mean!\\nI need a punching bag!$"}
text:Route16_CamronDefeat	{'body': 'Bad, bad, bad!$'}
text:Route16_CamronPostBattle	{'body': "If I'm going to have POKéMON, they\\nmay as well be ferocious.\\pI'd use them to leave my enemies\\nin tatters.$"}
text:Route16_RubenIntro	{'body': "Hey, there!\\nLet's have ourselves a good time!$"}
text:Route16_RubenDefeat	{'body': "Don't make me mad!$"}
text:Route16_RubenPostBattle	{'body': "I get my kicks by harassing people\\nwith my stinking POKéMON.\\pThey're great for startling people.\\nAnd, they bite, too.$"}
text:Route16_MonSprawledOutInSlumber	{'body': 'A POKéMON is sprawled out in\\na deep and comfortable slumber.$'}
text:Route16_CyclingRoadSign	{'body': 'Enjoy the slope!\\nCYCLING ROAD$'}
text:Route16_RouteSign	{'body': 'ROUTE 16\\nCELADON CITY - FUCHSIA CITY$'}
text:Route16_JedIntro	{'body': "JED: Our love knows no bounds.\\nWe're in love and we show it!$"}
text:Route16_JedDefeat	{'body': 'JED: Oh, no!\\nMy love has seen me as a loser!$'}
text:Route16_JedPostBattle	{'body': 'JED: Listen, LEA.\\nYou need to focus less on me.$'}
text:Route16_JedNotEnoughMons	{'body': 'JED: You have just one POKéMON?\\nIs there no love in your heart?$'}
text:Route16_LeaIntro	{'body': 'LEA: Sometimes, the intensity of\\nour love scares me.$'}
text:Route16_LeaDefeat	{'body': 'LEA: Ohh! But JED looks cool\\neven in a loss!$'}
text:Route16_LeaPostBattle	{'body': "LEA: Ehehe, I'm sorry.\\nJED is so cool.$"}
text:Route16_LeaNotEnoughMons	{'body': "LEA: Oh, you don't have two\\nPOKéMON with you?\\pDoesn't it feel lonely for you or\\nyour POKéMON?$"}
text:Route16_House_FoundMySecretRetreat	{'body': "Oh, dear.\\nYou've found my secret retreat.\\pPlease don't tell anyone I'm here.\\nI'll make it up to you with this!$"}
text:Route16_House_ReceivedHM02FromGirl	{'body': '{PLAYER} received HM02\\nfrom the girl.$'}
text:Route16_House_ExplainHM02	{'body': "HM02 is FLY.\\nIt's a wonderfully convenient move.\\pPlease, put it to good use.$"}
text:Route16_House_DontHaveAnyRoomForThis	{'body': "You don't have any room for this.$"}
text:Route16_House_Fearow	{'body': 'FEAROW: Kyueen!$'}
text:Route16_NorthEntrance_1F_NoPedestriansOnCyclingRoad	{'body': 'No pedestrians are allowed on\\nCYCLING ROAD!$'}
text:Route16_NorthEntrance_1F_CyclingRoadIsDownhillCourse	{'body': "CYCLING ROAD is a downhill course\\nby the sea. It's a great ride.$"}
text:Route16_NorthEntrance_1F_ExcuseMeWaitUp	{'body': 'Excuse me!\\nWait up, please!$'}
text:Route16_NorthEntrance_1F_HowdYouGetInGoodEffort	{'body': "How'd you get in?\\nGood effort!$"}
text:Route16_NorthEntrance_2F_OnBikeRideWithGirlfriend	{'body': "I'm on a relaxing ride on my new\\nbike with my girlfriend.$"}
text:Route16_NorthEntrance_2F_RidingTogetherOnNewBikes	{'body': "We're going riding together on our\\nnew bikes.$"}
text:Route16_NorthEntrance_2F_ItsCeladonDeptStore	{'body': "Let's see what the binoculars have\\nto show…\\pIt's the CELADON DEPT. STORE!$"}
text:Route16_NorthEntrance_2F_LongPathOverWater	{'body': "Let's see what the binoculars have\\nto show…\\pThere's a long path over water far\\naway.$"}
text:Route16_NorthEntrance_2F_GiveAmuletCoinIfCaught40	{'body': "Hi! Remember me?\\nI'm one of PROF. OAK's AIDES.\\pIf your POKéDEX has complete data\\non 40 species, I'm supposed to\\lgive you a reward.\\pPROF. OAK entrusted me with an\\nAMULET COIN for you.\\pSo, {PLAYER}, let me ask you.\\pHave you gathered data on at least\\n40 kinds of POKéMON?$"}
text:Route16_NorthEntrance_2F_GreatHereYouGo	{'body': 'Great! You have caught or owned\\n{STR_VAR_3} kinds of POKéMON!\\pCongratulations!\\nHere you go!$'}
text:Route16_NorthEntrance_2F_ReceivedAmuletCoinFromAide	{'body': '{PLAYER} received the AMULET COIN\\nfrom the AIDE.$'}
text:Route16_NorthEntrance_2F_ExplainAmuletCoin	{'body': 'An AMULET COIN is an item to be\\nheld by a POKéMON.\\pIf the POKéMON appears in a winning\\nbattle, you will earn more money.$'}
text:Route17_RaulIntro	{'body': "There's no getting rich quick in\\nbattling kids.$"}
text:Route17_RaulDefeat	{'body': 'Burned out!$'}
text:Route17_RaulPostBattle	{'body': "You can find good stuff lying\\naround on CYCLING ROAD.\\pThere's good money in picking them\\nup and selling them.$"}
text:Route17_IsaiahIntro	{'body': "I'm mighty proud of my bod, kiddo.\\nCome on!$"}
text:Route17_IsaiahDefeat	{'body': 'Whoo!$'}
text:Route17_IsaiahPostBattle	{'body': 'I could belly-bump you outta\\nhere!$'}
text:Route17_VirgilIntro	{'body': 'You heading to FUCHSIA?$'}
text:Route17_VirgilDefeat	{'body': 'Crash and burn!$'}
text:Route17_VirgilPostBattle	{'body': 'I love racing downhill!$'}
text:Route17_BillyIntro	{'body': "We're BIKERS!\\nWe rule the roads, man!$"}
text:Route17_BillyDefeat	{'body': 'Smoked!$'}
text:Route17_BillyPostBattle	{'body': 'Are you looking for adventure?$'}
text:Route17_NikolasIntro	{'body': 'Let VOLTORB electrify you!$'}
text:Route17_NikolasDefeat	{'body': 'Grounded out!$'}
text:Route17_NikolasPostBattle	{'body': 'I got my VOLTORB at the abandoned\\nPOWER PLANT.$'}
text:Route17_ZeekIntro	{'body': "I leveled up my POKéMON, but it\\nwon't evolve. Why?$"}
text:Route17_ZeekDefeat	{'body': 'Why, you!$'}
text:Route17_ZeekPostBattle	{'body': 'Maybe some POKéMON need element\\nSTONES to evolve.$'}
text:Route17_JamalIntro	{'body': 'I need a little exercise!$'}
text:Route17_JamalDefeat	{'body': 'Whew!\\nGood workout!$'}
text:Route17_JamalPostBattle	{'body': "I'm sure I lost weight there!$"}
text:Route17_CoreyIntro	{'body': 'Be a rebel!$'}
text:Route17_CoreyDefeat	{'body': 'Aaaargh!$'}
text:Route17_CoreyPostBattle	{'body': 'Be ready to fight for your beliefs!$'}
text:Route17_JaxonIntro	{'body': "Nice BIKE!\\nHow's it handle?$"}
text:Route17_JaxonDefeat	{'body': 'Shoot!$'}
text:Route17_JaxonPostBattle	{'body': 'The slope makes it hard to steer.$'}
text:Route17_WilliamIntro	{'body': "Get lost, kid!\\nI'm bushed!$"}
text:Route17_WilliamDefeat	{'body': 'Are you satisfied?$'}
text:Route17_WilliamPostBattle	{'body': "I need to catch a few z's!$"}
text:Route17_WatchOutForDiscardedItems	{'body': "It's a notice.\\pWatch out for discarded items.$"}
text:Route17_SameSpeciesGrowDifferentRates	{'body': 'TRAINER TIPS\\pAll POKéMON are unique.\\pEven POKéMON of the same species\\nand level grow at different rates.$'}
text:Route17_PressBToStayInPlace	{'body': 'TRAINER TIPS\\pPress the B Button to stay in place\\nwhile on a slope.$'}
text:Route17_RouteSign	{'body': 'ROUTE 17\\nCELADON CITY - FUCHSIA CITY$'}
text:Route17_DontThrowGameThrowBalls	{'body': "It's a notice!\\pDon't throw the game, throw POKé\\nBALLS instead!$"}
text:Route17_CyclingRoadSign	{'body': 'CYCLING ROAD\\nSlope ends here!$'}
text:Route18_EastEntrance_1F_NeedBicycleForCyclingRoad	{'body': 'You need a BICYCLE to go out on\\nCYCLING ROAD!$'}
text:Route18_EastEntrance_1F_CyclingRoadAllUphillFromHere	{'body': 'CYCLING ROAD is all uphill from\\nhere.$'}
text:Route18_EastEntrance_1F_ExcuseMe	{'body': 'Excuse me!$'}
text:Route18_EastEntrance_2F_PalletTownInWest	{'body': "Let's see what the binoculars have\\nto show…\\pPALLET TOWN is in the west.$"}
text:Route18_EastEntrance_2F_PeopleSwimming	{'body': "Let's see what the binoculars have\\nto show…\\pThere are people swimming.$"}
text:Route18_WiltonIntro	{'body': 'I always check every grassy area\\nfor new POKéMON.$'}
text:Route18_WiltonDefeat	{'body': 'Tch!$'}
text:Route18_WiltonPostBattle	{'body': 'I wish I had a BIKE!$'}
text:Route18_RamiroIntro	{'body': 'Kurukkoo!\\nHow do you like my birdcall?$'}
text:Route18_RamiroDefeat	{'body': 'I had to bug you!$'}
text:Route18_RamiroPostBattle	{'body': 'I collect sea POKéMON on weekends\\nbecause the sea is so close.$'}
text:Route18_JacobIntro	{'body': 'This is my turf!\\nGet out of here!$'}
text:Route18_JacobDefeat	{'body': 'Darn!$'}
text:Route18_JacobPostBattle	{'body': 'This is my fave area for catching\\nPOKéMON.$'}
text:Route18_RouteSign	{'body': 'ROUTE 18\\nCELADON CITY - FUCHSIA CITY$'}
text:Route18_CyclingRoadSign	{'body': 'CYCLING ROAD\\nNo pedestrians permitted!$'}
text:Route19_RichardIntro	{'body': 'I have to exercise and warm up\\nbefore going out for a swim.$'}
text:Route19_RichardDefeat	{'body': 'All warmed up!$'}
text:Route19_RichardPostBattle	{'body': "Thanks, kid!\\nI'm ready for a swim.$"}
text:Route19_ReeceIntro	{'body': "Wait! Slow down!\\nYou'll have a heart attack!$"}
text:Route19_ReeceDefeat	{'body': "Ooh!\\nThat's chilly!$"}
text:Route19_ReecePostBattle	{'body': 'Watch out for TENTACOOL.\\nThey sting so painfully.$'}
text:Route19_MatthewIntro	{'body': 'I love swimming!\\nWhat about you?$'}
text:Route19_MatthewDefeat	{'body': 'Belly flop!$'}
text:Route19_MatthewPostBattle	{'body': 'I can beat even marine POKéMON\\nat swimming.$'}
text:Route19_DouglasIntro	{'body': "What's beyond the horizon?$"}
text:Route19_DouglasDefeat	{'body': 'Glub!$'}
text:Route19_DouglasPostBattle	{'body': 'I see a couple of islands over\\nyonder!$'}
text:Route19_DavidIntro	{'body': 'I tried diving for POKéMON, but it\\nwas a no-go.$'}
text:Route19_DavidDefeat	{'body': 'Help!$'}
text:Route19_DavidPostBattle	{'body': 'I guess you have to fish for sea\\nPOKéMON.$'}
text:Route19_TonyIntro	{'body': 'I look at the sea to forget all\\nthe bad things that happened.$'}
text:Route19_TonyDefeat	{'body': 'Ooh!\\nTraumatic!$'}
text:Route19_TonyPostBattle	{'body': "I'm looking at the sea to forget\\nthe bad thing that happened!$"}
text:Route19_AnyaIntro	{'body': 'Oh, I just love your ride!\\nCan I have it if I win?$'}
text:Route19_AnyaDefeat	{'body': 'Oh! I lost!$'}
text:Route19_AnyaPostBattle	{'body': "It's still a long way to go to\\nSEAFOAM ISLANDS…\\pI want to go back to FUCHSIA…$"}
text:Route19_AliceIntro	{'body': "Swimming's great!\\nSunburns aren't!$"}
text:Route19_AliceDefeat	{'body': 'Shocker!$'}
text:Route19_AlicePostBattle	{'body': 'My boyfriend wanted to swim to\\nSEAFOAM ISLANDS.$'}
text:Route19_AxleIntro	{'body': 'Ahoy, there!\\nThese waters are treacherous!$'}
text:Route19_AxleDefeat	{'body': 'Ooh!\\nDangerous!$'}
text:Route19_AxlePostBattle	{'body': 'M-my legs! They cramped up!\\nGlub, glub…$'}
text:Route19_ConnieIntro	{'body': "I swam here with my friends…\\nI'm tired…$"}
text:Route19_ConnieDefeat	{'body': "I'm exhausted…$"}
text:Route19_ConniePostBattle	{'body': "If I were to ride a POKéMON on\\nthe sea, I'd like a LAPRAS.\\pLAPRAS is so big, I bet it\\nwould keep me dry on water.$"}
text:Route19_RouteSign	{'body': 'SEA ROUTE 19\\nFUCHSIA CITY - SEAFOAM ISLANDS$'}
text:Route19_LiaIntro	{'body': "LIA: I'm looking after my brother.\\nHe just became a TRAINER.$"}
text:Route19_LiaDefeat	{'body': "LIA: That's no way to treat my\\nlittle brother!$"}
text:Route19_LiaPostBattle	{'body': "LIA: Do you have a younger\\nbrother?\\pI hope you're teaching him all\\nsorts of things.$"}
text:Route19_LiaNotEnoughMons	{'body': "LIA: I want to battle together\\nwith my little brother.\\pDon't you have two POKéMON?$"}
text:Route19_LucIntro	{'body': 'LUC: My big sis taught me how\\nto swim and train POKéMON.$'}
text:Route19_LucDefeat	{'body': 'LUC: Oh, wow!\\nSomeone tougher than my big sis!$'}
text:Route19_LucPostBattle	{'body': "LUC: My big sis is strong and nice.\\nI think she's awesome!$"}
text:Route19_LucNotEnoughMons	{'body': "LUC: I don't want to if I can't\\nbattle you with my big sis.\\pDon't you have two POKéMON?$"}
text:Route1_WorkAtPokeMartTakeSample	{'body': "Hi!\\nI work at a POKéMON MART.\\pIt's part of a convenient chain\\nselling all sorts of items.\\pPlease, visit us in VIRIDIAN CITY.\\pI know, I'll give you a sample.\\nHere you go!$"}
text:Route1_ComeSeeUsIfYouNeedPokeBalls	{'body': 'Please come see us if you need\\nPOKé BALLS for catching POKéMON.$'}
text:Route1_PutPotionAway	{'body': "{PLAYER} put the POTION away in\\nthe BAG's ITEMS POCKET.$"}
text:Route1_CanJumpFromLedges	{'body': "See those ledges along the road?\\pIt's a bit scary, but you can jump\\nfrom them.\\pYou can get back to PALLET TOWN\\nquicker that way.$"}
text:Route1_RouteSign	{'body': 'ROUTE 1\\nPALLET TOWN - VIRIDIAN CITY$'}
text:Route20_BarryIntro	{'body': 'The water is shallow here.\\nThere are many people swimming.$'}
text:Route20_BarryDefeat	{'body': 'Splash!$'}
text:Route20_BarryPostBattle	{'body': "I wish I could ride my POKéMON.\\nI bet you're not tired.$"}
text:Route20_ShirleyIntro	{'body': "SEAFOAM is a quiet getaway.\\nI'm vacationing here.$"}
text:Route20_ShirleyDefeat	{'body': 'Quit it!$'}
text:Route20_ShirleyPostBattle	{'body': "There's a huge cavern underneath\\nthis island.$"}
text:Route20_TiffanyIntro	{'body': 'I love floating with the fishes\\nhere among the waves.$'}
text:Route20_TiffanyDefeat	{'body': 'Yowch!$'}
text:Route20_TiffanyPostBattle	{'body': 'Want to float with me?$'}
text:Route20_IreneIntro	{'body': 'Are you on vacation, too?$'}
text:Route20_IreneDefeat	{'body': 'No mercy at all!$'}
text:Route20_IrenePostBattle	{'body': 'SEAFOAM used to be a single island\\nin the distant past.$'}
text:Route20_DeanIntro	{'body': 'Check out my buff physique!$'}
text:Route20_DeanDefeat	{'body': 'Wimpy!$'}
text:Route20_DeanPostBattle	{'body': "I should've been buffing up my\\nPOKéMON, not me!$"}
text:Route20_DarrinIntro	{'body': "Why are you riding a POKéMON?\\nCan't you swim?$"}
text:Route20_DarrinDefeat	{'body': 'Ouch!\\nTorpedoed!$'}
text:Route20_DarrinPostBattle	{'body': 'Riding a POKéMON sure looks fun!$'}
text:Route20_RogerIntro	{'body': 'I rode my bird POKéMON here.$'}
text:Route20_RogerDefeat	{'body': 'Oh, no!\\nNow what am I to do?$'}
text:Route20_RogerPostBattle	{'body': "My birds are exhausted.\\nThey can't FLY me back!$"}
text:Route20_NoraIntro	{'body': 'My boyfriend gave me big pearls.$'}
text:Route20_NoraDefeat	{'body': 'Oh, no!\\nMy pearls were in them!$'}
text:Route20_NoraPostBattle	{'body': 'Will my pearls grow bigger inside\\nCLOYSTER?$'}
text:Route20_MissyIntro	{'body': "I swam here from CINNABAR ISLAND.\\nIt wasn't easy, I tell you.$"}
text:Route20_MissyDefeat	{'body': "I'm so disappointed!$"}
text:Route20_MissyPostBattle	{'body': 'POKéMON have taken over an\\nabandoned mansion on CINNABAR.\\pThey call it the POKéMON MANSION\\nnow.$'}
text:Route20_MelissaIntro	{'body': 'CINNABAR, in the west, has a LAB\\nfor POKéMON.\\pMy daddy works there.$'}
text:Route20_MelissaDefeat	{'body': "Wait!\\nYou're supposed to wait!$"}
text:Route20_MelissaPostBattle	{'body': 'CINNABAR is a volcanic island.\\pI heard it rose out of the sea\\nwhen a volcano erupted.$'}
text:Route20_SeafoamIslands	{'body': 'SEAFOAM ISLANDS$'}
text:Route20_MistyTrainsHere	{'body': 'Strong TRAINERS and WATER POKéMON\\nare common sights in these parts.\\pThey say that MISTY of the\\nCERULEAN GYM trains here.$'}
text:Route21_North_RonaldIntro	{'body': 'You want to know if the fish are\\nbiting?$'}
text:Route21_North_RonaldDefeat	{'body': 'Dang!$'}
text:Route21_North_RonaldPostBattle	{'body': "I can't catch anything good.\\nNot one good POKéMON to be had!$"}
text:Route21_North_WadeIntro	{'body': 'I got a big haul!\\nWanna go for it?$'}
text:Route21_North_WadeDefeat	{'body': "Heheh, MAGIKARP just don't make\\nthe grade, do they?$"}
text:Route21_North_WadePostBattle	{'body': 'I seem to only catch MAGIKARP!$'}
text:Route21_North_SpencerIntro	{'body': 'The sea cleanses my body and soul!$'}
text:Route21_North_SpencerDefeat	{'body': 'Ayah!$'}
text:Route21_North_SpencerPostBattle	{'body': 'The sea is great and all, but I\\nlike the mountains, too.$'}
text:Route21_North_CueBallIntro	{'body': 'おれだって\u3000たまには\\nおよぎに\u3000くるぜ！$'}
text:Route21_North_CueBallDefeat	{'body': 'ぐわわ！$'}
text:Route21_North_CueBallPostBattle	{'body': 'うきやすそう\u3000だと？\\nうるせー\u3000おおきな\u3000おせわだッ！$'}
text:Route21_South_JackIntro	{'body': 'I caught my POKéMON at sea.$'}
text:Route21_South_JackDefeat	{'body': 'Diver!!\\nDown!!$'}
text:Route21_South_JackPostBattle	{'body': "Where'd you catch your POKéMON?$"}
text:Route21_South_JeromeIntro	{'body': "Right now, I'm in a triathlon meet.$"}
text:Route21_South_JeromeDefeat	{'body': 'Pant…\\nPant… Pant…$'}
text:Route21_South_JeromePostBattle	{'body': "I'm beat! But, I still have the\\nbike race and marathon left!$"}
text:Route21_South_RolandIntro	{'body': 'Ahh!\\nFeel the sun and the wind!$'}
text:Route21_South_RolandDefeat	{'body': 'Yow!\\nI lost!$'}
text:Route21_South_RolandPostBattle	{'body': "I'm sunburnt to a crisp!$"}
text:Route21_South_ClaudeIntro	{'body': "Hey, don't scare away the fish!$"}
text:Route21_South_ClaudeDefeat	{'body': "Sorry! I'm just so frustrated from\\nnot catching anything.$"}
text:Route21_South_ClaudePostBattle	{'body': "Sheesh, I haven't caught a thing.\\nCould this place actually be a\\lgiant pool or something?$"}
text:Route21_South_NolanIntro	{'body': 'Keep me company till I get a hit.$'}
text:Route21_South_NolanDefeat	{'body': 'That burned some time.$'}
text:Route21_South_NolanPostBattle	{'body': 'Oh wait!\\nI got a bite! Yeah!$'}
text:Route21_North_LilIntro	{'body': "LIL: Huh? A battle?\\nIAN, can't you do it alone?$"}
text:Route21_North_LilDefeat	{'body': 'LIL: Oh, see?\\nWe lost. Happy now?$'}
text:Route21_North_LilPostBattle	{'body': "LIL: I'm tired.\\nCan't we go home already?$"}
text:Route21_North_LilNotEnoughMons	{'body': "LIL: Huh? A battle?\\nI can't be bothered to do it alone.\\lBring two POKéMON, won't you?$"}
text:Route21_North_IanIntro	{'body': "IAN: My sis doesn't get enough\\nexercise, so I made her come.$"}
text:Route21_North_IanDefeat	{'body': 'IAN: Awww, Sis!\\nGet it together!$'}
text:Route21_North_IanPostBattle	{'body': "IAN: Come on, Sis!\\pYou're not going to lose weight\\nlike this!$"}
text:Route21_North_IanNotEnoughMons	{'body': 'IAN: We want a two-on-two battle.\\nSo can you bring two POKéMON?$'}
text:Route22_EarlyRivalIntro	{'body': "{RIVAL}: Hey! {PLAYER}!\\pYou're off to the POKéMON LEAGUE?\\nForget about it!\\pYou probably don't have any\\nBADGES, do you?\\pThe guard won't let you through\\nwithout them.\\pBy the way, did your POKéMON get\\nany stronger?$"}
text:Route22_EarlyRivalDefeat	{'body': 'Awww!\\nYou just lucked out!$'}
text:Route22_EarlyRivalPostBattle	{'body': 'I heard the POKéMON LEAGUE is\\ncrawling with tough TRAINERS.\\pI have to figure out how to get\\npast them.\\pYou should quit dawdling and get a\\nmove on!$'}
text:Route22_RivalShouldCatchSomeMons	{'body': '{RIVAL}“なんだ？\\nポケモン\u30002ひきも\\lもってるの\u3000なぜか\u3000だって？\\pおまえも\\nつかまえれば\u3000いい\u3000じゃん！$'}
text:Route22_LateRivalIntro	{'body': "{RIVAL}: What? {PLAYER}!\\nWhat a surprise to see you here!\\pSo you're going to the POKéMON\\nLEAGUE?\\pYou collected all the BADGES, too?\\nThat's cool!\\pThen I'll whip you, {PLAYER}, as a\\nwarm-up for the POKéMON LEAGUE!\\pCome on!$"}
text:Route22_LateRivalDefeat	{'body': 'What!?\\pI was just careless, you!$'}
text:Route22_LateRivalPostBattle	{'body': "That loosened me up.\\nI'm ready for the POKéMON LEAGUE!\\p{PLAYER}, you need more practice.\\pBut hey, you know that!\\nI'm out of here. Smell ya!$"}
text:Route22_LateRivalVictory	{'body': '{RIVAL}“ひゃははッ\u3000{PLAYER}ー！\\nそれで\u3000がんばってるのかよ！\\lおれの\u3000さいのうに\u3000くらべりゃ\\l{PLAYER}は\u3000まだまだ\u3000だな！\\pもっと\u3000れんしゅう\u3000こいよ！\\nあははーッ！$'}
text:Route22_LeagueGateSign	{'body': 'POKéMON LEAGUE\\nFront Gate$'}
text:Route23_VictoryRoadGateSign	{'body': 'VICTORY ROAD GATE -\\nPOKéMON LEAGUE$'}
text:Route24_JustEarnedFabulousPrize	{'body': 'Congratulations! You beat our\\nfive contest TRAINERS!\\pYou just earned a fabulous prize!$'}
text:Route24_ReceivedNuggetFromMysteryTrainer	{'body': '{PLAYER} received a NUGGET\\nfrom the mystery TRAINER!$'}
text:Route24_YouDontHaveAnyRoom	{'body': "You don't have any room!$"}
text:Route24_JoinTeamRocket	{'body': "By the way, how would you like to\\njoin TEAM ROCKET?\\pWe're a group of professional\\ncriminals specializing in POKéMON!\\pWant to join?\\pAre you sure?\\pCome on, join us!\\pI'm telling you to join!\\p…Okay, you need convincing!\\pI'll make you an offer you can't\\nrefuse!$"}
text:Route24_RocketDefeat	{'body': 'Arrgh!\\nYou are good!$'}
text:Route24_YoudBecomeTopRocketLeader	{'body': "With your ability, you'd become\\na top leader in TEAM ROCKET.\\pCome on, think of the opportunity!\\nDon't let this chance go to waste.$"}
text:Route24_ShaneIntro	{'body': 'I saw your feat from the grass!$'}
text:Route24_ShaneDefeat	{'body': 'I thought not!$'}
text:Route24_ShanePostBattle	{'body': 'I hid because the people on the\\nbridge frightened me.$'}
text:Route24_EthanIntro	{'body': "Okay! I'm No. 5!\\nI'll stomp you!$"}
text:Route24_EthanDefeat	{'body': 'Whoa!\\nToo much!$'}
text:Route24_EthanPostBattle	{'body': 'I did my best. I have no regrets!$'}
text:Route24_ReliIntro	{'body': "I'm No. 4!\\nGetting tired?$"}
text:Route24_ReliDefeat	{'body': 'I lost, too!$'}
text:Route24_ReliPostBattle	{'body': "I did my best, so I've no regrets!$"}
text:Route24_TimmyIntro	{'body': "Here's No. 3!\\nI won't be easy!$"}
text:Route24_TimmyDefeat	{'body': 'Ow!\\nStomped flat!$'}
text:Route24_TimmyPostBattle	{'body': 'I did my best. I have no regrets!$'}
text:Route24_AliIntro	{'body': "I'm second!\\nNow it's serious!$"}
text:Route24_AliDefeat	{'body': 'How could I lose?$'}
text:Route24_AliPostBattle	{'body': 'I did my best. I have no regrets!$'}
text:Route24_CaleIntro	{'body': 'People call this the NUGGET\\nBRIDGE!\\pBeat us five TRAINERS and win\\na fabulous prize!\\pThink you got what it takes?$'}
text:Route24_CaleDefeat	{'body': 'Whoo!\\nGood stuff!$'}
text:Route24_CalePostBattle	{'body': 'I did my best. I have no regrets!$'}
text:Route25_JoeyIntro	{'body': 'Local TRAINERS come here to\\npractice.$'}
text:Route25_JoeyDefeat	{'body': "You're decent.$"}
text:Route25_JoeyPostBattle	{'body': "All POKéMON have weaknesses.\\nEven the strongest ones.\\pThat's why it's best to raise\\nPOKéMON of different types.$"}
text:Route25_DanIntro	{'body': 'Dad took me to a great party on\\nthe S.S. ANNE at VERMILION CITY.$'}
text:Route25_DanDefeat	{'body': "I'm not mad!$"}
text:Route25_DanPostBattle	{'body': 'On the S.S. ANNE, I saw TRAINERS\\nfrom around the world.$'}
text:Route25_FlintIntro	{'body': "I'm a cool guy.\\nI've got a girlfriend!$"}
text:Route25_FlintDefeat	{'body': 'Aww, darn…$'}
text:Route25_FlintPostBattle	{'body': 'Oh, well.\\nMy girlfriend will cheer me up.$'}
text:Route25_KelseyIntro	{'body': 'Hi!\\nMy boyfriend is cool!$'}
text:Route25_KelseyDefeat	{'body': "My conditioning isn't the best…$"}
text:Route25_KelseyPostBattle	{'body': 'I wish my boyfriend was as good\\nas you.$'}
text:Route25_ChadIntro	{'body': 'I had this feeling…\\nI knew I had to battle you!$'}
text:Route25_ChadDefeat	{'body': "I knew I'd lose, too!$"}
text:Route25_ChadPostBattle	{'body': "If your POKéMON gets confused,\\nswitch it out.\\pThat's a good tactic.$"}
text:Route25_HaleyIntro	{'body': "My friend has many cute POKéMON.\\nI'm so jealous!$"}
text:Route25_HaleyDefeat	{'body': "I'm not so jealous!$"}
text:Route25_HaleyPostBattle	{'body': 'You came from MT. MOON?\\nMay I have a CLEFAIRY?$'}
text:Route25_FranklinIntro	{'body': "I just got down from MT. MOON,\\nbut I've still got gas in the tank!$"}
text:Route25_FranklinDefeat	{'body': 'You worked hard!$'}
text:Route25_FranklinPostBattle	{'body': 'Drat!\\nA ZUBAT bit me back in that cave.$'}
text:Route25_NobIntro	{'body': "I'm off to see a POKéMANIAC's\\ncollection at the cape.$"}
text:Route25_NobDefeat	{'body': 'You done got me, and real good,\\ntoo!$'}
text:Route25_NobPostBattle	{'body': 'The POKéMANIAC sure lives up to\\nhis name.\\pHis collection includes many rare\\nspecies of POKéMON.$'}
text:Route25_WayneIntro	{'body': "You're going to see BILL?\\nFirst, we battle!$"}
text:Route25_WayneDefeat	{'body': "You're something.$"}
text:Route25_WaynePostBattle	{'body': 'The trail below is a shortcut to\\nCERULEAN CITY.$'}
text:Route25_SeaCottageSign	{'body': 'SEA COTTAGE\\nBILL lives here!$'}
text:Route25_MistyHighHopesAboutThisPlace	{'body': 'This cape is a famous date spot.\\pMISTY, the GYM LEADER, has high\\nhopes about this place.$'}
text:Route25_AreYouHereAlone	{'body': "Hello, are you here alone?\\pIf you're out at CERULEAN's cape…\\nWell, it should be as a couple.$"}
text:Route25_SeaCottage_ImBillHelpMeOutPal	{'body': "Hiya! I'm a POKéMON…\\n…No I'm not!\\pCall me BILL!\\nI'm a true-blue POKéMANIAC!\\pHey!\\nWhat's with that skeptical look?\\pI'm not joshing you, pal.\\pI screwed up an experiment and got\\ncombined with a POKéMON!\\pSo, how about it?\\nHelp me out here!$"}
text:Route25_SeaCottage_ImBillHelpMeOutLady	{'body': "Hiya! I'm a POKéMON…\\n…No I'm not!\\pCall me BILL!\\nI'm a true-blue POKéMANIAC!\\pHey!\\nWhat's with that skeptical look?\\pI'm not joshing you, lady.\\pI screwed up an experiment and got\\ncombined with a POKéMON!\\pSo, how about it?\\nHelp me out here!$"}
text:Route25_SeaCottage_RunCellSeparationOnPC	{'body': 'Wait till I get inside the\\nTELEPORTER.\\pWhen I do, go to my PC and run\\nthe Cell Separation System.$'}
text:Route25_SeaCottage_NoPleaseChief	{'body': "No!?\\nNow don't be so cold!\\pCome on, you gotta help a guy in\\ndeep, deep trouble!\\pWhat do you say, chief?\\nPlease?\\lOkay?\\lAll right!$"}
text:Route25_SeaCottage_NoPleaseBeautiful	{'body': "No!?\\nNow don't be so cold!\\pCome on, you gotta help a guy in\\ndeep, deep trouble!\\pWhat do you say, beautiful?\\nPlease?\\lOkay?\\lAll right!$"}
text:Route25_SeaCottage_ThanksBudTakeThis	{'body': "BILL: Yeehah!\\nThanks, bud! I owe you one!\\pSo, did you come to see my\\nPOKéMON collection?\\pYou didn't?\\nThat's a bummer.\\pI've got to thank you…\\nOh, here, maybe this'll do.$"}
text:Route25_SeaCottage_ThanksLadyTakeThis	{'body': "BILL: Yeehah!\\nThanks, lady! I owe you one!\\pSo, did you come to see my\\nPOKéMON collection?\\pYou didn't?\\nThat's a bummer.\\pI've got to thank you…\\nOh, here, maybe this'll do.$"}
text:Route25_SeaCottage_ReceivedSSTicketFromBill	{'body': '{PLAYER} received an S.S. TICKET\\nfrom BILL.$'}
text:Route25_SeaCottage_YouveGotTooMuchStuff	{'body': "You've got too much stuff!$"}
text:Route25_SeaCottage_SSAnnePartyYouGoInstead	{'body': "That cruise ship S.S. ANNE is in\\nVERMILION CITY.\\pI hear there are lots of TRAINERS\\non board, too.\\pThey invited me to their party, but\\nI can't stand fancy do's.\\pWhy don't you go instead of me?\\nGo on and have a good time.$"}
text:Route25_SeaCottage_CheckOutRareMonsOnPC	{'body': 'BILL: Feel like checking out some\\nof my rare POKéMON on my PC?\\pGo on, check out my PC.$'}
text:Route25_SeaCottage_TeleporterIsDisplayed	{'body': 'TELEPORTER is displayed on the PC\\nmonitor.$'}
text:Route25_SeaCottage_InitiatedTeleportersCellSeparator	{'body': "{PLAYER} initiated the TELEPORTER's\\nCell Separator.$"}
text:Route25_SeaCottage_BillsFavoriteMonList	{'body': "BILL's favorite POKéMON list!$"}
text:Route25_SeaCottage_SeeWhichMon	{'body': 'Which POKéMON do you want to see?$'}
text:Route2_EastBuilding_GiveHM05IfSeen10Mons	{'body': "Hi! Remember me?\\nI'm one of PROF. OAK's AIDES.\\pIf your POKéDEX has complete data\\non ten species, I'm supposed to\\lgive you a reward.\\pPROF. OAK entrusted me with\\nHM05 for you.\\pSo, {PLAYER}, let me ask you.\\pHave you gathered data on at least\\nten kinds of POKéMON?$"}
text:Route2_EastBuilding_GreatHereYouGo	{'body': 'Great! You have caught or owned\\n{STR_VAR_3} kinds of POKéMON!\\pCongratulations!\\nHere you go!$'}
text:Route2_EastBuilding_ReceivedHM05FromAide	{'body': '{PLAYER} received HM05\\nfrom the AIDE.$'}
text:Route2_EastBuilding_ExplainHM05	{'body': 'HM05 contains the hidden move\\nFLASH.\\pFLASH lights up even the darkest\\nof caves and dungeons.$'}
text:Route2_EastBuilding_CanGetThroughRockTunnel	{'body': 'Once a POKéMON learns FLASH, you\\ncan get through ROCK TUNNEL.$'}
text:Route2_RouteSign	{'body': 'ROUTE 2\\nVIRIDIAN CITY - PEWTER CITY$'}
text:Route2_DiglettsCave	{'body': "DIGLETT'S CAVE$"}
text:Route2_House_FaintedMonsCanUseFieldMoves	{'body': 'A fainted POKéMON just has no\\nenergy left to battle.\\pIt can still use moves like CUT\\noutside of battle.$'}
text:Route2_ViridianForest_NorthEntrance_ManyMonsOnlyInForests	{'body': 'Many POKéMON live only in forests \\nand caves.\\pYou need to be persistent and look\\neverywhere to get different kinds.$'}
text:Route2_ViridianForest_NorthEntrance_CanCutSkinnyTrees	{'body': 'Have you noticed the skinny trees\\non the roadside?\\pThey can be cut down by a special\\nPOKéMON move, I hear.$'}
text:Route2_ViridianForest_NorthEntrance_CanCancelEvolution	{'body': "Do you know the evolution-cancel\\ntechnique?\\pWhen a POKéMON is evolving, you\\ncan stop the process.\\pIt's a technique for raising\\nPOKéMON the way they are.$"}
text:Route2_ViridianForest_SouthEntrance_ForestIsMaze	{'body': "Are you going to VIRIDIAN FOREST?\\nIt's a natural maze in there.\\lBe careful you don't get lost.$"}
text:Route2_ViridianForest_SouthEntrance_RattataHasWickedBite	{'body': "RATTATA may be small, but don't\\nunderestimate its wicked bite.\\pHave you caught one already?$"}
text:Route3_TunnelFromCeruleanTiring	{'body': 'Whew… I better take a rest…\\nGroan…\\pThat tunnel from CERULEAN takes a\\nlot out of you!$'}
text:Route3_ColtonIntro	{'body': 'Hey!\\nI saw you in VIRIDIAN FOREST!$'}
text:Route3_ColtonDefeat	{'body': 'You beat me again!$'}
text:Route3_ColtonPostBattle	{'body': 'There are other kinds of POKéMON\\nthan the ones you find in forests.$'}
text:Route3_BenIntro	{'body': "Hi!\\nI like shorts!\\pThey're delightfully comfy and\\neasy to wear!$"}
text:Route3_BenDefeat	{'body': "I don't believe it!$"}
text:Route3_BenPostBattle	{'body': "Are you using a POKéMON CENTER's\\nPC for storing your POKéMON?\\pEach BOX can hold up to\\n30 POKéMON.$"}
text:Route3_JaniceIntro	{'body': "Excuse me!\\nYou looked at me, didn't you?$"}
text:Route3_JaniceDefeat	{'body': "You're mean!$"}
text:Route3_JanicePostBattle	{'body': "You shouldn't be staring if you\\ndon't want to battle!$"}
text:Route3_GregIntro	{'body': "Are you a TRAINER?\\nLet's get with it right away!$"}
text:Route3_GregDefeat	{'body': "If I had new POKéMON, I would've\\nwon!$"}
text:Route3_GregPostBattle	{'body': 'If a POKéMON BOX on the PC gets\\nfull, just switch to another BOX.$'}
text:Route3_SallyIntro	{'body': "That look you gave me…\\nIt's so intriguing!$"}
text:Route3_SallyDefeat	{'body': 'Be nice!$'}
text:Route3_SallyPostBattle	{'body': 'You can avoid battles by not\\nletting TRAINERS see you.$'}
text:Route3_CalvinIntro	{'body': "Hey! You're not wearing shorts!\\nWhat's wrong with you?$"}
text:Route3_CalvinDefeat	{'body': 'Lost!\\nLost! Lost!$'}
text:Route3_CalvinPostBattle	{'body': "I always wear shorts, even in\\nwinter. That's my policy.$"}
text:Route3_JamesIntro	{'body': "I'll battle you with the POKéMON\\nI just caught.$"}
text:Route3_JamesDefeat	{'body': 'Done like dinner!$'}
text:Route3_JamesPostBattle	{'body': 'Trained POKéMON are stronger than\\nthe wild ones.$'}
text:Route3_RobinIntro	{'body': 'Eek!\\nDid you touch me?$'}
text:Route3_RobinDefeat	{'body': "That's it?$"}
text:Route3_RobinPostBattle	{'body': 'ROUTE 4 is at the foot of\\nMT. MOON.$'}
text:Route3_RouteSign	{'body': 'ROUTE 3\\nMT. MOON AHEAD$'}
text:Route4_TrippedOverGeodude	{'body': 'Ouch! I tripped over a rocky\\nPOKéMON, GEODUDE!$'}
text:Route4_CrissyIntro	{'body': 'I came to MT. MOON in search of\\nmushroom POKéMON.$'}
text:Route4_CrissyDefeat	{'body': 'After all I did to catch them!$'}
text:Route4_CrissyPostBattle	{'body': 'There might not be any more\\nmushrooms here.\\pI think I got them all.$'}
text:Route4_MtMoonEntrance	{'body': 'MT. MOON\\nTunnel Entrance$'}
text:Route4_RouteSign	{'body': 'ROUTE 4\\nMT. MOON - CERULEAN CITY$'}
text:MegaPunchTeach	{'body': 'A punch of roaring ferocity!\\pPacked with destructive power!\\pWhen the chips are down,\\nMEGA PUNCH is the ultimate attack!\\lYou agree, yes?\\pNow!\\nLet me teach it to your POKéMON!$'}
text:MegaPunchDeclined	{'body': "You'll be back when you understand\\nthe worth of MEGA PUNCH.$"}
text:MegaPunchWhichMon	{'body': 'Fine!\\nWhich POKéMON will learn it?$'}
text:MegaPunchTaught	{'body': "Now, we are comrades in the way of\\npunching!\\pYou should go before you're seen\\nby the misguided fool who trains\\lonly his silly kicking over there.$"}
text:MegaKickTeach	{'body': "A kick of brutal ferocity!\\pPacked with destructive power!\\pWhen you get right down to it,\\nMEGA KICK is the ultimate attack!\\lDon't you agree?\\pOkay!\\nI'll teach it to your POKéMON!$"}
text:MegaKickDeclined	{'body': "You'll come crawling back when you\\nrealize the value of MEGA KICK.$"}
text:MegaKickWhichMon	{'body': 'All right!\\nWhich POKéMON wants to learn it?$'}
text:MegaKickTaught	{'body': "Now, we are soul mates in the way\\nof kicking!\\pYou should run before you're seen\\nby the deluded nitwit who trains\\lonly simple punching over there.$"}
text:Route4_PeopleLikeAndRespectBrock	{'body': "Oh, wow, that's the BOULDERBADGE!\\nYou got it from BROCK, didn't you?\\pBROCK is cool. He's not just tough.\\nPeople like and respect him.\\pI want to become a GYM LEADER\\nlike him.$"}
text:Route4_PokemonCenter_1F_CanHaveSixMonsWithYou	{'body': "Okay, set six POKé BALLS in my\\nbelt…\\pYeah, that'll do it. At most, you\\ncan have six POKéMON with you.$"}
text:Route4_PokemonCenter_1F_TeamRocketAttacksCerulean	{'body': 'TEAM ROCKET attacks CERULEAN\\ncitizens…\\pNot a day goes by without TEAM\\nROCKET being in the news.$'}
text:Route4_PokemonCenter_1F_LaddieBuyMagikarpForJust500	{'body': "MAN: Hello there, laddie!\\nHave I got a deal just for you!\\pI'll let you have a secret POKéMON\\n- a MAGIKARP - for just ¥500!\\pSo, you'll buy it, am I right?$"}
text:Route4_PokemonCenter_1F_SweetieBuyMagikarpForJust500	{'body': "MAN: Hello there, sweetie pie!\\nHave I got a deal just for you!\\pI'll let you have a secret POKéMON\\n- a MAGIKARP - for just ¥500!\\pSo, you'll buy it, am I right?$"}
text:Route4_PokemonCenter_1F_PaidOutrageouslyForMagikarp	{'body': '{PLAYER} paid an outrageous ¥500\\nand bought the MAGIKARP…$'}
text:Route4_PokemonCenter_1F_OnlyDoingThisAsFavorToYou	{'body': "No? You say no? I'm only doing this\\nas a favor to you!$"}
text:Route4_PokemonCenter_1F_NoRoomForMorePokemon	{'body': "There's no more room for any more\\nPOKéMON, it looks like.$"}
text:Route4_PokemonCenter_1F_YoullNeedMoreMoney	{'body': "You'll need more money than that!$"}
text:Route4_PokemonCenter_1F_IDontGiveRefunds	{'body': "MAN: Well, I don't give refunds.\\nYou knew what you were getting!$"}
text:Route4_PokemonCenter_1F_ShouldStoreMonsUsingPC	{'body': "Sometimes, you'll have too many\\nPOKéMON with you to add any more.\\pIn that case, you should just\\nstore some using any PC.$"}
text:Route4_PokemonCenter_1F_ItsANewspaper	{'body': "It's a newspaper.$"}
text:Route5_UndergroundPathSign	{'body': 'UNDERGROUND PATH\\nCERULEAN CITY - VERMILION CITY$'}
text:Route5_PokemonDayCare_WantMeToRaiseMon	{'body': 'I run the DAY-CARE service.\\pWould you like me to raise one of\\nyour POKéMON?$'}
text:Route5_PokemonDayCare_ComeAgain	{'body': 'Come again.$'}
text:Route5_PokemonDayCare_WhichMonShouldIRaise	{'body': 'Which POKéMON should I raise?$'}
text:Route5_PokemonDayCare_ComeAnytimeYouLike	{'body': 'Fine.\\nCome anytime you like.$'}
text:Route5_PokemonDayCare_LookAfterMonForAWhile	{'body': "Fine, I'll look after your\\n{STR_VAR_1} for a while.$"}
text:Route5_PokemonDayCare_ComeSeeMeInAWhile	{'body': 'Come see me in a while.$'}
text:Route5_PokemonDayCare_MonNeedsToSpendMoreTime	{'body': "You're back already?\\pYour {STR_VAR_1} needs to spend\\nsome more time with me.$"}
text:Route5_PokemonDayCare_OweMeXForMonsReturn	{'body': 'You owe me ¥{STR_VAR_2} for the return\\nof this POKéMON.$'}
text:Route5_PokemonDayCare_ThankYouHeresMon	{'body': "Thank you!\\nHere's your POKéMON.$"}
text:Route5_PokemonDayCare_PlayerGotMonBack	{'body': '{PLAYER} got {STR_VAR_1} back\\nfrom the DAY-CARE MAN.$'}
text:Route5_PokemonDayCare_OnlyHaveOneMonWithYou	{'body': 'Oh? You only have one POKéMON\\nwith you.$'}
text:Route5_PokemonDayCare_WhatWillYouBattleWith	{'body': 'If you leave me that POKéMON,\\nwhat will you battle with?$'}
text:Route5_PokemonDayCare_MonHasGrownByXLevels	{'body': "Your {STR_VAR_1} has grown a lot.\\nYes, quite a lot, I'd say.\\pLet me see…\\nBy level, it's grown by {STR_VAR_2}.\\pAren't I great?$"}
text:Route5_PokemonDayCare_YouveGotNoRoomForIt	{'body': "You can't take this POKéMON back\\nif you've got no room for it.$"}
text:Route5_PokemonDayCare_DontHaveEnoughMoney	{'body': "You don't have enough money.$"}
text:Route5_PokemonDayCare_WantMeToTakeALookAtYours	{'body': 'きみの\\nみてみるかね？$'}
text:Route5_PokemonDayCare_CantAcceptMonWithHM	{'body': 'わるいけど\u3000ひでんのわざを\u3000もった\\nポケモンは\u3000あずかれないなぁ$'}
text:Route5_SouthEntrance_ThirstyOnGuardDuty	{'body': "I'm on guard duty.\\nGee, I'm thirsty, though!\\pOh, wait there, the road's closed.$"}
text:Route5_SouthEntrance_ThatTeaLooksTasty	{'body': 'Oh, that TEA…\\nIt looks awfully tasty…$'}
text:Route5_SouthEntrance_ThanksIllShareTeaWithGuards	{'body': "Huh? I can have this drink?\\nGee, thanks!\\l… …\\lGlug, glug…\\l… …\\lGulp…\\lIf you want to go to SAFFRON\\lCITY…\\l… …\\lYou can go on through.\\pI'll share this TEA with the other\\nguards!$"}
text:Route5_SouthEntrance_HiHowsItGoing	{'body': "Hi, how's it going?$"}
text:Route6_RickyIntro	{'body': "Who's there?\\nQuit listening in on us!$"}
text:Route6_RickyDefeat	{'body': "I just can't win!$"}
text:Route6_RickyPostBattle	{'body': 'Whisper…\\nWhisper…$'}
text:Route6_NancyIntro	{'body': 'Excuse me!\\nThis is a private conversation!$'}
text:Route6_NancyDefeat	{'body': 'Ugh!\\nI hate losing.$'}
text:Route6_NancyPostBattle	{'body': 'Whisper…\\nWhisper…$'}
text:Route6_KeigoIntro	{'body': "There aren't many bugs out here.$"}
text:Route6_KeigoDefeat	{'body': "No!\\nYou're kidding!$"}
text:Route6_KeigoPostBattle	{'body': "I like bugs, so I'm going back to\\nVIRIDIAN FOREST.$"}
text:Route6_JeffIntro	{'body': 'Huh?\\nYou want to talk to me?$'}
text:Route6_JeffDefeat	{'body': "This stinks…\\nI couldn't beat your challenge…$"}
text:Route6_JeffPostBattle	{'body': "I should bring more POKéMON with\\nme. I'll feel safer that way.$"}
text:Route6_IsabelleIntro	{'body': "Me?\\nWell, okay. I'll play!$"}
text:Route6_IsabelleDefeat	{'body': "Things just didn't work…$"}
text:Route6_IsabellePostBattle	{'body': "I want to get stronger.\\nWhat's your secret?$"}
text:Route6_ElijahIntro	{'body': "I've never seen you around.\\nAre you good?$"}
text:Route6_ElijahDefeat	{'body': "You're too good!$"}
text:Route6_ElijahPostBattle	{'body': 'Are my POKéMON weak?\\nOr, am I just bad?\\lWhich do you think?$'}
text:Route6_UndergroundPathSign	{'body': 'UNDERGROUND PATH\\nCERULEAN CITY - VERMILION CITY$'}
text:Route6_NorthEntrance_ThirstyOnGuardDuty	{'body': "I'm on guard duty.\\nGee, I'm thirsty, though!\\pOh, wait there, the road's closed.$"}
text:Route6_NorthEntrance_ThatTeaLooksTasty	{'body': 'Oh, that TEA…\\nIt looks awfully tasty…$'}
text:Route6_NorthEntrance_ThanksIllShareTeaWithGuards	{'body': "Huh? I can have this drink?\\nGee, thanks!\\l… …\\lGlug, glug…\\l… …\\lGulp…\\lIf you want to go to SAFFRON\\lCITY…\\l… …\\lYou can go on through.\\pI'll share this TEA with the other\\nguards!$"}
text:Route6_NorthEntrance_HiHowsItGoing	{'body': "Hi, how's it going?$"}
text:Route7_EastEntrance_ThirstyOnGuardDuty	{'body': "I'm on guard duty.\\nGee, I'm thirsty, though!\\pOh, wait there, the road's closed.$"}
text:Route7_EastEntrance_ThatTeaLooksTasty	{'body': 'Oh, that TEA…\\nIt looks awfully tasty…$'}
text:Route7_EastEntrance_ThanksIllShareTeaWithGuards	{'body': "Huh? I can have this drink?\\nGee, thanks!\\l… …\\lGlug, glug…\\l… …\\lGulp…\\lIf you want to go to SAFFRON\\lCITY…\\l… …\\lYou can go on through.\\pI'll share this TEA with the other\\nguards!$"}
text:Route7_EastEntrance_HiHowsItGoing	{'body': "Hi, how's it going?$"}
text:Route7_UndergroundPathSign	{'body': 'UNDERGROUND PATH\\nCELADON CITY - LAVENDER TOWN$'}
text:Route8_AidanIntro	{'body': 'You look good at POKéMON, but how\\nis your chemistry grade?$'}
text:Route8_AidanDefeat	{'body': 'Ow!\\nMeltdown!$'}
text:Route8_AidanPostBattle	{'body': 'I am better at school than this!$'}
text:Route8_StanIntro	{'body': "All right!\\nLet's play a game!$"}
text:Route8_StanDefeat	{'body': 'Drat!\\nCame up short!$'}
text:Route8_StanPostBattle	{'body': "Things didn't work today.$"}
text:Route8_GlennIntro	{'body': 'You should be informed.\\nYou need strategy to win at this!$'}
text:Route8_GlennDefeat	{'body': "It's not logical!$"}
text:Route8_GlennPostBattle	{'body': 'Go with GRIMER first…and…\\n…and…then…$'}
text:Route8_PaigeIntro	{'body': 'I like NIDORAN, so I collect them!$'}
text:Route8_PaigeDefeat	{'body': 'Why?\\nWhy??$'}
text:Route8_PaigePostBattle	{'body': "When POKéMON grow up, they get\\nugly! They shouldn't evolve.$"}
text:Route8_LeslieIntro	{'body': 'School is fun, but so are POKéMON.$'}
text:Route8_LeslieDefeat	{'body': 'You made it clear to me that\\nI should stick with school.$'}
text:Route8_LesliePostBattle	{'body': "I was planning on getting some\\nfresh air for a change, but…\\pWe're stuck here because of the\\ngates at SAFFRON.$"}
text:Route8_AndreaIntro	{'body': 'MEOWTH is so cute, meow, meow,\\nmeow!$'}
text:Route8_AndreaDefeat	{'body': 'Meeeeyow!$'}
text:Route8_AndreaPostBattle	{'body': 'I think PIDGEY and RATTATA are\\ncute, too!$'}
text:Route8_MeganIntro	{'body': 'We must look silly standing here\\nlike this.$'}
text:Route8_MeganDefeat	{'body': 'Look what you did to my poor, cute\\nPOKéMON!$'}
text:Route8_MeganPostBattle	{'body': "SAFFRON's gatekeeper won't let us\\ngo through.\\pI know he's doing his job, but I\\nthink he's mean.$"}
text:Route8_RichIntro	{'body': "I'm a rambling, gaming dude!$"}
text:Route8_RichDefeat	{'body': 'Missed the big chance!$'}
text:Route8_RichPostBattle	{'body': "Playing games and POKéMON are like\\neating peanuts! I just can't stop!$"}
text:Route8_JuliaIntro	{'body': "What's a cute, round, and fluffy\\nPOKéMON?$"}
text:Route8_JuliaDefeat	{'body': "Stop!\\pDon't be so mean to my CLEFAIRY!$"}
text:Route8_JuliaPostBattle	{'body': "I read that CLEFAIRY evolves when\\nit's exposed to a MOON STONE.\\pI read that in a POKéMON JOURNAL.\\nI wonder if it's true?$"}
text:Route8_UndergroundPathSign	{'body': 'UNDERGROUND PATH\\nCELADON CITY - LAVENDER TOWN$'}
text:Route8_EliIntro	{'body': 'ELI: Twin power is fantastic.\\nDid you know?$'}
text:Route8_EliDefeat	{'body': 'ELI: But…\\nWe used our twin power…$'}
text:Route8_EliPostBattle	{'body': 'ELI: I caught my POKéMON with\\nANNE!$'}
text:Route8_EliNotEnoughMons	{'body': "ELI: We can't battle if you don't\\nhave two POKéMON.$"}
text:Route8_AnneIntro	{'body': "ANNE: We'll shock you with our twin\\npower!$"}
text:Route8_AnneDefeat	{'body': 'ANNE: Our twin power…$'}
text:Route8_AnnePostBattle	{'body': "ANNE: I'm raising POKéMON with\\nELI.$"}
text:Route8_AnneNotEnoughMons	{'body': "ANNE: Hi, hi! Let's battle!\\nBut bring two POKéMON.$"}
text:Route8_RicardoIntro	{'body': "My bike's acting up, man.$"}
text:Route8_RicardoDefeat	{'body': "Aww, man.\\nI'm not into this.$"}
text:Route8_RicardoPostBattle	{'body': 'I got grass caught up in my\\nspokes, man.$'}
text:Route8_JarenIntro	{'body': "Clear the way, or I'll run you\\ndown!$"}
text:Route8_JarenDefeat	{'body': 'You for real, kid?$'}
text:Route8_JarenPostBattle	{'body': "Don't think you're all special and\\nall just because of this.$"}
text:Route8_WestEntrance_ThirstyOnGuardDuty	{'body': "I'm on guard duty.\\nGee, I'm thirsty, though!\\pOh, wait there, the road's closed.$"}
text:Route8_WestEntrance_ThatTeaLooksTasty	{'body': 'Oh, that TEA…\\nIt looks awfully tasty…$'}
text:Route8_WestEntrance_ThanksIllShareTeaWithGuards	{'body': "Huh? I can have this drink?\\nGee, thanks!\\l… …\\lGlug, glug…\\l… …\\lGulp…\\lIf you want to go to SAFFRON\\lCITY…\\l… …\\lYou can go on through.\\pI'll share this TEA with the other\\nguards!$"}
text:Route8_WestEntrance_HiHowsItGoing	{'body': "Hi, how's it going?$"}
text:Route9_AliciaIntro	{'body': "You have POKéMON with you!\\nYou're mine!$"}
text:Route9_AliciaDefeat	{'body': 'You deceived me…$'}
text:Route9_AliciaPostBattle	{'body': "The tunnel coming up is pitch-black\\ninside.\\pYou'll need FLASH to get through\\nthere.$"}
text:Route9_ChrisIntro	{'body': "Who's that walking there with those\\ngood-looking POKéMON?$"}
text:Route9_ChrisDefeat	{'body': 'Out like a light!$'}
text:Route9_ChrisPostBattle	{'body': 'Keep walking!$'}
text:Route9_DrewIntro	{'body': "I'm taking the ROCK TUNNEL to\\ngo to LAVENDER…$"}
text:Route9_DrewDefeat	{'body': "Can't measure up…$"}
text:Route9_DrewPostBattle	{'body': 'Are you off to ROCK TUNNEL, too?$'}
text:Route9_CaitlinIntro	{'body': "Don't you dare patronize me!$"}
text:Route9_CaitlinDefeat	{'body': "No!\\nYou're too much.$"}
text:Route9_CaitlinPostBattle	{'body': "You're obviously talented.\\nGood luck to you!$"}
text:Route9_JeremyIntro	{'body': 'Bwahaha!\\nGreat! I was bored, eh!$'}
text:Route9_JeremyDefeat	{'body': "Keep it coming, eh!\\pOh wait.\\nI'm out of POKéMON!$"}
text:Route9_JeremyPostBattle	{'body': 'You sure had guts standing up to\\nme there, eh?$'}
text:Route9_BriceIntro	{'body': "Hahaha!\\nAren't you a little toughie!$"}
text:Route9_BriceDefeat	{'body': "What's that?$"}
text:Route9_BricePostBattle	{'body': 'Hahaha!\\nKids should be tough!$'}
text:Route9_BrentIntro	{'body': 'I got up early every day to raise\\nmy POKéMON from cocoons!$'}
text:Route9_BrentDefeat	{'body': 'WHAT?\\pWhat a total waste of time!$'}
text:Route9_BrentPostBattle	{'body': 'I have to collect more than bugs\\nto get stronger…$'}
text:Route9_AlanIntro	{'body': 'Hahahaha!\\nBring it on!$'}
text:Route9_AlanDefeat	{'body': 'Hahahaha!\\nYou beat me fair!$'}
text:Route9_AlanPostBattle	{'body': 'Hahahaha!\\nUs hearty guys always laugh!$'}
text:Route9_ConnerIntro	{'body': 'Go, my super BUG POKéMON!$'}
text:Route9_ConnerDefeat	{'body': 'My bugs…$'}
text:Route9_ConnerPostBattle	{'body': "If you don't like BUG POKéMON,\\nyou bug me!$"}
text:Route9_RouteSign	{'body': 'ROUTE 9\\nCERULEAN CITY - ROCK TUNNEL$'}
text:RustboroCity.RoxanneRestoredBefore	{'body': 'Stone alone is not a strategy.\\pStudy the partners in my GYM, then\\nshow me how your own team connects.$'}
text:RustboroCity.RoxanneRestoredAfter	{'body': 'Your STONE BADGE proves you can solve\\nmore than a type chart.\\pDEVON may have a task for you next.$'}
text:RustboroCity.WeShortenItToDevon	{'body': 'The DEVON CORPORATION…\\nWe all just shorten it to DEVON.\\pThat company makes all sorts of\\nconvenient products.$'}
text:RustboroCity.SneakyLookingManWentAroundCorner	{'body': 'Hm? A sneaky-looking man?\\pCome to think of it, yes, a shady-\\nlooking guy went around the corner.$'}
text:RustboroCity.HaveYouChallengedGym	{'body': 'Have you taken the POKéMON GYM\\nchallenge?\\pWhen you get that shiny GYM BADGE\\nin hand, I guess TRAINERS begin to\\lrealize what is required of them.$'}
text:RustboroCity.HeyThatsRustborosGymBadge	{'body': "Hey, that's RUSTBORO's GYM BADGE!\\pOut of all the POKéMON GYM BADGES,\\nRUSTBORO's is the coolest, I'd say.$"}
text:RustboroCity.YoureNewAroundHere	{'body': "Oh? Who might you be?\\nYou're a new face around these parts.\\pHave you just transferred into the\\nPOKéMON TRAINER'S SCHOOL?$"}
text:RustboroCity.GymLeaderIsntEasyWithFire	{'body': "I challenged the GYM LEADER, but…\\pIt's not going to be easy winning with\\nmy FIRE-type POKéMON…\\pFIRE-type POKéMON don't match up\\nwell against ROCK-type POKéMON…$"}
text:RustboroCity.MrBrineyWalksInTheTunnel	{'body': 'The old sailor MR. BRINEY lives in\\na cottage by the sea.\\pHe goes for walks in the tunnel every\\nso often.$'}
text:RustboroCity.MrBrineyLovesPeeko	{'body': 'The old sailor MR. BRINEY lives in\\na cottage by the sea.\\pHe said he was going shopping in\\nSLATEPORT for his pet, PEEKO.\\pThat old sea dog, he must really love\\nthat PEEKO.$'}
text:RustboroCity.WowYouHavePokemon	{'body': "Wow, you have POKéMON with you, too.\\pWhen I get bigger, I'm going to go\\nplaces with POKéMON, too.$"}
text:RustboroCity.CatchRarePokemonIfIGoToSchool	{'body': "POKéMON TRAINER'S SCHOOL!\\pIf I go to this school, will I be able\\nto catch rare POKéMON easily?$"}
text:RustboroCity.PokemonCanChangeLookFromExp	{'body': 'My POKéMON evolved when I used\\nthe LEVELER!\\pBattles give no experience here.\\nThe LEVELER raises your party\\land checks for evolutions.$'}
text:RustboroCity.PokemonChangeShape	{'body': 'A POKéMON changes shape?\\nIf one did that, I would be shocked!$'}
text:RustboroCity.TradePokemonGrowFast	{'body': 'A traded partner can use the\\nLEVELER just like one you caught.\\pNo need to raise it through\\nbattles. Take it to the CENTER\\land try a Battle Set together!$'}
text:RustboroCity.OutOfTheWay	{'body': 'Get out!\\nOut of the way!$'}
text:RustboroCity.WaitDontTakeMyGoods	{'body': "Wait! Pleeeaaase!\\pDon't take my GOODS!$"}
text:RustboroCity.HelpMeIWasRobbed	{'body': "Oh, it's you!\\pYou're that fantastic TRAINER who\\nhelped me in PETALBURG WOODS!\\pHelp me! I was robbed by TEAM AQUA!\\nI have to get the DEVON GOODS back!\\pIf I don't…\\nI'm going to be in serious trouble.\\pHe ran east along ROUTE 116!\\nPlease check RUSTURF TUNNEL.\\pBring the GOODS back to me here.\\nI'll wait by the road.$"}
text:RustboroCity.ShadyCharacterTookOffTowardsTunnel	{'body': 'Follow ROUTE 116 east to\\nRUSTURF TUNNEL. He went that way!\\pPlease bring the DEVON GOODS\\nback to me here.$'}
text:RustboroCity.YouGotItThankYou	{'body': "Oh! How did it go?\\nThe DEVON GOODS?\\pYou did!\\nYou got them back!\\pYou really are a great TRAINER!\\pI know! As my thanks, I'll give you\\nanother GREAT BALL!$"}
text:RustboroCity.YoureLoadedWithItems	{'body': "You're loaded with items.\\nI can't give you this GREAT BALL.$"}
text:RustboroCity.PleaseComeWithMe	{'body': 'Excuse me, please!\\nPlease come with me!$'}
text:RustboroCity.MayHiLetsRegister	{'body': "MAY: Oh, hi, {PLAYER}{KUN}!\\pYou had a MATCH CALL feature put\\non your POKéNAV!\\pLet's register each other so we can\\ncontact one another anytime!\\p… … … … … …$"}
text:RustboroCity.RegisteredMay	{'body': 'Registered MAY\\nin the POKéNAV.$'}
text:RustboroCity.MayPassedBrineyWantToBattle	{'body': "MAY: Oh, by the way, I passed\\nMR. BRINEY in PETALBURG WOODS.\\pI guess he's on his way home to his\\ncottage by the sea.\\pHow's your POKéDEX coming along,\\n{PLAYER}{KUN}? Mine's looking pretty decent!\\pSo…\\nHow about a little battle?$"}
text:RustboroCity.MayOhHaventRaisedPokemonEnough	{'body': "MAY: Oh, what's the matter?\\pHaven't you caught or raised your\\nPOKéMON very much?\\pThat's not very good for a TRAINER!$"}
text:RustboroCity.MayWantToBattle	{'body': 'MAY: So, what do you think?\\nHow about a little battle here?$'}
text:RustboroCity.MayImNotGoingToLose	{'body': "MAY: You just became a TRAINER,\\n{PLAYER}{KUN}. I'm not going to lose!$"}
text:RustboroCity.MayDefeat	{'body': "Yikes!\\nYou're better than I expected!$"}
text:RustboroCity.MayMrBrineyHint	{'body': 'MAY: Oh, by the way, MR. BRINEY, who\\nI just passed…\\p{PLAYER}{KUN}, you just moved here so you\\nmight not know this, but MR. BRINEY\\lwas once a revered seafarer.$'}
text:RustboroCity.BrendanHiLetsRegister	{'body': "BRENDAN: Oh, hey, {PLAYER}!\\pYou had a MATCH CALL feature put\\non your POKéNAV! Cool!\\pLet's register each other so we can\\nget in touch anytime!\\p… … … … … …$"}
text:RustboroCity.RegisteredBrendan	{'body': 'Registered BRENDAN\\nin the POKéNAV.$'}
text:RustboroCity.BrendanPassedBrineyWantToBattle	{'body': "BRENDAN: By the way, {PLAYER}, I walked\\nby MR. BRINEY in PETALBURG WOODS.\\pI bet he was on his way home to his\\ncottage by the sea.\\p{PLAYER}, how's your POKéDEX?\\nHave you filled in any pages yet?\\pMine rules.\\pWant to have a battle to test how\\nfar you've progressed?$"}
text:RustboroCity.BrendanNoConfidenceInPokemon	{'body': "BRENDAN: What's the matter? Don't have\\nany confidence in your POKéMON?$"}
text:RustboroCity.BrendanWantToBattle	{'body': "BRENDAN: What's up?\\nWant to have a battle with me?$"}
text:RustboroCity.BrendanIWontGoEasy	{'body': "BRENDAN: I know you just became\\na TRAINER, but I won't go easy!$"}
text:RustboroCity.BrendanDefeat	{'body': "Hmm…\\nYou're pretty good.$"}
text:RustboroCity.BrendanMrBrineyHint	{'body': "BRENDAN: By the way, you know\\nMR. BRINEY? The guy I just passed?\\pI bet you didn't know this, since you\\njust moved here, {PLAYER}, but\\lMR. BRINEY was once a great sailor.$"}
text:RustboroCity.TunnelNearingCompletion	{'body': "“Timesaving tunnel nearing\\ncompletion!”\\p…Is what it says on the sign, but\\nthere's also a big “X” splashed\\lacross it in red paint…$"}
text:RustboroCity.DevonCorpSign	{'body': 'DEVON CORPORATION\\p“For all your living needs, we make\\nit all.”$'}
text:RustboroCity.GymSign	{'body': 'RUSTBORO CITY POKéMON GYM\\nLEADER: ROXANNE\\p“The ROCK-loving honors student!”$'}
text:RustboroCity.DevonCorpBranchOfficeSign	{'body': 'DEVON CORP. BRANCH OFFICE\\p“Access limited to DEVON employees\\nand authorized personnel.”$'}
text:RustboroCity.CitySign	{'body': 'RUSTBORO CITY\\p“The city probing the integration of\\nnature and science.”$'}
text:RustboroCity.TrainersSchoolSign	{'body': "POKéMON TRAINER'S SCHOOL\\p“We'll teach you anything about\\nPOKéMON!”$"}
text:RustboroCity.CuttersHouse	{'body': "CUTTER'S HOUSE$"}
text:RustboroCity.DevelopedNewPokenavFeature	{'body': "I've been developing an added feature\\nfor the POKéNAV…\\pAnd it turned out great!\\p{PLAYER}, may I see that POKéNAV?\\nThe one our PRESIDENT gave you?$"}
text:RustboroCity.AddedMatchCallPleaseCallMrStone	{'body': 'There you go, {PLAYER}!\\pI added a new feature named\\nMATCH CALL to your POKéNAV.\\pUsing the MATCH CALL feature,\\nyou can chat with people who have\\lbeen registered in your POKéNAV.\\p{PLAYER}, our PRESIDENT STONE should\\nbe registered in your POKéNAV.\\pTest it out.\\nPlease give our PRESIDENT a call.$'}
text:RustboroCity.PleaseSelectPokenav	{'body': 'Please select the POKéNAV.$'}
text:RustboroCity.IdBetterGetBackToWork	{'body': "Okay, I'd better get back to work.\\nPlease take care, {PLAYER}!$"}
text:RustboroCity.YouCanHave2On2Battle	{'body': "Did you know this?\\pYou can have a 2-on-2 battle even\\nif you're not with another TRAINER.\\pIf you catch the eyes of two TRAINERS\\nwhen you have two or more POKéMON,\\lthey'll both challenge you.\\pDon't you think it'd be cool if you\\ncould beat two TRAINERS by yourself?$"}
text:RustboroCity_CuttersHouse.YouCanPutThisHMToGoodUse	{'body': "That determined expression…\\nThat limber way you move…\\lAnd your well-trained POKéMON…\\pYou're obviously a skilled TRAINER!\\pNo, wait, don't say a word.\\nI can tell just by looking at you.\\pI'm sure that you can put this\\nHIDDEN MACHINE to good use.\\pNo need to be modest or shy.\\nGo on, take it!$"}
text:RustboroCity_CuttersHouse.ExplainCut	{'body': "That HM registers CUT as a field\\ntechnique for your team.\\pWith the STONE BADGE, a party\\nmember able to learn CUT can chop\\lthin trees.\\pIt needn't keep CUT among its four\\nbattle moves.$"}
text:RustboroCity_CuttersHouse.DadHelpedClearLandOfTrees	{'body': 'When they were expanding the city of\\nRUSTBORO, my dad helped out.\\pHe made his POKéMON use CUT to clear\\nthe land of trees.$'}
text:RustboroCity_DevonCorp_1F.WelcomeToDevonCorp	{'body': "Hello and welcome to the DEVON\\nCORPORATION.\\pWe're proud producers of items and\\nmedicine that enhance your life.$"}
text:RustboroCity_DevonCorp_1F.StaffGotRobbed	{'body': "One of our researchers was robbed\\nof an important parcel. I hope\\lhe's all right.$"}
text:RustboroCity_DevonCorp_1F.ThoseShoesAreOurProduct	{'body': "Hey, those RUNNING SHOES!\\nThey're one of our products!\\pIt makes me happy when I see someone\\nusing something we made.$"}
text:RustboroCity_DevonCorp_1F.RobberWasntVeryBright	{'body': "That parcel holds instruments for\\nCAPT. STERN's research.\\pWho would go to so much trouble\\nto steal them? They must know\\lwhat the captain is studying.$"}
text:RustboroCity_DevonCorp_1F.SoundsLikeStolenGoodsRecovered	{'body': "It sounds like they've recovered\\nthe ripped-off DEVON GOODS.$"}
text:RustboroCity_DevonCorp_1F.OnlyAuthorizedPeopleEnter	{'body': "I'm sorry, only authorized people\\nare allowed to enter here.$"}
text:RustboroCity_DevonCorp_1F.HowCouldWeGetRobbed	{'body': "After that robbery, we're being\\nmuch more careful with our\\lresearch deliveries.$"}
text:RustboroCity_DevonCorp_1F.YoureAlwaysWelcomeHere	{'body': "Hi, there!\\nYou're always welcome here!$"}
text:RustboroCity_DevonCorp_1F.RocksMetalDisplay	{'body': "Samples of rocks and metal are\\ndisplayed in the glass case.\\pThere's a panel with some writing\\non it…\\p“DEVON CORPORATION got its start as\\na producer of stones from quarries.\\p“The company also produced iron from\\nfilings in the sand.\\p“From that humble start as a producer\\nof raw materials, DEVON developed.\\p“DEVON is now a manufacturer of a wide\\nrange of industrial products.”$"}
text:RustboroCity_DevonCorp_1F.ProductDisplay	{'body': "Prototypes and test products fill\\nthe glass display case.\\pThere's a panel with a description…\\p“In addition to industrial products,\\nDEVON now markets sundries and\\lpharmaceuticals for better lifestyles.\\p“Recently, DEVON has begun marketing\\ntools for POKéMON TRAINERS, including\\lPOKé BALLS and POKéNAV systems.”$"}
text:RustboroCity_DevonCorp_2F.EeveeResearcherOffer	{'body': 'DEVON can safely return an evolved\\nEEVEE to its original form. Try it?$'}
text:RustboroCity_DevonCorp_2F.EeveeResearcherChoose	{'body': 'Choose the EEVEE evolution to return\\nto EEVEE.$'}
text:RustboroCity_DevonCorp_2F.EeveeResearcherConfirm	{'body': 'Return {STR_VAR_1} to EEVEE? Its\\ncurrent moves will be preserved.$'}
text:RustboroCity_DevonCorp_2F.EeveeResearcherComplete	{'body': 'The genetic pattern stabilized.\\n{STR_VAR_1} is EEVEE again.$'}
text:RustboroCity_DevonCorp_2F.EeveeResearcherInvalid	{'body': "That POKéMON is not an evolved member\\nof EEVEE's family.$"}
text:RustboroCity_DevonCorp_2F.EeveeResearcherExit	{'directives': ('.set EC_SIGN_MAGEARNA_ID, 58',), 'body': 'The machine will be ready whenever\\nyou need it.$'}
text:RustboroCity_DevonCorp_2F.LegendarySignResearcherIntro	{'body': 'HOENN is full of rare discoveries.\\nYou can find them at your own pace.\\pMany legendaries are wild residents\\nwith a 3% encounter chance each.\\lRoute signs list them and mark\\leach one you catch.\\pSWEET SCENT helps find them.\\pOther wild discoveries need local\\nhelp, story progress or partners.\\lThose have 1% chances normally.\\lSWEET SCENT gives a shared 25%\\lchance among eligible, uncaught\\llocal legends.\\pRead the area signs for the exact\\nrequirements. Failed encounters\\lremain available until caught.\\pOthers await you at special places\\nor come from rewards. Talk to the\\lpeople you meet on your travels.$'}
text:RustboroCity_DevonCorp_2F.MagearnaParty	{'body': "Your discovery completes DEVON's\\nsealed mechanical prototype!\\pMAGEARNA awakens and joins your party.$"}
text:RustboroCity_DevonCorp_2F.MagearnaPC	{'body': "Your discovery completes DEVON's\\nsealed mechanical prototype!\\pMAGEARNA awakens and is sent to\\nyour PC.$"}
text:RustboroCity_DevonCorp_2F.MagearnaNoRoom	{'body': 'The sealed prototype answers DIANCIE,\\nbut your party and PC have no room.$'}
text:RustboroCity_DevonCorp_2F.ArceusRewardParty	{'body': "You restored HOENN's weather and\\nearned all eight badges.\\lSomething extraordinary has\\lanswered!\\pARCEUS appears before you and\\njoins your party.$"}
text:RustboroCity_DevonCorp_2F.ArceusRewardPC	{'body': "You restored HOENN's weather and\\nearned all eight badges.\\lSomething extraordinary has\\lanswered!\\pARCEUS appears before you and is\\nsent to your PC.$"}
text:RustboroCity_DevonCorp_2F.ArceusRewardNoRoom	{'body': 'ARCEUS has answered your journey,\\nbut needs room. Please make space\\lin your PC.$'}
text:RustboroCity_DevonCorp_2F.ArceusRewardComplete	{'body': 'Even ARCEUS has joined your\\njourney. Take your discoveries to\\lthe LEAGUE!$'}
text:RustboroCity_DevonCorp_2F.DeviceForTalkingToPokemon	{'body': "We're developing a device for talking\\nwith POKéMON.\\pBut we haven't had much success…$"}
text:RustboroCity_DevonCorp_2F.DevelopingNewBalls	{'body': "I'm developing new kinds of\\nPOKé BALLS…\\pBut I haven't made much headway…$"}
text:RustboroCity_DevonCorp_2F.WeFinallyMadeNewBalls	{'body': "We finally made new kinds of\\nPOKé BALLS!\\pThe REPEAT BALL makes it easier to\\ncatch POKéMON you've caught before.\\pThe TIMER BALL gets better at catching\\nPOKéMON the longer a battle runs.\\pBoth are proudly developed by\\nthe DEVON CORPORATION.\\pPlease give them a try!$"}
text:RustboroCity_DevonCorp_2F.IMadePokenav	{'body': 'I made the POKéNAV!\\pAs an engineer, I feel blessed to have\\nmade something so great!$'}
text:RustboroCity_DevonCorp_2F.WowThatsAPokenav	{'body': "Oh, wow!\\nThat's a POKéNAV!\\pIt came about as a result of our\\nPRESIDENT's desire to learn about\\lthe feelings of POKéMON.\\pWould you like me to describe its\\nfeatures in detail?\\pNo, no. I think you'll find out just by\\ntrying the POKéNAV out.$"}
text:RustboroCity_DevonCorp_2F.DeviceToVisualizePokemonDreams	{'body': "I'm trying to develop a device that\\nvisually reproduces the dreams of\\lPOKéMON…\\pBut it's not going well.$"}
text:RustboroCity_DevonCorp_2F.DevelopDeviceToResurrectFossils	{'body': 'My FOSSIL REGENERATOR can restore\\nancient POKéMON from every era.\\pBring me any complete fossil you find.$'}
text:RustboroCity_DevonCorp_2F.WantToBringFossilBackToLife	{'body': 'Wait! You have a POKéMON fossil!\\pShall I restore its ancient POKéMON\\nwith the FOSSIL REGENERATOR?$'}
text:RustboroCity_DevonCorp_2F.OhIsThatSo	{'body': "Oh, is that so?\\pDEVON's technological expertise\\nis outstanding, I tell you.$"}
text:RustboroCity_DevonCorp_2F.ChooseFossil	{'body': 'The machine restores one fossil at\\na time. Which one shall I revive?$'}
text:RustboroCity_DevonCorp_2F.HandedFossilToResearcher	{'body': "Excellent!\\nLet's do this right away.\\p{PLAYER} handed the {STR_VAR_1} to\\nthe DEVON RESEARCHER.$"}
text:RustboroCity_DevonCorp_2F.FossilNoLongerAvailable	{'body': "Oh! That fossil is no longer in your\\nBag. Bring it back and we'll try again.$"}
text:RustboroCity_DevonCorp_2F.FossilDataLost	{'body': "The regenerator's record is unreadable.\\nI've reset it so we can try again.$"}
text:RustboroCity_DevonCorp_2F.FossilRegeneratorTakesTime	{'body': 'The regenerator is working.\\nIt only needs a short while!\\pTalk to one of my colleagues,\\nor step outside this floor,\\lthen come back for your POKéMON.$'}
text:RustboroCity_DevonCorp_2F.FossilizedMonBroughtBackToLife	{'body': 'Thanks for waiting!\\pYour fossilized POKéMON has been\\nbrought back to life!\\pIt was {STR_VAR_2}!\\nAn ancient POKéMON!$'}
text:RustboroCity_DevonCorp_2F.ReceivedMonFromResearcher	{'body': '{PLAYER} received {STR_VAR_2} from\\nthe DEVON RESEARCHER.$'}
text:RustboroCity_DevonCorp_2F.TooManyPokemon	{'body': "Uh-oh, you've got too many POKéMON.\\nYou have no room for this one.$"}
text:RustboroCity_DevonCorp_2F.DevelopNewPokenavFeature	{'body': "I'm trying to develop a new feature\\nfor the POKéNAV…\\pBut it's not going well.$"}
text:RustboroCity_DevonCorp_2F.WhatToWorkOnNext	{'body': "Well, now what shall I work on\\ndeveloping next?\\pOur company allows us to make our\\ninspirations into reality.\\pOne couldn't ask for a better\\nenvironment as an engineer.$"}
text:RustboroCity_DevonCorp_2F.MegaGift_MAGEARNITE_Text	{'body': 'Eight badges! You have seen things\\nour laboratory can only dream of.\\pThis stone responds to Magearna.\\nPerhaps you can learn why.$'}
text:RustboroCity_DevonCorp_3F.MrStoneIHaveFavor	{'body': "I'm MR. STONE, president of\\nDEVON. You recovered our GOODS\\land protected my staff. Thank\\lyou!\\pReports of rare POKéMON are\\narriving from caves and forests\\lacross HOENN.\\pMAGMA and AQUA are searching\\nthose same places. I fear the\\lthefts are connected.\\pMy son STEVEN is in GRANITE CAVE\\nnear DEWFORD. Please take this\\lLETTER to him.\\pThen deliver the GOODS to CAPT.\\nSTERN in SLATEPORT. He's counting\\lon us.$"}
text:RustboroCity_DevonCorp_3F.LetterSentToPC	{'body': 'Your KEY ITEMS pocket is full, so the\\nLETTER was sent to your PC.$'}
text:RustboroCity_DevonCorp_3F.LetterNoRoom	{'body': 'Your KEY ITEMS pocket and PC are full.\\nMake room, then return to my desk.$'}
text:RustboroCity_DevonCorp_3F.MrStoneWantYouToHaveThis	{'body': "Please take this POKéNAV. You'll need\\na good map for the journey ahead.$"}
text:RustboroCity_DevonCorp_3F.ReceivedPokenav	{'body': '{PLAYER} received a POKéNAV.$'}
text:RustboroCity_DevonCorp_3F.MrStoneExplainPokenavRestUp	{'body': "The POKéNAV maps HOENN and keeps\\nyou in touch with key Trainers.\\pFor legendary leads, visit the\\nguide near the POKéMON CENTER PC.\\pEach town's guide knows nearby\\nPokémon and their requirements.\\pPlease rest before you leave.\\nDEWFORD is your next stop.$"}
text:RustboroCity_DevonCorp_3F.MrStoneGoWithCautionAndCare	{'body': "Go carefully, {PLAYER}. You've already\\ndone more for us than I could ask.$"}
text:RustboroCity_DevonCorp_3F.CountingOnYou	{'body': "You'll find STEVEN in GRANITE\\nCAVE near DEWFORD. He loses track\\lof time studying rocks!\\pFor local legendary leads, ask\\nthe guide near the PC in any\\lPOKéMON CENTER.$"}
text:RustboroCity_DevonCorp_3F.StevenAwaitsKnuckleBadge	{'body': "STEVEN received my LETTER. Good.\\pHe will entrust the MEGA RING\\nonly after you earn DEWFORD's\\lKNUCKLE BADGE.$"}
text:RustboroCity_DevonCorp_3F.ThankYouForDeliveringLetter	{'body': 'You reached STEVEN and earned the\\nright to use MEGA EVOLUTION.\\lExcellent.\\pThis stone was found above\\nRUSTBORO. Let PIDGEOT show you\\lwhat it can become.$'}
text:RustboroCity_DevonCorp_3F.ExplainPidgeotite	{'body': "PIDGEOTITE lets a PIDGEOT Mega\\nEvolve when it holds the stone and\\lyou possess a MEGA RING.\\pFind Mega Stones in HOENN's caves,\\ngyms and side paths, or through\\lthe people you meet.\\pCENTER vendors supply held items\\nfor free. Evolution specialists\\lsell stones and devices.$"}
text:RustboroCity_DevonCorp_3F.NotFamiliarWithTrends	{'body': 'Some rare POKéMON become\\navailable as you earn BADGES or\\lhelp HOENN.\\pA few also require you to have\\ncaught another POKéMON. Our guide\\ltells you exactly which one.\\pYou can explore and catch them\\nwithout visiting our researcher.$'}
text:RustboroCity_DevonCorp_3F.ThisIs3rdFloorWaitHere	{'body': "This is the DEVON CORPORATION's\\nthird floor.\\pOur PRESIDENT's OFFICE is on\\nthis floor.\\pAnyway, I can't tell you how much I'm\\ngrateful for what you've done.\\pUm… By the way, that parcel\\nyou got back for us…\\pCould I get you to deliver that to\\nthe SHIPYARD in SLATEPORT?\\pIt would be awful if those robbers\\ntried to take it again.\\pUh… Hehehe, so, uh, could I count\\non you to do that for me?\\pOh, that's right.\\nCould you wait here a second?$"}
text:RustboroCity_DevonCorp_3F.WordWithPresidentComeWithMe	{'body': 'Our PRESIDENT would like to have\\na word with you.\\pPlease come with me.$'}
text:RustboroCity_DevonCorp_3F.PleaseGoAhead	{'body': 'Please, go ahead.$'}
text:RustboroCity_DevonCorp_3F.VisitCaptSternShipyard	{'body': 'If you visit the SHIPYARD in SLATEPORT,\\nyou should go see CAPT. STERN.$'}
text:RustboroCity_DevonCorp_3F.RepeatAndTimerHugelyPopular	{'body': "DEVON's new products, the REPEAT BALL\\nand TIMER BALL, have become hugely\\lpopular among TRAINERS.$"}
text:RustboroCity_DevonCorp_3F.RareRocksDisplay	{'body': "It's a collection of rare rocks and\\nstones assembled by the PRESIDENT.$"}
text:RustboroCity_Flat1_1F.EveryPokemonHasAbility	{'body': 'Every POKéMON has a special ability\\nthat it can use.$'}
text:RustboroCity_Flat1_1F.PokemonStrange	{'body': 'POKéMON are such strange creatures.$'}
text:RustboroCity_Flat1_2F.ComingUpWithMealsIsHard	{'body': "Oh, it's so hard every day…\\pWhat's hard?\\nYou need to ask?\\pIt's trying to figure out what to\\nmake for meals every day.\\pIt really isn't easy coming up with\\nmeals every day.$"}
text:RustboroCity_Flat1_2F.HelloDoYouKnowFunnyPhrase	{'body': "Oh, hello!\\nWelcome to the PEPPER household.\\pI have a question for you.\\nHave you ever baby-sat?\\pYou see, I'm a new father, so raising\\na child is all new to me.\\pAnd I have a problem. My daughter\\nWALDA doesn't laugh enough.\\pI think she'd laugh for me if I told\\nher something funny.\\pDo you know of a funny word or\\nphrase you can tell me?$"}
text:RustboroCity_Flat1_2F.BeenSayingXDoYouKnowBetterPhrase	{'body': "I've been saying “{STR_VAR_1}”\\nto amuse her lately.\\pDo you know of a better word or\\na phrase that might work?$"}
text:RustboroCity_Flat1_2F.WonderfulLetsHearSuggestion	{'body': "Oh, that's wonderful.\\nSo, let's hear it, your suggestion.$"}
text:RustboroCity_Flat1_2F.OhIsThatRight	{'body': "Oh, is that right?\\pWell, if you come up with a good\\nsuggestion, I'm all ears.$"}
text:RustboroCity_Flat1_2F.LetsGiveItATry2	{'body': "Ah, I see.\\nWell, let's give it a try, shall we?$"}
text:RustboroCity_Flat1_2F.OhShesLaughing	{'body': "{STR_VAR_1}.\\n{STR_VAR_1}.\\pOh, yes! She's laughing!\\nOh, I am as delighted as she!$"}
text:RustboroCity_Flat1_2F.LetsGiveItATry	{'body': "Ah, I see.\\nWell, let's give it a try, shall we?$"}
text:RustboroCity_Flat1_2F.ShesNotSmilingAtAll	{'body': "{STR_VAR_1}.\\n{STR_VAR_1}.\\pHmmm… She's not smiling at all.\\nMaybe WALDA is one serious child…$"}
text:RustboroCity_Flat1_2F.ThinkOfMyOwnPhrase	{'body': "Oh, so you don't know any good words.\\nI'd better think for myself, then.\\pHmm…\\nHow about “{STR_VAR_1}”?\\lLet's see if that will work.$"}
text:RustboroCity_Flat1_2F.ShesNotSmilingAtAll2	{'body': "{STR_VAR_1}.\\n{STR_VAR_1}.\\pHmmm… She's not smiling at all.\\nMaybe WALDA is one serious child…$"}
text:RustboroCity_Flat1_2F.OhYouDontKnowAny	{'body': "Oh, so you don't know any good words.\\nI guess I'll try to amuse her with\\lthe saying I used before.\\pAnyways, if you have a good suggestion,\\ndon't hesitate in telling me, okay?$"}
text:RustboroCity_Flat1_2F.ThankYouIllGiveYouWallpaper	{'body': "Thank you!\\pThanks to you, my darling WALDA\\nlaughed for me!\\pActually, I may not look all that\\nspecial, but I'm one of DEVON\\lCORPORATION's top researchers.\\pSo, how about I do something in return\\nfor you?\\pI know, I'll add some new wallpaper\\npatterns for the BOXES in the PC\\lPOKéMON Storage System.\\pIn the wallpaper pattern menu,\\nselect “FRIENDS.”\\pThat will give you access to the new\\nwallpaper patterns.$"}
text:RustboroCity_Flat1_2F.ItsAPokemonPlushDoll	{'body': "It's a POKéMON plush DOLL!$"}
text:RustboroCity_Flat2_1F.DevonWorkersLiveHere	{'body': "DEVON CORPORATION's workers live in\\nthis building.$"}
text:RustboroCity_Flat2_1F.Skitty	{'body': 'SKITTY: Gyaaaah!$'}
text:RustboroCity_Flat2_2F.DevonWasTinyInOldDays	{'body': 'Way back in the old days, DEVON was just\\na teeny, tiny company.$'}
text:RustboroCity_Flat2_2F.MyDaddyMadeThisYouCanHaveIt	{'body': "My daddy's working at the CORPORATION.\\pMy daddy made this!\\nBut I can't use it, so you can have it.$"}
text:RustboroCity_Flat2_2F.GoingToWorkAtDevonToo	{'body': "My daddy's working at the CORPORATION.\\pWhen I grow up, I'm going to work for\\nDEVON, too.$"}
text:RustboroCity_Flat2_2F.MyDadsAceAtDevon	{'body': 'My dad is a real ace at DEVON.\\pHere. Take something an ACE TRAINER\\nlike me knows how to use.$'}
text:RustboroCity_Flat2_2F.PokemonHoldFloatStone	{'body': 'DEVON refines METAL COATS.\\pUse one from the BAG to evolve\\nONIX or SCYTHER. No trade with\\lanother player is required.$'}
text:RustboroCity_Flat2_2F.PutOnWeight	{'body': "For some reason, I've put on a lot of\\nweight recently…$"}
text:RustboroCity_Flat2_3F.PresidentCollectsRareStones	{'body': "DEVON's PRESIDENT likes to collect\\nrare stones.$"}
text:RustboroCity_Flat2_3F.PresidentsSonAlsoCollectsRareStones	{'body': "I think the PRESIDENT's son also\\ncollects rare stones.$"}
text:RustboroCity_Gym.GuideIntroduction	{'body': 'Yo! Welcome to RUSTBORO GYM.\\nROXANNE brings a whole Rock team.\\lHave a plan for both opponents!\\pBattle Sets at the CENTER prepare\\nmoves and EVs. Heal up and use\\lthe LEVELER before you challenge.\\pIn battle, L shows foe types.\\nOn a move, R opens its details\\lduring TRAINER battles.\\pMove symbols show effectiveness:\\na dotted circle means double,\\la star means four times damage.\\pThe school notebook explains\\nevery symbol and the shortcuts.\\lCheck your target in doubles!\\pTake these FRESH WATERS for\\nhealing outside TRAINER battles.\\lCome see me after your BADGE!$'}
text:RustboroCity_Gym.GymGuideAdvice	{'body': 'ROXANNE uses Rock Pokémon with\\ndifferent jobs.\\pCARBINK can reverse move order\\nwith TRICK ROOM. NOSEPASS can\\lguard its partner from spread\\lattacks.\\pWater and Grass are useful, but\\ntarget choice and timing still\\lmatter. Build the answer that\\lsuits your team!$'}
text:RustboroCity_Gym.GymGuidePostVictory	{'body': "Whoa! What a breathtaking victory!\\nMy cheering must've worked!\\pGreat!\\nCheck your TRAINER CARD.\\pThe STONE BADGE you got should be\\nproperly recorded on it.\\pIn other words…\\pYou've climbed the first step on\\nthe stairs to the CHAMPIONSHIP!\\pThat's got to feel awesome!$"}
text:RustboroCity_Gym.JoshIntro	{'body': 'BONSLY and SHIELDON can survive a\\nknockout blow at full health.\\pWe make that extra action count!$'}
text:RustboroCity_Gym.JoshDefeat	{'body': 'Our wall came down!$'}
text:RustboroCity_Gym.JoshPostBattle	{'body': 'STURDY can preserve BONSLY at\\nfull health. Chip damage or an\\lAbility that bypasses it changes\\lthe plan.$'}
text:RustboroCity_Gym.TommyIntro	{'body': 'LILEEP drinks the water you aim at\\nmy rocks. SHUCKLE slows your feet.\\pGo on -- find the dry path!$'}
text:RustboroCity_Gym.TommyDefeat	{'body': 'You saw right through them!$'}
text:RustboroCity_Gym.TommyPostBattle	{'body': 'Two small ROCKS still add up. Never\\nunderestimate a first-badge team.$'}
text:RustboroCity_Gym.MarcIntro	{'body': 'AMAURA calls snow and raises\\nAURORA VEIL.\\pStop the screen or find a way\\nthrough!$'}
text:RustboroCity_Gym.MarcDefeat	{'body': 'You kept control of your choices!$'}
text:RustboroCity_Gym.MarcPostBattle	{'body': 'ROXANNE combines every lesson: field\\ncontrol, reverse speed, and endurance.$'}
text:RustboroCity_Gym.RoxanneIntro	{'body': "I am ROXANNE, RUSTBORO's GYM\\nLEADER.\\pEach challenger gives me\\nsomething new to study.\\pMy Pokémon can endure a blow,\\nguard a partner, or reverse the\\lorder of battle.\\pShow me how your team answers\\nmine.$"}
text:RustboroCity_Gym.RoxanneDefeat	{'body': 'There is always more to learn. Even a\\ncarefully prepared team can be beaten.\\pYou have earned the STONE BADGE.\\nMay it be the first of many!$'}
text:RustboroCity_Gym.ReceivedStoneBadge	{'body': '{PLAYER} received the STONE BADGE\\nfrom ROXANNE.$'}
text:RustboroCity_Gym.StoneBadgeInfoTakeThis	{'body': 'The STONE BADGE lets your LEVELER\\ntrain a party up to Lv. 20.\\pIt also enables POKéMON to use\\nCUT outside of battle.\\pIt also marks your first true\\nstep toward the POKéMON LEAGUE.\\pPlease take this with you, too.$'}
text:RustboroCity_Gym.ExplainRoxanneRewards	{'body': 'Aerodactylite lets Aerodactyl Mega\\nEvolve once you possess a Mega Ring.\\pDEVON can restore that OLD AMBER.\\nConsider Aerodactyl your first Mega\\lproject.$'}
text:RustboroCity_Gym.RoxannePostBattle	{'body': "Your next GYM is BRAWLY's in DEWFORD.\\pMR. BRINEY sails from his cottage on\\nROUTE 104, south of PETALBURG WOODS.$"}
text:RustboroCity_Gym.GymStatue	{'body': 'RUSTBORO CITY POKéMON GYM$'}
text:RustboroCity_Gym.GymStatueCertified	{'body': "RUSTBORO CITY POKéMON GYM\\pROXANNE'S CERTIFIED TRAINERS:\\n{PLAYER}$"}
text:RustboroCity_Gym.RoxanneRegisterCall	{'body': "… … … … … …\\n… … … … … Beep!\\pROXANNE: Oh, hello, {PLAYER}?\\nThis is ROXANNE of RUSTBORO CITY.\\pI heard from BRAWLY that you're\\nmoving up through the ranks of\\lTRAINERS at an incredible clip.\\pYour progress gives my students\\nan excellent model to study.\\pI hope you'll share what you learn\\nas your journey continues!\\p… … … … … …\\n… … … … … Click!$"}
text:RustboroCity_Gym.RegisteredRoxanne	{'body': 'Registered GYM LEADER ROXANNE\\nin the POKéNAV.$'}
text:RustboroCity_Gym.RoxannePreRematch	{'body': "ROXANNE: I'm so glad to see you again.\\nI'm ROXANNE, the GYM LEADER here.\\pI'm sure we've both experienced many\\nbattles since we last met.\\pI would like to see how much better\\nwe've become. Let us battle!$"}
text:RustboroCity_Gym.RoxanneRematchDefeat	{'body': 'Grr…\\nAgain, I have lost…$'}
text:RustboroCity_Gym.RoxannePostRematch	{'body': 'ROXANNE: I still have much to learn\\nwhen it comes to battling POKéMON.\\pThat awareness makes me love battling\\nall that much more!$'}
text:RustboroCity_Gym.RoxanneRematchNeedTwoMons	{'body': "ROXANNE: I'm so glad to see you again.\\nI'm ROXANNE, the GYM LEADER here.\\pI'm sure we've both experienced many\\nbattles since we last met.\\pI would like to see how much better\\nwe've become…\\pOh, no…\\nYou only have one POKéMON with you?\\pPlease return with at least one more\\nPOKéMON.$"}
text:RustboroCity_House1.IllTradeIfYouWant	{'body': "Huh? My POKéMON is cute?\\nSure, I knew that.\\pBut if you really want, I'm willing\\nto trade it to you.\\pI'll trade you my {STR_VAR_2} for\\na {STR_VAR_1} if you want.$"}
text:RustboroCity_House1.PleaseBeGoodToMyPokemon	{'body': 'Eheheh…\\nPlease be good to my POKéMON.\\pIt already has a proper battle set,\\nso it can fight from day one.$'}
text:RustboroCity_House1.DoesntLookLikeMonToMe	{'body': "Huh? That doesn't look anything like\\na {STR_VAR_1} to me.$"}
text:RustboroCity_House1.YouDontWantToThatsOkay	{'body': "Oh, if you don't want to, that's okay.\\nBut my POKéMON is cute, you know…$"}
text:RustboroCity_House1.AnyPokemonCanBeCute	{'body': 'Any POKéMON can be cute if you raise\\nit with care and kindness.$'}
text:RustboroCity_House1.AllSortsOfPlaces	{'body': 'In all sorts of places, there are all\\nsorts of POKéMON and people.\\pI find that fascinating, so I go to all\\nsorts of places.$'}
text:RustboroCity_House2.TrainerSchoolExcellent	{'body': "The TRAINER'S SCHOOL is excellent.\\pIf you study there, you could even\\nbecome a GYM LEADER.$"}
text:RustboroCity_House2.RoxanneKnowsALot	{'body': "ROXANNE, the GYM LEADER, really knows\\na lot about POKéMON.\\pShe's really strong, too!$"}
text:RustboroCity_House3.IGivePerfectlySuitedNicknames	{'body': "For my own POKéMON, I give them\\nperfectly suited nicknames!\\pIt's my expression of, uh…\\noriginality, yes, that's it!$"}
text:RustboroCity_House3.NamingPikachuPekachu	{'body': "But giving the name PEKACHU to\\na PIKACHU? It seems pointless.\\pI suppose it is good to use a name\\nthat's easy to understand, but…$"}
text:RustboroCity_House3.Pekachu	{'body': 'PEKACHU: Peka!$'}
text:RustboroCity_Mart.MoveSpecialist	{'claims': (('same_price', 'item:WATER_STONE', 'item:FIRE_STONE'), ('same_price', 'item:THUNDER_STONE', 'item:FIRE_STONE'), ('same_price', 'item:LEAF_STONE', 'item:FIRE_STONE'), ('same_price', 'item:MOON_STONE', 'item:FIRE_STONE'), ('same_price', 'item:SUN_STONE', 'item:FIRE_STONE')), 'slots': {'evolution_price': ('field', 'item:FIRE_STONE', 'price')}, 'body': 'I sell evolution stones for ¥{evolution_price} each.\\nTry one on your POKéMON to check!\\pSLATEPORT carries more varieties.\\nLILYCOVE stocks the complete range.$'}
text:RustboroCity_Mart.BuyingHealsInCaseOfShroomish	{'body': "I'm buying some PARLYZ HEALS and\\nANTIDOTES.\\pJust in case I run into SHROOMISH\\nin PETALBURG WOODS.$"}
text:RustboroCity_Mart.ShouldBuySuperPotionsInstead	{'body': 'My POKéMON evolved.\\nIt has a lot of HP now.\\pI should buy SUPER POTIONS for it\\ninstead of ordinary POTIONS.$'}
text:RustboroCity_Mart.GettingEscapeRopeJustInCase	{'body': "I'm getting an ESCAPE ROPE just in\\ncase I get lost in a cave.\\pI just need to use it to get back to\\nthe entrance.$"}
text:RustboroCity_PokemonCenter_1F.PokemonHavePersonalities	{'body': "My partner's JOLLY Nature raises\\nSpeed but lowers Sp. Atk. That\\lsuits its physical moves!\\pThe TUTOR can change the Nature\\nthat affects your stats for free.\\lEach choice shows its tradeoff.\\pIVs are fixed at the best value,\\n31, for everyone. You don't need\\lto breed for better stats.\\pTo change an available Ability,\\nselect your POKéMON in the party\\lmenu and choose Change Ability.$"}
text:RustboroCity_PokemonCenter_1F.MaleAndFemalePokemon	{'body': 'Some POKéMON are male or female.\\nOthers have no gender.\\pSometimes it even changes how\\nthey evolve! Female BURMY become\\lWORMADAM; males become MOTHIM.$'}
text:RustboroCity_PokemonCenter_1F.HMCutNextDoor	{'body': "The man next door gave me CUT!\\pWith the STONE BADGE and a\\ncompatible partner, I can clear\\lskinny trees. It doesn't take up\\la battle move slot.$"}
text:RustboroCity_PokemonSchool.BlackboardListsStatusChanges	{'body': 'The blackboard lists status changes\\nthat may affect POKéMON in battle.$'}
text:RustboroCity_PokemonSchool.ReadWhichTopic	{'body': 'Which topic do you want to read?$'}
text:RustboroCity_PokemonSchool.ExplainPoison	{'body': 'If a POKéMON is poisoned, it steadily\\nloses HP during battle.\\pPoison remains after battle, but it no\\nlonger causes damage while traveling.\\pHeal it using an ANTIDOTE.$'}
text:RustboroCity_PokemonSchool.ExplainParalysis	{'body': 'If a POKéMON becomes paralyzed,\\nits SPEED drops.\\pIt may also not be able to move while\\nit is in battle.\\pParalysis remains after battle.\\nCure it using a PARLYZ HEAL.$'}
text:RustboroCity_PokemonSchool.ExplainSleep	{'body': 'Sleep prevents most moves until\\nthe Pokémon wakes.\\pSLEEP TALK and SNORE are\\nexceptions. A sleeping Pokémon\\lstays asleep after battle;\\lAWAKENING cures it.$'}
text:RustboroCity_PokemonSchool.ExplainBurn	{'body': 'A burn normally lowers damage from\\nphysical attacks and causes HP\\lloss.\\pSome Abilities change that result.\\nGUTS attackers can benefit from\\lburn!\\pBURN HEAL removes a burn outside a\\ntrainer battle.$'}
text:RustboroCity_PokemonSchool.ExplainFreeze	{'body': 'A frozen Pokémon usually cannot\\nmove. It may thaw, and certain\\lmoves can help it thaw as well.\\pFreezing remains after battle. An\\nICE HEAL removes it.$'}
text:RustboroCity_PokemonSchool.StudentsWhoStudyEveryTool	{'body': "Welcome! Today's lesson is\\npreparing a team without grinding.\\pEVs are effort values you assign\\nto strengthen particular stats.\\lThe CENTER TUTOR edits them free.\\pYou have 510 EVs to distribute,\\nwith at most 252 in one stat.\\lYou can't maximize everything!\\pFor a simple fast attacker, try\\n252 in Speed, 252 in its attacking\\lstat, and 4 in HP.\\pA Battle Set can assign them for\\nyou. Change them anytime to suit\\lyour plan.\\pEvolution is another tool.\\nThis SUN STONE evolves certain\\lPOKéMON. Try it on a suitable one!$"}
text:RustboroCity_PokemonSchool.ExplainSunStone	{'body': 'EVs let you specialize: up to\\n252 per stat, 510 total.\\lEdit them freely at the TUTOR.\\pA SUN STONE works differently:\\nuse it from the BAG to evolve\\la compatible POKéMON.$'}
text:RustboroCity_PokemonSchool.TradingRightNow	{'body': "I'm trading POKéMON with my friend\\nright now.$"}
text:RustboroCity_PokemonSchool.AlwaysWantedSeedot	{'body': "I always wanted a SEEDOT, and\\nI'm finally getting one!$"}
text:RustboroCity_PokemonSchool.PokemontCantUseManMadeItems	{'body': "I used the TUTOR's Other Services\\nand chose Bonding. You can set\\lfriendship there for free!\\pIt helps with friendship-based\\nevolutions. Meet the other\\lconditions, then use the LEVELER.$"}
text:RustboroCity_PokemonSchool.ConfusedPokemonAttacksItself	{'body': 'I changed Difficulty in OPTIONS\\nwhile trying a new team.\\pEasy lowers opponent levels by\\nfour, Medium by two, and Hard\\luses their full battle levels.\\pTheir plans stay just as clever!\\nI still have to learn how my\\lpartners work together.$'}
text:RustboroCity_PokemonSchool.PokemonHealItselfWithBerry	{'body': 'My partner ate its held BERRY…\\nand had it back after battle!\\pAll held items are restored\\nafter battle, including items\\lfrom Battle Sets.\\pAn eaten BERRY is still gone for\\nthe rest of that fight, unless\\la move or Ability recovers it.\\pPOTIONS and BALLS used from the\\nBAG are still spent. I underlined\\lthat bit in my notes!$'}
text:RustboroCity_PokemonSchool.StudentsNotes	{'body': "It's this student's notebook…\\nMove effectiveness symbols:\\p{CIRCLE_HOLLOW} Normal: usual damage.\\n{CIRCLE_DOT} Super effective: double.\\p{STAR} Four times normal damage.\\n{BIG_MULT_X} No effect: immune.\\p{TRIANGLE} Resisted: half damage.\\n{TRIANGLE_UPSIDE_DOWN} Resisted: quarter damage.\\pStatus moves have no symbol.\\nIn doubles, the move list shows\\lthe better matchup of the two.\\pCheck again when choosing your\\ntarget! The symbol is a matchup\\lguide, not an exact damage total.\\pL shows foe types. If L is set\\nto act as A in OPTIONS, change\\lthat setting to use this panel.\\pIn TRAINER battles, R on a move\\nopens its details. In catchable\\lwild battles, R throws a BALL!$"}
text:RustboroCity_PokemonSchool.ScottMetAlreadyCut	{'body': "SCOTT: We met in PETALBURG, didn't\\nwe? I'm looking for exceptional\\lTrainers.\\pThe CUTTER nearby has the CUT HM.\\nCollect it and the STONE BADGE.\\pThen a compatible party member can\\nclear thin trees without keeping\\lCUT in its battle moves.$"}
text:RustboroCity_PokemonSchool.StudentTalentLevelUnknown	{'body': "SCOTT: Hmm…\\pThe talent levels of the students here\\nare unknown. The potential's there.$"}
text:RustboroCity_PokemonSchool.ScottStoneBadge	{'body': "SCOTT: Oh, what's that?\\pIt's a STONE BADGE, isn't it?\\nThat's pretty impressive, I'd say.\\pBut, you know, I would've loved to see\\nyou in battle.\\pIt's hard to tell what you're like as\\na TRAINER from a LEAGUE BADGE.$"}
text:RustboroCity_PokemonSchool.ScottMetAlreadyStoneBadge	{'body': "SCOTT: There you are!\\nHow did your first GYM battle go?\\pA STONE BADGE! Well done.\\pI wish I'd seen the battle myself.\\nA BADGE shows that you won; I want\\lto see how you and your team did it.$"}
text:RusturfTunnel.ComeAndGetSome	{'body': 'What, are you coming?\\nCome and get some, then!$'}
text:RusturfTunnel.Peeko	{'body': 'PEEKO: Pii pihyoh!$'}
text:RusturfTunnel.GruntIntro	{'body': 'Grah, keelhaul it all!\\pA hostage bird, a stolen package,\\nand a tunnel to nowhere! This job\\lwas supposed to be easy!\\pYou want the package? MIGHTYENA,\\nshow this meddler the way out!$'}
text:RusturfTunnel.GruntDefeat	{'body': 'Urrrggh! My career in crime comes to\\na dead end!$'}
text:RusturfTunnel.GruntTakePackage	{'body': 'This is plain not right…\\pThe BOSS told me this would be a\\nslick-and-easy job to pull.\\pAll I had to do was steal some package\\nfrom DEVON.\\pTch!\\nYou want it back that badly, take it!$'}
text:RusturfTunnel.DevonPartsSentToPC	{'body': 'Your KEY ITEMS pocket is full, so the\\nDEVON PARTS were sent to your PC.$'}
text:RusturfTunnel.DevonPartsNoRoom	{'body': 'Your KEY ITEMS pocket and PC are full.\\nMake room, then take the DEVON PARTS.$'}
text:RusturfTunnel.PeekoGladToSeeYouSafe	{'body': "PEEKO!\\nAm I glad to see you're safe!$"}
text:RusturfTunnel.ThankYouLetsGoHomePeeko	{'body': "PEEKO owes her life to you!\\pThey call me MR. BRINEY.\\nAnd, you are?\\p… … … … … … … …\\n… … … … … … … …\\pAh, so you are {PLAYER}{KUN}!\\nI sincerely thank you!\\pNow, if there's anything that troubles\\nyou, don't hesitate to tell me!\\pYou can usually find me in my cottage\\nby the sea near PETALBURG WOODS.\\pCome, PEEKO, we should make our way\\nhome.\\pPEEKO: Pihyoh!$"}
text:RusturfTunnel.WhyCantTheyKeepDigging	{'body': "… …\\pWhy can't they keep digging?\\nIs the bedrock too hard?\\pMy beloved awaits me in VERDANTURF\\nTOWN just beyond here…\\pIf RUSTBORO and VERDANTURF were\\njoined by this tunnel, I could visit\\lher every day…\\pBut this…\\nWhat am I to do?$"}
text:RusturfTunnel.ToGetToVerdanturf	{'body': 'To get from RUSTBORO to VERDANTURF,\\nyou need to go to DEWFORD, then pass\\lthrough SLATEPORT and MAUVILLE…$'}
text:RusturfTunnel.YouShatteredBoulderTakeHM	{'body': "Wow! You shattered that boulder\\nblocking the way.\\pTo show you how much I appreciate it,\\nI'd like you to have this HM.$"}
text:RusturfTunnel.ExplainStrength	{'body': "That HM registers STRENGTH.\\pWith the HEAT BADGE, a party\\nmember able to learn STRENGTH can\\lmove large boulders.\\pIt needn't keep the move in its\\nbattle set.$"}
text:RusturfTunnel.WandaReunion	{'body': "WANDA!\\nNow I can see you anytime!\\pWANDA: That's…wonderful.\\pPlease, take some rest at my home.$"}
text:RusturfTunnel.BoyfriendOnOtherSideOfRock	{'body': "On the other side of this rock…\\nMy boyfriend is there.\\pHe… He's not just digging the tunnel\\nto come see me.\\pHe works his hands raw and rough\\nfor the benefit of everyone.$"}
text:RusturfTunnel.MikeIntro	{'body': "What do you call a wild man up in the\\nmountains? A mountain man, right?\\pSo why don't they call a POKéMON in\\nthe mountains a mountain POKéMON?$"}
text:RusturfTunnel.MikeDefeat	{'body': 'My POKéMON…\\nRan out of power…$'}
text:RusturfTunnel.MikePostBattle	{'body': "They halted development here to\\nprotect POKéMON, right?\\lThere's a feel-good story!$"}
text:SSAnne_1F_Corridor_LeStrongSilentType	{'body': 'Bonjour!\\nI am le waiter on this ship!\\pI will be happy to serve you\\nanything you please!\\p… … …\\nAh! Le strong silent type!$'}
text:SSAnne_1F_Corridor_PassengersAreRestless	{'body': 'The passengers are restless from\\nthis long voyage.\\pYou might be challenged by the\\nmore bored ones!$'}
text:SSAnne_1F_Room1_ImAGlobalPoliceAgent	{'body': "Ssh…!\\nI'm a GLOBAL POLICE agent.\\pI'm on the trail of TEAM ROCKET.\\nThey're up to nothing good!$"}
text:SSAnne_1F_Room2_TylerIntro	{'body': 'I love POKéMON!\\nDo you?$'}
text:SSAnne_1F_Room2_TylerDefeat	{'body': "Wow! \\nYou're great!$"}
text:SSAnne_1F_Room2_TylerPostBattle	{'body': 'Listen, listen!\\nLet me be your friend, okay?\\pThen we can trade POKéMON and\\ndo stuff.$'}
text:SSAnne_1F_Room2_AnnIntro	{'body': 'I collected these POKéMON\\nfrom all around the world!$'}
text:SSAnne_1F_Room2_AnnDefeat	{'body': 'Oh, no!\\nI went around the world for these!$'}
text:SSAnne_1F_Room2_AnnPostBattle	{'body': 'You hurt my poor POKéMON!\\pI demand that you heal them at a\\nPOKéMON CENTER!$'}
text:SSAnne_1F_Room2_CruisingAroundWorld	{'body': 'We are cruising around the world,\\nmy children and I.$'}
text:SSAnne_1F_Room3_CruiseIsElegantAndCozy	{'body': 'A world cruise is so elegant yet\\ncozy!$'}
text:SSAnne_1F_Room3_AlwaysTravelWithWigglytuff	{'body': 'I always travel with WIGGLYTUFF.\\nI never leave home without it.$'}
text:SSAnne_1F_Room3_Wigglytuff	{'body': 'WIGGLYTUFF: Puup pupuu!$'}
text:SSAnne_1F_Room4_WaiterCherryPiePlease	{'body': 'Waiter, I would like a cherry pie,\\nplease!$'}
text:SSAnne_1F_Room4_WaitressCherryPiePlease	{'body': 'Waitress, I would like a cherry\\npie, please!$'}
text:SSAnne_1F_Room5_ArthurIntro	{'body': 'You insolent pup!\\nHow dare you barge in!$'}
text:SSAnne_1F_Room5_ArthurDefeat	{'body': 'Humph! You rude child!\\nYou have no sense of courtesy!$'}
text:SSAnne_1F_Room5_ArthurPostBattle	{'body': 'I wish to be left alone!\\nGet out!$'}
text:SSAnne_1F_Room6_TakeAShortRest	{'body': 'You look tired. Would you like to\\ntake a short rest?$'}
text:SSAnne_1F_Room6_GladEveryoneIsRefreshed	{'body': "I'm glad to see that everyone is\\nlooking refreshed and chipper.$"}
text:SSAnne_1F_Room6_SorryYouLookLikeMyBrother	{'body': "Oh, I'm sorry for fussing over you.\\nYou look like my little brother…$"}
text:SSAnne_1F_Room6_SorryYouLookLikeMySister	{'body': "Oh, I'm sorry for fussing over you.\\nYou look like my little sister…$"}
text:SSAnne_1F_Room7_ThomasIntro	{'body': 'I am but a solitary traveler…\\pMy sole companions and friends are\\nPOKéMON I caught on my journeys…$'}
text:SSAnne_1F_Room7_ThomasDefeat	{'body': 'My, my friends…$'}
text:SSAnne_1F_Room7_ThomasPostBattle	{'body': 'You should be nice to friends!$'}
text:SSAnne_2F_Corridor_ThisShipIsLuxuryLiner	{'body': 'This ship, she is a luxury liner for\\nTRAINERS of the world!\\pAt every port, we hold parties with\\ninvited TRAINERS.$'}
text:SSAnne_2F_Corridor_RivalIntro	{'body': "{RIVAL}: Bonjour!\\n{PLAYER}!\\pImagine seeing you here!\\n{PLAYER}, were you really invited?\\pSo how's your POKéDEX coming?\\pI already caught 40 kinds, pal.\\nDifferent kinds are everywhere.\\pCrawl around in grassy areas, and\\nlook hard for them.$"}
text:SSAnne_2F_Corridor_RivalDefeat	{'body': "Humph!\\pAt least you're raising your\\nPOKéMON!$"}
text:SSAnne_2F_Corridor_RivalVictory	{'body': '{PLAYER}..！\\nふなよい\u3000してるのか！\\pもっと\u3000からだ\\nきたえた\u3000ほうが\u3000いいぜ！$'}
text:SSAnne_2F_Corridor_RivalPostBattle	{'body': "{RIVAL}: I heard there was a CUT\\nmaster on board.\\pBut he was just a seasick old man!\\pCUT itself is really useful.\\nYup, it'll be handy.\\pYou should go see him, too.\\nSmell ya!$"}
text:SSAnne_2F_Room1_SleepingMonLookedLikeThis	{'body': "I've journeyed far and wide, but in\\nall my travels I've never seen\\lany POKéMON sleep like this one!\\pIt was something like this!$"}
text:SSAnne_2F_Room2_BrooksIntro	{'body': 'Competing against the young keeps\\nme youthful.$'}
text:SSAnne_2F_Room2_BrooksDefeat	{'body': 'Good match!\\nAh, I feel young again!$'}
text:SSAnne_2F_Room2_BrooksPostBattle	{'body': 'Fifteen years ago, I would\\nhave won!$'}
text:SSAnne_2F_Room2_DaleIntro	{'body': 'Check out what I fished up!$'}
text:SSAnne_2F_Room2_DaleDefeat	{'body': "I'm all out!$"}
text:SSAnne_2F_Room2_DalePostBattle	{'body': "Party?\\pThe cruise ship's party should be\\nover by now.$"}
text:SSAnne_2F_Room3_SeenMonsFerryPeople	{'body': 'Ah, yes, I have seen some POKéMON\\nferry people across the water!$'}
text:SSAnne_2F_Room3_SomeTreesCanBeCutDown	{'body': 'Small trees can be chopped down\\nusing the move CUT.\\pBut remember this!\\nCUT is an HM technique.\\pOnce learned, it is not so easily\\ndiscarded.$'}
text:SSAnne_2F_Room4_LamarIntro	{'body': 'Which do you find more worthy,\\na strong or a rare POKéMON?$'}
text:SSAnne_2F_Room4_LamarDefeat	{'body': 'I must salute you!$'}
text:SSAnne_2F_Room4_LamarPostBattle	{'body': 'Personally, I prefer strong and\\nrare POKéMON.$'}
text:SSAnne_2F_Room4_DawnIntro	{'body': "I don't believe I saw you at the\\nparty?$"}
text:SSAnne_2F_Room4_DawnDefeat	{'body': 'Take it easy!$'}
text:SSAnne_2F_Room4_DawnPostBattle	{'body': 'Oh, I adore your strong POKéMON!\\nOh, how I envy you for them!$'}
text:SSAnne_2F_Room5_HaveYouGoneToSafariZone	{'body': 'Have you gone to the SAFARI ZONE\\nin FUCHSIA CITY?\\pThere are many kinds of rare\\nPOKéMON.$'}
text:SSAnne_2F_Room5_WeThinkSafariZoneIsAwesome	{'body': 'Me and my daddy think the SAFARI\\nZONE is awesome!\\lI wish we could go there again.$'}
text:SSAnne_2F_Room6_CaptainIsAwfullySick	{'body': "The CAPTAIN said he's awfully sick.\\nHe was all pale.$"}
text:SSAnne_2F_Room6_ManyPeopleGetSeasick	{'body': 'I hear many people get seasick.$'}
text:SSAnne_3F_Corridor_CaptainTeachesCutToMons	{'body': "Our CAPTAIN is a sword master.\\nHe's awesome at using CUT.\\pThey say he even teaches CUT\\nto POKéMON!$"}
text:SSAnne_B1F_Room1_PhillipIntro	{'body': "Matey, you're walking the plank if\\nyou lose!$"}
text:SSAnne_B1F_Room1_PhillipDefeat	{'body': 'Argh!\\nBeaten by a kid!$'}
text:SSAnne_B1F_Room1_PhillipPostBattle	{'body': "When we're out at sea, jellyfish\\nPOKéMON sometimes drift by.$"}
text:SSAnne_B1F_Room1_BarnyIntro	{'body': "Hello, stranger!\\pI can't tell if you're from the seas\\nor mountains, but stop and chat.\\pAll my POKéMON are from the sea.$"}
text:SSAnne_B1F_Room1_BarnyDefeat	{'body': 'Darn!\\nI let that one get away!$'}
text:SSAnne_B1F_Room1_BarnyPostBattle	{'body': 'I was going to make you my\\nassistant, too!$'}
text:SSAnne_B1F_Room2_HueyIntro	{'body': 'Even us sailors have POKéMON, too!$'}
text:SSAnne_B1F_Room2_HueyDefeat	{'body': "Okay, you're not bad.$"}
text:SSAnne_B1F_Room2_HueyPostBattle	{'body': 'We caught all our POKéMON while\\nwe were out at sea.$'}
text:SSAnne_B1F_Room3_DylanIntro	{'body': 'I like feisty kids like you!$'}
text:SSAnne_B1F_Room3_DylanDefeat	{'body': 'Argh!\\nLost it!$'}
text:SSAnne_B1F_Room3_DylanPostBattle	{'body': "Sea POKéMON live in deep water.\\nYou'll need a ROD to fish them up!$"}
text:SSAnne_B1F_Room4_LeonardIntro	{'body': 'You know what they say about\\nsailors and battling!$'}
text:SSAnne_B1F_Room4_LeonardDefeat	{'body': 'Right!\\nGood battle, mate!$'}
text:SSAnne_B1F_Room4_LeonardPostBattle	{'body': 'Hahaha!\\nWant to be a sailor, mate?$'}
text:SSAnne_B1F_Room4_DuncanIntro	{'body': "Come on, then!\\nMy sailor's pride is at stake!$"}
text:SSAnne_B1F_Room4_DuncanDefeat	{'body': 'Your spirit sank me!$'}
text:SSAnne_B1F_Room4_DuncanPostBattle	{'body': 'Did you see the FISHING GURU in\\nVERMILION CITY?$'}
text:SSAnne_B1F_Room5_MachokeHasStrengthToMoveRocks	{'body': 'My buddy MACHOKE is super strong!\\pHe has enough STRENGTH to move\\nbig rocks!$'}
text:SSAnne_B1F_Room5_Machoke	{'body': 'MACHOKE: Gwoh! Goggoh!$'}
text:SSAnne_CaptainsOffice_CaptainIFeelSeasick	{'body': 'CAPTAIN: Ooargh…\\nI feel hideous…\\lUrrp! Seasick…$'}
text:SSAnne_CaptainsOffice_RubbedCaptainsBack	{'body': "{PLAYER} rubbed the CAPTAIN's\\nback!\\pRub-rub…\\nRub-rub…$"}
text:SSAnne_CaptainsOffice_ThankYouHaveHMForCut	{'body': "CAPTAIN: Whew! Thank you!\\nI'm feeling much better now.\\pYou want to see my hidden CUT\\ntechnique?\\pI could show you my prized CUT\\ntechnique if I weren't so ill…\\pI know! You can have this!\\nThis HIDDEN MACHINE!\\pTeach CUT to your POKéMON, and\\nyou can see it CUT anytime!$"}
text:SSAnne_CaptainsOffice_ObtainedHM01FromCaptain	{'body': '{PLAYER} obtained HM01\\nfrom the CAPTAIN!$'}
text:SSAnne_CaptainsOffice_ExplainCut	{'body': 'Using CUT, you can chop down\\nsmall trees.\\pWhy not try it with the trees\\naround VERMILION CITY?$'}
text:SSAnne_CaptainsOffice_SSAnneWillSetSailSoon	{'body': "CAPTAIN: …Whew!\\pNow that I'm not sick anymore,\\nI guess it's time.\\pThe S.S. ANNE will set sail soon!\\pFarewell, until our return to\\nVERMILION CITY!$"}
text:SSAnne_CaptainsOffice_YouHaveNoRoomForThis	{'body': 'Oh, no!\\nYou have no room for this!$'}
text:SSAnne_CaptainsOffice_YuckShouldntHaveLooked	{'body': "Yuck!\\nShouldn't have looked!$"}
text:SSAnne_CaptainsOffice_HowToConquerSeasickness	{'body': "How to Conquer Seasickness…\\nThe CAPTAIN's reading this!$"}
text:SSAnne_Deck_ShipDepartingSoon	{'body': "The party's over.\\nThe ship will be departing soon.$"}
text:SSAnne_Deck_ScrubbingDecksHardWork	{'body': 'Whew!\\nScrubbing decks is hard work!$'}
text:SSAnne_Deck_FeelSeasick	{'body': 'Urf… I feel ill…\\pI got seasick, so I stepped out to\\nget some air…$'}
text:SSAnne_Deck_EdmondIntro	{'body': "Hey, matey!\\pLet's do a little jig!$"}
text:SSAnne_Deck_EdmondDefeat	{'body': "You're impressive!$"}
text:SSAnne_Deck_EdmondPostBattle	{'body': 'How many kinds of POKéMON do you\\nthink there are in this big world?$'}
text:SSAnne_Deck_TrevorIntro	{'body': 'Ahoy, there!\\nAre you seasick?$'}
text:SSAnne_Deck_TrevorDefeat	{'body': 'I was just careless!$'}
text:SSAnne_Deck_TrevorPostBattle	{'body': 'My pa said there are 100 kinds of\\nPOKéMON. I think there are more.$'}
text:SSAnne_Kitchen_BusyOutOfTheWay	{'body': "You, mon petit!\\nWe're busy here!\\lOut of the way!$"}
text:SSAnne_Kitchen_SawOddBerryInTrash	{'body': 'I saw an odd BERRY in the trash.\\nI wonder what that was?$'}
text:SSAnne_Kitchen_SoBusyImDizzy	{'body': "I'm so busy I'm getting dizzy!\\nYou have to give me room here!$"}
text:SSAnne_Kitchen_PeelSpudsEveryDay	{'body': 'Hum-de-hum-de-ho…\\pI peel spuds every day!\\nHum-hum…$'}
text:SSAnne_Kitchen_HearAboutSnorlaxItsAGlutton	{'body': "Did you hear about SNORLAX?\\nIt's a glutton.\\pNo other POKéMON eats and sleeps\\nthe way SNORLAX can and does!$"}
text:SSAnne_Kitchen_OnlyGetToPeelOnions	{'body': 'Snivel… Sniff…\\pI only get to peel onions…\\nSnivel…$'}
text:SSAnne_Kitchen_IAmLeChefMainCourseIs	{'body': 'Er-hem!\\nIndeed I am le CHEF!\\pLe main course is$'}
text:SSAnne_Kitchen_SalmonDuSalad	{'body': "Salmon du Salad!\\pLes guests may gripe it's fish\\nagain, however!$"}
text:SSAnne_Kitchen_EelsAuBarbecue	{'body': 'Eels au Barbecue!\\pLes guests will mutiny, I fear.$'}
text:SSAnne_Kitchen_PrimeBeefsteak	{'body': 'Prime Beefsteak!\\pBut, have I enough fillets du\\nbeef?$'}
text:SSTidalCorridor.ScottBattleFrontierInvite	{'body': "SCOTT: {PLAYER}{KUN}! Just the TRAINER\\nI hoped to run into!\\pI've watched you come a long way.\\nNow the sea has opened up a whole\\lnew set of challenges for you.\\pThe BATTLE FRONTIER! Bring six\\npartners and see how far you can\\lgo in the CHAMPIONS CIRCUIT.\\pThe ferry attendants can take you\\nthere. I'll be waiting for you!$"}
text:SSTidal_FastCurrentsHopeYouEnjoyVoyage	{'body': 'This ferry is built to plow through\\nfast-running currents.\\pWe hope you enjoy your voyage with us.\\nFeel free to explore the ship.$'}
text:SSTidal_HopeYouEnjoyVoyage	{'body': 'We hope you enjoy your voyage on\\nour ferry.$'}
text:SSTidal_MadeLandInSlateport	{'body': 'We have made land in SLATEPORT CITY.\\nThank you for sailing with us.$'}
text:SSTidal_MadeLandInLilycove	{'body': 'We have made land in LILYCOVE CITY.\\nThank you for sailing with us.$'}
text:SSTidalCorridor.CanRestInCabin2	{'body': "It'll be some time before we make land,\\nI reckon.\\pYou can rest up in your cabin if you'd\\nlike. Your cabin's No. 2.\\pThe bed in there is soft and plushy.\\nI can attest to how comfy it is!$"}
text:SSTidalCorridor.WeveArrived	{'body': "We've arrived!$"}
text:SSTidalCorridor.VisitOtherCabins	{'body': 'Go visit other cabins.\\nTRAINERS bored of the boat trip will\\lbe itching to battle.$'}
text:SSTidalCorridor.EnjoyYourCruise	{'body': 'Enjoy your cruise!$'}
text:SSTidalCorridor.HorizonSpreadsBeyondPorthole	{'body': 'The horizon spreads beyond\\nthe porthole.$'}
text:SSTidalCorridor.BrineyWelcomeAboard	{'body': 'MR. BRINEY: Welcome aboard, {PLAYER}{KUN}!\\pThey made me honorary captain of\\nthe S.S. TIDAL!\\pYou can call me CAPTAIN BRINEY now!\\pYou know, I retired once before,\\nbut when I saw this majestic ship…\\pLet me just say, it stirred my sleeping\\nsoul as a sailor!$'}
text:SSTidalCorridor.Peeko	{'body': 'PEEKO: Pihyo pihyohyo…$'}
text:SSTidalCorridor.Cabin1	{'body': 'Cabin 1$'}
text:SSTidalCorridor.Cabin2	{'body': 'Cabin 2$'}
text:SSTidalCorridor.Cabin3	{'body': 'Cabin 3$'}
text:SSTidalCorridor.Cabin4	{'body': 'Cabin 4$'}
text:SSTidalLowerDeck.PhillipIntro	{'body': "Arrrgh! I'm fed up and dog-tired of\\ncleaning this huge place!\\pLet's have a quick battle!$"}
text:SSTidalLowerDeck.PhillipDefeat	{'body': 'Little bro, I lost!$'}
text:SSTidalLowerDeck.PhillipPostBattle	{'body': "We're the CLEANUP BROTHERS!\\pThe old one dumps the detergent,\\nand the young one does the scrubbing!$"}
text:SSTidalLowerDeck.LeonardIntro	{'body': "This is the bottom of the ship's hull.\\nThere's plenty of room.\\lIt'll be alright for a POKéMON battle.$"}
text:SSTidalLowerDeck.LeonardDefeat	{'body': 'Big bro, I lost!$'}
text:SSTidalLowerDeck.LeonardPostBattle	{'body': "We're the CLEANUP BROTHERS!\\pThe old one dumps the detergent,\\nand the young one does the scrubbing!$"}
text:SSTidalRooms.TakeRestOnBed	{'body': "There's a bed…\\nLet's take a rest.$"}
text:SSTidalRooms.ColtonIntro	{'body': 'I often sail to LILYCOVE CITY.\\pI enjoy attending CONTESTS,\\nyou see.$'}
text:SSTidalRooms.ColtonDefeat	{'body': 'That was an enjoyable match!$'}
text:SSTidalRooms.ColtonPostBattle	{'body': "I get so excited imagining what kinds\\nof POKéMON I'll get to see in the next\\lCONTEST. The anticipation of it thrills!$"}
text:SSTidalRooms.MicahIntro	{'body': 'Are your friends strong?$'}
text:SSTidalRooms.MicahDefeat	{'body': 'Your friends are, indeed, strong.$'}
text:SSTidalRooms.MicahPostBattle	{'body': 'Friends need not be human.\\nFor me, POKéMON are treasured friends!$'}
text:SSTidalRooms.ThomasIntro	{'body': 'Child…\\nDid you knock on the door?$'}
text:SSTidalRooms.ThomasDefeat	{'body': 'A loss is to be accepted without haste\\nor panic.$'}
text:SSTidalRooms.ThomasPostBattle	{'body': "To be never ruffled in any situation is\\nthe GENTLEMAN's code of conduct.$"}
text:SSTidalRooms.JedIntro	{'body': "JED: I feel a little shy about this, but…\\nWe'll show you our lovey-dovey power!$"}
text:SSTidalRooms.JedDefeat	{'body': 'JED: Sigh…$'}
text:SSTidalRooms.JedPostBattle	{'body': "JED: It's the first time that our lovey-\\ndovey power couldn't prevail!\\lYou must be an awesome TRAINER!$"}
text:SSTidalRooms.JedNotEnoughMons	{'body': 'JED: We battle together!\\nBring two battle-ready POKéMON.$'}
text:SSTidalRooms.LeaIntro	{'body': "LEA: I feel a little silly, but…\\nWe'll show you our lovey-dovey power!$"}
text:SSTidalRooms.LeaDefeat	{'body': 'LEA: Oh, boo!$'}
text:SSTidalRooms.LeaPostBattle	{'body': "LEA: I can't believe it!\\nOur lovey-dovey power failed…\\lYou must be an awesome TRAINER!$"}
text:SSTidalRooms.LeaNotEnoughMons	{'body': 'LEA: I wanted to battle…\\nBring two battle-ready POKéMON!$'}
text:SSTidalRooms.GarretIntro	{'body': "Ah, you've come just in time.\\pI'm bored, you see.\\nYou may entertain me.$"}
text:SSTidalRooms.GarretDefeat	{'body': '…That will do.$'}
text:SSTidalRooms.GarretPostBattle	{'body': 'Perhaps I shall get Father to acquire\\na yacht for me.\\lA yacht for me and POKéMON!$'}
text:SSTidalRooms.NaomiIntro	{'body': "Oh, you're such an adorable TRAINER.\\nWould you like to have tea?\\lOr would you rather battle?$"}
text:SSTidalRooms.NaomiDefeat	{'body': "I see.\\nYou're the active sort.$"}
text:SSTidalRooms.NaomiPostBattle	{'body': 'A world cruise on a luxury liner has its\\ncharms, I must say…\\pBut, I will admit there is an appealing\\nside to touring HOENN by ferry.$'}
text:SSTidalRooms.NotSuspiciousTakeThis	{'body': "Uh… Hi! I'm not acting suspicious!\\pI didn't SNATCH this REAPER CLOTH\\nfrom anyone. It's clean! Take it!$"}
text:SSTidalRooms.ExplainReaperCloth	{'body': 'A REAPER CLOTH evolves DUSCLOPS.\\nUse it from the Bag when ready.$'}
text:SafariZone_Center_RestHouse	{'body': 'REST HOUSE$'}
text:SafariZone_Center_PressStartToCheckTime	{'body': 'TRAINER TIPS\\pPress START to check\\nremaining time.$'}
text:SafariZone_Center_CenterArea	{'body': 'CENTER AREA$'}
text:SafariZone_Center_WhereDidErikGo	{'body': 'SARA: Where did my boyfriend,\\nERIK, go?$'}
text:SafariZone_Center_CatchingMonsAsGifts	{'body': "I'm catching POKéMON to take home\\nas gifts.$"}
text:SafariZone_East_RestHouse	{'body': 'REST HOUSE$'}
text:SafariZone_East_TimeDeclinesOnlyWhileYouWalk	{'body': 'TRAINER TIPS\\pThe remaining time declines only\\nwhile you walk.$'}
text:SafariZone_East_AreaSign	{'body': 'AREA 1\\nWEST: CENTER AREA$'}
text:SafariZone_East_HowManyDidYouCatch	{'body': "How many did you catch?\\nI'm bushed from the effort!$"}
text:SafariZone_East_CaughtChanseyAllWorthwhile	{'body': 'I caught a CHANSEY!\\pThat makes this all worthwhile.$'}
text:SafariZone_East_TiredFromAllTheFun	{'body': "Whew!\\nI'm tired from all the fun!$"}
text:SafariZone_North_RestHouse	{'body': 'REST HOUSE$'}
text:SafariZone_North_SecretHouseStillAhead	{'body': 'TRAINER TIPS\\pThe SECRET HOUSE is still ahead.$'}
text:SafariZone_North_Area2	{'body': 'AREA 2$'}
text:SafariZone_North_ZigzagThroughTallGrass	{'body': 'TRAINER TIPS\\pPOKéMON hide in tall grass.\\pZigzag through grassy areas to\\nflush them out.$'}
text:SafariZone_North_WinFreeHMFindSecretHouse	{'body': 'TRAINER TIPS\\pWin a free HM for finding the\\nSECRET HOUSE.$'}
text:SafariZone_East_KeepAnyItemFoundOnSafari	{'body': "You can keep any item you find in\\nthe SAFARI ZONE.\\pBut, you'll run out of time if you\\ntry for all of them at once.$"}
text:SafariZone_East_PrizeInDeepestPartOfSafariZone	{'body': 'Go to the deepest part of the\\nSAFARI ZONE. You will win a prize!$'}
text:SafariZone_East_MyEeveeEvolvedIntoFlareon	{'body': "My EEVEE evolved into FLAREON.\\pBut, a friend's EEVEE turned into a\\nVAPOREON. I wonder why?$"}
text:SafariZone_SecretHouse_CongratsYouveWon	{'body': "Ah! Finally!\\pYou're the first person to reach\\nthe SECRET HOUSE!\\pAlthough I made a campaign\\nfor our grand opening,\\pI was getting worried that no one\\nwould win our campaign prize.\\pCongratulations!\\nYou have won!$"}
text:SafariZone_SecretHouse_ReceivedHM03FromAttendant	{'body': '{PLAYER} received HM03\\nfrom the attendant!$'}
text:SafariZone_SecretHouse_ExplainSurf	{'body': "HM03 is SURF.\\pPOKéMON will be able to ferry you\\nacross water using it.\\pAnd, this HM isn't disposable, so\\nyou can use it over and over.\\pYou're super lucky for winning this\\nfabulous prize!$"}
text:SafariZone_SecretHouse_DontHaveRoomForPrize	{'body': "You don't have room for this\\nfabulous prize!$"}
text:SafariZone_West_RestHouse	{'body': 'REST HOUSE$'}
text:SafariZone_West_PleaseFindWardensLostTeeth	{'body': "REQUEST NOTICE\\pPlease find the SAFARI WARDEN's\\nlost GOLD TEETH.\\lThey're around here somewhere.\\pReward offered!\\nContact: WARDEN$"}
text:SafariZone_West_SearchForSecretHouse	{'body': 'TRAINER TIPS\\pZone Exploration Campaign!\\nThe Search for the SECRET HOUSE!$'}
text:SafariZone_West_AreaSign	{'body': 'AREA 3\\nEAST: CENTER AREA$'}
text:SafariZone_West_KogaPatrolsSafariEverySoOften	{'body': "The SAFARI ZONE's huge, wouldn't\\nyou say?\\pFUCHSIA's GYM LEADER, KOGA, \\npatrols the grounds every so often.\\pThanks to him, we can play here\\nknowing that we're safe.$"}
text:SafariZone_West_RocksMakeMonRunButEasierCatch	{'body': "Tossing ROCKS at POKéMON might\\nmake them run, but they'll be\\leasier to catch.$"}
text:SafariZone_West_BaitMakesMonStickAround	{'body': 'Using BAIT will make POKéMON more\\nlikely to stick around if they get\\lbusy eating.$'}
text:SafariZone_West_HikedLotsDidntSeeMonIWanted	{'body': "I hiked a lot, but I didn't see any\\nPOKéMON I wanted.$"}
text:SaffronCity_CopycatsHouse_1F_DaughterIsSelfCentered	{'body': 'My daughter is so self-centered.\\nShe has but a few friends.$'}
text:SaffronCity_CopycatsHouse_1F_DaughterLikesToMimicPeople	{'body': "My daughter likes to mimic people.\\nIt's rather vexing.\\pHer mimicry has earned her the\\nnickname COPYCAT around here.$"}
text:SaffronCity_CopycatsHouse_1F_Chansey	{'body': 'CHANSEY: Chaan! Sii!$'}
text:SaffronCity_CopycatsHouse_2F_MimickingFavoriteHobbyMale	{'body': "{PLAYER}: Hi!\\nDo you like POKéMON?\\p{PLAYER}: Uh, no, I just asked you.\\p{PLAYER}: Huh?\\nYou're strange!\\pCOPYCAT: Hmm? Quit mimicking?\\nBut, that's my favorite hobby!$"}
text:SaffronCity_CopycatsHouse_2F_MimickingFavoriteHobbyFemale	{'body': "{PLAYER}: Hi.\\nYou must like POKéMON.\\p{PLAYER}: No, not me.\\nI asked you.\\p{PLAYER}: Pardon?\\nYou're weird!\\l \\lCOPYCAT: Hmm? Quit mimicking?\\lBut that's my favorite hobby!$"}
text:MimicTeach	{'body': 'Oh wow!\\nA POKé DOLL!\\pFor me?\\nThank you!\\pYou know what?\\nI can teach the move MIMIC.$'}
text:MimicDeclined	{'body': "Don't you like MIMIC?$"}
text:MimicWhichMon	{'body': "I really love MIMIC!\\nWho's going to learn it?$"}
text:MimicTaughtMale	{'body': "{PLAYER}: Hi!\\nThanks for earlier!\\p{PLAYER}: Pardon?\\p{PLAYER}: Is it that fun to mimic my\\nevery move?\\pCOPYCAT: You bet!\\nIt's a scream!$"}
text:MimicTaughtFemale	{'body': "{PLAYER}: Hi!\\nThanks for what you did for us.\\p{PLAYER}: Pardon?\\p{PLAYER}: Is it really that fun to\\ncopy what I say and do?\\pCOPYCAT: You bet!\\nIt's a scream!$"}
text:SaffronCity_CopycatsHouse_2F_Doduo	{'body': 'DODUO: Giiih!\\pPRETTY MIRROR LOOK AT ME,\\nSEE HOW PRETTY I CAN BE?$'}
text:SaffronCity_CopycatsHouse_2F_RareMonOnlyDoll	{'body': "This is a rare POKéMON!\\nHuh? It's only a doll!$"}
text:SaffronCity_CopycatsHouse_2F_MarioWearingABucket	{'body': 'A game with MARIO wearing a bucket\\non his head!$'}
text:SaffronCity_CopycatsHouse_2F_MySecrets	{'body': '…\\pMy Secrets!\\pSkill: Mimicry!\\nHobby: Collecting dolls!\\lFavorite POKéMON: CLEFAIRY!$'}
text:SaffronCity_Dojo_MasterKoichiIntro	{'body': 'Grunt!\\pI am the KARATE MASTER!\\nI am the LEADER here!\\pYou wish to challenge us?\\nExpect no mercy!\\pFwaaa!$'}
text:SaffronCity_Dojo_MasterKoichiDefeat	{'body': 'Hwa!\\nArrgh! Beaten!$'}
text:SaffronCity_Dojo_ChoosePrizedFightingMon	{'body': 'Indeed, I have lost!\\pBut, I beseech you, do not take\\nour emblem as your trophy!\\pIn return, I will give you a prized\\nFIGHTING POKéMON!\\pChoose whichever one you like!$'}
text:SaffronCity_Dojo_StayAndTrainWithUs	{'body': 'Grunt!\\nStay and train at karate with us!$'}
text:SaffronCity_Dojo_MikeIntro	{'body': 'Hoargh!\\nTake your shoes off!$'}
text:SaffronCity_Dojo_MikeDefeat	{'body': 'I give up!$'}
text:SaffronCity_Dojo_MikePostBattle	{'body': "You wait 'til you see our MASTER!\\nI'm a small fry compared to him!$"}
text:SaffronCity_Dojo_HidekiIntro	{'body': "I hear you're good!\\nShow me!$"}
text:SaffronCity_Dojo_HidekiDefeat	{'body': 'Judge!\\nOne point!$'}
text:SaffronCity_Dojo_HidekiPostBattle	{'body': 'Our MASTER is a pro fighter.\\nBe prepared to lose!$'}
text:SaffronCity_Dojo_AaronIntro	{'body': 'Hiyah!\\nI have no fear for anything tough!\\pI shatter boulders for training\\nevery day!$'}
text:SaffronCity_Dojo_AaronDefeat	{'body': 'Yow!\\nStubbed fingers!$'}
text:SaffronCity_Dojo_AaronPostBattle	{'body': 'The only thing that frightens us is\\npsychic power!$'}
text:SaffronCity_Dojo_HitoshiIntro	{'body': "Hwaah!\\pYou're trespassing in our\\nFIGHTING DOJO!$"}
text:SaffronCity_Dojo_HitoshiDefeat	{'body': 'Oof!\\nI give up!$'}
text:SaffronCity_Dojo_HitoshiPostBattle	{'body': 'The prime fighters across the land\\ntrain here.$'}
text:SaffronCity_Dojo_YouWantHitmonlee	{'body': 'You want the hard-kicking\\nHITMONLEE?$'}
text:SaffronCity_Dojo_ReceivedMonFromKarateMaster	{'body': '{PLAYER} received the {STR_VAR_1}\\nfrom the KARATE MASTER.$'}
text:SaffronCity_Dojo_YouWantHitmonchan	{'body': 'You want the piston-punching\\nHITMONCHAN?$'}
text:SaffronCity_Dojo_ReceivedMonFromKarateMaster2	{'body': '{PLAYER}は\u3000カラテ\u3000だいおう\u3000から\\n{STR_VAR_1}を\u3000もらった！$'}
text:SaffronCity_Dojo_BetterNotGetGreedy	{'body': 'Better not get greedy…$'}
text:SaffronCity_Dojo_EnemiesOnEverySide	{'body': 'Enemies on every side!$'}
text:SaffronCity_Dojo_GoesAroundComesAround	{'body': 'What goes around comes around.$'}
text:SaffronCity_Dojo_FightingDojo	{'body': 'FIGHTING DOJO$'}
text:SaffronCity_WhatDoYouWantGetLost	{'body': 'What do you want?\\nGet lost!$'}
text:SaffronCity_BossTakeTownForTeamRocket	{'body': "BOSS said he'll take this town\\nin the name of TEAM ROCKET!$"}
text:SaffronCity_DontGetDefiantOrIllHurtYou	{'body': "Don't get defiant!\\nOr I'll have to hurt you!$"}
text:SaffronCity_SaffronBelongsToTeamRocket	{'body': 'SAFFRON belongs to TEAM ROCKET!$'}
text:SaffronCity_CriminalLifeMakesMeFeelAlive	{'body': 'My life as a criminal makes me feel\\nso alive!$'}
text:SaffronCity_WatchWhereYoureWalking	{'body': "Ow!\\nWatch where you're walking!$"}
text:SaffronCity_WeCanExploitMonsAroundWorld	{'body': "With SILPH under control, we can\\nexploit POKéMON around the world!\\pWe'll get stinking rich, yeahah!$"}
text:SaffronCity_YouBeatTeamRocket	{'body': "You beat TEAM ROCKET all alone?\\nThat's amazing!$"}
text:SaffronCity_SafeToGoOutAgain	{'body': "Yeah! TEAM ROCKET is gone!\\nIt's safe to go out again!$"}
text:SaffronCity_PeopleComingBackToSaffron	{'body': 'People fled from here in droves\\nwhen those ROCKETS came.\\pThey should be flocking back to\\nSAFFRON now.$'}
text:SaffronCity_FlewHereOnPidgeot	{'body': "I flew here on my PIDGEOT when\\nI read about SILPH.\\pIt's already over?\\nI missed the media action…$"}
text:SaffronCity_Pidgeot	{'body': 'PIDGEOT: Bi bibii!$'}
text:SaffronCity_SawRocketBossEscaping	{'body': "I saw the ROCKET BOSS escaping\\nSILPH's building.$"}
text:SaffronCity_ImASecurityGuard	{'body': "I'm a security guard.\\pSuspicious kids I don't allow in!$"}
text:SaffronCity_HesTakingASnooze	{'body': "…\\nSnore…\\pHah! He's taking a snooze!$"}
text:SaffronCity_CitySign	{'body': 'SAFFRON CITY\\nShining, Golden Land of Commerce$'}
text:SaffronCity_FightingDojo	{'body': 'FIGHTING DOJO$'}
text:SaffronCity_GymSign	{'body': 'SAFFRON CITY POKéMON GYM\\nLEADER: SABRINA\\lThe Master of PSYCHIC POKéMON!$'}
text:SaffronCity_FullHealCuresStatus	{'body': "TRAINER TIPS\\pFULL HEAL cures all ailments like\\nburns, paralysis, poisoning,\\lfreezing, and sleep.\\pIt costs a bit more, but it's more\\nconvenient than buying other items.$"}
text:SaffronCity_GreatBallImprovedCatchRate	{'body': 'TRAINER TIPS\\pThe new GREAT BALL offers improved\\ncatching rates.\\pTry it on those hard-to-catch\\nPOKéMON.$'}
text:SaffronCity_SilphCoSign	{'body': 'SILPH CO. OFFICE BUILDING$'}
text:SaffronCity_MrPsychicsHouse	{'body': "MR. PSYCHIC'S HOUSE$"}
text:SaffronCity_SilphsLatestProduct	{'body': "SILPH's latest product!\\nRelease to be determined…$"}
text:SaffronCity_TrainerFanClubSign	{'body': 'POKéMON TRAINER FAN CLUB\\pMany TRAINERS have scribbled their\\nnames on this sign.$'}
text:SaffronCity_HowCanClubNotRecognizeLance	{'body': "This FAN CLUB…\\nNo one here has a clue!\\pHow could they not recognize\\nthe brilliance that is LANCE?\\pHe stands for justice!\\nHe's cool, and yet passionate!\\lHe's the greatest, LANCE!$"}
text:SaffronCity_Gym_SabrinaIntro	{'body': 'I had a vision of your arrival.\\pI have had psychic powers since\\nI was a child.\\pIt started when a spoon I\\ncarelessly tossed, bent.\\pI dislike battling, but if you wish,\\nI will show you my powers!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$'}
text:SaffronCity_Gym_SabrinaDefeat	{'body': "This loss shocks me!\\nBut, a loss is a loss.\\pI admit, I didn't work hard enough\\nto win.\\pYour victory has earned you the\\nMARSHBADGE.$"}
text:SaffronCity_Gym_SabrinaPostBattle	{'body': "Psychic power isn't something that\\nonly a few people have.\\pEveryone has psychic power.\\nPeople just don't realize it.$"}
text:SaffronCity_Gym_ExplainMarshBadgeTakeThis	{'body': "The MARSHBADGE makes POKéMON up\\nto Lv. 70 obey you.\\pStronger POKéMON will become wild,\\nignoring your orders in battle.\\pJust don't raise your POKéMON too\\nmuch to avoid that problem.\\pWait, please take this TM with you.$"}
text:SaffronCity_Gym_ReceivedTM04FromSabrina	{'body': '{PLAYER} received TM04 from\\nSABRINA.$'}
text:SaffronCity_Gym_ExplainTM04	{'body': 'TM04 is CALM MIND.\\pIt makes the POKéMON concentrate\\nto raise both SP. ATK and SP. DEF.$'}
text:SaffronCity_Gym_BagFullOfOtherItems	{'body': 'Your BAG is full of other items.$'}
text:SaffronCity_Gym_AmandaIntro	{'body': 'SABRINA is far younger than I,\\nbut she has earned my respect.$'}
text:SaffronCity_Gym_AmandaDefeat	{'body': 'Not good enough!$'}
text:SaffronCity_Gym_AmandaPostBattle	{'body': 'In a battle of equals, the one\\nwith the stronger will wins.\\pIf you wish to beat SABRINA, focus\\nand will yourself to victory.$'}
text:SaffronCity_Gym_JohanIntro	{'body': 'Does our unseen power scare you?$'}
text:SaffronCity_Gym_JohanDefeat	{'body': 'I never foresaw this!$'}
text:SaffronCity_Gym_JohanPostBattle	{'body': 'PSYCHIC POKéMON fear only ghosts\\nand bugs!$'}
text:SaffronCity_Gym_StacyIntro	{'body': 'POKéMON take on the appearance of\\ntheir TRAINERS.\\pYour POKéMON must be tough, then!$'}
text:SaffronCity_Gym_StacyDefeat	{'body': 'I knew it!$'}
text:SaffronCity_Gym_StacyPostBattle	{'body': 'I have much to learn still…\\pI must master PSYCHIC and teach it\\nto my POKéMON…$'}
text:SaffronCity_Gym_TyronIntro	{'body': "You understand, don't you?\\pThat power alone isn't enough to\\nwin in the world of POKéMON?$"}
text:SaffronCity_Gym_TyronDefeat	{'body': "I don't believe this!$"}
text:SaffronCity_Gym_TyronPostBattle	{'body': 'SABRINA just wiped out the KARATE\\nMASTER next door.$'}
text:SaffronCity_Gym_TashaIntro	{'body': 'You and I, our POKéMON shall\\nbattle!$'}
text:SaffronCity_Gym_TashaDefeat	{'body': 'I lost after all!$'}
text:SaffronCity_Gym_TashaPostBattle	{'body': 'I knew that this was going to take\\nplace.$'}
text:SaffronCity_Gym_CameronIntro	{'body': "SABRINA is young, but she's also\\nour highly skilled LEADER.\\pYou won't reach her easily!$"}
text:SaffronCity_Gym_CameronDefeat	{'body': 'Ow!\\nDown and out!$'}
text:SaffronCity_Gym_CameronPostBattle	{'body': 'There used to be two POKéMON GYMS\\nin SAFFRON.\\pThe FIGHTING DOJO next door lost\\nits GYM status, though.\\pWe simply creamed them when we\\ndecided to have just one GYM.$'}
text:SaffronCity_Gym_PrestonIntro	{'body': "SAFFRON POKéMON GYM is famous for\\ntraining psychics.\\pYou want to see SABRINA, don't\\nyou? I can tell!$"}
text:SaffronCity_Gym_PrestonDefeat	{'body': 'Arrrgh!$'}
text:SaffronCity_Gym_PrestonPostBattle	{'body': "That's right! I used telepathy to\\nread your mind!$"}
text:SaffronCity_Gym_GymGuyAdvice	{'body': "Yo!\\nChamp in the making!\\pSABRINA's POKéMON use psychic\\npower instead of force.\\pFIGHTING POKéMON are especially\\nweak against PSYCHIC POKéMON.\\pThey'll get destroyed before they\\ncan even aim a punch!$"}
text:SaffronCity_Gym_GymGuyPostVictory	{'body': "Psychic power, huh?\\pIf I had that, I'd make a bundle\\nat the slots!$"}
text:SaffronCity_Gym_GymStatue	{'body': 'SAFFRON POKéMON GYM\\nLEADER: SABRINA\\pWINNING TRAINERS:\\n{RIVAL}$'}
text:SaffronCity_Gym_GymStatuePlayerWon	{'body': 'SAFFRON POKéMON GYM\\nLEADER: SABRINA\\pWINNING TRAINERS:\\n{RIVAL}, {PLAYER}$'}
text:SaffronCity_House_DontLookAtMyLetter	{'body': "…Thank you for writing.\\nI hope to see you soon!\\p…Hey!\\nDon't look at my letter!$"}
text:SaffronCity_House_Pidgey	{'body': 'PIDGEY: Kurukkoo!$'}
text:SaffronCity_House_GettingCopycatPokeDoll	{'body': "The COPYCAT is cute!\\nI'm getting her a POKé DOLL.$"}
text:SaffronCity_House_ExplainPPUp	{'body': "I was given a PP UP as a gift.\\pIt's used to increase the PP of\\na POKéMON's move.\\pI should use it on a powerful move\\nwith only a few PP.$"}
text:SaffronCity_Mart_MaxRepelMoreEffectiveThanSuper	{'body': 'MAX REPEL keeps weaker POKéMON\\nfrom appearing.\\pMAX REPEL stays effective longer\\nthan SUPER REPEL.$'}
text:SaffronCity_Mart_ReviveIsCostly	{'body': 'REVIVE is costly, but it revives\\nfainted POKéMON!$'}
text:SaffronCity_MrPsychicsHouse_YouWantedThis	{'body': "…Wait! Don't say a word!\\pYou wanted this!$"}
text:SaffronCity_MrPsychicsHouse_ReceivedTM29FromMrPsychic	{'body': '{PLAYER} received TM29\\nfrom MR. PSYCHIC.$'}
text:SaffronCity_MrPsychicsHouse_ExplainTM29	{'body': "You already know, don't you?\\nTM29 is PSYCHIC.\\pIt's an attack that may also lower\\nthe target's special stats.$"}
text:SaffronCity_MrPsychicsHouse_YouveNoRoom	{'body': "Where do you plan to put this?\\nYou've no room.$"}
text:SaffronCity_PokemonCenter_1F_GrowthRatesDifferBySpecies	{'body': 'POKéMON growth rates differ from\\nspecies to species.$'}
text:SaffronCity_PokemonCenter_1F_SilphCoVictimOfFame	{'body': "SILPH CO. is widely known to all.\\pIt's a victim of its own fame - it\\nattracted TEAM ROCKET.$"}
text:SaffronCity_PokemonCenter_1F_GreatIfEliteFourCameBeatRockets	{'body': "Sigh…\\nWouldn't this be great?\\pIf the ELITE FOUR came and\\nstomped TEAM ROCKET?$"}
text:SaffronCity_PokemonCenter_1F_TeamRocketTookOff	{'body': "TEAM ROCKET took off!\\nWe can go out safely again!\\lThat's great!$"}
text:SaffronCity_PokemonTrainerFanClub_HuhYou	{'body': 'Huh?\\nYou…$'}
text:SaffronCity_PokemonTrainerFanClub_YourePlayerWereYourFansNow	{'body': "Are you maybe…\\n… …\\pYou are!\\nYou are {PLAYER}!\\pWe were just talking about you!\\pWe were talking about how an\\nincredibly good TRAINER appeared.\\pAnd that someone is you!\\nYou're so cool!\\pSo, we decided that we'll become\\nyour FAN CLUB!\\pWe all hope you'll keep battling\\nand show us how cool you are.\\pThat way, maybe other people will\\nbecome fans just like me.$"}
text:SaffronCity_PokemonTrainerFanClub_AlwaysCheerForYou	{'body': "I'll always be cheering for you!\\pGo, {PLAYER}, go!$"}
text:SaffronCity_PokemonTrainerFanClub_IllAlwaysBelieveInYou	{'body': "I'll always believe in you,\\n{PLAYER}.\\pPlease show the others what you're\\nlike when you battle seriously.$"}
text:SaffronCity_PokemonTrainerFanClub_WasYourFanNotAnymore	{'body': "I'm sorry.\\nI was your fan before.\\pBut now, you seem to have lost\\nthe drive you had before.\\pLately, I think {STR_VAR_1} has been\\na lot cooler.$"}
text:SaffronCity_PokemonTrainerFanClub_EveryonesYourFanButICantBe	{'body': "Oh!\\n{PLAYER}!\\pEveryone's been all excited about\\nyou recently.\\pI can understand why.\\nI know that you're strong.\\pBut, do you know what?\\pOnce I became {STR_VAR_1}'s fan,\\nI can't just stop being a fan.$"}
text:SaffronCity_PokemonTrainerFanClub_TrainersCoolWhenBattling	{'body': "I think TRAINERS are so cool when\\nthey're battling.\\pDon't you think so, too?$"}
text:SaffronCity_PokemonTrainerFanClub_CanYouAutographShorts	{'body': "Oh! It's {PLAYER}!\\nToo cool!\\pOh!\\nOh, yeah!\\pCan you autograph something?\\nHow about my shorts?$"}
text:SaffronCity_PokemonTrainerFanClub_CountingOnYou	{'body': "However hot it's been…\\pAnd however cold it may get…\\pI've always believed in, and worn,\\nshorts!\\pI'm counting on you to keep\\nwinning!\\pI believe in you just as much as\\nI believe in shorts!$"}
text:SaffronCity_PokemonTrainerFanClub_BrocksMyHero	{'body': "BROCK's my hero!\\nHe's a man among men!\\pHeheh, I got my mom to do\\nsomething for me.\\pI got her to embroider “BROCK”\\non my shorts!$"}
text:SaffronCity_PokemonTrainerFanClub_BrocksFanToBitterEnd	{'body': "…  …\\p…  …\\nI'm BROCK's fan!\\pEven if I were his only fan,\\nI swear it on my rock-hard will,\\land on my shorts!\\pI'll be his fan to the bitter end!$"}
text:SaffronCity_PokemonTrainerFanClub_BrocksLastWordOnCool	{'body': "BROCK's the last word on cool,\\nend of story!\\pNow there's a guy who I want to\\nbe like!$"}
text:SaffronCity_PokemonTrainerFanClub_HadPleasureOfWatchingYouBattle	{'body': "{PLAYER}, I've had the pleasure of\\nwatching you battle.\\pIt brings back sweet memories of\\nmy own long-lost youth.\\pMay you continue to find success.\\nYou have a fan in me!$"}
text:SaffronCity_PokemonTrainerFanClub_NeverSeenTrainerOfYourMagnificence	{'body': 'I have journeyed far and wide\\nacross the lands.\\pBut never have I seen a TRAINER\\nof your magnificence.\\pTake courage in your abilities\\nand keep battling on!\\pMake that a promise to me,\\nmy young idol!$'}
text:SaffronCity_PokemonTrainerFanClub_HmmAndYouAre	{'body': 'Hmm…\\nAnd you are?\\pWere you hoping to sign up for\\na membership in our FAN CLUB?$'}
text:SaffronCity_PokemonTrainerFanClub_YouveStillAWaysToGo	{'body': "Ah, so you are the much-\\ntalked-about {PLAYER}.\\pYou certainly do have the look of\\na winner.\\pBut for me to accept you as\\na true POKéMON great…\\p… …\\pYou've still a ways to go!$"}
text:SaffronCity_PokemonTrainerFanClub_YoullBeTalkedAboutIfYouKeepWinning	{'body': 'All of us gathered here are fans\\nof POKéMON TRAINERS.\\pThe way they look in battle…\\nThey are the picture of coolness.\\pPerhaps you will be talked about\\nhere, too, if you keep winning.$'}
text:SaffronCity_PokemonTrainerFanClub_WantToBeLikeYouOneDay	{'body': "It's {PLAYER}!\\nIt's {PLAYER}!\\pI want to be like {PLAYER} one day!$"}
text:SaffronCity_PokemonTrainerFanClub_EveryoneButMeStoppedBeingYourFan	{'body': "Everyone stopped being {PLAYER}'s\\nfan…\\pBut that means I can have {PLAYER}\\nall to myself!\\pYay! Go for it!\\nMy one and only {PLAYER}!$"}
text:SaffronCity_PokemonTrainerFanClub_WantToBeLikeSabrina	{'body': 'Do you know what?\\nI want to be like SABRINA!\\pI want to be a psychic girl just\\nlike her!$'}
text:SaffronCity_PokemonTrainerFanClub_WontStopBeingSabrinasFan	{'body': "Even if I'm the only one, I won't\\nstop being SABRINA's fan.\\pMy dream is to be like SABRINA,\\ncute, but cool.\\pI want to be a psychic girl just\\nlike her!$"}
text:SaffronCity_PokemonTrainerFanClub_CanIBecomeCoolTrainerOneDay	{'body': 'I wonder if I can become a cool\\nTRAINER one day?$'}
text:SaffronCity_PokemonTrainerFanClub_TheWayYouBattleIsCool	{'body': "Oh, man, oh, man!\\nCool! Too cool!\\p…Huh?\\nNo, not you.\\pJust the way you battle.\\nThat's cool.$"}
text:SaffronCity_PokemonTrainerFanClub_ImOnlyOneLeftOfYourFans	{'body': "Yo, {PLAYER}!\\pLooks like I'm the only one left\\nout of your fans.\\pBut, you know, I like being an only\\nfan… It's less stressful.\\pKeep up and at it!$"}
text:SaffronCity_PokemonTrainerFanClub_LoveWayTrainerTalks	{'body': "{STR_VAR_1}'s cool, huh?\\nI love the way he talks.\\pI'd really relish a chance to meet\\nhim in person once.$"}
text:SaffronCity_PokemonTrainerFanClub_ImLoneTrainerFan	{'body': "Huh, can you believe it?\\nEveryone turned into your fans.\\pSo after all we've been through,\\nI'm the lone {STR_VAR_1} fan?\\pEh, being the one and only\\n{STR_VAR_1} fan's my style, anyway.$"}
text:SaffronCity_PokemonTrainerFanClub_AdoreWayYouBattle	{'body': "Oh, my goodness!\\nIs it really you, {PLAYER}?\\pI have to tell you, I adore the\\nway you battle.\\pI hope you'll keep at it.\\nI'll be your number one fan!$"}
text:SaffronCity_PokemonTrainerFanClub_ImYourNumberOneFan	{'body': "Oh, my goodness!\\nIf it isn't {PLAYER}!\\pIt's so disappointing… I realized\\nI'm your number-one-and-only fan!\\pWell, it can't be helped!\\nLet me cheer you on, at least!\\pHurray, hurray, {PLAYER}!$"}
text:SaffronCity_PokemonTrainerFanClub_TrainerHasBeenOnFire	{'body': "Recently, {STR_VAR_1} has been on\\nfire.\\pThe way he battles… It's just \\nthe way that I like it!$"}
text:SaffronCity_PokemonTrainerFanClub_EveryoneTalksAboutYou	{'body': "Oh, hello!\\nIf it isn't {PLAYER}!\\pLately, all everyone talks about\\nis you.\\pI'm feeling lonesome because I\\nprefer {STR_VAR_1}.$"}
text:SaffronCity_PokemonTrainerFanClub_YouReallyAreAmazing	{'body': 'Amazing!\\n{PLAYER}, you really are amazing!\\pInstead of just watching, maybe\\nI should become a TRAINER, too.$'}
text:SaffronCity_PokemonTrainerFanClub_ImYourOnlyFan	{'body': "I'm your only fan…\\nSigh… This is lonely…\\pCan't you try harder and make the\\nothers take notice of you?$"}
text:SaffronCity_PokemonTrainerFanClub_WhyCantOthersSeeMastersDignity	{'body': "Master {STR_VAR_1} is so dignified…\\nHe is so my type.\\pWhy can't the others see the\\ndignity he simply oozes?$"}
text:SaffronCity_PokemonTrainerFanClub_BelieveInMasterWithAllMyHeart	{'body': "I believe in Master {STR_VAR_1}\\nwith all my heart.\\pEven if I am the only one to\\nbelieve in him.\\pI won't ever feel lonesome, though.\\pNot if I keep thinking about Master\\n{STR_VAR_1}.$"}
text:SaffronCity_PokemonTrainerFanClub_YourBattleStyleIsEducational	{'body': 'Hiyah!\\pYour battling style is most\\neducational.\\pI hope that you will keep plugging\\naway at success, hiyah!$'}
text:SaffronCity_PokemonTrainerFanClub_WontStopBeingYourFan	{'body': "Instead of just watching others\\nbattle, battle yourself!\\p…My DOJO's MASTER chewed me out\\nlike that…\\pBut I won't let that stop me from\\nbeing your fan!\\pI can't stop being your fan!$"}
text:SaffronCity_PokemonTrainerFanClub_OnlyMasterHasMyRespect	{'body': 'Hiyah! There is but one TRAINER\\nwho has my respect.\\pAnd that is none other than my\\nMASTER at the FIGHTING DOJO.\\pYou should become a fan of my\\nMASTER like me! Hiyah!$'}
text:SaffronCity_PokemonTrainerFanClub_NeverBeFanOfAnyoneButMaster	{'body': 'Hiyah! I respect my MASTER at the\\nFIGHTING DOJO.\\pI will never become a fan of\\nanyone other than my MASTER!\\pI will even sneak out of the DOJO\\nto spread word of his greatness.\\pHiyah!$'}
text:SandstrewnRuins.Archaeologist	{'body': 'Every fossil here tells us how a\\nPOKéMON lived. Imagine this place\\lbefore the desert!\\pThose green lights below us may\\nbe ZYGARDE. Search B1F. It has\\la 3% wild encounter chance.$'}
text:ScorchedSlab_B2F.Warden	{'body': 'A white dragon has been glimpsed\\namong these hot stones. RESHIRAM!\\pThe sign lists the wild POKéMON\\nhere, including that rare dragon.$'}
text:ScorchedSlab_B2F.ReshiramCaught	{'body': "You've befriended RESHIRAM?\\nThen the white dragon's journey\\lcontinues beyond these stones.$"}
text:ScorchedSlab_B2F.HeatranClue	{'body': 'HEATRAN sleeps farther below.\\pThey say a MAGMA STONE can\\nawaken it. Search the MAGMA\\lHIDEOUT beneath MT. CHIMNEY.$'}
text:ScorchedSlab_B2F.HeatranCaught	{'body': 'HEATRAN travels with you, too?\\nThese caves have shared quite a secret!$'}
text:ScorchedSlab_B2F.HeatranAwake	{'body': 'HEATRAN is awake in the room below.\\pIf it retreats after a battle, leave\\nthat room and return to find it.$'}
text:ScorchedSlab_HeatransRoom.PlaceMagmaStone	{'body': 'The MAGMA STONE is reacting\\nto something…\\pWill you set it down here?$'}
text:SeafloorCavern_Entrance.HearMagmaNearMossdeep	{'body': "Hey! I remember your face!\\nYou just keep turning up!\\pYou followed our sub down here?\\nDon't tell me you swam!\\pARCHIE says the ocean needs room\\nto breathe. We came all this way\\lto give it that chance.\\pYou won't stop us now. There are\\nplenty of us waiting inside!$"}
text:SeafloorCavern_Entrance.HearMagmaNearMossdeepShort	{'body': 'ARCHIE says the ocean needs room\\nto breathe. We came all this way\\lto give it that chance.\\pGo on, then. The others inside\\nwill send you back to the surface!$'}
text:SeafloorCavern_Room1.Grunt1Intro	{'body': 'Those currents outside spun our sub\\naround. You should turn back while\\lyou still know the way!$'}
text:SeafloorCavern_Room1.Grunt1Defeat	{'body': 'You kept your footing better than me!$'}
text:SeafloorCavern_Room1.Grunt1PostBattle	{'body': 'ARCHIE went deeper into the cavern.\\nThose twisting passages ought to\\lkeep you busy for a while.$'}
text:SeafloorCavern_Room1.Grunt2Intro	{'body': "The channel outside was just wide\\nenough for our sub. But this passage\\lisn't wide enough for both of us!$"}
text:SeafloorCavern_Room1.Grunt2Defeat	{'body': 'You opened the route again…$'}
text:SeafloorCavern_Room1.Grunt2PostBattle	{'body': 'We left the submarine outside.\\nARCHIE took the crew farther in.\\lI was supposed to guard the way...$'}
text:SeafloorCavern_Room3.ShellyIntro	{'body': "SHELLY: You reached the seafloor\\nwithout a submarine… Impressive.\\pFirst the WEATHER INSTITUTE, now\\nhere. You really intend to stop\\lARCHIE.\\pThen you'll have to get past me\\nagain!$"}
text:SeafloorCavern_Room3.ShellyDefeat	{'body': "You've grown stronger since we\\nmet…$"}
text:SeafloorCavern_Room3.ShellyPostBattle	{'body': "SHELLY: We wanted more room for\\nsea POKéMON to live. That's why I\\ljoined AQUA.\\pARCHIE is beyond this room. I hope\\nhe still remembers why we came.$"}
text:SeafloorCavern_Room3.Grunt5Intro	{'body': "Our submarine brought us this far.\\nYour POKéMON brought you.\\pThey're tough, I'll give you that.\\nBut I'm not letting you through!$"}
text:SeafloorCavern_Room3.Grunt5Defeat	{'body': 'You really did come prepared…$'}
text:SeafloorCavern_Room3.Grunt5PostBattle	{'body': "I joined AQUA because I love the\\nsea.\\pI thought I'd feel at home down\\nhere. Now I just want to see the\\lsky again.$"}
text:SeafloorCavern_Room4.Grunt3Intro	{'body': 'Who are you? How did you even get\\ndown here without the sub?$'}
text:SeafloorCavern_Room4.Grunt3Defeat	{'body': "Lost it… and I'm lost.$"}
text:SeafloorCavern_Room4.Grunt3PostBattle	{'body': "I can't find the way out. I'm not\\nscared. Don't get me wrong!$"}
text:SeafloorCavern_Room4.Grunt4Intro	{'body': "Who are you? Where do you think\\nyou're going? Not past TOXAPEX.$"}
text:SeafloorCavern_Room4.Grunt4Defeat	{'body': 'I failed to win. Twice today.$'}
text:SeafloorCavern_Room4.Grunt4PostBattle	{'body': "My partner left the map in the sub.\\nHow's that for useless?$"}
text:SeafloorCavern_Room9.ArchieHoldItRightThere	{'body': 'ARCHIE: Hold it right there.$'}
text:SeafloorCavern_Room9.ArchieSoItWasYou	{'body': 'ARCHIE: Fufufu…\\nSo it was you, after all.$'}
text:SeafloorCavern_Room9.ArchieBeholdKyogre	{'body': 'ARCHIE: Look at it, {PLAYER}.\\nKYOGRE! The POKéMON that made the\\lsea.\\pWith its power, the ocean can\\ngrow. Sea POKéMON will have all\\lthe space they need!$'}
text:SeafloorCavern_Room9.ArchieYouMustDisappear	{'body': "You've chased us this far. But I\\nwon't let you stop us now!\\pThis dream means everything to\\nTEAM AQUA!$"}
text:SeafloorCavern_Room9.ArchieDefeat	{'body': 'No… Not after coming so far!$'}
text:SeafloorCavern_Room9.ArchieWithThisRedOrb	{'body': 'ARCHIE: You won. But the RED ORB\\ncan still call KYOGRE!\\pKYOGRE! Give the sea room to grow!$'}
text:SeafloorCavern_Room9.RedOrbShinesByItself	{'body': 'The RED ORB suddenly began shining\\nby itself!$'}
text:SeafloorCavern_Room9.ArchieWhereDidKyogreGo	{'body': "ARCHIE: What?!\\pThe ORB… I didn't make it shine!\\pWhere did KYOGRE go?$"}
text:SeafloorCavern_Room9.ArchieAMessageFromOutside	{'body': "ARCHIE: Hm? It's a message from our\\nmembers outside…$"}
text:SeafloorCavern_Room9.ArchieWhatRainingTooHard	{'body': 'ARCHIE: Heavy rain? Good! KYOGRE\\nis expanding the sea!\\pWhat? The routes are flooding?\\nOur own crews are trapped?\\pTell them to get to high ground!\\nHow can the rain still be getting\\lworse?$'}
text:SeafloorCavern_Room9.ArchieWhyDidKyogreDisappear	{'body': "ARCHIE: The RED ORB woke KYOGRE.\\nWhy won't it answer me now?\\pI never wanted people to get\\nhurt…$"}
text:SeafloorCavern_Room9.MaxieWhatHaveYouWrought	{'body': "MAXIE: ARCHIE! KYOGRE's rain is\\nspreading, and GROUDON's heat is\\lgetting worse.\\pIf they meet, the people and\\nPOKéMON of HOENN will be caught\\lbetween them!$"}
text:SeafloorCavern_Room9.ArchieDontGetAllHighAndMighty	{'body': "ARCHIE: You're the one who woke\\nGROUDON!\\pI thought the ORB would let me\\ncontrol KYOGRE. But it's not\\llistening. Neither of them is!$"}
text:SeafloorCavern_Room9.MaxieWeDontHaveTimeToArgue	{'body': "MAXIE: We can argue later! We\\nneed to get everyone out of this\\lcavern.\\pCome and see what's happening\\noutside, ARCHIE. We have to stop\\lit.$"}
text:SeafloorCavern_Room9.MaxieComeOnPlayer	{'body': 'MAXIE: {PLAYER}, come on, you have\\nto get out of here, too!$'}
text:RockSlideTeach	{'body': "When you're up on a rocky mountain\\nlike this, rockslides are a threat.\\pCan you imagine?\\nBoulders tumbling down on you?\\pThat'd be, like, waaaaaaaaaaah!\\nTotal terror!\\pYou don't seem to be scared.\\nWant to try using ROCK SLIDE?$"}
text:RockSlideDeclined	{'body': 'Oh, so you are scared after all.$'}
text:RockSlideWhichMon	{'body': 'Which POKéMON should I teach\\nROCK SLIDE?$'}
text:RockSlideTaught	{'body': 'It might be scary to use it in this\\ntunnel…$'}
text:SeafoamIslands_B4F_BouldersMightChangeWaterFlow	{'body': 'Hint: Boulders might change the\\nflow of water.$'}
text:SeafoamIslands_B4F_DangerFastCurrent	{'body': 'DANGER\\nFast current!$'}
text:SealedChamber_InnerRoom.RegigigasStatue	{'body': "It's a statue of a Pokémon.\\nIt exudes tremendous power…\\pThere's something engraved on it…$"}
text:SealedChamber_InnerRoom.RegigigasECAwakens	{'body': 'The three REGIS answer together!\\nThe colossal statue begins to move!$'}
text:Seaspray_Cave.Explorer	{'body': 'The shifting tides exposed this\\ncave, but they did not create it.\\pExplore its deeper chambers.\\nUnusual water POKéMON have made a\\lhome beneath the coast.$'}
text:SwordsDanceTeach	{'body': "Not many people come out here.\\pIf I train here, I'm convinced that\\nI'll get stronger and stronger.\\pYep, stronger and stronger…\\pHow would you like to learn a move\\nlike that? It's SWORDS DANCE.$"}
text:SwordsDanceDeclined	{'body': "Well, that's fine, too.$"}
text:SwordsDanceWhichMon	{'body': 'All right, pick which POKéMON\\nI should teach it to.$'}
text:SwordsDanceTaught	{'body': 'If only we could keep getting\\nstronger and stronger, eh?$'}
text:SevenIsland_IslandSign	{'body': 'SEVEN ISLAND\\nQuest Island of Infinity$'}
text:SevenIsland_IslandsMadeInSevenDays	{'body': "These islands are called the SEVII\\nISLANDS because there are seven.\\p…Or at least that's what the young\\npeople believe.\\pThe truth is, these islands are so\\nnamed because they are said to\\lhave been made in seven days.$"}
text:SevenIsland_IslandVirtuallyUntouched	{'body': 'This island has been left virtually\\nuntouched in its natural state.\\pIt could be a little difficult to\\nhike around because of that.$'}
text:SevenIsland_House_Room1_OnlyEnjoymentWatchingBattles	{'body': 'I may not look like much now,\\nbut when I was younger…\\pI flew everywhere, challenging\\nTRAINERS wherever I found them.\\pNow, my only source of enjoyment\\nis reminiscing about the past while\\lwatching battles.$'}
text:SevenIsland_House_Room1_SlightBreezeAroundBox	{'body': 'There is a slight breeze blowing\\naround the box.$'}
text:SevenIsland_House_Room1_ChallengeVisitingTrainer	{'body': "Ah!\\nWelcome, my friend!\\pLet me tell you something. There's\\na hidden room in the basement.\\pA TRAINER named {STR_VAR_1} is\\nwaiting there now.\\pTell me, you did come to challenge\\n{STR_VAR_1}, am I right?$"}
text:SevenIsland_House_Room1_OhYouWontBattle	{'body': "Oh…\\nYou won't battle…\\pI see, I see.\\n… …\\pWell, perhaps if you change your\\nmind, do come back.$"}
text:SevenIsland_House_Room1_LimitThreeMonsPerSide	{'body': 'Ah!\\nYou will battle for me?\\pIt was worth my time moving the\\nbox aside, then.\\p… …\\nBut there is one slight problem.\\pThis hidden room is not built very\\nsturdy.\\pCan I get you to limit it to\\nbattles of three POKéMON per side?$'}
text:SevenIsland_House_Room1_SaveProgressBeforeBattle	{'body': 'Fine! Before your battle, would\\nyou like to save your game?$'}
text:SevenIsland_House_Room1_DontHoldAnythingBack	{'body': "All right.\\nDon't hold anything back!$"}
text:SevenIsland_House_Room1_StrVar1_1	{'body': '{STR_VAR_1}$'}
text:SevenIsland_House_Room2_MatchEndedUpDraw	{'body': 'The match ended up a draw.$'}
text:SevenIsland_House_Room1_DrawWasIt	{'body': "A draw, was it?\\pHowever, let me say that it was\\na worthy spectacle.\\pI'd say it was a wonderful battle\\nwith a real sense of depth!$"}
text:SevenIsland_House_Room1_StrVar1_2	{'body': '{STR_VAR_1}$'}
text:SevenIsland_House_Room1_AstoundingBattle	{'body': 'Bravo!\\pBravo, indeed!\\nWhat an astounding battle!\\pIt was so astounding, why, it keeps\\nfilling my eyes with tears!\\pThe thrust and parry of expertly\\nused techniques!\\pThe clash of power upon power!\\pYes!\\nIt was sheer magnificence!$'}
text:SevenIsland_House_Room1_StrVar1_3	{'body': '{STR_VAR_1}$'}
text:SevenIsland_House_Room1_FeelYourDisappointment	{'body': 'Too bad!\\nI feel your disappointment.\\pHowever, that disappointment is\\nwhat will make you better.\\pUse it, learn from it, and make it\\nmotivate you to seek greatness.\\pForget not this disappointment\\nand redouble your training!$'}
text:SevenIsland_Mart_MonHavePersonalitiesOfTheirOwn	{'body': 'POKéMON have personalities of their\\nown, just like people.\\pMy PIKACHU has a HASTY nature,\\nso it grew to be a speedy POKéMON.$'}
text:SevenIsland_Mart_PreparationsCompleteForRuins	{'body': 'Okay, preparations are complete\\nfor me to explore the RUINS.$'}
text:SevenIsland_Mart_NeedToFishOnSevenIsland	{'body': "I need to fish on SEVEN ISLAND.\\pThat will complete my fishing tour\\nof the SEVII ISLANDS.\\pI'd better stock up on some\\nPOKé BALLS first, though.$"}
text:SevenIsland_PokemonCenter_1F_EventsDependingOnConnections	{'body': 'On this island, different events\\noccur depending on connections.\\pWhat are those connections?\\pThey are for you to discover on\\nyour own.$'}
text:SevenIsland_PokemonCenter_1F_DidYouRideSeagallopHere	{'body': "Did you ride a SEAGALLOP ferry\\nto get here?\\pThere are at least ten of those\\nhigh-speed ships.\\pI don't know where they all go,\\nthough.$"}
text:SevenIsland_PokemonCenter_1F_CheckOutTrainerTower	{'body': "If you're confident, you should\\ncheck out TRAINER TOWER.$"}
text:SevenIsland_SevaultCanyon_Entrance_MiahIntro	{'body': "Kyahaha!\\nI'll flick you away effortlessly!$"}
text:SevenIsland_SevaultCanyon_Entrance_MiahDefeat	{'body': 'Tch!\\nToo strong for me!$'}
text:SevenIsland_SevaultCanyon_Entrance_MiahPostBattle	{'body': "What's that?\\nI don't act the way I look?\\pHeh, that's a part of my strategy!$"}
text:SevenIsland_SevaultCanyon_Entrance_MasonIntro	{'body': 'Howdy!\\nAre you a member of my fan club?$'}
text:SevenIsland_SevaultCanyon_Entrance_MasonDefeat	{'body': "Oh, so you're not a fan…\\pWell, I can change that.\\nLet me sing for you!$"}
text:SevenIsland_SevaultCanyon_Entrance_MasonPostBattle	{'body': 'Lalalah…\\nMy POKéMON, I send them out,\\lall the girls scream and shout!$'}
text:SevenIsland_SevaultCanyon_Entrance_NicolasIntro	{'body': "This island is too spread out…\\nIt's not easy patrolling the place.$"}
text:SevenIsland_SevaultCanyon_Entrance_NicolasDefeat	{'body': 'Uh-huh…$'}
text:SevenIsland_SevaultCanyon_Entrance_NicolasPostBattle	{'body': "TRAINERS like you from cities,\\nthey sure are tough.\\pYou'll be headed for the TOWER,\\nwon't you?$"}
text:SevenIsland_SevaultCanyon_Entrance_MadelineIntro	{'body': 'I punish people who abuse\\nPOKéMON!$'}
text:SevenIsland_SevaultCanyon_Entrance_MadelineDefeat	{'body': "You don't seem to be a problem\\nTRAINER.$"}
text:SevenIsland_SevaultCanyon_Entrance_MadelinePostBattle	{'body': "If you treat your POKéMON with\\nkindness, they'll understand.$"}
text:SevenIsland_SevaultCanyon_Entrance_EveIntro	{'body': "EVE: I'll team up with JON and\\nbattle together.$"}
text:SevenIsland_SevaultCanyon_Entrance_EveDefeat	{'body': 'EVE: Me and JON, we lost.\\nEhehe.$'}
text:SevenIsland_SevaultCanyon_Entrance_EvePostBattle	{'body': "EVE: I'm going to work harder with\\nJON.$"}
text:SevenIsland_SevaultCanyon_Entrance_EveNotEnoughMons	{'body': 'EVE: I want to team up with JON\\nwhen I battle you.\\pCome back with two POKéMON, okay?$'}
text:SevenIsland_SevaultCanyon_Entrance_JonIntro	{'body': "JON: When I'm with EVE, it feels\\nlike we could never lose.$"}
text:SevenIsland_SevaultCanyon_Entrance_JonDefeat	{'body': "JON: When I'm with EVE,\\nit doesn't feel like I've lost!$"}
text:SevenIsland_SevaultCanyon_Entrance_JonPostBattle	{'body': "JON: When I'm with EVE, I feel\\ngiddy whether I win or lose.\\pIt's magical!$"}
text:SevenIsland_SevaultCanyon_Entrance_JonNotEnoughMons	{'body': "JON: If it's with EVE, I'll be\\nhappy to battle with you.\\pSo, I'd like to make it a\\ntwo-on-two battle, if I may.$"}
text:SevenIsland_SevaultCanyon_Entrance_RouteSign	{'body': 'SEVAULT CANYON ENTRANCE\\pTRAINERS are asked to refrain from\\ndamaging plants in the CANYON.$'}
text:SevenIsland_SevaultCanyon_CyndyIntro	{'body': "My conditioning's in top form!$"}
text:SevenIsland_SevaultCanyon_CyndyDefeat	{'body': "Huh?\\nSomething's not right…$"}
text:SevenIsland_SevaultCanyon_CyndyPostBattle	{'body': 'The way I am now, I may have to\\nhold off on TRAINER TOWER…$'}
text:SevenIsland_SevaultCanyon_EvanIntro	{'body': "It doesn't matter if you happen to\\nhave the strongest POKéMON…\\pIt doesn't mean a thing if you don't\\nknow how to use them properly!$"}
text:SevenIsland_SevaultCanyon_EvanDefeat	{'body': "You're a master at this.$"}
text:SevenIsland_SevaultCanyon_EvanPostBattle	{'body': 'You see them every so often,\\nTRAINERS with awesome POKéMON\\lwho have no idea what to do.\\pBefore training POKéMON, TRAINERS\\nthemselves need to grow up.$'}
text:SevenIsland_SevaultCanyon_JacksonIntro	{'body': 'I work to protect the environment.\\nIn turn, nature protects me!$'}
text:SevenIsland_SevaultCanyon_JacksonDefeat	{'body': "Whoa! You're tough!\\nHow about protecting me?$"}
text:SevenIsland_SevaultCanyon_JacksonPostBattle	{'body': 'From far out among the stars, our\\nplanet is just a drop of water.\\pBut we want to protect that drop\\nof water for everyone.$'}
text:SevenIsland_SevaultCanyon_KatelynIntro	{'body': 'Those shoes you have are pretty\\nsnazzy.$'}
text:SevenIsland_SevaultCanyon_KatelynDefeat	{'body': "You're hot stuff in spite of your\\ncute looks.$"}
text:SevenIsland_SevaultCanyon_KatelynPostBattle	{'body': 'Your mom bought those snazzy\\nRUNNING SHOES for you?\\pShe must adore you.$'}
text:SevenIsland_SevaultCanyon_LeroyIntro	{'body': 'You look strong.\\nLet me battle you, please!$'}
text:SevenIsland_SevaultCanyon_LeroyDefeat	{'body': "I knew it!\\nYou're as tough as I thought!$"}
text:SevenIsland_SevaultCanyon_LeroyPostBattle	{'body': 'The way you battle has given me\\na lot of useful data.\\pThanks so much!$'}
text:SevenIsland_SevaultCanyon_MichelleIntro	{'body': "I was given the best possible\\neducation to become this strong.\\pI don't want to lose to anyone!$"}
text:SevenIsland_SevaultCanyon_MichelleDefeat	{'body': "Thank you. I feel like I've been\\nset free by losing to you.$"}
text:SevenIsland_SevaultCanyon_MichellePostBattle	{'body': "For some reason, I get furious\\nover the slightest thing.\\pI'll calm myself by breathing\\ndeeply.$"}
text:SevenIsland_SevaultCanyon_LexIntro	{'body': 'LEX: My darling NYA, together\\nwe could win!$'}
text:SevenIsland_SevaultCanyon_LexDefeat	{'body': 'LEX: I seem to have been too\\ncareless…$'}
text:SevenIsland_SevaultCanyon_LexPostBattle	{'body': 'LEX: I think it was a good\\nexperience for NYA.\\pYou have my gratitude.$'}
text:SevenIsland_SevaultCanyon_LexNotEnoughMons	{'body': 'LEX: May I ask you to battle the\\nboth of us at the same time?$'}
text:SevenIsland_SevaultCanyon_NyaIntro	{'body': "NYA: I'll do my best so I won't\\ndrag down my mentor, LEX!$"}
text:SevenIsland_SevaultCanyon_NyaDefeat	{'body': "NYA: Oh, no…\\nI'm so sorry, I…$"}
text:SevenIsland_SevaultCanyon_NyaPostBattle	{'body': "NYA: I think I'm going to need\\nmuch more seasoning and tutoring\\lunder LEX…\\p…So, LEX, please, may I stay with\\nyou like this?$"}
text:SevenIsland_SevaultCanyon_NyaNotEnoughMons	{'body': "NYA: I'm sorry, but may we battle\\nin two-on-two style?$"}
text:SevenIsland_SevaultCanyon_RouteSign	{'body': 'SEVAULT CANYON\\nTANOBY RUINS AHEAD$'}
text:SevenIsland_SevaultCanyon_BrunoTrainedWithBrawly	{'body': "Training by oneself is certainly\\nnot a bad thing.\\pBut it's also not bad to aim for\\nthe top with a partner.\\pEven BRUNO…\\nHe trained with a fellow by the\\lname of BRAWLY before.$"}
text:SevenIsland_SevaultCanyon_House_ChanseyDanceJoinIn	{'body': 'Dance, dance!\\nCHANSEY Dance!\\pYou join in, too!\\nDance, dance!$'}
text:SevenIsland_SevaultCanyon_House_WouldYouLikeToDance	{'body': 'Would you like to dance?$'}
text:SevenIsland_SevaultCanyon_House_ComeOnDance	{'body': 'Come on, dance!$'}
text:SevenIsland_SevaultCanyon_House_DancedChanseyDance	{'body': '{PLAYER} danced the CHANSEY Dance!$'}
text:SevenIsland_SevaultCanyon_House_YoureAllChipperNow	{'body': "Ahahahaha!\\pThere, you're all chipper now!\\nLucky!$"}
text:SevenIsland_SevaultCanyon_House_Chansey	{'body': 'CHANSEY: Chansi! Chansi!$'}
text:SevenIsland_SevaultCanyon_TanobyKey_MysteriousRumbleFarAway	{'body': 'A mysterious rumble echoed\\nsomewhere far away.$'}
text:SevenIsland_TanobyRuins_BrandonIntro	{'body': 'Do you know anything about this\\nstone chamber?$'}
text:SevenIsland_TanobyRuins_BrandonDefeat	{'body': "That was uncalled for.\\nYou didn't have to be so rough.$"}
text:SevenIsland_TanobyRuins_BrandonPostBattle	{'body': "The TANOBY RUINS date back at\\nleast 1,500 years.\\pBut it's a baffling mystery as to\\nwhy it was built in the first place.$"}
text:SevenIsland_TanobyRuins_BenjaminIntro	{'body': 'A mystic POKéMON is said to sleep\\ninside here.$'}
text:SevenIsland_TanobyRuins_BenjaminDefeat	{'body': "I'm not much good in battle.$"}
text:SevenIsland_TanobyRuins_BenjaminPostBattle	{'body': 'I hear there are other ruins like\\nthe one here.\\pMight they be the resting places\\nof other mystic POKéMON?$'}
text:SevenIsland_TanobyRuins_EdnaIntro	{'body': 'CLIFFORD is teaching me how to\\npaint.$'}
text:SevenIsland_TanobyRuins_EdnaDefeat	{'body': 'We might get in trouble for being\\nnoisy here.$'}
text:SevenIsland_TanobyRuins_EdnaPostBattle	{'body': 'I said that I wanted to paint an\\nold building.\\pSo CLIFFORD brought me here.$'}
text:SevenIsland_TanobyRuins_CliffordIntro	{'body': 'Today, in addition to our lesson,\\nwe came to see the chamber.$'}
text:SevenIsland_TanobyRuins_CliffordDefeat	{'body': 'My, how extraordinary.$'}
text:SevenIsland_TanobyRuins_CliffordPostBattle	{'body': 'Ah, so you are studying POKéMON\\non your own…\\pYes, you certainly are quite the\\nextraordinary person, indeed.$'}
text:SevenIsland_TrainerTower_DarioIntro	{'body': 'I sensed your approach.$'}
text:SevenIsland_TrainerTower_DarioDefeat	{'body': 'Give up…$'}
text:SevenIsland_TrainerTower_DarioPostBattle	{'body': 'In your future, I sense that you\\nwill meet many others.\\pI think you will be linked to each\\nother by a strange power.$'}
text:SevenIsland_TrainerTower_RodetteIntro	{'body': 'Somewhere on this island, peculiar\\nPOKéMON are sleeping.$'}
text:SevenIsland_TrainerTower_RodetteDefeat	{'body': 'What an amazing TRAINER!$'}
text:SevenIsland_TrainerTower_RodettePostBattle	{'body': "Somewhere on this island, peculiar\\nPOKéMON are sleeping.\\pCould it be that they're waiting\\nfor you?$"}
text:SevenIsland_TrainerTower_TrainerTowerSign	{'body': 'TRAINER TOWER ENTRANCE\\nRise to the Challenge, TRAINERS!$'}
text:SevenIsland_TrainerTower_TrainerTowerAhead	{'body': 'TRAINER TOWER AHEAD$'}
text:ShoalCave_RegionalEvolutions	{'body': 'Level DEWOTT anywhere in SHOAL CAVE at\\nLv. 36 or higher for Hisuian SAMUROTT.\\pLevel BERGMITE in the low-tide ice room\\nat Lv. 37 or higher for Hisuian AVALUGG.\\pElsewhere they take their usual forms.\\nGalarian MR. MIME also lives in that\\lice room. It becomes MR. RIME at Lv. 42.$'}
text:ShoalCave_LowTideIceRoom.ArticunoDormant	{'body': 'ARTICUNO rests in the frozen\\nchamber. Return with the FEATHER\\lBADGE to challenge it.$'}
text:ShoalCave_LowTideIceRoom.ArticunoNeedsPartner	{'body': 'ARTICUNO accepts challengers with\\nthe FEATHER BADGE. No partner\\lspecies is required.$'}
text:ShoalCave_LowTideIceRoom.ArticunoAwakens	{'body': 'ARTICUNO spreads its icy wings!\\nIt accepts your challenge!$'}
text:ShoalCave_LowTideLowerRoom.CanOvercomeColdWithFocus	{'body': 'Your focus overcame the cold!\\pTake this Deep Sea Scale.$'}
text:ShoalCave_LowTideLowerRoom.EverythingStartsWithFocus	{'body': 'Everything starts with focus!$'}
text:SilphCo_10F_GruntIntro	{'body': 'Welcome to 10F!\\nSo good of you to join me!$'}
text:SilphCo_10F_GruntDefeat	{'body': "I'm stunned!$"}
text:SilphCo_10F_GruntPostBattle	{'body': 'Nice try, but the boardroom is up\\none more floor.$'}
text:SilphCo_10F_TravisIntro	{'body': 'Enough of your silly games!$'}
text:SilphCo_10F_TravisDefeat	{'body': 'No continues left!$'}
text:SilphCo_10F_TravisPostBattle	{'body': 'Are you satisfied with beating me?\\nThen go on home!$'}
text:SilphCo_10F_WaaaImScared	{'body': "Waaaaa!\\nI'm scared!$"}
text:SilphCo_10F_KeepMeCryingASecret	{'body': 'About me crying…\\nPlease keep it a secret.$'}
text:SilphCo_10F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n10F$'}
text:SilphCo_11F_ThanksForSavingMeDearBoy	{'body': 'PRESIDENT: Oh, dear boy!\\nThank you for saving SILPH.\\pI will never forget you saved us in\\nour moment of peril.\\pI have to thank you in some way.\\pBecause I am rich, I can give you\\nanything.\\pHere, maybe this will do.$'}
text:SilphCo_11F_ThanksForSavingMeDearGirl	{'body': 'PRESIDENT: Oh, dear girl!\\nThank you for saving SILPH.\\pI will never forget you saved us in\\nour moment of peril.\\pI have to thank you in some way.\\pBecause I am rich, I can give you\\nanything.\\pHere, maybe this will do.$'}
text:SilphCo_11F_ObtainedMasterBallFromPresident	{'body': '{PLAYER} obtained a MASTER BALL\\nfrom the PRESIDENT!$'}
text:SilphCo_11F_ThatsOurSecretPrototype	{'body': "PRESIDENT: You can't buy that\\nanywhere.\\pIt's our secret prototype MASTER\\nBALL.\\pIt will catch any POKéMON without\\nfail!\\pYou should be quiet about using it,\\nthough.$"}
text:SilphCo_11F_YouHaveNoRoomForThis	{'body': 'You have no room for this.$'}
text:SilphCo_11F_ThanksForRescuingUs	{'body': 'SECRETARY: Thank you for rescuing\\nall of us.\\pWe, from the PRESIDENT down,\\nare indebted to you.$'}
text:SilphCo_11F_GiovanniIntro	{'body': 'Ah, {PLAYER}!\\nSo we meet again!\\pThe PRESIDENT and I are discussing\\na vital business proposition.\\pKeep your nose out of grown-up\\nmatters…\\pOr, experience a world of pain!$'}
text:SilphCo_11F_GiovanniDefeat	{'body': 'Arrgh!!\\nI lost again!?$'}
text:SilphCo_11F_GiovanniPostBattle	{'body': 'Blast it all!\\nYou ruined our plans for SILPH!\\pBut, TEAM ROCKET will never fall!\\p{PLAYER}! Never forget that all\\nPOKéMON exist for TEAM ROCKET!\\pI must go, but I shall return!$'}
text:SilphCo_11F_Grunt2Intro	{'body': "Stop right there!\\nDon't you move!$"}
text:SilphCo_11F_Grunt2Defeat	{'body': "Don't…\\nPlease!$"}
text:SilphCo_11F_Grunt2PostBattle	{'body': 'So, you want to see my BOSS?$'}
text:SilphCo_11F_Grunt1Intro	{'body': 'Halt! Do you have an appointment\\nwith my BOSS?$'}
text:SilphCo_11F_Grunt1Defeat	{'body': 'Gaah!\\nDemolished!$'}
text:SilphCo_11F_Grunt1PostBattle	{'body': 'Watch your step…\\nMy BOSS likes his POKéMON tough!$'}
text:SilphCo_11F_MonitorHasMonsOnIt	{'body': 'The monitor has POKéMON on it!$'}
text:SilphCo_11F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n11F$'}
text:SilphCo_1F_WelcomePresidentInBoardroom	{'body': 'Welcome.\\pThe PRESIDENT is in the boardroom\\non 11F.$'}
text:SilphCo_1F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n1F$'}
text:SilphCo_2F_ConnorIntro	{'body': "Help!\\nI'm a SILPH employee.$"}
text:SilphCo_2F_ConnorDefeat	{'body': 'How did you know\\nI was a ROCKET?$'}
text:SilphCo_2F_ConnorPostBattle	{'body': 'I work for both SILPH and TEAM\\nROCKET.$'}
text:SilphCo_2F_JerryIntro	{'body': "It's off-limits here!\\nGo home!$"}
text:SilphCo_2F_JerryDefeat	{'body': "You're good.$"}
text:SilphCo_2F_JerryPostBattle	{'body': "Can you solve the maze in here?\\nIt's not easy, I tell you!$"}
text:SilphCo_2F_Grunt1Intro	{'body': 'No kids are allowed in here!$'}
text:SilphCo_2F_Grunt1Defeat	{'body': 'Tough!$'}
text:SilphCo_2F_Grunt1PostBattle	{'body': "Diamond-shaped tiles are teleport\\nblocks.\\pThey're transporters for this\\nhigh-tech building.$"}
text:SilphCo_2F_Grunt2Intro	{'body': 'Hey, kid!\\nWhat are you wandering here for?$'}
text:SilphCo_2F_Grunt2Defeat	{'body': 'I goofed!$'}
text:SilphCo_2F_Grunt2PostBattle	{'body': 'SILPH CO. will be associated with\\nTEAM ROCKET!$'}
text:ThunderWaveTeach	{'body': "Eeek!\\nNo! Stop! Help!\\pOh, you're not with TEAM ROCKET.\\nI'm sorry, I thought…\\pWill you forgive me if I teach\\nyou the THUNDER WAVE technique?$"}
text:ThunderWaveDeclined	{'body': 'Oh…\\nBut THUNDER WAVE is convenient…$'}
text:ThunderWaveWhichMon	{'body': 'Which POKéMON should I teach\\nTHUNDER WAVE?$'}
text:ThunderWaveTaught	{'body': "THUNDER WAVE causes paralysis in\\nthe target POKéMON.\\pA paralyzed POKéMON may be unable\\nto move in battle.\\pIt's an ELECTRIC-type move, so it\\nwon't work on some POKéMON.$"}
text:SilphCo_2F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n2F$'}
text:SilphCo_3F_WhatAmIToDo	{'body': 'I work for SILPH CO.\\nWhat am I to do?$'}
text:SilphCo_3F_YouAndYourMonsSavedUs	{'body': '{PLAYER}!\\nYou and your POKéMON saved us!$'}
text:SilphCo_3F_GruntIntro	{'body': 'Quit messing with us, kid!$'}
text:SilphCo_3F_GruntDefeat	{'body': 'I give up!$'}
text:SilphCo_3F_GruntPostBattle	{'body': 'A hint? You can open doors with\\na CARD KEY!$'}
text:SilphCo_3F_JoseIntro	{'body': 'I support TEAM ROCKET more than\\nI support SILPH CO.!$'}
text:SilphCo_3F_JoseDefeat	{'body': 'You really got me!$'}
text:SilphCo_3F_JosePostBattle	{'body': "Humph…\\pTEAM ROCKET said that if I helped\\nthem, they'd let me study POKéMON.$"}
text:SilphCo_3F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n3F$'}
text:SilphCo_4F_CantYouSeeImHiding	{'body': "Sssh!\\nCan't you see I'm hiding?$"}
text:SilphCo_4F_TeamRocketIsGone	{'body': 'Huh?\\nTEAM ROCKET is gone?$'}
text:SilphCo_4F_Grunt1Intro	{'body': 'TEAM ROCKET has taken control\\nof SILPH CO.!$'}
text:SilphCo_4F_Grunt1Defeat	{'body': 'Arrgh!$'}
text:SilphCo_4F_Grunt1PostBattle	{'body': 'Fwahahaha!\\nMy BOSS has been after this place!$'}
text:SilphCo_4F_RodneyIntro	{'body': 'My POKéMON is my loyal servant.$'}
text:SilphCo_4F_RodneyDefeat	{'body': 'Darn!\\nYou weak POKéMON!$'}
text:SilphCo_4F_RodneyPostBattle	{'body': 'The doors are electronically\\nlocked.\\pIt takes a CARD KEY to open the\\ndoors here.$'}
text:SilphCo_4F_Grunt2Intro	{'body': 'Intruder spotted!$'}
text:SilphCo_4F_Grunt2Defeat	{'body': 'Who are you?$'}
text:SilphCo_4F_Grunt2PostBattle	{'body': 'I better tell the BOSS on 11F!$'}
text:SilphCo_4F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n4F$'}
text:SilphCo_5F_RocketsInUproarAboutIntruder	{'body': "TEAM ROCKET is in an uproar over\\nsome intruder.\\pThat's you, right?$"}
text:SilphCo_5F_YoureOurHeroThankYou	{'body': "TEAM ROCKET took off!\\nYou're our hero! Thank you!$"}
text:SilphCo_5F_Grunt1Intro	{'body': 'I heard a kid was wandering\\naround.$'}
text:SilphCo_5F_Grunt1Defeat	{'body': 'Boom!$'}
text:SilphCo_5F_Grunt1PostBattle	{'body': "It's not smart to pick a fight with\\nTEAM ROCKET!$"}
text:SilphCo_5F_BeauIntro	{'body': 'We study POKé BALL technology on\\nthis floor.$'}
text:SilphCo_5F_BeauDefeat	{'body': 'Dang!\\nBlast it!$'}
text:SilphCo_5F_BeauPostBattle	{'body': 'We worked on the ultimate POKé\\nBALL which would catch anything.$'}
text:SilphCo_5F_DaltonIntro	{'body': "Whaaat?\\pThere shouldn't be any children\\nhere!$"}
text:SilphCo_5F_DaltonDefeat	{'body': 'Oh, goodness!$'}
text:SilphCo_5F_DaltonPostBattle	{'body': "You're only on 5F.\\nIt's a long way to my BOSS!$"}
text:SilphCo_5F_Grunt2Intro	{'body': 'Show TEAM ROCKET a little respect!$'}
text:SilphCo_5F_Grunt2Defeat	{'body': 'Cough…\\nCough…$'}
text:SilphCo_5F_Grunt2PostBattle	{'body': 'Which reminds me.\\pKOFFING evolves into WEEZING!$'}
text:SilphCo_5F_PorygonFirstVRMon	{'body': "It's a POKéMON REPORT!\\pPOKéMON LAB created PORYGON,\\nthe first virtual-reality POKéMON.$"}
text:SilphCo_5F_Over350TechniquesConfirmed	{'body': "It's a POKéMON REPORT!\\pOver 350 POKéMON techniques have\\nbeen confirmed.$"}
text:SilphCo_5F_SomeMonsEvolveWhenTraded	{'body': "It's a POKéMON REPORT!\\pSome POKéMON have been confirmed\\nto evolve when they are traded.$"}
text:SilphCo_5F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n5F$'}
text:SilphCo_5F_RocketBossLookingForStrongMons	{'body': 'Those thugs that took over our\\nbuilding…\\pTheir BOSS said he was looking for\\nstrong POKéMON.\\pI hope our PRESIDENT managed to\\navoid trouble…$'}
text:SilphCo_6F_RocketsTookOverBuilding	{'body': 'The ROCKETS came and took over\\nthe building!$'}
text:SilphCo_6F_BetterGetBackToWork	{'body': 'Well, better get back to work.$'}
text:SilphCo_6F_HelpMePlease	{'body': 'Oh dear, oh dear.\\nHelp me, please!$'}
text:SilphCo_6F_WeGotEngaged	{'body': 'We got engaged.\\nHeheh!$'}
text:SilphCo_6F_ThatManIsSuchACoward	{'body': "That man next to me…\\nHe's such a coward!$"}
text:SilphCo_6F_NeedsMeToLookAfterHim	{'body': "He's so helpless, he needed\\nsomeone like me to look after him.$"}
text:SilphCo_6F_RocketsTryingToConquerWorld	{'body': 'TEAM ROCKET is trying to conquer\\nthe world with POKéMON.$'}
text:SilphCo_6F_RocketsRanAwayBecauseOfYou	{'body': "TEAM ROCKET ran away, and it's all\\nbecause of you!$"}
text:SilphCo_6F_TargetedSilphForOurMonProducts	{'body': 'They must have targeted SILPH for\\nour POKéMON products.$'}
text:SilphCo_6F_ComeWorkForSilphWhenYoureOlder	{'body': 'Come work for SILPH when you\\nget older.$'}
text:SilphCo_6F_Grunt1Intro	{'body': 'I am one of the four ROCKET\\nBROTHERS!$'}
text:SilphCo_6F_Grunt1Defeat	{'body': 'Flame out!$'}
text:SilphCo_6F_Grunt1PostBattle	{'body': 'No matter!\\nMy brothers will avenge me!$'}
text:SilphCo_6F_TaylorIntro	{'body': "That rotten PRESIDENT!\\pServes him right for shipping me\\noff to the TIKSI BRANCH!\\pThat's why TEAM ROCKET came after\\nus, I'm sure of it!$"}
text:SilphCo_6F_TaylorDefeat	{'body': 'Shoot!$'}
text:SilphCo_6F_TaylorPostBattle	{'body': "TIKSI BRANCH?\\nIt's in Russian no-man's-land!$"}
text:SilphCo_6F_Grunt2Intro	{'body': 'You dare betray TEAM ROCKET?$'}
text:SilphCo_6F_Grunt2Defeat	{'body': 'You traitor!$'}
text:SilphCo_6F_Grunt2PostBattle	{'body': 'If you stand for justice, you\\nbetray us bad guys!$'}
text:SilphCo_6F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n6F$'}
text:SilphCo_7F_HaveMonForSavingUs	{'body': "Oh! Hi! You're not a ROCKET!\\nYou came to save us?\\lWhy, thank you!\\pI want you to have this POKéMON\\nfor saving us.$"}
text:SilphCo_7F_ObtainedLaprasFromEmployee	{'body': '{PLAYER} obtained a LAPRAS from\\nthe SILPH employee!$'}
text:SilphCo_7F_ExplainLapras	{'body': "It's a LAPRAS.\\nIt's a very intelligent POKéMON.\\pWe kept it in our lab, but it will\\nbe much better off with you.\\pI think you will be a good TRAINER\\nfor LAPRAS!\\pIt's a good swimmer.\\nIt'll give you a lift across water!$"}
text:SilphCo_7F_RocketBossWentToBoardroom	{'body': "TEAM ROCKET's BOSS went to the\\nboardroom!\\pIs our PRESIDENT okay?\\nI'm worried.$"}
text:SilphCo_7F_RocketsAfterMasterBall	{'body': 'TEAM ROCKET was after the MASTER\\nBALL, which catches any POKéMON.$'}
text:SilphCo_7F_CanceledMasterBallProject	{'body': 'We canceled the MASTER BALL\\nproject because of TEAM ROCKET.$'}
text:SilphCo_7F_BadIfTeamRocketTookOver	{'body': 'It would be bad if TEAM ROCKET\\ntook over SILPH or our POKéMON.$'}
text:SilphCo_7F_WowYouChasedOffTeamRocket	{'body': 'Wow!\\pYou chased off TEAM ROCKET all by\\nyourself?$'}
text:SilphCo_7F_ReallyDangerousHere	{'body': "You!\\nIt's really dangerous here!\\pYou came to save me?\\nYou can't!$"}
text:SilphCo_7F_ThankYouSoMuch	{'body': 'Thank you so much!$'}
text:SilphCo_7F_Grunt3Intro	{'body': 'Uh-oh!\\nI smell a little mouse!$'}
text:SilphCo_7F_Grunt3Defeat	{'body': 'Lights out!$'}
text:SilphCo_7F_Grunt3PostBattle	{'body': "You won't find my BOSS by just\\nscurrying around!$"}
text:SilphCo_7F_JoshuaIntro	{'body': 'Heheh!\\pYou mistook me for a SILPH worker?$'}
text:SilphCo_7F_JoshuaDefeat	{'body': "I'm done!$"}
text:SilphCo_7F_JoshuaPostBattle	{'body': 'Despite your age, you are a\\nskilled TRAINER!$'}
text:SilphCo_7F_Grunt1Intro	{'body': 'I am one of the four ROCKET\\nBROTHERS!$'}
text:SilphCo_7F_Grunt1Defeat	{'body': 'Aack!\\nBrothers, I lost!$'}
text:SilphCo_7F_Grunt1PostBattle	{'body': "Doesn't matter.\\nMy brothers will repay the favor!$"}
text:SilphCo_7F_Grunt2Intro	{'body': 'A child intruder?\\nThat must be you!$'}
text:SilphCo_7F_Grunt2Defeat	{'body': 'Fine!\\nI lost!$'}
text:SilphCo_7F_Grunt2PostBattle	{'body': 'Go on home before my BOSS gets\\nticked off!$'}
text:SilphCo_7F_RivalWhatKeptYou	{'body': '{RIVAL}: What kept you, {PLAYER}?$'}
text:SilphCo_7F_RivalIntro	{'body': "{RIVAL}: Hahaha! I thought you'd\\nturn up if I waited here!\\pI guess TEAM ROCKET slowed you\\ndown! Not that I care!\\pI saw you in SAFFRON, so I decided\\nto see if you got better!$"}
text:SilphCo_7F_RivalDefeat	{'body': 'Oh, man!\\nSo, you are ready for BOSS\\lROCKET!$'}
text:SilphCo_7F_RivalPostBattle	{'body': "Well, {PLAYER}!\\nI'm moving on up and ahead!\\pBy checking my POKéDEX, I'm\\nstarting to see what's strong and\\lhow they evolve!\\pAm I a genius or what?\\pI'm going to the POKéMON LEAGUE to\\nboot out the ELITE FOUR.\\pI'll become the world's most\\npowerful TRAINER!\\p{PLAYER}, well, good luck to you!\\nDon't sweat it!\\lSmell ya!$"}
text:SilphCo_7F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n7F$'}
text:SilphCo_8F_WonderIfSilphIsFinished	{'body': 'I wonder if SILPH is finished…$'}
text:SilphCo_8F_ThanksForSavingUs	{'body': 'Thanks for saving us!$'}
text:SilphCo_8F_Grunt1Intro	{'body': "That's as far as you'll go!$"}
text:SilphCo_8F_Grunt1Defeat	{'body': 'Not enough grit!$'}
text:SilphCo_8F_Grunt1PostBattle	{'body': "If you don't turn back…\\nI'll call for backup!$"}
text:SilphCo_8F_ParkerIntro	{'body': "You're causing us problems!$"}
text:SilphCo_8F_ParkerDefeat	{'body': 'Huh?\\nI lost?$'}
text:SilphCo_8F_ParkerPostBattle	{'body': "So, what do you think of SILPH\\nBUILDING's maze?$"}
text:SilphCo_8F_Grunt2Intro	{'body': 'I am one of the four ROCKET\\nBROTHERS!$'}
text:SilphCo_8F_Grunt2Defeat	{'body': 'Whoo!\\nOh, Brothers!$'}
text:SilphCo_8F_Grunt2PostBattle	{'body': "I'll leave you up to my brothers.$"}
text:SilphCo_8F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n8F$'}
text:SilphCo_8F_ToRocketBossMonsAreTools	{'body': "TEAM ROCKET's BOSS is terribly\\ncruel!\\pTo him, POKéMON are just tools to\\nbe used.\\pWhat will happen if that tyrant\\ntakes over our company…$"}
text:SilphCo_9F_YouShouldTakeQuickNap	{'body': 'You look tired.\\nYou should take a quick nap.$'}
text:SilphCo_9F_DontGiveUp	{'body': "Don't give up!$"}
text:SilphCo_9F_ThankYouSoMuch	{'body': 'Thank you so much.$'}
text:SilphCo_9F_Grunt1Intro	{'body': 'Your POKéMON seem to adore you,\\nkid!$'}
text:SilphCo_9F_Grunt1Defeat	{'body': 'Ghaaah!$'}
text:SilphCo_9F_Grunt1PostBattle	{'body': 'If I had started as a TRAINER at\\nyour age…$'}
text:SilphCo_9F_EdIntro	{'body': 'Your POKéMON have weak points!\\nI can nail them!$'}
text:SilphCo_9F_EdDefeat	{'body': 'You hammered me!$'}
text:SilphCo_9F_EdPostBattle	{'body': 'Exploiting weak spots does work.\\nThink about type advantages.$'}
text:SilphCo_9F_Grunt2Intro	{'body': 'I am one of the four ROCKET\\nBROTHERS!$'}
text:SilphCo_9F_Grunt2Defeat	{'body': 'Warg!\\nBrothers, I lost!$'}
text:SilphCo_9F_Grunt2PostBattle	{'body': 'My brothers will avenge me!$'}
text:SilphCo_9F_FloorSign	{'body': 'SILPH CO. HEAD OFFICE\\n9F$'}
text:SixIsland_DottedHole_SapphireRoom_FoundSapphire	{'body': '{PLAYER} found a SAPPHIRE!$'}
text:SixIsland_DottedHole_SapphireRoom_IWasRightInTailingYou	{'body': 'Fufu… Fufufufu…\\nI guessed right.\\pI was right in tailing you!$'}
text:SixIsland_DottedHole_SapphireRoom_SellToTeamRocketTellPassword	{'body': "I knew that there was a SAPPHIRE\\nhere, so it belongs to me!\\pI'll sell it to TEAM ROCKET for\\nserious money.\\p…D-don't glare at me like that!\\pIf you want it back, why don't you\\ngo get it after I sell it?\\pI'll even tell you one of the\\npasswords to TEAM ROCKET's\\lWAREHOUSE.\\pThe WAREHOUSE password I know is\\n“Yes, nah, CHANSEY.”\\pI'm done.\\nDon't think badly of me!$"}
text:SixIsland_IslandSign	{'body': 'SIX ISLAND\\nFortune Island of Aged Wisdom$'}
text:SixIsland_ThatWayToWaterPathRuinValley	{'body': "Keep going this way and you'll get\\nto the WATER PATH.\\pStay on that and you'll get to\\nthe RUIN VALLEY.$"}
text:SixIsland_SkyAtNightIsFantastic	{'body': "When you're this far away from the\\ncity, the sky at night is fantastic.$"}
text:SixIsland_GreenPath_JaclynIntro	{'body': '…Huh?\\pI was envisioning my house, but\\nthis is where I TELEPORT?$'}
text:SixIsland_GreenPath_JaclynDefeat	{'body': 'Big boo-boo!$'}
text:SixIsland_GreenPath_JaclynPostBattle	{'body': 'I am so scatterbrained!\\pI need to focus so I can TELEPORT\\nproperly to my house!$'}
text:SixIsland_GreenPath_LeftRouteSign	{'body': 'GREEN PATH\\nPATTERN BUSH AHEAD$'}
text:SixIsland_GreenPath_RightRouteSign	{'body': 'GREEN PATH\\nThink Green, Keep Nature Clean!$'}
text:SixIsland_House_GoodPlaceForNatureAndHistory	{'body': "There's nothing that young people'd\\nfind exciting here on this island.\\pBut, this is a good place in terms\\nof nature and history.\\pRelax and enjoy your stay.$"}
text:SixIsland_Mart_AgathaOldestEverEliteFourMember	{'body': 'Play with POKéMON lots and live\\na long life!\\pTake AGATHA, for example.\\pShe set a record for being the\\noldest-ever ELITE FOUR member.\\pShe spurs me to do bigger things.$'}
text:SixIsland_Mart_ShouldBuyMailAndWriteLetter	{'body': 'I should buy some MAIL and write\\nhim a letter…$'}
text:SixIsland_OutcastIsland_RocketIntro	{'body': "There're no rare POKéMON around\\nthese parts! Not a one!\\pThat burns me up, man.\\nI'll take it out on you!$"}
text:SixIsland_OutcastIsland_RocketDefeat	{'body': '…Huh?$'}
text:SixIsland_OutcastIsland_RocketPostBattle	{'body': "So listen, you haven't seen any\\nrare POKéMON, have you?$"}
text:SixIsland_OutcastIsland_TylorIntro	{'body': "I'm having no luck at all.\\nA battle'd be a change of pace!$"}
text:SixIsland_OutcastIsland_TylorDefeat	{'body': 'Nope, no luck at all…$'}
text:SixIsland_OutcastIsland_TylorPostBattle	{'body': "I can't very well go home without\\ncatching something, though.$"}
text:SixIsland_OutcastIsland_MymoIntro	{'body': 'Gasp… Gasp…\\pI swam here from SIX ISLE PORT\\nin one go.$'}
text:SixIsland_OutcastIsland_MymoDefeat	{'body': 'Gasp…\\nGasp…$'}
text:SixIsland_OutcastIsland_MymoPostBattle	{'body': "I'm only at the halfway point…\\nI'm beat…$"}
text:SixIsland_OutcastIsland_NicoleIntro	{'body': "It's not so easy sending POKéMON\\nout while swimming, you know?$"}
text:SixIsland_OutcastIsland_NicoleDefeat	{'body': "I didn't lose to you at swimming.\\nThis doesn't bother me.$"}
text:SixIsland_OutcastIsland_NicolePostBattle	{'body': "Are you headed for the island up\\npast here?\\pI didn't see anything interesting\\nthere.$"}
text:SixIsland_OutcastIsland_AvaIntro	{'body': "AVA: Let's have a two-on-two\\nmarine battle!$"}
text:SixIsland_OutcastIsland_AvaDefeat	{'body': "AVA: Oh, you're amazing!\\nEven better, you're on your own!$"}
text:SixIsland_OutcastIsland_AvaPostBattle	{'body': 'AVA: You know, I do prefer the\\nsea over any pool.$'}
text:SixIsland_OutcastIsland_AvaNotEnoughMons	{'body': "AVA: You're challenging us to\\na battle?\\pYou'll need at least two POKéMON\\nif you want to do that.$"}
text:SixIsland_OutcastIsland_GebIntro	{'body': 'GEB: Big Sister, help!\\nPlease battle with me!$'}
text:SixIsland_OutcastIsland_GebDefeat	{'body': "GEB: Wow, Big Sister, this person's\\nreally good!$"}
text:SixIsland_OutcastIsland_GebPostBattle	{'body': "GEB: I'm hanging onto my sister\\nbecause I can't touch the bottom.$"}
text:SixIsland_OutcastIsland_GebNotEnoughMons	{'body': "GEB: Please battle against me and\\nmy sister!\\p…Oh, you don't have two POKéMON?$"}
text:SixIsland_PatternBush_BethanyIntro	{'body': "I'm curious, how do you raise your\\nPOKéMON?$"}
text:SixIsland_PatternBush_BethanyDefeat	{'body': 'You raise your POKéMON with a\\nwhole lot of love!$'}
text:SixIsland_PatternBush_BethanyPostBattle	{'body': 'In the same way your mother raised\\nyou full of love, you should raise\\lyour POKéMON.$'}
text:SixIsland_PatternBush_AllisonIntro	{'body': "I'm working to preserve the natural\\necology of POKéMON here.$"}
text:SixIsland_PatternBush_AllisonDefeat	{'body': 'Oh, for someone so young, you are\\ntremendous!$'}
text:SixIsland_PatternBush_AllisonPostBattle	{'body': "I'm not saying that you shouldn't\\ncatch POKéMON.\\pI just want people to raise their\\nPOKéMON responsibly.$"}
text:SixIsland_PatternBush_GarretIntro	{'body': 'I caught a BUG POKéMON that lives\\nonly around here!$'}
text:SixIsland_PatternBush_GarretDefeat	{'body': "Heheh…\\nIsn't my POKéMON awesome?$"}
text:SixIsland_PatternBush_GarretPostBattle	{'body': "There's a girl near the BUSH who\\nmeasures HERACROSS for TRAINERS.$"}
text:SixIsland_PatternBush_JonahIntro	{'body': "You know, it just doesn't feel right\\nif I don't use BUG POKéMON.$"}
text:SixIsland_PatternBush_JonahDefeat	{'body': "It's okay, losing is a fun part of\\nPOKéMON's appeal, too.$"}
text:SixIsland_PatternBush_JonahPostBattle	{'body': 'By the way, “appeal” is a weird\\nword, if you think about it.\\pLike, is it like an orange peel?\\nOr like a ringing bell?$'}
text:SixIsland_PatternBush_VanceIntro	{'body': 'Yeah, yeah, yeah!\\nLook at all the BUG POKéMON!$'}
text:SixIsland_PatternBush_VanceDefeat	{'body': 'I got beat while I was still busy\\ncelebrating!$'}
text:SixIsland_PatternBush_VancePostBattle	{'body': "I'm going to bring my little brother\\nhere next time.$"}
text:SixIsland_PatternBush_NashIntro	{'body': 'Look, look! There are funny\\npatterns on the ground.$'}
text:SixIsland_PatternBush_NashDefeat	{'body': 'Super awesome!$'}
text:SixIsland_PatternBush_NashPostBattle	{'body': "The funny patterns on the ground…\\pThey look like the patterns on my\\ngrandpa's clothes.$"}
text:SixIsland_PatternBush_CordellIntro	{'body': "I bet you think I'm just some guy,\\ndon't you, eh?$"}
text:SixIsland_PatternBush_CordellDefeat	{'body': "I bet you think I'm weak,\\ndon't you, eh?$"}
text:SixIsland_PatternBush_CordellPostBattle	{'body': 'Ayup, you townies come around all\\nso dandy with a hat that flashy…\\pHow about giving me that?$'}
text:SixIsland_PatternBush_DaliaIntro	{'body': "Take a deep breath.\\nIsn't the air delicious?$"}
text:SixIsland_PatternBush_DaliaDefeat	{'body': "If you'd like, I can teach you how\\nto breathe properly.$"}
text:SixIsland_PatternBush_DaliaPostBattle	{'body': "First, exhale.\\nBlow everything out.\\pWhen you can't exhale anymore,\\ninhale the clean air!\\pIsn't it refreshing?$"}
text:SixIsland_PatternBush_JoanaIntro	{'body': "I love BUG POKéMON.\\nThat's why I'm here all the time.\\pAm I the only girl like that?$"}
text:SixIsland_PatternBush_JoanaDefeat	{'body': "I lost, but I'm still laughing.\\nAm I the only girl like that?$"}
text:SixIsland_PatternBush_JoanaPostBattle	{'body': "I'm going to keep on collecting\\nBUG POKéMON.\\pAm I the only girl like that?$"}
text:SixIsland_PatternBush_RileyIntro	{'body': "This is a good spot.\\nI'll pitch my tent here.$"}
text:SixIsland_PatternBush_RileyDefeat	{'body': 'Wimped out…$'}
text:SixIsland_PatternBush_RileyPostBattle	{'body': "I'm going to observe the night sky\\nhere.$"}
text:SixIsland_PatternBush_MarcyIntro	{'body': 'Oh, yuck!\\nI think a bug stung me!$'}
text:SixIsland_PatternBush_MarcyDefeat	{'body': "It wasn't a bug.\\nI cut my shin on some grass.$"}
text:SixIsland_PatternBush_MarcyPostBattle	{'body': "A little cut like that…\\nA little spit's enough to cure it!$"}
text:SixIsland_PatternBush_LaytonIntro	{'body': 'Have you noticed something odd\\nabout these parts?$'}
text:SixIsland_PatternBush_LaytonDefeat	{'body': 'Have you taken a good look around\\nyour feet?$'}
text:SixIsland_PatternBush_LaytonPostBattle	{'body': "There are places here in PATTERN\\nBUSH where grass won't grow.\\pWhat could be the cause of such\\na phenomenon?$"}
text:SixIsland_PokemonCenter_1F_SomethingHiddenOnThisIsland	{'body': "For ten years, I've searched for\\nRUINS.\\pNo, make that twenty years.\\pI get this feeling that there's\\nsomething hidden on this island.$"}
text:SixIsland_PokemonCenter_1F_SomeMonsEvolveByTradingWithHeldItem	{'body': 'You know of POKéMON that evolve\\nonly upon trading, yes?\\pBut did you know that there are\\nstill others?\\pSome POKéMON evolve only when\\ntraded while holding specific items.$'}
text:SixIsland_PokemonCenter_1F_RivalImpossibleToGetAllMonsAroundHere	{'body': "{RIVAL}: Hey, {PLAYER}!\\nHow's your POKéDEX filling up?\\pIt looks like it's impossible to get\\nall the POKéMON by hanging around\\ljust these parts.\\pMaybe there are POKéMON we don't\\nknow about somewhere far away…\\p… … …  … … …  … … …\\pWell, if I can't do it, there's no\\nway for you to get it done.\\pI'm not going to get all desperate\\nover this.\\pI'll keep collecting POKéMON at my\\nown pace while I train them.\\pThat's what I'll do.\\nSo there's no point staying here.\\lI may as well leave for home.\\pThat's that, then!\\nSmell ya later!$"}
text:SixIsland_RuinValley_CantFigureOutHowToGetInside	{'body': "I can't figure out how I'm supposed\\nto get inside.$"}
text:SixIsland_RuinValley_IFoundThisPlace	{'body': "Let me tell you, I found this\\nplace.\\pDon't look so envious, will you?$"}
text:SixIsland_RuinValley_CheckDoorMoreThoroughly	{'body': "The door doesn't budge at all.\\nCheck it more thoroughly?$"}
text:SixIsland_RuinValley_LeftDoorAlone	{'body': '{PLAYER} left the door alone.$'}
text:SixIsland_RuinValley_SeveralDotsOnTheDoor	{'body': 'On closer inspection, there are\\nseveral dots on the door…$'}
text:SixIsland_RuinValley_DoorIsOpen	{'body': 'The door is open.$'}
text:SixIsland_RuinValley_StanlyIntro	{'body': 'There appear to be many secrets\\nstill unsolved in this world.$'}
text:SixIsland_RuinValley_StanlyDefeat	{'body': 'Hmm…$'}
text:SixIsland_RuinValley_StanlyPostBattle	{'body': 'I suggest to you that you, too,\\ngive a thought to the secrets and\\lmysteries of our world once a day.$'}
text:SixIsland_RuinValley_FosterIntro	{'body': "I'm curious, what compelled you to\\ncome here?$"}
text:SixIsland_RuinValley_FosterDefeat	{'body': "It's been so long since I battled,\\nmy instincts are off.$"}
text:SixIsland_RuinValley_FosterPostBattle	{'body': 'There are several ruins on the\\nSEVII ISLANDS.\\pThe majority of them date back\\na long way.$'}
text:SixIsland_RuinValley_LarryIntro	{'body': "It's been said that there are\\nmysterious stones on this island.\\pI suspect it has something to do\\nwith the ruins here.$"}
text:SixIsland_RuinValley_LarryDefeat	{'body': 'Oh, interesting.$'}
text:SixIsland_RuinValley_LarryPostBattle	{'body': "Those ruins over there…\\pI haven't had any luck in finding\\nhow I can get inside.$"}
text:SixIsland_RuinValley_DarylIntro	{'body': 'A battle with you, so high up!$'}
text:SixIsland_RuinValley_DarylDefeat	{'body': 'Oh, the heartbreak of losing so\\neasily to you!$'}
text:SixIsland_RuinValley_DarylPostBattle	{'body': 'Experience the joy of climbing!$'}
text:SixIsland_RuinValley_HectorIntro	{'body': "I'm pretty familiar with the land\\naround these parts.$"}
text:SixIsland_RuinValley_HectorDefeat	{'body': "You don't need to be so pushy.\\nI'll be happy to tell you.$"}
text:SixIsland_RuinValley_HectorPostBattle	{'body': "The door to the ruins…\\nIt has these strange patterns\\lengraved on the outside.\\pI don't know what they mean,\\nthough.$"}
text:SixIsland_WaterPath_RoseIntro	{'body': 'I let a pleasant breeze lead me\\nall the way here.$'}
text:SixIsland_WaterPath_RoseDefeat	{'body': "Giggle… You're so cute when you're\\ndetermined.$"}
text:SixIsland_WaterPath_RosePostBattle	{'body': 'I want to go to the woods over\\nthere, but…\\pThere are lots of BUG POKéMON.\\nThey scare me a little.$'}
text:SixIsland_WaterPath_EdwardIntro	{'body': "I'm practicing in secret so no one\\ncan see me.$"}
text:SixIsland_WaterPath_EdwardDefeat	{'body': 'Nobody saw me losing, right?$'}
text:SixIsland_WaterPath_EdwardPostBattle	{'body': "As a performer, I don't want people\\nto know about the effort I put in.$"}
text:SixIsland_WaterPath_SamirIntro	{'body': "What, you're suggesting that you're\\nsick of seeing SWIMMERS like me?\\pAww, don't be hatin'!$"}
text:SixIsland_WaterPath_SamirDefeat	{'body': 'Oh, no, no, no.$'}
text:SixIsland_WaterPath_SamirPostBattle	{'body': "I couldn't lift the stigma of being\\na SWIMMER…$"}
text:SixIsland_WaterPath_DeniseIntro	{'body': "My boyfriend's always busy, so I\\ncome swimming by myself.$"}
text:SixIsland_WaterPath_DeniseDefeat	{'body': 'Awww, I knew this would happen!$'}
text:SixIsland_WaterPath_DenisePostBattle	{'body': "When I can't be with my boyfriend,\\nI spend time with the POKéMON he\\lgave me.$"}
text:SixIsland_WaterPath_EarlIntro	{'body': 'Tell me, where are the mountains\\naround these parts?$'}
text:SixIsland_WaterPath_EarlDefeat	{'body': 'I lost my way while I was busy\\nbattling!$'}
text:SixIsland_WaterPath_EarlPostBattle	{'body': "Aren't there any mountains around\\nthese parts?$"}
text:SixIsland_WaterPath_MiuIntro	{'body': "MIU: Hello, POKéMON!\\nIt's time to play!$"}
text:SixIsland_WaterPath_MiuDefeat	{'body': 'MIU: Oh, no!\\nMommy!$'}
text:SixIsland_WaterPath_MiuPostBattle	{'body': 'MIU: It makes me all sad inside\\nwhen we lose…$'}
text:SixIsland_WaterPath_MiuNotEnoughMons	{'body': 'MIU: MIA and I are TWINS.\\nWe want to battle together.$'}
text:SixIsland_WaterPath_MiaIntro	{'body': "MIA: Hello, POKéMON!\\nIt's time to battle!$"}
text:SixIsland_WaterPath_MiaDefeat	{'body': "MIA: You're mean!\\nYou're bad for winning!$"}
text:SixIsland_WaterPath_MiaPostBattle	{'body': "MIA: Ohh…\\nI'm sorry, my POKéMON…$"}
text:SixIsland_WaterPath_MiaNotEnoughMons	{'body': "MIA: Oh, you only have one\\nPOKéMON?\\pDon't you feel lonesome?$"}
text:SixIsland_WaterPath_WantedUltimateHorn	{'body': 'Wanted!\\nThe Ultimate Horn!$'}
text:SixIsland_WaterPath_RouteSign	{'body': 'WATER PATH\\nLeads to RUIN VALLEY$'}
text:SixIsland_WaterPath_House1_LoveItNeedItHeracross	{'body': "Hera, hera, HERACROSS!\\nBig and shiny, it's the bug boss!\\lLove it, need it, HERACROSS!$"}
text:SixIsland_WaterPath_House1_MayIMeasureHeracross	{'body': "Eeeeek!\\nThat's a HERACROSS!\\pPlease, please, may I measure how\\nbig it is?$"}
text:SixIsland_WaterPath_House1_ItsXSizeDeserveReward	{'body': "Eeeek, it's {STR_VAR_2}!\\nI've never seen anything like this!\\lYou deserve a reward!$"}
text:SixIsland_WaterPath_House1_WantToSeeBiggerOne	{'body': 'I want to see a much, much bigger\\nHERACROSS than that one.\\pOh, how I adore them, big\\nHERACROSS!$'}
text:SixIsland_WaterPath_House1_ItsXSizeSameAsBefore	{'body': "Huh? This {STR_VAR_2} measurement…\\nOh, boo! It's the same as before.$"}
text:SixIsland_WaterPath_House1_ItsXSizeYSizeWasBiggest	{'body': "Oh, it's just {STR_VAR_2}.\\nThe HERACROSS before was bigger.\\pIt was {STR_VAR_3}, the biggest\\nHERACROSS you've brought me.$"}
text:SixIsland_WaterPath_House1_ThisWontDo	{'body': "Oh, no! This won't do!\\pHERACROSS looks much more macho\\nand cool, and has a lovely horn!$"}
text:SixIsland_WaterPath_House1_YourBagIsFull	{'body': "Your BAG is full.\\nMy reward won't fit.$"}
text:SixIsland_WaterPath_House1_BiggestHeracrossIsXSize	{'body': 'The biggest HERACROSS that I have\\never seen measured so far is:\\p{STR_VAR_3}!$'}
text:SixIsland_WaterPath_House1_BlankChartOfSomeSort	{'body': "It's a blank chart of some sort.\\pIt has spaces for writing in\\nrecords of some kind.$"}
text:SixIsland_WaterPath_House2_MyNeighborMeasuredMe	{'body': 'My height is 67.0 inches on the\\nbutton.\\pI know it is this precisely because\\nmy neighbor measured me.$'}
text:SkyPillar_Outside.DoorIsClosed	{'body': 'The door is closed.$'}
text:SkyPillar_Outside.OpenedDoorToSkyPillar	{'body': "WALLACE: Oh, my, I'm terribly sorry!\\pIn my haste, I didn't notice that\\nI'd left you behind!\\pI've opened the locked door of\\nthe SKY PILLAR.\\p{PLAYER}{KUN}, let's be on our way!$"}
text:SkyPillar_Outside.EarthquakeNotMomentToWaste	{'body': "WALLACE: It's an earthquake!\\pThere's not a moment to waste!\\nWe've got to hurry!$"}
text:SkyPillar_Outside.SituationGettingWorse	{'body': 'WALLACE: Hmm…\\nThe situation is getting worse…$'}
text:SkyPillar_Outside.GotToGoBackForSootopolis	{'body': 'WALLACE: The tremors reach even\\nhere. We are running out of time!\\pRAYQUAZA should be farther up.\\nPlease reach it while I return to\\lhelp SOOTOPOLIS.\\pEverything is in your hands now,\\n{PLAYER}{KUN}.$'}
text:SkyPillar_Top.RayquazaFlewOff	{'body': 'RAYQUAZA flew toward SOOTOPOLIS!$'}
text:SlateportCity.BattleItemScholar	{'body': 'I once sold POWER items here.\\pThe left-side vendor in every CENTER\\nnow supplies battle items for free.$'}
text:SlateportCity.IncenseScholar	{'body': "You don't need Incense to get\\nbaby POKéMON from compatible\\lparents.\\pSome Incenses have effects in\\nbattle, though. The CENTER\\lvendors can help you find them.$"}
text:SlateportCity.WhoahLineSoLong	{'body': 'Whoa! This line barely moves!\\nI could have paddled home by now.$'}
text:SlateportCity.LookingForBrawly	{'body': "Oh! You came looking for\\nDEWFORD's GYM LEADER?\\pThat's me! BRAWLY.\\nGuess I've kept you waiting.\\pI'll head back to DEWFORD right now.\\nBring two POKéMON. I battle doubles!$"}
text:SlateportCity.CatchingGuruSellWhatYouNeed	{'body': "I'm the CATCHING GURU! I stock\\nspecialized BALLS for every hunt.\\pThe right BALL can turn a rare sighting\\ninto your next teammate!$"}
text:SlateportCity.EvsAlreadyReady	{'body': "A CENTER tutor can prepare\\nyour {STR_VAR_1}'s EV spread.\\pThere is no EV training here; only\\nteam building and battle practice!$"}
text:SlateportCity.WonderIfLighthouseStartlesPokemon	{'body': "The light of the lighthouse reaches\\ndozens of miles away.\\pI wonder if it doesn't startle POKéMON\\nin the sea.$"}
text:SlateportCity.SeaweedFullOfLife	{'body': 'Ooh, look at this!\\pThe seaweed you can get around these\\nparts is fresh and full of life.\\pWhy, it looks like it can even rear up\\nand attack!$'}
text:SlateportCity.HowTownIsBornAndGrows	{'body': 'Where the water is clean, the fruits\\nof bountiful harvest gather.\\pAnd where people gather, a market\\nsoon starts.\\pThat is how a town is born and grows.$'}
text:SlateportCity.SlateportWonderfulPlace	{'body': 'Shopping where you can breathe the\\nscent of the ocean…\\pSLATEPORT is such a wonderful place!$'}
text:SlateportCity.BuyBricksSoDecorWontGetDirty	{'body': "If you put DOLLS or CUSHIONS on\\nthe floor, they'll get dirty.\\pI'm going to buy some BRICKS so my\\nDOLLS and CUSHIONS won't get dirty\\lwhen I leave them out.$"}
text:SlateportCity.GoingToCompeteInBattleTent	{'body': "Wroooar! I'm going to compete in\\nthe BATTLE TENT, too!\\pBut before that, I need to catch\\nsome POKéMON!$"}
text:SlateportCity.BushedHikingFromMauville	{'body': "Whew… I'm just bushed…\\pI hiked over from MAUVILLE CITY.\\nBut, boy, this city's huge.\\pIf I'd known this, I would've ridden\\nmy BIKE here.$"}
text:SlateportCity.EveryoneCallsHimCaptStern	{'body': 'STERN, the fellow who built the\\nMUSEUM, also happens to be the leader\\lof an undersea exploration team.\\pSo, everyone calls him CAPT. STERN.$'}
text:SlateportCity.WhatsLongLineOverThere	{'body': 'What is that over there?\\nThat long line…$'}
text:SlateportCity.VisitedMuseumOften	{'body': 'When I was a child, I visited\\nthe MUSEUM often.\\pI used to dream about the mysteries of\\nthe sea after seeing the exhibits.$'}
text:SlateportCity.QuitPushing	{'body': "Hey, there! Quit pushing!\\nThis is the line, can't you see?$"}
text:SlateportCity.AquaHasPolicy	{'body': 'TEAM AQUA has a policy of\\nassembling and dispersing at\\lthe operation site.$'}
text:SlateportCity.BossIsBrilliant	{'body': 'Our BOSS is brilliant.\\pWhat would he want to do with\\na MUSEUM now?$'}
text:SlateportCity.WhatsNewSchemeIWonder	{'body': "What's the new scheme, I wonder?\\pOur BOSS is scary when he's mad, so\\nI'd better not screw things up…$"}
text:SlateportCity.ShouldTakeItAll	{'body': "If there's something we need in\\nthe MUSEUM, we should take it all!$"}
text:SlateportCity.DontButtIn	{'body': "Hey, you there!\\nDon't butt in!$"}
text:SlateportCity.RemindsMeOfLongLineForGames	{'body': 'A long line, huh?\\pIt reminds me of the times I lined up to\\nbuy smash-hit games…$'}
text:SlateportCity.WhyAreWeLiningUp	{'body': 'Why are we even lining up and paying?\\nWe should just march in!$'}
text:SlateportCity.WhatDoYouWant	{'body': 'What?\\nWhat do you want?$'}
text:SlateportCity.IllReadSignForYou	{'body': "You want to read this sign?\\nI'll read it for you!$"}
text:SlateportCity.SaysSomethingLikeSeaIsEndless	{'body': "Let's see…\\pUm… I think it says something like\\n“the life in the sea is endless.”\\pYup, I'm pretty sure that's what\\nit says.$"}
text:SlateportCity.ShouldveBroughtMyGameBoy	{'body': "Grumble…\\pI should've brought my Game Boy\\nAdvance so I wouldn't get bored in line…\\pGrumble…$"}
text:SlateportCity.HotSpringsAfterOperation	{'body': "When this operation's over, I'll take\\nyou to a hot spring spa!\\pThat's what our leader said.\\nI can't wait!$"}
text:SlateportCity.SeaIsSoWet	{'body': 'The sea is just so vast…\\pCould the sea have been made by\\nthe tears shed by POKéMON?$'}
text:SlateportCity.SinkOldBoats	{'body': 'Do you know what they do with old\\nships that become too creaky to sail?\\pThey sink them in the sea so they\\nbecome habitats for POKéMON.$'}
text:SlateportCity.BuyTooMuch	{'body': 'Whenever I visit here, I get carried\\naway and buy too much.$'}
text:SlateportCity.GetNameRaterToHelpYou	{'body': "If you want to change your POKéMON's\\nnickname, you'll have to get the NAME\\lRATER to help you.$"}
text:SlateportCity.CantChangeTradeMonName	{'body': "Any POKéMON you get in a trade,\\nyou can't change its nickname.\\pThe original TRAINER's love for that\\nPOKéMON is in the nickname.$"}
text:SlateportCity.BattleTentBuiltRecently	{'body': "Recently, a BATTLE TENT was built\\nin SLATEPORT.\\pGYMS are fun, but the BATTLE TENT's\\nawesome in its own way.\\pYou should go find tough POKéMON\\nfor the BATTLE TENT!$"}
text:SlateportCity.CaptSternBeingInterviewed	{'body': "I was hoping that it was a famous star\\nso I could get an autograph.\\pBut who's that being interviewed?\\nIsn't that CAPT. STERN?$"}
text:SlateportCity.InterviewerSoCool	{'body': "That lady interviewer is so cool\\nand pretty.\\pWhen I grow up, I'm going to be\\nan international journalist!$"}
text:SlateportCity.SternSaysDiscoveredSomething	{'body': 'CAPT. STERN says they discovered\\nsomething at the bottom of the sea.\\pI wonder what it is?\\nWhat could it be?$'}
text:SlateportCity.CaptainComeBackWithBigFish	{'body': "What's going on here?\\pDid the good CAPTAIN come back with\\na big fish from the ocean floor?$"}
text:SlateportCity.AmIOnTV	{'body': 'Hey! Are you watching?\\nAm I on TV?$'}
text:SlateportCity.CaptainsACelebrity	{'body': "A TV interview! Here!\\nThe CAPTAIN's a celebrity!$"}
text:SlateportCity.BigSmileForCamera	{'body': 'TY: Okay, CAPT. STERN, a big smile\\nfor the camera!$'}
text:SlateportCity.MostInvaluableExperience	{'body': "GABBY: I see, I see. You've had a most\\ninvaluable experience…$"}
text:SlateportCity.SternMoveAheadWithExploration	{'body': 'CAPT. STERN: Yes, indeed. We intend to\\nmove ahead with our exploration.$'}
text:SlateportCity.GabbyWonderfulThanksForInterview	{'body': "GABBY: That's wonderful, CAPT. STERN!\\nThank you for taking the time from\\lyour busy schedule to talk to us.\\pWe hope we can interview you again\\nwith news of more discoveries!$"}
text:SlateportCity.SternWhewFirstInterview	{'body': 'CAPT. STERN: Whew…\\pThat was my first time to be filmed for\\nTV. That was nerve-wracking.$'}
text:SlateportCity.OhPlayerWeMadeDiscovery	{'body': "Oh! {PLAYER}{KUN}!\\nYou're looking great!\\pWe made a huge discovery on our last\\nseafloor exploration.\\pWe found an underwater cavern on\\nROUTE 128.\\pWe think it's the habitat of a POKéMON\\nthat's said to have been long extinct.$"}
text:SlateportCity.AquaWillAssumeControlOfSubmarine	{'body': 'Fufufu…\\nCAPT. STERN, I presume.\\pWe of TEAM AQUA will assume\\ncontrol of your submarine!\\pYour objections are meaningless!\\nWe expect your total cooperation!\\pFufufu…\\nJust watch and learn what TEAM\\lAQUA has planned!$'}
text:SlateportCity.SternWhatWasAllThat	{'body': 'CAPT. STERN: What was that all about?\\pIt sounded like someone using\\na megaphone…\\pWhere did it come from?$'}
text:SlateportCity.FromHarborTryingToTakeSub	{'body': "It's from the HARBOR!\\pThe submarine!\\nThey're trying to take it!$"}
text:SlateportCity.PleaseComeWithMe	{'body': '{PLAYER}{KUN}!\\nPlease, come with me!$'}
text:SlateportCity.BattleTentSign	{'body': 'BATTLE TENT SLATEPORT SITE\\n“Find it! The ultimate POKéMON!”$'}
text:SlateportCity.SternsShipyardWantedSign	{'body': "STERN'S SHIPYARD\\p“Wanted: A sailor capable of sailing\\nin all currents.”$"}
text:SlateportCity.SternsShipyardNearsCompletion	{'body': "STERN'S SHIPYARD\\p“The ferry S.S. TIDAL nears\\ncompletion for serving the ports of\\lSLATEPORT and LILYCOVE.”$"}
text:SlateportCity.SternsShipyardFerryComplete	{'body': "STERN'S SHIPYARD\\p“Boarding of the SLATEPORT-LILYCOVE\\nferry S.S. TIDAL is handled at the\\lHARBOR.”$"}
text:SlateportCity.PokemonFanClubSign	{'body': 'POKéMON FAN CLUB\\n“Calling all fans of POKéMON!”$'}
text:SlateportCity.OceanicMuseumSign	{'body': '“The endless sea sustains\\nall life.”\\pOCEANIC MUSEUM$'}
text:SlateportCity.CitySign	{'body': 'SLATEPORT CITY\\p“The port where people and POKéMON\\ncross paths.”$'}
text:SlateportCity.MarketSign	{'body': 'SLATEPORT MARKET\\n“Specialty goods and local services!”$'}
text:SlateportCity.HarborFerryUnderConstruction	{'body': 'SLATEPORT HARBOR\\p“The ferry S.S. TIDAL is under\\nconstruction in the SHIPYARD.\\p“Service is scheduled to begin\\nshortly.”$'}
text:SlateportCity.HarborSign	{'body': 'SLATEPORT HARBOR\\p“Enjoy a delightful cruise on\\nthe ferry S.S. TIDAL.”$'}
text:SlateportCity.NameRatersHouseSign	{'body': "NAME RATER'S HOUSE\\n“POKéMON nicknames rated.”$"}
text:SlateportCity.HerbalSupplies	{'body': "Fresh herbs and expedition supplies!\\nCash purchases, ready for the road.\\pPP UPS and PP MAX raise a move's PP.\\nWhen you change a battle set, those\\lupgrades stay with its move slots.$"}
text:SlateportCity.MarketDirectory	{'body': 'SLATEPORT MARKET\\pCapture supplies, herbal medicine,\\nand decorations for your SECRET BASE.\\pVisit the MART for evolution stones\\nand special evolution tools.$'}
text:SlateportCity.YouDroveTeamAquaAway	{'body': "SCOTT: Good to see you again!\\nWe met in PETALBURG.\\pI just saw TEAM AQUA rush out.\\nWas that your team's doing?$"}
text:SlateportCity.MaybeThisTrainer	{'body': 'SCOTT: Handling a surprise like\\nthat takes more than strong moves.\\lYou kept your team together.$'}
text:SlateportCity.LetsRegisterEachOther	{'body': "SCOTT: I'd like to hear how your\\njourney goes. Let's register\\leach other in our POKéNAVS.$"}
text:SlateportCity.RegisteredScott	{'body': 'Registered SCOTT\\nin the POKéNAV.$'}
text:SlateportCity.KeepEyeOnTrainersBeSeeingYou	{'body': "SCOTT: There are promising\\nTRAINERS all over HOENN. I have\\la few more stops to make.\\pKeep trying new plans,\\n{PLAYER}{KUN}. I'll be watching\\lfor your next BADGE!$"}
text:SlateportCity.TakingBattleTentChallenge	{'body': "SCOTT: Oh, hey!\\nIf it isn't {PLAYER}{KUN}!\\p{PLAYER}{KUN}, let me guess--you're going\\nto take the BATTLE TENT challenge?\\pYeah! That's a good idea!\\nThat's a really great idea!\\pAfter all, a tough TRAINER is\\nthe perfect fit for the BATTLE TENT!\\pGive it your best effort!$"}
text:SlateportCity.GretaChallenge	{'body': "I'm GRETA of the BATTLE ARENA.\\pA real match reveals mind, skill,\\nand body all at once. Show me yours!$"}
text:SlateportCity.GretaDefeat	{'body': 'All three were sharp. Nicely done!$'}
text:SlateportCity.GretaDecline	{'body': 'Return when mind, skill, and body are\\nready to be judged together.$'}
text:SlateportCity.GretaAfter	{'body': 'That GENGARITE marks a contender.\\nBring it to the BATTLE FRONTIER.$'}
text:SlateportCity.KnuckleGuardClosed	{'body': "ROUTE 110 is closed while the CYCLING\\nROAD crew resurfaces the trail.\\pThe LEAGUE lets certified TRAINERS\\nthrough. BRAWLY's KNUCKLE BADGE\\lcounts.$"}
text:SlateportCity.BrawlyAtMuseum	{'body': 'BRAWLY is in the queue outside the\\nOCEANIC MUSEUM. Ask him to go home.\\pThen sail back with MR. BRINEY and\\nchallenge DEWFORD GYM.$'}
text:SlateportCity.BrawlyBackInDewford	{'body': "BRAWLY has returned to DEWFORD GYM.\\nChallenge him for the KNUCKLE BADGE.\\pMR. BRINEY's boat is on ROUTE 109,\\nsouth of SLATEPORT.$"}
text:SlateportCity.KnuckleGuardTrigger	{'body': 'Whoa, not past the cones! ROUTE 110\\nis closed until you hold the\\lKNUCKLE BADGE.$'}
text:SlateportCity_ContestHall_AdviceForContests	{'body': "Want a tasty little bit of advice\\nfor CONTESTS?\\pUsing a certain move after another\\ncertain kind of move sometimes gets\\lyou extra attention.\\pIf you know what you're doing,\\nyou can score big in appeal.\\pOf course, your opponents might try\\ndisrupting your POKéMON's showing.$"}
text:SlateportCity_ContestHall_MyPapaIsContestJudge	{'body': "My papa, he's a CONTEST JUDGE.\\pI wonder what I should be when I\\ngrow up, a JUDGE or a GYM LEADER?$"}
text:SlateportCity_ContestHall_ImLikeMajorlyCheesed	{'body': "Hey, man, I'm like majorly cheesed,\\nyou know. Like, you know, I just\\lwanted to know why my POKéMON\\lnever won, you know, like, hey?\\pSo, like, I gave the JUDGE my two\\ncents, you know, they're free.\\pAnd he wouldn't hear me out, like, hey!\\nSo, like, total bummer, man!\\pHey, like, you! Zip it, you know?\\nJust, you know, take this!$"}
text:SlateportCity_ContestHall_ExplainTorment	{'body': "That move the tutor teaches, like,\\nTORMENT? You hearing me?\\pLike, it won't let the other guy\\nuse the same move twice in a row, see?\\pHey, now, you listen here, like,\\nI'm not laying a torment on you!$"}
text:SlateportCity_ContestHall_MCStepUpTakePartInContest	{'body': "MC: Oh, my, my!\\nNow isn't that a dandy of a POKéMON?\\pPlease! Do step right up and take\\npart in our splendid CONTESTS!\\pYou'll do well! I'm sure of it!\\nMy eyes have never failed me!$"}
text:SlateportCity_ContestHall_JudgeWouldntDoToMissContest	{'body': "JUDGE: Well, hello there!\\nI see that you're a TRAINER!\\pThen, it just wouldn't do for you\\nto miss a POKéMON CONTEST!\\pGet a CONTEST PASS in VERDANTURF\\nCITY and enter anytime!$"}
text:SlateportCity_ContestHall_ItsAppealTime	{'body': "It's appeal time!\\nWhat should I lead with?$"}
text:SlateportCity_ContestHall_DidntPayAttentionToAppeal	{'body': "They didn't pay much attention to\\nmy POKéMON's appeal…\\pHumph, that JUDGE, he doesn't know\\na good thing when he sees it.$"}
text:SlateportCity_ContestHall_RewardWithSageAdvice	{'body': "Oh, hi! You must be a serious fan to get\\nthis close to the action.\\pI'll reward your enthusiasm with\\nthis sage advice.\\pIf a move goes over really well,\\nthe audience will get excited.\\pThe POKéMON that makes its appeal\\nright when everyone's excited…\\pWell, you'd think something good has\\nto happen!$"}
text:SlateportCity_ContestHall_MoreFreakedOutThanMon	{'body': "I can't do this! I'm more freaked out\\nthan my POKéMON.\\pI'm shivering and my heart is racing!$"}
text:SlateportCity_ContestHall_BattleAndContestAlike	{'body': "A battle and a CONTEST aren't the\\nsame, but they are alike, too.\\pYou need to work hard and believe\\nin the POKéMON you've raised.$"}
text:SlateportCity_ContestHall_MonLooksOnTopOfGame	{'body': "That POKéMON looks like it's on top\\nof its game, huh?\\pA POKéMON that does good in the\\nsecondary judging seems to be more\\lrelaxed when it's doing appeals.$"}
text:SlateportCity_ContestHall_MyMonBetterThanThatLot	{'body': "Will you look at that sorry sight?\\pHeh, my POKéMON's absolutely better\\nthan that lot!$"}
text:SlateportCity_ContestHall_GetUrgeToMoveWithMon	{'body': "Don't you get the urge to move with\\nPOKéMON if they're putting on an\\lenergetic appeal?$"}
text:SlateportCity_ContestHall_HyperRankStage	{'body': 'POKéMON CONTESTS\\nHYPER RANK STAGE!$'}
text:SlateportCity_BattleTentLobby.CouldntFindMonForMe	{'body': "I couldn't settle on a team. Too\\nmany interesting choices!\\pThen I found this PRISM SCALE.\\nMaybe you can put it to use.$"}
text:SlateportCity_BattleTentLobby.ExplainPrismScale	{'body': 'A Prism Scale evolves Feebas.\\nUse it from the Bag when ready.$'}
text:SlateportCity_BattleTentLobby.IllTryUsingBugMons	{'body': "I don't really like BUG POKéMON,\\nbut maybe I'll try using some for\\la change of pace.\\pWho knows, I might even get to like\\nthem!$"}
text:SlateportCity_BattleTentLobby.BattleEvenWithoutToughMons	{'body': 'The CENTER can prepare any legal\\nset for free. Bring your own six\\land test them here.$'}
text:SlateportCity_BattleTentLobby.NiceIfMoreSelection	{'body': 'A new opponent every match! I keep\\nleaving with another idea for my\\lteam.$'}
text:SlateportCity_BattleTentLobby.ExhibitionWelcome	{'body': 'The port brings together teams\\nfrom every shore.\\pThis is a six-Pokémon doubles\\nexhibition. You command every move\\land switch.\\pYour team uses the current cap.\\nDifficulty sets opponent levels.\\lEnter with six healthy partners?$'}
text:SlateportCity_BattleTentLobby.ExhibitionRules	{'body': 'LOCAL DOUBLES EXHIBITIONS\\pBring six healthy Pokémon, with no\\nEggs. Prepare freely before\\lentering.\\pThree victories earn one local\\nprize. Your party is restored\\lafter each exhibition.\\pThese results are separate from\\nthe CHAMPIONS CIRCUIT. You return\\lto this lobby afterward.$'}
text:SlateportCity_Harbor.FerryServiceUnavailable	{'body': 'The ferry opens to TRAINERS with\\nsix BADGES. Come back with the\\lFEATHER BADGE!$'}
text:SlateportCity_Harbor.MayISeeYourTicket	{'body': 'Hello, are you here for the ferry?\\nMay I confirm your ferry pass?$'}
text:SlateportCity_Harbor.YouMustHaveTicket	{'body': "You'll need a ferry pass. With\\nsix BADGES, speak to the sailor\\lat LILYCOVE HARBOR. He can\\lregister yours.$"}
text:SlateportCity_Harbor.ConfirmedPassWhereTo	{'body': "The attendant confirmed your ferry\\npass.\\pPerfect! That's all you need!\\pAnd where would you like to go?$"}
text:SlateportCity_Harbor.SailAnotherTime	{'body': 'Please sail with us another time!$'}
text:SlateportCity_Harbor.LilycoveItIs	{'body': 'LILYCOVE CITY it is, then!$'}
text:SlateportCity_Harbor.BattleFrontierItIs	{'body': 'BATTLE FRONTIER it is, then!$'}
text:SlateportCity_Harbor.PleaseBoardFerry	{'body': 'Please board the ferry and wait for\\ndeparture.$'}
text:SlateportCity_Harbor.WhereWouldYouLikeToGo	{'body': 'Then, where would you like to go?$'}
text:SlateportCity_Harbor.LoveToGoDeepUnderwaterSomeday	{'body': "A journey to the bottom of the sea…\\nI wonder what it'd be like?\\pI'd love to go deep underwater like\\nthat someday.$"}
text:SlateportCity_Harbor.AbnormalWeather	{'body': 'For a ship to sail safely, we need to\\nknow about the weather!\\pSpeaking of weather, I heard something\\nfrom a guy at the WEATHER INSTITUTE.\\pHe was saying abnormal weather has\\nbeen reported all over the place!\\pYou should visit the WEATHER INSTITUTE\\nand ask around!$'}
text:SlateportCity_Harbor.SubTooSmallForMe	{'body': "I wanted to go with CAPT. STERN on\\nthe ocean floor exploration.\\pBut the sub's too small for me.\\pIf I squeezed in, there wouldn't be\\nany room for the CAPTAIN…$"}
text:SlateportCity_Harbor.SameThugsTriedToRobAtMuseum	{'body': "CAPT. STERN: Those thugs…\\pThey're the same lot who tried to rob\\nthe DEVON GOODS at the MUSEUM.$"}
text:SlateportCity_Harbor.ArchieYouAgainHideoutInLilycove	{'body': 'ARCHIE: Oh?\\nNot you again…\\pYou are tenacious to track us here,\\nthat much I will give you.\\pBut now…\\nNo one can stop us! No one!\\pOr, will you follow us back to our\\nHIDEOUT in LILYCOVE CITY?\\pFwahahahaha…$'}
text:SlateportCity_Harbor.CaptSternWhyStealMySubmarine	{'body': "CAPT. STERN: They have my submarine.\\nThe cavern charts are aboard, too.\\pARCHIE named LILYCOVE. Reach the city\\nby heading east from ROUTE 121.\\pFind LILYCOVE's eastern beach. SURF\\nnorth to TEAM AQUA's cave hideout.\\pStop their launch before they reach\\nthe sleeping POKéMON on the seafloor.$"}
text:SlateportCity_Harbor.TeamAquaLeftNeedDive	{'body': "CAPT. STERN: AQUA left before you\\ncould stop them... Don't blame\\lyourself.\\pTo follow that submarine, you'll\\nneed DIVE registered, the MIND\\lBADGE, and a partner able to use\\lthe technique.\\pTravel to MOSSDEEP. Its divers and\\nthe SPACE CENTER may be able to\\lhelp.$"}
text:SlateportCity_Harbor.NeedDiveToCatchSub	{'body': "CAPT. STERN: To follow the\\nsubmarine, you'll need DIVE\\lregistered, the MIND BADGE, and a\\lcompatible partner.\\pVisit MOSSDEEP's SPACE CENTER and\\nfind STEVEN. He may be able to\\lhelp.$"}
text:SlateportCity_Harbor.WontBeLongBeforeWeFinishFerry	{'body': "CAPT. STERN: Oh, yes.\\nMR. BRINEY came to our SHIPYARD.\\pIt won't be long now before we finish\\nmaking the ferry!$"}
text:SlateportCity_Harbor.FinishedMakingFerry	{'body': "CAPT. STERN: {PLAYER}{KUN}!\\pWe finally finished making the ferry\\nS.S. TIDAL!\\pWe couldn't have done it without\\nyour friend MR. BRINEY.\\pPlease go for a short cruise on it!$"}
text:SlateportCity_Harbor.WouldYouTradeScanner	{'body': "CAPT. STERN: Oh?\\n{PLAYER}{KUN}, that item you have…\\pThat's a SCANNER! That would sure\\nhelp us on our explorations.\\p{PLAYER}{KUN}, would you trade your\\nSCANNER for something?\\pLike, say, a DEEPSEATOOTH or\\na DEEPSEASCALE that I have?$"}
text:SlateportCity_Harbor.IfYouWantToTradeLetMeKnow	{'body': "CAPT. STERN: Are you certain?\\nIt's useless to you, {PLAYER}{KUN}…\\pWell, okay, then. If you want to trade\\nyour SCANNER, let me know.$"}
text:SlateportCity_Harbor.TradeForDeepSeaTooth	{'body': "CAPT. STERN: So you'll trade it for\\nmy DEEPSEATOOTH?$"}
text:SlateportCity_Harbor.TradeForDeepSeaScale	{'body': "CAPT. STERN: So you'll trade it for\\nmy DEEPSEASCALE?$"}
text:SlateportCity_Harbor.WhichOneDoYouWant	{'body': 'CAPT. STERN: Which one do you want?$'}
text:SlateportCity_Harbor.HandedScannerToStern	{'body': '{PLAYER} handed the SCANNER to\\nCAPT. STERN.$'}
text:SlateportCity_Harbor.ThisWillHelpResearch	{'body': 'CAPT. STERN: Thanks, {PLAYER}{KUN}!\\nThis will help our research a lot!$'}
text:SlateportCity_House.NatureToDoWithStatGains	{'body': 'My POKéMON has a HASTY nature.\\nThat raises its SPEED, but lowers\\lits DEFENSE.\\pThe CENTER specialist can adjust\\nNatures. Mine likes life in the fast\\llane, so HASTY suits us!$'}
text:SlateportCity_House.MustBeGoingToBattleTent	{'body': "You're a TRAINER, aren't you?\\pSince you came to SLATEPORT CITY,\\nyou must be going to the BATTLE TENT.$"}
text:SlateportCity_Mart.MarketAndMartStockDifferentGoods	{'body': 'The MARKET has unusual merchandise.\\pThe MART is still a reliable place to\\nrestock everyday field supplies.$'}
text:SlateportCity_Mart.GreatBallIsBetter	{'body': "Ships bring evolution items from afar.\\nI sell stones and a few special tools.\\pLILYCOVE's department store carries\\nevery kind. Have a look at mine!$"}
text:SlateportCity_NameRatersHouse.PleasedToRateMonNickname	{'body': "Hi, hi! I'm the NAME RATER!\\nI'm the fortune-teller of names!\\pI shall be pleased to rate your\\nPOKéMON's nickname.$"}
text:SlateportCity_NameRatersHouse.CritiqueWhichMonNickname	{'body': "Which POKéMON's nickname should\\nI critique?$"}
text:SlateportCity_NameRatersHouse.FineNameSuggestBetterOne	{'body': 'Hmmm… {STR_VAR_1}, is it? That is\\nquite a fine name you bestowed.\\pBut! What say you, if I were to\\nsuggest a slightly better name?$'}
text:SlateportCity_NameRatersHouse.WhatShallNewNameBe	{'body': 'Ah, good. Then, what shall the new\\nnickname be?$'}
text:SlateportCity_NameRatersHouse.MonShallBeKnownAsName	{'body': 'Done! From now on, this POKéMON\\nshall be known as {STR_VAR_1}!\\pIt is a better name than before!\\nHow fortunate for you!$'}
text:SlateportCity_NameRatersHouse.DoVisitAgain	{'body': 'I see.\\nDo come visit again.$'}
text:SlateportCity_NameRatersHouse.NameNoDifferentYetSuperior	{'body': 'Done! From now on, this POKéMON\\nshall be known as {STR_VAR_1}!\\pIt looks no different from before,\\nand yet, this is vastly superior!\\pHow fortunate for you!$'}
text:SlateportCity_NameRatersHouse.MagnificentName	{'body': "Hmmm… {STR_VAR_1} it is!\\pThis is a magnificent nickname!\\nIt is impeccably beyond reproach!\\pYou'll do well to cherish your\\n{STR_VAR_1} now and beyond.$"}
text:SlateportCity_NameRatersHouse.ThatIsMerelyAnEgg	{'body': 'Now, now.\\nThat is merely an EGG!$'}
text:SlateportCity_NameRatersHouse.MegaGift_MALAMARITE_Text	{'body': 'An Inkay once watched me write\\nits name while hanging upside down.\\pIt left this curious stone behind.\\nA Malamar should know what to do.$'}
text:SlateportCity_OceanicMuseum_1F.WouldYouLikeToEnter	{'body': 'Welcome to the OCEANIC MUSEUM.\\pThe entrance fee is ¥50.\\nWould you like to enter?$'}
text:SlateportCity_OceanicMuseum_1F.PleaseEnjoyYourself	{'body': 'Please enjoy yourself.$'}
text:SlateportCity_OceanicMuseum_1F.NotEnoughMoney	{'body': "Oh? I'm sorry, but you don't seem to\\nhave enough money.$"}
text:SlateportCity_OceanicMuseum_1F.CatchUpWithYourGroup	{'body': "Oh? You're with that group that\\nwent in earlier?\\pYou're the only one who's late.\\nYou'd better go catch up to them!$"}
text:SlateportCity_OceanicMuseum_1F.AquaExistForGoodOfAll	{'body': 'We, TEAM AQUA, exist for the good\\nof all!$'}
text:SlateportCity_OceanicMuseum_1F.OurBossIsntHere	{'body': "We were told to assemble here,\\nso we did, but…\\pOur BOSS, the linchpin, isn't here.$"}
text:SlateportCity_OceanicMuseum_1F.WouldStuffHereMakeMeRich	{'body': 'If I ripped off the stuff here,\\nwould it make me rich?$'}
text:SlateportCity_OceanicMuseum_1F.CanLearnForNefariousDeeds	{'body': 'What I learn here, I can put to use on\\nnefarious deeds…$'}
text:SlateportCity_OceanicMuseum_1F.RustboroBungled	{'body': "If our goons didn't bungle things\\nin RUSTBORO, we wouldn't be here!$"}
text:SlateportCity_OceanicMuseum_1F.DidntHaveMoney	{'body': "I didn't have ¥50, so it took a long\\ntime getting by the receptionist.$"}
text:SlateportCity_OceanicMuseum_1F.LearnAboutSeaForBattling	{'body': 'I want to learn about the sea and\\nuse that knowledge for battling.$'}
text:SlateportCity_OceanicMuseum_1F.SternIsRoleModel	{'body': 'I get all giddy and gooey when\\nI see the sea!\\pFor me, CAPT. STERN is the number\\none role model!$'}
text:SlateportCity_OceanicMuseum_1F.MustBePokemonWeDontKnow	{'body': "The sea is vast without end, and\\ninfinitely deep…\\pThere must be many POKéMON that\\nwe don't know about.$"}
text:SlateportCity_OceanicMuseum_1F.WantSeaPokemon	{'body': 'I want a sea POKéMON.\\pI think it would feel cool and nice\\nto hug.$'}
text:SlateportCity_OceanicMuseum_1F.RememberMeTakeThis	{'body': "Aiyeeeh!\\nWhat are you doing here?\\pMe? I'm the TEAM AQUA member\\nyou thumped before, remember?\\lBack in RUSTURF TUNNEL?\\pHere, take this!\\nYou have to forgive me!$"}
text:SlateportCity_OceanicMuseum_1F.HopeINeverSeeYouAgain	{'body': 'That DEEP SEA TOOTH suits you more\\nthan it does me. It evolves CLAMPERL.\\pHope I never see you again!\\nWahahaha!$'}
text:SlateportCity_OceanicMuseum_1F.YouHaveToTakeThis	{'body': 'Awww, come on!\\nYou have to take this and let me go!$'}
text:SlateportCity_OceanicMuseum_1F.WhirlpoolExperiment	{'body': 'A blue fluid is spiraling inside\\na glass vessel.\\p“This is an experiment to create a\\nWHIRLPOOL artificially using wind.”$'}
text:SlateportCity_OceanicMuseum_1F.WaterfallExperiment	{'body': "A red ball is bobbing up and down\\ninside a glass vessel.\\p“This is an experiment simulating a\\nWATERFALL using the ball's buoyancy.”$"}
text:SlateportCity_OceanicMuseum_1F.OceanSoilDisplay	{'body': "It's a sample of soil from the ocean\\nfloor.\\p“Over many years, the remains of\\nlife-forms settle at the bottom of\\lthe sea, making sedimentary layers.\\p“By analyzing these layers, the\\nancient past is revealed.”$"}
text:SlateportCity_OceanicMuseum_1F.BeachSandDisplay	{'body': "It's a sample of beach sand.\\p“Stones from mountains are washed\\ndown by rivers where they are\\lchipped and ground down.\\p“They are reduced to grains and end\\nup as sand on beaches.”$"}
text:SlateportCity_OceanicMuseum_1F.OceanicMinifact1	{'body': '“OCEANIC MINIFACT 1\\nWhy is seawater blue?\\p“Light is composed of many colors.\\p“When light passes through water,\\nmost kinds of light lose color.\\p“However, blue light retains its\\ncolor, making the sea appear blue.”$'}
text:SlateportCity_OceanicMuseum_1F.OceanicMinifact2	{'body': '“OCEANIC MINIFACT 2\\nWhy is the sea salty?\\p“Seawater contains dissolved salt in\\nthe form of sodium and chlorine ions.\\p“These ions leech out of rocks\\nand are carried out to sea by rain.\\p“The concentration of dissolved salt\\nmakes the sea salty.”$'}
text:SlateportCity_OceanicMuseum_1F.OceanicMinifact3	{'body': '“OCEANIC MINIFACT 3\\nWhich is bigger? The sea or land?\\p“The sea covers about 70% of\\nthe planet, and the rest is land.\\p“The sea is therefore more than twice\\nthe size of land.”$'}
text:SlateportCity_OceanicMuseum_1F.FossilDisplay	{'body': "It's a fossil with wavy ridges on it.\\p“Soil on the ocean floor gets scoured\\nby the tide.\\p“The flowing seawater marks the soil\\nwith small ridges and valleys.\\p“If this soil becomes fossilized, it is\\ncalled a ripple mark.”$"}
text:SlateportCity_OceanicMuseum_1F.DepthMeasuringMachine	{'body': "A strange machine is rotating under\\na glass dome.\\pMaybe it's for measuring the depth\\nof something…$"}
text:SlateportCity_OceanicMuseum_2F.ThankYouForTheParts	{'body': "I'm STERN. You brought DEVON's\\nparts! They'll help us measure\\lpressure deep beneath the sea.\\pThe tides have been changing.\\nEven the wild POKéMON are\\lappearing in unusual places.$"}
text:SlateportCity_OceanicMuseum_2F.WellTakeThoseParts	{'body': 'Hold it. Those parts map pressure below\\nthe seafloor. AQUA is taking them.$'}
text:SlateportCity_OceanicMuseum_2F.SternWhoAreYou	{'body': 'CAPT. STERN: Wh-what?\\nWho are you people?$'}
text:SlateportCity_OceanicMuseum_2F.WereTeamAqua	{'body': "We're TEAM AQUA! Those parts belong to\\nthe people who understand the sea!$"}
text:SlateportCity_OceanicMuseum_2F.Grunt1Defeat	{'body': "That wasn't supposed to happen!$"}
text:SlateportCity_OceanicMuseum_2F.BossGoingToBeFurious	{'body': 'The boss is going to hear about this…$'}
text:SlateportCity_OceanicMuseum_2F.LetMeTakeCareOfThis	{'body': "Move aside.\\nI'll get those parts myself!$"}
text:SlateportCity_OceanicMuseum_2F.Grunt2Defeat	{'body': "I can't stop this kid!$"}
text:SlateportCity_OceanicMuseum_2F.MeddlingKid	{'body': "We still don't have the parts.\\nWhat are we going to tell ARCHIE?$"}
text:SlateportCity_OceanicMuseum_2F.CameToSeeWhatsTakingSoLong	{'body': "That's enough. You two, stand back.\\nI'll deal with this.$"}
text:SlateportCity_OceanicMuseum_2F.ArchieWarning	{'body': "I'm ARCHIE, leader of TEAM AQUA.\\pThe sea doesn't care for borders.\\nLife moves where the water\\lcarries it.\\pThose instruments can track the\\ndeep currents and lead us to the\\lPOKéMON that shaped the sea.\\pMAXIE would bury that power under\\nmore land. I intend to let it\\lflow.\\pHand them over, or stand and\\nfight!$"}
text:SlateportCity_OceanicMuseum_2F.ArchieDefeat	{'body': 'Tch! I underestimated you.$'}
text:SlateportCity_OceanicMuseum_2F.ArchieDefeated	{'body': "Keep them, then.\\nAQUA won't turn back for one Trainer.\\pWe'll find that current with or without\\nyour precious instruments.$"}
text:SlateportCity_OceanicMuseum_2F.SternThankYouForSavingUs	{'body': '{PLAYER}, thank you. You kept us\\nand the parts safe.\\pOur instruments may reveal what\\nis disturbing the ocean and its\\lPOKéMON.$'}
text:SlateportCity_OceanicMuseum_2F.SternIveGotToGo	{'body': "I'll get these instruments to the\\nship. We can't let AQUA reach the\\ldepths first.\\pAfter DEWFORD GYM, follow ROUTE\\n110 north to MAUVILLE CITY.\\pWATTSON keeps the city running.\\nHis GYM should give you a\\lchallenge!$"}
text:SlateportCity_OceanicMuseum_2F.BrawlyHandoff	{'body': "But earn BRAWLY's BADGE first.\\nThen you can head north.$"}
text:SlateportCity_OceanicMuseum_2F.RemindsMeOfAbandonedShip	{'body': 'I saw a model of a ship here.\\pIt reminded me of the ABANDONED SHIP\\nnear DEWFORD TOWN…$'}
text:SlateportCity_OceanicMuseum_2F.DontRunInMuseum	{'body': "Don't you dare run around inside\\nthe MUSEUM!$"}
text:SlateportCity_OceanicMuseum_2F.WantToRideSubmarine	{'body': "Wow, the submarine's awesome!\\nI want to go for a ride!$"}
text:SlateportCity_OceanicMuseum_2F.WaterQualitySample1	{'body': '“WATER QUALITY SAMPLE 1,” the\\nlabel says.\\pThe sea is all connected, but the\\nwater seems to differ by region.$'}
text:SlateportCity_OceanicMuseum_2F.WaterQualitySample2	{'body': '“WATER QUALITY SAMPLE 2,” the\\nlabel says.\\pDoes the saltiness of seawater differ\\nby region, too?$'}
text:SlateportCity_OceanicMuseum_2F.PressureExperiment	{'body': 'A rubber ball is expanding and\\nshrinking.\\p“In the sea, the weight of water itself\\nexerts pressure.\\p“In shallow water, the pressure is not\\nvery heavy.\\p“However, in extremely deep water,\\nthe pressure can reach even tens of\\lthousands of tons on a small area.”$'}
text:SlateportCity_OceanicMuseum_2F.HoennModel	{'body': "“MODEL OF HOENN REGION”\\pIt's a miniature diorama of the\\nHOENN region.\\pWhere is LITTLEROOT TOWN on this?$"}
text:SlateportCity_OceanicMuseum_2F.DeepSeawaterDisplay	{'body': "It's a display on the flow of seawater.\\p“Near the bottom of the sea, water\\nflows due to differences in such\\lfactors as temperature and salinity.”$"}
text:SlateportCity_OceanicMuseum_2F.SurfaceSeawaterDisplay	{'body': "It's a display on the flow of seawater.\\p“Toward the surface, seawater flows\\nas currents driven by the winds.”$"}
text:SlateportCity_OceanicMuseum_2F.SSTidalReplica	{'body': "“THE FERRY S.S. TIDAL”\\p“A scale replica of the vessel\\ndesigned at STERN'S SHIPYARD.”$"}
text:SlateportCity_OceanicMuseum_2F.SubmarineReplica	{'body': '“SUBMARINE EXPLORER 1\\p“A replica of the high-performance\\nocean floor exploration submarine.”$'}
text:SlateportCity_OceanicMuseum_2F.SumbersibleReplica	{'body': '“SUBMERSIBLE POD\\p“A replica of a compact, unmanned\\npod for seafloor exploration.”$'}
text:SlateportCity_OceanicMuseum_2F.SSAnneReplica	{'body': '“S.S. ANNE\\p“A replica of the luxury liner that\\ncircles the globe.”$'}
text:SlateportCity_PokemonCenter_1F.RaiseDifferentTypesOfPokemon	{'body': "Want a tip for battling?\\pI'd say it's raising different kinds\\nof POKéMON in a balanced manner.\\pIt's no good to make just one\\nPOKéMON strong.\\pIf it has a type disadvantage,\\nit might not stand a chance.$"}
text:SlateportCity_PokemonCenter_1F.TradedMonWithFriend	{'body': 'I trade POKéMON with my friends.\\pIf a traded POKéMON is holding an\\nitem, it makes me twice as happy!$'}
text:SlateportCity_PokemonFanClub.FurfrouOffer	{'body': 'A fine FURFROU deserves a fine\\ntrim! Would yours like a new cut?$'}
text:SlateportCity_PokemonFanClub.FurfrouChoose	{'body': 'Choose the FURFROU you want styled.$'}
text:SlateportCity_PokemonFanClub.FurfrouComplete	{'body': 'All done! {STR_VAR_1} has a lovely\\nnew look.$'}
text:SlateportCity_PokemonFanClub.FurfrouInvalid	{'body': 'I can only style FURFROU, including\\none that already has a trim.$'}
text:SlateportCity_PokemonFanClub.FurfrouExit	{'body': 'Come back whenever FURFROU wants a\\ndifferent look.$'}
text:SlateportCity_PokemonFanClub.MeetChairman	{'body': "Er-hem! I am the CHAIRMAN of the\\nPOKéMON FAN CLUB!\\pBeing the CHAIRMAN, I am naturally\\nthe most important!\\pNo one can best me when it comes\\nto raising POKéMON. No one!\\pWell, let me tell you about\\nPOKéMON CONTESTS.\\pThey're events where one can show off\\nPOKéMON for the world to see!\\pHowever, they're held in far-off towns,\\nso I cannot participate often enough.\\pThat is why we gather here to show\\noff our POKéMON, and have others\\lshow us theirs.$"}
text:SlateportCity_PokemonFanClub.LikeToSeeEnteredContestPokemon	{'body': 'The POKéMON of a TRAINER who has\\nentered a POKéMON CONTEST…\\lThat, I would like to see.$'}
text:SlateportCity_PokemonFanClub.AllowMeToExamineYourPokemon	{'body': "Er-hem! I see you've participated in\\na POKéMON CONTEST!\\pPlease! Allow me to examine how you\\nhave raised your POKéMON.\\pIt delights me no end to see POKéMON\\nraised by other TRAINERS.\\pThe happy expressions of POKéMON\\nraised with proper care…\\pThe kindly eyes of the TRAINER that\\nnurtured and raised the POKéMON…\\pThe very thought fills my heart to\\noverwhelming with joy.\\pOh! I do beg your pardon!\\nForgive me for prattling on so!\\pPlease! Allow me to examine how much\\nyour POKéMON has grown!$"}
text:SlateportCity_PokemonFanClub.HowIsYourPokemonGrowing	{'body': 'How is your POKéMON growing?\\nAllow me to examine it.$'}
text:SlateportCity_PokemonFanClub.HmHmISee	{'body': 'Hm, hm…\\nI see…$'}
text:SlateportCity_PokemonFanClub.GiveMonMorePokeblocks	{'body': "Hmmm… It's not bad, but it's not\\ngood, either…\\pYou, the TRAINER, must put more\\neffort into raising this POKéMON!\\pFor instance, may I suggest that\\nyou give it more {POKEBLOCK}S?$"}
text:SlateportCity_PokemonFanClub.NoSpaceForReward	{'body': 'Oh, my…\\pYour POKéMON is growing quite well,\\nso you deserve a reward.\\pUnfortunately, you have no space for\\nthis in your BAG.$'}
text:SlateportCity_PokemonFanClub.MonMostImpressiveGiveItThis	{'body': 'Your {STR_VAR_1}, it is growing in\\na most impressive manner!\\lIt is one fine specimen!\\pBut! If you were to give it this,\\nit would grow even better! Indeed!$'}
text:SlateportCity_PokemonFanClub.ExplainRedScarf	{'body': 'Let a POKéMON hold that RED SCARF.\\pEveryone will recognize the coolness\\nof that POKéMON!$'}
text:SlateportCity_PokemonFanClub.ExplainBlueScarf	{'body': 'Let a POKéMON hold that BLUE SCARF.\\pIts beauty will be accentuated much\\nmore than now!$'}
text:SlateportCity_PokemonFanClub.ExplainPinkScarf	{'body': 'Let a POKéMON hold that PINK SCARF.\\pIt will draw out the cuteness of\\nthe POKéMON some more!$'}
text:SlateportCity_PokemonFanClub.ExplainGreenScarf	{'body': 'Let a POKéMON hold that GREEN SCARF.\\pThat will enhance the\\nsmartness of POKéMON!$'}
text:SlateportCity_PokemonFanClub.ExplainYellowScarf	{'body': "Let a POKéMON hold that YELLOW SCARF.\\pIt will bolster your POKéMON's\\ntoughness so much more!$"}
text:SlateportCity_PokemonFanClub.NothingElseToGiveYou	{'body': "You've earned every scarf I have!\\pDo keep visiting with your\\nPOKéMON. Seeing them flourish is a\\ljoy!$"}
text:SlateportCity_PokemonFanClub.ShowMePokemonThatLoveYou	{'body': "I love seeing POKéMON that love\\ntheir TRAINERS.\\pPOKéMON are very sensitive to\\nthe feelings of their TRAINERS.\\pIf you treat your POKéMON with love\\nand care, they'll love you back.\\pWhen your POKéMON grow to love you,\\nplease come show me.$"}
text:SlateportCity_PokemonFanClub.PokemonAdoresYou	{'body': 'Your POKéMON really adores you.\\pFor you, a most compassionate\\nTRAINER, a gift from the FAN CLUB!$'}
text:SlateportCity_PokemonFanClub.TreatPokemonWithLove	{'body': "POKéMON are very sensitive to\\nthe feelings of their TRAINERS.\\pIf you treat your POKéMON with love\\nand care, they'll love you back.$"}
text:SlateportCity_PokemonFanClub.PokemonDontLikeFainting	{'body': "If you keep letting a POKéMON faint\\nin battle, it'll come to resent it.\\pSoon, it will become less trusting\\nof the TRAINER.\\pIn other words, it certainly won't\\nlike you very much.$"}
text:SlateportCity_PokemonFanClub.MonEnjoyedLuxuryBall	{'body': 'Do POKéMON remember how they were\\ncaught?\\pMine became friendly so quickly after\\nI caught it in a LUXURY BALL.$'}
text:SlateportCity_PokemonFanClub.Skitty	{'body': 'SKITTY: Fffnyaaaah…$'}
text:SlateportCity_PokemonFanClub.Zigzagoon	{'body': 'ZIGZAGOON: Kyuuu…$'}
text:SlateportCity_PokemonFanClub.Azumarill	{'body': 'AZUMARILL: Marimari?$'}
text:SlateportCity_SternsShipyard_1F.CantMakeHeadsOrTails	{'body': "The hull fits. The engine fits.\\nSo why won't these measurements agree?\\pIf I move this here…\\nNo, then that won't fit!$"}
text:SlateportCity_SternsShipyard_1F.MeetDockDeliverToStern	{'body': "Hm? Oh, sorry. I'm DOCK.\\nCAPT. STERN asked me to design a ferry.\\pAre those the DEVON GOODS?\\nHe's been waiting for them.\\pHe's at the OCEANIC MUSEUM.\\nTake the parcel straight to him.$"}
text:SlateportCity_SternsShipyard_1F.CouldYouFindStern	{'body': "DOCK: Try the OCEANIC MUSEUM.\\nCAPT. STERN needs that parcel.\\pI'll be here, arguing with\\nthese measurements…$"}
text:SlateportCity_SternsShipyard_1F.CouldUseAdviceFromVeteran	{'body': "DOCK: Shipbuilding is an art.\\pA lot of things can't be figured out\\njust by calculating.\\pI really could use advice from a veteran\\nwho knows the seas…$"}
text:SlateportCity_SternsShipyard_1F.BrineyJoinedUs	{'body': "DOCK: MR. BRINEY's joined us!\\pThe ferry is sailing, but there's\\nalways work to do. His experience\\lat sea is a great help.$"}
text:SlateportCity_SternsShipyard_1F.FerryIsReady	{'body': "DOCK: The ferry is finally ready!\\pThe new S.S. TIDAL is truly a marvel\\nof technology!\\pBut, I get the feeling that we can\\nmake something even better.\\pYou know, there's never an end to\\ntechnology's march.$"}
text:SlateportCity_SternsShipyard_1F.DecidedToHelpDock	{'body': "MR. BRINEY: Ah, {PLAYER}{KUN}!\\nIt's been too long!\\pI've joined DOCK here at the\\nshipyard. That lad's S.S. TIDAL\\lis a fine vessel!\\pHe knows the engineering, and I\\nknow the sea. Together, we'll\\lkeep her sailing for years!$"}
text:SlateportCity_SternsShipyard_1F.SeaIsLikeLivingThing	{'body': "The seasons, the weather, where\\nthe moon sits in the sky…\\pThese and other conditions make\\nthe sea change its expression.\\pThat's right!\\nThe sea is like a living thing!$"}
text:SlateportCity_SternsShipyard_1F.GetSeasickEasily	{'body': 'I get seasick real easily.\\nSo I get to help out here instead.$'}
text:SlateportCity_SternsShipyard_2F.ShipDesignMoreLikeBuilding	{'body': 'Designing a large ship is more like\\nmaking a big building than putting\\ltogether a transportation vehicle.$'}
text:SlateportCity_SternsShipyard_2F.FloatsBecauseBuoyancy	{'body': "Don't you think it's strange that\\na ship made of heavy iron floats?\\pIt floats because of a principle\\ncalled buoyancy.$"}
text:SootopolisCity.GymSign	{'body': 'SOOTOPOLIS CITY POKéMON GYM\\nLEADER: JUAN\\p“The GYM LEADER with the beauty\\nof pure water!”$'}
text:SootopolisCity.CitySign	{'body': 'SOOTOPOLIS CITY\\p“The mystical city where history\\nslumbers.”$'}
text:SootopolisCity.DoorIsClosed	{'body': 'The door is closed.$'}
text:SootopolisCity.PhysicallyFitLivingHere	{'body': 'Diving in the sea. Climbing up and\\ndown stairs all the time…\\pIf you live in this town, you end up\\ngetting physically fit.$'}
text:SootopolisCity.GiantPokemonSuddenlyAppeared	{'body': "These giant POKéMON suddenly appeared\\nin the middle of the city!\\pAnd, I've never seen them before!\\pWhy are they smashing into each\\nother like that?\\pWhy can't they be friends, those\\nPOKéMON?$"}
text:SootopolisCity.WhatIsThatGreenPokemon	{'body': 'What? What? What?\\nWhat is that green POKéMON?!$'}
text:SootopolisCity.WhereDidLegendariesGo	{'body': 'GROUDON and KYOGRE…\\nWhere did they go?\\pWill they cause droughts or downpours\\nsomewhere else?$'}
text:SootopolisCity.TwoPokemonArentAngry	{'body': "I just get this sense somehow that\\nthe two POKéMON aren't angry.\\pI think… They probably can't control\\ntheir own power…$"}
text:SootopolisCity.FlyingMonStoppedRampage	{'body': 'That flying POKéMON came down from\\nthe sky and stopped the rampaging\\lPOKéMON…$'}
text:SootopolisCity.WonderWhatWorldIsLike	{'body': "I… I've never been out of this city.\\pI wonder what the world is like on\\nthe other side of this round sky?$"}
text:SootopolisCity.ThisIsWicked	{'body': 'Wow!\\nThis is wicked!$'}
text:SootopolisCity.ThatWasWicked	{'body': 'Wow!\\nThat was wicked!$'}
text:SootopolisCity.GoRedAndBlueMon	{'body': "Go for it, red POKéMON!\\nDon't back off, blue POKéMON!$"}
text:SootopolisCity.DoYouKnowMonNames	{'body': '… … … … … …\\pHi, do you know the names of those\\nPOKéMON fighting over there?$'}
text:SootopolisCity.GreenOneSettlesThings	{'body': "I was wondering which one would win,\\nthe red one or the blue one, but, oh no,\\lit's the green one that settles things!\\pTalk about a huge turn of events!$"}
text:SootopolisCity.SeeingLegendWithOwnEyes	{'body': "There's an ancient legend that claims\\nthe land and sea were shaped by\\la colossal battle between POKéMON.\\pWell, I'm seeing that happen with\\nmy very own eyes!\\pWhoa! I never expected to be\\nwitness to something this huge!$"}
text:SootopolisCity.SawLegendWithOwnEyes	{'body': "There's an ancient legend that claims\\nthe land and sea were shaped by\\la colossal battle between POKéMON.\\pWell, I saw that happen with\\nmy very own eyes!\\pWhoa! I never expected to be\\nwitness to something this huge!$"}
text:SootopolisCity.BigPokemonFighting	{'body': 'A big POKéMON is fighting with\\nanother big POKéMON!\\pPlease, someone make them stop!$'}
text:SootopolisCity.PrettyMonCameFromSky	{'body': 'A pretty POKéMON came down from\\nthe sky…$'}
text:SootopolisCity.SootopolisWillBeWrecked	{'body': 'Oh, no!\\nSOOTOPOLIS CITY will get wrecked!$'}
text:SootopolisCity.SootopolisDidntGetWrecked	{'body': "SOOTOPOLIS CITY didn't get wrecked!$"}
text:SootopolisCity.NoOrdinaryTourist	{'body': "Hm!\\nYou've come all the way to SOOTOPOLIS?\\lYou're no ordinary tourist.\\pBut I suppose that doesn't make you\\nan extraordinary tourist, either.$"}
text:SootopolisCity.CityRegainedCalm	{'body': 'The city has regained its calm…$'}
text:SootopolisCity.CaveOfOriginPleaseLeave	{'body': 'Who might you be?\\pThis is the CAVE OF ORIGIN.\\pThe spirits of POKéMON, becalmed at\\nMT. PYRE, are said to be revived here.\\pPlease leave.$'}
text:SootopolisCity.LeadSuperiorTrainerToCave	{'body': 'A person with a strong will and\\nsuperior talent…\\pA TRAINER who has knowledge and\\nexperience of many kinds of POKéMON…\\pIf such a person were to appear, I was\\ninstructed by WALLACE to lead that\\lTRAINER to this CAVE.$'}
text:SootopolisCity.AwakenedPokemonClash	{'body': 'Oh, my…\\pThe clash between the two awakened\\nPOKéMON was quelled by the awakening\\lof a third POKéMON…$'}
text:SootopolisCity.CaveOfOriginSleepsToo	{'body': 'The crisis has passed. You may\\nexplore the CAVE OF ORIGIN again.\\pTERAPAGOS lives on B1F, the floor\\nwhere you met WALLACE. Let me\\lcheck its discovery record.$'}
text:SootopolisCity.SootopolisSkyBeautiful	{'body': "SOOTOPOLIS sprang up as a town in\\nthe crater of a volcano.\\pIf you look up at the sky, the lip of\\nthe crater is also visible.\\lSo, all you see is the sky in a circle.\\pBut that's what makes the sky above\\nSOOTOPOLIS the most beautiful.$"}
text:SootopolisCity.GiganticPokemonFight	{'body': "When two POKéMON that gigantic\\nare fighting that savagely, there's\\lnot much that we can do.$"}
text:SootopolisCity.FearedWorstWhenPokemonFlewDown	{'body': 'When that third POKéMON flew down,\\nI feared the worst.$'}
text:SootopolisCity.NightSkyFavoriteScenery	{'body': "A circle of a night sky framed by\\nthe crater of a volcano…\\pAnd in that ring, stars flicker and\\nblink as if they were alive…\\lIt's my favorite scenery.$"}
text:SootopolisCity.WeatherWentWild	{'body': 'The weather was clear this morning,\\nbut…\\pAll of a sudden, dark clouds brewed up,\\nrain started falling in sheets, and\\lthere was thunder and lightning, too.\\pThe weather just went completely\\nwild!\\pIs all of this because of those\\nPOKéMON?$'}
text:SootopolisCity.YouBroughtFlyingMon	{'body': "Oh?\\pIt was you who brought that flying\\nPOKéMON here?\\pWell, aren't you amazing!$"}
text:SootopolisCity.GroudonPleaseStop	{'body': "MAXIE: GROUDON, stop!\\pI wanted more land for people and\\nPOKéMON to live on. You're\\lburning the homes they already\\lhave!$"}
text:SootopolisCity.AfterAllOurScheming	{'body': "MAXIE: The heat is fading…\\nRAYQUAZA stopped them.\\pI was so certain more land would\\nhelp HOENN. I wouldn't listen to\\lanyone who questioned me.\\pLook what that certainty nearly\\ncost us.$"}
text:SootopolisCity.KyogreCalmDown	{'body': 'ARCHIE: KYOGRE! I called this freedom,\\nbut even the sea needs a shore.\\pThe RED ORB cannot make you hear me.$'}
text:SootopolisCity.TryingMeaninglessToPokemon	{'body': "ARCHIE: The rain's stopped.\\nPeople can come out again.\\pI said I was protecting sea\\nPOKéMON. I nearly washed away\\levery home along this coast.\\pWe have to return the ORBS,\\nMAXIE.$"}
text:SootopolisCity.InvolvedWithCrisisComeWithMe	{'body': "STEVEN: GROUDON and KYOGRE's\\nclash is tearing through this\\lcrater.\\pTheir weather reaches across\\nHOENN. We must restore the\\lbalance before anyone else is\\lhurt.\\pWALLACE knows the old legends.\\nCome with me.$"}
text:SootopolisCity.DoesThisMakeYourFearPokemon	{'body': 'STEVEN: I understand why people\\nare frightened. Neither leader\\lcould control the POKéMON they\\lawakened.\\pBut POKéMON have helped us\\nthrough this, too. We must find a\\lway to stop the fighting.$'}
text:SootopolisCity.HereWereAreHelpWallace	{'body': 'WALLACE knows the story of the\\nlast time these two clashed. Tell\\lhim what you have seen.$'}
text:SootopolisCity.KnowWhatsNeededToHelpHim	{'body': "STEVEN: I think you have what's\\nneeded to help him…$"}
text:SootopolisCity.NeverBeenToSkyPillar	{'body': 'STEVEN: SKY PILLAR stands on the\\nnorth side of ROUTE 131, east of\\lPACIFIDLOG.\\pRAYQUAZA is said to rest at its\\nsummit. Find it and bring it\\lhere!$'}
text:SootopolisCity.SoThatsRayquaza	{'body': "STEVEN: So that's RAYQUAZA…\\pJust as the old tale said, it\\nstopped their clash. You reached\\lit in time, {PLAYER}.$"}
text:SootopolisCity.MaxieArchieLeft	{'body': "STEVEN: MAXIE and ARCHIE have\\ngone to MT. PYRE to return the\\lORBS.\\pThe weather is settling. There is\\nstill so much of HOENN to\\lexplore, and so many POKéMON to\\lmeet.\\pThe guide near the POKéMON\\nCENTER's PC can tell you about\\llocal legendary discoveries.$"}
text:SootopolisCity.HaventYouScaledSkyPillar	{'body': "WALLACE: Oh?\\n{PLAYER}{KUN}?\\pHaven't you scaled the SKY PILLAR\\nyet?\\pI'm sure that you can make it to\\nthe top of the SKY PILLAR…$"}
text:SootopolisCity.AquaMagmaDidntMeanHarm	{'body': 'WALLACE: MAXIE and ARCHIE are\\nstill here. They owe you an\\lexplanation.\\pReturning the ORBS will be a\\nstart. There is much more for\\lthem to put right.$'}
text:SootopolisCity.ThankYouForHelpAcceptThis	{'body': 'WALLACE: You crossed HOENN to\\nstop this disaster, then climbed\\lSKY PILLAR when we needed you\\lmost.\\pThank you, {PLAYER}{KUN}.\\nSOOTOPOLIS is safe again. Please\\laccept this.$'}
text:SootopolisCity.ExplainWaterfallGoToGym	{'body': "That HIDDEN MACHINE contains\\nWATERFALL.\\pWith the RAIN BADGE, a party member\\nthat can learn WATERFALL can climb\\lwaterfalls without being taught it.\\pAnd where does one get the RAIN BADGE?\\nYou know, don't you?\\pThat's right! You have to beat\\nthe SOOTOPOLIS GYM LEADER.\\pWhen you're all set to go, step through\\nthat door.$"}
text:SootopolisCity.DazzledByMentor	{'body': "WALLACE: JUAN, my mentor, leads\\nthis city's GYM. His BADGE is the\\llast you need for the LEAGUE.\\pYou've helped our city through so\\nmuch. I look forward to seeing\\lhow far your journey takes you.$"}
text:SootopolisCity_Gym_1F.GymGuideAdvice	{'body': "Yo! How's it going, CHAMPION-\\nbound {PLAYER}?\\pSOOTOPOLIS's GYM LEADER JUAN is\\na master of WATER-type POKéMON.\\pAnd, to get to JUAN, an icy floor\\nwill hamper your progress…\\pListen, I'm sorry, but that's all the\\nadvice that I have for you.\\pThe rest of the way, you have to\\ngo for it yourself!$"}
text:SootopolisCity_Gym_1F.GymGuidePostVictory	{'body': "Yow! You've beaten even JUAN, who\\nwas supposedly the best in all HOENN!\\pOkay! Check out your TRAINER CARD.\\pIf you've gotten all the BADGES, you're\\nset for the POKéMON LEAGUE challenge!$"}
text:SootopolisCity_Gym_1F.JuanIntro	{'body': "I am JUAN, WALLACE's mentor and\\nSOOTOPOLIS's GYM LEADER.\\pYou have done our city a great\\nservice. Now let us meet as\\lTRAINERS.\\pMy partners thrive in rain. Each\\nbrings a different strength to\\lour performance. Shall we begin?$"}
text:SootopolisCity_Gym_1F.JuanDefeat	{'body': 'Excellent! A victory to be proud of.\\pTake the RAIN BADGE. WALLACE will\\nask even more of your team.$'}
text:SootopolisCity_Gym_1F.ReceivedRainBadge	{'body': '{PLAYER} received the RAIN BADGE\\nfrom JUAN.$'}
text:SootopolisCity_Gym_1F.ExplainRainBadgeTakeThis	{'body': "The RAIN BADGE lets your LEVELER train\\na party up to Lv. 80.\\pIt also enables WATERFALL to scale\\nwalls of cascading water.\\pWith all eight BADGES, HOENN's last\\ndoors open: VICTORY ROAD, and the\\lLEAGUE beyond it.\\pAnd, so that you never forget the\\nbattle we shared, take this…$"}
text:SootopolisCity_Gym_1F.ExplainGyaradosite	{'body': "Gyaradosite lets Gyarados Mega\\nEvolve. Let it hold the stone in\\lbattle.\\pSURF east from ROUTE 128 to EVER\\nGRANDE. Use WATERFALL at the\\lcity's entrance.$"}
text:SootopolisCity_Gym_1F.RegisteredJuan	{'body': 'Registered GYM LEADER JUAN\\nin the POKéNAV.$'}
text:SootopolisCity_Gym_1F.JuanPostBattle	{'body': "Eight BADGES open EVER GRANDE.\\nIts challenge is five master\\lteams in a row.\\pSURF east from ROUTE 128 to EVER\\nGRANDE. Use WATERFALL at the\\lcity's entrance.\\pYou may heal with your BAG\\nbetween rooms, but never use\\litems inside their battles.$"}
text:SootopolisCity_Gym_1F.NeedMindBadge	{'body': 'There remains but one BADGE to\\nobtain in HOENN.\\pIf you wish to challenge the POKéMON\\nLEAGUE, first earn the MIND BADGE\\lfrom the GYM in MOSSDEEP.$'}
text:SootopolisCity_Gym_1F.GymStatue	{'body': 'SOOTOPOLIS CITY POKéMON GYM$'}
text:SootopolisCity_Gym_1F.GymStatueCertified	{'body': "SOOTOPOLIS CITY POKéMON GYM\\pJUAN'S CERTIFIED TRAINERS:\\n{PLAYER}$"}
text:SootopolisCity_Gym_1F.JuanPreRematch	{'body': 'JUAN: Ah, this GYM had returned to its\\nusual state of serenity…\\pBut our young typhoon has returned\\nto put us to the test again!\\pWell, my friend, most certainly!\\pI shall be delighted to dance with you\\nas often as you wish!$'}
text:SootopolisCity_Gym_1F.JuanRematchDefeat	{'body': 'Ahahaha, you are the winner!\\nYou have defeated me again!$'}
text:SootopolisCity_Gym_1F.JuanPostRematch	{'body': 'JUAN: If I told you to become my\\napprentice, you will refuse, I am sure.\\pI would like to make a gift of my coat\\nto you.\\pBut again, you will refuse.\\nI imagine that to be so.\\pAnd that, my friend, is a certain sign\\nof nobility!$'}
text:SootopolisCity_Gym_1F.JuanRematchNeedTwoMons	{'body': 'JUAN: Ah, this GYM had returned to its\\nusual state of serenity…\\pBut our young typhoon has returned\\nto put us to the test again!\\pWell, my friend, most certainly!\\nI shall be delighted to dance with you…\\pAh, no, no, no.\\nYou have with you but one POKéMON.\\pI wish that you would return with\\ntwo, perhaps more, POKéMON, please.$'}
text:SootopolisCity_Gym_B1F.AndreaIntro	{'body': "I'll show you the sublime techniques\\nI learned from our LEADER JUAN!$"}
text:SootopolisCity_Gym_B1F.AndreaDefeat	{'body': 'Please forgive me, JUAN…$'}
text:SootopolisCity_Gym_B1F.AndreaPostBattle	{'body': 'Watch what happens if you crack all\\nthe floor tiles.$'}
text:SootopolisCity_Gym_B1F.CrissyIntro	{'body': "You came all the way here, but you won't\\nget to see JUAN.\\pNot if you lose to me, you won't!$"}
text:SootopolisCity_Gym_B1F.CrissyDefeat	{'body': "You're strong!\\nI was fooled by your cute looks!$"}
text:SootopolisCity_Gym_B1F.CrissyPostBattle	{'body': 'You might be good enough to avoid\\nbeing wiped out in one hit by JUAN.$'}
text:SootopolisCity_Gym_B1F.DaphneIntro	{'body': 'The sight of JUAN conducting\\na battle…\\pThe very beauty of it compelled me to\\nbecome a TRAINER.$'}
text:SootopolisCity_Gym_B1F.DaphneDefeat	{'body': 'You battled with more beauty than\\nI could muster…$'}
text:SootopolisCity_Gym_B1F.DaphnePostBattle	{'body': "The grace you bring to battle is\\nfabulous.\\pOh… I'm so fortunate to have found\\nPOKéMON.$"}
text:SootopolisCity_Gym_B1F.ConnieIntro	{'body': 'I should teach you how harsh battles\\ncan be.$'}
text:SootopolisCity_Gym_B1F.ConnieDefeat	{'body': "Oh.\\nYou're strong.$"}
text:SootopolisCity_Gym_B1F.ConniePostBattle	{'body': "I'll tell you something good.\\pIf you want to reach JUAN, you\\nneed to walk on each floor tile once.$"}
text:SootopolisCity_Gym_B1F.BridgetIntro	{'body': "The POKéMON GYM of the highest level\\nin the HOENN region…\\pThat's the SOOTOPOLIS GYM.$"}
text:SootopolisCity_Gym_B1F.BridgetDefeat	{'body': 'What a high level you are!$'}
text:SootopolisCity_Gym_B1F.BridgetPostBattle	{'body': 'Rather than being satisfied by being\\nin a strong GYM, I imagine training in\\lother places will make you stronger.\\lBut above all, it looks more fun.$'}
text:SootopolisCity_Gym_B1F.OliviaIntro	{'body': "I train my POKéMON together with\\nJUAN.\\pDon't think I'm a pushover.$"}
text:SootopolisCity_Gym_B1F.OliviaDefeat	{'body': 'I was beaten…$'}
text:SootopolisCity_Gym_B1F.OliviaPostBattle	{'body': "I think you have potential.\\nWhy don't you stay and train with us?$"}
text:SootopolisCity_Gym_B1F.TiffanyIntro	{'body': 'A graceful glide across the ice while\\ncrossing no lines…\\pA TRAINER putting on that performance\\nwould be elegantly beautiful!$'}
text:SootopolisCity_Gym_B1F.TiffanyDefeat	{'body': 'Well, excuse me?!$'}
text:SootopolisCity_Gym_B1F.TiffanyPostBattle	{'body': 'This is really obvious, but how strong\\nyou are as a TRAINER has nothing to do\\lwith how young or old you are.$'}
text:SootopolisCity_Gym_B1F.BethanyIntro	{'body': "When I'm with my POKéMON, the time\\nflies by before you can say, “Oops!”$"}
text:SootopolisCity_Gym_B1F.BethanyDefeat	{'body': 'Oops!$'}
text:SootopolisCity_Gym_B1F.BethanyPostBattle	{'body': 'I wish I could forget about lost causes\\nbefore I can manage an “Oops!”$'}
text:SootopolisCity_Gym_B1F.AnnikaIntro	{'body': "I can battle with really rare POKéMON\\nif you'd like.$"}
text:SootopolisCity_Gym_B1F.AnnikaDefeat	{'body': 'Oh, there now! Did you have a good look\\nat my POKéMON?$'}
text:SootopolisCity_Gym_B1F.AnnikaPostBattle	{'body': "I came to this GYM because JUAN\\npraised me for my darling POKéMON.\\pOh, if only I'd met JUAN years ago\\nwhen I was younger…$"}
text:SootopolisCity_Gym_B1F.BriannaIntro	{'body': 'Giggle…\\nYour grim look is so charming.$'}
text:SootopolisCity_Gym_B1F.BriannaDefeat	{'body': 'Oh, dear.\\nI went much too easy on you.$'}
text:SootopolisCity_Gym_B1F.BriannaPostBattle	{'body': "You couldn't lay a finger on JUAN,\\nI'm sure. Giggle…$"}
text:SootopolisCity_House1.FoundThisRazorClaw	{'body': "For thirty years I've remained in\\nSOOTOPOLIS honing my skills.\\pThis RAZOR CLAW is just as sharp.\\nI bequeath it to you!$"}
text:SootopolisCity_House1.ExplainRazorClaw	{'body': 'Use a RAZOR CLAW on SNEASEL at\\nnight to evolve it into WEAVILE.\\pA Hisuian SNEASEL needs it during\\nthe day instead, to become\\lSNEASLER.$'}
text:SootopolisCity_House1.Kecleon	{'body': 'KECLEON: Puu puhyaah.$'}
text:SootopolisCity_House2.MoveSpecialist	{'body': 'I once taught DRACO METEOR only to\\nDRAGONS that trusted their TRAINER.\\pThe CENTER specialist now handles\\nevery legal competitive move.$'}
text:SootopolisCity_House2.DidYouKnowAboutMtPyreOrbs	{'body': "MT. PYRE… I once visited its\\nsummit and saw the two ORBS in\\lthe elders' care.\\pHave you heard their story?$"}
text:SootopolisCity_House2.YesTwoOrbsSideBySide	{'body': 'The elders said those ORBS were\\npassed down for generations.\\pI still remember how carefully\\nthey watched over them.$'}
text:SootopolisCity_House2.OughtToVisitAndSee	{'body': "The elders at MT. PYRE can tell\\nyou. They've kept HOENN's old\\lstories alive for so long.$"}
text:SootopolisCity_House3.JuanHasManyFansDoYou	{'body': "You're a POKéMON TRAINER, aren't you?\\pSOOTOPOLIS's JUAN has many fans.\\nEven more than his student WALLACE!\\pDo you have any?$"}
text:SootopolisCity_House3.YouMustBePrettyStrong	{'body': 'Oh, then you must be pretty strong.$'}
text:SootopolisCity_House3.LonesomeTryWorkingHarder	{'body': "Oh, dear…\\nThat's a little lonesome.\\pTry working a little harder to get\\na fan following.$"}
text:SootopolisCity_House3.TrainerFanClubWasWild	{'body': 'Dedicated fans come over from even\\noutside of HOENN.\\pIt was really wild when I went to the\\nTRAINER FAN CLUB in LILYCOVE.$'}
text:SootopolisCity_House4.AncientTreasuresWaitingInSea	{'body': "Listen up, and I'll tell you something\\ngood.\\pThere's supposed to be an ancient\\nruin in the sea around here.\\pThere could be treasures just waiting\\nto be discovered down there.$"}
text:SootopolisCity_House4.StrollUnderwaterWithPokemon	{'body': "Ancient treasures…\\pIt would be nice if they existed, but\\neven if they didn't, it would be so\\lbeautiful to take an underwater\\lstroll with my POKéMON.$"}
text:SootopolisCity_House4.Azumarill	{'body': 'AZUMARILL: Marurii.$'}
text:SootopolisCity_House5.SootopolisMtPyreConnection	{'body': 'There appears to be some connection\\nbetween SOOTOPOLIS and MT. PYRE.\\pMy friends and I did some research on\\nit at the lab where I used to work.$'}
text:SootopolisCity_House5.BrotherUsedToStudySea	{'body': 'My big brother used to study the sea.$'}
text:SootopolisCity_House6.FirstGuestInWhileTakeDoll	{'body': "Hello! You're our first guest in\\na good while.\\pYou've brightened up my day, so I'll\\ngive you a big WAILMER DOLL.$"}
text:SootopolisCity_House6.TakeGoodCareOfIt	{'body': 'Take good care of it!$'}
text:SootopolisCity_House6.IllHoldItForYou	{'body': "Oh, you want it, but not right now?\\nOkay, then I'll hold it for you.$"}
text:SootopolisCity_House6.DontWantThisDoll	{'body': "Are you sure?\\nYou don't want this DOLL?$"}
text:SootopolisCity_House6.LovePlushDolls	{'body': 'I love plush DOLLS!$'}
text:SootopolisCity_House7.CityFromEruptedVolcano	{'body': "An underwater volcano erupted and\\nforced itself up from the depths.\\pIts crater emerged from the sea and\\nbecame filled with rainwater.\\pThat's how SOOTOPOLIS CITY came into\\nbeing.$"}
text:SootopolisCity_House7.CaveMadeToKeepSomething	{'body': 'The cave that links SOOTOPOLIS and\\nthe outside world…\\pIt seems as if the cave was made to\\nkeep something from getting out.\\pOr am I just imagining things?$'}
text:SootopolisCity_LotadAndSeedotHouse.PleaseShowMeBigSeedot	{'body': "Do you know the POKéMON SEEDOT?\\nIt's hardly ever seen in SOOTOPOLIS.\\pAnyway, I love big SEEDOT.\\nThe bigger the better.\\pBut my younger brother, he says that\\nLOTAD is bigger.\\pThat's silly.\\nSEEDOT has to be bigger than that!\\pHuh? Do you have a SEEDOT with you?\\nP-p-please, show me!$"}
text:SootopolisCity_LotadAndSeedotHouse.GoshMightBeBiggerThanLotad	{'body': '{STR_VAR_2}!\\nOh, my gosh, this is a big one!\\pIt might even beat the big LOTAD\\nmy younger brother saw!\\pThanks for showing me.\\nThis is my thanks!$'}
text:SootopolisCity_LotadAndSeedotHouse.ReceivedPotion1	{'body': '{PLAYER} received a POTION.$'}
text:SootopolisCity_LotadAndSeedotHouse.BagCrammedFull1	{'body': 'Hunh?\\nYour BAG is crammed full.$'}
text:SootopolisCity_LotadAndSeedotHouse.SeenBiggerSeedot	{'body': "{STR_VAR_2}, is it?\\pHmm… I've seen a bigger SEEDOT\\nthan this one.$"}
text:SootopolisCity_LotadAndSeedotHouse.ThatsNotSeedot	{'body': "Oh, now this is quite something…\\nBut it's not a SEEDOT!$"}
text:SootopolisCity_LotadAndSeedotHouse.DontHaveBigSeedot	{'body': "You don't have a big SEEDOT?\\nThat's too bad…\\pIf you get a big SEEDOT, please\\ncome show me.$"}
text:SootopolisCity_LotadAndSeedotHouse.BiggestSeedotInHistory	{'body': "The biggest SEEDOT in history!\\n{STR_VAR_2}'s {STR_VAR_3} giant!\\pA SEEDOT bigger than a LOTAD\\nalways wanted!$"}
text:SootopolisCity_LotadAndSeedotHouse.PleaseShowMeBigLotad	{'body': "Do you know the POKéMON LOTAD?\\nIt's rarely seen in SOOTOPOLIS.\\pI love, I mean love, big LOTAD!\\pMy big brother says that SEEDOT is\\nbigger.\\pBut that's wrong! Everyone knows that\\nLOTAD is a lot bigger.\\pHunh? Do you have a LOTAD?\\nP-p-please show me!$"}
text:SootopolisCity_LotadAndSeedotHouse.WowMightBeBiggerThanSeedot	{'body': '{STR_VAR_2}!\\nWow, that is big!\\pIt might be even bigger than the huge\\nSEEDOT my big brother saw.\\pThanks for showing me!\\nThis is my thanks!$'}
text:SootopolisCity_LotadAndSeedotHouse.ReceivedPotion2	{'body': '{PLAYER} received a POTION.$'}
text:SootopolisCity_LotadAndSeedotHouse.BagCrammedFull2	{'body': 'Hunh?\\nYour BAG is crammed full.$'}
text:SootopolisCity_LotadAndSeedotHouse.SeenBiggerLotad	{'body': "{STR_VAR_2}?\\pHmm… I've seen a bigger LOTAD\\nthan this one here.$"}
text:SootopolisCity_LotadAndSeedotHouse.ThatsNotLotad	{'body': "Well, isn't this something!\\nBut it's no LOTAD!$"}
text:SootopolisCity_LotadAndSeedotHouse.DontHaveBigLotad	{'body': "Don't you have a big LOTAD?\\nHow disappointing…\\pIf you get a big LOTAD, please\\ncome show me!$"}
text:SootopolisCity_LotadAndSeedotHouse.BiggestLotadInHistory	{'body': "The biggest LOTAD in history!\\n{STR_VAR_2}'s {STR_VAR_3} colossus!\\pA LOTAD bigger than a SEEDOT\\nalways wanted!$"}
text:SootopolisCity_Mart.PPUpIsGreat	{'body': 'PP UP is great!\\pIt raises the POWER POINTS, the PP,\\nof a POKéMON move.$'}
text:SootopolisCity_Mart.TooScaryOutside	{'body': "What…\\nWhat is happening?\\pI really want to know, but it's too\\nscary to go outside.$"}
text:SootopolisCity_Mart.FullRestoreItemOfDreams	{'body': "Do you know FULL RESTORE?\\pFull restoration of HP!\\nEradication of all status problems!\\pIt's truly an item of your dreams!$"}
text:SootopolisCity_Mart.DidSomethingAwaken	{'body': 'This weather…\\nDid something awaken?$'}
text:SootopolisCity_MysteryEventsHouse_1F.OnlyAmusementWatchingBattles	{'body': "When I was young, I traveled the world\\nas a POKéMON TRAINER.\\pNow that I've become an old buzzard,\\nmy only amusement is watching young\\lTRAINERS battle.$"}
text:SootopolisCity_MysteryEventsHouse_1F.DoorAppearsToBeLocked	{'body': 'The door appears to be locked.$'}
text:SootopolisCity_MysteryEventsHouse_1F.ChallengeVisitingTrainer	{'body': 'A TRAINER named {STR_VAR_1}\\nis visiting my home.\\pWould you like to challenge\\n{STR_VAR_1}?$'}
text:SootopolisCity_MysteryEventsHouse_1F.YouWontBattle	{'body': "You won't battle? I'm disappointed\\nthat I can't see you battle…$"}
text:SootopolisCity_MysteryEventsHouse_1F.KeepItTo3On3	{'body': "Oh, good, good!\\pBut my house isn't all that sturdy.\\pCould I ask you to keep it down to\\na 3-on-3 match?$"}
text:SootopolisCity_MysteryEventsHouse_1F.SaveProgressBeforeBattle	{'body': 'Before you two battle, you should\\nsave your progress.$'}
text:SootopolisCity_MysteryEventsHouse_1F.HopeToSeeGoodMatch	{'body': 'I hope to see a good match!$'}
text:SootopolisCity_MysteryEventsHouse_1F.StrVar1Tie	{'body': '{STR_VAR_1}$'}
text:SootopolisCity_MysteryEventsHouse_B1F_MatchEndedUpDraw	{'body': 'The match ended up a draw.$'}
text:SootopolisCity_MysteryEventsHouse_1F.BrilliantStandoff	{'body': 'So, it became a standoff.\\pIt was a brilliant match in which\\nneither side conceded a step!$'}
text:SootopolisCity_MysteryEventsHouse_1F.StrVar1Won	{'body': '{STR_VAR_1}$'}
text:SootopolisCity_MysteryEventsHouse_1F.ThatWasSuperlative	{'body': 'That was superlative!\\pWhy, it was like seeing myself in\\nmy youth again!$'}
text:SootopolisCity_MysteryEventsHouse_1F.StrVar1Lost	{'body': '{STR_VAR_1}$'}
text:SootopolisCity_MysteryEventsHouse_1F.TooBadForYou	{'body': 'Ah, too bad for you!\\pBut it was a good match.\\nI hope you can win next time.$'}
text:SootopolisCity_MysteryEventsHouse_1F.CurrentBattles	{'body': "I still enjoy a fine Pokémon\\nbattle. These old visitor records\\lbring back good memories.\\pFor a new challenge, seek the\\nLeague or the Frontier's CHAMPIONS\\lCIRCUIT.$"}
text:SootopolisCity_PokemonCenter_1F.WallaceToughestInHoenn	{'body': "WALLACE is rumored to be the toughest\\nTRAINER in the whole HOENN region.\\pThis town's GYM is led by the TRAINER\\nwho taught WALLACE.\\pBut the ELITE FOUR… They're said to be\\neven stronger than WALLACE's mentor.\\pHow strong could they be?$"}
text:SootopolisCity_PokemonCenter_1F.EveryoneTakenRefuge	{'body': "Many families are sheltering\\nindoors until the weather\\lsettles.\\pI'd rather stay here, too. That\\nclash outside is frightening.$"}
text:SootopolisCity_PokemonCenter_1F.AlwaysBeFriendsWithPokemon	{'body': "Whenever, wherever, and whatever\\nhappens, I will always be friends with\\lPOKéMON.\\pBecause it's fun to be with POKéMON!$"}
text:SootopolisCity_PokemonCenter_1F.ArentPokemonOurFriends	{'body': "Aren't POKéMON our friends?\\pWhy are they going wild this way?$"}
text:ThreeIsland_BerryForest_HelpScaryPokemon	{'body': "LOSTELLE: Whimper… Sniff…\\nOh! Please, help!\\pA scary POKéMON appeared there\\na little while ago.\\pIt kept scaring.\\nIt made LOSTELLE scared.\\pI'm too scared to move!\\nBut I want to go home…$"}
text:ThreeIsland_BerryForest_HereItComesAgain	{'body': "Oh! Here it comes again!\\nNo! Go away! It's scaring me!\\pWaaaaaaah!\\nI want my daddy!$"}
text:ThreeIsland_BerryForest_ThankYouHaveThis	{'body': 'Ohh! That was so scary!\\nThank you!\\pLOSTELLE came to pick some\\nBERRIES.\\pYou can have this!$'}
text:ThreeIsland_BerryForest_LetsGoHome	{'body': "What's your name?\\pLOSTELLE's scared, so can I go\\nwith you to my daddy's house?\\pOkay!\\nLet's go home!$"}
text:ThreeIsland_BerryForest_BerryPouchIsFull	{'body': "Your BERRY POUCH is full.\\nI guess you don't want this.$"}
text:ThreeIsland_BerryForest_WelcomeToBerryForest	{'body': 'Welcome to the BERRY FOREST\\pBe friendly and share BERRIES with\\nothers and POKéMON.$'}
text:ThreeIsland_BerryForest_BewareWildBerryLovingMons	{'body': 'Beware of wild, BERRY-loving\\nPOKéMON!$'}
text:ThreeIsland_BondBridge_NikkiIntro	{'body': 'The salty tang of the sea…\\nIt tickles my heart.$'}
text:ThreeIsland_BondBridge_NikkiDefeat	{'body': '…Sniff, sniff…\\nSomething smells unpleasant…$'}
text:ThreeIsland_BondBridge_NikkiPostBattle	{'body': "Perhaps that reek is your sweaty\\nPOKéMON's body odor…$"}
text:ThreeIsland_BondBridge_VioletIntro	{'body': 'Where are you off to in such\\na hurry?$'}
text:ThreeIsland_BondBridge_VioletDefeat	{'body': "You're raising some wonderful\\nPOKéMON.$"}
text:ThreeIsland_BondBridge_VioletPostBattle	{'body': "If you keep going this way, you'll\\neventually reach BERRY FOREST.$"}
text:ThreeIsland_BondBridge_AmiraIntro	{'body': "My mommy said that I can't swim\\nwithout my float ring.$"}
text:ThreeIsland_BondBridge_AmiraDefeat	{'body': 'Waaah!\\nWaaah!$'}
text:ThreeIsland_BondBridge_AmiraPostBattle	{'body': "This year, I'm going to finally\\nlearn how to swim!$"}
text:ThreeIsland_BondBridge_AlexisIntro	{'body': 'Yay, yay!\\nPOKéMON!$'}
text:ThreeIsland_BondBridge_AlexisDefeat	{'body': 'What happens now?$'}
text:ThreeIsland_BondBridge_AlexisPostBattle	{'body': 'Did I just win?\\nOr did I lose?$'}
text:ThreeIsland_BondBridge_TishaIntro	{'body': "Oh, no, don't come here!\\nPlease, stay away from me!$"}
text:ThreeIsland_BondBridge_TishaDefeat	{'body': "Okay, you've won!\\nNow will you please go away?$"}
text:ThreeIsland_BondBridge_TishaPostBattle	{'body': "A POKéMON bit through my \\nswimsuit.\\pI can't get out of the water!$"}
text:ThreeIsland_BondBridge_JoyIntro	{'body': "JOY: We'll teach you what our\\nfavorite POKéMON is!$"}
text:ThreeIsland_BondBridge_JoyDefeat	{'body': 'JOY: Ohh…\\nMEG!$'}
text:ThreeIsland_BondBridge_JoyPostBattle	{'body': "JOY: Wasn't that fun?\\nI hope we can battle again!$"}
text:ThreeIsland_BondBridge_JoyNotEnoughMons	{'body': "JOY: I really want to battle with\\nMEG.\\pOne POKéMON isn't enough.$"}
text:ThreeIsland_BondBridge_MegIntro	{'body': "MEG: We'll show you our favorite\\nPOKéMON.$"}
text:ThreeIsland_BondBridge_MegDefeat	{'body': 'MEG: Ohh…\\nJOY!$'}
text:ThreeIsland_BondBridge_MegPostBattle	{'body': "MEG: JOY, wasn't that fun?$"}
text:ThreeIsland_BondBridge_MegNotEnoughMons	{'body': "MEG: I want to battle together\\nwith JOY.\\pOne POKéMON isn't enough.$"}
text:ThreeIsland_BondBridge_BerryForestAhead	{'body': 'BERRY FOREST AHEAD$'}
text:ThreeIsland_BondBridge_BondBridgeSign	{'body': 'BOND BRIDGE\\nPlease be quiet when crossing.\\pBERRY FOREST AHEAD$'}
text:ThreeIsland_DunsparceTunnel_ProspectingForGold	{'body': "Hey, there!\\nHow's it going?\\pWhat am I doing here, you ask?\\nWhy, I'm prospecting for gold!\\pWhen I strike it rich, I'm buying\\na house in KANTO.$"}
text:ThreeIsland_DunsparceTunnel_StruckGoldThisIsForYou	{'body': "Hey, there! How's it going?\\nDid you hear? I've struck gold!\\pYou remembered that I was\\nprospecting, didn't you?\\pYou can't begin to imagine just\\nhow happy I am.\\pSo, I'll show you!\\nThis is for you!$"}
text:ThreeIsland_DunsparceTunnel_ThatsANugget	{'body': "That's a NUGGET!\\pI can't give you any nuggets of\\nwisdom, so that'll have to do!$"}
text:ThreeIsland_DunsparceTunnel_WhoopsBagCrammedFull	{'body': "Whoops, your BAG is crammed full!\\nI'll give this to you later.$"}
text:ThreeIsland_IslandSign	{'body': 'THREE ISLAND\\nKin Island of Family Bonding$'}
text:ThreeIsland_IslandBelongsToUs	{'body': 'Hyahoo!\\pFrom this day on, this island\\nbelongs to us!$'}
text:ThreeIsland_GoBackToKanto	{'body': "We don't need you people bringing\\nyour noise and trouble here!\\pWe're asking you to go back to\\nKANTO!$"}
text:ThreeIsland_BossIsOnHisWay	{'body': "Hey, go cry somewhere else.\\nOur boss is on his way.\\pWhen he gets here, we'll give you\\na k-rad motorbike show you won't\\lsoon forget!$"}
text:ThreeIsland_GetOffIslandNow	{'body': 'W-what!? Not on your life!\\nGet off the island now!$'}
text:ThreeIsland_WhosGonnaMakeMe	{'body': "Who's gonna make me?$"}
text:ThreeIsland_AreYouBossGoBackToKanto	{'body': 'Are you the boss?\\nGo back to KANTO right now!$'}
text:ThreeIsland_JustGotHerePal	{'body': "Hah?\\pI just got here, pal.\\pWhat's with the hostile attitude?\\nIt's mighty cold of you!$"}
text:ThreeIsland_FollowersRaisingHavoc	{'body': "Your gang of followers have been\\nraising havoc on their bikes.\\pDo you have any idea how much\\ntrouble they've caused us on the\\lisland?$"}
text:ThreeIsland_OughtToBeThankingUs	{'body': "No, man, I don't get it at all.\\pLook at this place.\\nWhat do you do for entertainment?\\pYou ought to be thanking us for\\nlivening up this sleepy village.\\pBut hey, if you insist, you can try\\nmaking us leave.$"}
text:ThreeIsland_YouCowardsToughInPack	{'body': 'Grr… You cowards…\\nSo tough in a pack…$'}
text:ThreeIsland_WannaMakeSomethingOfYourStaring	{'body': "You, what are you staring at?\\nDon't you know it's not polite?\\pYou wanna make something of it\\nor what?$"}
text:ThreeIsland_ThatsSmart	{'body': "That's smart.\\nKeep your nose out of this.$"}
text:ThreeIsland_Biker1Intro	{'body': "Heh, I like your guts.\\nYou'll be losing money to me, but…$"}
text:ThreeIsland_Biker1Defeat	{'body': 'Wha…\\nWhat is this kid?!$'}
text:ThreeIsland_Biker1PostBattle	{'body': "Aww, man…\\nDon't you dare laugh!$"}
text:ThreeIsland_Biker2Intro	{'body': "Aren't you from KANTO?\\nYou should be on our side!$"}
text:ThreeIsland_Biker2Defeat	{'body': 'Stop fooling around!$'}
text:ThreeIsland_Biker2PostBattle	{'body': "What's the matter with you,\\ngetting all hot like that?\\pTotally uncool, man!$"}
text:ThreeIsland_Biker3Intro	{'body': 'We invited the boss out here,\\nbut you had to mess it up!\\pYou embarrassed us, man!$'}
text:ThreeIsland_Biker3Defeat	{'body': '… … …   … … …$'}
text:ThreeIsland_Biker3PostBattle	{'body': "Boss, I'm telling you, you've gotta\\ndo something about this kid!$"}
text:ThreeIsland_PaxtonIntro	{'body': "I've been watching you, and I'd say\\nyou've done enough.\\pWhat are you, their friend or\\nsomething?\\pThen I guess you'll be battling me\\nin their place.$"}
text:ThreeIsland_PaxtonDefeat	{'body': "All right, enough!\\nWe'll leave like you wanted!\\pWe'll be happy to see the last of\\nthis boring island!$"}
text:ThreeIsland_PaxtonPostBattle	{'body': 'Humph! Yeah, go right on hanging\\naround with these hayseeds!$'}
text:ThreeIsland_ThankYouOhYourMonGotHurt	{'body': 'Thank you! Those goons were\\nnothing but bad trouble.\\pOh, look, your POKéMON got hurt\\non my account.$'}
text:ThreeIsland_GivenFullRestore	{'body': '{PLAYER} was given\\na FULL RESTORE.$'}
text:ThreeIsland_OhYourBagIsFull	{'body': 'Oh?\\nYour BAG is full.$'}
text:ThreeIsland_YouveGotImpressiveMons	{'body': "You've got seriously impressive\\nPOKéMON with you.$"}
text:ThreeIsland_LostelleWentOffTowardsBondBridge	{'body': "It'd be fantastic if someone as\\nstrong as you lived here.\\pI hope you'll at least stay here\\na while.\\p…I beg your pardon?\\nYou're looking for LOSTELLE?\\pLOSTELLE went off towards BOND\\nBRIDGE a while ago.$"}
text:ThreeIsland_WouldntWantToSeeBikersHereAgain	{'body': "THREE ISLAND is actually the most\\npopulous of the islands here.\\pStill, it could be less sleepy.\\pBut I wouldn't want to see goons\\nlike those BIKERS here again.$"}
text:ThreeIsland_WhenDodouEvolvesGoingToPlayGame	{'body': "I'm going to train my DODUO in the\\nBERRY FOREST.\\pWhen it evolves, I'm going to play\\na game on TWO ISLAND.$"}
text:ThreeIsland_Doduo	{'body': 'DODUO: Gigiih!$'}
text:ThreeIsland_House1_YoureAlwaysSoCool	{'body': "LOSTELLE: Hi, {PLAYER}!\\nYou're always so cool!\\pI'll make lunch for you, too, one\\nday, {PLAYER}.$"}
text:ThreeIsland_House1_RareRocksGemsDisplayed	{'body': 'Rare rocks and gems are displayed.$'}
text:ThreeIsland_House2_CantMakeThisSpoonBend	{'body': "Urrrrrrrrgggghhhh…\\nKwaaaaah!\\p…It's useless! I can't make this\\nspoon bend with my mind.\\pMaybe I really don't have any\\npsychic powers.$"}
text:ThreeIsland_House2_IAdmireSabrina	{'body': "You know about a girl GYM LEADER\\nin SAFFRON CITY?\\pShe uses PSYCHIC-type POKéMON,\\nright?\\pI admire her, I really do.\\pI've heard that she's one cool\\ncustomer and beautiful, too.$"}
text:ThreeIsland_House3_WantedToLiveSomewhereQuiet	{'body': "I bought this house because I\\nwanted to live somewhere quiet.\\pToday, I think I'll go out fishing.$"}
text:ThreeIsland_House4_GhostsInBerryForest	{'body': 'You must never, ever go out to\\nthe BERRY FOREST alone.\\pWhy?\\nThere are ghosts there.$'}
text:ThreeIsland_House4_PapaKeepsLyingToMe	{'body': "Papa keeps lying to me, and won't\\nlet me go out and play!$"}
text:ThreeIsland_House5_ImNotLostelle	{'body': "Me?\\nI'm not LOSTELLE.\\pShe's probably gone to the\\nBERRY FOREST, I think.\\pShe picks BERRIES there for making\\nlunch.$"}
text:ThreeIsland_House5_IllGoPlayWithLostelle	{'body': "I think I'll go play with LOSTELLE\\ntoday.$"}
text:ThreeIsland_Mart_TrueThatCeldadonDeptStoreBigger	{'body': 'Is it true?\\pCELADON DEPT. STORE is several\\ntimes bigger than this shop?$'}
text:ThreeIsland_Mart_PeopleHealWithBerriesFromForest	{'body': 'I sometimes buy medicine here.\\pBut a lot of people heal POKéMON\\nwith BERRIES from BERRY FOREST.\\pAfter all, BERRIES are free and\\nthey never run out.$'}
text:ThreeIsland_Mart_BikersWereAboutToTrashMart	{'body': 'Those BIKERS were about to trash\\nthis POKéMON MART.\\pAm I glad they decided to leave!$'}
text:ThreeIsland_PokemonCenter_1F_PCNetworkCanLinkWithKanto	{'body': "Hey, did you hear the news?\\pThe PC network here can now link\\nwith PCs in KANTO.\\pI don't know how that came about,\\nbut it's fantastic!$"}
text:ThreeIsland_PokemonCenter_1F_ImpossibleToSurfBetweenIslands	{'body': "It's impossible to SURF between the\\nislands around these parts.\\pThe tides are too fast and\\ntreacherous.$"}
text:ThreeIsland_PokemonCenter_1F_AlwaysBerriesInBerryForest	{'body': "Let's crush BERRIES!\\n…That'd be wasting BERRIES?\\pYou can always find some BERRIES\\non the ground in BERRY FOREST.$"}
text:ThreeIsland_Port_WereKantoRiderFederation	{'body': "We're the KANTO RIDER FEDERATION!\\nVroom! Vavavavooom! Vroom!\\pMy bike's wimpy, so I have to\\nmake exhaust noises myself!$"}
text:ThreeIsland_Port_ForkOverMoney	{'body': 'Hey, hey, lady!\\nFork over some spending money!$'}
text:ThreeIsland_Port_IllCallThePolice	{'body': "Aiyeeh!\\pWh-who are you?!\\nI… I'll call the police!$"}
text:ThreeIsland_Port_ThankGoodnessBikersGone	{'body': 'Those BIKERS…\\nAre they gone?\\pOh, thank goodness!\\nThey certainly had me terrified!$'}
text:ThreeIsland_Port_EverythingTurnedOutForBest	{'body': 'Those BIKERS ran off, and\\nLOSTELLE was found safe.\\pEverything turned out for the best!$'}
text:TrainerHill_Entrance.StillGettingReady	{'body': "This is the TRAINER HILL where\\nyou may enjoy tag battles with many\\lTRAINERS.\\pUnfortunately, we're still getting\\nthings ready. Please come back later!$"}
text:TrainerHill_Entrance.WelcomeToTrainerHill	{'body': 'Welcome!\\pThis is the TRAINER HILL where\\nyou may enjoy tag battles with many\\lTRAINERS!$'}
text:TrainerHill_Entrance.SaveGameBeforeEnter	{'body': 'Is this your first visit here?\\pBefore you enter, please save\\nyour game.$'}
text:TrainerHill_Entrance.TrainersUpToFloorX	{'body': "Let's see…\\nThe TRAINERS here now are…\\pUp to floor no. {STR_VAR_1}.$"}
text:TrainerHill_Entrance.TrainersInEveryRoom	{'body': "Let's see…\\nThe TRAINERS here now are…\\pThere appear to be TRAINERS gathered\\nin every room.$"}
text:TrainerHill_Entrance.LikeToChallengeTrainers	{'body': 'Would you like to challenge the\\nwaiting TRAINERS?$'}
text:TrainerHill_Entrance.TimeProgessGetSetGo	{'body': 'I will time your progress.\\nBest of luck!\\pOn your marks…\\pGet set…\\pGo!$'}
text:TrainerHill_Entrance.PleaseVisitUsAgain	{'body': 'Please do visit us again!$'}
text:TrainerHill_Entrance.TooBadTremendousEffort	{'body': 'That was too bad.\\pI think you put in a tremendous\\neffort in your battling.\\pPlease come back and try again!$'}
text:TrainerHill_Entrance.HopeYouGiveItYourBest	{'body': 'I hope you give it your best.$'}
text:TrainerHill_Entrance.MovedReceptionHereForSwitch	{'body': "When the TRAINERS switch places,\\nthe movement can be hectic.\\pTo avoid the stampede, we moved\\nthe reception counter here.\\pI'm sorry for the inconvenience.$"}
text:TrainerHill_Entrance.ThankYouForPlaying	{'body': 'Thank you for playing!$'}
text:TrainerHill_Entrance.ExplainTrainerHill	{'body': 'Here at the TRAINER HILL, we conduct\\nan event called the Time Attack.\\pIt is a race that measures how long\\nyou take to reach our owner on\\lthe rooftop from this counter.\\pThe fastest times are posted on\\nthe Time Board--try competing with\\lyour friends.\\pIn TRAINER battles along the way,\\nneither Exp. Points nor money will\\lbe awarded.$'}
text:TrainerHill_Entrance.NeedAtLeastTwoPokemon	{'body': "Oh, I'm sorry, but you appear to have\\nonly one POKéMON with you.\\pYou will need at least two POKéMON\\nto enter this event.$"}
text:TrainerHill_Roof_YouFinallyCameBravo	{'body': "Hm! Hm!\\pYou finally came!\\nYes, you have arrived!\\pWait! Don't say it!\\nI know why you came all the way\\lhere by yourself!\\pYou wanted to see me, the owner\\nof the TRAINER HILL, because…\\pYou want to form a tag team with me!\\nWa-hoo!\\p…Uh?\\nThat's not it?\\pAnyway, I watched you on your way up.\\nMarvelous battling! Bravo, indeed!$"}
text:TrainerHill_Roof_HaveTheMostMarvelousGift	{'body': 'For a marvelous someone like you,\\nI have the most marvelous gift!$'}
text:TrainerHill_Roof_FullUpBeBackLaterForThis	{'body': "Oh, no, full up with things!\\nYou'll be back later for this!$"}
text:TrainerHill_Roof_GotHereMarvelouslyQuickly	{'body': "Oh, hold on here! Did you possibly get\\nhere marvelously quickly?\\pHow splendid! You needn't have\\nhurried so to see me!\\pThat is so delightful. I'll have the Time\\nBoard at the reception updated!$"}
text:TrainerHill_Roof_YouWerentVeryQuick	{'body': "But, oh…\\nYou weren't very quick getting here.$"}
text:TrainerHill_Roof_ArriveZippierNextTime	{'body': 'Perhaps it would please me more if you\\narrived zippier next time.\\pThen, I should be pleased to form\\na tag team with you!\\pUntil we meet again, amigo!$'}
text:TrainerHill_Roof_BuiltTrainerHillToFindPartner	{'body': 'I had the TRAINER HILL built for but\\none reason and one only!\\pTo find the most suitable partner\\nwith whom I may form a tag team!$'}
text:TrainerHill_Entrance.ChallengeTime	{'body': '{STR_VAR_1} min. {STR_VAR_2}.{STR_VAR_3} sec.$'}
text:TrainerHill_Entrance.WhatSortOfTrainersAreAhead	{'body': "Who knows what sort of TRAINERS\\nand POKéMON combos are ahead?\\pAll I know is that I'll knock aside\\nanyone that stands in my way!$"}
text:TrainerHill_Entrance.CantWaitToTestTheWaters	{'body': "I heard tough TRAINERS come to this\\nTRAINER HILL from all over.\\pI can't wait to test the waters!\\pI'll knock aside anyone that stands\\nin my way!$"}
text:TrainerHill_Entrance.FriendsTryingToReachTimeBoardTop	{'body': 'Do you see the Time Board over there?\\pMy friends and I are trying to see who\\ncan reach the top in the least time.$'}
text:TrainerHill_Entrance.DoYouKnowWhenTheyOpen	{'body': "Do you know when they're opening\\nthis place up?\\pI'm waiting here to be the first\\nchallenger ever!$"}
text:TrainerHill_Elevator_ReturnToReception	{'body': 'Would you like to return to\\nthe reception counter?$'}
text:TrainerHill_Roof.NotCompleted	{'body': "Finish every floor's DOUBLE BATTLE\\nin a current challenge first.$"}
text:TrainerTower_Lobby_WelcomeToTrainerTower	{'body': 'Hello!\\pWelcome to TRAINER TOWER where\\nTRAINERS gather from all over!$'}
text:TrainerTower_Lobby_TrainersUpToFloorNum	{'body': 'TRAINERS from all over the world\\ngather here to battle.\\pLet me see…\\pRight now, there are TRAINERS only\\nup to Floor {STR_VAR_1}.$'}
text:TrainerTower_Lobby_TrainersUpEighthFloor	{'body': 'TRAINERS are awaiting your\\nchallenge up to the eighth floor.$'}
text:TrainerTower_Lobby_LikeToChallengeTrainers	{'body': 'Would you like to challenge the\\nwaiting TRAINERS?$'}
text:TrainerTower_Lobby_StartClockGetSetGo	{'body': "Okay, I'll get the clock started,\\nso give it everything you have.\\pOn your marks…\\pGet set…\\pGo!$"}
text:TrainerTower_Lobby_PleaseVisitUsAgain	{'body': 'Please do visit us again!$'}
text:TrainerTower_Lobby_TooBadComeBackTryAgain	{'body': 'That was too bad.\\pI think you put in a tremendous\\neffort in your battling.\\pPlease come back and try again!$'}
text:TrainerTower_Lobby_GiveItYourBest	{'body': 'I hope you give it your best.$'}
text:TrainerTower_Lobby_MoveCounterHereWhenTrainersSwitch	{'body': "When the TRAINERS switch places,\\nthe movement can be hectic.\\pTo avoid the stampede, we moved\\nthe reception counter here.\\pI'm sorry for the inconvenience.$"}
text:TrainerTower_Roof_ImOwnerBattledPerfectly	{'body': "Hello…\\pI am the owner of this TOWER…\\pHow the sky soars above this\\nrooftop…\\pThe caress of the winds up here…\\pIt's all so perfect…\\pThe way you battled…\\nIt, too, was perfection…$"}
text:TrainerTower_Roof_ThisIsForYou	{'body': 'This is for you…$'}
text:TrainerTower_Roof_DoneItInRecordTime	{'body': "Oh!\\nStupendous!\\pIt's marvelous how you've come up\\nhere so quickly.\\pThe fact is, you've done it in\\nrecord time…\\pI'll have your record posted at\\nthe reception counter.$"}
text:TrainerTower_Roof_TookSweetTimeGettingHere	{'body': 'You seem to have taken your sweet\\ntime getting here…$'}
text:TrainerTower_Roof_IdLikeToSeeBetterTime	{'body': "What I would like to see is a\\nbetter time out of you…\\pI'm counting on you.\\pUntil then, farewell…$"}
text:TrainerTower_XMinYZSec	{'body': '{STR_VAR_1} min. {STR_VAR_2}.{STR_VAR_3} sec.$'}
text:TrainerTower_Lobby_HereAreTheResults	{'body': 'せいせきひょうです$'}
text:TrainerTower_Lobby_NeedTwoMonsForDouble	{'body': 'This is a two-on-two battle.\\pYou may not battle unless you have\\nat least two POKéMON.$'}
text:TrainerTower_Lobby_ExplainTrainerTower	{'body': 'Here at TRAINER TOWER, there is an\\nevent called TIME ATTACK.\\pYou will be timed on how quickly\\nyou can get from the reception\\lcounter to the OWNER on the roof.\\pThe best times will be recorded on\\nthe Time Board.\\pTry competing with friends to see\\nwho can beat it the fastest.\\pYou will not earn any EXP. Points\\nor money by beating TRAINERS here.$'}
text:TrainerTower_Lobby_ThanksForCompeting	{'body': 'Thank you for competing!$'}
text:TrainerTower_Lobby_WonderWhatKindsOfTrainers	{'body': "I'm here to see how good I am.\\pI wonder what kinds of TRAINERS\\nare waiting for me?\\pIt's nerve-racking!$"}
text:TrainerTower_Lobby_StairsTougherThanAnyBattle	{'body': "Gasp, gasp…\\nGasp…\\pNever mind battling! These stairs…\\nThey're tougher than any battle…$"}
text:UltimateMoveThatMon	{'body': 'I perfected the ultimate move of\\nits type…\\pBut will no one take it for\\nfuture use?\\p…Hm? Hmmm!\\pY-you…\\nTh-that {STR_VAR_1}…$'}
text:JustMistaken	{'body': '…No…\\nI was just mistaken.$'}
text:AllowMeToTeachMonUltimateMove	{'body': 'Oh! This is the one!\\nThis is the POKéMON!\\pThis {STR_VAR_1} is worthy of\\nlearning my ultimate move!\\pWill you allow it?\\pWill you allow your {STR_VAR_1} to\\nlearn my {STR_VAR_2}?$'}
text:YouRejectIt	{'body': "Gaah! You reject it?\\nNo, I won't be dissuaded!$"}
text:LetMeConferUltimateMove	{'body': 'You will allow it?\\pThen, let me confer my ultimate\\n{STR_VAR_2} on your {STR_VAR_1}.\\pGgggrah-awooo!$'}
text:TaughtMove	{'body': "Gasp, gasp, gasp…\\pI didn't think I could teach that\\nmove while I still lived…$"}
text:MakeBestUseOfMove	{'body': 'I implore you to make the best\\nuse of that move and gain power!$'}
text:PassedOnEverythingIKnow	{'body': "Gasp, gasp, gasp…\\pI have no regrets now.\\nI've passed on everything I know.\\pNow I can live out my life knowing\\nmy work is done.$"}
text:FeelRejuvenated	{'body': 'After I passed on my knowledge to\\nyou, I felt so much relief.\\pIn fact, I feel rejuvenated,\\nas if I were younger again!$'}
text:TwoIsland_IslandSign	{'body': 'TWO ISLAND\\nBoon Island for Two$'}
text:TwoIsland_JoyfulGameCornerSign	{'body': 'Skip & Chomp!\\nJoyful GAME CORNER$'}
text:TwoIsland_DangerFastCurrent	{'body': 'DANGER! FAST CURRENT!\\nFishing and surfing prohibited!$'}
text:TwoIsland_WelcomeToShopMerchandiseLimited	{'body': "Oh!\\nHello, welcome to my shop!\\pWe've only opened up recently.\\pOur merchandise is limited, but I\\nhope we can serve your needs.$"}
text:TwoIsland_AddedMerchandiseForLostelle	{'body': "I can't tell you how grateful I am\\nfor your rescue of LOSTELLE.\\pThanks to your feat, the people of\\nTHREE ISLAND have changed their\\lattitudes about KANTO people.\\pAnd, I'm from KANTO, you see.\\pThe people of THREE ISLAND\\nhelped me add to my merchandise.$"}
text:TwoIsland_HopeYouGiveItYourBest	{'body': "Hi! I'm giving it my best here.\\nI hope you do too, {PLAYER}.$"}
text:TwoIsland_BringingItemsFromDistantLands	{'body': "Oh, hello, {PLAYER}!\\nWelcome!\\pI've started bringing in items from\\ndistant lands.\\pI've got some rare items in, too.\\nPlease have a look!$"}
text:TwoIsland_FellowMovedFromCeladonCity	{'body': 'That fellow there, he moved here\\nfrom CELADON CITY.\\pHe started up a shop with his\\nyounger brother.\\pYou have to wonder if he knew what\\nhe was getting into.$'}
text:TwoIsland_ShopkeepersBrotherWorksGameCorner	{'body': "The shopkeeper's brother took\\na job at the GAME CORNER.\\pHe's trying to pull together money\\nso they can buy more merchandise.$"}
text:TwoIsland_BrunoCameToIslandWhileBack	{'body': "Listen, listen.\\nDid you know?\\pA famous TRAINER came to the\\nISLAND a little while back.\\pHe's one of the ELITE FOUR.\\nHis name is BRUNO.\\pHe went away disappointed when he\\nfound out that they were all sold\\lout of Rage Candybars.$"}
text:TwoIsland_BuyRareItemsHere	{'body': 'The discerning TRAINER knows to\\nbuy rare items here!$'}
text:TwoIsland_OldWomanLivesOutOnCape	{'body': "There's an old woman who lives in\\na cottage out on the cape.\\pShe gives the eye to POKéMON.\\nIt's a bit unnerving.$"}
text:TwoIsland_HaveYouTriedJumpingGame	{'body': 'Boing! Boing!\\nHave you tried the jumping game?\\pThe POKéMON you can enter…\\nBoing!\\pSome go boing!\\pAnd some go boooooooing!\\pDid you know that?\\nBoing!$'}
text:TwoIsland_House_TeachMonMoveForMushroom	{'body': "I'm the POKéMON MOVE MANIAC.\\pI know every single move that\\nPOKéMON learn growing up.\\pI'm also a mushroom maniac.\\pBring me two TINYMUSHROOMS,\\nor one BIG MUSHROOM.\\pIf you do that for me, I'll teach\\na move to one POKéMON.$"}
text:TwoIsland_House_WantMeToTeachMove	{'body': 'Sniff, sniff…\\nHm! You smell of MUSHROOMS!\\pDo you want me to teach a move\\nto a POKéMON of yours?$'}
text:TwoIsland_House_TutorWhichMon	{'body': 'Which POKéMON needs tutoring?$'}
text:TwoIsland_House_TeachWhichMove	{'body': 'Which move should I teach?$'}
text:TwoIsland_House_NoMoveICanTeachThatMon	{'body': "Sorry…\\pIt doesn't appear as if I have a\\nmove I can teach that POKéMON.$"}
text:TwoIsland_House_IllNeedMushroomOrTwo	{'body': "Then, I'll need a MUSHROOM or two.\\nWhat are you going to give me?$"}
text:TwoIsland_House_HandedOverTwoTinyMushrooms	{'body': '{PLAYER} handed over two\\nTINYMUSHROOMS in exchange.$'}
text:TwoIsland_House_HandedOverOneBigMushroom	{'body': '{PLAYER} handed over one\\nBIG MUSHROOM in exchange.$'}
text:TwoIsland_House_NeedMushroomOrTwoToLearnMove	{'body': 'If your POKéMON need to learn a\\nmove, I need a MUSHROOM or two.$'}
text:TwoIsland_House_CantTeachAnEgg	{'body': "Hunh? There isn't a single move\\nthat I can teach an EGG.$"}
text:TwoIsland_JoyfulGameCorner_WhereHasLostelleGottenTo	{'body': "Now, where's LOSTELLE gotten to\\ntoday?\\pShe always brings me lunch every\\nday right about now…$"}
text:TwoIsland_JoyfulGameCorner_PleaseHelpFindLostelle	{'body': "Hm? You, there!\\nAre you a friend of LOSTELLE's?\\pHave you seen LOSTELLE around?\\nI don't know where she might be.\\lShe should've been here long ago.\\pLOSTELLE's a cutie - she got my\\nlooks - so what if someone…\\pWhat if something's happened to\\nmy LOSTELLE?!\\pPlease, help me find her!\\nPlease go search THREE ISLAND!$"}
text:TwoIsland_JoyfulGameCorner_IsThisOnlyThreeIsland	{'body': "Hah? What is this GAME CORNER?\\nHow much sadder can this get?\\pThose clowns…\\pThey said they'd be waiting on the\\nisland, so where are they?\\pHey, you! Is this the only THREE\\nISLAND around here?$"}
text:TwoIsland_JoyfulGameCorner_ThisIsTwoIslandMoveIt	{'body': 'Try waking up before you crawl out\\nof bed, you punk.\\pThis is TWO ISLAND!\\pMove it! Get your filthy motorbike\\nout of my place!$'}
text:TwoIsland_JoyfulGameCorner_TheseIslandsAreConfusing	{'body': 'Huh…\\nOh, oh, gotcha.\\pTch…\\nThese islands are confusing…$'}
text:TwoIsland_JoyfulGameCorner_PunkScuffedUpMyFloor	{'body': 'Would you look at that?\\nThat punk scuffed up my floor.$'}
text:TwoIsland_JoyfulGameCorner_PleaseGoToThreeIsland	{'body': "Hey, but listen! I'm begging you,\\nyou have to go to THREE ISLAND.\\pIf anything were to happen to my\\nLOSTELLE…\\pMy place is the house with the red\\nroof on THREE ISLAND.\\pShe may just show up late here,\\nso I can't run off anywhere.\\pThat's why I have to get you to do\\nme this big favor.$"}
text:TwoIsland_JoyfulGameCorner_NotRunningAnyGamesToday	{'body': "I'm sorry.\\nWe're not running any games today.$"}
text:TwoIsland_JoyfulGameCorner_GetGamesGoingSoon	{'body': "We'll get the games going soon\\nfor you!$"}
text:TwoIsland_JoyfulGameCorner_YouRescuedLostelle	{'body': "So you rescued LOSTELLE?\\nHow can I thank you?\\pLOSTELLE, darling, forgive me!\\pDaddy didn't know you were scared\\nand in trouble!$"}
text:TwoIsland_JoyfulGameCorner_LostelleItsOkayDaddy	{'body': "LOSTELLE: It's okay, Daddy.\\nI got to be friends with {PLAYER}!$"}
text:TwoIsland_JoyfulGameCorner_ThisIsForMe	{'body': "Oh, what's that?\\nYou're saying that this is for me?\\pHow did you know that I love rare\\nrocks and gems?\\pYou sure know how to make a guy\\nhappy.$"}
text:TwoIsland_JoyfulGameCorner_HandedMeteoriteToLostellesDaddy	{'body': "{PLAYER} handed the METEORITE\\nto LOSTELLE's daddy.$"}
text:TwoIsland_JoyfulGameCorner_OhThisIsFromBill	{'body': "Oh, I see, this is from BILL!\\nYou have to thank him for me!\\pYou know, you've been fantastic.\\nI want you to have this.$"}
text:TwoIsland_JoyfulGameCorner_ReceivedMoonStoneFromLostellesDaddy	{'body': "{PLAYER} received a MOON STONE\\nfrom LOSTELLE's daddy.$"}
text:TwoIsland_JoyfulGameCorner_NotGoingToFitInBag	{'body': "Your BAG's not going to fit another\\nthing…$"}
text:TwoIsland_JoyfulGameCorner_IllGetGameCornerRunning	{'body': "All right, I'll get the GAME CORNER\\nrunning right away.\\pYou have to come visit with a\\nfriend.$"}
text:TwoIsland_JoyfulGameCorner_PleaseShowMeYouBeingCool	{'body': 'Listen, listen!\\pPlease show me you being cool\\nagain!$'}
text:TwoIsland_PokemonCenter_1F_HaveYouVisitedGameCorner	{'body': "Have you visited the GAME CORNER\\nalready?\\pIt's no good to go alone.\\nYou have to take a friend along.$"}
text:TwoIsland_PokemonCenter_1F_OldLadyLivesOutOnCape	{'body': "Not many people live on\\nTWO ISLAND.\\pThere is this old lady who lives\\nout on the cape.\\pShe's been there since I don't know\\nwhen.$"}
text:UndergroundPath_EastEntrance_DoYouGoToCeladonDeptStore	{'body': 'The DEPARTMENT STORE in CELADON\\nhas a great selection.\\pDo you go there very often?$'}
text:UndergroundPath_SouthEntrance_PeopleLoseThingsInTheDarkness	{'body': 'People often lose things in the\\ndarkness of the UNDERGROUND PATH.$'}
text:UndergroundPath_WestEntrance_SleepyMonNearCeladon	{'body': 'I heard a sleepy POKéMON appeared\\nout near CELADON CITY, too.$'}
text:Underwater_SeafloorCavern.SubExplorer1	{'body': '“SUBMARINE EXPLORER 1” is painted\\non the hull.\\pThis is the submarine TEAM AQUA\\nstole in SLATEPORT!\\pTEAM AQUA must have gone\\nashore here.$'}
text:VerdanturfMeadow.Warden	{'body': 'DEERLING graze among these flowers.\\nThey evolve into SAWSBUCK at Lv. 34.\\pA SUN STONE used on PETILIL in this\\nmeadow yields Hisuian LILLIGANT.\\lUse it elsewhere for the usual form.$'}
text:VerdanturfTown.ManTryingToDigTunnel	{'body': "My papa told me.\\pHe says this tunnel is full of\\ntimid POKéMON.\\pThey get all scared of loud noise and\\nmake a big uproar.\\pSo they had to stop the big tunnel\\nproject.\\pBut there's one man. He's trying to dig\\nthe tunnel by himself!$"}
text:VerdanturfTown.ManDugTunnelForLove	{'body': "There was a man who dug a tunnel for\\na lady he loved.\\pI don't really get it, but hey!$"}
text:VerdanturfTown.AirCleanHere	{'body': 'The way the winds blow, volcanic ash\\nis never blown in this direction.\\pThe air is clean and delicious here.\\nLiving here should do wonders for even\\lfrail and sickly people.$'}
text:VerdanturfTown.MakeBattleTentDebut	{'body': "My POKéMON and I, we've been riding\\na hot winning streak.\\pSo I decided to make my BATTLE TENT\\ndebut in this town.$"}
text:VerdanturfTown.GuyTryingToBustThroughCave	{'body': "Did you see the cave next to the\\nPOKéMON MART?\\pThere's a guy in there who's trying to\\nbust up boulders so he can bust out\\lthrough to the other side.\\pIt'd be great if we could go through…\\nIt'll make it easy to visit RUSTBORO.$"}
text:VerdanturfTown.EasyToGetToRustboroNow	{'body': "That cave next to the POKéMON MART\\nis now a tunnel to the other side.\\pIt's great--it's easy to go shop for\\nnew DEVON products in RUSTBORO now.$"}
text:VerdanturfTown.TownSign	{'body': 'VERDANTURF TOWN\\pThe windswept highlands where\\ngrass and people recover after\\levery storm.\\pA restored meadow lies to the\\nsouth.$'}
text:VerdanturfTown.WandasHouse	{'body': "WANDA'S HOUSE$"}
text:VerdanturfTown.BattleTentSign	{'body': 'BATTLE TENT VERDANTURF SITE\\n“Feast Your Eyes on Battles!”$'}
text:VerdanturfTown.RusturfTunnelSign	{'body': 'RUSTURF TUNNEL\\n“Linking RUSTBORO and VERDANTURF\\p“The tunnel project has been\\ncanceled.”$'}
text:VerdanturfTown_ContestHall_WhichContestYouEntering	{'body': "Which CONTEST are you entering?\\nWant a piece of advice?\\pIn any CONTEST, for example, a CUTE\\nCONTEST, I don't think they judge you\\lonly on cuteness in the first round.\\pYou need to work out ways for raising\\nPOKéMON better.$"}
text:VerdanturfTown_ContestHall_RaisedMonToBeCute	{'body': "I raised my POKéMON to be cute.\\pI found out you can put POKéMON in\\na CONTEST for cuteness!\\pI'm so glad I raised my POKéMON with\\nloving care…$"}
text:VerdanturfTown_ContestHall_MyMonRules	{'body': "My POKéMON rules!\\pIt's cool, tough yet beautiful, cute,\\nand smart. It's complete!\\pI may as well go for wins in every\\nsingle CONTEST.$"}
text:VerdanturfTown_ContestHall_NormalRankStage	{'body': 'POKéMON CONTESTS\\nNORMAL RANK STAGE!$'}
text:VerdanturfTown_BattleTentLobby.MonsReluctantToUseDislikedMoves	{'body': 'Natures change stats, not which\\nmoves your Pokémon will obey.\\pYou command both partners here. A\\nquiet Pokémon can have a very\\laggressive battle set.$'}
text:VerdanturfTown_BattleTentLobby.GentleMonsScaryIfAngry	{'body': "My big sister is gentle usually.\\nBut when she gets angry,\\lshe's really, really scary!\\pI bet a gentle POKéMON will be scary\\nif it gets angry!$"}
text:VerdanturfTown_BattleTentLobby.AttractionRunsDeep	{'body': 'My feelings toward my POKéMON…\\nThe attraction runs deep…\\pOh, hi! A bond like yours deserves\\nthis SHINY STONE.$'}
text:VerdanturfTown_BattleTentLobby.AttractionMutual	{'body': "My feelings toward my POKéMON…\\nI'm sure the attraction is mutual!\\pThey battle exactly the way I want\\nthem to!$"}
text:VerdanturfTown_BattleTentLobby.TaughtWhatKindsOfMoves	{'body': 'What kind of moves have you taught\\nyour POKéMON?\\pI think you would give yourself\\nan advantage if they knew how to\\lheal or protect themselves.$'}
text:VerdanturfTown_BattleTentLobby.ScottCanMeetToughTrainers	{'body': "SCOTT: Hey there, {PLAYER}{KUN}!\\nI thought I might see you here.\\pA BATTLE TENT's a place where\\nyou can meet tough TRAINERS.\\pIt doesn't matter what the rules are,\\nor how battles are waged, either.\\p{PLAYER}{KUN}, I expect you to do\\nthe best you can!$"}
text:VerdanturfTown_BattleTentLobby.ScottVisitRegularly	{'body': 'SCOTT: I visit here regularly in hopes\\nof seeing tough TRAINERS in action\\lin whatever the situation.$'}
text:VerdanturfTown_BattleTentLobby.ExhibitionWelcome	{'body': 'Bring a team that supports each\\npartner through a hard match.\\pThis is a six-Pokémon doubles\\nexhibition. You command every move\\land switch.\\pYour team uses the current cap.\\nDifficulty sets opponent levels.\\lEnter with six healthy partners?$'}
text:VerdanturfTown_BattleTentLobby.ExhibitionRules	{'body': 'LOCAL DOUBLES EXHIBITIONS\\pBring six healthy Pokémon, with no\\nEggs. Prepare freely before\\lentering.\\pThree victories earn one local\\nprize. Your party is restored\\lafter each exhibition.\\pThese results are separate from\\nthe CHAMPIONS CIRCUIT. You return\\lto this lobby afterward.$'}
text:VerdanturfTown_FriendshipRatersHouse.TradeHappiny	{'body': 'This {STR_VAR_2} needs a caring\\nTRAINER. Trade a {STR_VAR_1} for it?$'}
text:VerdanturfTown_FriendshipRatersHouse.TradeComplete	{'body': 'Thank you. Friendship is the best\\ntraining CHANSEY can receive.$'}
text:VerdanturfTown_FriendshipRatersHouse.TradeDeclined	{'body': "That's all right. A trade should never\\nbe rushed.$"}
text:VerdanturfTown_FriendshipRatersHouse.NeedRequestedMon	{'body': "That isn't a {STR_VAR_1}. Please bring\\nthe partner we discussed.$"}
text:VerdanturfTown_FriendshipRatersHouse.HappinyDoingWell	{'body': 'CHANSEY and DITTO at the DAY CARE\\ncan have a HAPPINY EGG.$'}
text:VerdanturfTown_FriendshipRatersHouse.SeeHowMuchPokemonLikesYou	{'body': "Let me see your POKéMON.\\nI'll check to see how much it likes you.\\pOh.\\nYour POKéMON…$"}
text:VerdanturfTown_FriendshipRatersHouse.AdoresYou	{'body': "It adores you.\\nIt can't possibly love you any more.\\lI even feel happy seeing it.$"}
text:VerdanturfTown_FriendshipRatersHouse.VeryHappy	{'body': 'It seems to be very happy.\\nIt obviously likes you a whole lot.$'}
text:VerdanturfTown_FriendshipRatersHouse.LikesYouQuiteALot	{'body': 'It likes you quite a lot.\\nIt seems to want to be babied a little.$'}
text:VerdanturfTown_FriendshipRatersHouse.GettingUsedToYou	{'body': "It's getting used to you.\\nIt seems to believe in you.$"}
text:VerdanturfTown_FriendshipRatersHouse.NotUsedToYou	{'body': "It's not very used to you yet.\\nIt neither loves nor hates you.$"}
text:VerdanturfTown_FriendshipRatersHouse.VeryWary	{'body': "It's very wary.\\nIt has scary viciousness in its eyes.\\lIt doesn't like you much at all.$"}
text:VerdanturfTown_FriendshipRatersHouse.DetestsYou	{'body': "This is a little hard for me to say…\\pYour POKéMON simply detests you.\\nDoesn't that make you uncomfortable?$"}
text:VerdanturfTown_FriendshipRatersHouse.Pikachu	{'body': 'PIKACHU: Pika pika!$'}
text:VerdanturfTown_FriendshipRatersHouse.MegaGift_RAICHUNITE_X_Text	{'body': 'A little Pichu can grow into\\na wonderful traveling companion.\\pThis stone is for a Raichu.\\nFriendship is where it all begins.$'}
text:VerdanturfTown_House.TrainersGatherAtPokemonLeague	{'body': 'Far away, deep in EVER GRANDE CITY,\\nis the POKéMON LEAGUE.\\pThe TRAINERS who gather there are\\nall frighteningly well skilled.$'}
text:VerdanturfTown_House.DefeatEliteFourInARow	{'body': "The ELITE FOUR face challengers\\none after another, with the\\lCHAMPION waiting beyond them.\\pImagine standing at that first\\ndoor! I'd need a moment to catch\\lmy breath.$"}
text:VerdanturfTown_House.MegaGift_GALLADITE_Text	{'body': 'Strength can be quiet. A Gallade\\nuses its blades to protect others.\\pI think this stone belongs with\\nsomeone who understands that.$'}
text:VerdanturfTown_Mart.MoveSpecialist	{'body': 'I used to reward patient POKéMON\\nwith the move PAYBACK.\\pThe CENTER specialist teaches it now\\nwhenever the species can learn it.$'}
text:VerdanturfTown_Mart.LuxuryBallBuildsFriendship	{'body': 'A LUXURY BALL helps a caught POKéMON\\ngrow friendly more quickly.\\pThe right Ball can make team building\\nfeel like part of the adventure.$'}
text:VerdanturfTown_Mart.NoStrategyGuidesForBattleTent	{'body': "They don't seem to sell any winning\\nstrategy guides for the BATTLE TENT…\\pIt seems one must rely on one's\\nown wits after all…$"}
text:VerdanturfTown_Mart.NestBallOnLowerLevelPokemon	{'body': 'The NEST BALL works better on\\nlower-level wild POKéMON.\\pIt is one of several specialty BALLS\\nsold around HOENN.$'}
text:VerdanturfTown_PokemonCenter_1F.FaithInYourPokemon	{'body': "You can't consider yourself a real\\nTRAINER if you don't have faith\\lin your POKéMON.\\pOnly those people who can believe\\nin their battling POKéMON can win\\lthrough to the very end.$"}
text:VerdanturfTown_PokemonCenter_1F.VisitForBattleTent	{'body': "The reason why anyone would visit\\nVERDANTURF…\\pIt's the BATTLE TENT. It goes without\\nsaying.\\pOr is there somebody here that you\\ncame to see?$"}
text:VerdanturfTown_WandasHouse.StrongerSpeech	{'body': "WALLY: I lost to you, {PLAYER}, but I'm\\nnot feeling down anymore.\\pBecause I have a new purpose in life.\\nTogether with my KIRLIA, I'm going\\lto challenge POKéMON GYMS and become\\la great TRAINER.\\pPlease watch me, {PLAYER}.\\nI'm going to be stronger than you.\\pWhen I do, I'm going to challenge you\\nto another battle.$"}
text:VerdanturfTown_WandasHouse.StrongerSpeechShort	{'body': "WALLY: Please watch me, {PLAYER}.\\nI'm going to get stronger than you.\\pWhen I do, I'm going to challenge you\\nto another battle.$"}
text:VerdanturfTown_WandasHouse.WallysNextDoor	{'body': "UNCLE: Oh! {PLAYER}{KUN}!\\nWALLY's next door.\\pBut, boy, there's something I have to\\ntell you.\\pThis natural environment is doing\\nwonders for WALLY's health.\\pMaybe it's not just the environment.\\nIt could be POKéMON that are giving\\lthe boy hope.$"}
text:VerdanturfTown_WandasHouse.WallySlippedOff	{'body': "WALLY's gone away…\\nHe slipped off on his own…$"}
text:VerdanturfTown_WandasHouse.WallyGoneThatFar	{'body': "UNCLE: Is that right?\\nWALLY's gone away that far all by\\lhimself…\\pWell, I have to give him credit--he is\\nmy little brother's son.$"}
text:VerdanturfTown_WandasHouse.MeetWanda	{'body': "WANDA: You are?\\nOh, right, I get it!\\pYou're the {PLAYER} who WALLY was\\ntelling me about.\\pI'm WALLY's cousin.\\nGlad to meet you!\\pI think WALLY's become a lot more lively\\nand healthy since he came here.$"}
text:VerdanturfTown_WandasHouse.DontWorryAboutWally	{'body': "WANDA: Don't worry about WALLY.\\nHe'll be just fine.\\pI know my little cousin, and he has\\nPOKéMON with him, too.$"}
text:VerdanturfTown_WandasHouse.CanSeeGirlfriendEveryDay	{'body': 'Thanks to you, I can see my girlfriend\\nevery day.\\lHappy? You bet I am!$'}
text:VerdanturfTown_WandasHouse.DaughtersBoyfriendDriven	{'body': "My daughter's boyfriend is a very\\ndriven and passionate sort of person.\\pHe's been digging a tunnel nonstop\\njust so he can see my daughter.\\pMy daughter's a little concerned,\\nso she goes out to the tunnel a lot.$"}
text:VerdanturfTown_WandasHouse.DaughtersBoyfriendWasDigging	{'body': "It's amazing. My daughter's boyfriend\\nwas digging the tunnel by hand!\\pIt's so incredible!$"}
text:VerdanturfTown_WandasHouse.IfAnythingHappenedToWally	{'body': 'If anything were to happen to WALLY,\\nI would never be able to look his\\lparents in PETALBURG in the eye…$'}
text:VerdanturfTown_WandasHouse.WallyWasInEverGrande	{'body': 'WALLY was in EVER GRANDE?\\pHis parents in PETALBURG would be\\nastonished to hear that!$'}
text:VerdanturfTown_WandasHouse.MegaGift_GARDEVOIRITE_Text	{'body': 'Wally and his partner have given\\neach other the courage to grow.\\pIf you raise a Gardevoir, this\\nstone can deepen that partnership.$'}
text:VermilionCity_GrimerMultipliesInSludge	{'body': "We're careful about pollution here.\\pWe've heard GRIMER multiplies in\\ntoxic sludge.$"}
text:VermilionCity_DidYouSeeSSAnneInHarbor	{'body': 'Did you see the S.S. ANNE moored\\nin the harbor?$'}
text:VermilionCity_SSAnneHasDepartedForYear	{'body': "So, the S.S. ANNE has departed?\\pShe'll be back in VERMILION about\\nthis time next year.$"}
text:VermilionCity_BuildingOnThisLand	{'body': "I'm putting up a building on this\\nplot of land. I own it all.\\pMy POKéMON is tamping the land\\nto lay the foundation.$"}
text:VermilionCity_Machop	{'body': 'MACHOP: Guoh! Gogogoh!$'}
text:VermilionCity_MachopStompingLandFlat	{'body': 'A MACHOP is stomping the land flat.$'}
text:VermilionCity_SSAnneVisitsOnceAYear	{'body': 'The S.S. ANNE is a famous luxury\\ncruise ship.\\pIt visits VERMILION once a year.$'}
text:VermilionCity_CitySign	{'body': 'VERMILION CITY\\nThe Port of Exquisite Sunsets$'}
text:VermilionCity_SnorlaxBlockingRoute12	{'body': 'NOTICE!\\pROUTE 12 may be blocked off by a\\nsleeping POKéMON.\\pDetour through ROCK TUNNEL to\\nLAVENDER TOWN.\\pVERMILION POLICE$'}
text:VermilionCity_PokemonFanClubSign	{'body': 'POKéMON FAN CLUB\\nAll POKéMON fans welcome!$'}
text:VermilionCity_GymSign	{'body': 'VERMILION CITY POKéMON GYM\\nLEADER: LT. SURGE\\lThe Lightning American!$'}
text:VermilionCity_VermilionHarbor	{'body': 'VERMILION HARBOR$'}
text:VermilionCity_WelcomeToTheSSAnne	{'body': 'Welcome to the S.S. ANNE!$'}
text:VermilionCity_DoYouHaveATicket	{'body': 'Welcome to the S.S. ANNE!\\pExcuse me, do you have a ticket?$'}
text:VermilionCity_FlashedSSTicket	{'body': '{FONT_NORMAL}{PLAYER} flashed the S.S. TICKET!\\p{FONT_MALE}Great!\\nWelcome to the S.S. ANNE!$'}
text:VermilionCity_DontHaveNeededSSTicket	{'body': "{FONT_NORMAL}{PLAYER} doesn't have the needed\\nS.S. TICKET.\\p{FONT_MALE}Sorry!\\pYou need a ticket to get aboard.$"}
text:VermilionCity_TheShipSetSail	{'body': 'The ship set sail.$'}
text:VermilionCity_BoardSeagallopTriPass	{'body': 'Ah, you have a TRI-PASS.\\pWould you like to board\\na SEAGALLOP ferry?$'}
text:VermilionCity_Seagallop7Departing	{'body': "Okay, everything's in order.\\pSEAGALLOP HI-SPEED 7 will be\\ndeparting immediately.$"}
text:VermilionCity_BoardSeagallopRainbowPass	{'body': 'Ah, you have a RAINBOW PASS.\\pWould you like to board\\na SEAGALLOP ferry?$'}
text:VermilionCity_OhMysticTicketTakeYouToNavelRock	{'body': "Oh! That's a MYSTICTICKET!\\nNow that is rare.\\pWe'll be happy to take you to\\nNAVEL ROCK anytime.$"}
text:VermilionCity_OhAuroraTicketTakeYouToBirthIsland	{'body': "Oh! That's an AURORATICKET!\\nNow that is rare.\\pWe'll be happy to take you to\\nBIRTH ISLAND anytime.$"}
text:VermilionCity_BoardSeagallopFerry	{'body': 'Would you like to board\\na SEAGALLOP ferry?$'}
text:VermilionCity_Seagallop10Departing	{'body': "Okay, everything's in order for you\\nto board a special ferry.\\pSEAGALLOP HI-SPEED 10 will be\\ndeparting immediately.$"}
text:VermilionCity_Seagallop12Departing	{'body': "Okay, everything's in order for you\\nto board a special ferry.\\pSEAGALLOP HI-SPEED 12 will be\\ndeparting immediately.$"}
text:VermilionCity_Route2AideHasPackageForYou	{'body': "Oh, hello, {PLAYER}!\\nHow are you doing?\\pIt's me, one of PROF. OAK's AIDES.\\pDid you meet the other AIDE?\\pHe had a package from PROF. OAK\\nfor you, {PLAYER}.\\pHe said he'd look for you around\\nROUTE 2, {PLAYER}.\\pIf you're in the ROUTE 2 area,\\nplease look for him.$"}
text:VermilionCity_Gym_LtSurgeIntro	{'body': "Hey, kid! What do you think you're\\ndoing here?\\pYou won't live long in combat!\\nNot with your puny power!\\pI tell you, kid, electric POKéMON\\nsaved me during the war!\\pThey zapped my enemies into\\nparalysis!\\pThe same as I'll do to you!{PLAY_BGM}{MUS_RG_ENCOUNTER_GYM_LEADER}$"}
text:VermilionCity_Gym_LtSurgePostBattle	{'body': "A little word of advice, kid!\\pElectricity is sure powerful!\\pBut, it's useless against GROUND-\\ntype POKéMON!$"}
text:VermilionCity_Gym_ExplainThunderBadgeTakeThis	{'body': "The THUNDERBADGE cranks up your\\nPOKéMON's SPEED!\\pIt also lets your POKéMON FLY\\nlightning-quick anytime, kid!\\pYou're special, kid!\\nTake this!$"}
text:VermilionCity_Gym_ReceivedTM34FromLtSurge	{'body': '{PLAYER} received TM34\\nfrom LT. SURGE.$'}
text:VermilionCity_Gym_ExplainTM34	{'body': 'TM34 contains SHOCK WAVE!\\pTeach it to an ELECTRIC POKéMON!$'}
text:VermilionCity_Gym_MakeRoomInYourBag	{'body': 'Yo, kid, make room in your BAG!$'}
text:VermilionCity_Gym_LtSurgeDefeat	{'body': "Now that's a shocker!\\pYou're the real deal, kid!\\pFine, then, take the THUNDERBADGE!$"}
text:VermilionCity_Gym_TuckerIntro	{'body': 'When I was in the Army, LT. SURGE\\nwas my strict CO.\\pHe was a hard taskmaster.$'}
text:VermilionCity_Gym_TuckerDefeat	{'body': "Stop!\\nYou're very good!$"}
text:VermilionCity_Gym_TuckerPostBattle	{'body': "It's not easy opening that door.\\pLT. SURGE was always famous for\\nhis cautious nature in the Army.$"}
text:VermilionCity_Gym_BailyIntro	{'body': "I'm a lightweight, but I'm good\\nwith electricity!\\pThat's why I joined this GYM.$"}
text:VermilionCity_Gym_BailyDefeat	{'body': 'Fried!$'}
text:VermilionCity_Gym_BailyPostBattle	{'body': "Okay, I'll talk!\\pLT. SURGE said he hid door\\nswitches inside something.$"}
text:VermilionCity_Gym_DwayneIntro	{'body': "This is no place for kids!\\nNot even if you're good!$"}
text:VermilionCity_Gym_DwayneDefeat	{'body': 'Wow!\\nSurprised me!$'}
text:VermilionCity_Gym_DwaynePostBattle	{'body': 'LT. SURGE installed the traps in\\nthe GYM himself.\\pHe set up double locks everywhere.\\nLet me give you a hint.\\pWhen you open the first lock, the\\nsecond lock is right next to it.$'}
text:VermilionCity_Gym_GymGuyAdvice	{'body': "Yo!\\nChamp in the making!\\pLT. SURGE has a nickname.\\pPeople refer to him as the\\nLightning American!\\pHe's an expert on electric\\nPOKéMON.\\pBIRD/WATER-type POKéMON match\\npoorly against the ELECTRIC type.\\pBeware of paralysis, too.\\pLT. SURGE is very cautious.\\pHe's locked himself in, so it won't\\nbe easy getting to him.$"}
text:VermilionCity_Gym_GymGuyPostVictory	{'body': 'Whew!\\nThat match was electric!$'}
text:VermilionCity_Gym_GymStatue	{'body': 'VERMILION POKéMON GYM\\nLEADER: LT. SURGE\\pWINNING TRAINERS:\\n{RIVAL}$'}
text:VermilionCity_Gym_GymStatuePlayerWon	{'body': 'VERMILION POKéMON GYM\\nLEADER: LT. SURGE\\pWINNING TRAINERS:\\n{RIVAL}, {PLAYER}$'}
text:VermilionCity_Gym_NopeOnlyTrashHere	{'body': "Nope!\\nThere's only trash here.$"}
text:VermilionCity_Gym_SwitchUnderTrashFirstLockOpened	{'body': "Hey! There's a switch under the\\ntrash! Turn it on!\\pThe first electric lock opened!$"}
text:VermilionCity_Gym_SecondLockOpened	{'body': 'The second electric lock opened!\\nThe motorized door opened!$'}
text:VermilionCity_Gym_OnlyTrashLocksWereReset	{'body': "Nope!\\nThere's only trash here.\\pHey!\\nThe electric locks were reset!$"}
text:VermilionCity_House1_ImFishingGuruDoYouLikeToFish	{'body': "I'm the FISHING GURU!\\pI simply looove fishing!\\nI can't bear to go without.\\pTell me, do you like to fish?$"}
text:VermilionCity_House1_TakeThisAndFish	{'body': 'Grand! I like your style.\\nI think we can be friends.\\pTake this and fish, young friend!$'}
text:VermilionCity_House1_ReceivedOldRodFromFishingGuru	{'body': '{PLAYER} received an OLD ROD from\\nthe FISHING GURU.$'}
text:VermilionCity_House1_FishingIsAWayOfLife	{'body': 'Fishing is a way of life!\\nIt is like the finest poetry.\\pFrom the seas to rivers, go out\\nand land the big one, my friend.$'}
text:VermilionCity_House1_OhThatsSoDisappointing	{'body': "Oh…\\nThat's so disappointing…$"}
text:VermilionCity_House1_HowAreTheFishBiting	{'body': 'Hello there, {PLAYER}!\\pHow are the fish biting?$'}
text:VermilionCity_House1_NoRoomForNiceGift	{'body': 'Oh, no!\\pI had a nice gift for you, but you\\nhave no room for it!$'}
text:VermilionCity_House2_DoYouHaveMonWantToTradeForMyMon	{'body': 'Hi!\\nDo you have a {STR_VAR_1}?\\pWant to trade it for my\\n{STR_VAR_2}?$'}
text:VermilionCity_House2_ThatsTooBad	{'body': "That's too bad.$"}
text:VermilionCity_House2_ThisIsNoMon	{'body': '…This is no {STR_VAR_1}.\\pIf you get one, please trade it\\nto me!$'}
text:VermilionCity_House2_ThankYou	{'body': 'Thank you!$'}
text:VermilionCity_House2_HowIsMyOldMon	{'body': 'How is my old {STR_VAR_2}?\\pMy {STR_VAR_1} is doing great!$'}
text:VermilionCity_House3_PidgeyFlyLetterToSaffron	{'body': "I'm getting my PIDGEY to fly a\\nletter to SAFFRON in the north.$"}
text:VermilionCity_House3_Pidgey	{'body': 'PIDGEY: Kurukkoo!$'}
text:VermilionCity_House3_DearPippiLetter	{'body': 'Dear PIPPI,\\nI hope to see you soon.\\pI heard SAFFRON has problems with\\nTEAM ROCKET.\\pVERMILION appears to be safe.$'}
text:VermilionCity_House3_SendMyPidgeyToUnionRoom	{'body': 'I want to exchange MAIL with all\\nsorts of people.\\pI send my PIDGEY to a UNION ROOM\\nto exchange MAIL for me.$'}
text:VermilionCity_Mart_TeamRocketAreWickedPeople	{'body': "There are wicked people who will\\nuse POKéMON for criminal acts.\\pTEAM ROCKET traffics in rare\\nPOKéMON, for example.\\pThey also abandon POKéMON that\\nthey consider unpopular or useless.\\pThat's the sort of horrid people\\nthey are, TEAM ROCKET.$"}
text:VermilionCity_Mart_MonsGoodOrBadDependingOnTrainer	{'body': 'I think POKéMON can be good or\\nbad. It depends on the TRAINER.$'}
text:VermilionCity_PokemonCenter_1F_TrainerMonsStrongerThanWild	{'body': 'Even if they are the same level,\\nPOKéMON can have very different\\lstats and abilities.\\pA POKéMON raised by a TRAINER is\\nstronger than one in the wild.$'}
text:VermilionCity_PokemonCenter_1F_PoisonedMonFaintedWhileWalking	{'body': 'My POKéMON was poisoned!\\nIt fainted while we were walking!$'}
text:VermilionCity_PokemonCenter_1F_AllMonWeakToSpecificTypes	{'body': 'It is true that a higher-level\\nPOKéMON will be more powerful…\\pBut, all POKéMON will have weak\\npoints against specific types.\\pSo, there appears to be no\\nuniversally strong POKéMON.$'}
text:VermilionCity_PokemonCenter_1F_UrgeToBattleSomeoneAgain	{'body': "The urge to battle with someone\\nyou've tangled with before…\\pHave you ever had that urge?\\nI'm sure you have.\\pI wanted to battle certain people\\nagain over and over, too.\\pSo, I've been giving these away.\\nPlease, take one!$"}
text:VermilionCity_PokemonCenter_1F_UseDeviceForRematches	{'body': "Use that device and you'll find\\nTRAINERS looking for a rematch.\\pYou have to charge its battery to\\nuse it, though.$"}
text:VermilionCity_PokemonCenter_1F_ExplainVSSeeker	{'body': "How do you use the VS SEEKER?\\nThere's nothing to it.\\pUse it like beep-beep-beep, and\\nTRAINERS around you will notice.\\pIf any TRAINER wants a rematch,\\nit will let you know immediately.\\pCharge its battery and use it\\nwhile you're on a road.$"}
text:VermilionCity_PokemonFanClub_AdmirePikachusTail	{'body': "Won't you admire my PIKACHU's\\nadorable tail?$"}
text:VermilionCity_PokemonFanClub_PikachuTwiceAsCute	{'body': 'Humph!\\pMy PIKACHU is twice as cute as\\nthat one!$'}
text:VermilionCity_PokemonFanClub_AdoreMySeel	{'body': "I just adore my SEEL!\\nIt's so lovable!\\pIt squeals, “Kyuuuh,” when I\\nhug it!$"}
text:VermilionCity_PokemonFanClub_SeelFarMoreAttractive	{'body': 'Oh, dear!\\pMy SEEL is far more attractive.\\nBy double, I would say.$'}
text:VermilionCity_PokemonFanClub_Pikachu	{'body': 'PIKACHU: Chu! Pikachu!$'}
text:VermilionCity_PokemonFanClub_Seel	{'body': 'SEEL: Kyuoo!$'}
text:VermilionCity_PokemonFanClub_DidYouComeToHearAboutMyMons	{'body': "I chair the POKéMON Fan Club!\\pI raise more than a hundred\\nPOKéMON!\\pI'm very fussy when it comes to\\nPOKéMON! I surely am!\\pSo…\\pDid you come visit to hear about\\nmy POKéMON?$"}
text:VermilionCity_PokemonFanClub_ChairmansStory	{'body': "Good!\\nThen listen up!\\pMy favorite RAPIDASH…\\pIt's…cute…lovely…smart… \\nplus…amazing…you think so?…\\loh yes…it's…stunning…\\lkindly…love it!\\pHug it…when…sleeping…warm\\nand cuddly…spectacular…\\lravishing…\\l…Oops! Look at the time!\\lI kept you too long!\\pThanks for hearing me out!\\nI want you to have this!$"}
text:VermilionCity_PokemonFanClub_ReceivedBikeVoucherFromChairman	{'body': '{PLAYER} received a BIKE VOUCHER\\nfrom the CHAIRMAN.$'}
text:VermilionCity_PokemonFanClub_ExplainBikeVoucher	{'body': "Take that BIKE VOUCHER to the\\nBIKE SHOP in CERULEAN CITY.\\pExchange that for a BICYCLE\\nfree of charge!\\pDon't worry, my favorite FEAROW\\nwill FLY me anywhere I need to go.\\pSo, I have no need for a BICYCLE.\\pI hope you like cycling!$"}
text:VermilionCity_PokemonFanClub_ComeBackToHearStory	{'body': 'Oh. Come back when you want to\\nhear my story!$'}
text:VermilionCity_PokemonFanClub_DidntComeToSeeAboutMonsAgain	{'body': 'Hello, {PLAYER}!\\pDid you come see me about my\\nPOKéMON again?\\pNo?\\nToo bad!$'}
text:VermilionCity_PokemonFanClub_MakeRoomForThis	{'body': 'Make room for this!$'}
text:VermilionCity_PokemonFanClub_ChairmanVeryVocalAboutPokemon	{'body': 'Our CHAIRMAN is very vocal about\\nPOKéMON.$'}
text:VermilionCity_PokemonFanClub_ListenPolitelyToOtherTrainers	{'body': "Let's all listen politely to other\\nTRAINERS!$"}
text:VermilionCity_PokemonFanClub_SomeoneBragsBragBack	{'body': 'If someone brags, brag right back!$'}
text:VermilionCity_PokemonFanClub_ChairmanReallyAdoresHisMons	{'body': 'Our CHAIRMAN really does adore his\\nPOKéMON.\\pBut the person who is most liked by\\nPOKéMON is DAISY, I think.$'}
text:VictoryRoad_1F.WallyNotGoingToLoseAnymore	{'body': "WALLY: {PLAYER}! I was hoping I'd\\nsee you!\\pWhen we met, I couldn't imagine\\ntraveling this far from home. Now\\llook at us!\\pMy uncle still worries, so I call\\nwhenever I reach a new town.\\pThis time, I want to tell him I\\nwon. Here I come!$"}
text:VictoryRoad_1F.WallyEntranceDefeat	{'body': 'We gave it everything we had…$'}
text:VictoryRoad_1F.WallyPostEntranceBattle	{'body': "WALLY: I wanted to win so badly…\\pBut I'm glad you were here to see\\nhow far we've come. I'll keep\\lgoing, {PLAYER}. You can count on\\lthat!$"}
text:VictoryRoad_1F.WallyIntro	{'body': "WALLY: {PLAYER}! Welcome back!\\pWe've been training since our last\\nbattle. I wanted you to see us!\\pAll right… Here we come!$"}
text:VictoryRoad_1F.WallyDefeat	{'body': 'Still just out of reach…$'}
text:VictoryRoad_1F.WallyPostBattle	{'body': "WALLY: I used to be afraid to\\nlose. Now every battle makes me\\lwant to try again.\\pSomeday, I'll meet you at the\\nLEAGUE. Until then, let's keep\\lhelping each other grow!$"}
text:VictoryRoad_1F.EdgarIntro	{'body': "I've made it this far a couple times,\\nbut the last stretch is so long…$"}
text:VictoryRoad_1F.EdgarDefeat	{'body': 'My dream ends here again…$'}
text:VictoryRoad_1F.EdgarPostBattle	{'body': 'You have made it this far. Keep\\ngoing and become the CHAMPION!\\pVICTINI lives on this floor,\\nwith a 3% encounter chance.\\lA rare bit of luck on a hard road!$'}
text:VictoryRoad_1F.AlbertIntro	{'body': "I didn't come all this way to lose now.\\nThat possibility doesn't exist!$"}
text:VictoryRoad_1F.EdgarVictiniCaught	{'body': "You've already found VICTINI!\\pNow go claim your own victory\\nat the POKéMON LEAGUE!$"}
text:VictoryRoad_1F.AlbertDefeat	{'body': 'Impossible…\\nI lost?$'}
text:VictoryRoad_1F.AlbertPostBattle	{'body': 'I lost here…\\pThat means I lack the qualifications\\nto become the CHAMPION…$'}
text:VictoryRoad_1F.HopeIntro	{'body': 'This seemingly infinite and harsh road\\nlives up to its name of VICTORY.$'}
text:VictoryRoad_1F.HopeDefeat	{'body': 'Your battle style is fantastic…$'}
text:VictoryRoad_1F.HopePostBattle	{'body': 'You seem to have the potential for\\nbecoming the CHAMPION.$'}
text:VictoryRoad_1F.QuincyIntro	{'body': "What is the VICTORY ROAD?\\nI'll tell you if you win!$"}
text:VictoryRoad_1F.QuincyDefeat	{'body': 'Okay!\\nWell done!$'}
text:VictoryRoad_1F.QuincyPostBattle	{'body': "Getting through here safely--that's\\nthe final test for any TRAINER aiming\\lto become the POKéMON CHAMPION.\\pThat's why it's called the VICTORY\\nROAD.$"}
text:VictoryRoad_1F.KatelynnIntro	{'body': "I have nothing to say to anyone\\nthat's come this far. Come on!$"}
text:VictoryRoad_1F.KatelynnDefeat	{'body': 'This is a disgrace…$'}
text:VictoryRoad_1F.KatelynnPostBattle	{'body': 'Humph, go right on ahead.\\nSee if I care.$'}
text:VictoryRoad_1F_NaomiIntro	{'body': 'I wonder if you are good enough\\nfor me?$'}
text:VictoryRoad_1F_NaomiDefeat	{'body': 'I lost out…$'}
text:VictoryRoad_1F_NaomiPostBattle	{'body': 'I never wanted to lose to anybody,\\nespecially to a younger kid…$'}
text:VictoryRoad_1F_RolandoIntro	{'body': "I can see you're good.\\nLet me see exactly how good!$"}
text:VictoryRoad_1F_RolandoDefeat	{'body': 'I had a chance…$'}
text:VictoryRoad_1F_RolandoPostBattle	{'body': 'Tch!\\nI concede, you are better than I!$'}
text:VictoryRoad_2F_DawsonIntro	{'body': 'If you can get through here,\\nyou can go meet the ELITE FOUR.$'}
text:VictoryRoad_2F_DawsonDefeat	{'body': 'No!\\nUnbelievable!$'}
text:VictoryRoad_2F_DawsonPostBattle	{'body': 'I can beat you when it comes to\\nknowledge about POKéMON!$'}
text:VictoryRoad_2F_DaisukeIntro	{'body': "This here is VICTORY ROAD.\\nIt's the final test for TRAINERS!$"}
text:VictoryRoad_2F_DaisukeDefeat	{'body': 'Atcho!$'}
text:VictoryRoad_2F_DaisukePostBattle	{'body': 'If you get stuck, try moving some\\nboulders around.$'}
text:VictoryRoad_2F_NelsonIntro	{'body': 'Ah, so you wish to challenge the\\nELITE FOUR?$'}
text:VictoryRoad_2F_NelsonDefeat	{'body': 'You got me!$'}
text:VictoryRoad_2F_NelsonPostBattle	{'body': '{RIVAL} also came through here.$'}
text:VictoryRoad_2F_VincentIntro	{'body': "Come on!\\nI'll whip you!$"}
text:VictoryRoad_2F_VincentDefeat	{'body': 'I got whipped!$'}
text:VictoryRoad_2F_VincentPostBattle	{'body': 'You earned the right to be on\\nVICTORY ROAD…$'}
text:VictoryRoad_2F_GregoryIntro	{'body': 'Is VICTORY ROAD too tough?$'}
text:VictoryRoad_2F_GregoryDefeat	{'body': 'Well done!$'}
text:VictoryRoad_2F_GregoryPostBattle	{'body': 'Many TRAINERS give up their\\nchallenge here and go home.$'}
text:VictoryRoad_2F_Gyaoo	{'body': 'ギヤーオ！$'}
text:DoubleEdgeTeach	{'body': "You should be proud of yourself,\\nhaving battled your way through\\lVICTORY ROAD so courageously.\\pIn recognition of your feat,\\nI'll teach you DOUBLE-EDGE.\\pWould you like me to teach that\\ntechnique?$"}
text:DoubleEdgeDeclined	{'body': "I'll teach you the technique\\nanytime.$"}
text:DoubleEdgeWhichMon	{'body': 'Which POKéMON should I teach\\nDOUBLE-EDGE?$'}
text:DoubleEdgeTaught	{'body': "Keep that drive going for the\\nPOKéMON LEAGUE!\\pTake a run at them and knock 'em\\nout!$"}
text:VictoryRoad_3F_GeorgeIntro	{'body': 'I heard rumors of a child prodigy.$'}
text:VictoryRoad_3F_GeorgeDefeat	{'body': 'The rumors were true!$'}
text:VictoryRoad_3F_GeorgePostBattle	{'body': 'So, it was you who beat GIOVANNI\\nof TEAM ROCKET?$'}
text:VictoryRoad_3F_AlexaIntro	{'body': 'TRAINERS live to seek stronger\\nopponents.$'}
text:VictoryRoad_3F_AlexaDefeat	{'body': 'Oh!\\nSo strong!$'}
text:VictoryRoad_3F_AlexaPostBattle	{'body': 'By fighting tough battles, you get\\nstronger.$'}
text:VictoryRoad_3F_CarolineIntro	{'body': "I'll show you just how good you\\nare. Not!$"}
text:VictoryRoad_3F_CarolineDefeat	{'body': "I'm furious!$"}
text:VictoryRoad_3F_CarolinePostBattle	{'body': 'You showed me just how good\\nI was…$'}
text:VictoryRoad_3F_ColbyIntro	{'body': 'Only the chosen can pass here!$'}
text:VictoryRoad_3F_ColbyDefeat	{'body': "I don't believe it!$"}
text:VictoryRoad_3F_ColbyPostBattle	{'body': "All TRAINERS here are headed to\\nthe POKéMON LEAGUE.\\pDon't let down your guard.$"}
text:VictoryRoad_3F_RayIntro	{'body': 'RAY: Together, the two of us are\\ndestined for greatness!$'}
text:VictoryRoad_3F_RayDefeat	{'body': "RAY: Ludicrous!\\nThis can't be!$"}
text:VictoryRoad_3F_RayPostBattle	{'body': "RAY: You've beaten us.\\nGreatness remains elusive…$"}
text:VictoryRoad_3F_RayNotEnoughMons	{'body': 'RAY: Together, the two of us are\\nstriving for the pinnacle.\\pWe need you to bring two POKéMON\\ninto battle with us.$'}
text:VictoryRoad_3F_TyraIntro	{'body': "TYRA: We're trying to become\\nchampions together.$"}
text:VictoryRoad_3F_TyraDefeat	{'body': 'TYRA: Oh, but…$'}
text:VictoryRoad_3F_TyraPostBattle	{'body': "TYRA: You've taught me that power\\ncan be infinite in shape and form.$"}
text:VictoryRoad_3F_TyraNotEnoughMons	{'body': "TYRA: You can't battle with us if\\nyou have only one POKéMON.$"}
text:VictoryRoad_B1F.SamuelIntro	{'body': "The thought that I'm getting closer to\\nthe POKéMON LEAGUE…\\pI'm getting stage fright…$"}
text:VictoryRoad_B1F.SamuelDefeat	{'body': "I couldn't do a thing…$"}
text:VictoryRoad_B1F.SamuelPostBattle	{'body': 'The POKéMON LEAGUE became distant\\nagain… What a letdown…$'}
text:VictoryRoad_B1F.ShannonIntro	{'body': 'To win your way through the POKéMON\\nLEAGUE, you need the trust of your\\lPOKéMON.$'}
text:VictoryRoad_B1F.ShannonDefeat	{'body': 'Your relationship is based on\\nsolid trust.$'}
text:VictoryRoad_B1F.ShannonPostBattle	{'body': 'By being together all the time, trust\\ngrows between POKéMON and TRAINERS.$'}
text:VictoryRoad_B1F.MichelleIntro	{'body': "This isn't the goal. It's only a place\\non the way to the POKéMON LEAGUE.$"}
text:VictoryRoad_B1F.MichelleDefeat	{'body': "That's the way!$"}
text:VictoryRoad_B1F.MichellePostBattle	{'body': "You'll do fine, for sure!\\nYour POKéMON are all eager to go!$"}
text:VictoryRoad_B1F.MitchellIntro	{'body': 'My POKéMON are cosmically\\nawe inspiring!$'}
text:VictoryRoad_B1F.MitchellDefeat	{'body': "I've never met anyone like you before.$"}
text:VictoryRoad_B1F.MitchellPostBattle	{'body': 'Even outside of battle, I sense\\nincredible power emanating from you\\land your POKéMON.$'}
text:VictoryRoad_B1F.HalleIntro	{'body': "Okay, no need to get your back up!\\nRelax, let's take it easy!$"}
text:VictoryRoad_B1F.HalleDefeat	{'body': 'Whoa!\\nWonderful!$'}
text:VictoryRoad_B1F.HallePostBattle	{'body': "Sure, this is VICTORY ROAD.\\pBut it's not all that different from\\nthe path you've taken so far.\\pTry to enjoy things the rest of\\nthe way!$"}
text:VictoryRoad_B2F.VitoIntro	{'body': "I trained together with my whole family,\\nevery one of us!\\lI'm not losing to anyone!$"}
text:VictoryRoad_B2F.VitoDefeat	{'body': 'Better than my family?!\\nIs that possible?!$'}
text:VictoryRoad_B2F.VitoPostBattle	{'body': "I was better than everyone in my\\nfamily. I've never lost before…\\pI've lost my confidence…\\nMaybe I'll go home…$"}
text:VictoryRoad_B2F.OwenIntro	{'body': "I'd heard that there was a tough\\nlittle kid around. Do they mean you?$"}
text:VictoryRoad_B2F.OwenDefeat	{'body': 'The little shrimp is tough!$'}
text:VictoryRoad_B2F.OwenPostBattle	{'body': 'The rumors I heard, that tough little\\nkid is from PETALBURG CITY.$'}
text:VictoryRoad_B2F.CarolineIntro	{'body': 'You must be getting a little tired.$'}
text:VictoryRoad_B2F.CarolineDefeat	{'body': 'No signs of tiring at all!$'}
text:VictoryRoad_B2F.CarolinePostBattle	{'body': 'VICTORY ROAD and the POKéMON LEAGUE\\nare long and grueling challenges.\\lBeware of fatigue!$'}
text:VictoryRoad_B2F.JulieIntro	{'body': "You shouldn't get complacent just\\nbecause you have a lot of GYM BADGES.\\pThere's always going to be someone\\nwho's better than you!$"}
text:VictoryRoad_B2F.JulieDefeat	{'body': "You're better than me!$"}
text:VictoryRoad_B2F.JuliePostBattle	{'body': "Gaze on your collected BADGES and\\nremember the TRAINERS you've faced.$"}
text:VictoryRoad_B2F.FelixIntro	{'body': "I've come this far, but the tension's\\ngiving me awful stomach pain…$"}
text:VictoryRoad_B2F.FelixDefeat	{'body': 'Ooh…\\nIt hurts…$'}
text:VictoryRoad_B2F.FelixPostBattle	{'body': "I can't help getting all tense knowing\\nthat I'm nearing the POKéMON LEAGUE.\\pIt's all I can do to feign calm.$"}
text:VictoryRoad_B2F.DianneIntro	{'body': 'The elite among the elite gather in\\nthis cave.\\pHow are you finding it?$'}
text:VictoryRoad_B2F.DianneDefeat	{'body': 'Not rattled in the least bit!$'}
text:VictoryRoad_B2F.DiannePostBattle	{'body': 'You do have guts! I like that!\\nKeep it going!$'}
text:ViridianCity_CanCarryMonsAnywhere	{'body': "Those POKé BALLS at your waist!\\nYou have POKéMON, don't you?\\pIt's great that you can carry and\\nuse POKéMON anytime, anywhere.$"}
text:ViridianCity_GymClosedWonderWhoLeaderIs	{'body': 'This POKéMON GYM is always closed.\\pI wonder who the LEADER is?$'}
text:ViridianCity_ViridiansGymLeaderReturned	{'body': "VIRIDIAN GYM's LEADER returned!$"}
text:ViridianCity_WantToKnowAboutCaterpillarMons	{'body': 'You want to know about the two\\nkinds of caterpillar POKéMON?$'}
text:ViridianCity_OhOkayThen	{'body': 'Oh, okay then!$'}
text:ViridianCity_ExplainCaterpieWeedle	{'body': "CATERPIE has no poison,\\nbut WEEDLE does.\\pWatch that your POKéMON aren't\\nstabbed by WEEDLE's POISON STING.$"}
text:ViridianCity_GrandpaHasntHadCoffeeYet	{'body': "Oh, Grandpa!\\nDon't be so mean!\\pI'm so sorry.\\nHe hasn't had his coffee yet.$"}
text:ViridianCity_GoShoppingInPewterOccasionally	{'body': 'I go shopping in PEWTER CITY\\noccasionally.\\pI have to take the winding trail in\\nVIRIDIAN FOREST when I go.$'}
text:ViridianCity_ThisIsPrivateProperty	{'body': 'I absolutely forbid you from\\ngoing through here!\\pThis is private property!$'}
text:ViridianCity_ShowYouHowToCatchMons	{'body': "Well, now, I've had my coffee, and\\nthat's what I need to get going!\\pHm?\\nWhat is that red box you have?\\pAh, so you're working on your\\nPOKéDEX.\\pThen let me give you a word of\\nadvice.\\pWhenever you catch a POKéMON,\\nthe POKéDEX automatically updates\\lits data.\\p…You don't know how to catch\\na POKéMON?\\pI suppose I had better show you\\nthen!$"}
text:ViridianCity_ThatWasEducationalTakeThis	{'body': 'There! Now tell me, that was\\neducational, was it not?\\pAnd here, take this, too.$'}
text:ViridianCity_WatchThatToLearnBasics	{'body': "If there's something you don't\\nunderstand, watch that.\\pIt will teach you about the basics\\nof being a POKéMON TRAINER.$"}
text:ViridianCity_WeakenMonsFirstToCatch	{'body': "Well, now, I've had my coffee, and\\nthat's what I need to get going!\\pBut I made it too strong.\\nIt gave me a headache…\\pIncidentally, are you filling your\\nPOKéDEX?\\pAt first, focus on weakening the\\nPOKéMON before trying to catch it.$"}
text:ViridianCity_HowsTeachyTVHelping	{'body': "Well, now, I've had my coffee, and\\nthat's what I need to get going!\\pBut I made it too strong.\\nIt gave me a headache…\\pIncidentally, is my old TEACHY TV\\nhelping you?$"}
text:ViridianCity_MyGrandsonOnTheShow	{'body': "Wahaha!\\nIt's my grandson on the show!\\pSince he's the one doing the\\nteaching, you're bound to learn.$"}
text:ViridianCity_TooBusyForTeachyTV	{'body': "Hm… You're too busy to not even\\nhave the time for TEACHY TV…\\pTime is money, and neither should\\nbe ill spent…$"}
text:ViridianCity_CitySign	{'body': 'VIRIDIAN CITY \\nThe Eternally Green Paradise$'}
text:ViridianCity_CatchMonsForEasierBattles	{'body': 'TRAINER TIPS\\pCatch POKéMON and expand your\\ncollection.\\pThe more you have, the easier it\\nis to battle.$'}
text:ViridianCity_MovesLimitedByPP	{'body': 'TRAINER TIPS\\pThe battle moves of POKéMON are\\nlimited by their POWER POINTS, PP.\\pTo replenish PP, rest your tired\\nPOKéMON at a POKéMON CENTER.$'}
text:ViridianCity_GymSign	{'body': 'VIRIDIAN CITY POKéMON GYM$'}
text:ViridianCity_GymDoorsAreLocked	{'body': "VIRIDIAN GYM's doors are locked…$"}
text:ViridianCity_Gym_GiovanniIntro	{'body': "Fwahahaha!\\nWelcome to my hideout!\\pIt shall be so until I can restore\\nTEAM ROCKET to its former glory.\\pBut, you have found me again.\\nSo be it.\\lThis time, I'm not holding back!\\pOnce more, you shall face\\nGIOVANNI, the greatest TRAINER!{PLAY_BGM}{MUS_RG_ENCOUNTER_ROCKET}$"}
text:ViridianCity_Gym_GiovanniDefeat	{'body': 'Ha!\\nThat was a truly intense fight.\\lYou have won!\\pAs proof, here is the EARTHBADGE!\\n{PAUSE_MUSIC}{PLAY_BGM}{MUS_OBTAIN_BADGE}{PAUSE 0xFE}{PAUSE 0x56}{RESUME_MUSIC}$'}
text:ViridianCity_Gym_GiovanniPostBattle	{'body': "Having lost in this fashion, \\nI can't face my followers.\\lI have betrayed their trust.\\pAs of today, TEAM ROCKET is\\nfinished forever!\\pAs for myself, I shall dedicate\\nmy life to training again.\\pLet us meet again someday!\\nFarewell!$"}
text:ViridianCity_Gym_ExplainEarthBadgeTakeThis	{'body': 'The EARTHBADGE makes POKéMON of\\nany level obey without question.\\pIt is evidence of your mastery as\\na POKéMON TRAINER.\\pWith it, you can challenge the\\nPOKéMON LEAGUE.\\pAlso, take this TM.\\pConsider it a gift for your POKéMON\\nLEAGUE challenge.$'}
text:ViridianCity_Gym_ReceivedTM26FromGiovanni	{'body': '{PLAYER} received TM26\\nfrom GIOVANNI.$'}
text:ViridianCity_Gym_ExplainTM26	{'body': 'TM26 contains EARTHQUAKE.\\pIt is a powerful attack that causes\\na massive tremor.\\pI made it when I ran the GYM here,\\nfar too long ago… $'}
text:ViridianCity_Gym_YouDoNotHaveSpace	{'body': 'You do not have space for this!$'}
text:ViridianCity_Gym_YujiIntro	{'body': 'Heh!\\nYou must be running out of steam\\lby now!$'}
text:ViridianCity_Gym_YujiDefeat	{'body': 'I ran out of gas!$'}
text:ViridianCity_Gym_YujiPostBattle	{'body': "You'll need power to keep up with\\nour GYM LEADER.$"}
text:ViridianCity_Gym_AtsushiIntro	{'body': "Rrrroar!\\nI'm working myself into a rage!$"}
text:ViridianCity_Gym_AtsushiDefeat	{'body': 'Wargh!$'}
text:ViridianCity_Gym_AtsushiPostBattle	{'body': "I'm still not worthy!$"}
text:ViridianCity_Gym_JasonIntro	{'body': 'POKéMON and I, we make wonderful\\nmusic together!$'}
text:ViridianCity_Gym_JasonDefeat	{'body': 'You are in perfect harmony!$'}
text:ViridianCity_Gym_JasonPostBattle	{'body': 'Do you know the identity of our\\nGYM LEADER?$'}
text:ViridianCity_Gym_KiyoIntro	{'body': 'Karate is the ultimate form of\\nmartial arts!$'}
text:ViridianCity_Gym_KiyoDefeat	{'body': 'Aiyah!$'}
text:ViridianCity_Gym_KiyoPostBattle	{'body': 'If my POKéMON were as good at\\nkarate as I…$'}
text:ViridianCity_Gym_WarrenIntro	{'body': 'The truly talented win with style.$'}
text:ViridianCity_Gym_WarrenDefeat	{'body': 'I lost my grip!$'}
text:ViridianCity_Gym_WarrenPostBattle	{'body': 'The LEADER will scold me for\\nlosing this way…$'}
text:ViridianCity_Gym_TakashiIntro	{'body': "I'm the KARATE KING!\\nYour fate rests with me!$"}
text:ViridianCity_Gym_TakashiDefeat	{'body': 'Ayah!$'}
text:ViridianCity_Gym_TakashiPostBattle	{'body': "The POKéMON LEAGUE?\\nYou? Don't get cocky!$"}
text:ViridianCity_Gym_ColeIntro	{'body': 'Your POKéMON will cower at the\\ncrack of my whip!$'}
text:ViridianCity_Gym_ColeDefeat	{'body': 'Yowch!\\nWhiplash!$'}
text:ViridianCity_Gym_ColePostBattle	{'body': 'Wait!\\nI was just careless!$'}
text:ViridianCity_Gym_SamuelIntro	{'body': 'VIRIDIAN GYM was closed for a\\nlong time.\\pBut now, our LEADER is back!$'}
text:ViridianCity_Gym_SamuelDefeat	{'body': 'I was beaten?$'}
text:ViridianCity_Gym_SamuelPostBattle	{'body': 'You can go on to the POKéMON\\nLEAGUE only by defeating our GYM\\lLEADER!$'}
text:ViridianCity_Gym_GymGuyAdvice	{'body': "Yo!\\nChamp in the making!\\pEven I don't know the VIRIDIAN\\nLEADER's identity.\\pBut one thing's certain.\\nThis will be the toughest of all\\lthe GYM LEADERS.\\pAlso, I heard that the TRAINERS\\nhere like GROUND-type POKéMON.$"}
text:ViridianCity_Gym_GymGuyPostVictory	{'body': 'Blow me away! GIOVANNI was the\\nGYM LEADER of VIRIDIAN?$'}
text:ViridianCity_Gym_GymStatue	{'body': 'VIRIDIAN POKéMON GYM\\nLEADER: ?\\pWINNING TRAINERS:\\n{RIVAL}$'}
text:ViridianCity_Gym_GymStatuePlayerWon	{'body': 'VIRIDIAN POKéMON GYM\\nLEADER: GIOVANNI\\pWINNING TRAINERS:\\n{RIVAL}, {PLAYER}$'}
text:ViridianCity_House_NicknamingIsFun	{'body': "Coming up with nicknames is fun,\\nbut it's not so easy to do.\\pClever names are nice, but simple\\nnames are easier to remember.$"}
text:ViridianCity_House_MyDaddyLovesMonsToo	{'body': 'My daddy loves POKéMON, too.$'}
text:ViridianCity_House_Speary	{'body': 'SPEARY: Tetweet!$'}
text:ViridianCity_House_SpearowNameSpeary	{'body': 'SPEAROW\\nName: SPEARY$'}
text:ViridianCity_Mart_YouCameFromPallet	{'body': 'Hey!\\nYou came from PALLET TOWN?$'}
text:ViridianCity_Mart_TakeThisToProfOak	{'body': 'You know PROF. OAK, right?\\pHis order came in.\\nCan I get you to take it to him?$'}
text:ViridianCity_Mart_ReceivedOaksParcelFromClerk	{'body': "{PLAYER} received OAK'S PARCEL\\nfrom the POKéMON MART clerk.$"}
text:ViridianCity_Mart_SayHiToOakForMe	{'body': 'Okay, thanks! Please say hi to\\nPROF. OAK for me, too.$'}
text:ViridianCity_Mart_ShopDoesGoodBusinessInAntidotes	{'body': "This shop does good business in\\nANTIDOTES, I've heard.$"}
text:ViridianCity_Mart_GotToBuySomePotions	{'body': "I've got to buy some POTIONS.\\pYou never know when your POKéMON\\nwill need quick healing.$"}
text:ViridianCity_PokemonCenter_1F_FeelFreeToUsePC	{'body': "Please feel free to use that PC in\\nthe corner.\\pThe receptionist told me so.\\nIt's so kind of her!$"}
text:ViridianCity_PokemonCenter_1F_PokeCenterInEveryTown	{'body': "There's a POKéMON CENTER in every\\ntown ahead.\\pThey charge no money, so don't\\nbe shy about healing POKéMON.$"}
text:ViridianCity_PokemonCenter_1F_PokeCentersHealMons	{'body': 'POKéMON CENTERS heal your tired,\\nhurt, or fainted POKéMON.\\pThey make all POKéMON completely\\nhealthy.$'}
text:ViridianCity_School_TryingToMemorizeNotes	{'body': "Whew! I'm trying to memorize all my\\nnotes.$"}
text:ViridianCity_School_ReadBlackboardCarefully	{'body': "Okay!\\pBe sure to read what's on the\\nblackboard carefully!$"}
text:ViridianCity_School_NotebookFirstPage	{'body': "Let's check out the notebook.\\pFirst page…\\pPOKé BALLS are used to catch\\nPOKéMON.\\pUp to six POKéMON can be carried\\nin your party.\\pPeople who raise and battle\\nwith POKéMON are called TRAINERS.$"}
text:ViridianCity_School_NotebookSecondPage	{'body': 'Second page…\\pA healthy POKéMON may be hard to\\ncatch, so weaken it first.\\pPoison, burn, or cause another\\nstatus problem to weaken it.$'}
text:ViridianCity_School_NotebookThirdPage	{'body': 'Third page…\\pPOKéMON TRAINERS seek others to\\nengage in POKéMON battles.\\pTo TRAINERS, the taste of victory\\nis sweet, indeed.\\pBattles are constantly waged at\\nPOKéMON GYMS everywhere.$'}
text:ViridianCity_School_NotebookFourthPage	{'body': 'Fourth page…\\pThe ultimate goal for all POKéMON\\nTRAINERS is simple.\\pIt is to defeat the top eight\\nPOKéMON GYM LEADERS.\\pDo so to earn the right to face…\\pThe ELITE FOUR of the POKéMON\\nLEAGUE!$'}
text:ViridianCity_School_TurnThePage	{'body': 'Turn the page?$'}
text:ViridianCity_School_HeyDontLookAtMyNotes	{'body': "GIRL: Hey!\\nDon't look at my notes!$"}
text:ViridianCity_School_BlackboardListsStatusProblems	{'body': 'The blackboard lists POKéMON\\nSTATUS problems during battles.$'}
text:ViridianCity_School_ReadWhichTopic	{'body': 'Which topic do you want to read?$'}
text:ViridianCity_School_ExplainSleep	{'body': "A POKéMON can't attack if it's\\nasleep.\\pPOKéMON will stay asleep even\\nafter battles.\\pUse AWAKENING to awaken one\\nfrom sleep.$"}
text:ViridianCity_School_ExplainBurn	{'body': 'A burn reduces ATTACK power.\\nIt also causes ongoing HP loss.\\pA burn remains after a battle.\\nUse BURN HEAL to cure a burn.$'}
text:ViridianCity_School_ExplainPoison	{'body': "When poisoned, a POKéMON's health\\nsteadily drops.\\pPoison lingers after battles.\\nUse an ANTIDOTE to cure poison!$"}
text:ViridianCity_School_ExplainFreeze	{'body': 'A frozen POKéMON becomes\\nhelplessly immobile.\\pIt stays frozen even after the\\nbattle ends.\\pUse ICE HEAL to thaw out the\\nsuffering POKéMON.$'}
text:ViridianCity_School_ExplainParalysis	{'body': 'Paralysis reduces SPEED and may\\nprevent the POKéMON from moving.\\pParalysis remains after battles.\\nUse PARLYZ HEAL for treatment.$'}
text:ViridianForest_FriendsItchingToBattle	{'body': "I came here with some friends to\\ncatch us some BUG POKéMON!\\pThey're all itching to get into\\nsome POKéMON battles!$"}
text:ViridianForest_RickIntro	{'body': "Hey! You have POKéMON!\\nCome on!\\lLet's battle 'em!$"}
text:ViridianForest_RickDefeat	{'body': "No!\\nCATERPIE can't hack it!$"}
text:ViridianForest_RickPostBattle	{'body': "Ssh! You'll scare the bugs away.\\nAnother time, okay?$"}
text:ViridianForest_DougIntro	{'body': "Yo!\\nYou can't jam out if you're a\\lPOKéMON TRAINER!$"}
text:ViridianForest_DougDefeat	{'body': 'Huh?\\nI ran out of POKéMON!$'}
text:ViridianForest_DougPostBattle	{'body': "That totally stinks! I'm going to\\ncatch some stronger ones!$"}
text:ViridianForest_SammyIntro	{'body': "Hey, wait up!\\nWhat's the hurry? Why the rush?$"}
text:ViridianForest_SammyDefeat	{'body': "I give!\\nYou're good at this!$"}
text:ViridianForest_SammyPostBattle	{'body': "Sometimes, you can find stuff on\\nthe ground.\\pI'm looking for the stuff I\\ndropped. Can you help me?$"}
text:ViridianForest_AnthonyIntro	{'body': "I might be little, but I won't like\\nit if you go easy on me!$"}
text:ViridianForest_AnthonyDefeat	{'body': 'Oh, boo.\\nNothing went right.$'}
text:ViridianForest_AnthonyPostBattle	{'body': 'I lost some of my allowance…$'}
text:ViridianForest_CharlieIntro	{'body': 'Did you know that POKéMON evolve?$'}
text:ViridianForest_CharlieDefeat	{'body': 'Oh!\\nI lost!$'}
text:ViridianForest_CharliePostBattle	{'body': "BUG POKéMON evolve quickly.\\nThey're a lot of fun!$"}
text:ViridianForest_RanOutOfPokeBalls	{'body': "I was throwing POKé BALLS to\\ncatch POKéMON, and I ran out.\\pThat's why you can never have too\\nmany POKé BALLS.$"}
text:ViridianForest_AvoidGrassyAreasWhenWeak	{'body': 'TRAINER TIPS\\pIf your POKéMON are weak and you\\nwant to avoid battles, stay away\\lfrom grassy areas!$'}
text:ViridianForest_UseAntidoteForPoison	{'body': 'For poison, use ANTIDOTE!\\nGet it at POKéMON MARTS!$'}
text:ViridianForest_ContactOakViaPCToRatePokedex	{'body': 'TRAINER TIPS\\pContact PROF. OAK via a PC to\\nget your POKéDEX evaluated!$'}
text:ViridianForest_CantCatchOwnedMons	{'body': "TRAINER TIPS\\pYou can't catch a POKéMON that\\nbelongs to someone else.\\pThrow POKé BALLS only at wild\\nPOKéMON to catch them!$"}
text:ViridianForest_WeakenMonsBeforeCapture	{'body': 'TRAINER TIPS\\pWeaken POKéMON before attempting\\ncapture!\\pWhen healthy, they may escape!$'}
text:ViridianForest_LeavingViridianForest	{'body': 'LEAVING VIRIDIAN FOREST\\nPEWTER CITY AHEAD$'}
text:Aide_HaventCaughtEnoughMonsForItem	{'body': "Let's see…\\nUh-oh! You have caught only\\l{STR_VAR_3} kinds of POKéMON!\\pYou need {STR_VAR_1} kinds\\nif you want the {STR_VAR_2}.$"}
text:Aide_GetEnoughMonsComeBackForItem	{'body': '…Oh. I see.\\pWhen you get {STR_VAR_1} kinds of POKéMON,\\ncome back for the {STR_VAR_2}.$'}
text:Aide_DontHaveAnyRoomForItem	{'body': "Oh! I see you don't have any\\nroom for the {STR_VAR_2}.$"}
text:Apprentice_PreparingForCircuit	{'body': "I'm putting together my first\\nsix-POKéMON CIRCUIT team!\\pI picked my two opening partners.\\nNow I'm looking for teammates who\\lcan help when they need to switch.\\pSix strong POKéMON are a start.\\nI want mine to work together!$"}
text:ApricornTree_Intro	{'body': "It's an Apricorn Tree!$"}
text:ApricornTree_Empty	{'body': 'There are no Apricorns…$'}
text:ApricornTree_WantToPick	{'body': "…It's {STR_VAR_2} {STR_VAR_1}!\\nDo you want to pick the\\l{STR_VAR_1}?$"}
text:ApricornTree_PickedTheApricorn	{'body': '{PLAYER} obtained\\n{STR_VAR_2} {STR_VAR_1}.$'}
text:ApricornTree_PutAwayApricorn	{'body': "{PLAYER} put away the\\n{STR_VAR_1} in\\lthe BAG's {STR_VAR_3} POCKET.$"}
text:ApricornTree_PocketFull	{'body': "The BAG's {STR_VAR_3} POCKET is full.\\p{PLAYER} gave up on the\\n{STR_VAR_1}…$"}
text:ApricornTree_ApricornLeftUnpicked	{'body': '{PLAYER} gave up on the\\n{STR_VAR_1}…$'}
text:BattleFrontier_DoYouWantToSeeTheListOfCaughtBannedSpecies	{'body': "Do you want to see the list of\\nPOKéMON species you can't bring?$"}
text:BerryBlender_WantToMakePokeblocks	{'body': 'Oh? Did you want to make some {POKEBLOCK}S\\nwith this old-timer?$'}
text:BerryBlender_Excellent	{'body': 'Excellent!$'}
text:BerryBlender_MadeOldTimerSad	{'body': "Oh…\\nYou've made this old-timer sad…$"}
text:BerryBlender_KnowHowToMakePokeblocks	{'body': 'Do you know how to make a {POKEBLOCK}?$'}
text:BerryBlender_LetsBerryBlender	{'body': "Let's get started, then!\\pLet's BERRY BLENDER!$"}
text:BerryBlender_ExplainBerryBlending	{'body': "Okay, a little explanation, then.\\pOh, don't worry, it's quite simple.\\pWhen the BLENDER's arrow comes to\\nyour marker, just press the A Button.\\pThat's all you have to do.\\nYou'll see how easy it is when you try.$"}
text:BerryBlender_DontHaveAnyBerries	{'body': "Oh?\\nYou don't have any BERRIES?\\pIf you don't have any BERRIES,\\nyou can't make any {POKEBLOCK}S.$"}
text:BerryBlender_CanHaveOneOfMyBerries	{'body': "Well, that won't do at all now, will it?\\pIf you don't mind leftovers, you can\\nhave one of my BERRIES.\\pThat way, we could make some {POKEBLOCK}S\\ntogether using the BERRY BLENDER.$"}
text:BerryBlender_DontHaveAnyBerriesToSpare	{'body': "If I had some BERRIES left over,\\nI'd gladly give you one…\\pBut, I don't have any to spare today.\\nWe'll have to do this another time.$"}
text:BerryBlender_PokeblockCaseIsFull	{'body': 'But your {POKEBLOCK} CASE is full.\\pYou should use some {POKEBLOCK}S before\\nyou come see me again.$'}
text:BerryBlender_DontHavePokeblockCase	{'body': "But you don't have a {POKEBLOCK} CASE.\\pYou should get a {POKEBLOCK} CASE and then\\ncome see me.$"}
text:BerryBlender_LetsGetBlendingAlready	{'body': "Let's get blending already!$"}
text:BerryBlender_WhatKindOfPokeblockWillIGet	{'body': "I wonder what kind of {POKEBLOCK} I'll get?\\nThis is so exciting!$"}
text:BerryBlender_WantToBlendPokeblocksWithUs	{'body': 'Hi, there! Did you want to blend some\\n{POKEBLOCK}S with us?$'}
text:BerryBlender_Okay	{'body': 'Okay!$'}
text:BerryBlender_ThatsTooBad	{'body': "That's too bad…\\pBut we'll always be around whenever\\nyou get the urge to blend!$"}
text:BerryBlender_KnowHowToMakePokeblocks2	{'body': "Of course, you do know how to\\nblend {POKEBLOCK}S, don't you?$"}
text:BerryBlender_LetsBerryBlender2	{'body': "Let's get started, then!\\pLet's BERRY BLENDER!$"}
text:BerryBlender_ExplainBerryBlending2	{'body': "Okay!\\nLet me explain it to you!\\pWhen the spinning BLENDER's arrow\\nreaches your marker, just press\\lthe A Button.\\pThat's all it takes.\\nPretty easy, don't you think?$"}
text:BerryBlender_DontHaveAnyBerries2	{'body': "Oh, but wait a second here…\\nYou don't have any BERRIES.\\pYou can't make any {POKEBLOCK}S without\\nBERRIES…\\pWe'll always be around whenever you\\nget hold of some BERRIES to blend.$"}
text:BerryBlender_PokeblockCaseIsFull2	{'body': 'Oh, but wait a second here…\\nYour {POKEBLOCK} CASE is full.\\pYou should use some {POKEBLOCK}S and\\nthen come back.$'}
text:BerryBlender_DontHavePokeblockCase2	{'body': "Oh, but wait a second here…\\nYou don't have a {POKEBLOCK} CASE.\\pYou should get a {POKEBLOCK} CASE and\\nthen come back.$"}
text:BerryBlender_MakePokeblocksWithOurGroup	{'body': 'Oh, hello! Did you want to make some\\n{POKEBLOCK}S with our little group?$'}
text:BerryBlender_OhDear	{'body': 'Oh, dear!$'}
text:BerryBlender_LeftUsInShock	{'body': "Oh, dear me…\\pYou've left us in shock!$"}
text:BerryBlender_KnowHowToMakePokeblocks3	{'body': "Naturally, you know how to make\\n{POKEBLOCK}S, don't you?$"}
text:BerryBlender_LetsBerryBlender3	{'body': "Okay, dear!\\nLet's get started!\\pLet's BERRY BLENDER!$"}
text:BerryBlender_ExplainBerryBlending3	{'body': "Oh, dear!\\pThen, I'll explain it to you nicely.\\pWhen the BLENDER's arrow spins to\\nyour marker, press the A Button.\\pThat's all it takes.\\nIsn't it simple?$"}
text:BerryBlender_DontHaveAnyBerries3	{'body': "You don't have any BERRIES,\\ndo you?\\pIf you don't have any BERRIES,\\nyou can't make any {POKEBLOCK}S.\\pWe'll always be making {POKEBLOCK}S here,\\nso let's make some together when\\lyou get a BERRY or two.$"}
text:BerryBlender_PokeblockCaseIsFull3	{'body': 'Your {POKEBLOCK} CASE is full,\\nit looks like.\\pYou should use some {POKEBLOCK}S up\\nand then come back.$'}
text:BerryBlender_DontHavePokeblockCase3	{'body': "You haven't gotten a {POKEBLOCK} CASE\\nyet, it looks like.\\pYou need to get a {POKEBLOCK} CASE before\\nyou come back.$"}
text:BerryBlender_SetNewBlenderRecord	{'body': "Okay! Today's going to be the day that\\nI set a new BLENDER speed record!$"}
text:BerryBlender_LookGoodAtBlendingJoinUs	{'body': "Oh, dear!\\nYou look as if you're good at blending.\\lWould you like to join us?$"}
text:BerryBlender_MakeDeliciousPokeblocks	{'body': "I'm going to make delicious {POKEBLOCK}S\\nand make my POKéMON cuter.$"}
text:BerryBlender_SaveGameBeforeBerryBlenderLink	{'body': '{POKEBLOCK}S will be made with your friends \\nfrom BERRIES in the BERRY BLENDER.\\pIs it okay to save the game before\\nlinking with your friends?$'}
text:BerryBlender_SearchingForFriends	{'body': 'Searching for your friends…\\n… … B Button: Cancel$'}
text:BerryBlender_Player1Arrived	{'body': '{STR_VAR_1} arrived.$'}
text:BerryBlender_Player1And2Arrived	{'body': '{STR_VAR_1} and {STR_VAR_2} arrived.$'}
text:BerryBlender_AllPlayersArrived	{'body': '{STR_VAR_1}, {STR_VAR_2}, and\\n{STR_VAR_3} arrived.$'}
text:BerryBlender_NoBerriesLink	{'body': "You have no BERRIES.\\nThe BERRY BLENDER can't be used.$"}
text:BerryBlender_PokeblockCaseIsFullLink	{'body': "Your {POKEBLOCK} CASE is full.\\nThe BERRY BLENDER can't be used.$"}
text:BerryBlender_DontHavePokeblockCaseLink	{'body': "You don't have a {POKEBLOCK} CASE.\\nThe BERRY BLENDER can't be used.$"}
text:BerryBlender_LoveMakingPokeblocks	{'body': 'I love making {POKEBLOCK}S.\\pI always have some BERRIES with me.$'}
text:BerryBlender_MakePokeblocksUsingBerryBlender	{'body': "If you'd like, we could make some\\n{POKEBLOCK}S together using the\\lBERRY BLENDER.$"}
text:BerryBlender_DontHaveAnyBerriesHaveOne	{'body': "Oh?\\nYou don't have any BERRIES?\\pWell, that won't do at all now, will it?\\pIf you don't mind leftovers, you can\\nhave one of my BERRIES.$"}
text:BerryBlender_UseItToMakePokeblocksTogether	{'body': "We'll use it to make {POKEBLOCK}S together\\nusing the BERRY BLENDER.$"}
text:BerryBlender_DontHaveAnyBerriesNoneToSpare	{'body': "Oh?\\nYou don't have any BERRIES?\\pIf I had some left over, I'd gladly\\ngive you one…\\pBut, I don't have any to spare today.\\nSorry about that.$"}
text:BerryTree_ItsSoftLoamySoil	{'body': "It's soft, loamy soil.$"}
text:BerryTree_WantToPlant	{'body': "It's soft, loamy soil.\\nWant to plant a BERRY?$"}
text:BerryTree_PlantedOneBerry	{'body': '{PLAYER} planted one {STR_VAR_1} in\\nthe soft, loamy soil.$'}
text:BerryTree_BerryGrowthStage1	{'body': 'One {STR_VAR_1} was planted here.$'}
text:BerryTree_BerryGrowthStage2	{'body': '{STR_VAR_1} has sprouted.$'}
text:BerryTree_BerryGrowthStage3	{'body': 'This {STR_VAR_1} plant is growing taller.$'}
text:BerryTree_BerryGrowthStageTrunk	{'body': "The {STR_VAR_1}'s trunk is getting bigger!$"}
text:BerryTree_BerryGrowthStageBudding	{'body': 'The {STR_VAR_1} tree has buds!$'}
text:BerryTree_BerryGrowthStage4	{'body': 'These {STR_VAR_1} flowers are blooming\\n{STR_VAR_2}.$'}
text:BerryTree_CareAdverbGreat	{'body': 'very beautifully$'}
text:BerryTree_CareAdverbPoor	{'body': 'cutely$'}
text:BerryTree_CareAdverbGood	{'body': 'prettily$'}
text:BerryTree_WantToPick	{'body': 'You found {STR_VAR_2} {STR_VAR_1}!\\pDo you want to pick the\\n{STR_VAR_1}?$'}
text:BerryTree_PickedTheBerry	{'body': '{PLAYER} picked the {STR_VAR_2} {STR_VAR_1}.$'}
text:BerryTree_PutAwayBerry	{'body': "{PLAYER} put away the {STR_VAR_1}\\nin the BAG's BERRIES POCKET.\\pThe soil returned to its soft and\\nloamy state.$"}
text:BerryTree_BerryPocketFull	{'body': "The BAG's BERRIES POCKET is full.\\pThe {STR_VAR_1} couldn't be taken.$"}
text:BerryTree_BerryLeftUnpicked	{'body': '{PLAYER} left the {STR_VAR_1}\\nunpicked.$'}
text:BerryTree_WantToWater	{'body': 'Want to water the {STR_VAR_1} with the\\nWAILMER PAIL?$'}
text:BerryTree_WateredTheBerry	{'body': '{PLAYER} watered the {STR_VAR_1}.$'}
text:BerryTree_PlantIsDelighted	{'body': 'The plant seems to be delighted.$'}
text:BerryTree_ExclamationPoint	{'body': '!$'}
text:CableClub_WelcomeWhichCableClubService_Frlg	{'body': 'Welcome to the POKéMON CABLE\\nCLUB.\\pWhich of our services do you wish\\nto use?$'}
text:CableClub_WhichService_Frlg	{'body': 'Which of our services do you wish\\nto use?$'}
text:CableClub_TradeMonsUsingLinkCable_Frlg	{'body': 'Trade POKéMON with another player\\nusing a GBA Game Link cable.$'}
text:CableClub_BattleUsingLinkCable_Frlg	{'body': 'You may battle another TRAINER\\nusing a GBA Game Link cable.$'}
text:CableClub_CloseThisMenu_Frlg	{'body': 'おわります$'}
text:CableClub_NeedTwoMonsForDoubleBattle_Frlg	{'body': 'For a DOUBLE BATTLE, you must\\nhave at least two POKéMON.$'}
text:CableClub_NeedTwoMonsToTrade_Frlg	{'body': 'For trading, you must have at\\nleast two POKéMON with you.$'}
text:CableClub_CantTradeEnigmaBerry_Frlg	{'body': "A POKéMON holding the {STR_VAR_1}\\nBERRY can't be traded.$"}
text:CableClub_PleaseWaitBCancel_Frlg	{'body': 'Please wait.\\n… … B Button: Cancel$'}
text:CableClub_WhenAllPlayersReadyAConfirmBCancel_Frlg	{'body': 'When all players are ready…\\nA Button: Confirm\\lB Button: Cancel$'}
text:CableClub_StartLinkWithXPlayersAConfirmBCancel_Frlg	{'body': 'Start link with {STR_VAR_1} players.\\nA Button: Confirm\\lB Button: Cancel$'}
text:CableClub_AwaitingLinkupBCancel_Frlg	{'body': 'Awaiting linkup…\\n… … B Button: Cancel$'}
text:CableClub_OkayToSaveProgress_Frlg	{'body': 'はじめる\u3000まえに\u3000レポートを\\nかきますが\u3000よろしいですか？$'}
text:CableClub_PleaseEnter_Frlg	{'body': 'Please enter.$'}
text:CableClub_DirectYouToYourRoom_Frlg	{'body': "I'll direct you to your room now.$"}
text:CableClub_SomeoneIsNotReadyToLink_Frlg	{'body': 'Someone is not ready to link.\\pPlease come back after everyone\\nhas made preparations.$'}
text:CableClub_LinkErrorPleaseReset_Frlg	{'body': 'Sorry, we have a link error…\\nPlease reset and try again.$'}
text:CableClub_PlayersMadeDifferentSelections_Frlg	{'body': 'The link partners appear to have\\nmade different selections.$'}
text:CableClub_PleaseVisitAgain_Frlg	{'body': 'Please do visit again.$'}
text:CableClub_IncorrectNumberOfParticipants_Frlg	{'body': 'The number of participants is\\nincorrect.$'}
text:CableClub_CantSingleBattleWithXPlayers_Frlg	{'body': "The SINGLE BATTLE Mode can't be\\nplayed by {STR_VAR_1} players.$"}
text:CableClub_CantDoubleBattleWithXPlayers_Frlg	{'body': "The DOUBLE BATTLE Mode can't be\\nplayed by {STR_VAR_1} players.$"}
text:CableClub_NeedFourPlayers_Frlg	{'body': 'There must be four players to play\\nthis Battle Mode.$'}
text:CableClub_PleaseConfirmNumberAndRestart_Frlg	{'body': 'Please confirm the number of\\nplayers and start again.$'}
text:TerminateLinkIfYouLeaveRoom_Frlg	{'body': 'The link will be terminated if you\\nleave the room. Is that okay?$'}
text:TerminateLinkConfirmation_Frlg	{'body': 'Terminating link…\\nYou will be escorted out of\\lthe room. Please wait.$'}
text:TrainerTooBusyToNotice_Frlg	{'body': 'This TRAINER is too busy to\\nnotice…$'}
text:LookedAtPlayersTrainerCard_Frlg	{'body': "Score! Got to look at {STR_VAR_1}'s\\nTRAINER CARD!$"}
text:LookedAtPlayersTrainerCardColored_Frlg	{'body': "Score! Got to look at {STR_VAR_1}'s\\nTRAINER CARD!\\pIt's a {STR_VAR_2} card!$"}
text:TakeSeatStartBattle_Frlg	{'body': 'Please take your seat and start\\nyour battle.$'}
text:TakeSeatStartTrade_Frlg	{'body': 'Please take your seat and start\\nyour trade.$'}
text:RecordCorner_ThanksForComing_Frlg	{'body': 'ごりよう\u3000ありがとう\u3000ございました$'}
text:CableClub_TrainerCardDataOverwritten_Frlg	{'body': 'The TRAINER CARD data will\\nbe overwritten.$'}
text:CableClub_HopeToSeeYouAgain_Frlg	{'body': 'I hope to see you again!$'}
text:CableClub_NotSetUpForFarAwayRegion_Frlg	{'body': "I'm awfully sorry.\\pWe're not set up to conduct trades\\nwith TRAINERS far away in another\\lregion yet…$"}
text:CableClub_OtherTrainerNotReady_Frlg	{'body': 'The other TRAINER is not ready.$'}
text:CableClub_YouHaveAMonThatCantBeTaken_Frlg	{'body': "You have at least one POKéMON\\nthat can't be taken.$"}
text:CableClub_AdapterNotConnected_Frlg	{'body': 'The Wireless Adapter is not\\nconnected properly.$'}
text:CableClub_ParticipantsStepUpToCounter_Frlg	{'body': 'Participants are asked to step up\\nto the reception counter.$'}
text:CableClub_Hello_Frlg	{'body': 'こんにちは！$'}
text:CableClub_PleaseWait_Frlg	{'body': 'しょうしょう\u3000おまちください$'}
text:CableClub_YouMayTradeHere_Frlg	{'body': 'You may trade your POKéMON here\\nwith another TRAINER.$'}
text:CableClub_YouMayBattleHere_Frlg	{'body': 'You may battle with your friends\\nhere.$'}
text:CableClub_CanMakeBerryPowder_Frlg	{'body': 'Two to five TRAINERS can make\\nBERRY POWDER together.$'}
text:CableClub_CanMixRecords_Frlg	{'body': 'ワイヤレス\u3000クラブでの\\nあそびかたを\u3000せつめいします$'}
text:CableClub_CancelSelectedItem_Frlg	{'body': 'Cancels the selected MENU item.$'}
text:CableClub_WhichBattleMode_Frlg	{'body': 'どちらの\u3000しょうぶに\u3000しますか？$'}
text:CableClub_ReturnsToPreviousStep_Frlg	{'body': 'ひとつ\u3000まえに\u3000もどります$'}
text:CableClub_NeedBerryForBerryCrush_Frlg	{'body': 'To use the BERRY CRUSH service,\\nyou must have at least one BERRY.$'}
text:CableClub_NeedTwoMonsForUnionRoom_Frlg	{'body': 'To enter the UNION ROOM, you must\\nhave at least two POKéMON.$'}
text:CableClub_NoEnigmaBerryInUnionRoom_Frlg	{'body': 'No POKéMON holding the {STR_VAR_1}\\nBERRY may enter the UNION ROOM.$'}
text:CableClub_UnionRoomAdapterNotConnected_Frlg	{'body': 'This is the POKéMON WIRELESS CLUB\\nUNION ROOM.\\pUnfortunately, your Wireless\\nAdapter is not connected properly.\\pPlease do come again.$'}
text:PlayerIsPlayingRightNowGoForIt_Frlg	{'body': 'It appears as if {STR_VAR_1} is playing\\nright now.\\lGo for it!$'}
text:DescribeWhichGame_Frlg	{'body': "I can explain game rules to you,\\nif you'd like.\\pWhich game should I describe?$"}
text:PokemonJumpInfo_Frlg	{'body': '“POKéMON JUMP”\\pMake your POKéMON skip the\\nVINE WHIP rope with the A Button.\\pOnly mini POKéMON around 28 inches\\nor less may participate.\\pPOKéMON that only swim, burrow, or\\nfly are not good at jumping.\\pAs a result, those POKéMON may not\\nparticipate.\\pGood things happen if everyone\\njumps in time.$'}
text:DodrioBerryPickingInfo_Frlg	{'body': "“DODRIO BERRY-PICKING”\\pCommand DODRIO's three heads to\\ncatch falling BERRIES.\\pPress right, up, or left on the\\n{PLUS} Control Pad to move the heads.\\pTo play this game, you must have\\na DODRIO.$"}
text:TalkToManToPlay_Frlg	{'body': 'If you want to play a game,\\nplease tell the man beside me.$'}
text:WelcomeCanYouWait_Frlg	{'body': 'Hi, welcome!\\nYou can play games over the\\lWireless Communication System.\\pCan you wait just a little bit?$'}
text:CableClub_ComeAgain_Frlg	{'body': 'All right, come again!$'}
text:AdapterNotConnectedMinigame_Frlg	{'body': "The Wireless Adapter isn't\\nconnected.\\pCome back when it's hooked up!$"}
text:PlayWhichGame_Frlg	{'body': 'All right, which game did you want\\nto play?$'}
text:EnterWhichPokemon_Frlg	{'body': 'Which POKéMON would you like to\\nenter?$'}
text:AllGoodToGo_Frlg	{'body': "Okay, you're all good to go.\\nDon't let the others beat you!$"}
text:LeavingDoComeAgain_Frlg	{'body': 'きょうは\u3000けえるのか？\\nまたこいよ！$'}
text:ExplainPokemonJumpRequirements_Frlg	{'body': "It doesn't look like you have any\\nPOKéMON that you can enter…\\pWould you like me to explain what\\nkinds of POKéMON can enter?$"}
text:ShortJumpingPokemonAllowed_Frlg	{'body': "“POKéMON JUMP” is open to POKéMON\\naround 28 inches or less.\\pWhat you can't enter are those\\nPOKéMON that can't jump.\\pYou know, like POKéMON that only\\nswim, burrow, or fly.\\pThat's all you need to know.$"}
text:OnlyDodrioAllowed_Frlg	{'body': '“DODRIO BERRY-PICKING”…\\nWell, the name says it all.\\pYou have to have a DODRIO to play\\nthis game.$'}
text:RetryFromStartPlease_Frlg	{'body': 'もういちど\u3000はじめから\\nやりなおして\u3000みて\u3000くれ$'}
text:CableClub_WelcomeWhichDirectCornerRoom_Frlg	{'body': 'Welcome to the POKéMON WIRELESS\\nCLUB DIRECT CORNER.\\pYou may interact directly with\\nyour friends here.\\pWhich room would you like to\\nenter?$'}
text:CableClub_TradePokemon_Frlg	{'body': 'Would you like to trade POKéMON?$'}
text:CableClub_PlayWhichBattleMode_Frlg	{'body': 'Which Battle Mode would you like\\nto play?$'}
text:CableClub_UseBerryCrush_Frlg	{'body': 'Would you like to use the\\nBERRY CRUSH System?$'}
text:CableClub_ExplainBattleModes_Frlg	{'body': 'There are three Battle Modes.\\pSINGLE BATTLE is for two TRAINERS\\nwith one or more POKéMON each.\\pEach TRAINER can have one POKéMON\\nin battle at a time.\\pDOUBLE BATTLE is for two TRAINERS\\nwith two or more POKéMON each.\\pEach TRAINER will send out two\\nPOKéMON in battle at a time.\\pMULTI BATTLE is for four TRAINERS\\nwith one or more POKéMON each.\\pEach TRAINER can have one POKéMON\\nin battle at a time.$'}
text:CableClub_ChooseGroupLeaderOfTwo_Frlg	{'body': 'Please decide which of you two\\nwill become the LEADER.\\pThe other player must then choose\\n“JOIN GROUP.”$'}
text:CableClub_ChooseGroupLeaderOfFour_Frlg	{'body': 'Please decide which of you four\\nwill become the GROUP LEADER.\\pThe other players must then choose\\n“JOIN GROUP.”$'}
text:CableClub_ChooseGroupLeader_Frlg	{'body': 'Please decide which of you will\\nbecome the GROUP LEADER.\\pThe other players must then choose\\n“JOIN GROUP.”$'}
text:CableClub_WelcomeUnionRoomEnter_Frlg	{'body': 'Welcome to the POKéMON WIRELESS\\nCLUB UNION ROOM.\\pYou may interact directly with\\nother TRAINERS here, some of\\lwhom you may not even know.\\pWould you like to enter the ROOM?$'}
text:CableClub_UnionRoomInfo_Frlg	{'body': 'The TRAINERS in the UNION ROOM\\nwill be those players around you\\lwho have also entered the ROOM.\\pYou may do all sorts of things\\nhere, such as exchanging greetings.\\pYou may enter two POKéMON up to\\nLv. 30 for a one-on-one battle.\\pYou may take part in a chat with\\ntwo to five people.\\pOr, you may register a POKéMON for\\ntrade.\\pWould you like to enter the ROOM?$'}
text:CableClub_EnjoyUnionRoom_Frlg	{'body': 'I hope you enjoy your time in\\nthe UNION ROOM.$'}
text:CableClub_FirstTimeRightThisWay_Frlg	{'body': "Hello!\\nMy name is TEALA.\\pThis must be your first time\\nup here.\\pI'll show you how the Wireless\\nCommunication System works.\\pFirst, I need to show you this\\nfloor of our POKéMON CENTER.\\pRight this way, please.$"}
text:CableClub_ExplainWirelessClubFirstTime_Frlg	{'body': "On the top floor, there are two\\nrooms.\\pFirst, the room on the left.\\nIt's the UNION ROOM.\\pYou may link up with TRAINERS\\naround you who have also entered\\lthe UNION ROOM.\\pWith them, you may do things like\\nchat, battle, and trade.\\pSecond, the room on the right is\\nthe DIRECT CORNER.\\pYou may trade or battle POKéMON\\nwith your friends in this room.\\pIf the Wireless Adapter isn't\\nconnected, you may still link up\\lusing a GBA Game Link cable.\\pIf that is the case, you must go\\nto the DIRECT CORNER.\\pI hope you enjoy the Wireless \\nCommunication System.$"}
text:CableClub_AskAboutLinking_Frlg	{'body': "Hello, {PLAYER}!\\pIt's me, TEALA, the POKéMON\\nCENTER 2F attendant.\\pIs there something you needed to\\nask me about linking?$"}
text:CableClub_ExplainWirelessClub_Frlg	{'body': "Let me explain how the POKéMON\\nWIRELESS CLUB works.\\pOn this, the top floor, there are\\ntwo rooms.\\pFirst, the room on the left.\\nIt's the UNION ROOM.\\pYou may link up with TRAINERS\\naround you who have also entered\\lthe UNION ROOM.\\pWith them, you may do things like\\nchat, battle, and trade.\\pSecond, the room on the right is\\nthe DIRECT CORNER.\\pYou may trade or battle POKéMON\\nwith your friends in this room.\\pSometimes, you may not be able to\\nfind your friends in the UNION ROOM\\lor the DIRECT CORNER.\\pIn that case, please move closer\\nto your friends.\\pIf the Wireless Adapter isn't\\nconnected, you may still link up\\lusing a GBA Game Link cable.\\pIf that is the case, you must go\\nto the DIRECT CORNER.\\pI hope you enjoy the Wireless \\nCommunication System.$"}
text:CableClub_HopeYouEnjoyWirelessSystem_Frlg	{'body': 'I hope you enjoy the Wireless\\nCommunication System.$'}
text:WirelessClubUndergoingAdjustments	{'body': "I'm terribly sorry.\\nThe POKéMON WIRELESS CLUB is\\lundergoing adjustments now.$"}
text:AppearsToBeUndergoingAdjustments	{'body': 'It appears to be undergoing\\nadjustments…$'}
text:ChampionsTent_Challenge	{'body': 'Take on three DOUBLE BATTLES?$'}
text:ChampionsTent_Rules	{'body': 'Bring six Pokémon ready to battle.\\nEGGS cannot enter.\\pYour team fights at your current\\nlevel cap. Your chosen builds stay.\\pWin three battles for a prize.\\nYou may retire between battles.\\pYour party is restored afterward.\\nThese wins are separate from the\\lCHAMPIONS CIRCUIT.$'}
text:ChampionsTent_Opponent	{'body': 'Battle {STR_VAR_2}: {STR_VAR_1}!\\nThe opposing team is Lv. {STR_VAR_3}.$'}
text:ChampionsTent_Continue	{'body': 'Well played! Your team is healed.\\nContinue the exhibition?$'}
text:ChampionsTent_Thanks	{'body': 'Thank you for battling!\\nCome back with your next idea.$'}
text:ChampionsTent_Prize	{'body': 'Three wins! Here is your prize:\\n{PLAYER} received {STR_VAR_1}!$'}
text:ChampionsTent_PrizeFull	{'body': 'Your prize is waiting here.\\nMake room in your BAG and return.$'}
text:ChampionsTent_NeedParty	{'body': 'Bring six Pokémon able to battle.\\nPrepare at a POKéMON CENTER, then\\lcome back when you are ready.$'}
text:ChampionsTent_NoOpponent	{'body': 'The next team is not ready yet.\\nPlease try the exhibition again.$'}
text:Debug_FlagsAndVarNotSetBattleConfigMessage_Text	{'body': "Feature unavailable! Please define a\\nusable flag and a usable var in:\\l'include/config/battle.h'!$"}
text:LilycoveCity_ContestLobby_ReceptionDontHavePokeblockCase	{'body': "Hello!\\pThis is the reception counter for\\nPOKéMON CONTESTS.\\pOh? It appears that you don't have\\na {POKEBLOCK} CASE yet.\\pIn that case, we need to provide you\\nwith this!$"}
text:LilycoveCity_ContestLobby_NowThatWeveClearedThatUp	{'body': "Okay, now that we've cleared that\\nup…\\pHello!\\pThis is the reception counter for\\nPOKéMON CONTESTS.$"}
text:LilycoveCity_ContestLobby_ContestReception	{'body': 'Hello!\\pThis is the reception counter for\\nPOKéMON CONTESTS.$'}
text:LilycoveCity_ContestLobby_CounterOnlyFor4PlayerContests	{'body': 'Hello!\\pThis reception counter is only\\nfor 4-player POKéMON CONTESTS.$'}
text:LilycoveCity_ContestLobby_EnterContest1	{'body': 'Would you like to enter your POKéMON\\nin our CONTESTS?$'}
text:LilycoveCity_ContestLobby_WhichTopic1	{'body': 'Which topic would you like?$'}
text:LilycoveCity_ContestLobby_ExplainContests	{'body': 'A POKéMON CONTEST involves four\\nTRAINERS entering one POKéMON each\\lin competitive judging.\\pA CONTEST has two stages of judging,\\nprimary and secondary.\\pPrimary judging is a popularity poll\\ninvolving the audience.\\pSecondary judging features appeals\\nby the POKéMON using their moves.\\pPlan appeals carefully to earn the\\nmost attention of the JUDGE and\\lexcite the audience.\\lDo your best to stand out.\\pThe primary and secondary scores are\\nadded at the end.\\pThe POKéMON garnering the highest\\nscore is declared the winner.$'}
text:LilycoveCity_ContestLobby_ExplainContestTypes	{'body': 'There are five kinds of CONTESTS.\\pCOOL, BEAUTY, CUTE, SMART, and\\nTOUGH are the five categories.\\pChoose the CONTEST that is right for\\nthe POKéMON you plan to enter.$'}
text:LilycoveCity_ContestLobby_ExplainContestRanks	{'body': 'There are four ranks of POKéMON\\nCONTESTS.\\pNORMAL, SUPER, HYPER, and MASTER\\nare the four ranks.\\pIn the NORMAL Rank, any POKéMON may\\nenter.\\pAny POKéMON that won a NORMAL Rank\\nCONTEST may move up to the SUPER Rank\\lin the same category.\\pIn the same way, a SUPER Rank winner\\ncan move up to the HYPER Rank, and\\la HYPER Rank winner can advance to\\lthe MASTER Rank in the same category.\\pA POKéMON that won in the MASTER Rank\\nmay compete in the MASTER Rank as\\loften as its TRAINER wants.$'}
text:LilycoveCity_ContestLobby_EnterWhichRank	{'body': 'Which Rank would you like to enter?$'}
text:LilycoveCity_ContestLobby_EnterWhichContest1	{'body': 'Which CONTEST would you like to enter?$'}
text:LilycoveCity_ContestLobby_EnterWhichPokemon1	{'body': 'Which POKéMON would you like to enter?$'}
text:LilycoveCity_ContestLobby_MonNotQualifiedForRank	{'body': "I'm terribly sorry, but your POKéMON\\nis not qualified to compete at this\\lRank yet…$"}
text:LilycoveCity_ContestLobby_EggCannotTakePart	{'body': "I'm sorry, but an EGG cannot take part\\nin a POKéMON CONTEST.$"}
text:LilycoveCity_ContestLobby_MonInNoConditionForContest	{'body': 'Your POKéMON appears to be in no\\ncondition to take part in a CONTEST…$'}
text:LilycoveCity_ContestLobby_AlreadyWonEnterAnyway	{'body': "Oh, but that RIBBON…\\pYour POKéMON has won this CONTEST\\nbefore, hasn't it?\\pWould you like to enter it in this\\nCONTEST anyway?$"}
text:LilycoveCity_ContestLobby_ConfirmContestMon	{'body': 'Is that your CONTEST POKéMON?$'}
text:LilycoveCity_ContestLobby_YourMonIsEntryNum4	{'body': 'Okay, your POKéMON will be entered\\nin this CONTEST.\\pYour POKéMON is Entry No. 4.\\nThe CONTEST will begin shortly.$'}
text:LilycoveCity_ContestLobby_ComeThroughHere	{'body': 'Please come in through here.\\nGood luck!$'}
text:LilycoveCity_ContestLobby_PokemonWonWeHavePrize	{'body': 'Congratulations! Your POKéMON is the\\nCONTEST winner!\\pWe have your prize right here.\\nPlease, right this way!$'}
text:LilycoveCity_ContestLobby_ComeBackForPrizeLater	{'body': 'Please come back for your prize\\nlater on.$'}
text:ContestHall_GettingStartedParticipantsAsFollows	{'body': "MC: Hello! We're just getting started\\nwith a {STR_VAR_3} Rank POKéMON\\l{STR_VAR_2}!\\pThe participating TRAINERS and their\\nPOKéMON are as follows:$"}
text:ContestHall_GettingStartedParticipantsAsFollowsLink	{'body': "MC: Hello! We're just getting started\\nwith a 4-player linked POKéMON\\l{STR_VAR_2}!\\pThe participating TRAINERS and their\\nPOKéMON are as follows:$"}
text:ContestHall_EntryXTrainersMon	{'body': "MC: Entry No. {STR_VAR_2}!\\n{STR_VAR_1}'s {STR_VAR_3}!$"}
text:ContestHall_SeenContestantsAudienceWillVote	{'body': "MC: We've just seen the four POKéMON\\ncontestants.\\pNow it's time for primary judging!\\pThe audience will vote on their\\nfavorite POKéMON contestants.\\pWithout any further ado, let the\\nvoting begin!$"}
text:ContestHall_VotingUnderWay	{'body': 'Voting under way…$'}
text:ContestHall_VotingCompleteLetsAppeal	{'body': "Voting is now complete!\\pWhile the votes are being tallied,\\nlet's move on to secondary judging!\\pThe second stage of judging is the\\nmuch anticipated appeal time!\\pMay the contestants amaze us with\\nsuperb appeals of dazzling moves!\\pLet's see a little enthusiasm!\\nLet's appeal!$"}
text:ContestHall_ThatsItForJudging	{'body': "MC: That's it for judging!$"}
text:ContestHall_ThankYouForAppeals	{'body': 'Thank you all for a most wonderful\\ndisplay of quality appeals!\\pThis concludes all judging!\\nThank you for your fine efforts!$'}
text:ContestHall_JudgeLooksReady	{'body': 'Now, all that remains is the pulse-\\npounding proclamation of the winner.\\pThe JUDGE looks ready to make\\nthe announcement!$'}
text:ContestHall_WeWillNowDeclareWinner	{'body': 'JUDGE: We will now declare the winner!$'}
text:ContestHall_CongratsTrainerXandMon	{'body': 'MC: Entry No. {STR_VAR_2}!\\p{STR_VAR_3} and {STR_VAR_1},\\ncongratulations!$'}
text:ContestHall_CongratsPleaseCompeteAgain	{'body': 'MC: Congratulations!\\nPlease do compete again!$'}
text:ContestHall_AcceptYourPrize	{'body': 'MC: Here you are!\\nPlease accept your prize!$'}
text:ContestHall_ConferRibbonAsPrize	{'body': 'We confer on you this RIBBON\\nas your prize!$'}
text:ContestHall_ReceivedRibbon	{'body': '{PLAYER} received a RIBBON.$'}
text:ContestHall_PutRibbonOnMon	{'body': '{PLAYER} put the RIBBON on\\n{STR_VAR_1}.$'}
text:ContestHall_PickUpPrizeAtCounterLater	{'body': 'Please pick up your prize at\\nthe reception counter later.\\lPlease do compete again!$'}
text:ContestHall_OnlyRegister4Players	{'body': 'I only register four players for\\nPOKéMON CONTESTS.\\pIf three other players link up, all\\nfour may enter the same CONTEST.\\pWould you like to take part?$'}
text:LilycoveCity_ContestLobby_ProgressWillBeSaved	{'body': 'Before entering a CONTEST, your\\nprogress will be saved.$'}
text:LilycoveCity_ContestLobby_ParticipateAnotherTime	{'body': 'We hope you will participate another\\ntime.$'}
text:LilycoveCity_ContestLobby_EnterContest2	{'body': 'Would you like to enter a CONTEST?$'}
text:LilycoveCity_ContestLobby_Explain4PlayerContest	{'body': 'When four players are ready, connect\\nover a Game Link cable, and register\\lwith me, please.\\pPlease choose the same CONTEST\\nas your fellow contestants.\\pThe CONTEST begins as soon as all\\nplayers register their entry.\\pAfter that, the usual CONTEST rules\\napply.$'}
text:LilycoveCity_ContestLobby_EnterWhichContest2	{'body': 'Which CONTEST would you like to enter?$'}
text:LilycoveCity_ContestLobby_EnterWhichPokemon2	{'body': 'Which POKéMON would you like to enter?$'}
text:LilycoveCity_ContestLobby_Transmitting	{'body': 'Transmitting…$'}
text:LilycoveCity_ContestLobby_TransmissionError	{'body': 'Transmission error…$'}
text:LilycoveCity_ContestLobby_PlayersChoseDifferentContest	{'body': 'You may have chosen a different\\nCONTEST than another player.$'}
text:LilycoveCity_ContestLobby_PlayersMadeDifferentChoice	{'body': 'You may have made a different\\nchoice than another player.$'}
text:LilycoveCity_ContestLobby_PleaseWaitBButtonCancel	{'body': 'Please wait.\\n… … B Button: Cancel$'}
text:LilycoveCity_ContestLobby_ParticipateAnotherTime2	{'body': 'We hope you will participate another\\ntime.$'}
text:LilycoveCity_ContestLobby_TransmissionErrorTryAgain	{'body': 'Transmission error.\\nPlease try again.$'}
text:LilycoveCity_ContestLobby_YourMonIsEntryNumX	{'body': 'Your POKéMON will be entered in\\nthe CONTEST.\\pYour POKéMON is Entry No. {STR_VAR_2}.$'}
text:LilycoveCity_ContestLobby_ContestBeginShortly	{'body': 'The CONTEST will begin shortly.$'}
text:LilycoveCity_ContestLobby_LinkContestReception	{'body': 'Welcome! This is the POKéMON CONTEST\\nlink reception counter.\\pYou may enter CONTESTS together with\\none or more friends.$'}
text:LilycoveCity_ContestLobby_WhichTopic2	{'body': 'Which topic would you like?$'}
text:LilycoveCity_ContestLobby_EnterContest3	{'body': 'Would you like to enter a CONTEST?$'}
text:LilycoveCity_ContestLobby_EnterWhichContest3	{'body': 'Which CONTEST would you like to enter?$'}
text:LilycoveCity_ContestLobby_MonInNoCondition2	{'body': 'Your POKéMON appears to be in no\\ncondition to take part in a CONTEST…$'}
text:LilycoveCity_ContestLobby_EggCannotTakePart2	{'body': "I'm sorry, but an EGG cannot take part\\nin a POKéMON CONTEST.$"}
text:LilycoveCity_ContestLobby_EnterWhichPokemon3	{'body': 'Which POKéMON would you like to enter?$'}
text:LilycoveCity_ContestLobby_PleaseDecideLinkLeader	{'body': 'Please decide which of you will\\nbecome the GROUP LEADER.\\pThe other players must then choose\\n“JOIN GROUP.”$'}
text:LilycoveCity_ContestLobby_PlayerAt4PCounterUseGMode	{'body': 'At least one player has entered using\\nthe 4-player reception counter.\\pThere must be four players connected\\nusing a GBA Game Link cable.\\pWhen the four players are ready,\\nselect G-MODE (GLOBAL MODE),\\lthen register to enter again, please.$'}
text:LilycoveCity_ContestLobby_ExplainLinkContest	{'body': 'This is a CONTEST for two to four\\nplayers linked using a Wireless\\lAdapter or a GBA Game Link cable.\\pParticipants are first asked to choose\\nthe mode they wish to enter.\\pThere are two different modes.\\pE-MODE (CHAMPIONS MODE) is for\\ntwo to four players, each with a\\lEmerald Champions Game Pak.\\pG-MODE (GLOBAL MODE) is only for\\nfour players, each with a POKéMON\\lEmerald Champions, Ruby, or Sapphire.\\pThe players should discuss which mode\\nthey want, then choose the same mode.\\pOnce all the players have chosen\\nthe same CONTEST in the same mode,\\lthe entry registration is complete.\\pAfter that, a CONTEST will start in\\nthe usual manner.$'}
text:LilycoveCity_ContestLobby_ExplainEMode	{'body': 'In E-MODE (CHAMPIONS MODE),\\na LINK CONTEST can be held with\\ltwo to four players. Each player must\\lhave an Emerald Champions Game Pak.\\pThe players must be linked with each\\nother using Wireless Adapters or\\lGBA Game Link cables.\\pIf there are fewer than four players,\\nTRAINERS in the hall will join to fill\\lthe 4-player CONTEST lineup.\\pPlease be aware that E-MODE is not\\navailable in POKéMON Ruby or Sapphire.$'}
text:LilycoveCity_ContestLobby_ExplainGMode	{'body': 'G-MODE (GLOBAL MODE) is specifically\\nfor four players who are linked using\\lGBA Game Link cables.\\pEach player must have a POKéMON\\nEmerald Champions, Ruby, or Sapphire.\\pThe CONTEST starts after all players\\nchoose G-MODE (Emerald Champions) or\\lenter through the 4-player reception\\lcounter (POKéMON Ruby or Sapphire).$'}
text:LilycoveCity_ContestLobby_NoWirelessAdapterInGMode	{'body': "I'm terribly sorry.\\pG-MODE does not function\\nwith Wireless Adapters.\\pPlease select E-MODE or try\\nagain using a GBA Game Link cable.$"}
text:LilycoveCity_ContestLobby_WhichContestMode	{'body': 'Which CONTEST MODE would you like\\nto enter?$'}
text:ContestHall_GettingStartedWireless	{'body': "MC: Hello! We're just getting started\\nwith a 4-player linked POKéMON\\l{STR_VAR_2}!$"}
text:ContestHall_ParticipantsAsFollows	{'body': 'The participating TRAINERS and their\\nPOKéMON are as follows:$'}
text:ContestHall_WeveSeenContestants	{'body': "MC: We've just seen the four POKéMON\\ncontestants.\\pNow it's time for primary judging!$"}
text:ContestHall_AudienceWillVote	{'body': 'The audience will vote on their\\nfavorite POKéMON contestants.$'}
text:ContestHall_LetVotingBegin	{'body': 'Without any further ado,\\nlet the voting begin!$'}
text:ContestHall_VotingComplete	{'body': "Voting is now complete!\\pWhile the votes are being tallied,\\nlet's move on to secondary judging!$"}
text:ContestHall_SecondStageOfJudging	{'body': 'The second stage of judging is\\nthe much-anticipated appeal time!\\pMay the contestants amaze us with\\nsuperb appeals of dazzling moves!$'}
text:ContestHall_LetsAppeal	{'body': "Let's see a little enthusiasm!\\nLet's appeal!$"}
text:Route117_SeeWifeIfYoudLikeMeToRaiseMon	{'body': "I'm the DAY-CARE MAN.\\pI help take care of the precious\\nPOKéMON of TRAINERS.\\pIf you'd like me to raise your POKéMON,\\nhave a word with my wife.$"}
text:Route117_DoYouWantEgg	{'body': "Ah, it's you!\\pWe were raising your POKéMON,\\nand my goodness, were we surprised!\\pYour POKéMON had an EGG!\\pWe don't know how it got there,\\nbut your POKéMON had it.\\pYou do want it, yes?$"}
text:Route117_YourMonIsDoingFine	{'body': "Ah, it's you! Good to see you.\\nYour {STR_VAR_1}'s doing fine.$"}
text:Route117_IllKeepIt	{'body': "Well then, I'll keep it.\\nThanks!$"}
text:Route117_YouHaveNoRoomForIt	{'body': "You have no room for it…\\nCome back when you've made room.$"}
text:Route117_ReceivedEgg	{'body': '{PLAYER} received the EGG from\\nthe DAY-CARE MAN.$'}
text:Route117_TakeGoodCareOfIt	{'body': 'Take good care of it.$'}
text:Route117_FriendlyWithOtherTrainersMon	{'body': "By the way, about your {STR_VAR_1},\\nit seemed to be friendly with\\l{STR_VAR_2}'s {STR_VAR_3}.\\pI may even have seen it receiving\\na piece of MAIL.$"}
text:Route117_SeeWifeIfYouWantToPickUpMon	{'body': 'If you want to pick up your POKéMON,\\nhave a word with my wife.$'}
text:Route117_YourMonsAreDoingFine	{'body': "Ah, it's you! Your {STR_VAR_1} and\\n{STR_VAR_2} are doing fine.$"}
text:Route117_IWillKeepDoYouWantIt	{'body': 'I really will keep it.\\nYou do want this, yes?$'}
text:Route117_PokemonDayCare_WouldYouLikeUsToRaiseAMon	{'body': "I'm the DAY-CARE LADY.\\pWe can raise POKéMON for you.\\pWould you like us to raise one?$"}
text:Route117_PokemonDayCare_WhichMonShouldWeRaise	{'body': 'Choose a POKéMON from your party\\nor PC for us to raise.$'}
text:Route117_PokemonDayCare_WellRaiseYourMon	{'body': "Fine, we'll raise your {STR_VAR_1}\\nfor a while.\\pCome back for it later.$"}
text:Route117_PokemonDayCare_WeCanRaiseOneMore	{'body': 'We can raise two of your POKéMON.\\nWould you like us to raise one more?$'}
text:Route117_PokemonDayCare_HusbandWasLookingForYou	{'body': 'My husband was looking for you.$'}
text:Route117_PokemonDayCare_FineThenComeAgain	{'body': 'Oh, fine, then.\\nCome again.$'}
text:Route117_PokemonDayCare_NotEnoughMoney	{'body': "You don't have enough money…$"}
text:Route117_PokemonDayCare_TakeOtherOneBackToo	{'body': 'Will you take back the other one,\\ntoo?$'}
text:Route117_PokemonDayCare_ComeAgain	{'body': 'Fine.\\nCome again.$'}
text:Route117_PokemonDayCare_GoodToSeeYou	{'body': "Ah, it's you! Good to see you.\\nYour POKéMON can only be doing good!$"}
text:Route117_PokemonDayCare_YourMonHasGrownXLevels	{'body': 'By level, your {STR_VAR_1} has\\ngrown by {STR_VAR_2}.$'}
text:Route117_PokemonDayCare_YourTeamIsFull	{'body': 'Your POKéMON team is full.\\nMake room, then come see me.$'}
text:Route117_PokemonDayCare_TakeBackWhichMon	{'body': 'Which POKéMON will you take back?$'}
text:Route117_PokemonDayCare_ItWillCostX	{'body': 'If you want your {STR_VAR_1} back,\\nit will cost ¥{STR_VAR_2}.$'}
text:Route117_PokemonDayCare_HeresYourMon	{'body': "Perfect!\\nHere's your POKéMON.$"}
text:Route117_PokemonDayCare_TookBackMon	{'body': '{PLAYER} took back {STR_VAR_1} from\\nthe DAY-CARE LADY.$'}
text:Route117_PokemonDayCare_YouHaveJustOneMon	{'body': 'Oh? But you have just one\\nPOKéMON.\\pCome back another time.$'}
text:Route117_PokemonDayCare_TakeYourMonBack	{'body': 'Will you take your POKéMON back?$'}
text:Route117_PokemonDayCare_WhatWillYouBattleWith	{'body': 'If you leave me that POKéMON,\\nwhat will you battle with?\\pCome back another time.$'}
text:EggHatchHuh	{'body': 'Huh?$'}
text:Route117_PokemonDayCare_YoullBeLeftWithJustOne	{'body': 'Keep at least two healthy POKéMON\\nwith you for double battles.\\pYou can leave a boxed POKéMON here\\nwithout changing your party.$'}
text:Debug_FlagsNotSetOverworldConfigMessage_Text	{'body': "Feature unavailable!\\nPlease define a usable flag in:\\l'include/config/overworld.h'!$"}
text:Debug_FlagsNotSetBattleConfigMessage_Text	{'body': "Feature unavailable!\\nPlease define a usable flag in:\\l'include/config/battle.h'!$"}
text:Debug_VarsNotSetBattleConfigMessage_Text	{'body': "Feature unavailable!\\nPlease define a usable var in:\\l'include/config/battle.h'!$"}
text:Debug_BoxFilledMessage_Text	{'body': 'Storage boxes filled!$'}
text:Debug_OffensiveEVs	{'body': 'ATK EVs: {STR_VAR_1}, SPATK EVs: {STR_VAR_2}, SPEED EVs: {STR_VAR_3}$'}
text:Debug_DefensiveEVs	{'body': 'HP EVs: {STR_VAR_1}, DEF EVs: {STR_VAR_2}, SPDEF EVs: {STR_VAR_3}$'}
text:Debug_OffensiveIVs	{'body': 'ATK IVs: {STR_VAR_1}, SPATK IVs: {STR_VAR_2}, SPEED IVs: {STR_VAR_3}$'}
text:Debug_DefensiveIVs	{'body': 'HP IVs: {STR_VAR_1}, DEF IVs: {STR_VAR_2}, SPDEF IVs: {STR_VAR_3}$'}
text:Debug_SaveBlock1Size	{'body': 'SaveBlock1 size: {STR_VAR_1}b/{STR_VAR_2}b.\\nFree space: {STR_VAR_3}b.$'}
text:Debug_SaveBlock2Size	{'body': 'SaveBlock2 size: {STR_VAR_1}b/{STR_VAR_2}b.\\nFree space: {STR_VAR_3}b.$'}
text:Debug_SaveBlock3Size	{'body': 'SaveBlock3 size: {STR_VAR_1}b/{STR_VAR_2}b.\\nFree space: {STR_VAR_3}b.$'}
text:Debug_PokemonStorageSize	{'body': '{PKMN}Storage size: {STR_VAR_1}b/{STR_VAR_2}b.\\nFree space: {STR_VAR_3}b.$'}
text:Debug_ROMSize	{'body': 'ROM size: {STR_VAR_1}MB/32MB.\\nFree space: {STR_VAR_2}MB.$'}
text:DebugScript_EmptyParty	{'body': 'You have no Pokémon nor Eggs.$'}
text:DebugScript_HatchAnEgg_NotAnEgg	{'body': "That's not a Pokémon Egg.$"}
text:DebugDaycareNoPokemon	{'body': 'You have no Pokémon at Daycare.$'}
text:DebugDaycareOnePokemon	{'body': 'You have only one Pokémon at Daycare.$'}
text:DebugDaycarePokemonNotCompatible	{'body': "Your Pokémon at Daycare can't\\nhave babies together!$"}
text:Debug_ExpansionVersion	{'body': 'pokeemerald-expansion {STR_VAR_1}$'}
text:Debug_Enable_To_Use_Follower_NPCs	{'body': "Feature unavailable.\\nSet FNPC_ENABLE_NPC_FOLLOWERS to\\lTRUE in 'include/config/follower_npc.h'.$"}
text:Debug_Follower_NPC_Test_Message	{'body': 'This is a Follower NPC test.$'}
text:DebugBerryPestsDisabled	{'body': 'OW_BERRY_PESTS is disabled.\\nUnable to force pests onto berry trees.$'}

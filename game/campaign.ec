species:ZAMAZENTA_CROWNED	{'footprint': 'gMonFootprint_Zamazenta', 'teachableLearnset': 'sZamazentaTeachableLearnset', 'genderRatio': 255, 'friendship': 0, 'levelUpLearnset': 'learn:sZamazentaLevelUpLearnset', 'types': ('type:FIGHTING', 'type:STEEL'), 'catchRate': 10, 'expYield': 350, 'eggCycles': 120, 'growthRate': 'GROWTH_SLOW', 'eggGroups': '{ EGG_GROUP_NO_EGGS_DISCOVERED, DEFAULT(EGG_GROUP_NO_EGGS_DISCOVERED, ) }', 'abilities': ('ability:DAUNTLESS_SHIELD', 'ability:NONE', 'ability:NONE'), 'bodyColor': 'BODY_COLOR_RED', 'cryId': 'CRY_ZAMAZENTA_CROWNED', 'natDexNum': 'NATIONAL_DEX_ZAMAZENTA', 'height': 29, 'weight': 7850, 'description': "Its ability to deflect any attack\\nled to it being known as the Fighting\\nMaster's Shield. It was feared and\\nrespected by all.", 'pokemonScale': 275, 'pokemonOffset': 7, 'frontPicSize': 'MON_COORDS_SIZE(56, 64)', 'frontPicYOffset': 0, 'frontAnimFrames': 'sAnims_SingleFramePlaceHolder', 'backPicSize': 'MON_COORDS_SIZE(64, 64)', 'backPicYOffset': 3, 'enemyShadowXOffset': 0, 'enemyShadowYOffset': 12, 'enemyShadowSize': 'SHADOW_SIZE_L', 'isRestrictedLegendary': 1, 'isFrontierBanned': 1, 'perfectIVCount': 'LEGENDARY_PERFECT_IV_COUNT', 'formChangeTable': 'sZamazentaFormChangeTable', 'art_name': 'ZamazentaCrowned', 'family': 'family:Zamazenta', 'stats': (92, 120, 140, 80, 140, 128), 'yield': (0, 0, 0, 0, 0, 3), 'name': 'Zamazenta', 'category': 'Warrior', 'pool': 'learn:pool.ZAMAZENTA_HERO'}

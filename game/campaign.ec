species:SHIELDON	{'iconPalIndex': 1, 'pokemonJumpType': 'PKMN_JUMP_TYPE_SLOW', 'genderRatio': 31, 'levelUpLearnset': 'learn:sShieldonLevelUpLearnset', 'types': ('type:ROCK', 'type:STEEL'), 'catchRate': 45, 'expYield': 70, 'eggCycles': 30, 'growthRate': 'GROWTH_ERRATIC', 'eggGroups': '{ EGG_GROUP_MONSTER, DEFAULT(EGG_GROUP_MONSTER, ) }', 'abilities': ('ability:STURDY', 'ability:NONE', 'ability:SOUNDPROOF'), 'bodyColor': 'BODY_COLOR_GRAY', 'cryId': 'CRY_SHIELDON', 'natDexNum': 'NATIONAL_DEX_SHIELDON', 'height': 5, 'weight': 570, 'description': "This Pokémon lived in primeval jungles.\\nFew enemies would have been willing to\\nsquare off against its heavily armored\\nface, so it's thought.", 'pokemonScale': 432, 'pokemonOffset': 16, 'frontPicSize': 'MON_COORDS_SIZE(40, 40)', 'frontPicYOffset': 15, 'frontAnimFrames': '(const union AnimCmd *const[]) { sAnim_GeneralFrame0, (const union AnimCmd[]) { ANIMCMD_FRAME(0, 20), ANIMCMD_FRAME(1, 10), ANIMCMD_FRAME(0, 10), ANIMCMD_END, }, }', 'frontAnimId': 'ANIM_V_SHAKE', 'backPicSize': 'MON_COORDS_SIZE(56, 48)', 'backPicYOffset': 11, 'backAnimId': 'BACK_ANIM_V_SHAKE', 'enemyShadowXOffset': 3, 'enemyShadowYOffset': -1, 'enemyShadowSize': 'SHADOW_SIZE_S', 'eggMoveLearnset': 'learn:sShieldonEggMoveLearnset', 'evolutions': '(const struct Evolution[]) { {EVO_LEVEL, 30, species:BASTIODON}, { EVOLUTIONS_END }, }', 'art_name': 'Shieldon', 'preparation': 'preparation:SHIELDON', 'stats': (30, 42, 118, 42, 88, 30), 'yield': (0, 0, 1, 0, 0, 0), 'name': 'Shieldon', 'category': 'Shield', 'pool': 'learn:pool.SHIELDON'}

species:BURMY_PLANT	{'iconPalIndex': 1, 'footprint': 'gMonFootprint_Burmy', 'teachableLearnset': 'sBurmyTeachableLearnset', 'levelUpLearnset': 'learn:sBurmyLevelUpLearnset', 'types': ('type:BUG',), 'catchRate': 120, 'expYield': 45, 'eggCycles': 15, 'growthRate': 'GROWTH_MEDIUM_FAST', 'eggGroups': '{ EGG_GROUP_BUG, DEFAULT(EGG_GROUP_BUG, ) }', 'abilities': ('ability:SHED_SKIN', 'ability:NONE', 'ability:OVERCOAT'), 'bodyColor': 'BODY_COLOR_GREEN', 'cryId': 'CRY_BURMY', 'natDexNum': 'NATIONAL_DEX_BURMY', 'height': 2, 'weight': 34, 'description': 'If its cloak is even slightly damaged, it\\nwill immediately repair it with whatever is\\nnear at hand. The Pokémon within the cloak\\nis scrawny and vulnerable to the cold.', 'pokemonScale': 682, 'pokemonOffset': 24, 'frontPicSize': 'MON_COORDS_SIZE(32, 56)', 'frontPicYOffset': 13, 'frontAnimFrames': 'sAnims_Burmy', 'frontAnimId': 'ANIM_V_STRETCH', 'enemyMonElevation': 10, 'backPicSize': 'MON_COORDS_SIZE(40, 56)', 'backPicYOffset': 6, 'backAnimId': 'BACK_ANIM_H_SHAKE', 'enemyShadowXOffset': -1, 'enemyShadowYOffset': 8, 'enemyShadowSize': 'SHADOW_SIZE_S', 'teachingType': 1, 'formChangeTable': 'sBurmyFormChangeTable', 'evolutions': '(const struct Evolution[]) { {EVO_LEVEL, 20, species:WORMADAM_PLANT, ((const struct EvolutionParam[]) { {IF_GENDER, MON_FEMALE}, {CONDITIONS_END} })}, {EVO_LEVEL, 20, species:MOTHIM_PLANT, ((const struct EvolutionParam[]) { {IF_GENDER, MON_MALE}, {CONDITIONS_END} })}, { EVOLUTIONS_END }, }', 'art_name': 'BurmyPlant', 'family': 'family:Burmy', 'stats': (40, 29, 45, 29, 45, 36), 'yield': (0, 0, 0, 0, 1, 0), 'name': 'Burmy', 'category': 'Bagworm', 'preparation': 'preparation:BURMY', 'pool': 'learn:pool.BURMY_PLANT'}
species:BURMY_SANDY	{'iconPalIndex': 1, 'footprint': 'gMonFootprint_Burmy', 'teachableLearnset': 'sBurmyTeachableLearnset', 'levelUpLearnset': 'learn:sBurmyLevelUpLearnset', 'types': ('type:BUG',), 'catchRate': 120, 'expYield': 45, 'eggCycles': 15, 'growthRate': 'GROWTH_MEDIUM_FAST', 'eggGroups': '{ EGG_GROUP_BUG, DEFAULT(EGG_GROUP_BUG, ) }', 'abilities': ('ability:SHED_SKIN', 'ability:NONE', 'ability:OVERCOAT'), 'bodyColor': 'BODY_COLOR_BROWN', 'cryId': 'CRY_BURMY', 'natDexNum': 'NATIONAL_DEX_BURMY', 'height': 2, 'weight': 34, 'description': 'It weaves a cloak together with sand, mud,\\nand silk it spits out. This earthen cloak\\nis ruined by wind and rain, so the Pokémon\\nhides away in caves and other such places.', 'pokemonScale': 682, 'pokemonOffset': 24, 'frontPicSize': 'MON_COORDS_SIZE(32, 56)', 'frontPicYOffset': 12, 'frontAnimFrames': 'sAnims_Burmy', 'frontAnimId': 'ANIM_V_STRETCH', 'enemyMonElevation': 10, 'backPicSize': 'MON_COORDS_SIZE(32, 56)', 'backPicYOffset': 7, 'backAnimId': 'BACK_ANIM_H_SHAKE', 'enemyShadowXOffset': -1, 'enemyShadowYOffset': 9, 'enemyShadowSize': 'SHADOW_SIZE_S', 'teachingType': 1, 'formChangeTable': 'sBurmyFormChangeTable', 'evolutions': '(const struct Evolution[]) { {EVO_LEVEL, 20, species:WORMADAM_SANDY, ((const struct EvolutionParam[]) { {IF_GENDER, MON_FEMALE}, {CONDITIONS_END} })}, {EVO_LEVEL, 20, species:MOTHIM_SANDY, ((const struct EvolutionParam[]) { {IF_GENDER, MON_MALE}, {CONDITIONS_END} })}, { EVOLUTIONS_END }, }', 'art_name': 'BurmySandy', 'preparation': 'preparation:BURMY_SANDY', 'family': 'family:Burmy', 'stats': (40, 29, 45, 29, 45, 36), 'yield': (0, 0, 0, 0, 1, 0), 'name': 'Burmy', 'category': 'Bagworm', 'pool': 'learn:pool.BURMY_PLANT'}
species:BURMY_TRASH	{'footprint': 'gMonFootprint_Burmy', 'teachableLearnset': 'sBurmyTeachableLearnset', 'levelUpLearnset': 'learn:sBurmyLevelUpLearnset', 'types': ('type:BUG',), 'catchRate': 120, 'expYield': 45, 'eggCycles': 15, 'growthRate': 'GROWTH_MEDIUM_FAST', 'eggGroups': '{ EGG_GROUP_BUG, DEFAULT(EGG_GROUP_BUG, ) }', 'abilities': ('ability:SHED_SKIN', 'ability:NONE', 'ability:OVERCOAT'), 'bodyColor': 'BODY_COLOR_RED', 'cryId': 'CRY_BURMY', 'natDexNum': 'NATIONAL_DEX_BURMY', 'height': 2, 'weight': 34, 'description': 'When confronted by a lack of other\\nmaterials, Burmy will create its cloak\\nusing dust and refuse. The cloak seems to\\nbe more comfortable than one would think.', 'pokemonScale': 682, 'pokemonOffset': 24, 'frontPicSize': 'MON_COORDS_SIZE(32, 56)', 'frontPicYOffset': 8, 'frontAnimFrames': 'sAnims_Burmy', 'frontAnimId': 'ANIM_V_STRETCH', 'enemyMonElevation': 10, 'backPicSize': 'MON_COORDS_SIZE(40, 64)', 'backPicYOffset': 0, 'backAnimId': 'BACK_ANIM_H_SHAKE', 'enemyShadowXOffset': -1, 'enemyShadowYOffset': 13, 'enemyShadowSize': 'SHADOW_SIZE_S', 'teachingType': 1, 'formChangeTable': 'sBurmyFormChangeTable', 'evolutions': '(const struct Evolution[]) { {EVO_LEVEL, 20, species:WORMADAM_TRASH, ((const struct EvolutionParam[]) { {IF_GENDER, MON_FEMALE}, {CONDITIONS_END} })}, {EVO_LEVEL, 20, species:MOTHIM_TRASH, ((const struct EvolutionParam[]) { {IF_GENDER, MON_MALE}, {CONDITIONS_END} })}, { EVOLUTIONS_END }, }', 'art_name': 'BurmyTrash', 'preparation': 'preparation:BURMY_TRASH', 'family': 'family:Burmy', 'stats': (40, 29, 45, 29, 45, 36), 'yield': (0, 0, 0, 0, 1, 0), 'name': 'Burmy', 'category': 'Bagworm', 'pool': 'learn:pool.BURMY_PLANT'}

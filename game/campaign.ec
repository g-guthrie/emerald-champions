text:Braille_Everything	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "EVERYTHING$"'), 'body': ''}
text:Braille_HasMeaning1	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "HAS MEANING$"'), 'body': ''}
text:Braille_Existence	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "EXISTENCE$"'), 'body': ''}
text:Braille_HasMeaning2	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "HAS MEANING$"'), 'body': ''}
text:Braille_BeingAlive	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "BEING ALIVE$"'), 'body': ''}
text:Braille_HasMeaning3	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "HAS MEANING$"'), 'body': ''}
text:Braille_HaveDreams	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "HAVE DREAMS$"'), 'body': ''}
text:Braille_UsePower	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "USE POWER.$"'), 'body': ''}
text:Braille_LetTheTwo	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "LET THE TWO$"'), 'body': ''}
text:Braille_Glittering	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "GLITTERING$"'), 'body': ''}
text:Braille_Stones	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "STONES$"'), 'body': ''}
text:Braille_OneInRed	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "ONE IN RED$"'), 'body': ''}
text:Braille_OneInBlue	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "ONE IN BLUE$"'), 'body': ''}
text:Braille_ConnectThe	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "CONNECT THE$"'), 'body': ''}
text:Braille_Past	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "PAST.$"'), 'body': ''}
text:Braille_TwoFriends	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "TWO FRIENDS$"'), 'body': ''}
text:Braille_Sharing	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "SHARING$"'), 'body': ''}
text:Braille_PowerOpen	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "POWER OPEN$"'), 'body': ''}
text:Braille_AWindowTo	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "A WINDOW TO$"'), 'body': ''}
text:Braille_ANewWorld	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "A NEW WORLD$"'), 'body': ''}
text:Braille_ThatGlows	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "THAT GLOWS.$"'), 'body': ''}
text:Braille_TheNext	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "THE NEXT$"'), 'body': ''}
text:Braille_WorldWaits	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "WORLD WAITS$"'), 'body': ''}
text:Braille_ForYou	{'directives': ('brailleformat 3, 0, 25, 19, 6, 3', '.braille "FOR YOU.$"'), 'body': ''}
text:PetalburgCity_Gym_GiveEnigmaBerry	{'body': "DAD: Hi, {PLAYER}!\\pI just received a very rare BERRY.\\nI'd like you to have it.$"}
text:Route104_PlantBerriesInSoilTakeThis	{'body': "If you see BERRIES growing in loamy\\nsoil, feel free to take them.\\pBut make sure you plant a BERRY in the\\nsame spot. That's common courtesy.\\pHere, I'll share this with you.$"}
text:Route104_TrainersOftenMakeMonHoldBerries	{'body': "The way you look, you must be a\\nTRAINER, no?\\pTRAINERS often make POKéMON hold\\nBERRIES.\\pIt's up to you whether to grow BERRIES\\nor use them.$"}
text:Route111_WateredPlantsEveryDayTakeBerry	{'body': 'I watered the plants every day.\\nThey grew lots of flowers.\\pAnd they gave me lots of BERRIES, too.\\pHere you go!\\nYou can have it!$'}
text:Route111_GoingToTryToMakeDifferentColorBerries	{'body': "I'm going to try really hard and make\\nBERRIES in different colors.\\pI hope you try hard, too!$"}
text:Route111_WhatColorBerriesToLookForToday	{'body': "I wonder what color BERRIES I'll look\\nfor today?$"}
text:Route114_LoveUsingBerryCrushShareBerry	{'body': "I love using the BERRY CRUSH machine,\\nso I'm collecting BERRIES.\\pI'll share one with you, if you'd like.$"}
text:Route114_TryBerryCrushWithFriends	{'body': 'You should try the BERRY CRUSH\\nmachine with your friends.$'}
text:Route114_FunToThinkAboutBerries	{'body': "Which BERRY should be planted?\\nShould you use or hoard BERRIES?\\pIt's fun to think about.$"}
text:Route120_BerriesExpressionOfLoveIsntIt	{'body': "BERRIES grow by soaking up sunlight.\\pWe help the BERRIES grow by watering\\nthem regularly.\\pIt's an expression of love, isn't it?$"}
text:Route120_YesYouUnderstand	{'body': 'Yes, yes.\\nYou understand what I mean.\\pYou should take this.$'}
text:Route120_MakeYourOwnImpressions	{'body': 'Oh… But it is important to make your\\nown impressions, I guess…\\pYou can have this.$'}
text:Route120_BerryIsRareRaiseItWithCare	{'body': 'I think that BERRY is rare.\\nI hope you raise it with loving care.$'}
text:Route120_IllGetMoreBerriesFromBerryMaster	{'body': "I'll get more BERRIES from\\nthe BERRY MASTER.$"}
text:LilycoveCity_BerrySuitsYou	{'body': 'When it gets right down to it…\\pThe same way suits suit me perfectly,\\na crisp breeze suits the sea.\\pAnd you, a BERRY suits you to a “T”…\\pWhy should that be so?$'}
text:LilycoveCity_BecauseYoureTrainer	{'body': "When it gets right down to it…\\pIt's because you're a TRAINER!$"}
text:LilycoveCity_PokeblocksSuitPokemon	{'body': 'When it gets right down to it…\\pThe way dignified simplicity suits me,\\n{POKEBLOCK}S perfectly suit POKéMON.$'}
text:Route123_BerryMastersHouse_YoureDeservingOfBerry	{'body': "You may call me the BERRY MASTER.\\pI dream of filling the world with\\nbeautiful flowers, so I raise BERRIES\\land hand them out to everyone.\\pYou're deserving of one!$"}
text:Route123_BerryMastersHouse_WhyBeStingyTakeAnother	{'body': 'Why be stingy?\\nTake another!$'}
text:Route123_BerryMastersHouse_VisitPrettyPetalFlowerShop	{'body': 'Be sure to visit the PRETTY PETAL\\nflower shop near RUSTBORO.\\pLet flowers fill the world!$'}
text:Route123_BerryMastersHouse_DoneForToday	{'body': "I'm done for today.\\nCome again another day.\\pLet flowers fill the world!$"}
text:Route123_BerryMastersHouse_HeardAGoodSayingLately	{'body': "The way my husband grows BERRIES,\\noh, he's the best in the world.\\pHe makes me proud, that he does.\\pIncidentally, child, have you heard\\na good saying lately?$"}
text:Route123_BerryMastersHouse_InspirationalTakeThis	{'body': 'Ah! What a remarkable saying!\\nInspirational, it is!\\pI want you to have this.$'}
text:Route123_BerryMastersHouse_GoodSayingTakeThis	{'body': "Oh! A good saying it is.\\nYou're quite remarkable.\\pI want you to have this.$"}
text:Route123_BerryMastersHouse_JoyNeverGoesOutOfMyLife	{'body': 'Our four grandchildren should become\\nmore accomplished than my husband.\\pJoy never goes out of my life!$'}
text:Route123_BerryMastersHouse_Ah	{'body': 'Ah…$'}
text:Route104_PrettyPetalFlowerShop_ThisIsPrettyPetalFlowerShop	{'body': 'Hello!\\pThis is the PRETTY PETAL flower shop.\\nSpreading flowers all over the world!$'}
text:Route104_PrettyPetalFlowerShop_LearnAboutBerries	{'body': '{PLAYER}{KUN}, would you like to\\nlearn about BERRIES?$'}
text:Route104_PrettyPetalFlowerShop_IntroLearnAboutBerries	{'body': "Your name is {PLAYER}{KUN}?\\nThat's a nice name.\\pWould you like to learn about\\nBERRIES?$"}
text:Route104_PrettyPetalFlowerShop_BerriesExplanation	{'body': "BERRIES grow on trees that thrive\\nonly in soft, loamy soil.\\pIf you take some BERRIES, be sure to\\nplant one in the loamy soil again.\\pA planted BERRY will soon sprout,\\ngrow into a plant, flower beautifully,\\lthen grow BERRIES again.\\pI want to see the whole wide world\\nfilled with beautiful flowers.\\lThat's my dream.\\pPlease help me, {PLAYER}{KUN}. Plant BERRIES\\nand bring more flowers into the world.$"}
text:Route104_PrettyPetalFlowerShop_FlowersBringHappiness	{'body': "Flowers bring so much happiness to\\npeople, don't they?$"}
text:Route104_PrettyPetalFlowerShop_YouCanHaveThis	{'body': "Hello!\\pThe more attention you give to flowers,\\nthe more beautifully they bloom.\\pYou'll like tending flowers. I'm sure\\nof it. You can have this.$"}
text:Route104_PrettyPetalFlowerShop_WailmerPailExplanation	{'body': "While BERRY plants are growing,\\nwater them with the WAILMER PAIL.\\pOh, another thing.\\pIf you don't pick BERRIES for a while,\\nthey'll drop off onto the ground.\\lBut they'll sprout again.\\pIsn't that awesome?\\nIt's like they have the will to live.$"}
text:Route104_PrettyPetalFlowerShop_ImGrowingFlowers	{'body': "I'm trying to be like my big sisters.\\nI'm growing flowers, too!\\pHere you go!\\nIt's for you!$"}
text:Route104_PrettyPetalFlowerShop_MachineMixesBerries	{'body': 'You can plant a BERRY and grow it big,\\nor you can make a POKéMON hold it.\\pBut now they have a machine that mixes\\nup different BERRIES and makes candies\\lfor POKéMON.\\pI want some candy, too.$'}
text:SootopolisCity_NameIsKiriHaveOneOfThese	{'body': "Hi, what's your name?\\p… … …  … … …  … … …\\nOkay. That's nice!\\pMy name is KIRI.\\pMy mommy and daddy named me that so\\nI would grow healthy and warmhearted.\\lThat's what they wished.\\pYou can have one of these.$"}
text:SootopolisCity_GiveYouThisBerryToo	{'body': 'KIRI will give you this BERRY, too!\\nI really like it lots!$'}
text:SootopolisCity_WhatKindOfWishInYourName	{'body': 'I wonder what kind of wish is included\\nin your name.$'}
text:SootopolisCity_LikeSeasonBornIn	{'body': "Spring, summer, autumn, and winter.\\pIf you're born in springtime, do you like\\nthe spring, and if you're born in the\\lsummer, do you like the summer?$"}
text:SootopolisCity_ThenILoveAutumn	{'body': 'Then KIRI was born in the autumn,\\nso I love the autumn!\\pWhich season do you like?$'}
text:SootopolisCity_OhDoesntMatter	{'body': "Oh…\\nIt doesn't matter…\\pThere's so much that I want to know…$"}
text:ShoalCave_Materials	{'body': 'Bring four SHOAL SALTS and four\\nSHOAL SHELLS from this cave.\\pYour first collection earns GLALITITE,\\na Mega Stone for GLALIE.\\pAfter that, each collection earns\\na BIG PEARL you can sell at a MART.\\pCome speak to me again tomorrow.\\nThen you can collect fresh materials.\\pLook for salt at low tide and\\nshells at high tide.$'}
text:ShoalCave_ConfirmExchange	{'body': 'Trade four SHOAL SALTS and four\\nSHOAL SHELLS for a {STR_VAR_1}?$'}
text:ShoalCave_RewardBag	{'body': 'The materials are perfect!\\nYour {STR_VAR_1} is in your BAG.$'}
text:ShoalCave_RewardPC	{'body': 'The materials are perfect!\\nYour {STR_VAR_1} is in your item PC.$'}
text:ShoalCave_NoRoom	{'body': "Your BAG and item PC are full.\\nKeep your materials until there's room.$"}
text:ShoalCave_Declined	{'body': "No hurry. Bring them back whenever\\nyou're ready to trade.$"}
text:ShoalCave_WasShoalSaltNowNothing	{'body': "There was some SHOAL SALT here.\\nBut, there's nothing here now.$"}
text:ShoalCave_WasShoallShellNowNothing	{'body': "There was a SHOAL SHELL here.\\nBut, there's nothing here now.$"}
text:PictureBookShelf	{'body': "There's a set of POKéMON picture books.$"}
text:BookShelf	{'body': "It's filled with all sorts of books.$"}
text:PokemonCenterBookShelf	{'body': 'POKéMON magazines!\\nPOKéMON PAL…\\pPOKéMON HANDBOOK…\\nADORABLE POKéMON…$'}
text:Vase	{'body': 'This vase looks expensive…\\nPeered inside…\\pBut, it was empty.$'}
text:EmptyTrashCan	{'body': "It's empty.$"}
text:ShopShelf	{'body': 'The shelves brim with all sorts of\\nPOKéMON merchandise.$'}
text:Blueprint	{'body': "A blueprint of some sort?\\nIt's too complicated!$"}
text:MatchCall_WildBattleText1	{'body': "Hi! {PLAYER}{KUN}, hello!\\nThis is {STR_VAR_1}.\\pI saw this {STR_VAR_2} a while back\\nbut I couldn't catch it.\\pIt was so close, too!\\nWell, see you again!$"}
text:MatchCall_WildBattleText2	{'body': "Hello, {PLAYER}{KUN}.\\nIt's {STR_VAR_1}.\\pI tried to catch a nice {STR_VAR_2}\\na little while ago.\\pBut, it got away.\\nI was sure disappointed!\\pOkay, bye!$"}
text:MatchCall_WildBattleText3	{'body': "Hey there, {PLAYER}!\\nIt's me, {STR_VAR_1}.\\pI just took a shot at catching\\nthis {STR_VAR_2}, but it took off.\\pI came oh so close, too!\\pIt spoiled my day…\\nAll right, see you!$"}
text:MatchCall_WildBattleText4	{'body': "Hey, {PLAYER}{KUN}.\\n{STR_VAR_1} here.\\pYou know the POKéMON {STR_VAR_2}?\\nI came close to getting one.\\pIt was just a while back.\\nI thought I had it but it escaped.\\pIf I see it again, I'll get it for\\nsure, though.\\pOkay, catch you later.$"}
text:MatchCall_WildBattleText5	{'body': "Hiya, {PLAYER}{KUN}!\\nIt's {STR_VAR_1}.\\lCatching any POKéMON lately?\\pA little while ago I came close to\\nnabbing one, but it got loose.\\pRight, take care!$"}
text:MatchCall_WildBattleText6	{'body': 'Hey, {PLAYER}{KUN}.\\n{STR_VAR_1} here.\\lCaught any POKéMON lately?\\pI nearly nabbed one the other day.\\nBut it evaded me somehow.\\pYou take care.$'}
text:MatchCall_WildBattleText7	{'body': "…Uh, {PLAYER}{KUN}?\\nIt's me, {STR_VAR_1}.\\pOh, wait! Wait!\\nI can catch this {STR_VAR_2}…\\pAaarrrgh! It bolted loose!\\nThat wasn't just close!$"}
text:MatchCall_WildBattleText8	{'body': 'Oh, {PLAYER}{KUN}, how do you do?\\nThis is {STR_VAR_1} speaking.\\pHave you had success catching\\nPOKéMON lately?\\pI came very close a little while\\nago, but my target got free.\\pI need to try harder!\\nSee you again!$'}
text:MatchCall_WildBattleText9	{'body': "Oh, {PLAYER}{KUN}, hi there!\\nThis is {STR_VAR_1}!\\pSo? Are you getting more POKéMON\\ntogether?\\pI'm having a rotten time of it!\\nThey all get away from me!\\pSee you!$"}
text:MatchCall_WildBattleText10	{'body': 'Oh, {PLAYER}{KUN}, hello…\\nThis is {STR_VAR_1}.\\pListen, I came within a whisker of\\ncatching this {STR_VAR_2}…\\pBut, it gave me the slip…\\pI need to try harder.\\nSee you around.$'}
text:MatchCall_WildBattleText11	{'body': 'Ah, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\lHow are things with you?\\pI tried to catch a wild {STR_VAR_2}\\nearlier, but it managed to flee.\\pI feel defeated…$'}
text:MatchCall_WildBattleText12	{'body': "Hello, {PLAYER}{KUN}.\\nIt's me, {STR_VAR_1}.\\lAre you still catching POKéMON?\\pI've been trying to catch them\\nmyself, but it's not so easy.\\pThe way of POKéMON is deep!$"}
text:MatchCall_WildBattleText13	{'body': "Ah, hello, {PLAYER}{KUN}!\\nThis is {STR_VAR_1}!\\lHave you been catching POKéMON?\\pI've been trying to catch them\\nmyself, but with little success.\\pThe way of POKéMON is deep!$"}
text:MatchCall_WildBattleText14	{'body': 'Oh, hi, {PLAYER}{KUN}, how do you do?\\nThis is {STR_VAR_1}.\\pJust now, I tried to catch a cute\\n{STR_VAR_2}.\\pIt got away, though!\\nOh, you bet I was disappointed!\\pBye-bye!$'}
text:MatchCall_WildBattleText15	{'body': "Hey, {PLAYER}!\\nThis is {STR_VAR_1}!\\pI've been thinking about trying\\nto catch me some POKéMON.\\pBut I can't seem to find any.\\nIt's a real puzzler for me!\\pI'm at my wit's end!\\nSee you around!$"}
text:MatchCall_NegativeBattleText1	{'body': 'Hi! {PLAYER}{KUN}, hello!\\nThis is {STR_VAR_1}.\\pI tried battling another TRAINER,\\nbut I lost.\\pIt was really disappointing.\\nWell, see you again!$'}
text:MatchCall_NegativeBattleText2	{'body': "Hello, {PLAYER}{KUN}.\\nIt's {STR_VAR_1}.\\pI challenged someone else after\\nwe battled.\\pI came close, but I ended up\\nlosing. Oh, well!$"}
text:MatchCall_NegativeBattleText3	{'body': "Hey there, {PLAYER}! It's me,\\n{STR_VAR_1}!\\pI just got cleaned in a battle. I\\nneed to rethink how my partners\\lwork together!$"}
text:MatchCall_NegativeBattleText4	{'body': "Hey, {PLAYER}. {STR_VAR_1} here.\\pI tried another battle yesterday,\\nbut I couldn't pull out the win.\\pI'm trying a different lead pair.\\nOkay, catch you later.$"}
text:MatchCall_NegativeBattleText5	{'body': "Hiya, {PLAYER}!\\nIt's {STR_VAR_1}.\\pHow are things with you?\\pI've been battling on,\\nbut I haven't won very often.\\pI can't get it together.\\nRight, take care!$"}
text:MatchCall_NegativeBattleText6	{'body': "Hey, {PLAYER}.\\n{STR_VAR_1} here.\\pHow's it going for you?\\pI've been battling hard lately,\\nbut to little success.\\pI can't get into the groove.\\nYou take care.$"}
text:MatchCall_NegativeBattleText7	{'body': "{STR_VAR_1} here.\\nHow's it going lately?\\pI lost a battle yesterday,\\nand it's filled my thoughts.\\pI have to devise a plan…\\nSee you.$"}
text:MatchCall_NegativeBattleText8	{'body': 'Oh, {PLAYER}{KUN}, how do you do?\\nThis is {STR_VAR_1} speaking.\\pHow are your POKéMON doing?\\nI lost a match the other day.\\pI need to try harder!\\nSee you again!$'}
text:MatchCall_NegativeBattleText9	{'body': 'Oh, {PLAYER}{KUN}, hi there!\\nThis is {STR_VAR_1}!\\pListen, listen, you have to hear\\nthis!\\pI had a POKéMON battle earlier,\\nbut I lost at the last second.\\pOh, it burns me up!$'}
text:MatchCall_NegativeBattleText10	{'body': "Oh, {PLAYER}{KUN}, hello… This is\\n{STR_VAR_1}.\\pI lost a battle earlier. I'm going\\nto review our moves with a TUTOR.\\pSee you around.$"}
text:MatchCall_NegativeBattleText11	{'body': 'Ah, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\lHow are your POKéMON?\\pI just lost yet another battle.\\pWell, see you!$'}
text:MatchCall_NegativeBattleText12	{'body': "Hello, {PLAYER}{KUN}.\\nIt's me, {STR_VAR_1}.\\lAre you still battling hard?\\pAs for me, I lost recently, so I've\\nbeen training my team all over.\\pLet's meet again.$"}
text:MatchCall_NegativeBattleText13	{'body': "Ah, hello, {PLAYER}{KUN}!\\nThis is {STR_VAR_1}!\\pI hope you've been keeping well.\\pI was in a battle just a little\\nwhile before this.\\p{PLAYER}{KUN}, try to be active like me.\\nSee you again!$"}
text:MatchCall_NegativeBattleText14	{'body': 'Oh, hi, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\pAre you doing good?\\pYou should go home every so often,\\nthough.\\pBye-bye!$'}
text:MatchCall_PositiveBattleText1	{'body': 'Hi! {PLAYER}{KUN}, hello!\\nThis is {STR_VAR_1}!\\pI battled another TRAINER earlier.\\nI won! I won!\\pMy {STR_VAR_2} really worked hard\\nfor me. This is so great!$'}
text:MatchCall_PositiveBattleText2	{'body': "Hello, {PLAYER}{KUN}!\\nIt's {STR_VAR_1}!\\pI had a battle yesterday and\\nI won! It's fantastic!$"}
text:MatchCall_PositiveBattleText3	{'body': "Hey there, {PLAYER}!\\nIt's me, {STR_VAR_1}!\\lHow's your battling?\\pMe, I had a battle the other day,\\nand my {STR_VAR_2} came up huge!\\pThat win proved our practice is\\nworking. I had to tell you!$"}
text:MatchCall_PositiveBattleText4	{'body': 'Hey, {PLAYER}.\\n{STR_VAR_1} here.\\pI had a match earlier.\\nI managed to win, but it was close.\\pMy {STR_VAR_2} put on one\\ninspired showing.$'}
text:MatchCall_PositiveBattleText5	{'body': "Hiya, {PLAYER}{KUN}!\\nIt's {STR_VAR_1}.\\pHow are things with you?\\nBattling much?\\pI just won a while back!\\nMy {STR_VAR_2} was brilliant!\\pI'm writing down what worked.\\nRight, take care!$"}
text:MatchCall_PositiveBattleText6	{'body': "Hey, {PLAYER}{KUN}.\\n{STR_VAR_1} here.\\pHow's it going for you?\\pI've been riding a hot streak.\\nWhy, I just won a battle.\\pMy team's rhythm is finally\\ncoming together!$"}
text:MatchCall_PositiveBattleText7	{'body': '{PLAYER}{KUN}?\\n{STR_VAR_1} here.\\pMy {STR_VAR_2} is a force!\\nIt won me another battle just now!\\pI wanted you to hear that our\\ntraining is paying off.$'}
text:MatchCall_PositiveBattleText8	{'body': "Oh, {PLAYER}{KUN}, how do you do?\\nThis is {STR_VAR_1} speaking.\\pI hope you've been well.\\nI wanted to tell you I just won.\\pMy {STR_VAR_2} worked especially\\nhard to get the win.\\pSee you again!$"}
text:MatchCall_PositiveBattleText9	{'body': "Oh, {PLAYER}{KUN}, hi there!\\nThis is {STR_VAR_1}!\\pHow are your POKéMON holding up?\\nMine just won a battle!\\pMy {STR_VAR_2} was spectacular,\\nI must say!\\pI wish I could've shown you!\\nSee you again!$"}
text:MatchCall_PositiveBattleText10	{'body': 'Oh, {PLAYER}{KUN}, hello…\\nThis is {STR_VAR_1}.\\pHow has life been treating you?\\pMy POKéMON appear to be charged\\nwith energy.\\pI just won a battle with them.\\nSee you around.$'}
text:MatchCall_PositiveBattleText11	{'body': "Ah, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\pBeen in any battles lately?\\nI just won another one today!\\pI'm on a roll! Gahahaha!\\nWell, see you!$"}
text:MatchCall_PositiveBattleText12	{'body': "Hello, {PLAYER}{KUN}.\\nIt's me, {STR_VAR_1}.\\pI trust you've been well?\\nI'm still bursting with life!\\pWhy, just now, I won another match.\\nI'm not stepping aside to you\\lyoungsters yet!$"}
text:MatchCall_PositiveBattleText13	{'body': "Ah, hello, {PLAYER}{KUN}!\\nThis is {STR_VAR_1}!\\pI hope you've been keeping well.\\nI still have a bounce in my step!\\pWhy, I just won a battle yet again.\\nOh, I won't lose to young people\\lquite yet!\\pSee you again!$"}
text:MatchCall_PositiveBattleText14	{'body': 'Oh, hi, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\pI was in a battle recently, and my\\n{STR_VAR_2} was exceptional!\\pI wish you could have seen it,\\n{PLAYER}{KUN}. Bye-bye!$'}
text:MatchCall_SameRouteBattleRequestText1	{'body': "Hi! {PLAYER}, hello!\\nThis is {STR_VAR_1}.\\pHuh? Wait, you're near\\n{STR_VAR_2}?\\pOh, wow, we have to battle, then!\\nI'll be waiting! See you!$"}
text:MatchCall_SameRouteBattleRequestText2	{'body': "Hello, {PLAYER}!\\nIt's {STR_VAR_1}.\\pOh? You happen to be around\\n{STR_VAR_2} right now?\\pWould you like to battle now?\\nI'll wait for you! See you!$"}
text:MatchCall_SameRouteBattleRequestText3	{'body': "Hey there, {PLAYER}!\\nIt's me, {STR_VAR_1}.\\pOh, hey, are you near\\n{STR_VAR_2} right now?\\pHow would you like to battle with\\nme right now?\\pI'm not losing again!\\nI'll be waiting! Catch you soon!$"}
text:MatchCall_SameRouteBattleRequestText4	{'body': "Hey, {PLAYER}{KUN}.\\n{STR_VAR_1} here.\\pWhereabouts are you now?\\nHuh? {STR_VAR_2}?\\pWant to battle now?\\nI'll wait for you. See you!$"}
text:MatchCall_SameRouteBattleRequestText5	{'body': "Hiya, {PLAYER}{KUN}!\\nIt's {STR_VAR_1}.\\lHow are things with you?\\pYou're where now?\\n{STR_VAR_2}?\\pWell, how about we have a quick\\nrematch right away?\\pI'll keep an eye out for you.\\nSee you soon!$"}
text:MatchCall_SameRouteBattleRequestText6	{'body': "Hey, {PLAYER}{KUN}.\\n{STR_VAR_1} here.\\lHow are your POKéMON keeping?\\pOh, is that right? You're around\\n{STR_VAR_2}?\\pWell, then, we'd better have\\na rematch.\\pI can wait, sure.\\nSee you!$"}
text:MatchCall_SameRouteBattleRequestText7	{'body': "…Er, {PLAYER}{KUN}?\\n{STR_VAR_1} here…\\pOh, you happen to be around\\n{STR_VAR_2}?\\pThen, let's battle.\\nRight away, I mean.\\pI'll show you my POKéMON.\\nI'll wait for you.$"}
text:MatchCall_SameRouteBattleRequestText8	{'body': "Oh, {PLAYER}{KUN}, how do you do?\\nThis is {STR_VAR_1} speaking.\\pI hope you're doing well.\\nOh, you're near {STR_VAR_2}.\\pWould you like to have a battle\\nwith me, then?\\pI'll wait for you.\\nSee you soon!$"}
text:MatchCall_SameRouteBattleRequestText9	{'body': "Oh, {PLAYER}{KUN}, hi there!\\nThis is {STR_VAR_1}!\\pAre you keeping up?\\nOh, you're near {STR_VAR_2}?\\pOh, well, then don't you think we\\nshould battle?\\pDon't keep me waiting too long!$"}
text:MatchCall_SameRouteBattleRequestText10	{'body': "Oh, {PLAYER}{KUN}, hello…\\nThis is {STR_VAR_1}.\\pHow are things with you?\\nOh, you're near {STR_VAR_2}.\\pWe should have a battle now, then.\\pI'm ready and waiting.\\nBe quick!$"}
text:MatchCall_SameRouteBattleRequestText11	{'body': "Ah, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\pAh, so where you are now is\\n{STR_VAR_2}?\\pWell, then, we just have to have\\na battle, don't you think?\\pI'll wait around for you!\\nSee you real quick!$"}
text:MatchCall_SameRouteBattleRequestText12	{'body': "Hello, {PLAYER}{KUN}.\\nIt's me, {STR_VAR_1}.\\lWhere might you be now?\\p{STR_VAR_2}?\\nThat's quite close by!\\pWhat do you say we have a battle\\nnow?\\pI can wait.\\nSee you!$"}
text:MatchCall_SameRouteBattleRequestText13	{'body': "Ah, hello, {PLAYER}{KUN}!\\nThis is {STR_VAR_1}!\\pI hope you've been keeping well.\\nOh, you're near {STR_VAR_2}?\\pSince that's not very far away,\\ncome see me for a battle.\\pI'll wait for you.\\nBye for now.$"}
text:MatchCall_SameRouteBattleRequestText14	{'body': "Oh, hi, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\pYou're what? …{STR_VAR_2}?\\nThat's very close.\\pDon't you think we ought to have\\na battle?\\pI'll be looking for you!\\nBye-bye!$"}
text:MatchCall_DifferentRouteBattleRequestText1	{'body': "Hi! {PLAYER}, hello!\\nThis is {STR_VAR_1}.\\pWant to have a battle with me?\\pI'll be waiting for you around\\n{STR_VAR_2}!$"}
text:MatchCall_DifferentRouteBattleRequestText2	{'body': "Hello, {PLAYER}!\\nIt's {STR_VAR_1}.\\pWould you like to have a battle\\nwith me again?\\pYou can find me around\\n{STR_VAR_2}. I'll be waiting!$"}
text:MatchCall_DifferentRouteBattleRequestText3	{'body': "Hey there, {PLAYER}!\\nIt's me, {STR_VAR_1}.\\pMy POKéMON have grown a lot\\ntougher since last time.\\pI want to see how strong they've\\nbecome with your POKéMON, {PLAYER}.\\pSo, let's have a battle!\\pI'll be waiting for you around\\n{STR_VAR_2}.$"}
text:MatchCall_DifferentRouteBattleRequestText4	{'body': "Hey, {PLAYER}{KUN}.\\n{STR_VAR_1} here.\\lHow are things with you?\\pMy POKéMON have grown pretty\\ntough lately.\\pHey, how would you like to have\\nanother battle with me?\\pLet's meet up around\\n{STR_VAR_2}, okay?$"}
text:MatchCall_DifferentRouteBattleRequestText5	{'body': "Hiya, {PLAYER}{KUN}!\\nIt's {STR_VAR_1}.\\pMy POKéMON are growing up in\\ndecent ways.\\pI'd really like to have another\\nbattle with you.\\pI'll keep an eye out for you around\\n{STR_VAR_2}. See you soon!$"}
text:MatchCall_DifferentRouteBattleRequestText6	{'body': "Hey, {PLAYER}{KUN}.\\n{STR_VAR_1} here.\\lI hope you're on top of things.\\pI was thinking I'd like another\\nbattle with you. What do you say?\\pIf you feel like a battle,\\ncome to {STR_VAR_2}.\\pSee you!$"}
text:MatchCall_DifferentRouteBattleRequestText7	{'body': "…Er, {PLAYER}{KUN}?\\n{STR_VAR_1} here…\\lSo? Are your POKéMON growing?\\pMine sure got stronger.\\nI'd like to show you.\\pI'll be around {STR_VAR_2}.\\nCome see me for a match.\\pSee you around.$"}
text:MatchCall_DifferentRouteBattleRequestText8	{'body': "Oh, {PLAYER}{KUN}, how do you do?\\nThis is {STR_VAR_1} speaking.\\pI hope you're doing well.\\nMy POKéMON are very frisky.\\pIf you're ever in the area, please\\ngive me a rematch.\\pI'll be around {STR_VAR_2}.\\nUntil then, good-bye!$"}
text:MatchCall_DifferentRouteBattleRequestText9	{'body': "Oh, {PLAYER}{KUN}, hi there!\\nThis is {STR_VAR_1}!\\lHow are your POKéMON doing?\\pMy POKéMON keep getting better.\\nI'd like to show you, {PLAYER}{KUN}.\\pI'm around {STR_VAR_2} now,\\nso let's battle if you're close by.\\pHope I see you soon!$"}
text:MatchCall_DifferentRouteBattleRequestText10	{'body': "Oh, {PLAYER}{KUN}, hello…\\nThis is {STR_VAR_1}.\\lSo, how are things with you?\\pMy POKéMON have grown much\\nstronger than before.\\pI'd love another battle with you,\\n{PLAYER}{KUN}.\\pI'll be around {STR_VAR_2}.\\nCome see me if you're close.$"}
text:MatchCall_DifferentRouteBattleRequestText11	{'body': "Ah, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\lWhere might you be now?\\pMy POKéMON are full of life.\\nThey appear to be looking forward\\lto seeing your POKéMON, {PLAYER}{KUN}.\\pI'm around {STR_VAR_2} now.\\nI hope you'll seek us out.$"}
text:MatchCall_DifferentRouteBattleRequestText12	{'body': "Hello, {PLAYER}{KUN}.\\nIt's me, {STR_VAR_1}.\\pI should tell you, my POKéMON have\\ngrown to be quite robust lately.\\pI would like to see them in a battle\\nwith you, {PLAYER}{KUN}.\\pWe'll be around {STR_VAR_2}.\\nCome see us anytime!$"}
text:MatchCall_DifferentRouteBattleRequestText13	{'body': "Ah, hello, {PLAYER}{KUN}!\\nThis is {STR_VAR_1}!\\lAre your POKéMON keeping well?\\pMy POKéMON have been so healthy,\\nthey don't look capable of losing!\\pI would surely love to have another\\nbattle with you.\\pIf you're near {STR_VAR_2},\\ndo come see us.$"}
text:MatchCall_DifferentRouteBattleRequestText14	{'body': "Oh, hi, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\lKeeping well, I hope.\\pOh, yes! My POKéMON are\\nmuch stronger than before.\\pDon't you think we ought to have\\na battle, {PLAYER}{KUN}?\\pWe'll be waiting for you around\\n{STR_VAR_2}.\\pCome see us anytime, okay?$"}
text:MatchCall_PersonalizedText1	{'body': "It's me, the mountain-loving\\n{STR_VAR_1}!\\pWell, since we met, have you grown\\nto appreciate the mountains more?\\pI rarely see you in the mountains…\\pNext time, we'll meet somewhere\\naround {STR_VAR_2}.$"}
text:MatchCall_PersonalizedText2	{'body': "This is {STR_VAR_1}.\\nHello.\\pI was just telling a new TRAINER\\nabout you.\\pI told her about a strong TRAINER\\nwho raises POKéMON with care.\\pI hope you'll become a TRAINER\\nthat everyone will admire.\\pI hope we meet again!$"}
text:MatchCall_PersonalizedText3	{'body': "Hello! It's {STR_VAR_1}.\\pI love where I am now.\\nIt's pleasant with sweet aromas!\\pI think someone planted BERRIES,\\nand they burst into bloom.\\pSee you again sometime!$"}
text:MatchCall_PersonalizedText4	{'body': "Hello! Thirty years of exploration,\\n{STR_VAR_1} at your service!\\pIt seems that you're energetically\\ntraveling here and there.\\pHave you discovered any new ruins?\\nPlease tell if you have!\\pNow, if you'll excuse me,\\nI have ruins to explore.$"}
text:MatchCall_PersonalizedText5	{'body': "It's {STR_VAR_1}!\\pKnow what I'm doing today?\\nLooking at waves from the beach!\\pSigh… The waves are all sparkly.\\nThe sea is the prettiest from here.\\lI'm getting hungry, so bye-bye!$"}
text:MatchCall_PersonalizedText6	{'body': "Munch-chew…\\nOh, hi, it's {STR_VAR_1}.\\lI love eating on the beach.\\pMy POKéMON and I have been doing\\ngreat. We're fully fueled!\\lI'm going for a swim. Bye!$"}
text:MatchCall_PersonalizedText7	{'body': "Hello, this is {STR_VAR_1}…\\pI've grown a little jaded with this\\nwhole COOLTRAINER thing…\\pEveryone thinks I'm a perfect\\nTRAINER, and that makes me try to\\llive up to that expectation.\\pBut I guess that goes with being\\na COOLTRAINER.\\pI'll just have to buckle down…\\nand grin and bear it.\\pYou're the only person that I could\\nconfide in like this.\\pBut when I see you next,\\ndon't worry, I won't whine!$"}
text:MatchCall_PersonalizedText8	{'body': "Yahoo, it's {STR_VAR_1}!\\nHow do you do?\\pI've been raising my POKéMON with\\nlessons from our battle.\\pYour example keeps our training\\nfocused.\\pIsn't it great to have TRAINER\\nfriends? Let's meet again!$"}
text:MatchCall_PersonalizedText9	{'body': "It's {STR_VAR_1}…\\nRight now, behind you…\\lWasn't there something…?\\pThe power of the POKéMON that\\nsleep here at MT. PYRE…\\pIt's telling me about you…\\pYou should walk away quickly and\\nnever once look back…\\pGiggle…\\nFarewell…$"}
text:MatchCall_PersonalizedText10	{'body': "This is {STR_VAR_1}.\\nHow do you do?\\pIsn't it convenient that we can\\nchat like this at a distance?\\pBefore, if I wanted to speak with\\nanyone, I had to have my father\\ldrive me…\\pI should be going now.\\nI'm glad we had this chat.$"}
text:MatchCall_PersonalizedText11	{'body': "It's {STR_VAR_1}!\\nWill you listen to this?\\pI like the SAFARI ZONE a lot,\\nbut whenever I go, I get lost!\\pAll that tall grass!\\nAnd it's much too spread out!\\pI feel better getting that off\\nmy chest!\\pI'm off to the SAFARI ZONE again!\\nCatch you!$"}
text:MatchCall_PersonalizedText12	{'body': "Hello, {STR_VAR_1} here.\\nYes, correct, I am rich, yes.\\pI should tell you, my wealth has\\ngrown since we last met.\\pWhat's more, my POKéMON have also\\ngrown stronger.\\pI can't shake the feeling that\\nthis world exists for me!\\pOh, no need to say a word!\\nEveryone knows it's true!\\pOh, you must excuse me, I have this\\nformal dinner to attend.$"}
text:MatchCall_PersonalizedText13	{'body': "Ufufufufu…\\nIt's me, {STR_VAR_1}…\\pCan you guess what I'm seeing?\\nA pair of {STR_VAR_2} in a battle.\\pMaybe I'll try catching the winner…\\nUfufufufufu…\\pI… I'm kind of busy now.\\nI have to go.$"}
text:MatchCall_PersonalizedText14	{'body': "Oh, it's {STR_VAR_1}!\\pI was just thinking I'm getting\\nbored of the ABANDONED SHIP.\\pBut since I'm already here, I'll\\nlearn every corner of the place.\\pIf you feel compelled, why don't\\nyou come see me?\\pI think today will be the day that\\nI finally challenge the man next\\ldoor to a match.\\pBe seeing you!$"}
text:MatchCall_PersonalizedText15	{'body': "I'm {STR_VAR_1}!\\nThe man of the sea!\\pYou know what I think?\\pThe TRAINERS out at sea are\\nthe toughest of the tough!\\pYou should learn from me and train\\nin the sea…\\pWhoops, giant surf rising!\\pIt's a great training opportunity!\\nSorry, but I have to go!$"}
text:MatchCall_PersonalizedText16	{'body': "It's {STR_VAR_1}! Listen, I've been\\nteaching karate to my POKéMON.\\pBut now they're better than me!\\nI've done nothing but lose to them!\\pBut teaching them has made all of\\nus tougher than before!\\pTraining never ends!\\nUgwaah!$"}
text:MatchCall_PersonalizedText17	{'body': "It's me, {STR_VAR_1}.\\nHow're your travels unwinding?\\p…Whoa, is that right?\\nSounds awfully stimulating!\\pI think I could write a song about\\none of your episodes.\\p…Oh, hey, I'm feeling it.\\nI hear the riffs in my head.\\pI'd better get this tune properly\\nwritten, so I've got to fly! Later!$"}
text:MatchCall_PersonalizedText18	{'body': "This is {STR_VAR_1}…\\nHear my new song.\\pLalala, {STR_VAR_2}, {STR_VAR_2}!\\nWhy are you that {STR_VAR_2}?\\lWhy can't I be you, {STR_VAR_2}?\\lLala, {STR_VAR_2} and {STR_VAR_1},\\l{STR_VAR_1} and {STR_VAR_2}…\\pRepeat chorus, fade…$"}
text:MatchCall_PersonalizedText19	{'body': "I'm {STR_VAR_1}, you know,\\nthe camping expert!\\pWhen we battled, I couldn't help\\nbut lose to you.\\pAfter all, my expertise is in\\ncamping.\\pBut win or lose, I like to battle\\nwhen I'm camping.\\pCome camping with us sometime, okay?\\nI know the best sites!$"}
text:MatchCall_PersonalizedText20	{'body': "It's me, me, {STR_VAR_1}!\\pI'd like to climb other mountains\\nthan this one, to be honest.\\pBut I'm not sure if there'd be any\\nladies like on MT. CHIMNEY.\\pIf you know any other mountain\\nwith ladies around, let me know!\\pEhehehe, see you around!$"}
text:MatchCall_PersonalizedText21	{'body': "… … … … … …\\n… … … … … …\\lIt's {STR_VAR_1}…\\p… … … … … …\\n… … … … … …\\lThat's all today…$"}
text:MatchCall_PersonalizedText22	{'body': "This is {STR_VAR_1}. Today, I had\\nthis feeling I would chat with you.\\pMy desire to defeat you builds\\nby day and by night.\\pYou have a rival like that, yes?\\nI wish it were me…\\pI'm glad you heard me out.\\nSee you!$"}
text:MatchCall_PersonalizedText23	{'body': "It's {STR_VAR_1}.\\pWhen there's a strong TRAINER\\nnearby, I can sometimes sense that\\lsomehow.\\pDid you pass close by, {PLAYER}{KUN}?\\nMaybe it was you.\\pI'll be waiting for your visit.\\nBye!$"}
text:MatchCall_PersonalizedText24	{'body': "Hello, this is {STR_VAR_1}.\\nYou sound well, {PLAYER}{KUN}.\\pI've traveled around the world,\\nbut I must say I've taken a great\\lshine to this region.\\pI plan to stay here a while.\\nPerhaps we can meet again?\\pI still study your dazzling\\ntechniques.\\pI hope our paths cross again.$"}
text:MatchCall_PersonalizedText25	{'body': "Snivel… It's… {STR_VAR_1}…\\n…Sob…\\pROXANNE chewed me out in class\\ntoday.\\pBut I don't dislike her or anything.\\pROXANNE tells me exactly what\\nI did wrong so I can learn from it.\\pYou bet I'll be going to\\nthe TRAINER'S SCHOOL tomorrow!\\pSee you later!$"}
text:MatchCall_PersonalizedText26	{'body': "It's {STR_VAR_1}!\\pROXANNE let me battle with her\\nyesterday.\\pThe results…\\nTerrible, like you needed to ask.\\pBut I was delighted that ROXANNE\\nwould even let me challenge her!\\pYou wouldn't believe how much\\nmore I admire her!\\pI'm going to really focus and work!\\nI'd better go!$"}
text:MatchCall_PersonalizedText27	{'body': "Hi, it's ANNA! I'm with my junior\\npartner MEG again today.\\pI really love caring for MEG and\\nPOKéMON. They're so cute!\\pI wish I could look after them\\nas if they were my siblings!\\pOh, hi, MEG!\\nDid you get the buns?\\pHuh? No, no, I'm not treating you\\nlike my personal slave!\\pYou lost the match, so you have\\nto go buy the bread as punishment!\\pI wouldn't treat you like a slave,\\nMEG! You're too special to me!\\pI have to go now.\\nIt's time for our snack!$"}
text:MatchCall_PersonalizedText28	{'body': "I love POKéMON!\\nIt's {STR_VAR_1} from the FAN CLUB!\\pYou have to hear this!\\nMy sweet POKéMON…\\pSnort! Wahaha!\\nI can't say any more! It's a secret!\\lIt's just too cute for words!\\pOh, my sweet {STR_VAR_2} is begging\\nfor a {POKEBLOCK}!\\pIt's the picture of cuteness!\\pSorry, but I can't talk now!\\nYou'll have to hear this next time!$"}
text:MatchCall_PersonalizedText29	{'body': "Ohoho!\\pThis is {STR_VAR_1}! I can't wait to\\ntell you about my darling POKéMON!\\pPlease, you must listen to this.\\nIt's about my darling {STR_VAR_2}.\\pWhenever anyone picks it up,\\nit leaps straight into my arms!\\pOh… Oh… Could there be anything\\nmore blissful?\\pOh, it feels so heavenly!\\pI'm so glad I could share some of\\nmy happiness with you.\\pWell, I must be going.\\nBye, now!$"}
text:MatchCall_PersonalizedText30	{'body': 'I am… {STR_VAR_1}.\\nPeople call me an EXPERT.\\pBut there is one thing I know.\\nI could not be an EXPERT on my own\\lpower.\\pOnly with the help of POKéMON can\\na TRAINER become an EXPERT.\\pHumph! I believe I may have said\\nsomething deep and profound!\\pI shall leave you in good spirits!$'}
text:MatchCall_PersonalizedText31	{'body': "It's {STR_VAR_1}.\\nI'm glad to chat with you!\\pI am feeling alive and refreshed\\nsoaking in this hot-spring tub.\\pI've been battling young TRAINERS\\nsince we met, but you're still\\lthe best of the lot.\\pI imagine you'll become an EXPERT\\nin your old age! Ohohoho…$"}
text:MatchCall_PersonalizedText32	{'body': "Yay! This is {STR_VAR_1}!\\nWhat's up?\\pI might be imagining this, but when\\nI win battles, my shorts seem to\\lfeel, like, better. Materially.\\pWhat do I mean by that?\\nIt's kind of hard to explain, but…\\lHow would I say this now…\\lMy shorts feel silkier!\\pAnd when I battled you, {PLAYER}{KUN},\\nmy shorts felt icky and coarse.\\p… … … … … …\\nYou didn't really believe that?\\lEhehehe, that's all! Bye now!$"}
text:MatchCall_PersonalizedText33	{'body': "Ahoy!\\n{STR_VAR_1} here!\\pAs always, I'm fishing with wild\\nabandon!\\pAre there other places I can fish\\nthan the sea and rivers?\\pI get these powerful urges to\\nfish just about anywhere!\\pOh, gosh, darn it!\\nMy line's tangled up!\\pGotta go!\\nFind me some new fishing spots!$"}
text:MatchCall_PersonalizedText34	{'body': "Hey, there! It's {STR_VAR_1}.\\nAre you taking it casually?\\pEver since I was a kid, you know,\\nI've always been placid, huh?\\pI never was much for getting all\\nstressed or rushing things.\\pBut wouldn't you know it,\\nI'm now a TRIATHLETE.\\pYou just can't tell where life will\\ntake you, if you get my drift.\\pYou're a TRAINER now, but who\\nknows what the future holds, huh?\\pImagine yourself as a teacher,\\nor maybe an artist. Cool, huh?\\pBut, hey, be cool. Take it casual.\\nSee you around.$"}
text:MatchCall_PersonalizedText35	{'body': "This is {STR_VAR_1}!\\nI'm cycling right now.\\pI love swimming and running,\\nbut cycling is my first love!\\pIt makes my whole body feel as if\\nI'm one with the wind.\\pIt exhilarates me as if I were\\nflying!\\pOkay! Today, I'm going to set a new\\nCYCLING ROAD record!\\pYou should make the challenge, too!\\nSee you!$"}
text:MatchCall_PersonalizedText36	{'body': "Yo, this is {STR_VAR_1}! I'm smack\\nin the middle of a triathlon!\\pBut, hey, I've always got time to\\nshoot the breeze!\\pWorking out with POKéMON feels\\nmighty good!\\pWithout exchanging words, we synch\\nas if we shared a heart.\\pIt's inspiring!\\pGasp… Chatting while running…\\nI'm getting run down…\\lGasp… Have…to…go…$"}
text:MatchCall_PersonalizedText37	{'body': "Hi, it's {STR_VAR_1}.\\nIf you want to improve endurance,\\lhigh-altitude training is it!\\pTry running on a mountaintop.\\nYou'll be gasping in no time!\\pI'm getting oxygen starved, too!\\nSee you!$"}
text:MatchCall_PersonalizedText38	{'body': "Oh, it's {STR_VAR_1}, hello.\\pI've been swimming a lot but I still\\ncan't seem to reach EVERGRANDE.\\pMaybe I'm just going in circles.\\pNo, no, that can't be possible.\\nWahahaha.\\lTake care!$"}
text:MatchCall_PersonalizedText39	{'body': "Hey, it's {STR_VAR_1}…\\nWhoops!\\pSplash!\\pBlug-blug-blug-blug…\\pSploosh!\\pWhiff-whiff! Whiff-whiff!\\pHey! Sorry about that!\\nI just put on some suntan oil.\\pSo my POKéNAV went whoopsy\\nout of my hand into the water!\\pBut, boy, DEVON's POKéNAV is built\\ntough. It survived that dunking!\\pAnyways, I'm busy sunbathing,\\nso let's chat another time.$"}
text:MatchCall_PersonalizedText40	{'body': "Hello, this is {STR_VAR_1}.\\pOut of the three triathlon events,\\nI like swimming best.\\pBut if I stay in the sea too long,\\nwon't I get all prune-like?\\pOoh, triathlon is such a grueling\\ntest of human endurance! Bye!$"}
text:MatchCall_PersonalizedText41	{'body': 'Hello, {PLAYER}{KUN}.\\n{STR_VAR_1} here.\\pHow are your POKéMON doing?\\pMy DRAGON POKéMON appear to be\\nin peak form. Bye for now.$'}
text:MatchCall_PersonalizedText42	{'body': "{STR_VAR_1} here.\\pMy {STR_VAR_2} has grown even more\\ntough than that last time.\\pI'm not going to lose again to you.\\nYou wait till next time!\\pSee you around!$"}
text:MatchCall_PersonalizedText43	{'body': 'It is {STR_VAR_1} here.\\pI have continued with my studies\\nin the art of concealment.\\pBut I have been too successful.\\nNo one has been able to find me.\\lMy success makes me lonely…\\pLike smoke I disappear!\\nFarewell!$'}
text:MatchCall_PersonalizedText44	{'body': 'This is {STR_VAR_1}.\\nI kept up my training since we met.\\pMy {STR_VAR_2} is getting pretty\\ntough.\\pTraining on a beach is effective,\\njust as I thought. Bye now!$'}
text:MatchCall_PersonalizedText45	{'body': "How do you do?\\nThis is {STR_VAR_1}.\\pI wonder when this yucky volcanic\\nash will stop falling?\\pIf it gets too deep, it will cover\\nup the pattern on my parasol…\\pLet's promise to meet again!$"}
text:MatchCall_PersonalizedText46	{'body': "Hi, {STR_VAR_1} here.\\pDid you know that it's easier to\\nfloat in the sea than a pool?\\pJust by lying still, your body will\\nfloat on its own.\\pBut if you float for too long,\\nwatch that you don't get carried\\loff too far out.\\p…Where am I, anyway?\\nI'd better go!$"}
text:MatchCall_PersonalizedText47	{'body': "Oh, {PLAYER}{KUN}, hello!\\nThis is {STR_VAR_1}.\\lI'm up in the mountains now.\\pBut the ground is too bumpy.\\nI can't pitch my tent here…\\pOh, I had a brilliant idea!\\pMaybe I can get my POKéMON to tamp\\nthe ground flat here!\\pI'm going to try that!\\nBye-bye!$"}
text:MatchCall_PersonalizedText48	{'body': "Oh, hi, hi, this is {STR_VAR_1}!\\pI'm raising POKéMON with LIV!\\nWe're trying very hard!\\pIf we try harder, can we become\\nnumber one? Bye-bye!$"}
text:MatchCall_PersonalizedText49	{'body': "{STR_VAR_1} here!\\pI'm a SAILOR, but I'm not on a boat\\nnow.\\pIt makes me wonder--what should\\na SAILOR on land be called?\\pThat's what I've been thinking\\nwhile staring out across the waves.\\pAll right, next time!$"}
text:MatchCall_PersonalizedText50	{'body': "It's {STR_VAR_1}.\\nSo? Get any more POKéMON?\\pIf you catch a new POKéMON,\\nyou have to come show me.\\pI won't whine for it, honest.\\nI'll be waiting. See you.$"}
text:MatchCall_PersonalizedText51	{'body': "This is {STR_VAR_1}.\\pAre you raising your POKéMON\\nin the optimal way?\\pThe air is clean where I am.\\nIt's the perfect environment for\\lraising POKéMON.\\pIf you're going to focus on raising\\nPOKéMON, you should come out to\\l{STR_VAR_2}. Take care now.$"}
text:MatchCall_PersonalizedText52	{'body': 'Hi, this is {STR_VAR_1}.\\pI gave a {POKEBLOCK} to my {STR_VAR_2}.\\nIt seemed to enjoy it very much.\\pIt looks like POKéMON have their\\nlikes and dislikes with {POKEBLOCK}S.\\pI find that quite fascinating.\\nPlease do take care.$'}
text:MatchCall_PersonalizedText53	{'body': "{STR_VAR_1} here.\\pIf you cooperate with POKéMON,\\none can be comfortable in the wild.\\pEveryone should realize that and\\ncooperate with POKéMON more.\\pThat would be ideal.\\nI really think so.\\pI think you're on the right track!\\nCatch you later!$"}
text:MatchCall_PersonalizedText54	{'body': "Hi, it's {STR_VAR_1}. You know,\\nthe TRAINER who's always prepared!\\p{PLAYER}{KUN}, do you have enough items?\\nAre your POKéMON fit for action?\\pKeeping everything perfect around\\nyou all the time is the secret to\\lkeeping your journey going.\\pI'd better go check my own\\nsupplies! Be vigilant!$"}
text:MatchCall_PersonalizedText55	{'body': "It's {STR_VAR_1}!\\nIt's {STR_VAR_1}!\\p{STR_VAR_2} is a very busy\\nthoroughfare, so I get challenged\\lby all kinds of TRAINERS every day.\\pToday, I won five battles and lost\\nonly three!\\pHow did you do today?\\nTell me about it next time, okay?$"}
text:MatchCall_PersonalizedText56	{'body': "It's me, {STR_VAR_1}.\\pI'm popular because I have lots\\nof BUG POKéMON, right?\\pWell, I took a bunch of my fave\\nbugs to school today.\\pThis girl I like started crying!\\nGo ahead and laugh if you want.\\pI have to try teaching her what\\nmakes BUG POKéMON so appealing.\\pSnivel…\\nSee you!$"}
text:MatchCall_PersonalizedText57	{'body': "Hah! Hah! Hah! Hah!\\pHi! It's {STR_VAR_1}! Hah! Hah!\\pTrying to chat…\\nWhile climbing…\\lIs harsh exercise… Hah! Hah!\\pUrgh! Oof…\\nIt's steeper now…\\lWe'll chat…another time…\\lHah! Hah! Hah!$"}
text:MatchCall_PersonalizedText58	{'body': "Oh, hi!\\pI'm still searching for treasures\\nwith KIRA!\\pMaybe there isn't any treasure\\nhere at all…\\pBut the important thing is for me\\nto search alongside KIRA.\\pOh, hey, KIRA!\\nWh-why are you angry?\\pI'm not ignoring you, honey!\\nYou're my one and only!\\p…{PLAYER}, I have to go, bye!$"}
text:MatchCall_PersonalizedText59	{'body': "This is {STR_VAR_1}!\\pI went to DEWFORD's GYM again\\nfor training.\\pBRAWLY, the GYM LEADER, seems\\nto be tougher now.\\pSomething about being toughened\\nby the wild waves…\\pBut he's still as cool as ever.\\nThe ladies adore him!\\lIt makes me envious, frankly.\\pI wonder… Is his friend BRUNO\\nthe same way as BRAWLY?\\pYou know, all sweaty or smelly,\\nand prone to calling people\\l“big wave,” that sort of thing.\\pBut, hey, this jealousy thing isn't\\nvery seemly, is it?\\pForget this chat ever happened,\\nhow about it? So long!$"}
text:MatchCall_PersonalizedText60	{'body': "It's a pleasure to chat with\\na young TRAINER like you.\\pI imagine that you will continue to\\nenjoy POKéMON whatever your age.\\pWouldn't it be good if you had\\na partnership like ours?\\pOf course, {PLAYER}{KUN}, you already\\nenjoy the trust and companionship\\lof your POKéMON now.\\pYou have the makings of long and\\nenduring relationships already!\\pHahaha!\\nNever be discouraged!$"}
text:MatchCall_PersonalizedText61	{'body': "Hi, this is {STR_VAR_1}!\\nWe just won a battle!\\pWe don't win often, but it was this\\ncool SWIMMER guy.\\pMy sister was steamed!\\pShe wanted to pretend that she\\nwas weak to make an impression!\\pShe always chews me out whether\\nwe win or lose!\\p{PLAYER}{KUN}, can you say something\\nto her next time?\\pOkay, see you!$"}
text:MatchCall_PersonalizedText62	{'body': "{STR_VAR_1} here, yes.\\nI headed out to sea yesterday.\\pI had been hoping to find a new\\nruin to explore.\\pBut the tides somehow seemed to\\ncarry me back where I started.\\pI'm still weak at battling, too…\\nFeel free to mock me…\\lBut I won't give up.\\pMy day will come when I discover\\na new ruin!\\pThat's all I have to say!\\nFarewell for now!$"}
text:MatchCall_PersonalizedText63	{'body': "Ahoy there!\\nIt's me, {STR_VAR_1}!\\lI'm out on ROUTE 108 now!\\lIn other words, where I always am!\\pToday, a gorgeous SWIMMER \\nswam by me!\\pSo I startled her with a shout!\\pAnd she gave me a nasty glare!\\pThat's all from ROUTE 108!\\nBrought to you by {STR_VAR_1}!$"}
text:MatchCall_PersonalizedText64	{'body': "It's {STR_VAR_1}!\\pI'm kind of busy, but I figured\\nI should let you know that I've\\lbeaten five TRAINERS again today.\\pIf I keep this pace up, I can\\nprobably beat you next time.\\pI think we'll be good rivals,\\nyou and I. Good-bye for now!$"}
text:MatchCall_BattleFrontierStreakText1	{'body': "Hi! This is {STR_VAR_1}.\\nI heard the news!\\pThey say you did excellent at\\nthe {STR_VAR_2}.\\pIt's awesome, {STR_VAR_3} straight wins?\\nSee you!$"}
text:MatchCall_BattleFrontierStreakText2	{'body': "Hello, it's {STR_VAR_1}!\\nI heard about you!\\pThey said you won {STR_VAR_3} straight\\nbattles at the {STR_VAR_2}.\\pThat's special! I should try\\nharder, too! See you!$"}
text:MatchCall_BattleFrontierStreakText3	{'body': "Hey there, {PLAYER}!\\nIt's me, {STR_VAR_1}.\\pI heard you went on a tear at\\nthe {STR_VAR_2}!\\pA big {STR_VAR_3}-win streak…\\nThat is a big record, isn't it?\\pI'd better get it together, too!\\nCatch you soon!$"}
text:MatchCall_BattleFrontierStreakText4	{'body': "Hey, {PLAYER}{KUN}.\\n{STR_VAR_1} here. What's up?\\pThere's a rumor going around that\\nyou strung together {STR_VAR_3} straight\\lwins at the {STR_VAR_2}.\\pI'd better step it up, too.\\nSee you!$"}
text:MatchCall_BattleFrontierStreakText5	{'body': "Hiya, {PLAYER}{KUN}!\\nIt's {STR_VAR_1}.\\pYou were at the {STR_VAR_2}\\nand won {STR_VAR_3} battles in a row?\\lIsn't that something!\\pI'd better work on my POKéMON more.\\nSee you soon!$"}
text:MatchCall_BattleFrontierStreakText6	{'body': 'Hey, {PLAYER}{KUN}.\\n{STR_VAR_1} here. How are you?\\pBy the way, I heard you pulled off\\nthe feat of {STR_VAR_3} straight wins at\\lthe {STR_VAR_2}.\\pThat inspires me to focus on\\nraising my team.$'}
text:MatchCall_BattleFrontierStreakText7	{'body': '…Er, {PLAYER}{KUN}?\\n{STR_VAR_1} here…\\pOh, yeah, you were over at\\nthe {STR_VAR_2}, right?\\pAnd you won {STR_VAR_3} battles in a row.\\pOh, there goes a rare POKéMON!\\nI have to go!$'}
text:MatchCall_BattleFrontierStreakText8	{'body': "Oh, {PLAYER}{KUN}, how do you do?\\nThis is {STR_VAR_1} speaking.\\lI hope you're doing well.\\pOh, but, you are. I've heard that\\nyou won {STR_VAR_3} matches in a row at\\lthe {STR_VAR_2}.\\pThat's very impressive!\\nI hope you stay successful.$"}
text:MatchCall_BattleFrontierStreakText9	{'body': "Oh, {PLAYER}{KUN}, hi there!\\nThis is {STR_VAR_1}!\\pI heard! Your {STR_VAR_3}-win streak at\\nthe {STR_VAR_2}!\\pThat is so cool!\\nI'd better try harder, too!$"}
text:MatchCall_BattleFrontierStreakText10	{'body': "Oh, {PLAYER}{KUN}, hello…\\nThis is {STR_VAR_1}.\\pYou won {STR_VAR_3} straight battles at\\nthe {STR_VAR_2}?\\pThat's quite the accomplishment.\\nI need to work harder.$"}
text:MatchCall_BattleFrontierStreakText11	{'body': "Ah, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\pI hear you're the terror of\\nthe {STR_VAR_2}?\\pYou won, what, {STR_VAR_3} matches in\\na row?\\pYou're good, you.\\nI wonder how many I can win?$"}
text:MatchCall_BattleFrontierStreakText12	{'body': "Hello, {PLAYER}{KUN}.\\nIt's me, {STR_VAR_1}.\\lAre you keeping well?\\pSomeone passed on word about you.\\nHow you won {STR_VAR_3} straight battles\\lat a place named {STR_VAR_2}?\\pThat's quite the tale.\\nSee you!$"}
text:MatchCall_BattleFrontierStreakText13	{'body': "Ah, hello, {PLAYER}{KUN}!\\nThis is {STR_VAR_1}!\\lI hope you've been keeping well.\\pThey say you won {STR_VAR_3} straight\\nbattles at the {STR_VAR_2}.\\pI admire your energy!\\nBye now.$"}
text:MatchCall_BattleFrontierStreakText14	{'body': "Oh, hi, {PLAYER}{KUN}.\\nThis is {STR_VAR_1}.\\pI heard about you!\\nDidn't you just win {STR_VAR_3} battles in\\la row at the {STR_VAR_2}?\\pYou're an inspiration!\\nBye-bye!$"}

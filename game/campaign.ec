text:EmeraldChampions_ChangeAnotherNature	{'body': 'Change another Nature?$'}
text:EmeraldChampions_NatureEgg	{'body': "An Egg's Nature can't be changed.$"}
text:EmeraldChampions_SpecialistForgetMove	{'body': 'Forgetting a move clears a slot for\\nsomething your team needs more.\\pShall I help a POKéMON forget one?$'}
text:EmeraldChampions_RepelSprayWoreOffUseAgain	{'body': 'The Repel Spray wore off.\\nUse it again?$'}
text:EmeraldChampions_RepelSprayLeftOff	{'body': 'The grass stirs. Wild Pokémon are\\ncoming back.$'}
text:EmeraldChampions_RepelSprayMistedAgain	{'body': '{PLAYER} misted the air again.\\pWild Pokémon will keep their distance\\nfor the next 500 steps.$'}
text:EmeraldChampions_FormGiftOffer	{'body': 'Would you like this prepared\\n{STR_VAR_2} to join you?$'}
text:EmeraldChampions_FormGiftParty	{'body': 'Your new partner joined your party!$'}
text:EmeraldChampions_FormGiftPC	{'body': 'Your new partner was sent to the PC!$'}
text:EmeraldChampions_FormGiftFull	{'body': "There's no room in your party or\\nPC. I'll keep your partner here\\luntil a space opens up.$"}
text:EmeraldChampions_ResearchPartners	{'body': 'Which research partner interests you?$'}
text:EmeraldChampions_BattleBondInfo	{'body': 'Battle Bond boosts Attack, Sp. Atk\\nand Speed once after a knockout.\\pThis GRENINJA keeps its usual form.$'}
text:EmeraldChampions_PartnerInfo	{'body': 'This special partner has enhanced\\nstats and cannot evolve.$'}
text:EmeraldChampions_KubfuInfo	{'body': 'A Dark Scroll and a Water Scroll\\nlead KUBFU to different styles.\\pThis second partner lets you explore\\nboth paths with your original KUBFU.$'}
text:EmeraldChampions_CosmogInfo	{'body': 'COSMOEM evolves into SOLGALEO by\\nday or LUNALA at night.\\pThis second COSMOG lets you\\nexplore both paths. Use your\\lLeveler when ready.$'}
text:EmeraldChampions_ContestServices	{'body': "Would you like help with your\\npartner's appearance or costume?$"}
text:EmeraldChampions_Appearance	{'body': 'Appearance$'}
text:EmeraldChampions_CosplayPartner	{'body': 'Cosplay partner$'}
text:EmeraldChampions_CostumeLessons	{'body': 'Costume lessons$'}
text:EmeraldChampions_AppearanceInfo	{'body': "I style matching colors and trims\\nwithout changing your partner's build.\\pFURFROU trims return to normal with\\ntime or storage. Fresh trims are free.\\pMINIOR keeps its meteor shell here;\\nits matching core appears in battle.$"}
text:EmeraldChampions_DeoxysResearch	{'body': 'Would you like to study your DEOXYS\\nwith our form-changing equipment?$'}
text:EmeraldChampions_FormChooseMon	{'body': 'Which partner would you like to study?$'}
text:EmeraldChampions_FormChooseTarget	{'body': 'Which appearance or form?$'}
text:EmeraldChampions_ConfirmFormChange	{'body': 'Make this change?$'}
text:EmeraldChampions_FormChanged	{'body': "Your partner's new look is ready!$"}
text:EmeraldChampions_FormUnavailable	{'body': "That partner isn't part of this\\nservice. Choose another Pokémon.$"}
text:EmeraldChampions_Bonding	{'body': 'Bonding$'}
text:EmeraldChampions_BondingChooseMon	{'body': 'Whose friendship would you like\\nto adjust?$'}
text:EmeraldChampions_BondingValues	{'body': 'Choose a friendship value.$'}
text:EmeraldChampions_BondingLow	{'body': 'Low (0)$'}
text:EmeraldChampions_BondingThreshold	{'body': 'Evolution threshold$'}
text:EmeraldChampions_BondingMaximum	{'body': 'Maximum (255)$'}
text:EmeraldChampions_BondingDone	{'body': 'Friendship is set. Your Leveler can\\nhelp when evolution conditions are met.$'}
text:EmeraldChampions_BondingUnavailable	{'body': 'Please choose a Pokémon, not an Egg.$'}
text:EmeraldChampions_CenterLocalGuide	{'body': 'I listen for stories about rare\\nPOKéMON around here. Let me tell\\lyou where to look!$'}
text:WantToCut	{'body': 'This tree looks like it can be\\nCUT down!\\pWould you like to CUT it?$'}
text:MonUsedFieldMove	{'body': '{STR_VAR_1} used {STR_VAR_2}!$'}
text:UseBrailleFieldMove	{'body': 'Use {STR_VAR_2}?$'}
text:BrailleFieldMoveLocked	{'body': 'To use {STR_VAR_2}, you need\\nits field licence and required BADGE.$'}
text:CantCut	{'body': 'This tree looks like it can be\\nCUT down!$'}
text:WantToSmash	{'body': 'This rock appears to be breakable.\\nWould you like to use ROCK SMASH?$'}
text:CantSmash	{'body': "It's a rugged rock, but a POKéMON\\nmay be able to smash it.$"}
text:WantToStrength	{'body': "It's a big boulder, but a POKéMON\\nmay be able to push it aside.\\pWould you like to use STRENGTH?$"}
text:MonUsedStrength	{'body': "{STR_VAR_1} used STRENGTH!\\p{STR_VAR_1}'s STRENGTH made it\\npossible to move boulders around!$"}
text:CantStrength	{'body': "It's a big boulder, but a POKéMON\\nmay be able to push it aside.$"}
text:StrengthActivated	{'body': 'STRENGTH made it possible to move\\nboulders around.$'}
text:CantWaterfall	{'body': 'A wall of water is crashing down with\\na mighty roar.$'}
text:WantToWaterfall	{'body': "It's a large waterfall.\\nWould you like to use WATERFALL?$"}
text:MonUsedWaterfall	{'body': '{STR_VAR_1} used WATERFALL.$'}
text:CantDive	{'body': 'The sea is deep here. A POKéMON\\nmay be able to go underwater.$'}
text:WantToDive	{'body': 'The sea is deep here.\\nWould you like to use DIVE?$'}
text:MonUsedDive	{'body': '{STR_VAR_1} used DIVE.$'}
text:CantSurface	{'body': 'Light is filtering down from above.\\nA POKéMON may be able to surface.$'}
text:WantToSurface	{'body': 'Light is filtering down from above.\\nWould you like to use DIVE?$'}
text:FailSweetScent	{'body': "Looks like there's nothing here…$"}
text:WantToRockClimb	{'body': 'The cliff is steep.\\nWould you like to use Rock Climb?$'}
text:MonUsedRockClimb	{'body': '{STR_VAR_1} used Rock Climb!$'}
text:CantRockClimb	{'body': 'The cliff is steep.\\nA Pokémon may be able to climb it.$'}
text:NobodyCanUseFieldMove	{'body': 'Nobody in your party can use\\n{STR_VAR_1}.$'}
text:Bookshelf	{'body': "It's crammed full of POKéMON\\nbooks.$"}
text:NothingButPokemonBooks	{'body': 'Every book on the shelf is about\\nPOKéMON.$'}
text:ATownMap	{'body': 'A TOWN MAP.$'}
text:PokeMartShelf	{'body': 'Wow!\\nTons of POKéMON stuff!$'}
text:DishesPlatesNeatlyLinedUp	{'body': 'Dishes and plates are neatly\\nlined up.$'}
text:Kitchen	{'body': "It smells delicious!\\nSomebody's been cooking here.$"}
text:Dresser	{'body': "It's a nicely made dresser.\\nIt will hold a lot of stuff.$"}
text:Snacks	{'body': "There's a pile of snacks here.$"}
text:PokemartSign	{'body': 'All your item needs fulfilled!\\nPOKéMON MART$'}
text:PokecenterSign	{'body': 'Heal Your POKéMON!\\nPOKéMON CENTER$'}
text:Indigo_UltimateGoal	{'body': 'INDIGO PLATEAU\\pThe ultimate goal of TRAINERS!\\nPOKéMON LEAGUE HQ$'}
text:Indigo_HighestAuthority	{'body': 'INDIGO PLATEAU\\pThe highest POKéMON authority!\\nPOKéMON LEAGUE HQ$'}
text:Food	{'body': 'It should be packed with all kinds\\nof delicious things to eat.$'}
text:Blueprints	{'body': "It's a blueprint of some sort.\\nIt's filled with diagrams and text.$"}
text:Painting	{'body': "It's a pretty picture of a POKéMON.\\nIt looks like it's feeling good.$"}
text:PowerPlantMachine	{'body': 'What could this machine be?\\nBetter not mess around with it!$'}
text:Telephone	{'body': "It's a telephone.\\nBetter not use it.$"}
text:Computer	{'body': "It's all complicated words and\\nnumbers that make no sense…$"}
text:AdvertisingPoster	{'body': "It's an advertising poster about\\nall kinds of products.$"}
text:TastyFood	{'body': 'Oh, that smells tasty!\\nIt might get the stomach growling!$'}
text:TrashBin	{'body': "Inside this…\\n……\\pThere's nothing here!$"}
text:Cup	{'body': "It's a cup with a POKéMON mark\\non it.$"}
text:PolishedWindow	{'body': 'The window is very well polished.$'}
text:BeautifulSkyWindow	{'body': 'Outside the window…\\pThe sky looks fantastically\\nbeautiful.$'}
text:BlinkingLights	{'body': 'Lights in different colors are\\nflashing on and off.$'}
text:NeatlyLinedUpTools	{'body': 'All sorts of tools are lined up\\nneatly.$'}
text:ImpressiveMachine	{'body': "It's a machine of some sort.\\nIt sure is impressive.$"}
text:VideoGame	{'body': "It's the latest video game!\\nIt sure looks fun!$"}
text:Burglary	{'body': 'There are obvious signs of burglary\\nhere…$'}
text:PlayerFacingTVScreen	{'body': "There's a POKéMON on TV!\\nIt looks like it's having fun.$"}
text:gFollowerLovesYou	{'body': '{STR_VAR_1} is regarding you with\\nadoration!$'}
text:gFollowerLostInThought	{'body': '{STR_VAR_1} seems lost in thought.$'}
text:gFollowerDefault	{'body': '{STR_VAR_1} pauses to take in the\\nsurroundings.$'}
text:gWantsToFly	{'body': '{STR_VAR_1} looks up at the\\nsky restlessly.\\pWould you like to use FLY?$'}
text:sMysteryGiftAlteringCave	{'body': 'Thank you for using the MYSTERY\\nGIFT System.\\pThere appears to be a rumor about\\nrare POKéMON sightings.\\pThe sightings reportedly came from\\nthe ALTERING CAVE on ROUTE 103.\\pPerhaps it would be worthwhile for\\nyou to investigate this rumor.$'}
text:sAuroraTicketForYou	{'body': 'Thank you for using the MYSTERY\\nGIFT System.\\pYou must be {PLAYER}.\\nThere is a ticket here for you.$'}
text:sAuroraTicketUseAtPort	{'body': 'It appears to be for use at the\\nLILYCOVE CITY port.\\pWhy not give it a try and see what\\nit is about?$'}
text:sAuroraTicketThankYou	{'body': 'Thank you for using the MYSTERY\\nGIFT System.$'}
text:sAuroraTicketBagFull	{'body': "Oh, I'm sorry, {PLAYER}.\\nYour BAG's KEY ITEMS POCKET is full.\\pPlease store something on your PC,\\nthen come back for this.$"}
text:sMysteryGiftBattleCountCard	{'body': 'Thank you for using the MYSTERY\\nGIFT System.\\pYour BATTLE COUNT CARD keeps\\ntrack of your battle record against\\lTRAINERS with the same CARD.\\pLook for and battle TRAINERS who\\nhave the same CARD as you.\\pYou may check the overall rankings\\nby reading the NEWS.\\pPlease do give it a try!$'}
text:sMysteryGiftBattleCountCard_WonPrize	{'body': 'Thank you for using the MYSTERY\\nGIFT System.\\pCongratulations!\\pYou have won a prize for winning\\nthree battles!\\pWe hope you will be inspired to\\nbattle some more.$'}
text:sMysticTicketForYou	{'body': 'Thank you for using the MYSTERY\\nGIFT System.\\pYou must be {PLAYER}.\\nThere is a ticket here for you.$'}
text:sMysticTicketUseAtPort	{'body': 'It appears to be for use at the\\nLILYCOVE CITY port.\\pWhy not give it a try and see what\\nit is about?$'}
text:sMysticTicketThankYou	{'body': 'Thank you for using the MYSTERY\\nGIFT System.$'}
text:sMysticTicketBagFull	{'body': "Oh, I'm sorry, {PLAYER}.\\nYour BAG's KEY ITEMS POCKET is full.\\pPlease store something on your PC,\\nthen come back for this.$"}
text:sMysteryGiftOldSeaMapForYou	{'body': 'Thank you for using the MYSTERY\\nGIFT System.\\pLet me confirm--you are {PLAYER}?\\pWe received this OLD SEA MAP\\naddressed to you.$'}
text:sMysteryGiftOldSeaMapUseAtPort	{'body': 'It appears to be for use at the\\nLILYCOVE CITY port.\\pWhy not give it a try and see what\\nit is about?$'}
text:sMysteryGiftOldSeaMapThankYou	{'body': 'Thank you for using the MYSTERY\\nGIFT System.$'}
text:sMysteryGiftOldSeaMapBagFull	{'body': "Oh, I'm sorry, {PLAYER}.\\nYour BAG's KEY ITEMS POCKET is full.\\pPlease store something on your PC,\\nthen come back for this.$"}
text:sMysteryGiftEgg	{'body': 'Thank you for using the MYSTERY\\nGIFT System.\\pFrom the POKéMON CENTER we\\nhave a gift--a POKéMON EGG!\\pPlease raise it with love and\\nkindness.$'}
text:sFullParty	{'body': 'Oh, your party appears to be full.\\pPlease come see me after storing\\na POKéMON on a PC.$'}
text:sMysteryGiftStampCard	{'body': 'Thank you for using the STAMP CARD\\nSystem.\\pYou have {STR_VAR_1} more to collect to\\nfill your STAMP CARD.$'}
text:sMysteryGiftVisitingTrainerInstructions	{'body': 'Thank you for using the MYSTERY\\nGIFT System.\\pBy holding this WONDER CARD, you\\nmay take part in a survey at a\\lPOKéMON MART.\\pUse these surveys to invite\\nTRAINERS to SOOTOPOLIS CITY.\\p…Let me give you a secret\\npassword for a survey:\\p“GIVE ME\\nAWESOME TRAINER”\\pWrite that in on a survey and send\\nit to the WIRELESS\\lCOMMUNICATION SYSTEM.$'}
text:sMysteryGiftVisitingTrainerArrived	{'body': 'Thank you for using the MYSTERY\\nGIFT System.\\pA TRAINER has arrived in\\nSOOTOPOLIS CITY looking for you.\\pWe hope you will enjoy\\nbattling the visiting TRAINER.\\pYou may invite other TRAINERS by\\nentering other passwords.\\pTry looking for other passwords\\nthat may work.$'}
text:LilycoveCity_PokemonCenter_1F_ImTheFavorLady	{'body': "I'm the FAVOR LADY…$"}
text:LilycoveCity_PokemonCenter_1F_ObsessedWithThing	{'body': "I've recently developed an obsession\\nfor {STR_VAR_1} things…$"}
text:LilycoveCity_PokemonCenter_1F_ThankYouForLastTime	{'body': 'Oh…\\nThank you for last time…$'}
text:LilycoveCity_PokemonCenter_1F_PlayerGaveMeBadThing	{'body': "Before, I think it was {STR_VAR_3}…\\p{STR_VAR_3} gave me one\\n{STR_VAR_2},\\lsaying it was {STR_VAR_1}.\\pBut it wasn't {STR_VAR_1}.\\nNot in the least bit.$"}
text:LilycoveCity_PokemonCenter_1F_PlayerGaveMeGreatThing	{'body': 'Before, {STR_VAR_3} gave me a very\\n{STR_VAR_1} {STR_VAR_2}.\\pI cherish it now.$'}
text:LilycoveCity_PokemonCenter_1F_WillYouShareThing	{'body': 'Listen, if you have anything that\\nis {STR_VAR_1}, will you share it\\lwith me?$'}
text:LilycoveCity_PokemonCenter_1F_WhatWillYouGiveMe	{'body': '…Really?\\nWhat will you give me?$'}
text:LilycoveCity_PokemonCenter_1F_IsThatSoGoodbye	{'body': "Is that so?\\nThen, it's good-bye…$"}
text:LilycoveCity_PokemonCenter_1F_NotWillingToShare	{'body': "Oh…\\nYou're not willing to share?$"}
text:LilycoveCity_PokemonCenter_1F_IllTryToCherishIt	{'body': "Oh?\\nThat {STR_VAR_2} is {STR_VAR_1}?\\p…Oh, is that right?\\pWell, I owe you a thanks anyway.\\nI'll try to cherish it…$"}
text:LilycoveCity_PokemonCenter_1F_IWillCherishThis	{'body': "Oh…\\pThat's a quite {STR_VAR_1}\\n{STR_VAR_2}…\\pIsn't it nice?\\nIt's so dreamy…\\pThank you…\\nI will cherish this…$"}
text:LilycoveCity_PokemonCenter_1F_IWillTreasureThis	{'body': '…Oh, oh, oh…\\pThis is amazing!\\nThis really is {STR_VAR_1}!\\pI never knew that one {STR_VAR_2}\\ncould be this {STR_VAR_1}!\\pThank you!\\pI will treasure this for the rest\\nof my life!$'}
text:LilycoveCity_PokemonCenter_1F_IllGiveYouThisInReturn	{'body': "I'll give you this wonderful item in\\nreturn for your fabulous gift.\\pI hope you will cherish it…$"}
text:LilycoveCity_PokemonCenter_1F_YouDontHaveSpaceForIt	{'body': "Oh, you can't have it if you don't have\\nthe space for it.\\pPlease come see me when you get\\nyour BAG organized…$"}
text:LilycoveCity_PokemonCenter_1F_ImTheQuizLady	{'body': "I'm the QUIZ LADY!\\nI love quizzes!$"}
text:LilycoveCity_PokemonCenter_1F_WaitingToTakeYourQuiz	{'body': "Oh?\\pI'm waiting for a challenger to answer\\nthe quiz you made.\\pWe can chat another time, okay?$"}
text:LilycoveCity_PokemonCenter_1F_WaitingForChallenger	{'body': "I'm waiting for someone to challenge\\na quiz this {STR_VAR_1} thought up!$"}
text:LilycoveCity_PokemonCenter_1F_TakeQuizChallenge	{'body': 'If you answer correctly, you can win\\nfabulous prizes!\\pWould you like to take the quiz\\nchallenge?$'}
text:LilycoveCity_PokemonCenter_1F_WaitForAnswer	{'body': '… … … … … …\\n… … … … … …$'}
text:LilycoveCity_PokemonCenter_1F_HowBoringBye	{'body': 'Oh, how boring!\\nBye-bye!$'}
text:LilycoveCity_PokemonCenter_1F_YoureGoingToQuit	{'body': "Awww!\\nYou're going to quit?$"}
text:LilycoveCity_PokemonCenter_1F_TakeTheQuizAnotherTime	{'body': 'Please take the quiz challenge\\nanother time!$'}
text:LilycoveCity_PokemonCenter_1F_YouGotItRight	{'body': "You're amazing! You've got it right!\\nYou're one sharp customer!$"}
text:LilycoveCity_PokemonCenter_1F_YouGotItRightYouveWonPersonsPrize	{'body': "Congratulations!\\nYou've got the quiz right!\\pYou've won a prize provided by\\n{STR_VAR_1}!$"}
text:LilycoveCity_PokemonCenter_1F_XReceivedOneY	{'body': '{STR_VAR_1} received\\none {STR_VAR_2}!$'}
text:LilycoveCity_PokemonCenter_1F_YourBagIsFilledUp	{'body': 'Oh? Your BAG is filled up!\\nCome see me when you have room.$'}
text:LilycoveCity_PokemonCenter_1F_WrongTheCorrectAnswerIs	{'body': 'Hmm… Wrong!\\nThe correct answer is “{STR_VAR_3}”!$'}
text:LilycoveCity_PokemonCenter_1F_IGetToKeepPrize	{'body': 'Too bad!\\pI get to keep the quiz prize\\n{STR_VAR_1} now!$'}
text:LilycoveCity_PokemonCenter_1F_MakeYourOwnQuiz	{'body': 'Listen, listen!\\nWould you like to make your own quiz?$'}
text:LilycoveCity_PokemonCenter_1F_MaybeNextTime	{'body': 'Oh, I see…\\nWell, maybe next time!$'}
text:LilycoveCity_PokemonCenter_1F_PickYourPrize	{'body': "Okay, the first thing you have to do\\nis pick the prize for the person that\\lanswers your quiz correctly.\\pBut beware, if the person taking\\nthe quiz can't get it right, I get to\\lkeep the prize!$"}
text:LilycoveCity_PokemonCenter_1F_QuitChoosingPrize	{'body': "If you don't choose a prize,\\nyour quiz can't be made.\\pAre you going to quit making\\nyour quiz?$"}
text:LilycoveCity_PokemonCenter_1F_WriteYourQuiz	{'body': "Oh, how nice!\\nThat's a wonderful prize!\\pNext, you need to write your quiz\\nquestion and its answer.$"}
text:LilycoveCity_PokemonCenter_1F_QuitWritingQuizQuestion	{'body': 'Are you going to quit writing\\nyour quiz question?$'}
text:LilycoveCity_PokemonCenter_1F_QuitWritingQuizAnswer	{'body': 'Are you going to quit choosing\\nyour quiz answer?$'}
text:LilycoveCity_PokemonCenter_1F_IllLookForAChallenger	{'body': "Thank you!\\nYou've put together a nice quiz.\\pI'll go look for someone who'll take\\nyour quiz challenge right away.$"}
text:LilycoveCity_PokemonCenter_1F_ImTheContestLady	{'body': "I'm the CONTEST LADY!\\nI sure do love CONTESTS!$"}
text:LilycoveCity_PokemonCenter_1F_ThankForPokeblock	{'body': 'Thanks for your {POKEBLOCK} before!$'}
text:LilycoveCity_PokemonCenter_1F_MyFriendDisplaysQuality	{'body': "This is my friend {STR_VAR_1}!\\nIt's the epitome of {STR_VAR_2}!\\pBut I think that it will display\\neven more {STR_VAR_2}!$"}
text:LilycoveCity_PokemonCenter_1F_DontHaveAPokeblockCase	{'body': "So, I need your help!\\pPlease, may I have one {POKEBLOCK}?\\nAll I'm asking for is one!\\p…Oh, but…\\nDon't you have a {POKEBLOCK} CASE?\\lThat's no good. Next time, then!$"}
text:LilycoveCity_PokemonCenter_1F_AskingForOnePokeblock	{'body': "So, I need your help!\\pPlease, may I have one {POKEBLOCK}?\\nAll I'm asking for is one!$"}
text:LilycoveCity_PokemonCenter_1F_ICantHaveOnePokeblock	{'body': "Awww!\\nI can't have one {POKEBLOCK}?!$"}
text:LilycoveCity_PokemonCenter_1F_WhatACheapskate	{'body': 'Sheesh!\\nWhat a cheapskate!$'}
text:LilycoveCity_PokemonCenter_1F_IllUseYourPokeblock	{'body': "Yay!\\nThank you!\\pI'll feed my POKéMON your {POKEBLOCK}\\nright away.$"}
text:LilycoveCity_PokemonCenter_1F_NoChangeThanks	{'body': "…It doesn't seem to have changed\\nin any way at all…\\pHmm…\\pOh, well!\\nThank you very much!$"}
text:LilycoveCity_PokemonCenter_1F_ReallyImprovedThanks	{'body': "Oh, yay!\\nIt's really delighted!\\pI think it really improved {STR_VAR_1}'s\\n{STR_VAR_2} quality, too.\\pThank you so much!$"}
text:LilycoveCity_PokemonCenter_1F_ReadyToEnterContests	{'body': "Hmm…\\pI think we may be ready to enter\\nsome CONTESTS.\\pIf you see us in one somewhere,\\nI hope you'll cheer for us.$"}
text:LilycoveCity_PokemonCenter_1F_Zigzagoon	{'body': '{STR_VAR_1}: Guguuh!$'}
text:LilycoveCity_PokemonCenter_1F_Kecleon	{'body': '{STR_VAR_1}: Igigigiiih!$'}
text:LilycoveCity_PokemonCenter_1F_Poochyena	{'body': '{STR_VAR_1}: Baaarun…$'}
text:LilycoveCity_PokemonCenter_1F_Pikachu	{'body': '{STR_VAR_1}: Pikka!$'}
text:LilycoveCity_PokemonCenter_1F_Skitty	{'body': '{STR_VAR_1}: Umyaaaan!$'}
text:gHowMayIServeYou	{'body': 'Welcome!\\pHow may I serve you?$'}
text:gPleaseComeAgain	{'body': 'Please come again!$'}
text:gPlayerWhatCanIDoForYou	{'body': '{PLAYER}{KUN}, welcome!\\pWhat can I do for you?$'}
text:MauvilleCity_PokemonCenter_1F_WantToTradeDecor	{'body': "Hi, I'm the TRADER.\\nWant to trade decorations with me?$"}
text:MauvilleCity_PokemonCenter_1F_TraderFeelingTheBlues	{'body': "Oh…\\nYou've left me feeling the blues…$"}
text:MauvilleCity_PokemonCenter_1F_WeveAlreadyTraded	{'body': "But we've traded decorations already,\\nyou and I.$"}
text:MauvilleCity_PokemonCenter_1F_PickADecorItem	{'body': 'If you see any decorative item that\\nyou want of mine, speak up.$'}
text:MauvilleCity_PokemonCenter_1F_YouDontWantAnything	{'body': "You don't want anything?\\nI feel unwanted…$"}
text:MauvilleCity_PokemonCenter_1F_OnceBelongedToPlayerDoYouWantIt	{'body': 'That decorative item once belonged\\nto {STR_VAR_1}.\\pDo you want it?$'}
text:MauvilleCity_PokemonCenter_1F_YouDontHaveAnyDecor	{'body': "Uh… Wait a second. You don't have a\\nsingle piece of decoration!$"}
text:MauvilleCity_PokemonCenter_1F_PickTheDecorToTrade	{'body': "Okay, pick the decoration that you'll\\ntrade to me.$"}
text:MauvilleCity_PokemonCenter_1F_YouDontWantToTrade	{'body': "You won't trade with me?\\nI feel unwanted…$"}
text:MauvilleCity_PokemonCenter_1F_YouveNoRoomForThis	{'body': "You've got all the {STR_VAR_2}S that can\\nbe stored. You've no room for this.$"}
text:MauvilleCity_PokemonCenter_1F_SoWellTradeTheseDecor	{'body': "Okay, so we'll trade my {STR_VAR_3}\\nfor your {STR_VAR_2}?$"}
text:MauvilleCity_PokemonCenter_1F_ThatDecorIsInUse	{'body': "That piece of decoration is in use.\\nYou can't trade it.$"}
text:MauvilleCity_PokemonCenter_1F_SendDecorToYourPC	{'body': "Then we'll trade!\\nI'll send my decoration to your PC.$"}
text:MauvilleCity_PokemonCenter_1F_CantTradeThatOne	{'body': "Oops! Sorry! That's a really rare\\npiece of decoration.\\lI can't trade that one away!\\pCan I interest you in something else?$"}
text:MauvilleCity_PokemonCenter_1F_WillYouHearMyTale	{'body': "I'm the STORYTELLER.\\nI'll tell you tales of legendary\\lTRAINERS.\\pWill you hear my tale?$"}
text:MauvilleCity_PokemonCenter_1F_StorytellerFeelingTheBlues	{'body': "Oh…\\nYou've left me feeling the blues…$"}
text:MauvilleCity_PokemonCenter_1F_WhichTaleToTell	{'body': 'I know of these legends.\\nWhich tale will you have me tell?$'}
text:MauvilleCity_PokemonCenter_1F_IKnowNoTales	{'body': 'But, I know of no legendary TRAINERS.\\nHence, I know no tales.\\pWhere does one find a TRAINER worthy\\nof a legendary tale?$'}
text:MauvilleCity_PokemonCenter_1F_YouDidStatXTimes	{'body': "What's that?!\\nYou… You…\\p{STR_VAR_2}\\n{STR_VAR_1} time(s)?!\\pThat is indeed magnificent!\\nIt's the birth of a new legend!$"}
text:MauvilleCity_PokemonCenter_1F_CouldThereBeOtherLegends	{'body': 'It gets me thinking, could there be\\nother TRAINERS with more impressive\\llegends awaiting discovery?$'}
text:MauvilleCity_PokemonCenter_1F_HaveYouAnyLegendaryTales	{'body': 'Are you a TRAINER?\\pThen tell me, have you any tales that\\nare even remotely legendary?$'}
text:MauvilleCity_PokemonCenter_1F_HearAnotherLegendaryTale	{'body': 'Incidentally… Would you care to hear\\nanother legendary tale?$'}
text:MauvilleCity_PokemonCenter_1F_NotWorthyOfLegend	{'body': "Hmm…\\nI'm not satisfied…\\pI wish you would bring me news worthy\\nof being called a legend.$"}
text:MauvilleCity_PokemonCenter_1F_IWishMorePeopleWereInterested	{'body': 'I wish more people would be interested\\nin hearing my epic tales of legendary\\lTRAINERS.$'}
text:MauvilleCity_PokemonCenter_1F_SavedGameTitle	{'body': 'The Save-Happy TRAINER$'}
text:MauvilleCity_PokemonCenter_1F_SavedGameAction	{'body': 'Saved the game$'}
text:MauvilleCity_PokemonCenter_1F_SavedGameStory	{'body': 'This is a tale of a TRAINER\\nnamed {STR_VAR_3}.\\pThis TRAINER saved the game\\n{STR_VAR_1} times!\\pA more cautious TRAINER than\\n{STR_VAR_3} one will never find!$'}
text:MauvilleCity_PokemonCenter_1F_TrendsStartedTitle	{'body': 'The Trendsetter TRAINER$'}
text:MauvilleCity_PokemonCenter_1F_TrendsStartedAction	{'body': 'Started trends$'}
text:MauvilleCity_PokemonCenter_1F_TrendsStartedStory	{'body': 'This is a tale of a TRAINER\\nnamed {STR_VAR_3}.\\pThis TRAINER started new trends\\n{STR_VAR_1} times!\\p{STR_VAR_3} is setting trends for all\\nthe HOENN region!$'}
text:MauvilleCity_PokemonCenter_1F_BerriesPlantedTitle	{'body': 'The BERRY-Planting TRAINER$'}
text:MauvilleCity_PokemonCenter_1F_BerriesPlantedAction	{'body': 'Planted BERRIES$'}
text:MauvilleCity_PokemonCenter_1F_BerriesPlantedStory	{'body': 'This is a tale of a TRAINER\\nnamed {STR_VAR_3}.\\pThis TRAINER planted BERRIES\\n{STR_VAR_1} times!\\p{STR_VAR_3} is a legendary lover of\\nBERRIES!$'}
text:MauvilleCity_PokemonCenter_1F_BikeTradesTitle	{'body': 'The BIKE-Loving TRAINER$'}
text:MauvilleCity_PokemonCenter_1F_BikeTradesAction	{'body': 'Traded BIKES$'}
text:MauvilleCity_PokemonCenter_1F_BikeTradesStory	{'body': 'This is a tale of a TRAINER\\nnamed {STR_VAR_3}.\\pThis TRAINER swapped BIKES\\n{STR_VAR_1} times!\\p{STR_VAR_3} must love BIKES deeply\\nand passionately!$'}
text:MauvilleCity_PokemonCenter_1F_InterviewsTitle	{'body': 'The Interviewed TRAINER$'}
text:MauvilleCity_PokemonCenter_1F_InterviewsAction	{'body': 'Got interviewed$'}
text:MauvilleCity_PokemonCenter_1F_InterviewsStory	{'body': "This is a tale of a TRAINER\\nnamed {STR_VAR_3}.\\pThis TRAINER got interviewed\\n{STR_VAR_1} times!\\p{STR_VAR_3} must be a TRAINER who's\\nattracting much attention!$"}
text:MauvilleCity_PokemonCenter_1F_TrainerBattlesTitle	{'body': 'The Battle-Happy TRAINER$'}
text:MauvilleCity_PokemonCenter_1F_TrainerBattlesAction	{'body': 'Battled$'}
text:MauvilleCity_PokemonCenter_1F_TrainerBattlesStory	{'body': 'This is a tale of a TRAINER\\nnamed {STR_VAR_3}.\\pThis TRAINER battled {STR_VAR_1} times!\\p{STR_VAR_3} must be a TRAINER who can\\nnever refuse a chance to battle!$'}
text:MauvilleCity_PokemonCenter_1F_PokemonCaughtTitle	{'body': 'The POKéMON-Catching TRAINER$'}

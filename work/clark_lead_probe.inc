AI_DOUBLE_BATTLE_TEST("EC live review Clark leads: native physical and special pressure")
{
    u32 board, turns;
    PARAMETRIZE { board = 0; turns = 1; }
    PARAMETRIZE { board = 0; turns = 2; }
    PARAMETRIZE { board = 0; turns = 3; }
    PARAMETRIZE { board = 1; turns = 1; }
    PARAMETRIZE { board = 1; turns = 2; }
    PARAMETRIZE { board = 1; turns = 3; }
    GIVEN {
        ClarkPlayer(board == 0 ? SPECIES_EEVEE : SPECIES_PACHIRISU, board == 0 ? &sClarkEevee : &sClarkPachirisu);
        ClarkPlayer(board == 0 ? SPECIES_TIMBURR : SPECIES_LOTAD, board == 0 ? &sClarkTimburr : &sClarkLotad);
        AuthoredOpponent(TRAINER_CLARK, 0, FALSE);
        const enum Species expected[] = {SPECIES_ROGGENROLA, SPECIES_GEODUDE, SPECIES_MUDBRAY, SPECIES_ARCHEN};
        for (u32 owner = B_TRAINER_PLAYER; owner <= B_TRAINER_OPPONENT_A; owner++)
            for (u32 slot = 0; slot < (owner == B_TRAINER_PLAYER ? 2 : 4); slot++) {
                struct Pokemon *mon = &gBattleTestRunnerState->data.recordedBattle.parties[owner][slot];
                for (u32 index = 0; index < MAX_MON_MOVES; index++)
                    EXPECT(CanSpeciesUseEmeraldChampionsPreparationMove(GetMonData(mon, MON_DATA_SPECIES), GetMonData(mon, MON_DATA_MOVE1 + index)));
                if (owner == B_TRAINER_OPPONENT_A)
                    EXPECT_EQ(GetMonData(mon, MON_DATA_SPECIES), expected[slot]);
                Test_MgbaPrintf("CLARK_INPUT board=%d owner=%d slot=%d species=%d lv=%d HP=%d stats=%d/%d/%d/%d/%d item=%d ability=%d",
                    board, owner, slot, GetMonData(mon, MON_DATA_SPECIES), GetMonData(mon, MON_DATA_LEVEL),
                    GetMonData(mon, MON_DATA_HP), GetMonData(mon, MON_DATA_ATK), GetMonData(mon, MON_DATA_DEF),
                    GetMonData(mon, MON_DATA_SPATK), GetMonData(mon, MON_DATA_SPDEF), GetMonData(mon, MON_DATA_SPEED),
                    GetMonData(mon, MON_DATA_HELD_ITEM), GetMonAbility(mon));
            }
    } WHEN {
        for (u32 turn = 0; turn < turns; turn++) TURN {
            if (board == 0) {
                MOVE(playerLeft, MOVE_DOUBLE_EDGE, target: opponentLeft, hit: TRUE, criticalHit: FALSE);
                MOVE(playerRight, MOVE_DRAIN_PUNCH, target: opponentRight, hit: TRUE, criticalHit: FALSE);
            } else {
                MOVE(playerLeft, MOVE_SUPER_FANG, target: opponentLeft, hit: TRUE);
                MOVE(playerRight, MOVE_GIGA_DRAIN, target: opponentRight, hit: TRUE, criticalHit: FALSE);
            }
        }
    } THEN {
        Test_MgbaPrintf("CLARK_AFTER board=%d t=%d native=%d active=%d/%d HP=%d/%d foes=%d/%d moves=%S/%S faints=%d/%d",
            board, turns, gBattleResults.battleTurnCounter, opponentLeft->species, opponentRight->species,
            opponentLeft->hp, opponentRight->hp, playerLeft->hp, playerRight->hp,
            GetMoveName(gLastMoves[B_BATTLER_1]), GetMoveName(gLastMoves[B_BATTLER_3]),
            gBattleResults.opponentFaintCounter, gBattleResults.playerFaintCounter);
        Test_MgbaPrintf("CLARK_STATE board=%d t=%d Def=%d/%d foeSpe=%d/%d items=%d/%d",
            board, turns, opponentLeft->statStages[STAT_DEF], opponentRight->statStages[STAT_DEF],
            playerLeft->statStages[STAT_SPEED], playerRight->statStages[STAT_SPEED], opponentLeft->item, opponentRight->item);
    }
}

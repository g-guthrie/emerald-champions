    {
      "file": "src/legendary_signs.c",
      "line": 852,
      "text": "{STR_VAR_2}\\n{STR_VAR_3}."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 855,
      "text": "\\pCaught! This discovery is recorded."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 859,
      "text": "\\pAfter resolving the weather crisis,\\nask the Weather Institute about\\lunusual weather. Follow its report."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 861,
      "text": "\\pReturn to the summit after resolving\\nthe crisis in Sootopolis."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 863,
      "text": "\\pTake WAILORD and RELICANTH to the\\nSealed Chamber on Route 134.\\pRead its inscriptions to open the\\nthree ruins, then solve each puzzle."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 865,
      "text": "\\pWith six badges, ask the sailor at\\nLilycove Harbor about his sightings.\\pOne roams Hoenn; the other waits on\\nSouthern Island. He gives the passes."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 867,
      "text": "\\pPlace the MAGMA STONE in its room\\nto awaken HEATRAN."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 869,
      "text": "\\pFollow MEW through the island's grass\\nand approach when you find it."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 871,
      "text": "\\pFollow the moving triangle with as\\nfew steps as possible."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 873,
      "text": "\\pExplore this place and approach the\\nlegendary when you find it."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 874,
      "text": "\\pIf it escapes or faints, leave the\\narea and return for another try."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 892,
      "text": "{STR_VAR_2}\\n{STR_VAR_3}."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 895,
      "text": "\\pCaught! This discovery is recorded."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 905,
      "text": "\\pAvailable after earning\\n{STR_VAR_1} Gym Badges."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 909,
      "text": "\\pFirst, resolve the weather crisis\\nin Sootopolis."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 911,
      "text": "\\pHelp Wattson stop New Mauville's\\ngenerator, then report back to him."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 913,
      "text": "\\pFirst, rescue the Weather Institute\\nresearchers from Team Aqua."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 915,
      "text": "\\pFirst, confront Maxie deep inside\\nthe Magma Hideout."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 917,
      "text": "\\pFirst, help the elders at Mt. Pyre\\nand receive their Orb."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 923,
      "text": "\\pHelp Dewford Meadow's warden perform\\na song. Bring a Pokémon with SING."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 925,
      "text": "\\pBring CASTFORM to the archaeologist\\nat Route 111's elevated ruins.\\lHelp with the local weather survey."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 927,
      "text": "\\pFirst, catch RESHIRAM or ZEKROM.\\nEither discovery is enough."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 929,
      "text": "\\pBring REGIROCK, REGICE and REGISTEEL\\ntogether to the statue."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 931,
      "text": "\\pCatch OKIDOGI, MUNKIDORI and\\nFEZANDIPITI, then inspect the shrine."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 935,
      "text": "\\pA clue points to this family:\\n{STR_VAR_1}.\\pBefriend a member of that family.\\nA caught Pokédex entry is enough;\\lyour partner can stay in the PC."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 944,
      "text": "\\pAsk the Pokémon prize counter at\\nMauville's Game Corner."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 947,
      "text": "\\pEarn its Champions Circuit milestone\\nat the Battle Frontier's Battle Tower.\\pThe ferry opens with six badges.\\pLifetime wins count. The attendant\\nkeeps an earned reward until claimed."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 951,
      "text": "\\pResolve the weather crisis and earn\\nall eight badges, then visit Devon.\\pNo Pokédex completion is needed."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 952,
      "text": "\\pWin 40 Circuit battles in total and\\nclaim its other legendary rewards."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 955,
      "text": "\\pLeave MANAPHY and DITTO together\\nat Route 117's Day Care.\\pHatch their Egg to meet PHIONE."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 958,
      "text": "\\pAvailable now!"
    },
    {
      "file": "src/legendary_signs.c",
      "line": 960,
      "text": "\\pSearch while SURFING in this area.\\nThis Pokémon has a 1% encounter chance."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 961,
      "text": "\\pSearch the wild Pokémon in this area.\\nThis Pokémon has a 1% encounter chance."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 962,
      "text": "\\pSWEET SCENT gives a 25% chance of\\na legendary encounter here.\\pAvailable legends share that chance.\\nIt cannot bypass their requirements."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 963,
      "text": "\\pIf it escapes or faints, keep looking.\\nIt can appear again until caught."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 966,
      "text": "\\pSearch the wild Pokémon in this area.\\nNo research visit is needed."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 973,
      "text": "\\pSpeak to Devon's dream researcher\\nabout his mechanical prototype."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 978,
      "text": "\\pResting after your last encounter.\\nLeave this area and return to retry."
    },
    {
      "file": "src/legendary_signs.c",
      "line": 982,
      "text": "\\pReady! Approach the Pokémon or\\ninspect its shrine in this area."
    },

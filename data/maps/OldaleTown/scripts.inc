	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	step_end

OldaleTown_Movement_WatchRivalExit:
	delay_8
	delay_4
	walk_in_place_faster_down
	step_end

OldaleTown_Movement_PlayerStepBack:
	delay_8
	walk_right
	step_end

OldaleTown_Movement_BackUp:
	walk_fast_up
	walk_in_place_faster_left
	lock_facing_direction
	walk_right
	unlock_facing_direction
	step_end

OldaleTown_Movement_ReturnToOriginalPosition:
	walk_down
	walk_left
	step_end

OldaleTown_Text_SavingMyProgress:
	.string "I'm saving before I take a rest.\n"
	.string "Don't forget yours!\p"
	.string "Once you SAVE, the START menu\n"
	.string "also has RELOAD. It loads your\l"
	.string "last save without a reset.\p"
	.string "Anything since that save is lost.\n"
	.string "I always SAVE before trying\l"
	.string "something I might want to undo!$"

OldaleTown_Text_IWorkAtPokemonMart:
	.string "Hi!\n"
	.string "I work at a POKéMON MART.\p"
	.string "Can I get you to come with me?$"

OldaleTown_Text_ThisIsAPokemonMart:
	.string "This is a POKéMON MART.\n"
	.string "Just look for the blue roof!\p"
	.string "The clerk stocks POTIONS and\n"
	.string "other supplies for your travels.\p"
	.string "Take these three HEAL BALLS to try.$"

OldaleTown_Text_PotionExplanation:
	.string "A HEAL BALL restores a wild POKéMON\n"
	.string "after you catch it.\p"
	.string "Try different partners as you travel.\n"
	.string "The CENTER can prepare them for\l"
	.string "your next challenge!$"

OldaleTown_Text_WaitDontComeInHere:
	.string "I'm still sketching these tracks.\n"
	.string "Go south along ROUTE 101 to\l"
	.string "PROF. BIRCH's lab in LITTLEROOT.\p"
	.string "I'll have this path clear when\n"
	.string "you return from your send-off!$"

OldaleTown_Text_DiscoveredFootprints:
	.string "I just discovered the footprints of\n"
	.string "a rare POKéMON!\p"
	.string "While I sketch, meet your rival\n"
	.string "on ROUTE 103, through OLDALE's\l"
	.string "north exit. The CENTER can help\l"
	.string "you prepare first!$"

OldaleTown_Text_FinishedSketchingFootprints:
	.string "I finished sketching those rare\n"
	.string "POKéMON footprints!\p"
	.string "But it turns out they were only\n"
	.string "my own footprints…$"

OldaleTown_Text_MayLetsGoBack:
	.string "MAY: {PLAYER}{KUN}!\n"
	.string "Over here!\p"
	.string "Follow ROUTE 101 south to Dad's\n"
	.string "lab in LITTLEROOT. I'll go ahead!$"

OldaleTown_Text_BrendanLetsGoBack:
	.string "BRENDAN: Follow ROUTE 101 south\n"
	.string "to Dad's lab in LITTLEROOT.\p"
	.string "I'll meet you there, {PLAYER}!$"

OldaleTown_Text_TownSign:
	.string "OLDALE TOWN\n"
	.string "“Where things start off scarce.”$"
